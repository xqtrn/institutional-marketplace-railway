		<script>
			$(document).ready(function(){
				var whei = $(window).height()
				var pd = (whei-950)/2
				$('#main02 .model-swiper-container').css({
					'padding':pd+'px 0'
				})
			})
		</script>
		<script>
			var modelSwiper = new Swiper('.model-swiper-container', {
				autoplay: {
					delay: 4000,
					stopOnLastSlide: false,
					disableOnInteraction: false,
				},
			   loop:true,
				navigation: {
					nextEl: '.model-swiper-container .swiper-button-next',
					prevEl: '.model-swiper-container .swiper-button-prev',
				},

				on: {
					init: function() {
						this.emit('slideChange'); //在初始化时触发一次slideChangeTransitionEnd事件

					},
					slideChange: function() {
					    $('.model-pagination li').eq(this.realIndex).addClass('active').siblings().removeClass('active');
					}
				},

			});
			$(".model-swiper-container .model-pagination").on("click", "li", function() {

				var index = $(this).index();
				console.log(index)
				modelSwiper.slideToLoop(index);
			});

			var serviceSwiper = new Swiper('.service-swiper-container', {
				autoplay: {
					delay: 8000,
					stopOnLastSlide: false,
					disableOnInteraction: false,
				},
				pagination: {
					el: '.service-pagination',
					clickable: true,
					type: 'custom',
					renderCustom: function(swiper, current, total) {
						var icon = ["https://new-official-website-prod.oss-cn-hangzhou.aliyuncs.com/cmsstatic/static/images/index-main05-icon01.svg", "https://new-official-website-prod.oss-cn-hangzhou.aliyuncs.com/cmsstatic/static/images/index-main05-icon02.svg",
								"https://new-official-website-prod.oss-cn-hangzhou.aliyuncs.com/cmsstatic/static/images/index-main05-icon03.svg", "https://new-official-website-prod.oss-cn-hangzhou.aliyuncs.com/cmsstatic/static/images/index-main05-icon04.svg"
							];
							var icon2 = ["https://new-official-website-prod.oss-cn-hangzhou.aliyuncs.com/cmsstatic/static/images/index-main05-icon01-gray.svg", "https://new-official-website-prod.oss-cn-hangzhou.aliyuncs.com/cmsstatic/static/images/index-main05-icon02-gray.svg",
								"https://new-official-website-prod.oss-cn-hangzhou.aliyuncs.com/cmsstatic/static/images/index-main05-icon03-gray.svg", "https://new-official-website-prod.oss-cn-hangzhou.aliyuncs.com/cmsstatic/static/images/index-main05-icon04-gray.svg"
							],
							title = ["哪吒加电", "充电地图", "售后服务", "线下门店"],
							paginationHtml = "";
						for (var i = 0; i < total; i++) {
							// 判断是不是激活焦点，是的话添加active类，不是就只添加基本样式类
							if (i === (current - 1)) {
								paginationHtml += "<span class='active'><div class='flex'><i><img src='" + icon[i] + "'/></i><div>" + title[
									i] + "</div></div></span>";
							} else {
								paginationHtml += "<span><div class='flex'><i><img src='" + icon2[i] + "' /></i><div>" + title[i] +
									"</div></div></span>";
							}
						}
						return paginationHtml;
					}
				},
				navigation: {
					nextEl: '.service-swiper-container .swiper-button-next',
					prevEl: '.service-swiper-container .swiper-button-prev',
				},


			});
			$(".service-swiper-container .service-pagination").on("click", "span", function() {

				var index = $(this).index();
				console.log(index)
				serviceSwiper.slideTo(index);
			});
		</script>
	</body>
</html>