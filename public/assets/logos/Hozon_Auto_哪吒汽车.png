		</script>
		<script type="text/javascript">
			var lat = "";
			var lng = "";
			var baseUrl = "https://www.hozonauto.com";
			var testDriveVehicleid = "";
			var regionId_1 = "";
			var regionId_2 = "";
			var citytext = "";
			var provincetext = "";
			var dealer_name = "";






			if (window.layui) {
				layui.use('form', function() {
					var form = layui.form;
				  	loadstart();
					

					function loadstart() {
						var name = getQueryParam("name");
						var loc = getQueryParam("loc");
						if (loc != "" && loc != undefined) {
							var lng = loc.split(",")[0];
							var lat = loc.split(",")[1];
						}
						if (name != "" && name != undefined) {

							dealer_name = name;
						}
						onComplete(lng, lat);
					}

					function getQueryParam(param) {
						var result = null,
							tmp = [];
						location.search
							.substr(1)
							.split("&")
							.forEach(function(item) {
								tmp = item.split("=");
								if (tmp[0] === param) result = decodeURIComponent(tmp[1]);
							});
						return result;
					}

					function onComplete(lng, lat) {
						// 成功
						//根据经纬度获取城市数据
						$.ajax({
							url: "/cms/area/getProvinceAndCity",
							data: {
								lat: lat,
								lng: lng
							},
							type: "POST",
							dataType: 'json',
							success: function(res) {
								citytext = res.city;
								provincetext = res.province;
								province();
							}
						})
					}

					function onError(res) {
						//定位出错，则获取所有
						province();
					}

					//高德浏览器定位
					AMap.plugin('AMap.Geolocation', function() {
						var geolocation = new AMap.Geolocation({
							enableHighAccuracy: true,
							timeout: 10000,
							offset: [10, 20],
							zoomToAccuracy: true,
							position: 'RB'
						})

						geolocation.getCurrentPosition(function(status, result) {
							if (status == 'complete') {
								lat = result.position.lat
								lng = result.position.lng
								onComplete(lng, lat)
							} else {
								onError(result)
							  	onComplete("121.395437", "31.225025")
							}
						});


					})

					form.on('select(select_model1)', function(data) {
						var value = $('#modelselect option:selected').text();
						switchBg(value);
						testDriveVehicleid = $(data.elem).find("option:selected").attr("type");
						province(testDriveVehicleid);

					});

					form.on('select(select_province)', function(data) {
						regionId_1 = data.value;
					    regionId_2="";
						city();
					});

					form.on('select(select_city)', function(data) {
						regionId_2 = data.value;
						$("#dealerCode").html("");
						console.log(data.value);
						changecity(regionId_1, regionId_2, testDriveVehicleid);
					});

					var params = new URLSearchParams(window.location.search)
					var value = $('#modelselect option:selected').text();
					console.log(value);
					switchBg(value);
					testDriveVehicleid = $('#modelselect option:selected').attr("type");
					province(testDriveVehicleid);

					function province(testDriveVehicleid) {
					  	$("#province").html("");
						$.ajax({
							url: 'https://api.chehezhi.cn/hznz/third/dealerList/selectBySyscity',
							type: 'get',
							data: {
								parentCode: 0,
								select_has_dealer: 1,
								test_drive_vehicle: testDriveVehicleid
							},
							// 设置的是请求参数
							dataType: 'json', // 用于设置响应体的类型 注意 跟 data 参数没关系！！！
							success: function(res) {
								console.log('!!!!!!!!!!!!!!!!!!!', res)
								if (res.data !== '') {
									for (var i = 0; i < res.data.length; i++) {
										let post = res.data[i];
										console.log(post);
										if (provincetext == post.name) {
											$("#province").append('<option  selected value="' + post
												.areaCode +
												'">' + post
												.name +
												'</option>');
											regionId_1 = post.areaCode;
										} else {
											$("#province").append('<option value="' + post.areaCode +
												'">' + post
												.name +
												'</option>');
										}

									}
									layui.form.render();
									city();
								}
							}
						});
					}



					function switchBg(value) {
						var bg = ''
						if (value == "哪吒L" || value == "l") {
							bg = 'https://new-official-website-prod.oss-cn-hangzhou.aliyuncs.com/cmsstatic/static/images/index-order-img01@2x.webp'
						}
						if (value == "哪吒S" || value == "s") {
							bg = 'https://new-official-website-prod.oss-cn-hangzhou.aliyuncs.com/cmsstatic/static/images/index-order-img02@2x.webp'
						}
						if (value == "哪吒GT" || value == "gt") {
							bg = 'https://new-official-website-prod.oss-cn-hangzhou.aliyuncs.com/cmsstatic/static/images/index-order-img03@2x.webp'
						}
						if (value == "新哪吒X" || value == "x") {
							bg = 'https://new-official-website-prod.oss-cn-hangzhou.aliyuncs.com/cmsstatic/static/images/index-order-img04@2x.webp'
						}
						if (value == "哪吒AYA" || value == "aya") {
							bg = 'https://new-official-website-prod.oss-cn-hangzhou.aliyuncs.com/cmsstatic/static/images/index-order-img05@2x.webp'
						}
						if (value == "哪吒S猎装" || value == "sl") {
							bg = 'https://new-official-website-prod.oss-cn-hangzhou.aliyuncs.com/cmsstatic/static/images/index-order-img06@2x.webp'
						}
						$('.order-img').attr('style', 'background: url(' + bg + ') no-repeat;background-size: cover')
					}


					function city() {
						$("#city").html("");
						$("#dealerCode").html("");
						if (regionId_1 != "") {

							$.ajax({
								url: 'https://api.chehezhi.cn/hznz/third/dealerList/selectBySyscity',
								type: 'get',
								data: {
									areaCode: regionId_1,
									select_has_dealer: 1,
									test_drive_vehicle: testDriveVehicleid
								},
								// 设置的是请求参数
								contentType: 'application/json',
								success: function(res) {
									console.log('!!!!!!!!!!!!!!!!!!!', res)
									if (res.data !== '') {
										for (var i = 0; i < res.data.length; i++) {
											let post = res.data[i];
											console.log(post);
											if (citytext == post.name) {

												$("#city").append('<option selected  value="' + post
													.areaCode +
													'">' +
													post.name + '</option>');

												regionId_2 = post.areaCode;
											} else {
												$("#city").append('<option value="' + post.areaCode + '">' +
													post.name + '</option>');
												
											}

										}
										layui.form.render();
										if (regionId_2 == "") {
											regionId_2 = res.data[0].areaCode;
										}
										changecity(regionId_1, regionId_2, testDriveVehicleid);
									}

								}
							});
						}
					}

					// 选择城市获取经销商
					function changecity(regionId_1, regionId_2, testDriveVehicle) {
						$("#dealerCode").html("");
						$.ajax({
							url: 'https://api.chehezhi.cn/hznz/third/dealerList/selectAppDealerslist',
							type: 'get',
							data: {
								page: 1,
								pageSize: 50,
								province_region_id: regionId_1,
								city_region_id: regionId_2,
								test_drive_vehicle: testDriveVehicle,
								lng: lng,
								lat: lat
							},
							// 设置的是请求参数
							dataType: 'json', // 用于设置响应体的类型 注意 跟 data 参数没关系！！！
							success: function(res) {
								console.log('!!!!!!!!!!!!!!!!!!!', res)
								if (res.data.rows !== '') {
									for (var i = 0; i < res.data.rows.length; i++) {
										let post = res.data.rows[i];
										console.log(post);

										if (dealer_name == post.dealer_name) {
											$("#dealerCode").append('<option  selected value="' + post
												.dealer_code + '">' +
												post
												.dealer_name +
												'</option>');

										} else {
											$("#dealerCode").append('<option value="' + post.dealer_code +
												'">' +
												post
												.dealer_name +
												'</option>');

										}

									}
									layui.form.render();
								}
							}
						});
					}
				});
			}

			function yysj() {
				var province = "";
				var city = "";
				dealerCode
				dealerCn

				var modelselect = $("#modelselect").val();
				var name = $("#name").val();
				var custPhone = $("#tel").val();
				var provinceId = $("#province").val();
				var cityId = $("#city").val();
				var city = $('#city option:selected').text();
				var dealerCode = $("#dealerCode").val();
				var dealerCn = $('#dealerCode option:selected').text();
				var cusSource3 = "010601";
				var province = $('#province option:selected').text();
				var intentModel = $('#modelselect option:selected').text();
				var intentModelId = modelselect;

				if (modelselect == "") {
					layer.msg("请选择车型")
					return
				}
				if (province == "") {
					layer.msg("请选择省份")
					return
				}
				if (city == "") {
					layer.msg("请选择城市")
					return
				}
				if (name == "") {
					layer.msg("请输入名字")
					return
				}
				if (custPhone == "") {
					layer.msg("请输入手机号")
					return false;
				} else {
					if (!/^1[3456789]\d{9}$/.test(custPhone)) {
						layer.msg("手机号格式不正确")
						return false;
					}
				}
				if (!$("input[name='sex']").prop("checked")) {
					layer.msg("请勾选我已阅读同意")
					return false;
				}
				$.ajax({
					url: "/cms/carmodel/reservationsj",
					data: {
						"name": name,
						"phone": custPhone,
						"province": province,
						"provinceId": provinceId,
						"city": city,
						"cityId": cityId,
						"dealerCode": dealerCode,
						"dealerCn": dealerCn,
						"cusSource3": cusSource3,
						"carmodel": intentModel,
						"intentModelId": intentModelId
					},
					type: "POST",
					contentType: 'application/x-www-form-urlencoded', // 设置请求内容类型
					dataType: 'json', // 设置服务器返回的数据类型
					success: function(res) {
						if (res.code == 0) {
							layer.msg("预约成功")
						} else {
							layer.msg("预约失败")
						}
					}
				})

			}
		</script>


	</section>




