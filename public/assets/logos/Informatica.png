<div class="xf-content-height">
    


<div class="aem-Grid aem-Grid--12 aem-Grid--default--12 ">
    
    <div class="html-v2 html aem-GridColumn aem-GridColumn--default--12">
    <div class="infacom-html-component-container">
        <!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Leading Brands Component</title>

    <style>
      /* Base reset */
* {
  margin: 0;
  padding: 0;
  box-sizing: border-box;
}

/* Component */
.leading-brands-component {
  width: 100%;
  height: 880px;
  background: linear-gradient(180deg, #FFF 6.7%, #3EB0C7 72.23%, #0047BA 100.19%);
  margin: 0 auto;
  padding: 40px 125px;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.leading-brands-component .header-text {
  color: #101820;
  font-family: 'Roboto', sans-serif;
  font-size: 48px;
  font-weight: 200;
  line-height: 56px;
  text-align: center;
  margin-bottom: 60px;
  max-width: 1190px;
}

.leading-brands-component .content-container {
  width: 1190px;
  height: 615px;
  position: relative;
}

.leading-brands-component .top-border {
  width: 160px;
  height: 2px;
  background-color: #FF6A12;
  position: absolute;
  top: 0;
  left: 0; /* Start from left edge */
  z-index: 10;
  transition: left 0.3s ease; /* Animate left instead of transform */
}

/* Icon bar viewport (fixed), track inside will move */
.leading-brands-component .icon-container {
  width: 1190px;
  height: 110px;
  display: flex;
  padding: 0 40px;
  justify-content: space-between;
  align-items: center;
  border-radius: 4px 4px 0 0;
  background: #FFF;
  position: relative;
  overflow: hidden; /* important: prevent partials from showing outside */
}

/* Inner track that slides */
.leading-brands-component .icon-track {
   display: flex;
  justify-content: space-between; /* desktop layout */
  align-items: center;
  width: 100%; 
  transition: transform 0.3s ease;
}

.leading-brands-component .tab-icon {
  display: flex;
  width: 160px;
  height: 90px;
  justify-content: center;
  align-items: center;
  flex-shrink: 0;
  cursor: pointer;
  transition: opacity 0.3s ease;
  border-radius: 4px;
  position: relative;
  opacity: 0.45;
  border: none;
  outline: none;
  background: none;
}

.leading-brands-component .tab-icon:focus {
  outline: none;
  border: none;
}

.leading-brands-component .tab-icon:active {
  outline: none;
  border: none;
}

.leading-brands-component .tab-icon.active {
  opacity: 1;
}

.leading-brands-component .tab-icon img {
  max-width: 140px;
  max-height: 70px;
  object-fit: contain;
}

.leading-brands-component .content-area {
  width: 1190px;
  background: #FFF;
  display: flex;
  padding: 40px;
  align-items: flex-start;
  gap: 40px;
  border-radius: 0 0 4px 4px;
  height: 505px;
  margin-top: 2px;
}

.leading-brands-component .tab-image {
  width: 460px;
  height: 422px;
  object-fit: cover;
  border-radius: 8px;
  opacity: 0;
  visibility: hidden;
  transition: opacity 0.4s ease, visibility 0.4s ease;
  position: absolute;
  top: 0;
  left: 0;
}

.leading-brands-component .tab-image.active {
  opacity: 1;
  visibility: visible;
}

.leading-brands-component .left-content {
  width: 460px;
  height: 422px;
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.leading-brands-component .right-content {
  flex: 1;
  height: 100%;
  position: relative;
  display: flex;
  align-items: stretch;
}

.leading-brands-component .slider-container {
  width: 100%;
  height: 100%;
  position: relative;
  display: flex;
  align-items: stretch;
}

.leading-brands-component .tab-content {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  opacity: 0;
  visibility: hidden;
  transition: opacity 0.3s ease, visibility 0.3s ease;
  display: flex;
  flex-direction: column;
  justify-content: center;
  padding: 20px 0;
}

.leading-brands-component .tab-content.active {
  opacity: 1;
  visibility: visible;
}

.leading-brands-component .company-logo {
  margin-bottom: 24px;
  height: 80px;
  display: flex;
  align-items: center;
  opacity: 0;
  transform: translateY(20px);
  transition: opacity 0.6s ease 0.2s, transform 0.6s ease 0.2s;
}

.leading-brands-component .tab-content.active .company-logo {
  opacity: 1;
  transform: translateY(0);
}

.leading-brands-component .company-logo img {
  max-width: 200px;
  max-height: 80px;
  object-fit: contain;
}

.leading-brands-component .main-headline {
  color: #000;
  font-family: 'Roboto', sans-serif;
  font-size: 48px;
  font-weight: 200;
  line-height: 56px;
  margin-bottom: 20px;
  opacity: 0;
  transform: translateY(20px);
  transition: opacity 0.6s ease 0.4s, transform 0.6s ease 0.4s;
}

.leading-brands-component .tab-content.active .main-headline {
  opacity: 1;
  transform: translateY(0);
}

/* CTA */
.leading-brands-component .cta-refresh {
  margin-bottom: 32px;
  opacity: 0;
  transform: translateY(20px);
  transition: opacity 0.6s ease 0.6s, transform 0.6s ease 0.6s;
}

.leading-brands-component .tab-content.active .cta-refresh {
  opacity: 1;
  transform: translateY(0);
}

.leading-brands-component .container {
  width: 100%;
}

.leading-brands-component .www-cta-refresh {
  display: inline-block;
}

.leading-brands-component .infacom-cta-margin-top-0 {
  margin-top: 0;
}

.leading-brands-component .infacom-cta-refresh {
  display: inline-block;
}

.leading-brands-component .infa-o-cta__primary {
  display: inline-block;
}

.leading-brands-component .infacom-cta-left {
  text-align: left;
}

.leading-brands-component .infacom-cta-link {
  text-decoration: none;
  display: inline-flex;
  align-items: center;
  gap: 8px;
  font-family: 'Roboto', sans-serif;
  font-size: 16px;
  font-weight: 400;
  transition: all 0.3s ease;
}

.leading-brands-component .infacom-cta-link.infa-o-cta__link--orange-4 {
  color: #E23400;
}

.leading-brands-component .infacom-cta-link.infa-o-cta__link--orange-4:hover {
  color: #9C2400;
}

.leading-brands-component .infacom-cta-link.infa-o-cta__link--orange-4:hover svg path {
  stroke: #9C2400;
}

.leading-brands-component .infa-o-cta__arrow {
  display: inline-flex;
  align-items: center;
}

.leading-brands-component .infa-o-cta__arrow svg {
  transition: all 0.3s ease;
}

/* CTA custom sizes */
.leading-brands-component .cta-refresh.leading-brands-cta {
  margin-bottom: 32px;
}

.leading-brands-component .leading-brands-cta .infacom-cta-link {
  font-size: 18px;
}

.leading-brands-component .leading-brands-cta .infa-o-cta__arrow svg {
  width: 20px;
  height: 20px;
}

/* AEM overrides */
.leading-brands-component .leading-brands-cta .container,
.leading-brands-component .leading-brands-cta .www-cta-refresh,
.leading-brands-component .leading-brands-cta .infacom-cta-refresh {
  padding-left: 0 !important;
  margin-left: 0 !important;
}

.leading-brands-component .leading-brands-cta .infa-o-cta__primary {
  padding-left: 0 !important;
  text-align: left !important;
}

/* Statistics */
.leading-brands-component .statistics-section {
  display: flex;
  align-items: flex-start;
  gap: 24px;
  margin-bottom: 0;
}

.leading-brands-component .stat-group {
  display: flex;
  flex-direction: column;
  opacity: 0;
  transform: translateX(-30px);
  transition: opacity 0.6s ease, transform 0.6s ease;
}

/*.leading-brands-component .stat-group.fade-in-left {
  animation: fadeInLeft 0.8s ease forwards;
}

.leading-brands-component .stat-group.fade-in-right {
  animation: fadeInRight 0.8s ease forwards;
}

.leading-brands-component .stat-group:nth-child(2) {
  transform: translateX(30px);
}

@keyframes fadeInLeft {
  from { opacity: 0; transform: translateX(-30px); }
  to   { opacity: 1; transform: translateX(0); }
}

@keyframes fadeInRight {
  from { opacity: 0; transform: translateX(30px); }
  to   { opacity: 1; transform: translateX(0); }
}*/

.leading-brands-component .stat-number {
  color: #12C2E5;
  font-family: 'Roboto', sans-serif;
  font-size: 62px;
  font-weight: 300;
  line-height: 72px;
  margin-bottom: 4px;
}

.leading-brands-component .stat-description {
  color: #000;
  font-family: 'Roboto', sans-serif;
  font-size: 18px;
  font-weight: 300;
  line-height: 24px;
  margin-bottom: 30px;
}

/* Arrow active/inactive states */
.leading-brands-component .slider-arrow.inactive {
  cursor: default !important;
  pointer-events: none !important;
}

.leading-brands-component .slider-arrow.inactive:hover {
  opacity: 1 !important; /* Remove hover effect when inactive */
}

/* Hide grey circle on inactive arrows */
.leading-brands-component .slider-arrow.inactive circle {
  display: none;
}

/* Gradient area */
.leading-brands-component .gradient-area {
  width: 1190px;
  height: 92px;
  background: transparent;
}

/* Slider arrows (hidden on desktop) */
.leading-brands-component .slider-arrows {
  display: none;
  gap: 20px;
  margin-top: 24px;
  align-items: center;
}

.leading-brands-component .slider-arrow {
  width: 40px;
  height: 40px;
  cursor: pointer;
  transition: opacity 0.3s ease;
}

.leading-brands-component .slider-arrow:hover {
  opacity: 0.7;
}

/* Button reset */
.leading-brands-component button {
  border: none;
  outline: none;
  background: none;
}

.leading-brands-component button:focus,
.leading-brands-component button:active {
  border: none;
  outline: none;
}

/* <=1440px */
@media (max-width: 1440px) {
  .leading-brands-component {
    width: 100%;
    padding: 20px;
  }

  .leading-brands-component .content-container,
  .leading-brands-component .icon-container,
  .leading-brands-component .content-area,
  .leading-brands-component .gradient-area {
    width: 100%;
    max-width: 1190px;
  }

  .leading-brands-component .header-text {
    font-size: 36px;
    line-height: 42px;
  }

  .leading-brands-component .main-headline {
    font-size: 36px;
    line-height: 42px;
  }

  .leading-brands-component .left-content {
    width: 50%;
    height: auto;
    min-height: 400px;
  }
}

/* Add fixed offsets for different screen sizes */
@media (min-width: 768px) {
  .leading-brands-component .top-border {
    margin-left: 0px !important; /* Fixed desktop offset */
  }
}

@media (max-width: 767px) {
  .leading-brands-component .top-border {
    margin-left: 10px !important; /* Fixed mobile offset */
  }
}

/* Tablet 991px */
@media (max-width: 991px) and (min-width: 768px) {
  .leading-brands-component .icon-container {
    padding: 0 20px !important;
  }
  
  .leading-brands-component .tab-icon {
    width: 140px !important;
    min-width: 140px !important;
  }
  
  .leading-brands-component .tab-icon img {
    max-width: 120px !important;
  }
  
  .leading-brands-component .top-border {
    width: 140px !important; /* Match reduced icon width */
  }
  /* Reduce content area padding and gap */
  .leading-brands-component .content-area {
    padding: 30px;
    gap: 30px;
  }
  
  /* Reduce left content width */
  .leading-brands-component .left-content {
    width: 40%;
    min-height: 350px;
  }
  
  /* Adjust image size to fit smaller container */
  .leading-brands-component .tab-image {
    width: 100%;
    height: 100%;
    max-width: 350px;
    max-height: 350px;
  }
  
  /* Make text a bit smaller */
  .leading-brands-component .main-headline {
    font-size: 32px;
    line-height: 38px;
  }
  
  /* Adjust stat number size */
  .leading-brands-component .stat-number {
    font-size: 54px;
    line-height: 64px;
  }
  
  /* Adjust statistics section */
  .leading-brands-component .statistics-section {
    gap: 20px;
  }
}

/* Smaller tablet landscape (850px to 768px) */
@media (max-width: 850px) and (min-width: 768px) {
  /* Further reduce content area padding and gap */
  .leading-brands-component .content-area {
    padding: 25px;
    gap: 20px;
  }
  
  /* Further reduce left content width */
  .leading-brands-component .left-content {
    width: 35%;
    min-height: 320px;
  }
  
  /* Further adjust image size */
  .leading-brands-component .tab-image {
    max-width: 300px;
    max-height: 300px;
  }
  
  /* Make text smaller */
  .leading-brands-component .main-headline {
    font-size: 28px;
    line-height: 34px;
  }
  
  /* Adjust stat number size */
  .leading-brands-component .stat-number {
    font-size: 46px;
    line-height: 52px;
  }
  
  /* Reduce stat description size */
  .leading-brands-component .stat-description {
    font-size: 16px;
    line-height: 22px;
  }
}

/* Mobile <=767px */
@media (max-width: 767px) {
  .leading-brands-component {
    background: #d9d9d9 !important;
    padding: 20px 0 !important; /* Remove side padding */
    height: auto !important;
    min-height: 750px !important;
  }

  /* Add padding to header text */
  .leading-brands-component .header-text {
    padding-left: 20px !important;
    padding-right: 20px !important;
  }

/* .leading-brands-component .top-border { left: -20px !important; } */

  .leading-brands-component .tab-image { display: none !important; }
  .leading-brands-component .company-logo { display: none !important; }

  .leading-brands-component .content-container {
    height: auto !important;
    width: 100% !important;
    padding: 0 !important; /* Keep content-container full width */
  }

  /* Icon bar flush to content area, no side gaps */
  .leading-brands-component .icon-container {
    width: 100% !important;
    margin: 0 !important;
    padding: 0 !important;
    overflow: hidden !important;
    display: block !important;
    background: #FFF !important;
    border-radius: 4px 4px 0 0 !important;
  }

  .leading-brands-component .icon-track {
     justify-content: flex-start !important;
    width: max-content !important;  
    transition: transform 0.3s ease !important;
  }

  .leading-brands-component .tab-icon {
    min-width: 160px !important;
    margin-right: 8px !important;
    flex-shrink: 0 !important;
  }
  .leading-brands-component .tab-icon:last-child { margin-right: 0 !important; }

  .leading-brands-component .content-area {
    display: block !important;
    width: 100% !important;
    height: auto !important;
    padding: 0 !important;
    overflow: hidden !important;
    background: transparent !important;
    border-radius: 0 !important;
    margin: 2px 0 0 !important;
  }

  .leading-brands-component .slider-container {
    display: flex !important;
    transition: transform 0.3s ease !important;
    width: 100% !important;
    height: auto !important;
  }

  .leading-brands-component .tab-content {
    position: relative !important;
    width: calc(85% - 8px) !important;
    min-width: calc(85% - 8px) !important;
    flex-shrink: 0 !important;
    opacity: 1 !important;
    visibility: visible !important;
    display: flex !important;
    flex-direction: column !important;
    padding: 20px !important;
    margin-right: 8px !important;
    height: auto !important;
    background: #FFF !important;
    border-radius: 0 0 4px 4px !important;
    box-sizing: border-box !important;
    justify-content: flex-start !important;
  }
  .leading-brands-component .tab-content:last-child { margin-right: 0 !important; }

  /* Reset mobile animations */
  .leading-brands-component .tab-content .company-logo,
  .leading-brands-component .tab-content .main-headline,
  .leading-brands-component .tab-content .cta-refresh {
    opacity: 1 !important;
    transform: translateY(0) !important;
    transition: none !important;
  }

  .leading-brands-component .right-content {
    width: 100% !important;
    height: auto !important;
    overflow: hidden !important;
    padding: 0 !important;
    margin: 0 !important;
    background: transparent !important;
  }

  .leading-brands-component .left-content { display: none !important; }

  .leading-brands-component .main-headline {
    font-size: 32px !important;
    line-height: 1.3 !important;
    margin-bottom: 20px !important;
  }

  .leading-brands-component .cta-refresh { margin-bottom: 20px !important; }

  .leading-brands-component .statistics-section {
    position: relative !important;
    top: auto !important;
    margin-bottom: 20px !important;
    flex-direction: column !important;
    gap: 10px !important;
  }

  .leading-brands-component .stat-number { font-size: 40px !important; margin-bottom: 2px !important; }
  .leading-brands-component .stat-description { font-size: 16px !important; margin-bottom: 15px !important; }

  /* Add margin to arrows instead of padding */
  .leading-brands-component .slider-arrows {
    display: flex !important;
    gap: 20px !important;
    margin-top: 24px !important;
    margin-left: 20px !important; /* Use margin for better control */
    margin-bottom: 40px !important;
    align-items: center !important;
    justify-content: flex-start !important;
    position: relative !important;
    width: calc(100% - 20px) !important; /* Account for margin */
    padding-left: 0 !important;
  }

  .leading-brands-component .slider-arrow {
    width: 40px !important;
    height: 40px !important;
    cursor: pointer !important;
    transition: opacity 0.3s ease !important;
  }

  .leading-brands-component .slider-arrow:hover { opacity: 0.7 !important; }
  .leading-brands-component .gradient-area { display: none !important; }
}

/* <=545px */
@media (max-width: 545px) {
  .leading-brands-component {
    padding: 16px 0 !important; /* Remove side padding */
    min-height: 850px !important;
  }

  /* Add padding to header text */
  .leading-brands-component .header-text {
    padding-left: 16px !important;
    padding-right: 16px !important;
  }

  .leading-brands-component .content-container { 
    height: auto !important; 
    padding: 0 !important; /* Keep content-container full width */
  }

  /* Keep icon bar flush */
  .leading-brands-component .icon-container {
    width: 100% !important;
    margin: 0 !important;
    padding: 0 !important;
    overflow: hidden !important;
    display: block !important;
    background: #FFF !important;
    border-radius: 4px 4px 0 0 !important;
  }

  .leading-brands-component .content-area {
    padding: 0 !important;
    margin: 2px 0 0 !important;
    background: transparent !important;
    border-radius: 0 !important;
  }

  /* Cards keep their own internal padding */
  .leading-brands-component .tab-content {
    padding: 20px !important;
  }

  /* Arrows with margin */
  .leading-brands-component .slider-arrows {
    margin-left: 16px !important; /* Match header padding */
    width: calc(100% - 16px) !important;
    padding-left: 0 !important;
  }

  .leading-brands-component .main-headline { font-size: 28px !important; margin-bottom: 16px !important; }
  .leading-brands-component .cta-refresh { margin-bottom: 16px !important; }
  .leading-brands-component .statistics-section { gap: 8px !important; }
  .leading-brands-component .stat-number { font-size: 35px !important; margin-bottom: 2px !important; }
  .leading-brands-component .stat-description { font-size: 16px !important; margin-bottom: 12px !important; }
  .leading-brands-component .slider-arrow { width: 35px !important; height: 35px !important; }
  .leading-brands-component .gradient-area { display: none !important; }
}

/* <=320px */
@media (max-width: 320px) {
  .leading-brands-component { 
    padding: 12px 0 !important; /* Remove side padding */
    min-height: 600px !important; 
  }

  /* Add padding to header text */
  .leading-brands-component .header-text {
    padding-left: 12px !important;
    padding-right: 12px !important;
  }

  .leading-brands-component .content-container { 
    height: auto !important; 
    padding: 0 !important; /* Keep content-container full width */
  }

  .leading-brands-component .content-area {
    padding: 0 !important;
    margin: 2px 0 0 !important;
    background: transparent !important;
    border-radius: 0 !important;
  }

  .leading-brands-component .tab-content { padding: 16px !important; }

  /* Arrows with margin */
  .leading-brands-component .slider-arrows { 
    gap: 15px !important; 
    margin-top: 20px !important; 
    margin-left: 12px !important; /* Match header padding */
    width: calc(100% - 12px) !important;
    padding-left: 0 !important;
  }

  .leading-brands-component .main-headline { font-size: 24px !important; margin-bottom: 12px !important; }
  .leading-brands-component .cta-refresh { margin-bottom: 12px !important; }
  .leading-brands-component .statistics-section { gap: 6px !important; }
  .leading-brands-component .stat-number { font-size: 30px !important; margin-bottom: 2px !important; }
  .leading-brands-component .stat-description { font-size: 16px !important; margin-bottom: 10px !important; }
  .leading-brands-component .slider-arrow { width: 30px !important; height: 30px !important; }
  .leading-brands-component .gradient-area { display: none !important; }
}

    </style>

