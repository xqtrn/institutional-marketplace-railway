    <path d="M89.1399 69.85L86.0599 70.38L85.8799 69.34L93.7499 67.98L94.2499 70.88C94.3999 71.74 94.2999 72.45 93.9399 73.02C93.5799 73.58 93.0399 73.93 92.3199 74.05C91.5599 74.18 90.9299 74.05 90.4299 73.64C89.9299 73.23 89.6099 72.59 89.4599 71.7L89.1399 69.85ZM89.9899 69.7L90.3099 71.56C90.4099 72.11 90.6099 72.52 90.9199 72.77C91.2299 73.02 91.6399 73.1 92.1299 73.02C92.5999 72.94 92.9499 72.73 93.1799 72.38C93.4099 72.03 93.4899 71.61 93.4099 71.09L93.0799 69.17L89.9899 69.7Z" fill="white"/>
    <path d="M88.0498 77.1601L88.6098 80.9001L87.7598 81.0301L87.0498 76.2401L94.9498 75.0601L95.1098 76.1101L88.0598 77.1601H88.0498Z" fill="white"/>
    <path d="M90.5398 86.3201L90.1198 83.0001L87.9498 82.5101L87.8198 81.4301L96.1198 83.4601L96.2298 84.3801L88.6898 88.4001L88.5598 87.3301L90.5398 86.3101V86.3201ZM91.0198 83.2101L91.3598 85.9001L94.8998 84.09L91.0298 83.2101H91.0198Z" fill="white"/>
    <path d="M91.8902 94.87C91.0402 94.86 90.3602 94.61 89.8502 94.13C89.3402 93.65 89.0402 92.98 88.9602 92.12C88.8702 91.18 89.1302 90.4 89.7402 89.76C90.3502 89.12 91.2302 88.76 92.3602 88.64L93.1202 88.56C93.8602 88.49 94.5202 88.56 95.1102 88.76C95.7002 88.97 96.1602 89.3 96.5102 89.75C96.8602 90.2 97.0602 90.75 97.1302 91.39C97.2102 92.23 97.0502 92.93 96.6302 93.49C96.2102 94.05 95.5902 94.41 94.7602 94.57L94.6602 93.52C95.2902 93.37 95.7302 93.12 95.9802 92.79C96.2302 92.46 96.3302 92.02 96.2802 91.47C96.2102 90.8 95.9102 90.3 95.3802 89.97C94.8502 89.64 94.1202 89.52 93.2102 89.61L92.4402 89.69C91.5802 89.78 90.9102 90.02 90.4302 90.44C89.9602 90.85 89.7502 91.38 89.8202 92.03C89.8802 92.61 90.0502 93.05 90.3502 93.33C90.6402 93.62 91.1202 93.78 91.7902 93.81L91.8902 94.86V94.87Z" fill="white"/>
    <path d="M93.5 100.69L93.24 97.24L90.42 97.45L90.72 101.46L89.86 101.53L89.48 96.47L97.44 95.87L97.82 100.87L96.96 100.93L96.66 96.98L94.1 97.17L94.36 100.62L93.5 100.68V100.69Z" fill="white"/>
    <path d="M96.78 48.7701L104.55 46.9301L105.07 49.1201C105.23 49.8001 105.22 50.4301 105.05 51.0201C104.87 51.6101 104.54 52.1101 104.06 52.5301C103.58 52.9401 102.98 53.2401 102.26 53.4101L101.76 53.5301C101.03 53.7001 100.35 53.7101 99.73 53.5601C99.11 53.4101 98.59 53.1001 98.17 52.6501C97.75 52.1901 97.45 51.6201 97.28 50.9201L96.77 48.7701H96.78ZM103.95 48.1501L97.86 49.6001L98.12 50.6801C98.31 51.4701 98.7 52.0301 99.29 52.3501C99.88 52.6701 100.64 52.7301 101.55 52.5101L102 52.4001C102.88 52.1901 103.52 51.8201 103.91 51.2901C104.3 50.7601 104.41 50.1101 104.24 49.3501L103.96 48.1501H103.95Z" fill="white"/>
    <path d="M101.32 59.38L100.62 56.11L98.4199 55.81L98.1899 54.75L106.64 56.07L106.83 56.97L99.6499 61.62L99.4299 60.56L101.32 59.38ZM101.53 56.24L102.09 58.9L105.46 56.79L101.52 56.24H101.53Z" fill="white"/>
    <path d="M107.7 65.78L107.22 63.26L100.22 64.6L100.02 63.57L107.02 62.23L106.54 59.71L107.39 59.55L108.55 65.6201L107.7 65.78Z" fill="white"/>
    <path d="M103.58 71.59L103.02 68.29L100.83 67.9L100.65 66.83L109.03 68.5L109.18 69.41L101.82 73.76L101.64 72.69L103.57 71.59H103.58ZM103.93 68.46L104.38 71.14L107.84 69.18L103.93 68.47V68.46Z" fill="white"/>
  </g>
  <defs>
    <clipPath id="clip0_35516_10277">
      <rect width="139.16" height="114.36" fill="white"/>
    </clipPath>
  </defs>
</svg>
          </div>

          

        <h2 class="metadata-title">
          Metadata
          <span class="light-text">System of Intelligence</span>
        </h2>
      </section>

      <!-- Title -->
      <div class="cloud-title-container">
        <h1 class="cloud-title">Intelligent Data Management Cloud<span class="trademark">TM</span></h1>
        
      </div>
    </header>

    <!-- Feature bar -->
    <nav class="feature-bar">
      <div class="feature-item">Multi-Cloud<br>& Hybrid</div>
      <div class="feature-item">50,000+<br>Metadata-Aware<br>Connections</div>
      <div class="feature-item">Global<br>Scale</div>
      <div class="feature-item">Security<br>& Compliance</div>
      <div class="feature-item">Flexible<br>Pricing</div>
    </nav>
  </article>
</section>

<script>
document.addEventListener("DOMContentLoaded", () => {
  // Define wedge URLs and labels with analytics attributes
  const wedgeConfig = [
    { 
      id: 'new-wedge1-wrapper', 
      url: '/content/informatica-www/en_us/products/data-catalog.html', 
      name: 'Data Catalog',
      analytics: {
        linkName: 'data-catalog-link',
        linkPosition: 'desktop-wedge-1'
      }
    },
    { 
      id: 'new-wedge2-wrapper', 
      url: '/content/informatica-www/en_us/products/cloud-data-integration.html', 
      name: 'Data Integration',
      analytics: {
        linkName: 'data-integration-link',
        linkPosition: 'desktop-wedge-2'
      }
    },
    { 
      id: 'new-wedge3-wrapper', 
      url: '/content/informatica-www/en_us/products/cloud-application-integration.html', 
      name: 'Cloud App Integration',
      analytics: {
        linkName: 'cloud-app-integration-link',
        linkPosition: 'desktop-wedge-3'
      }
    },
    { 
      id: 'new-wedge4-wrapper', 
      url: '/content/informatica-www/en_us/products/ai-agent-engineering.html', 
      name: 'API Management',
      analytics: {
        linkName: 'api-management-link',
        linkPosition: 'desktop-wedge-4'
      }
    },
    { 
      id: 'new-wedge5-wrapper', 
      url: '/content/informatica-www/en_us/products/data-quality.html', 
      name: 'Data Quality',
      analytics: {
        linkName: 'data-quality-link',
        linkPosition: 'desktop-wedge-5'
      }
    },
    { 
      id: 'new-wedge6-wrapper', 
      url: '/content/informatica-www/en_us/products/master-data-management.html', 
      name: 'Master Data Management',
      analytics: {
        linkName: 'mdm-link',
        linkPosition: 'wedge-6'
      }
    },
    { 
      id: 'new-wedge7-wrapper', 
      url: '/content/informatica-www/en_us/products/data-governance.html', 
      name: 'Data Governance',
      analytics: {
        linkName: 'data-governance-link',
        linkPosition: 'wedge-7'
      }
    },
    { 
      id: 'new-wedge8-wrapper', 
      url: '/content/informatica-www/en_us/products/data-governance/cloud-data-marketplace.html', 
      name: 'Cloud Data Marketplace',
      analytics: {
        linkName: 'cloud-data-marketplace-link',
        linkPosition: 'wedge-8'
      }
    }
  ];

  // Debug mode - set to false for production
  let debugMode = false;

  // Debug colors for each hit area
  const debugColors = [
    'rgba(255, 0, 0, 0.3)',     // Red - Wedge 1
    'rgba(255, 165, 0, 0.3)',   // Orange - Wedge 2
    'rgba(255, 255, 0, 0.3)',   // Yellow - Wedge 3
    'rgba(0, 128, 0, 0.3)',     // Green - Wedge 4
    'rgba(0, 255, 255, 0.3)',   // Cyan - Wedge 5
    'rgba(0, 0, 255, 0.3)',     // Blue - Wedge 6
    'rgba(128, 0, 128, 0.3)',   // Purple - Wedge 7
    'rgba(255, 0, 255, 0.3)'    // Magenta - Wedge 8
  ];

  // Clear any existing hit areas first
  document.querySelectorAll('.wedge-hit-area').forEach(el => el.remove());

  // Make all wedges non-interactive
  wedgeConfig.forEach(config => {
    const wedge = document.getElementById(config.id);
    if (wedge) {
      wedge.replaceWith(wedge.cloneNode(true));
      const newWedge = document.getElementById(config.id);
      if (newWedge) {
        newWedge.style.pointerEvents = 'none';
      }
    }
  });

  // Create hit areas for all wedges
  createAllWedgeHitAreas();

  // Function to create hit areas for all wedges with precise positioning
  function createAllWedgeHitAreas() {
    const container = document.querySelector('.svg-container');
    if (!container) return;

    // Define custom hit areas for each wedge
    const hitAreaConfig = [
      // Wedge 1 - Data Catalog
      {
        id: 'wedge1-hit-area',
        wedgeId: 'new-wedge1-wrapper',
        styles: {
          position: 'absolute',
          left: '118px',
          bottom: '-176px',
          width: '125px',
          height: '133px',
          zIndex: '50',
          cursor: 'pointer',
           clipPath: 'polygon(8% 6%, 100% 0%, 95% 100%, 32% 100%)',
          transform: 'rotate(-75deg)',
          transformOrigin: 'bottom left'
        },
        configIndex: 0
      },
      // Wedge 2 - Data Integration
      {
        id: 'wedge2-hit-area',
        wedgeId: 'new-wedge2-wrapper',
        styles: {
          position: 'absolute',
          left: '120px',
          bottom: '-85px',
          width: '116px',
          height: '130px',
           zIndex: '45',
          cursor: 'pointer',
          clipPath: 'polygon(0 0, 100% 0, 100% 100%, 25% 100%)',
          transform: 'rotate(-50deg)',
          transformOrigin: 'bottom left'

        },
        configIndex: 1
      },
// Wedge 3 - Cloud Data Management
{
  id: 'wedge3-hit-area',
  wedgeId: 'new-wedge3-wrapper',
  styles: {
    position: 'absolute',
    bottom: '-14px',
    left: '155px',
    width: '134px',
    height: '139px',
    zIndex: '44',
    cursor: 'pointer',
    clipPath: 'polygon(5% 15%, 100% 0%, 89% 100%, 31% 100%)',
    transform: 'rotate(-30deg)', // Rotate counter-clockwise
    transformOrigin: 'bottom left' // Set the pivot point of rotation
  },
  configIndex: 2
},
      // Wedge 4 - API Management
      {
        id: 'wedge4-hit-area',
        wedgeId: 'new-wedge4-wrapper',
        styles: {
          position: 'absolute',
          bottom: '50px',
          left: '220px', // Moved slightly right to avoid wedge3
          width: '125px',
          height: '145px',
          zIndex: '43',
          cursor: 'pointer',
          clipPath: 'polygon(0 0, 100% 0, 100% 100%, 25% 100%)',
          transform: 'rotate(-5deg)', // Rotate counter-clockwise
    transformOrigin: 'bottom left' // Set the pivot point of rotation
        },
        configIndex: 3
      },
      // Wedge 5 - Master Data Management
      {
        id: 'wedge5-hit-area',
        wedgeId: 'new-wedge5-wrapper',
        styles: {
          position: 'absolute',
          bottom: '46px',
          left: '340px',
          width: '150px', 
          height: '149px',
          clipPath: 'polygon(2% 0%, 83% 17%, 48% 100%, 0% 88%)',
          zIndex: '42',
          cursor: 'pointer'
        },
        configIndex: 4
      },
      // Wedge 6 - Data Quality
      {
        id: 'wedge6-hit-area',
        wedgeId: 'new-wedge6-wrapper',
        styles: {
          position: 'absolute',
          top: '109px',
          left: '380px',
          width: '157px',
          height: '156px',
           clipPath: 'polygon(18.6% 14%, 100% 21%, 74.4% 100%, 28.4% 98%)',
           transform: 'rotate(29deg)', 
    transformOrigin: 'bottom left',
          zIndex: '41',
          cursor: 'pointer'
        },
        configIndex: 5
      },

      // Wedge 7 - Data Governance
      {
        id: 'wedge7-hit-area',
        wedgeId: 'new-wedge7-wrapper',
        styles: {
          position: 'absolute',
          bottom: '6px', 
          right: '46px',
          width: '161px',
          height: '144px',
          clipPath: 'polygon(8.6% 0%, 87% 0%, 60.4% 94%, 13.4% 87%)',
          transform: 'rotate(49deg)', 
    transformOrigin: 'bottom left',
          zIndex: '40',
          cursor: 'pointer'
        },
        configIndex: 6
      },
      // Wedge 8 - Big Data
      {
        id: 'wedge8-hit-area',
        wedgeId: 'new-wedge8-wrapper',
        styles: {
          position: 'absolute',
          bottom: '-136px',
          right: '-128px',
          width: '121px', 
          height: '129px',
          zIndex: '50',
          cursor: 'pointer',
          clipPath: 'polygon(20% 0%, 75% 0%, 100% 98%, 0% 100%)',
           transform: 'rotate(-99deg)', // Rotate counter-clockwise
    transformOrigin: 'bottom left' // Set the pivot point of rotation
        },
        configIndex: 7
      }
    ];

    // Create all hit areas
    hitAreaConfig.forEach((config, index) => {
      const hitArea = document.createElement('div');
      hitArea.id = config.id;
      hitArea.className = 'wedge-hit-area';
      hitArea.dataset.wedgeIndex = config.configIndex;

      // Apply all styles from the config
      Object.keys(config.styles).forEach(prop => {
        hitArea.style[prop] = config.styles[prop];
      });

      // Add debug styling if debug mode is enabled
      if (debugMode) {
        hitArea.style.backgroundColor = debugColors[index];
        hitArea.style.border = '1px solid ' + debugColors[index].replace('0.3', '1');

        // Add a label for easier identification
        const label = document.createElement('div');
        label.className = 'hit-area-label';
        label.textContent = `${index + 1}: ${wedgeConfig[config.configIndex].name}`;
        label.style.position = 'absolute';
        label.style.top = '5px';
        label.style.left = '5px';
        label.style.color = '#000';
        label.style.fontWeight = 'bold';
        label.style.fontSize = '10px';
        label.style.backgroundColor = 'rgba(255, 255, 255, 0.7)';
        label.style.padding = '2px';
        label.style.borderRadius = '3px';
        hitArea.appendChild(label);
      }

      // Attach to container
      container.appendChild(hitArea);

      // Add event listeners
      const wedge = document.getElementById(config.wedgeId);
      if (wedge) {
        // Add hover effect listeners
        hitArea.addEventListener('mouseenter', () => {
          applyWedgeHoverEffect(wedge);

          // Show active state in debug mode
          if (debugMode) {
            hitArea.style.border = '2px solid black';
          }
        });

        hitArea.addEventListener('mouseleave', () => {
          removeWedgeHoverEffect(wedge);

          // Reset border in debug mode
          if (debugMode) {
            hitArea.style.border = '1px solid ' + debugColors[index].replace('0.3', '1');
          }
        });

        // Click listener with Adobe Analytics tracking
        hitArea.addEventListener('click', (e) => {
          e.preventDefault(); // Prevent default navigation

          // Get the analytics info for this wedge
          const configIndex = config.configIndex;
          const wedgeAnalytics = wedgeConfig[configIndex].analytics;
          const destination = wedgeConfig[configIndex].url;

          // Create a link element with the analytics attributes
          const analyticsLink = document.createElement('a');
          analyticsLink.href = destination;
          analyticsLink.setAttribute('data-link-name', wedgeAnalytics.linkName);
          analyticsLink.setAttribute('data-link-position', wedgeAnalytics.linkPosition);

          // Make links open in a new window
         // analyticsLink.setAttribute('target', '_blank');
          analyticsLink.setAttribute('rel', 'noopener noreferrer');

          // Make it invisible and append to body
          analyticsLink.style.position = 'absolute';
          analyticsLink.style.opacity = '0';
          document.body.appendChild(analyticsLink);

          // Click it and remove it
          analyticsLink.click();

          // Clean up the element after a short delay
          setTimeout(() => {
            document.body.removeChild(analyticsLink);
          }, 100);
        });
      }
    });

    // Add CSS to ensure wedges don't interfere with hit areas
    const style = document.createElement('style');
    style.textContent = `
      [id^="new-wedge"], [id^="new-wedge"] * {
        pointer-events: none !important;
      }
      .wedge-hit-area {
        pointer-events: auto !important;
      }
    `;
    document.head.appendChild(style);

    // Add debug toggle controls
    if (debugMode) {
      // Create toggle button
      const toggleBtn = document.createElement('button');
      toggleBtn.textContent = 'Hide Debug Boxes';
      toggleBtn.style.position = 'fixed';
      toggleBtn.style.bottom = '10px';
      toggleBtn.style.right = '10px';
      toggleBtn.style.zIndex = '1000';
      toggleBtn.style.padding = '8px 16px';
      toggleBtn.style.backgroundColor = '#007BFF';
      toggleBtn.style.color = 'white';
      toggleBtn.style.border = 'none';
      toggleBtn.style.borderRadius = '4px';
      toggleBtn.style.cursor = 'pointer';

      toggleBtn.addEventListener('click', toggleDebugMode);
      document.body.appendChild(toggleBtn);

      // Add instructions text
      const instructions = document.createElement('div');
      instructions.innerHTML = `
        <div style="position: fixed; top: 10px; right: 10px; background: rgba(255,255,255,0.9); 
                    padding: 10px; border-radius: 5px; max-width: 300px; z-index: 1000; 
                    box-shadow: 0 0 10px rgba(0,0,0,0.2);">
          <h3 style="margin-top: 0;">Hit Area Debug Mode</h3>
          <p>Each colored box represents a hit area for a wedge.</p>
          <p>To adjust hit areas, use the browser console with these commands:</p>
          <code style="display: block; background: #f5f5f5; padding: 5px; margin: 5px 0;">
            // Adjust wedge 3 hit area<br>
            adjustHitArea('wedge3-hit-area', {<br>
              &nbsp;&nbsp;width: '110px',<br>
              &nbsp;&nbsp;left: '105px',<br>
              &nbsp;&nbsp;clipPath: 'polygon(0 0, 100% 0, 90% 100%, 0 100%)'<br>
            });
          </code>
          <p>Press the button below or type <code>toggleDebugMode()</code> in console to hide/show debug boxes</p>
        </div>
      `;
      document.body.appendChild(instructions);

      // Expose helper functions to window for console usage
      window.toggleDebugMode = toggleDebugMode;
      window.adjustHitArea = adjustHitArea;
    }
  }

  // Function to toggle debug mode
  function toggleDebugMode() {
    debugMode = !debugMode;
    document.querySelectorAll('.wedge-hit-area').forEach((hitArea, index) => {
      if (debugMode) {
        // Show debug styling
        hitArea.style.backgroundColor = debugColors[hitArea.dataset.wedgeIndex];
        hitArea.style.border = '1px solid ' + debugColors[hitArea.dataset.wedgeIndex].replace('0.3', '1');

        // Add label if it doesn't exist
        if (!hitArea.querySelector('.hit-area-label')) {
          const label = document.createElement('div');
          label.className = 'hit-area-label';
          label.textContent = `${parseInt(hitArea.dataset.wedgeIndex) + 1}: ${wedgeConfig[hitArea.dataset.wedgeIndex].name}`;
          label.style.position = 'absolute';
          label.style.top = '5px';
          label.style.left = '5px';
          label.style.color = '#000';
          label.style.fontWeight = 'bold';
          label.style.fontSize = '10px';
          label.style.backgroundColor = 'rgba(255, 255, 255, 0.7)';
          label.style.padding = '2px';
          label.style.borderRadius = '3px';
          hitArea.appendChild(label);
        }
      } else {
        // Hide debug styling
        hitArea.style.backgroundColor = 'transparent';
        hitArea.style.border = 'none';

        // Remove label
        const label = hitArea.querySelector('.hit-area-label');
        if (label) {
          label.remove();
        }
      }
    });

    // Update toggle button text
    const toggleBtn = document.querySelector('button');
    if (toggleBtn) {
      toggleBtn.textContent = debugMode ? 'Hide Debug Boxes' : 'Show Debug Boxes';
    }

    // Show/hide instructions
    const instructions = document.querySelector('div[style*="position: fixed"]');
    if (instructions) {
      instructions.style.display = debugMode ? 'block' : 'none';
    }

    console.log(`Debug mode ${debugMode ? 'enabled' : 'disabled'}`);
  }

  // Function to adjust hit area properties
  function adjustHitArea(id, styles) {
    const hitArea = document.getElementById(id);
    if (!hitArea) {
      console.error(`Hit area with ID "${id}" not found`);
      return;
    }

    // Apply styles
    Object.keys(styles).forEach(prop => {
      hitArea.style[prop] = styles[prop];
    });

    console.log(`Adjusted hit area: ${id}`);
    console.log('New styles:', styles);
  }

  function applyWedgeHoverEffect(wedgeWrapper) {
    if (!wedgeWrapper) return;

    // Select elements we need to modify
    const textPaths = wedgeWrapper.querySelectorAll('path[fill="white"]');
    const iconPaths = wedgeWrapper.querySelectorAll('path[stroke="white"][stroke-width="1.08"]');
    const circlePath = wedgeWrapper.querySelector('path[d*="C"][stroke="#96DAEA"]');

    // More robust wedge path selector - select the large path that is not the circle
    const allPaths = wedgeWrapper.querySelectorAll('path[stroke="#96DAEA"]');
    let wedgePath = null;

    // Find the path that is not the circle (usually has longer path data)
    allPaths.forEach(path => {
      const d = path.getAttribute('d');
      // If this path has a long, complex path data
      if (d && (d.length > 100 || !d.startsWith('M'))) {
        if (d.includes('L') || d.includes('Z')) { // Wedge paths typically have line segments
          wedgePath = path;
        }
      }
    });

    // If we still didn't find it, try an alternative approach
    if (!wedgePath && allPaths.length > 1) {
      // Take any path that's not the circle
      wedgePath = Array.from(allPaths).find(path => path !== circlePath);
    }

    // Final fallback - try a more direct attribute selector
    if (!wedgePath) {
      wedgePath = wedgeWrapper.querySelector('path[stroke="#96DAEA"][stroke-width="0.86"]:not([d*="C"])');
    }

    // 1. Make the main wedge path white and bold
    if (wedgePath) {
      wedgePath.setAttribute('stroke', '#fff');
      wedgePath.setAttribute('stroke-width', '2');
      wedgePath.style.transition = 'stroke 0.3s ease, stroke-width 0.3s ease';
    }

    // 2. Make text paths bolder with thicker stroke
    textPaths.forEach(path => {
      path.setAttribute('stroke', 'white');
      path.setAttribute('stroke-width', '0.5');
      path.setAttribute('paint-order', 'stroke');
    });

    // 3. Make the entire icon grow but DO NOT change the circle stroke width
    if (circlePath) {
      circlePath.style.transform = 'scale(1.15)';
      circlePath.style.transformOrigin = 'center';
      circlePath.style.transition = 'transform 0.3s ease';
    }

    // 4. Make all icon paths grow but DO NOT change their stroke width
    iconPaths.forEach(path => {
      path.style.transform = 'scale(1.15)';
      path.style.transformOrigin = 'center';
      path.style.transition = 'transform 0.3s ease';
    });
  }

  function removeWedgeHoverEffect(wedgeWrapper) {
    if (!wedgeWrapper) return;

    const textPaths = wedgeWrapper.querySelectorAll('path[fill="white"]');
    const iconPaths = wedgeWrapper.querySelectorAll('path[stroke="white"][stroke-width="1.08"]');
    const circlePath = wedgeWrapper.querySelector('path[d*="C"][stroke="#96DAEA"]');

    // Use the same approach to find the wedge path
    const allPaths = wedgeWrapper.querySelectorAll('path[stroke="#fff"], path[stroke="#96DAEA"]');
    let wedgePath = null;

    allPaths.forEach(path => {
      // Find paths that already have white stroke or have the original blue stroke
      if (path.getAttribute('stroke') === '#fff' || 
          (path.getAttribute('stroke') === '#96DAEA' && 
           path !== circlePath)) {
        wedgePath = path;
      }
    });

    // Fallback if we didn't find it that way
    if (!wedgePath) {
      wedgePath = wedgeWrapper.querySelector('path[stroke="#fff"], path[stroke-width="2"]');
    }

    // 1. Restore wedge path
    if (wedgePath) {
      wedgePath.setAttribute('stroke', '#96DAEA');
      wedgePath.setAttribute('stroke-width', '0.86');
    }

    // 2. Remove bold effect from text
    textPaths.forEach(path => {
      path.removeAttribute('stroke');
      path.removeAttribute('stroke-width');
      path.removeAttribute('paint-order');
    });

    // 3. Return icon to normal size
    if (circlePath) {
      circlePath.style.transform = 'scale(1)';
    }

    // 4. Return icon paths to normal size
    iconPaths.forEach(path => {
      path.style.transform = 'scale(1)';
    });
  }
});
</script>

</body>
</html>

  
