        <style>
@media screen and (min-width: 768px) {

#use-case-sec-tile {
  margin-top: -40px;
}

/* Move the header image to bottom-right*/
#slider-component .infa-c-card__with-full-header-image .infa-c-card__header--image,
#use-case-sec-tile .infa-c-card__with-full-header-image .infa-c-card__header--image {
    position: absolute !important;
    bottom: 20px !important;
    right: -20px !important; /* Shift right to crop */
    top: auto !important;
    width: 200px !important;
    height: auto !important;
    max-width: none !important; /* Allow overflow */
    max-height: 100% !important;
    z-index: 0 !important;
    /* opacity: 0.5; */ /* Removed opacity */
}

/* Ensure the card container allows for absolute positioning AND clips overflow */
#slider-component .infa-c-card__with-full-header-image,
#use-case-sec-tile .infa-c-card__with-full-header-image {
    position: relative !important;
    overflow: hidden !important; /* This clips the overflowing image */
}

#slider-component .infa-c-card__with-full-header-image .infa-c-card__content,
#use-case-sec-tile .infa-c-card__with-full-header-image .infa-c-card__content {
    padding-right: 0 !important;
    padding-bottom: 0 !important;
    display: flex !important;
    flex-direction: column !important;
    justify-content: space-between !important;
    height: 100% !important;
    position: relative !important;
    z-index: 2 !important; /* Above image */
}

/* Keep copy at top */
#slider-component .infa-c-card__with-full-header-image .infa-c-card__title,
#slider-component .infa-c-card__with-full-header-image .infa-c-card__description,
#use-case-sec-tile .infa-c-card__with-full-header-image .infa-c-card__title,
#use-case-sec-tile .infa-c-card__with-full-header-image .infa-c-card__description {
    margin-bottom: auto !important;
    position: relative !important;
    z-index: 3 !important; /* Above image */
}

/* Position CTA at bottom-left */
#slider-component .infa-c-card__with-full-header-image .infa-c-card__cta,
#use-case-sec-tile .infa-c-card__with-full-header-image .infa-c-card__cta {
    align-self: flex-start !important;
    margin-top: auto !important;
    position: relative !important;
    z-index: 3 !important; /* Above image */
}

#slider-component .infa-c-card.clickable-tile.has-enable-hover.infacom-accessibility.infa-c-card__image-variation.infa-c-card__with-full-header-image.has-fixed-height.click-cursor,
#use-case-sec-tile .infa-c-card.clickable-tile.has-enable-hover.infacom-accessibility.infa-c-card__image-variation.infa-c-card__with-full-header-image.has-fixed-height.click-cursor {
  max-height: 270px;
}
}

@media screen and (max-width: 1199px) and (min-width: 992px) {
#slider-component .infa-c-card,
#use-case-sec-tile .infa-c-card {
    max-height: 420px !important;
}

#slider-component .infa-c-card.has-fixed-height,
#use-case-sec-tile .infa-c-card.has-fixed-height {
    height: 320px !important;
}

/* Override specific properties for this breakpoint */
#slider-component .infa-c-card__with-full-header-image .infa-c-card__header--image,
#use-case-sec-tile .infa-c-card__with-full-header-image .infa-c-card__header--image {
    bottom: 40px !important;
    width: 160px !important; 
}
}

@media screen and (max-width: 767px) {

#use-case-sec-tile {
  margin-top: -40px;
}

#slider-component .infa-tile::after,
#use-case-sec-tile .infa-tile::after {
    border-bottom: none !important;
}

#slider-component .infa-c-card.clickable-tile.has-enable-hover.infacom-accessibility.infa-c-card__image-variation.infa-c-card__with-full-header-image.has-fixed-height.click-cursor,
#use-case-sec-tile .infa-c-card.clickable-tile.has-enable-hover.infacom-accessibility.infa-c-card__image-variation.infa-c-card__with-full-header-image.has-fixed-height.click-cursor {
  max-height: 90px !important;
}

}
</style>

