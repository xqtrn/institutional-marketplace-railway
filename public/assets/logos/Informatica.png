<body>
    <div class="leading-brands-component">
        <!-- Header Text -->
        <h1 class="header-text">Leading brands unlock value with trusted,<br>AI-powered data</h1>

        <!-- Main Content Container -->
        <div class="content-container">
            <!-- Top Border -->
            <div class="top-border"></div>

            <!-- Icon Container (Tabs) -->
            <div class="icon-container">
                <button class="tab-icon active" data-company="citizens" role="tab" aria-selected="true" tabindex="0">
                    <img src="/content/dam/informatica-com/en/images/cc02v2/cc02v2-citizens-bank.svg" alt="Citizens"/>
                </button>
                <button class="tab-icon" data-company="petmate" role="tab" aria-selected="false" tabindex="-1">
                    <img src="/content/dam/informatica-com/en/images/cc02v2/cc02v2-petmate.svg" alt="Petmate"/>
                </button>
                <button class="tab-icon" data-company="holiday-inn" role="tab" aria-selected="false" tabindex="-1">
                    <img src="/content/dam/informatica-com/en/images/cc02v2/cc02v2-holiday-inn-club-vacations.svg" alt="Holiday Inn Club Vacation"/>
                </button>
                <button class="tab-icon" data-company="subaru" role="tab" aria-selected="false" tabindex="-1">
                    <img src="/content/dam/informatica-com/en/images/cc02v2/cc02v2-subaru.svg" alt="Subaru"/>
                </button>
                <button class="tab-icon" data-company="mabe" role="tab" aria-selected="false" tabindex="-1">
                    <img src="/content/dam/informatica-com/en/images/cc02v2/cc02v2-mabe.svg" alt="MABE"/>
                </button>
            </div>

            <!-- Content Area -->
            <div class="content-area">
                <!-- Left Side - Placeholder Image -->
                <div class="left-content">
                    <img class="tab-image active" data-image="citizens" src="/content/dam/informatica-com/en/images/misc/hp-citizens-customer-section.jpg" alt="Citizens Bank Image"/>
                    <img class="tab-image" data-image="petmate" src="/content/dam/informatica-com/en/images/misc/hp-petmate-customer-section.jpg" alt="Petmate Image"/>
                    <img class="tab-image" data-image="holiday-inn" src="/content/dam/informatica-com/en/images/misc/hp-holiday-inn-customer-section.jpg" alt="Holiday Inn Image"/>
                    <img class="tab-image" data-image="subaru" src="/content/dam/informatica-com/en/images/misc/hp-subaru-customer-section.jpg" alt="Subaru Image"/>
                    <img class="tab-image" data-image="mabe" src="/content/dam/informatica-com/en/images/misc/hp-mabe-customer-section.jpg" alt="MABE Image"/>
                </div>

                <!-- Right Side - Tab Content -->
                <div class="right-content">
                    <div class="slider-container">
                        <!-- Citizens Content -->
                        <div class="tab-content active" data-content="citizens" role="tabpanel">
                            <div class="company-logo">
                                <img src="/content/dam/informatica-com/en/images/cc02v2/cc02v2-citizens-bank.svg" alt="Citizens Bank"/>
                            </div>

                            <h2 class="main-headline">Citizens Bank's cloud MDM modernization<br>pays off</h2>

                            <div class="cta-refresh leading-brands-cta aem-GridColumn aem-GridColumn--default--12">
                                <section class="container">
                                    <div class="www-cta-refresh">
                                        <div class="infacom-cta-margin-top-0">
                                            <div class="infacom-cta-refresh">
                                                <span class="infa-o-cta__primary infacom-cta-left">
                                                    <a class="infacom-cta-link infa-o-cta__link infa-o-cta__link--orange-4 infa-o-cta__link--right infa-o-cta__special-label" href="/about-us/customers/customer-success-stories/citizens.html" data-link-name="read-the-story" data-link-position="citizens-story">
                                                        Read the Story
                                                        <i aria-hidden="true" class="infa-o-cta__arrow infacom-arrow-right infacom-right-arrow-content infa-o-cta__link--right">
                                                            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                                                                <rect width="24" height="24" fill="none"></rect>
                                                                <path d="M13.3333 5L20 12M20 12L13.3333 19M20 12L4 12" stroke="#E23400" stroke-width="2" stroke-linecap="round"></path>
                                                            </svg>
                                                        </i>
                                                    </a>
                                                </span>
                                            </div>
                                        </div>
                                    </div>
                                </section>
                            </div>

                            <div class="statistics-section">
                                <div class="stat-group">
                                    <div class="stat-number">85%</div>
                                    <div class="stat-description">faster data onboarding</div>
                                </div>
                                <div class="stat-group">
                                    <div class="stat-number">99.95%</div>
                                    <div class="stat-description">uptime and elastic scale</div>
                                </div>
                            </div>
                        </div>

                        <!-- Petmate Content -->
                        <div class="tab-content" data-content="petmate" role="tabpanel">
                            <div class="company-logo">
                                <img src="/content/dam/informatica-com/en/images/cc02v2/cc02v2-petmate.svg" alt="Petmate"/>
                            </div>

                            <h2 class="main-headline">Petmate fetches a winning cloud data strategy</h2>

                            <div class="cta-refresh leading-brands-cta aem-GridColumn aem-GridColumn--default--12">
                                <section class="container">
                                    <div class="www-cta-refresh">
                                        <div class="infacom-cta-margin-top-0">
                                            <div class="infacom-cta-refresh">
                                                <span class="infa-o-cta__primary infacom-cta-left">
                                                    <a class="infacom-cta-link infa-o-cta__link infa-o-cta__link--orange-4 infa-o-cta__link--right infa-o-cta__special-label" href="/about-us/customers/customer-success-stories/petmate.html" data-link-name="read-the-story" data-link-position="petmate-story">
                                                        Read the Story
                                                        <i aria-hidden="true" class="infa-o-cta__arrow infacom-arrow-right infacom-right-arrow-content infa-o-cta__link--right">
                                                            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
