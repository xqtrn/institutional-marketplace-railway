<title>Informatica Cloud</title>
<style>
  
     /* Device visibility control - put this FIRST */
    .desktop-only {
        display: block;
    }
    .tablet-mobile-only {
        display: none;
    }
    
    @media (max-width: 991px) {
        .desktop-only {
            display: none !important;
        }
        .tablet-mobile-only {
            display: block;
        }
    }
* {
  margin: 0;
  padding: 0;
  box-sizing: border-box;
}

body {
  font-family:
    Roboto,
    -apple-system,
    Helvetica,
    sans-serif;
}

.cloud-showcase {
  background-color: #fff;
  display: flex;
  padding: 50px 0;
  flex-direction: column;
  overflow: hidden;
  align-items: center;
  justify-content: center;
}

.content-container {
  width: 100%;
  max-width: 1233px;
  display: flex;
  flex-direction: column;
  margin: 0 auto;
}

.hero-section {
  display: flex;
  flex-direction: column;
  position: relative;
  min-height: 593px;
  width: 100%;
  align-items: center;
  color: #eaf7fa;
  background: url("https://www.informatica.com/content/dam/informatica-com/en/images/misc/idmc-graphic-bg.png")
              center / contain no-repeat;
}

/* Claire logo container */
.claire-logo-container {
  position: absolute;
  top: 25px;
  left: 50%;
  transform: translateX(-50%);
  width: 160px;
  z-index: 5;
  text-align: center;
}

.claire-logo {
  width: 100%;
  height: auto;
  display: block;
  margin: 0 auto;
}

/* Copilots arc text */
.copilots-arc-container {
  position: absolute;
  top: 50px;
  left: 50%;
  transform: translateX(-50%);
  width: 100%;
  max-width: 450px;
  pointer-events: none;
  z-index: 6;
}
  
  .services-text-svg {
  width: 400px;
  height: 60px;
  margin: 0 auto;
  display: block;
  overflow: visible;
  position: relative;
}

.services-text-svg svg {
  position: absolute;
  top: 40px !important;
  left: 0;
  transform: scale(1.7); /* Adjust scale as needed */
  width: 400px;
  height: auto;
}

/* Services arc text */
.services-arc-container {
  position: absolute;
  top: 45px;
  left: 50%;
  transform: translateX(-50%);
  width: 100%;
  max-width: 400px;
  pointer-events: none;
  z-index: 10;
}

.metadata-container {
  position: relative;
  display: flex;
  flex-direction: column;
  width: 666px;
  max-width: 100%;
  padding: 2px 80px 35px;
  margin-top: 0;
  min-height: 326px;
  align-items: center;
  overflow: visible;
  z-index: 2;
}

.metadata-svg {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  transform: translateY(140px);
  z-index: 1;
}

.metadata-title {
  position: absolute;
  bottom: -100px;
  left: 50%;
  transform: translateX(-50%);
  width: 100%;
  margin: 0;
  color: #ff8435;
  font-size: 34px;
  font-weight: 500;
  line-height: 1;
  text-align: center;
  z-index: 1;
}

.light-text {
  display: block;
  margin-top: 5px;
  color: white;
  font-size: 24px;
  font-weight: 300;
}

.cloud-title-container {
  position: relative;
  display: flex;
  align-self: stretch;
  justify-content: center;
  align-items: center;
  margin-top: 125px;
  padding: 15px 5px 5px 20px;
  width: 100%;
  z-index: 3;
}

.cloud-title {
  color: white;
  font-size: 51.916px;
  font-weight: 500;
  line-height: 1;
  text-align: center;
}

.trademark {
  font-size: 10px;
  font-weight: 600;
  vertical-align: top;
  color: white;
  position: relative;
  left: 5px;
}

.feature-bar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  width: 100%;
  max-width: 949px;
  margin: -15px auto 0;
  padding: 0;
  background-color: white;
  border: 1px solid #12c1e5;
  font-size: 18px;
  line-height: 24px;
  color: #0b1345;
  font-weight: 400;
  z-index: 10;
  border: none;
  border-top: 1px solid #12c1e5;
  border-bottom: 1px solid #12c1e5;
 position: relative;
}
  
  /* Add disconnected side borders */
.feature-bar:before,
.feature-bar:after {
  content: '';
  position: absolute;
  width: 1px;
  background-color: #12c1e5;
  top: 10px; /* This creates the 10px gap */
  bottom: 0;
}

.feature-bar:before {
  left: 0;
}

.feature-bar:after {
  right: 0;
}

.feature-item {
  flex-grow: 1;
  padding: 15px 10px;
  text-align: center;
  position: relative;
}

.feature-item:not(:last-child)::after {
  content: '';
  position: absolute;
  right: 0;
  top: 50%;
  transform: translateY(-50%);
  width: 1px;
  height: 80px;
  background: #12c2e5;
}
  

/* ────────────────────────────────────────────────────────
   Wedge hit area styles
   ──────────────────────────────────────────────────────── */

.svg-container {
  position: relative;
  width: 666px;
  height: 327px;
}

/* Ensure the SVG container doesn't block events */
.metadata-svg {
  pointer-events: none;
}


  

  




/* Wedge wrapper styling */
[id^="new-wedge"] {
  position: absolute;
  z-index: 30;
  cursor: pointer;
}
  
  

#new-wedge1-wrapper {
    bottom: -141px;
    left: 5px;
}



#new-wedge2-wrapper {
  bottom: -65px;
  left: 32px;
}

#new-wedge3-wrapper {
  bottom: 2px;
  left: 105px;
}


#new-wedge4-wrapper {
    bottom: 45px;
    left: 214px;
}

#new-wedge5-wrapper {
    bottom: 44px;
    left: 341px;
}


#new-wedge6-wrapper
 {
    top: 171px;
    left: 420px;

}

#new-wedge7-wrapper
 {
  bottom: -67px;
  right: 24px;
}

#new-wedge8-wrapper {
  bottom: -142px;
  right: -3px;
}
  
  .services-text-svg {
  width: 400px;
  height: 60px;
  margin: 0 auto;
  display: block;
  overflow: visible;
  position: relative;
}

.services-text-svg svg {
  position: absolute;
top:15px;
  left: 0;
  transform: scale(1.7); /* Adjust scale as needed */
  width: 400px;
  height: auto;
}
  
 

/* ────────────────────────────────────────────────────────
   Responsive tweaks
   ──────────────────────────────────────────────────────── */

@media (max-width: 991px) {
  .cloud-showcase { padding: 50px 20px; }
  .metadata-container { padding: 2px 20px 35px; }
  .metadata-title { bottom: -100px; }
  .cloud-title { font-size: 30px; }
  .svg-container { width: 100%; height: auto; }
  [id^="new-wedge"]:not(#new-wedge1-wrapper):not(#new-wedge2-wrapper) { transform: scale(0.8); }
  #new-wedge3-wrapper, #new-wedge6-wrapper {
    transform: translateY(-50%) scale(0.8);
  }
}
  
  /* -------------------------------------------------------
  Tablet Styles
  ---------------------------------------------------------- */
    

        .idmc-body {
            margin: 0 auto;
            overflow-x: hidden;
        }

        .idmc-container {
            max-width: 991px;
            margin: 0 auto;
        }

        /* Header section with gradient background */
        .idmc-header {
  background: linear-gradient(180deg, #36B0C9 -18.76%, #339EC1 -16.26%, #307CB3 -10.27%, #2D63AA -4.78%, #2B55A4 0.21%, #2B50A2 4.21%, #24458F 12.7%, #1F3C81 22.68%, #1E397C 31.17%);
    padding: 20px;
    text-align: center;
    display: flex;
    align-items: center;
    justify-content: center;
}

        .idmc-header-title {
            color: #FFF;
            font-size: 36px;
            font-weight: 500;
            line-height: 34.611px;
            text-align: center;
            position: relative;
            display: inline-block;
        }
      
      
.idmc-title-words {
    display: inline-block;
}

.idmc-cloud-wrapper {
    display: inline-block;
    white-space: nowrap;
}

        .idmc-trademark {
 font-size: 12px;
    vertical-align: super;
    position: relative; /* Change from absolute to relative */
    top: -5px;
    margin-left: 10px;
    
        }

        .idmc-cloud-trademark {
            white-space: nowrap !important;
        }

        /* CLAIRE background wrapper */
        .idmc-claire-bg-wrapper {
            background: linear-gradient(180deg, #36B0C9 -12.31%, #3293BD -7.63%, #2F75B1 -1.78%, #2C60A8 4.65%, #2B54A3 10.51%, #2B50A2 15.77%, #24458F 25.13%, #1F3C81 36.25%, #1E397C 45.02%);
        }

        /* Claire logo section */
      .idmc-claire-section {
    background: none;
    padding: 20px;
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
}

        .idmc-claire-logo {
            width: 135.033px;
            height: 24.81px;
            margin: 0 auto;
            display: block;
        }

        .idmc-claire-section p {
            color: #FFF;
            font-size: 36px;
            font-weight: 300;
            text-align: center;
            margin-top: 15px;
            letter-spacing: 2px;
        }

        /* Services section with card background */
        .idmc-services-wrapper {
            background: none;
            padding: 0 20px;
        }

        .idmc-services-section {
            background: linear-gradient(0deg, #6CD2E7 -11.96%, #0080A2 28.53%);
    filter: drop-shadow(0px 0px 21.918px rgba(0, 0, 0, 0.75));
    padding: 40px 20px;
    margin: 0 auto;
}

        .idmc-services-title-container {
            display: flex;
            align-items: center;
            justify-content: center;
            margin-bottom: 30px;
        }

        .idmc-title-line {
            height: 1px;
            background-color: #9AE5F4;
            flex: 1;
        }

        .idmc-services-title {
            color: white;
            text-align: center;
            font-size: 24px;
            font-weight: 500;
            margin: 0 20px;
            white-space: nowrap;
        }

        .idmc-service-box {
           display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 15px;
    margin-bottom: 15px;
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid #9ae5f4;
    border-radius: 4px;
}

        .idmc-service-text p {
            display: flex;
            width: 170px;
            transform: rotate(0.333deg);
            flex-direction: column;
            justify-content: center;
            align-self: stretch;
            color: #FFF;
            font-family: Roboto;
            font-size: 16px;
            font-style: normal;
            font-weight: 400;
            line-height: 22px;
        }

        .idmc-service-text-content {
            margin: 0;
            padding: 0;
        }

        .idmc-service-text-wide {
            width: 170px; /* Increased width for longer text */
        }

        .idmc-service-icon {
            width: 52.164px;
            height: 52.164px;
        }

        /* Metadata section */
     .idmc-metadata-section {
    background: linear-gradient(180deg, #36B0C9 -18.76%, #339EC1 -16.26%, #307CB3 -10.27%, #2D63AA -4.78%, #2B55A4 0.21%, #2B50A2 4.21%, #24458F 12.7%, #1F3C81 22.68%, #1E397C 31.17%);
    padding: 20px;
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
}

        .idmc-metadata-title {
            font-size: 36px;
            color: #FF8435;
            font-weight: 500;
            text-align: center;
            width: 100%;
            max-width: 274.763px;
            margin: 0 auto;
        }

        .idmc-metadata-subtitle {
            font-size: 30px;
            color: #FFF;
            font-weight: 300;
            margin-top: 5px;
            text-align: center;
            width: 100%;
            max-width: 506px;
            margin: 5px auto 0;
        }

        /* Feature bar */
        .idmc-footer-section {
            background-color: white;
            padding: 0;
            margin: 0 auto;
            border: 1px solid #12C2E5;
            color: #0b1345;
        }

        .idmc-footer-item {
            padding: 15px 0;
            text-align: center;
            font-size: 18px;
            font-weight: 400;
            position: relative;
        }

        .idmc-footer-item:after {
            content: '';
            position: absolute;
            bottom: 0;
            left: 50%;
            transform: translateX(-50%);
            width: 900px;
            max-width: 95%;
            height: 1px;
            background-color: #12C2E5;
        }

        .idmc-footer-item:last-child:after {
            display: none;
        }
      
/* Enhanced animation for service boxes with slower timing */
.idmc-service-box {
  opacity: 0;
  transform: scaleX(0.5) scaleY(0.8);
  transform-origin: center center;
  transition: opacity 1.2s cubic-bezier(0.17, 0.67, 0.26, 1.01), 
              transform 1.2s cubic-bezier(0.17, 0.67, 0.26, 1.01);
  position: relative;
  overflow: hidden;
}

.idmc-service-box::before {
  content: '';
  position: absolute;
  top: 0;
  left: 50%;
  width: 0;
  height: 100%;
  background: rgba(255, 255, 255, 0.03);
  transform: translateX(-50%);
  transition: width 1s ease-out;
  z-index: -1;
}

.idmc-service-box.visible {
  opacity: 1;
  transform: scale(1);
}

.idmc-service-box.visible::before {
  width: 100%;
}

/* Add a slight delay for each subsequent box - increased delays */
.idmc-service-box:nth-child(1) {
  transition-delay: 0.15s;
}
.idmc-service-box:nth-child(2) {
  transition-delay: 0.3s;
}
.idmc-service-box:nth-child(3) {
  transition-delay: 0.45s;
}
.idmc-service-box:nth-child(4) {
  transition-delay: 0.6s;
}
.idmc-service-box:nth-child(5) {
  transition-delay: 0.75s;
}
.idmc-service-box:nth-child(6) {
  transition-delay: 0.9s;
}
.idmc-service-box:nth-child(7) {
  transition-delay: 1.05s;
}
.idmc-service-box:nth-child(8) {
  transition-delay: 1.2s;
}

/* Enhance animation for the content inside service boxes */
.idmc-service-text, .idmc-service-icon {
  opacity: 0;
  transform: translateY(10px);
  transition: opacity 0.9s ease-out 0.3s, 
              transform 0.9s ease-out 0.3s;
}

.idmc-service-box.visible .idmc-service-text,
.idmc-service-box.visible .idmc-service-icon {
  opacity: 1;
  transform: translateY(0);
}

/* Service icon animates slightly after the text */
.idmc-service-box.visible .idmc-service-icon {
  transition-delay: 0.5s;
}
/* Simple and direct approach - scoped to component only */
.idmc-services-wrapper .idmc-service-box-link,
.idmc-services-wrapper .idmc-service-box-link a {
    display: initial;
    text-decoration: none !important;
    color: inherit;
}

/* Keep the margin on the box itself */
.idmc-service-box {
    margin-bottom: 15px;
}

/* Active/clicked state with increased border */
.idmc-service-box-link:active .idmc-service-box,
.idmc-service-box-link:focus .idmc-service-box {
    border-width: 3px;
    border-color: #fff;
    box-shadow: 0 0 15px rgba(154, 229, 244, 0.5);
}

/* Hover state */
.idmc-service-box-link:hover .idmc-service-box {
    border-color: #fff;
    box-shadow: 0 0 10px rgba(154, 229, 244, 0.3);
}
/* Make SVG paths brighter on hover */
.idmc-service-box-link:hover .idmc-service-icon svg path {
    stroke: #ffffff; /* Brighter white */
    transition: all 0.3s ease;
}

/* Make SVG paths even brighter and thicker on click/focus */
.idmc-service-box-link:active .idmc-service-icon svg path,
.idmc-service-box-link:focus .idmc-service-icon svg path {
    stroke: #ffffff;
    stroke-width: 1.8px; /* Slightly thicker */
    filter: drop-shadow(0 0 3px rgba(255, 255, 255, 0.7)); /* Light glow */
}



        /* Media Queries */

@media screen and (min-width: 768px) and (max-width: 1199px) {
.feature-bar {

  margin: -20px auto 0 !important;

  position: relative;
}

}
        @media (min-width: 768px) and (max-width: 991px) {
            .idmc-container {
                max-width: 750px;
            }

            .idmc-services-section {
                max-width: 710px; /* 750px - 40px (20px gap on each side) */
            }
        }

       
@media (max-width: 767px) {
    .idmc-container {
        max-width: 500px;
    }

    .idmc-header-title {
        font-size: 28px;
    }

    .idmc-claire-section p {
        font-size: 26px;
    }

    .idmc-claire-logo {
        width: 120px;
        height: auto;
    }

    .idmc-services-section {
        max-width: 460px; /* 500px - 40px (20px gap on each side) */
    }

    .idmc-services-title {
        font-size: 20px;
    }

    .idmc-service-text {
        font-size: 14px;
        line-height: 20px;
    }

    .idmc-service-icon {
        width: 42px;
        height: 42px;
        margin-right: 20px; /* Add this line to move icons from the right edge */
    }

    /* Alternatively, you can adjust the service box padding */
    .idmc-service-box {
        padding: 15px 35px 15px 15px; /* Increase right padding */
    }

    .idmc-metadata-title {
        font-size: 28px;
        max-width: 220px;
    }

    .idmc-metadata-subtitle {
        font-size: 22px;
        max-width: 400px;
    }

    .idmc-footer-item {
        font-size: 16px;
        padding: 12px 0;
    }

    .idmc-footer-item:after {
        width: 460px;
    }
}
      
 @media (max-width: 530px) {
    .idmc-cloud-wrapper {
        display: block;
        margin-top: 5px;
    }

    /* Fix any specificity issues by being more explicit */
    .idmc-header-title .idmc-cloud-wrapper {
        display: block !important;
    }

    .idmc-header-title .idmc-cloud-trademark {
        display: inline-block !important;
    }
}

/* Extra small screens */
@media (max-width: 400px) {
    /* Ensure the service box properly contains all elements */
    .idmc-service-box {
        display: flex;
        flex-wrap: nowrap;
        justify-content: space-between;
        padding: 15px 10px; /* Reduce horizontal padding */
        overflow: hidden; /* Prevent content from spilling out */
        position: relative; /* Create positioning context */
    }

    /* Make the SVG icon container more compact */
    .idmc-service-icon {
        width: 38px;
        height: 38px;
        min-width: 38px; /* Prevent shrinking below this size */
        margin-right: 0; /* Remove any right margin */
        margin-left: 5px; /* Small left margin */
        flex-shrink: 0; /* Prevent icon from shrinking */
    }

    /* Allow the text to adjust its width */
    .idmc-service-text {
        flex: 1; /* Allow text to take available space */
        font-size: 13px; /* Slightly smaller font */
        line-height: 18px;
        width: auto !important; /* Override fixed width */
        min-width: 90px; /* Ensure minimum readable width */
        max-width: calc(100% - 50px); /* Ensure space for icon */
    }

    .idmc-service-text-wide {
        width: auto !important;
        max-width: calc(100% - 50px);
    }

    /* Make SVG elements scale properly */
    .idmc-service-icon svg {
        width: 100%;
        height: 100%;
    }
}
