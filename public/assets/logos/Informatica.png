<!-- Slider Arrows (mobile only) -->
<div class="slider-arrows">
    <div class="slider-arrow slider-arrow-left">
        <svg width="25" height="25" viewBox="0 0 25 25" fill="none" xmlns="http://www.w3.org/2000/svg">
            <g clip-path="url(#clip0_37018_9164)">
                <circle cx="12.0659" cy="12.5649" r="12.0659" fill="#949494"/>
                <path fill-rule="evenodd" clip-rule="evenodd" d="M12.4903 11.5446L14.4052 9.36916C14.5629 9.19084 14.6514 8.94794 14.6514 8.69473C14.6514 8.44112 14.5629 8.19822 14.4052 8.0199C14.2487 7.84 14.036 7.73896 13.8141 7.73896C13.5922 7.73896 13.3795 7.84 13.223 8.0203L9.89307 11.8204C9.8173 11.9107 9.75807 12.0173 9.71846 12.1334C9.62923 12.3637 9.62923 12.626 9.71846 12.8558C9.75807 12.9723 9.8173 13.0789 9.89307 13.1693L13.223 16.9694C13.5495 17.3422 14.0787 17.3422 14.4052 16.9694C14.7314 16.5969 14.7314 15.993 14.4052 15.6205L12.4899 13.4451C12.2261 13.1693 11.8488 13.0195 11.8488 12.4948C11.8488 11.9702 12.3395 11.6651 12.4903 11.5446Z" fill="#101820"/>
            </g>
            <defs>
                <clipPath id="clip0_37018_9164">
                    <rect width="24.1318" height="24.1318" fill="white" transform="translate(0 0.5)"/>
                </clipPath>
            </defs>
        </svg>
    </div>
    <div class="slider-arrow slider-arrow-right">
        <svg width="25" height="25" viewBox="0 0 25 25" fill="none" xmlns="http://www.w3.org/2000/svg">
            <g clip-path="url(#clip0_37018_9168)">
                <circle cx="12.5014" cy="12.5649" r="12.0659" fill="#949494"/>
                <path fill-rule="evenodd" clip-rule="evenodd" d="M12.0558 13.661L10.1217 15.7936C9.96239 15.9685 9.87305 16.2066 9.87305 16.4548C9.87305 16.7034 9.96239 16.9415 10.1217 17.1163C10.2798 17.2927 10.4946 17.3918 10.7187 17.3918C10.9429 17.3918 11.1577 17.2927 11.3158 17.116L14.6791 13.3906C14.7556 13.3021 14.8154 13.1976 14.8554 13.0838C14.9455 12.8581 14.9455 12.6009 14.8554 12.3756C14.8154 12.2614 14.7556 12.1569 14.6791 12.0683L11.3158 8.343C10.986 7.97746 10.4515 7.97746 10.1217 8.343C9.79225 8.70815 9.79225 9.30017 10.1217 9.66532L12.0562 11.798C12.3227 12.0683 12.7037 12.2152 12.7037 12.7295C12.7037 13.2438 12.2081 13.5429 12.0558 13.661Z" fill="#101820"/>
            </g>
            <defs>
                <clipPath id="clip0_37018_9168">
                    <rect width="24.1318" height="24.1318" fill="white" transform="translate(0.437012 0.5)"/>
                </clipPath>
            </defs>
        </svg>
    </div>
</div>

        <!-- Gradient Area -->
        <div class="gradient-area"></div>
    </div>


<script>
class LeadingBrandsComponent {
  constructor() {
    this.iconWidth = 160;
    this.iconGap = 8;
    this.iconOriginalCount = 0;
    this.isMobile = window.innerWidth <= 767;
    this.currentActiveIndex = 0;

    this.tabIcons = [];
    this.tabContents = [];
    this.tabImages = [];
    this.topBorder = null;
    this.sliderContainer = null;
    this.iconContainer = null;
    this.iconTrack = null;

    this.init();
  }

  init() {
    this.cacheDom();
    this.setupIconTrack();
    this.cacheDom(); // re-query after creating track
    this.iconOriginalCount = this.tabIcons.length;
    this.setupEventListeners();
    this.setupKeyboardNavigation();
    this.initMobileSlider();
    this.setActiveTab(0);
  }

  cacheDom() {
    this.iconContainer = document.querySelector('.icon-container');
    this.iconTrack = this.iconContainer ? this.iconContainer.querySelector('.icon-track') : null;
    this.tabIcons = Array.from(this.iconTrack ? this.iconTrack.querySelectorAll('.tab-icon') : document.querySelectorAll('.tab-icon'));
    this.tabContents = Array.from(document.querySelectorAll('.tab-content'));
    this.tabImages = Array.from(document.querySelectorAll('.tab-image'));
    this.topBorder = document.querySelector('.top-border');
    this.sliderContainer = document.querySelector('.slider-container');
  }

  setupIconTrack() {
    if (!this.iconContainer) return;
    const existing = this.iconContainer.querySelector('.icon-track');
    if (existing) { this.iconTrack = existing; return; }
    const track = document.createElement('div');
    track.className = 'icon-track';
    const icons = Array.from(this.iconContainer.querySelectorAll('.tab-icon'));
    icons.forEach(i => track.appendChild(i));
    this.iconContainer.appendChild(track);
    this.iconTrack = track;
  }

  setupEventListeners() {
    // delegate clicks on iconTrack (no cloning)
    if (this.iconTrack) {
      this.iconTrack.addEventListener('click', (e) => {
        const btn = e.target.closest('.tab-icon');
        if (!btn) return;
        const index = this.tabIcons.indexOf(btn);
        if (index > -1) this.setActiveTab(index);
      });
    }

    // ensure arrows handled (in case arrows exist)
    const leftArrow = document.querySelector('.slider-arrow-left');
    const rightArrow = document.querySelector('.slider-arrow-right');
    if (leftArrow) leftArrow.addEventListener('click', (e) => { e.preventDefault(); this.slideLeft(); });
    if (rightArrow) rightArrow.addEventListener('click', (e) => { e.preventDefault(); this.slideRight(); });
  }

  setupKeyboardNavigation() {
    this.tabIcons.forEach((tab, index) => {
      tab.addEventListener('keydown', (e) => {
        if (e.key === 'ArrowRight') { e.preventDefault(); this.slideRight(); }
        else if (e.key === 'ArrowLeft') { e.preventDefault(); this.slideLeft(); }
        else if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); this.setActiveTab(index); }
      });
    });
  }

  initMobileSlider() {
    this.updateResponsiveMode();
    window.addEventListener('resize', () => {
      const prevMobile = this.isMobile;
      this.isMobile = window.innerWidth <= 767;
      
      // if changed between mobile/desktop, reset transforms and recalculate
      if (prevMobile !== this.isMobile) {
        this.cacheDom();
        this.iconOriginalCount = this.tabIcons.length;
        if (!this.isMobile) this.resetIconTrack();
        
        // Use timeout to ensure layout is stable before recalculating border
        setTimeout(() => {
          this.updateSliderPosition();
          this.updateIconContainerPosition();
          this.updateTopBorderPosition(this.currentActiveIndex);
        }, 100);
      } else {
        // Same mode, just update positions
        this.updateSliderPosition();
        this.updateIconContainerPosition();
        this.updateTopBorderPosition(this.currentActiveIndex);
      }
    });
  }

  // helper: get current translateX of iconTrack
  getIconTrackTranslate() {
    if (!this.iconTrack) return 0;
    const style = window.getComputedStyle(this.iconTrack);
    const transform = style.transform;
    if (!transform || transform === 'none') return 0;
    const match = transform.match(/matrix\(([^,]+),[^,]+,[^,]+,[^,]+,([^,]+),([^,]+)\)/) || transform.match(/matrix3d\(([^,]+),/);
    // fallback: parse translateX from matrix or just default 0
    try {
      const values = transform.split(/\(|\)|,/).filter(Boolean).map(s => s.trim());
      const last = parseFloat(values[values.length - 2]);
      if (!isNaN(last)) return last;
    } catch (e) {}
    return 0;
  }

  setIconTrackTranslate(x) {
    if (!this.iconTrack) return;
    this.iconTrack.style.transition = 'transform 0.3s ease';
    this.iconTrack.style.transform = `translateX(${Math.round(x)}px)`;
  }

  resetIconTrack() {
    if (!this.iconTrack) return;
    this.iconTrack.style.transition = 'none';
    this.iconTrack.style.transform = 'translateX(0)';
  }

  // Align active icon to the left edge, just like content area
  ensureIconVisible(index) {
    if (!this.isMobile || !this.iconContainer || !this.iconTrack) return;
    const icons = Array.from(this.iconTrack.querySelectorAll('.tab-icon'));
    if (!icons[index]) return;

    // Calculate the position to align the active icon to the left edge
    let targetTranslate = 0;
    
    // Sum up the widths of all icons before the active one to move them off-screen
    for (let i = 0; i < index; i++) {
      const iconRect = icons[i].getBoundingClientRect();
      targetTranslate -= (iconRect.width + this.iconGap);
    }

    // Apply the translation without boundary constraints - let each icon align to left
    this.setIconTrackTranslate(targetTranslate);
  }

  updateResponsiveMode() {
    this.isMobile = window.innerWidth <= 767;
    this.updateSliderPosition();
    this.updateIconContainerPosition();
  }

  slideLeft() {
    if (this.iconOriginalCount === 0) return;
    // Linear navigation - don't go past first slide
    if (this.currentActiveIndex === 0) return;
    const prevIndex = this.currentActiveIndex - 1;
    this.setActiveTab(prevIndex);
  }

  slideRight() {
    if (this.iconOriginalCount === 0) return;
    // Linear navigation - don't go past last slide
    if (this.currentActiveIndex === this.iconOriginalCount - 1) return;
    const nextIndex = this.currentActiveIndex + 1;
    this.setActiveTab(nextIndex);
  }

  updateArrowStates() {
    const leftArrow = document.querySelector('.slider-arrow-left');
    const rightArrow = document.querySelector('.slider-arrow-right');
    
    if (!leftArrow || !rightArrow) return;
    
    // Left arrow: inactive on first slide
    if (this.currentActiveIndex === 0) {
      leftArrow.classList.add('inactive');
    } else {
      leftArrow.classList.remove('inactive');
    }
    
    // Right arrow: inactive on last slide
    if (this.currentActiveIndex === this.iconOriginalCount - 1) {
      rightArrow.classList.add('inactive');
    } else {
      rightArrow.classList.remove('inactive');
    }
  }

  updateSliderPosition() {
    if (!this.sliderContainer) return;
    if (this.isMobile) {
      const firstSlide = this.sliderContainer.querySelector('.tab-content');
      let slideWidth = 0;
      if (firstSlide) {
        const rect = firstSlide.getBoundingClientRect();
        const style = window.getComputedStyle(firstSlide);
        const mr = parseFloat(style.marginRight) || 0;
        slideWidth = Math.round(rect.width + mr);
      } else {
        const containerWidth = this.sliderContainer.parentElement ? this.sliderContainer.parentElement.offsetWidth : window.innerWidth;
        slideWidth = Math.round((containerWidth * 0.85) + 8);
      }
      const translateX = -(this.currentActiveIndex * slideWidth);
      this.sliderContainer.style.transition = 'transform 0.3s ease';
      this.sliderContainer.style.transform = `translateX(${translateX}px)`;
    } else {
      this.sliderContainer.style.transition = 'transform 0.3s ease';
      this.sliderContainer.style.transform = 'translateX(0)';
    }
  }

  updateIconContainerPosition() {
    if (!this.iconContainer || !this.iconTrack) return;
    if (!this.isMobile) {
      this.resetIconTrack();
      return;
    }
    // on mobile, ensure active icon is aligned to left
    this.ensureIconVisible(this.currentActiveIndex);
  }

updateTopBorderPosition(index) {
  if (!this.topBorder || !this.iconContainer || !this.tabIcons[index]) return;

  const targetIcon = this.tabIcons[index];
  const iconContainerRect = this.iconContainer.getBoundingClientRect();
  const targetIconRect = targetIcon.getBoundingClientRect();
  const contentContainerRect = this.iconContainer.closest('.content-container').getBoundingClientRect();

  // Match the indicator to the icon width
  const borderWidth = window.innerWidth <= 991 ? 140 : 160;
  
  if (this.isMobile) {
    // Mobile positioning with fixed offset
    this.topBorder.style.width = `${borderWidth}px`;
    this.topBorder.style.left = `0px`;
    this.topBorder.style.marginLeft = '10px';
  } else {
    // For desktop, position directly above the icon
    // Calculate the center of the icon relative to the content container
    const iconCenterX = targetIconRect.left + (targetIconRect.width / 2) - contentContainerRect.left;
    
    // Position the border centered on the icon
    const left = iconCenterX - (borderWidth / 2);
    
    this.topBorder.style.width = `${borderWidth}px`;
    this.topBorder.style.left = `${left}px`;
    this.topBorder.style.marginLeft = '0'; // Remove additional margin
  }
}

  animateStats(tabContent) {
  const statGroups = Array.from(tabContent.querySelectorAll('.stat-group'));
  
  // Reset all stat groups first
  statGroups.forEach(group => {
    group.style.opacity = '0';
    group.style.transform = 'translateY(20px)';
    group.style.transition = 'none';
  });
  
  // Force reflow
  void tabContent.offsetHeight;
  
  // Animate each stat group with staggered delays
  statGroups.forEach((group, i) => {
    const delay = 0.8 + (i * 0.2); // Start after CTA (0.8s), then stagger by 0.2s
    group.style.transition = `opacity 0.6s ease ${delay}s, transform 0.6s ease ${delay}s`;
    group.style.opacity = '1';
    group.style.transform = 'translateY(0)';
  });
}

  animateContentElements(tabContent) {
    // Reset animations for all elements
    const logo = tabContent.querySelector('.company-logo');
    const headline = tabContent.querySelector('.main-headline');
    const cta = tabContent.querySelector('.cta-refresh');
    
    if (logo) {
      logo.style.opacity = '0';
      logo.style.transform = 'translateY(20px)';
      logo.style.transition = 'none';
      // Force reflow
      void logo.offsetHeight;
      logo.style.transition = 'opacity 0.6s ease 0.2s, transform 0.6s ease 0.2s';
      logo.style.opacity = '1';
      logo.style.transform = 'translateY(0)';
    }
    
    if (headline) {
      headline.style.opacity = '0';
      headline.style.transform = 'translateY(20px)';
      headline.style.transition = 'none';
      // Force reflow
      void headline.offsetHeight;
      headline.style.transition = 'opacity 0.6s ease 0.4s, transform 0.6s ease 0.4s';
      headline.style.opacity = '1';
      headline.style.transform = 'translateY(0)';
    }
    
    if (cta) {
      cta.style.opacity = '0';
      cta.style.transform = 'translateY(20px)';
      cta.style.transition = 'none';
      // Force reflow
      void cta.offsetHeight;
      cta.style.transition = 'opacity 0.6s ease 0.6s, transform 0.6s ease 0.6s';
      cta.style.opacity = '1';
      cta.style.transform = 'translateY(0)';
    }
  }

  setActiveTab(index) {
    if (index < 0 || index >= this.iconOriginalCount) return;
    this.currentActiveIndex = index;

    const activeCompany = this.tabIcons[index].getAttribute('data-company');

    this.tabIcons.forEach((tab, i) => {
      if (i === index) {
        tab.classList.add('active');
        tab.setAttribute('aria-selected', 'true');
        tab.setAttribute('tabindex', '0');
      } else {
        tab.classList.remove('active');
        tab.setAttribute('aria-selected', 'false');
        tab.setAttribute('tabindex', '-1');
      }
    });

    if (!this.isMobile) {
      this.tabContents.forEach((content, i) => {
        if (i === index) {
          content.classList.add('active');
          setTimeout(() => {
            this.animateContentElements(content);
            this.animateStats(content);
          }, 150);
        } else {
          content.classList.remove('active');
        }
      });
    } else {
      const currentContent = this.tabContents[index];
      if (currentContent) this.animateStats(currentContent);
    }

    this.tabImages.forEach((image) => {
      if (image.getAttribute('data-image') === activeCompany) image.classList.add('active');
      else image.classList.remove('active');
    });

    // Update slider and icon positions first
    this.updateSliderPosition();
    this.updateIconContainerPosition();
    
    // Then update border position after layout changes
    setTimeout(() => {
      this.updateTopBorderPosition(index);
    }, 50);
    
    // Update arrow states for linear navigation
    this.updateArrowStates();
  }
}

// Boot
document.addEventListener('DOMContentLoaded', () => {
  window.leadingBrandsComponent = new LeadingBrandsComponent();
});
</script>
</body>
</html>
