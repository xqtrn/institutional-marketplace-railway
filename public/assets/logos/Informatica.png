<script>
document.addEventListener('DOMContentLoaded', function() {
  // Options for the observer
  const options = {
    threshold: 0.15,
    rootMargin: '0px 0px -60px 0px'
  };

  // Get all service boxes in their DOM order
  const serviceBoxes = Array.from(document.querySelectorAll('.idmc-service-box'));
  
  // Create the observer
  const observer = new IntersectionObserver((entries, observer) => {
    entries.forEach(entry => {
      if (entry.isIntersecting) {
        // Get index of this box in the visual flow (top to bottom)
        const index = serviceBoxes.indexOf(entry.target);
        
        // Remove any existing inline styles or classes
        entry.target.classList.remove('visible');
        entry.target.style.transitionDelay = '';
        
        // Set transition delay based on the box's visual position
        const delay = 0.15 * index;
        entry.target.style.transitionDelay = `${delay}s`;
        
        // Small timeout to ensure the transition delay is applied before adding visible class
        setTimeout(() => {
          entry.target.classList.add('visible');
        }, 10);
        
        // Stop observing once the animation is triggered
        observer.unobserve(entry.target);
      }
    });
  }, options);

  // Start observing all service boxes
  serviceBoxes.forEach(box => {
    // Reset any existing transition delays from CSS
    box.style.transitionDelay = '0s';
    observer.observe(box);
  });
});
  
  document.addEventListener('DOMContentLoaded', function() {
  // Options for the observer
  const options = {
    threshold: 0.15,
    rootMargin: '0px 0px -60px 0px'
  };

  // Get all service boxes in their DOM order (now inside links)
  const serviceBoxes = Array.from(document.querySelectorAll('.idmc-service-box'));
  
  // Create the observer
  const observer = new IntersectionObserver((entries, observer) => {
    entries.forEach(entry => {
      if (entry.isIntersecting) {
        // Get index of this box in the visual flow (top to bottom)
        const index = serviceBoxes.indexOf(entry.target);
        
        // Remove any existing inline styles or classes
        entry.target.classList.remove('visible');
        entry.target.style.transitionDelay = '';
        
        // Set transition delay based on the box's visual position
        const delay = 0.15 * index;
        entry.target.style.transitionDelay = `${delay}s`;
        
        // Small timeout to ensure the transition delay is applied before adding visible class
        setTimeout(() => {
          entry.target.classList.add('visible');
        }, 10);
        
        // Stop observing once the animation is triggered
        observer.unobserve(entry.target);
      }
    });
  }, options);

  // Start observing all service boxes
  serviceBoxes.forEach(box => {
    // Reset any existing transition delays from CSS
    box.style.transitionDelay = '0s';
    observer.observe(box);
  });
});

</script>




</body>
</html>

