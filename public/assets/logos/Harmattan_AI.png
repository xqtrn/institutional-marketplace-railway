<style>
                    html, body {
                        background: #121212;
                        position: relative;
                        z-index: 0;
                    }
                    #__nuxt {
                        position: relative;
                        z-index: 2;
                        min-height: 100vh;
                    }
                </style>
<style>@media (min-width:0){html:before{content:"small";display:none}}@media (min-width:500px){html:before{content:"medium";display:none}}@media (min-width:850px){html:before{content:"large";display:none}}a,abbr,acronym,address,applet,article,aside,audio,b,big,blockquote,body,canvas,caption,center,cite,code,dd,del,details,dfn,div,dl,dt,em,embed,fieldset,figcaption,figure,footer,form,h1,h2,h3,h4,h5,h6,header,hgroup,html,i,iframe,img,ins,kbd,label,legend,li,main,mark,menu,nav,object,ol,output,p,pre,q,ruby,s,samp,section,small,span,strike,strong,sub,summary,sup,table,tbody,td,tfoot,th,thead,time,tr,tt,u,ul,var,video{border:0;font-size:100%;font:inherit;margin:0;padding:0;vertical-align:baseline}article,aside,details,figcaption,figure,footer,header,hgroup,main,menu,nav,section{display:block}[hidden]{display:none}body{line-height:1}menu,ol,ul{list-style:none}blockquote,q{quotes:none}blockquote:after,blockquote:before,q:after,q:before{content:"";content:none}table{border-collapse:collapse;border-spacing:0}html{--vh:1vh;--color-white:#fff;--color-black:#000;--color-highlight:#fff;--color-clear-beige:#f5f4e0;--color-desert-sand:#ddd1b9;--color-dark-beige:#cbb8a0;--color-dark-grey:#a1937f;--color-military-green:#6f6357;--color-bolt-black:#121212;--color-lightning-green:#f6f075}body,html{color:var(--color-black);font-family:IBM Plex Mono,sans-serif;font-size:4.26667vw;height:100%;width:100%}@media (min-width:500px){body,html{font-size:2.08333vw}}@media (min-width:850px){body,html{font-size:.94444vw}}body *,html *{box-sizing:border-box!important;-webkit-tap-highlight-color:transparent;-webkit-font-smoothing:antialiased;-khtml-font-smoothing:antialiased;-apple-font-smoothing:antialiased;font-smooth:always;-moz-osx-font-smoothing:grayscale}button{cursor:pointer;font-family:IBM Plex Mono,sans-serif}a{color:inherit;text-decoration:none}address{font-style:normal}::selection{background-color:var(--color-military-green);color:var(--color-white)}::-moz-selection{background-color:var(-