11d3c-35 cCNbgC"><div class="sc-1fb90aaf-107 dRhGvh"><div class="sc-1fb90aaf-109 cHIhiG"><div class="sc-1fb90aaf-106 lmCvMN"><div class="sc-a9d11d3c-82 fhFCEF"><div class="sc-a9d11d3c-77 fWLwUY"><div class="sc-1fb90aaf-108 jmfRaV"><p class="sc-1fb90aaf-9 chupgp">why wellhub</p></div><div class="sc-1fb90aaf-108 wbMFG"><p class="sc-1fb90aaf-9 chupgp">why wellhub</p></div><div class="sc-1fb90aaf-108 jmfRaV"><h2 class="sc-1fb90aaf-5 cBiWZh">Unbeatable value in every plan</h2></div><div class="sc-1fb90aaf-108 wbMFG"><h2 class="sc-1fb90aaf-5 cBiWZh">Unbeatable value in every plan</h2></div><div class="sc-1fb90aaf-108 jmfRaV"><p class="sc-1fb90aaf-2 hVMiBn"><span class="sc-1fb90aaf-57 bpSMIC"><span style="color:#FFFFFF">Wellhub subscriptions are designed for every company and employee to enjoy every day.</span></span></p></div><div class="sc-1fb90aaf-108 wbMFG"><p class="sc-1fb90aaf-2 hVMiBn"><span class="sc-1fb90aaf-57 bpSMIC"><span style="color:#FFFFFF">Wellhub subscriptions are designed for every company and employee to enjoy every day.</span></span></p></div></div></div></div></div></div></section><section id="why-wellhub" class="sc-a9d11d3c-35 enhTcS"><div class="sc-1fb90aaf-107 dRhGvh"><div class="sc-1fb90aaf-109 cHIhiG"><div class="sc-1fb90aaf-106 lmCvMN"><div class="sc-a9d11d3c-82 fhFCEF"><div class="sc-a9d11d3c-81 gwFIjk"><div class="sc-9addcfcc-28 imxfzc"><div class="sc-9addcfcc-27 czwqXz"><div class="sc-1fb90aaf-107 sc-9addcfcc-2 dRhGvh gmHaya"><div class="sc-9addcfcc-1 KzpQj"><picture class="sc-841363ad-0 hGAKsc"><source srcSet="https://assets-cdn.wellhub.com/images/mep-cms/pricing_1_1d72501da8.png?h=240&amp;q=65" media="(max-width: 360px)" height="100%"/><source srcSet="https://assets-cdn.wellhub.com/images/mep-cms/pricing_1_1d72501da8.png?h=240&amp;q=65" media="(max-width: 480px)" height="100%"/><img src="https://assets-cdn.wellhub.com/images/mep-cms/pricing_1_1d72501da8.png?h=240&amp;q=65" alt="" height="240" width="100%" loading="lazy" class="sc-9addcfcc-0 knpgvy"/></picture></div></div></div><div class="sc-9addcfcc-22 hCQJEx"><h3 class="sc-1fb90aaf-6 jWvxIi">Always less expensive</h3><p class="sc-1fb90aaf-3 ljlETE">Employee plans cost up to 50% less than direct memberships.</p></div></div><div class="sc-9addcfcc-28 imxfzc"><div class="sc-9addcfcc-27 czwqXz"><div class="sc-1fb90aaf-107 sc-9addcfcc-2 dRhGvh gmHaya"><div class="sc-9addcfcc-1 KzpQj"><picture class="sc-841363ad-0 hGAKsc"><source srcSet="https://assets-cdn.wellhub.com/images/mep-cms/pricing_2_5658424e71.png?h=240&amp;q=65" media="(max-width: 360px)" height="100%"/><source srcSet="https://assets-cdn.wellhub.com/images/mep-cms/pricing_2_5658424e71.png?h=240&amp;q=65" media="(max-width: 480px)" height="100%"/><img src="https://assets-cdn.wellhub.com/images/mep-cms/pricing_2_5658424e71.png?h=240&amp;q=65" alt="" height="240" width="100%" loading="lazy" class="sc-9addcfcc-0 knpgvy"/></picture></div></div></div><div class="sc-9addcfcc-22 hCQJEx"><h3 class="sc-1fb90aaf-6 jWvxIi">Always more options</h3><p class="sc-1fb90aaf-3 ljlETE">Choose any plan and get thousands of popular options for fitness &amp; wellness.</p></div></div><div class="sc-9addcfcc-28 imxfzc"><div class="sc-9addcfcc-27 czwqXz"><div class="sc-1fb90aaf-107 sc-9addcfcc-2 dRhGvh gmHaya"><div class="sc-9addcfcc-1 KzpQj"><picture class="sc-841363ad-0 hGAKsc"><source srcSet="https://assets-cdn.wellhub.com/images/mep-cms/pricing_3_1e6f34f161.png?h=240&amp;q=65" media="(max-width: 360px)" height="100%"/><source srcSet="https://assets-cdn.wellhub.com/images/mep-cms/pricing_3_1e6f34f161.png?h=240&amp;q=65" media="(max-width: 480px)" height="100%"/><img src="https://assets-cdn.wellhub.com/images/mep-cms/pricing_3_1e6f34f161.png?h=240&amp;q=65" alt="" height="240" width="100%" loading="lazy" class="sc-9addcfcc-0 knpgvy"/></picture></div></div></div><div class="sc-9addcfcc-22 hCQJEx"><h3 class="sc-1fb90aaf-6 jWvxIi">Always risk-free</h3><p class="sc-1fb90aaf-3 ljlETE">No enrollment or cancellation fees. Pause or upgrade plans at any time.</p></div></div></div><div class="sc-a9d11d3c-79 jwvDJX"><div class="sc-a9d11d3c-78 fvmcuH"><a href="/en-us/plans-pricing/" target="_self" class="sc-1fb90aaf-21 kBzlwa sc-1fb90aaf-25 bfPOVX">See plans &amp; pricing</a></div></div></div></div></div></div></section><section id="testimonials" class="sc-a9d11d3c-35 gVnIwh"><div class="sc-1fb90aaf-107 dRhGvh"><div class="sc-1fb90aaf-109 cHIhiG"><div class="sc-1fb90aaf-106 lmCvMN"><div class="sc-a9d11d3c-82 fhFCEF"><div class="sc-a9d11d3c-77 fWLwUY"><div class="sc-1fb90aaf-108 jmfRaV"><p class="sc-1fb90aaf-9 bddlQx">testimonials</p></div><div class="sc-1fb90aaf-108 wbMFG"><p class="sc-1fb90aaf-9 bddlQx">testimonials</p></div><div class="sc-1fb90aaf-108 jmfRaV"><h2 class="sc-1fb90aaf-5 gziSLW">Loved by our community</h2></div><div class="sc-1fb90aaf-108 wbMFG"><h2 class="sc-1fb90aaf-5 gziSLW">Loved by our community</h2></div></div></div></div></div></div></section><section class="sc-a9d11d3c-35 wKhA"><div class="sc-1fb90aaf-107 dRhGvh"><div class="sc-1fb90aaf-109 cHIhiG"><div class="sc-1fb90aaf-106 lmCvMN"><div class="sc-a9d11d3c-82 fhFCEF"><div class="sc-a9d11d3c-81 gwFIjk"><div class="sc-9addcfcc-28 dREttp"><div class="sc-9addcfcc-22 bzwdMs"><div><div class="sc-1fb90aaf-126 zWrmk"><span class="sc-1fb90aaf-128 dFBdMJ">Happy company</span></div></div><h3 class="sc-1fb90aaf-6 joUPar">Suzanne M. - HR</h3><p class="sc-1fb90aaf-1 sTovG">“We always emphasize to employees that Wellhub is more than just a gym: it is a complete quality of life benefit.”</p></div></div><div class="sc-9addcfcc-28 dREttp"><div class="sc-9addcfcc-22 bzwdMs"><div><div class="sc-1fb90aaf-126 zWrmk"><span class="sc-1fb90aaf-128 dFBdMJ">Happy employee</span></div></div><h3 class="sc-1fb90aaf-6 joUPar">Sam M. - Loan Officer</h3><p class="sc-1fb90aaf-1 sTovG">“I never imagined having access to this many gyms and being able to maintain my routine with so much ease!”</p></div></div></div></div></div></div></div></section><secti