t-c0762701e9895de3.js" async=""></script><script src="/_next/static/chunks/8270-8dd807d9bbea61b1.js" async=""></script><script src="/_next/static/chunks/app/%5Blang%5D/%5B%5B...slug%5D%5D/page-6c13b391d87f3370.js" async=""></script><meta name="referrer" content="strict-origin-when-cross-origin"/><link rel="dns-prefetch" href="https://assets-cdn.wellhub.com"/><link rel="preconnect" href="https://assets-cdn.wellhub.com" crossorigin="anonymous"/><link rel="dns-prefetch" href="https://tracking.wellhub.com"/><link rel="preconnect" href="https://tracking.wellhub.com" crossorigin="anonymous"/><link rel="dns-prefetch" href="https://cdn.cookielaw.org"/><link rel="preconnect" href="https://cdn.cookielaw.org" crossorigin="anonymous"/><link rel="dns-prefetch" href="https://www.googletagmanager.com"/><link rel="preconnect" href="https://www.googletagmanager.com" crossorigin="anonymous"/><link rel="preload" href="https://assets-cdn.wellhub.com/fonts/mep-cms/Na_N_Holo_Condensed_Bold_acbe44ddc6.woff2" as="font" type="font/woff2" crossorigin="anonymous"/><link rel="preload" href="https://assets-cdn.wellhub.com/fonts/mep-cms/Inter_Bold_5ba31f7471.woff2" as="font" type="font/woff2" crossorigin="anonymous"/><link rel="preload" href="https://assets-cdn.wellhub.com/fonts/mep-cms/Inter_Medium_9fcff7c51b.woff2" as="font" type="font/woff2" crossorigin="anonymous"/><link rel="preload" as="image" href="https://assets-cdn.wellhub.com/images/mep-cms/US_Hero_New_89193756b8.png?h=700&amp;q=85" media="(min-width: 1200px)" fetchPriority="high"/><title>Wellhub (Gympass) | Daily Wellbeing Options for Every Employee </title><meta name="description" content="Wellhub, formerly Gympass, offers a single subscription connecting employees to fitness, mindfulness, nutrition, sleep resources, and more. Explore our how it works and how to bring wellness to your workplace. "/><link rel="canonical" href="https://wellhub.com/en-us/"/><meta property="og:type" content="website"/><meta name="robots" content="index, follow"/><meta property="og:image" content="https://assets-cdn.wellhub.com/images/mep-cms/EN_UK_IT_meta_d8c2bf8ba9.png"/><meta property="og:image:alt" content="corporate wellness for every employee, including fitness, nutrition and mindfulness "/><meta property="og:type" content="website"/><meta name="twitter:card" content="summary_large_image"/><meta name="twitter:image" content="https://assets-cdn.wellhub.com/images/mep-cms/EN_UK_IT_meta_d8c2bf8ba9.png"/><meta name="twitter:image:alt" content="corporate wellness for every employee, including fitness, nutrition and mindfulness "/><script>
(function() {
    const TARGET_PROPERTY = 'webExperiment';
    const STORAGE_KEY = 'WH_REDEXP';

    function getRedirectContext(instance) {
        const activePages = instance.activePages || {};
        const activeFlagKeys = Object.keys(activePages);
        let activeVariant = null;
        let experimentKey = '';

        if (activeFlagKeys.length === 0) {
            return { flagKey: 'UNKNOWN', variant: 'control', experimentKey };
        }

        const flagKey = activeFlagKeys[0];

        const flagConfig = instance.initialFlags ? instance.initialFlags.find(f => f.key === flagKey) : null;

        if (flagConfig) {
            experimentKey = flagConfig.metadata?.experimentKey || '';

            if (flagConfig.variants) {
                for (const key in flagConfig.variants) {
                    const variant = flagConfig.variants[key];

                    if (
                        variant.payload &&
                        Array.isArray(variant.payload) &&
                        variant.payload.length > 0 &&
                        variant.payload[0].action === 'redirect'
                    ) {
                        activeVariant = variant;
                        break;
                    }
                }
            }
        }

        const variant = activeVariant
            ? activeVariant.key || activeVariant.value
            : 'control';

        return { flagKey, variant, experimentKey };
    }

    function redirectHandler(destinationUrl) {
        const instance = this;
        const originUrl = window.location.href;

        const { flagKey, variant, experimentKey } = getRedirectContext(instance);

        const payload = {
            flag_key: flagKey,
            variant: variant,
            originUrl: originUrl,
            destinationUrl: destinationUrl,
            type: 'REDIRECT',
            experiment_key: experimentKey
        };

        try {
            sessionStorage.setItem(
                STORAGE_KEY,
                JSON.stringify(payload)
            );
        } catch (e) {
            console.error(e);
        }
    };

    try {
        let _webExperiment = window[TARGET_PROPERTY];

        Object.defineProperty(window, TARGET_PROPERTY, {
            configurable: true,
            enumerable: true,
            get: () => _webExperiment,
            set: (newClientInstance) => {
                _webExperiment = newClientInstance;

                if (newClientInstance && typeof newClientInstance === 'object') {
                    newClientInstance.customRedirectHandler = redirectHandler;
                }
            }
        });
    } catch (e) {
        if (window[TARGET_PROPERTY] && typeof window[TARGET_PROPERTY] === 'object') {
             window[TARGET_PROPERTY].customRedirectHandler = redirectHandler;
        }
    }
})();
