ePosition&q;:false,&q;hasEpisodeCards&q;:true,&q;lockedForShouna&q;:false,&q;needSignIn&q;:false,&q;needTeacherSignIn&q;:false,&q;enablePadPencil&q;:true,&q;displayExercise&q;:false,&q;supportLuckyBag&q;:true,&q;supportLivePk&q;:true},{&q;id&q;:11219413,&q;kePrefix&q;:&q;sydw&q;,&q;courseId&q;:6,&q;status&q;:3,&q;playStatus&q;:3,&q;type&q;:33,&q;recordingType&q;:0,&q;mediaType&q;:0,&q;title&q;:&q;【公基法律】精选好题 沉浸刷题&q;,&q;innerTitle&q;:&q;&q;,&q;startTime&q;:1763186400000,&q;endTime&q;:1763193600000,&q;teacher&q;:{&q;id&q;:32041,&q;userId&q;:83032228,&q;name&q;:&q;刘柳利&q;,&q;brief&q;:&q;粉笔优质讲师&q;,&q;desc&q;:&q;粉笔优质教师。\n5年教学经验，累计授课近千课时，综合授课评分4.9，服务超过1000名学员，督学评分平均4.98以上。多次参与真题教研与解析编写，及时掌握各类考试命题特点与趋势。理论基础扎实，知识储备丰富，逻辑清晰，注重理解记忆和高效率，语言通俗易懂，幽默风趣，注重引导学员思考，帮助学员快速理解考点考情。善于倾听学员的学习诉求，并及时回应，讲课细致耐心，课堂氛围轻松活跃，学员可以获得良好的学习体验，深受学员好评。&q;,&q;avatar&q;:&q;1783557a9efc908.jpg&q;,&q;upperBodyPhoto&q;:null,&q;displayCoursePrefix&q;:&q;sydw&q;,&q;teacherStat&q;:{&q;teacherId&q;:32041,&q;episodeCount&q;:607,&q;scoreCount&q;:1396,&q;avgScore&q;:9.777936962750728,&q;fiveGradeAvgScore&q;:4.89,&q;updateTime&q;:1773281123587},&q;auditionEpisode&q;:null,&q;memberOfCPC&q;:false,&q;tags&q;:null},&q;teachChannel&q;:1,&q;offline&q;:null,&q;duration&q;:7703,&q;hasAudition&q;:false,&q;bizType&q;:0,&q;bizId&q;:&q;726825&q;,&q;supportReplay&q;:true,&q;extraInfo&q;:null,&q;liveConfig&q;:{&q;episodeId&q;:11219413,&q;supportMultiGroup&q;:false,&q;exerciseBizType&q;:0,&q;videoDisplayType&q;:0,&q;avForwardType&q;:0,&q;useIntelligentRoom&q;:false,&q;hasStrokeKeynote&q;:true,&q;verticalModeType&q;:0,&q;originEpisodeId&q;:0,&q;supportRtmp&q;:false,&q;supportPk&q;:true,&q;supportLuckyBag&q;:true,&q;supportUserNoteStroke&q;:false,&q;communicateType&q;:0,&q;one2One&q;:false,&q;fakeLive&q;:false},&q;validStatus&q;:1,&q;supportLive&q;:true,&q;supportAiCatalog&q;:false,&q;hasIntelligentPen&q;:false,&q;useLocalRecording&q;:false,&q;useIntelligentRoom&q;:false,&q;hasSalePosition&q;:false,&q;hasEpisodeCards&q;:true,&q;lockedForShouna&q;:false,&q;needSignIn&q;:false,&q;needTeacherSignIn&q;:false,&q;enablePadPencil&q;:true,&q;displayExercise&q;:false,&q;supportLuckyBag&q;:true,&q;supportLivePk&q;:true},{&q;id&q;:11224286,&q;kePrefix&q;:&q;sydw&q;,&q;courseId&q;:6,&q;status&q;:3,&q;playStatus&q;:3,&q;type&q;:33,&q;recordingType&q;:0,&q;mediaType&q;:0,&q;title&q;:&q;【公基非法】精选好题 沉浸刷题  &q;,&q;innerTitle&q;:&q;&q;,&q;startTime&q;:1763258400000,&q;endTime&q;:1763265600000,&q;teacher&q;:{&q;id&q;:52906,&q;userId&q;:88669957,&q;name&q;:&q;陶静&q;,&q;brief&q;:&q;粉笔优质讲师&q;,&q;desc&q;:&q;粉笔优质讲师\n6年一线教学，深耕线上线下授课，累计覆盖全国超万名学员，授课时长已突破2500小时，教学经验扎实且全面。\n深耕常识与公共基础知识、判断科目领域，兼具扎实的专业理论功底与丰富实践经验。对全国多地考试考情、真题规律及命题趋势有着深刻洞察，授课理念独到新颖，始终秉持理论与实践相结合的教学原则，致力于帮助学员系统掌握解题技巧，让大家在轻松高效的学习氛围中稳步提升。\n授课风格独树一帜，条理清晰，又风趣幽默，把复杂课程内容拆解得层次分明、脉络清晰，让学员轻松跟上学习节奏，再搭配专业完善的教学体系，学习效率直接拉满。&q;,&q;avatar&q;:&q;1984fe9e02e27a3.jpg&q;,&q;upperBodyPhoto&q;:null,&q;displayCoursePrefix&q;:&q;sydw&q;,&q;teacherStat&q;:{&q;teacherId&q;:52906,&q;episodeCount&q;:640,&q;scoreCount&q;:952,&q;avgScore&q;:9.83823529411764,&q;fiveGradeAvgScore&q;:4.92,&q;updateTime&q;:1773495035648},&q;auditionEpisode&q;:{&q;episodeTitle&q;:&q;个人展示课&q;,&q;episodeVideoUrl&q;:&q;https://vod.fbstatic.cn/22e9ceb2vodbj1251001446/d568fd2c1397757888047530032/UZNkfXcuVicA.mp4?t=f2a4b300&a;us=4070880000&a;sign=a17687f4fba4def68220de9a1cbf4eef&q;},&q;memberOfCPC&q;:false,&q;tags&q;:null},&q;teachChannel&q;:1,&q;offline&q;:null,&q;duration&q;:7418,&q;hasAudition&q;:false,&q;bizType&q;:0,&q;bizId&q;:&q;726825&q;,&q;supportReplay&q;:true,&q;extraInfo&q;:null,&q;liveConfig&q;:{&q;episodeId&q;:11224286,&q;supportMultiGroup&q;:false,&q;exerciseBizType&q;:0,&q;videoDisplayType&q;:0,&q;avForwardType&q;:0,&q;useIntelligentRoom&q;:false,&q;hasStrokeKeynote&q;:true,&q;verticalModeType&q;:0,&q;originEpisodeId&q;:0,&q;supportRtmp&q;:false,&q;supportPk&q;:true,&q;supportLuckyBag&q;:true,&q;supportUserNoteStroke&q;:false,&q;communicateType&q;:0,&q;one2One&q;:false,&q;fakeLive&q;:false},&q;validStatus&q;:1,&q;supportLive&q;:true,&q;supportAiCatalog&q;:false,&q;hasIntelligentPen&q;:false,&q;useLocalRecording&q;:false,&q;useIntelligentRoom&q;:false,&q;hasSalePosition&q;:false,&q;hasEpisodeCards&q;:true,&q;lockedForShouna&q;:false,&q;needSignIn&q;:false,&q;needTeacherSignIn&q;:false,&q;enablePadPencil&q;:true,&q;displayExercise&q;:false,&q;supportLuckyBag&q;:true,&q;supportLivePk&q;:true},{&q;id&q;:11224291,&q;kePrefix&q;:&q;sydw&q;,&q;courseId&q;:6,&q;status&q;:3,&q;playStatus&q;:3,&q;type&q;:33,&q;recordingType&q;:0,&q;mediaType&q;:0,&q;title&q;:&q;【判断】精选好题 沉浸刷题  &q;,&q;innerTitle&q;:&q;&q;,&q;startTime&q;:1763265600000,&q;endTime&q;:1763272800000,&q;teacher&q;:{&q;id&q;:16630,&q;userId&q;:63555782,&q;name&q;:&q;陈贺&q;,&q;brief&q;:&q;粉笔优质讲师&q;,&q;desc&q;:&q;粉笔优质教师\n6年一线教学授课经验，线上累计授课超800+小时，带班学生8000+；具有判断推理科目丰富的实践经验和系统扎实的专业理论，对山东、陕西、甘肃等各省判断推理科目的考情深入研究，全面了解命题规律及答题技巧，长期参与线上系统班和精品班的教研工作，撰写教研文章10余篇，出过近200道优质模拟题；具有幽默诙谐、形象生动、条理清晰的授课风格，让学生在轻松的学习氛围中，用更简单的方法，找到更快捷的解题之道，深受广大学员的认可和好评。&q;,&q;avatar&q;:&q;175d8f143291ec7.jpg&q;,&q;upperBodyPhoto&q;:null,&q;displayCoursePrefix&q;:&q;sydw&q;,&q;teacherStat&q;:{&q;teacherId&q;:16630,&q;episodeCount&q;:508,&q;scoreCount&q;:1860,&q;avgScore&q;:9.8516129032258,&q;fiveGradeAvgScore&q;:4.93,&q;updateTime&q;:1773584418412},&q;auditionEpisode&q;:{&q;episodeTitle&q;:&q;个人展示课&q;,&q;episodeVideoUrl&q;:&q;https://vod.fbstatic.cn/22e9ceb2vodbj1251001446/be9c21bc5145403709538211346/S3YE0Y3AIBoA.mp4?t=f2a4b300&a;us=4070880000&a;sign=aa0da2116ec32854b9c50d64d3429cec&q;},&q;memberOfCPC&q;:false,&q;tags&q;:null},&q;teachChannel&q;:1,&q;offline&q;:null,&q;duration&q;:7955,&q;hasAudition&q;:false,&q;bizType&q;:0,&q;bizId&q;:&q;726825&q;,&q;supportReplay&q;:true,&q;extraInfo&q;:null,&q;liveConfig&q;:{&q;episodeId&q;:11224291,&q;supportMultiGroup&q;:false,&q;exerciseBizType&q;:0,&q;videoDisplayType&q;:0,&q;avForwardType&q;:0,&q;useIntelligentRoom&q;:false,&q;hasStrokeKeynote&q;:true,&q;verticalModeType&q;:0,&q;originEpisodeId&q;:0,&q;supportRtmp&q;:false,&q;supportPk&q;:true,&q;supportLuckyBag&q;:true,&q;supportUserNoteStroke&q;:false,&q;communicateType&q;:0,&q;one2One&q;:false,&q;fakeLive&q;:false},&q;validStatus&q;:1,&q;supportLive&q;:true,&q;supportAiCatalog&q;:false,&q;hasIntelligentPen&q;:false,&q;useLocalRecording&q;:false,&q;useIntelligentRoom&q;:false,&q;hasSalePosition&q;:false,&q;hasEpisodeCards&q;:true,&q;lockedForShouna&q;:false,&q;needSignIn&q;:false,&q;needTeacherSignIn&q;:false,&q;enablePadPencil&q;:true,&q;displayExercise&q;:false,&q;supportLuckyBag&q;:true,&q;supportLivePk&q;:true},{&q;id&q;:11224309,&q;kePrefix&q;:&q;sydw&q;,&q;courseId&q;:6,&q;status&q;:3,&q;playStatus&q;:3,&q;type&q;:33,&q;recordingType&q;:0,&q;mediaType&q;:0,&q;title&q;:&q; 【公基法律】精选好题 沉浸刷题  &q;,&q;innerTitle&q;:&q;&q;,&q;startTime&q;:1763344800000,&q;endTime&q;:1763352000000,&q;teacher&q;:{&q;id&q;:16637,&q;userId&q;:73362780,&q;name&q;:&q;施孙芳&q;,&q;brief&q;:&q;粉笔优质讲师&q;,&q;desc&q;:&q;粉笔常识公基优质讲师。\n6年一线教学授课经验。具有常识公基科目丰富的实践经验及系统扎实的专业理论知识。多次参加粉笔授课研讨会议，全面把握常识公基考试命题趋势及最新考情，积累丰富笔试知识。具有幽默的授课风格，让学生在轻松的学习氛围中，用更简单的方法，找到更快捷的解题之道，深受广大学员的认可和好评，是值得信赖的好导师。&q;,&q;avatar&q;:&q;1746b726467e4a2.jpg&q;,&q;upperBodyPhoto&q;:null,&q;displayCoursePrefix&q;:&q;sydw&q;,&q;teacherStat&q;:{&q;teacherId&q;:16637,&q;episodeCount&q;:893,&q;scoreCount&q;:3281,&q;avgScore&q;:9.663517220359648,&q;fiveGradeAvgScore&q;:4.83,&q;updateTime&q;:1773547028739},&q;auditionEpisode&q;:{&q;episodeTitle&q;:&q;个人展示课&q;,&q;episodeVideoUrl&q;:&q;https://vod.fbstatic.cn/22e9ceb2vodbj1251001446/5a62805a5145403714882122093/LsABTK490BoA.mp4?t=f2a4b300&a;us=4070880000&a;sign=d987186e83731399b0f26511ecf8d802&q;},&q;memberOfCPC&q;:false,&q;tags&q;:null},&q;teachChannel&q;:1,&q;offline&q;:null,&q;duration&q;:7927,&q;hasAudition&q;:false,&q;bizType&q;:0,&q;bizId&q;:&q;726825&q;,&q;supportReplay&q;:true,&q;extraInfo&q;:null,&q;liveConfig&q;:{&q;episodeId&q;:11224309,&q;supportMultiGroup&q;:false,&q;exerciseBizType&q;:0,&q;videoDisplayType&q;:0,&q;avForwardType&q;:0,&q;useIntelligentRoom&q;:false,&q;hasStrokeKeynote&q;:true,&q;verticalModeType&q;:0,&q;originEpisodeId&q;:0,&q;supportRtmp&q;:false,&q;supportPk&q;:true,&q;supportLuckyBag&q;:true,&q;supportUserNoteStroke&q;:false,&q;communicateType&q;:0,&q;one2One&q;:false,&q;fakeLive&q;:false},&q;validStatus&q;:1,&q;supportLive&q;:true,&q;supportAiCatalog&q;:false,&q;hasIntelligentPen&q;:false,&q;useLocalRecording&q;:false,&q;useIntelligentRoom&q;:false,&q;hasSalePosition&q;:false,&q;hasEpisodeCards&q;:true,&q;lockedForShouna&q;:false,&q;needSignIn&q;:false,&q;needTeacherSignIn&q;:false,&q;enablePadPencil&q;:true,&q;displayExercise&q;:false,&q;supportLuckyBag&q;:true,&q;supportLivePk&q;:true},{&q;id&q;:11224316,&q;kePrefix&q;:&q;sydw&q;,&q;courseId&q;:6,&q;status&q;:3,&q;playStatus&q;:3,&q;type&q;:33,&q;recordingType&q;:0,&q;mediaType&q;:0,&q;title&q;:&q; 【判断】精选好题 沉浸刷题&q;,&q;innerTitle&q;:&q;&q;,&q;startTime&q;:1763352000000,&q;endTime&q;:1763359200000,&q;teacher&q;:{&q;id&q;:18201,&q;userId&q;:65021959,&q;name&q;:&q;和羽&q;,&q;brief&q;:&q;粉笔优质讲师&q;,&q;desc&q;:&q;粉笔优质教师\n六年以上公考教学经验，深耕判断推理领域多年，具有丰富的实践经验及系统扎实的专业理论知识，特别对联考，江苏，广东地区的考情有深刻的了解，曾正确预测广东2023年统考判断题目考点，参与命制笔试教研，对判断方向有深入研究。&q;,&q;avatar&q;:&q;175de1603793be8.jpg&q;,&q;upperBodyPhoto&q;:null,&q;displayCoursePrefix&q;:&q;sydw&q;,&q;teacherStat&q;:{&q;teacherId&q;:18201,&q;episodeCount&q;:448,&q;scoreCount&q;:2492,&q;avgScore&q;:9.51685393258427,&q;fiveGradeAvgScore&q;:4.76,&q;updateTime&q;:1773579873374},&q;auditionEpisode&q;:{&q;episodeTitle&q;:&q;个人展示课&q;,&q;episodeVideoUrl&q;:&q;https://vod.fbstatic.cn/22e9ceb2vodbj1251001446/44f952535145403715606022056/4LBzOwv6V2sA.mp4?t=f2a4b300&a;us=4070880000&a;sign=0c9562cc28065d90b6940e468cbb4ddd&q;},&q;memberOfCPC&q;:false,&q;tags&q;:null},&q;teachChannel&q;:1,&q;offline&q;:null,&q;duration&q;:8832,&q;hasAudition&q;:false,&q;bizType&q;:0,&q;bizId&q;:&q;726825&q;,&q;supportReplay&q;:true,&q;extraInfo&q;:null,&q;liveConfig&q;:{&q;episodeId&q;:11224316,&q;supportMultiGroup&q;:false,&q;exerciseBizType&q;:0,&q;videoDisplayType&q;:0,&q;avForwardType&q;:0,&q;useIntelligentRoom&q;:false,&q;hasStrokeKeynote&q;:true,&q;verticalModeType&q;:0,&q;originEpisodeId&q;:0,&q;supportRtmp&q;:false,&q;supportPk&q;:true,&q;supportLuckyBag&q;:true,&q;supportUserNoteStroke&q;:false,&q;communicateType&q;:0,&q;one2One&q;:false,&q;fakeLive&q;:false},&q;validStatus&q;:1,&q;supportLive&q;:true,&q;supportAiCatalog&q;:false,&q;hasIntelligentPen&q;:false,&q;useLocalRecording&q;:false,&q;useIntelligentRoom&q;:false,&q;hasSalePosition&q;:false,&q;hasEpisodeCards&q;:true,&q;lockedForShouna&q;:false,&q;needSignIn&q;:false,&q;needTeacherSignIn&q;:false,&q;enablePadPencil&q;:true,&q;displayExercise&q;:false,&q;supportLuckyBag&q;:true,&q;supportLivePk&q;:true},{&q;id&q;:11224318,&q;kePrefix&q;:&q;sydw&q;,&q;courseId&q;:6,&q;status&q;:3,&q;playStatus&q;:3,&q;type&q;:33,&q;recordingType&q;:0,&q;mediaType&q;:0,&q;title&q;:&q; 【公基非法】精选好题 沉浸刷题&q;,&q;innerTitle&q;:&q;&q;,&q;startTime&q;:1763359200000,&q;endTime&q;:1763366400000,&q;teacher&q;:{&q;id&q;:34141,&q;userId&q;:67002168,&q;name&q;:&q;温东升&q;,&q;brief&q;:&q;粉笔优质讲师&q;,&q;desc&q;:&q;粉笔优质教师\n6年以上一线授课经验。带班学生10000+；熟悉国考、省考、事业单位考情，参与四川、山东、甘肃等省考情分析；长期扎根于公考、省考、事业单位教学教研工作，参与粉笔题库真题、模拟题解析编撰工作，时政文件解析工作，参与全国常识公基非法密卷课件及教案制作，农业农村书籍编撰工作。长期担任常识公基、判断课程主讲。课堂氛围轻松幽默，寓教于乐，能够结合当下时政，灵活运用到实际讲解之中，逻辑思维性强，善于沟通，能够迅速帮助考生进行全方位提升。&q;,&q;avatar&q;:&q;19841271adb989c.jpg&q;,&q;upperBodyPhoto&q;:null,&q;displayCoursePrefix&q;:&q;sydw&q;,&q;teacherStat&q;:{&q;teacherId&q;:34141,&q;episodeCount&q;:708,&q;scoreCount&q;:1467,&q;avgScore&q;:9.745057941376977,&q;fiveGradeAvgScore&q;:4.87,&q;updateTime&q;:1773480813169},&q;auditionEpisode&q;:{&q;episodeTitle&q;:&q;个人展示课&q;,&q;episodeVideoUrl&q;:&q;https://vod.fbstatic.cn/22e9ceb2vodbj1251001446/7b5794655145403710132043113/2OaZlykd0yAA.mp4?t=f2a4b300&a;us=4070880000&a;sign=63dc74bcedbc74171e790ef405ff495e&q;},&q;memberOfCPC&q;:false,&q;tags&q;:null},&q;teachChannel&q;:1,&q;offline&q;:null,&q;duration&q;:7543,&q;hasAudition&q;:false,&q;bizType&q;