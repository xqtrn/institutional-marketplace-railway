内蒙古、江苏、陕西等多省精讲、冲刺等课程的授课经验)。课堂上，以考生为中心，以提升学员能力导向，立足考试实际，扎实推动思维训练和做题训练，让学员有收获，帮助学员在考场脱颖而出。&q;,&q;avatar&q;:&q;1927ab7a76c2808.jpg&q;,&q;upperBodyPhoto&q;:null,&q;displayCoursePrefix&q;:&q;gwy&q;,&q;teacherStat&q;:{&q;teacherId&q;:2228,&q;episodeCount&q;:1847,&q;scoreCount&q;:17251,&q;avgScore&q;:9.774969566981635,&q;fiveGradeAvgScore&q;:4.89,&q;updateTime&q;:1773488838761},&q;auditionEpisode&q;:{&q;episodeTitle&q;:&q;个人展示课&q;,&q;episodeVideoUrl&q;:&q;https://vod.fbstatic.cn/22e9ceb2vodbj1251001446/3a2674403560136621456363708/h3kmtfU6YwYA.mp4?t=f2a4b300&a;us=4070880000&a;sign=96ea1c4002a57a928656415e682e68ff&q;},&q;memberOfCPC&q;:false,&q;tags&q;:null},&q;teachChannel&q;:1,&q;offline&q;:null,&q;duration&q;:10482,&q;hasAudition&q;:false,&q;bizType&q;:0,&q;bizId&q;:&q;710082&q;,&q;supportReplay&q;:true,&q;extraInfo&q;:null,&q;liveConfig&q;:{&q;episodeId&q;:11356948,&q;supportMultiGroup&q;:false,&q;exerciseBizType&q;:0,&q;videoDisplayType&q;:0,&q;avForwardType&q;:0,&q;useIntelligentRoom&q;:false,&q;hasStrokeKeynote&q;:true,&q;verticalModeType&q;:0,&q;originEpisodeId&q;:0,&q;supportRtmp&q;:false,&q;supportPk&q;:false,&q;supportLuckyBag&q;:false,&q;supportUserNoteStroke&q;:false,&q;communicateType&q;:0,&q;one2One&q;:false,&q;fakeLive&q;:false},&q;validStatus&q;:1,&q;supportLive&q;:true,&q;supportAiCatalog&q;:true,&q;hasIntelligentPen&q;:false,&q;useLocalRecording&q;:false,&q;useIntelligentRoom&q;:false,&q;hasSalePosition&q;:false,&q;hasEpisodeCards&q;:false,&q;lockedForShouna&q;:false,&q;needSignIn&q;:false,&q;needTeacherSignIn&q;:false,&q;enablePadPencil&q;:true,&q;displayExercise&q;:false,&q;supportLuckyBag&q;:false,&q;supportLivePk&q;:false},{&q;id&q;:11356949,&q;kePrefix&q;:&q;gwy&q;,&q;courseId&q;:1,&q;status&q;:3,&q;playStatus&q;:3,&q;type&q;:1,&q;recordingType&q;:0,&q;mediaType&q;:0,&q;title&q;:&q;2026江苏行测申论联合终极模考大赛《申论》（A卷）&q;,&q;innerTitle&q;:&q;&q;,&q;startTime&q;:1764846000000,&q;endTime&q;:1764856800000,&q;teacher&q;:{&q;id&q;:6058,&q;userId&q;:60103386,&q;name&q