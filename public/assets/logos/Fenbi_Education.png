,&q;needTeacherSignIn&q;:false,&q;enablePadPencil&q;:true,&q;displayExercise&q;:false,&q;supportLuckyBag&q;:false,&q;supportLivePk&q;:false},{&q;id&q;:11382182,&q;kePrefix&q;:&q;sydw&q;,&q;courseId&q;:6,&q;status&q;:3,&q;playStatus&q;:3,&q;type&q;:1,&q;recordingType&q;:0,&q;mediaType&q;:0,&q;title&q;:&q;2026广东行测申论联合终极模考大赛《公安专业知识》&q;,&q;innerTitle&q;:&q;&q;,&q;startTime&q;:1764846000000,&q;endTime&q;:1764855000000,&q;teacher&q;:{&q;id&q;:16734,&q;userId&q;:65372272,&q;name&q;:&q;周浩飞&q;,&q;brief&q;:&q;粉笔面试优质讲师&q;,&q;desc&q;:&q;粉笔面试优质讲师\n6年公考一线教学经验，专业水平扎实，有丰富的实战经历和机关工作经历。多次参与全国各省份公务员、事业单位面试真题教研工作，熟练掌握各种面试作答技巧。授课累计时长6000+，多次承担线下长线班型授课，授课期间多次助力学员逆袭上岸。综合面试通过率72%。授课思路清晰，严谨，善于引导学员、开发学员面试思维，增强学员自主性；课堂氛围活跃，学员互动性强；注重理论与实际相结合，因材施教，有针对性的提升学员能力，深受学员喜爱。&q;,&q;avatar&q;:&q;1945f4a402b3e77.jpg&q;,&q;upperBodyPhoto&q;:null,&q;displayCoursePrefix&q;:&q;gwy&q;,&q;teacherStat&q;:{&q;teacherId&q;:16734,&q;episodeCount&q;:978,&q;scoreCount&q;:31170,&q;avgScore&q;:9.748989412897016,&q;fiveGradeAvgScore&q;:4.87,&q;updateTime&q;:1773575875032},&q;auditionEpisode&q;:{&q;episodeTitle&q;:&q;个人展示课&q;,&q;episodeVideoUrl&q;:&q;https://vod.fbstatic.cn/22e9ceb2vodbj1251001446/e1ada1595145403709542416512/7GtFiqAxArcA.mp4?t=f2a4b300&a;us=4070880000&a;sign=8b3c690173802629092e12b11a5a0ae6&q;},&q;memberOfCPC&q;:false,&q;tags&q;:null},&q;teachChannel&q;:1,&q;offline&q;:null,&q;duration&q;:12547,&q;hasAudition&q;:false,&q;bizType&q;:0,&q;bizId&q;:&q;710082&q;,&q;supportReplay&q;:true,&q;extraInfo&q;:null,&q;liveConfig&q;:{&q;episodeId&q;:11382182,&q;supportMultiGroup&q;:false,&q;exerciseBizType&q;:0,&q;videoDisplayType&q;:0,&q;avForwardType&q;:0,&q;useIntelligentRoom&q;:false,&q;hasStrokeKeynote&q;:true,&q;verticalModeType&q;:0,&q;originEpisodeId&q;:0,&q;supportRtmp&q;:false,&q;supportPk&q;:false,&q;supportLuckyBag&q;:false,&q;supportUserNoteStroke&q;:false,&q;communicateType&q;:0,&q;one2One&q;:false,&q;fakeLive&q;:false},&q;validStatus&q;:1,&q;supportLive&q;:true,&q;supportAiCatalog&q;:false,&q;hasIntell