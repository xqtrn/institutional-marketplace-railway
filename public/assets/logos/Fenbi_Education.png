wardType&q;:0,&q;useIntelligentRoom&q;:false,&q;hasStrokeKeynote&q;:true,&q;verticalModeType&q;:0,&q;originEpisodeId&q;:0,&q;supportRtmp&q;:false,&q;supportPk&q;:true,&q;supportLuckyBag&q;:true,&q;supportUserNoteStroke&q;:false,&q;communicateType&q;:0,&q;one2One&q;:false,&q;fakeLive&q;:false},&q;validStatus&q;:1,&q;supportLive&q;:true,&q;supportAiCatalog&q;:false,&q;hasIntelligentPen&q;:false,&q;useLocalRecording&q;:false,&q;useIntelligentRoom&q;:false,&q;hasSalePosition&q;:false,&q;hasEpisodeCards&q;:true,&q;lockedForShouna&q;:false,&q;needSignIn&q;:false,&q;needTeacherSignIn&q;:false,&q;enablePadPencil&q;:true,&q;displayExercise&q;:false,&q;supportLuckyBag&q;:true,&q;supportLivePk&q;:true},{&q;id&q;:11000514,&q;kePrefix&q;:&q;sydw&q;,&q;courseId&q;:6,&q;status&q;:3,&q;playStatus&q;:3,&q;type&q;:33,&q;recordingType&q;:0,&q;mediaType&q;:0,&q;title&q;:&q;【综应】精选好题 沉浸刷题&q;,&q;innerTitle&q;:&q;&q;,&q;startTime&q;:1757296800000,&q;endTime&q;:1757304000000,&q;teacher&q;:{&q;id&q;:15514,&q;userId&q;:63317913,&q;name&q;:&q;唐邦杰&q;,&q;brief&q;:&q;粉笔优质讲师&q;,&q;desc&q;:&q;粉笔优质教师\n6年一线教学授课经验，线上累计授课超1000+小时，授课人数2500+，始终教研结合，紧跟命题走向，强调知识更新。善于讲解联考A、江苏、浙江、山东、广东各省综应课程，对于综应解题技巧有独到的见解，并参与综应各大题型人工批改服务上千份，能够多方面把握学员需求，精准定位学员薄弱点。全面了解事业单位综合应用能力考试的命题规律及答题技巧，授课经验丰富，逻辑清晰，思维严谨，擅长总结，深受广大学员的认可和好评，在学员中具有非常好的口碑，是值得信赖的好导师。&q;,&q;avatar&q;:&q;198411427ad51c5.jpg&q;,&q;upperBodyPhoto&q;:null,&q;displayCoursePrefix&q;:&q;sydw&q;,&q;teacherStat&q;:{&q;teacherId&q;:15514,&q;episodeCount&q;:512,&q;scoreCount&q;:787,&q;avgScore&q;:9.9135959339263,&q;fiveGradeAvgScore&q;:4.96,&q;updateTime&q;:1772548329533},&q;auditionEpisode&q;:{&q;episodeTitle&q;:&q;个人展示课&q;,&q;episodeVideoUrl&q;:&q;https://vod.fbstatic.cn/22e9ceb2vodbj1251001446/5402b0855145403709207407994/antnJrlNvLMA.mp4?t=f2a4b300&a;us=4070880000&a;sign=cd84b92e364976b35f69adb6cf6cd1b7&q;},&q;memberOfCPC&q;:false,&q;tags&q;:null},&q;teachChannel&q;:1,&q;offline&q;:null,&q;duration&q;:7419,&q;hasAudition&q;:false,&q;bizType&q;:0,&q;bizId&q;:&q;726825&q;