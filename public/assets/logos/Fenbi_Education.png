人展示课&q;,&q;episodeVideoUrl&q;:&q;https://vod.fbstatic.cn/22e9ceb2vodbj1251001446/53f4fa301253642695778393524/uGA8MEZ6dXgA.mp4?t=f2a4b300&a;us=4070880000&a;sign=53f612c946fe50fbc2fe02f9de9341e1&q;},&q;memberOfCPC&q;:false,&q;tags&q;:null},&q;teachChannel&q;:1,&q;offline&q;:null,&q;duration&q;:8805,&q;hasAudition&q;:false,&q;bizType&q;:0,&q;bizId&q;:&q;726825&q;,&q;supportReplay&q;:true,&q;extraInfo&q;:null,&q;liveConfig&q;:{&q;episodeId&q;:10794911,&q;supportMultiGroup&q;:false,&q;exerciseBizType&q;:0,&q;videoDisplayType&q;:0,&q;avForwardType&q;:0,&q;useIntelligentRoom&q;:false,&q;hasStrokeKeynote&q;:true,&q;verticalModeType&q;:0,&q;originEpisodeId&q;:0,&q;supportRtmp&q;:false,&q;supportPk&q;:true,&q;supportLuckyBag&q;:true,&q;supportUserNoteStroke&q;:false,&q;communicateType&q;:0,&q;one2One&q;:false,&q;fakeLive&q;:false},&q;validStatus&q;:1,&q;supportLive&q;:true,&q;supportAiCatalog&q;:false,&q;hasIntelligentPen&q;:false,&q;useLocalRecording&q;:false,&q;useIntelligentRoom&q;:false,&q;hasSalePosition&q;:false,&q;hasEpisodeCards&q;:true,&q;lockedForShouna&q;:false,&q;needSignIn&q;:false,&q;needTeacherSignIn&q;:false,&q;enablePadPencil&q;:true,&q;displayExercise&q;:false,&q;supportLuckyBag&q;:true,&q;supportLivePk&q;:true},{&q;id&q;:10794989,&q;kePrefix&q;:&q;sydw&q;,&q;courseId&q;:6,&q;status&q;:3,&q;playStatus&q;:3,&q;type&q;:33,&q;recordingType&q;:0,&q;mediaType&q;:0,&q;title&q;:&q;【言语】精选好题 沉浸刷题&q;,&q;innerTitle&q;:&q;&q;,&q;startTime&q;:1750492800000,&q;endTime&q;:1750500000000,&q;teacher&q;:{&q;id&q;:52949,&q;userId&q;:80481411,&q;name&q;:&q;王臻瑶&q;,&q;brief&q;:&q;粉笔优质讲师&q;,&q;desc&q;:&q;粉笔优质讲师\n211高校毕业，6年一线教学、教研经验，线上线下授课人数千余人，累计授课时长3000+。\n对于言语理解与表达科目有丰富的实践经验及系统扎实的专业理论知识。\n亲和力强，注重与学员的互动和交流，对各省份考情熟悉，注重理论与实践相结合，引导学员发现问题，帮助学员高分上岸，深受学员喜爱。\n教学风格注重条理性和逻辑性，善于通过生动的例子，帮助学员深入理解题目背后的逻辑关系和解题技巧。&q;,&q;avatar&q;:&q;1945f3b6384d792.jpg&q;,&q;upperBodyPhoto&q;:null,&q;displayCoursePrefix&q;:&q;sydw&q;,&q;teacherStat&q;:{&q;teacherId&q;:52949,&q;episodeCount&q;:342,&q;scoreCount&q;:1475,&q;avgScore&q;:9.738305084745754,&q;fiveGradeAvgScore&q;:4.87,&q;updateTime&q;:1773588704179},&q;auditionEpisode&q;:{&q;episodeTitle&q;:&q;个人展示课&q;,&q;episodeVideoUrl&q;:&q;https://nodestatic.fbstatic.cn/video_qhd/1714474745775.mp4&q;},&q;memberOfCPC&q;:false,&q;tags&q;:null},&q;teachChannel&q;:1,&q;offline&q;:null,&q;duration&q;:8573,&q;hasAudition&q;:false,&q;bizType&q;:0,&q;bizId&q;:&q;726825&q;,&q;supportReplay&q;:true,&q;extraInfo&q;:null,&q;liveConfig&q;:{&q;episodeId&q;:10794989,&q;supportMultiGroup&q;:false,&q;exerciseBizType&q;:0,&q;videoDisplayType&q;:0,&q;avForwardType&q;:0,&q;useIntelligentRoom&q;:false,&q;hasStrokeKeynote&q;:true,&q;verticalModeType&q;:0,&q;originEpisodeId&q;:0,&q;supportRtmp&q;:false,&q;supportPk&q;:true,&q;supportLuckyBag&q;:true,&q;supportUserNoteStroke&q;:false,&q;communicateType&q;:0,&q;one2One&q;:false,&q;fakeLive&q;:false},&q;validStatus&q;:1,&q;supportLive&q;:true,&q;supportAiCatalog&q;:false,&q;hasIntelligentPen&q;:false,&q;useLocalRecording&q;:false,&q;useIntelligentRoom&q;:false,&q;hasSalePosition&q;:false,&q;hasEpisodeCards&q;:true,&q;lockedForShouna&q;:false,&q;needSignIn&q;:false,&q;needTeacherSignIn&q;:false,&q;enablePadPencil&q;:true,&q;displayExercise&q;:false,&q;supportLuckyBag&q;:true,&q;supportLivePk&q;:true},{&q;id&q;:10794992,&q;kePrefix&q;:&q;sydw&q;,&q;courseId&q;:6,&q;status&q;:3,&q;playStatus&q;:3,&q;type&q;:33,&q;recordingType&q;:0,&q;mediaType&q;:0,&q;title&q;:&q;【言语】精选好题 沉浸刷题&q;,&q;innerTitle&q;:&q;&q;,&q;startTime&q;:1750572000000,&q;endTime&q;:1750579200000,&q;teacher&q;:{&q;id&q;:52905,&q;userId&q;:64869017,&q;name&q;:&q;迟琳&q;,&q;brief&q;:&q;粉笔优质讲师&q;,&q;desc&q;:&q;粉笔优质讲师\n5年一线教学深耕，主讲线上精品班、刷题班等多元班型，累计授课时长超3000小时，教学经验扎实丰富。\n深耕言语理解模块，凭借对考情的敏锐洞察，能精准捕捉考试趋势与命题方向。擅长将复杂知识点拆解为“可吸收”的清晰模块，结合生动案例与通俗表达，让抽象解题技巧变得直观易懂，帮助学生快速突破学习难点。\n教学中始终以学员为核心，不仅注重解题方法的传授，更着力培养学生的逻辑思维与自主学习能力。通过“举一反三”的引导式教学，助力学员实现知识的灵活迁移与运用，学员好评率稳居前列，深受信赖与喜爱。&q;,&q;avatar&q;:&q;17f3f0375916d72.jpg&q;,&q;upperBodyPhoto&q;:null,&q;displayCoursePrefix&q;:&q;sydw&q;,&q;teacherStat&q;:{&q;teacherId&q;:52905,&q;episodeCount&q;:351,&q;scoreCount&q;:1137,&q;avgScore&q;:9.829375549692163,&q;fiveGradeAvgScore&q;:4.91,&q;updateTime&q;:1773566236546},&q;auditionEpisode&q;:{&q;episodeTitle&q;:&q;个人展示课&q;,&q;episodeVideoUrl&q;:&q;https://vod.fbstatic.cn/22e9ceb2vodbj1251001446/ba3aba5f5145403709538052229/NBGfnV7d2IEA.mp4?t=f2a4b300&a;us=4070880000&a;sign=783070f866ba71370a8c3a086a82aa91&q;},&q;memberOfCPC&q;:false,&q;tags&q;:null},&q;teachChannel&q;:1,&q;offline&q;:null,&q;duration&q;:7311,&q;hasAudition&q;:false,&q;bizType&q;:0,&q;bizId&q;:&q;726825&q;,&q;supportReplay&q;:true,&q;extraInfo&q;:null,&q;liveConfig&q;:{&q;episodeId&q;:10794992,&q;supportMultiGroup&q;:false,&q;exerciseBizType&q;:0,&q;videoDisplayType&q;:0,&q;avForwardType&q;:0,&q;useIntelligentRoom&q;:false,&q;hasStrokeKeynote&q;:true,&q;verticalModeType&q;:0,&q;originEpisodeId&q;:0,&q;supportRtmp&q;:false,&q;supportPk&q;:true,&q;supportLuckyBag&q;:true,&q;supportUserNoteStroke&q;:false,&q;communicateType&q;:0,&q;one2One&q;:false,&q;fakeLive&q;:false},&q;validStatus&q;:1,&q;supportLive&q;:true,&q;supportAiCatalog&q;:false,&q;hasIntelligentPen&q;:false,&q;useLocalRecording&q;:false,&q;useIntelligentRoom&q;:false,&q;hasSalePosition&q;:false,&q;hasEpisodeCards&q;:true,&q;lockedForShouna&q;:false,&q;needSignIn&q;:false,&q;needTeacherSignIn&q;:false,&q;enablePadPencil&q;:true,&q;displayExercise&q;:false,&q;supportLuckyBag&q;:true,&q;supportLivePk&q;:true},{&q;id&q;:10794995,&q;kePrefix&q;:&q;sydw&q;,&q;courseId&q;:6,&q;status&q;:3,&q;playStatus&q;:3,&q;type&q;:33,&q;recordingType&q;:0,&q;mediaType&q;:0,&q;title&q;:&q;【数资】精选好题 沉浸刷题&q;,&q;innerTitle&q;:&q;&q;,&q;startTime&q;:1750579200000,&q;endTime&q;:1750586400000,&q;teacher&q;:{&q;id&q;:26292,&q;userId&q;:79327575,&q;name&q;:&q;郑美娟&q;,&q;brief&q;:&q;粉笔优质讲师&q;,&q;desc&q;:&q;粉笔数量关系与资料分析科目优质教师\n5年一线教学授课经验。\n具有数资科目丰富的实践经验及系统扎实的专业理论知识。多次参与粉笔数资授课研讨，教学教研能力扎实。承担过线下笔试精品班、刷题班、冲刺班等多种班型，授课经验丰富，思路清晰，讲解全面细致。\n授课形式生动形象，能够有针对性的引导学生进行主动思考，课堂氛围轻松无压力。擅长化繁为简，适合各个阶段的学生，深受广大学员好评。&q;,&q;avatar&q;:&q;1777f9e082273e5.jpg&q;,&q;upperBodyPhoto&q;:null,&q;displayCoursePrefix&q;:&q;sydw&q;,&q;teacherStat&q;:{&q;teacherId&q;:26292,&q;episodeCount&q;:567,&q;scoreCount&q;:1594,&q;avgScore&q;:9.803011292346305,&q;fiveGradeAvgScore&q;:4.9,&q;updateTime&q;:1773586366104},&q;auditionEpisode&q;:{&q;episodeTitle&q;:&q;个人展示课&q;,&q;episodeVideoUrl&q;:&q;https://vod.fbstatic.cn/22e9ceb2vodbj1251001446/9f3a48475145403713947309566/MDmpFEIP6G8A.mp4?t=f2a4b300&a;us=4070880000&a;sign=39fd01bda5913d3e938e577986d9db4b&q;},&q;memberOfCPC&q;:false,&q;tags&q;:null},&q;teachChannel&q;:1,&q;offline&q;:null,&q;duration&q;:8568,&q;hasAudition&q;:false,&q;bizType&q;:0,&q;bizId&q;:&q;726825&q;,&q;supportReplay&q;:true,&q;extraInfo&q;:null,&q;liveConfig&q;:{&q;episodeId&q;:10794995,&q;supportMultiGroup&q;:false,&q;exerciseBizType&q;:0,&q;videoDisplayType&q;:0,&q;avForwardType&q;:0,&q;useIntelligentRoom&q;:false,&q;hasStrokeKeynote&q;:true,&q;verticalModeType&q;:0,&q;originEpisodeId&q;:0,&q;supportRtmp&q;:false,&q;supportPk&q;:true,&q;supportLuckyBag&q;:true,&q;supportUserNoteStroke&q;:false,&q;communicateType&q;:0,&q;one2One&q;:false,&q;fakeLive&q;:false},&q;validStatus&q;:1,&q;supportLive&q;:true,&q;supportAiCatalog&q;:false,&q;hasIntelligentPen&q;:false,&q;useLocalRecording&q;:false,&q;useIntelligentRoom&q;:false,&q;hasSalePosition&q;:false,&q;hasEpisodeCards&q;:true,&q;lockedForShouna&q;:false,&q;needSignIn&q;:false,&q;needTeacherSignIn&q;:false,&q;enablePadPencil&q;:true,&q;displayExercise&q;:false,&q;supportLuckyBag&q;:true,&q;supportLivePk&q;:true},{&q;id&q;:10795006,&q;kePrefix&q;:&q;sydw&q;,&q;courseId&q;:6,&q;status&q;:3,&q;playStatus&q;:3,&q;type&q;:33,&q;recordingType&q;:0,&q;mediaType&q;:0,&q;title&q;:&q;【判断】精选好题 沉浸刷题&q;,&q;innerTitle&q;:&q;&q;,&q;startTime&q;:1750644000000,&q;endTime&q;:1750651200000,&q;teacher&q;:{&q;id&q;:16837,&q;userId&q;:74162051,&q;name&q;:&q;杨晓晓&q;,&q;brief&q;:&q;粉笔优质讲师&q;,&q;desc&q;:&q;粉笔优质教师\n六年一线教学授课经验，具有判断科目丰富的实践经验及系统扎实的专业理论知识，参与判断科目讲义、模拟卷研发。始终以生动有趣、激发学生思维为教学宗旨，课堂氛围轻松融洽，广受学员好评。授课重点突出，能够及时总结拓展，讲解语言通俗易懂。擅长引导学生自主思考，善于根据学生的不同情况和需求,制定合适的教学计划，进行个性化指导，助力学员上岸。&q;,&q;avatar&q;:&q;19661648a9e627d.jpg&q;,&q;upperBodyPhoto&q;:null,&q;displayCoursePrefix&q;:&q;sydw&q;,&q;teacherStat&q;:{&q;teacherId&q;:16837,&q;episodeCount&q;:442,&q;scoreCount&q;:1576,&q;avgScore&q;:9.804568527918779,&q;fiveGradeAvgScore&q;:4.9,&q;updateTime&q;:1773585462870},&q;auditionEpisode&q;:{&q;episodeTitle&q;:&q;个人展示课&q;,&q;episodeVideoUrl&q;:&q;https://vod.fbstatic.cn/22e9ceb2vodbj1251001446/1a7c47ce1253642695750676159/Sc7AGWXJ4K0A.mp4?t=f2a4b300&a;us=4070880000&a;sign=33dc347897be647da623a7048bd9c97b&q;},&q;memberOfCPC&q;:false,&q;tags&q;:null},&q;teachChannel&q;:1,&q;offline&q;:null,&q;duration&q;:7828,&q;hasAudition&q;:false,&q;bizType&q;:0,&q;bizId&q;:&q;726825&q;,&q;supportReplay&q;:true,&q;extraInfo&q;:null,&q;liveConfig&q;:{&q;episodeId&q;:10795006,&q;supportMultiGroup&q;:false,&q;exerciseBizType&q;:0,&q;videoDisplayType&q;:0,&q;avForwardType&q;:0,&q;useIntelligentRoom&q;:false,&q;hasStrokeKeynote&q;:true,&q;verticalModeType&q;:0,&q;originEpisodeId&q;:0,&q;supportRtmp&q;:false,&q;supportPk&q;:true,&q;supportLuckyBag&q;:true,&q;supportUserNoteStroke&q;:false,&q;communicateType&q;:0,&q;one2One&q;:false,&q;fakeLive&q;:false},&q;validStatus&q;:1,&q;supportLive&q;:true,&q;supportAiCatalog&q;:false,&q;hasIntelligentPen&q;:false,&q;useLocalRecording&q;:false,&q;useIntelligentRoom&q;:false,&q;hasSalePosition&q;:false,&q;hasEpisodeCards&q;:true,&q;lockedForShouna&q;:false,&q;needSignIn&q;:false,&q;needTeacherSignIn&q;:false,&q;enablePadPencil&q;:true,&q;displayExercise&q;:false,&q;supportLuckyBag&q;:true,&q;supportLivePk&q;:true},{&q;id&q;:10795007,&q;kePrefix&q;:&q;sydw&q;,&q;courseId&q;:6,&q;status&q;:3,&q;playStatus&q;:3,&q;type&q;:33,&q;recordingType&q;:0,&q;mediaType&q;:0,&q;title&q;:&q;【公基非法】精选好题 沉浸刷题&q;,&q;innerTitle&q;:&q;&q;,&q;startTime&q;:1750651200000,&q;endTime&q;:1750658400000,&q;teacher&q;:{&q;id&q;:52947,&q;userId&q;:64240438,&q;name&q;:&q;鲁媛&q;,&q;brief&q;:&q;粉笔优质讲师&q;,&q;desc&q;:&q;粉笔优质教师\n五年一线教学授课经验，深耕一线考试考情，累计授课时长1000+，经验丰富。\n具有常识公共基础知识和言语科目丰富的实践经验及系统扎实的专业理论知识和对考情有深入研究，对最新命题趋势方向有深入研究。\n注重因材施教，在学员中具有非常好的口碑，理论扎实，讲解细致，上课风格条理清晰，且能够帮助学员全面掌握做题技巧，深受学员喜爱与好评。&q;,&q;avatar&q;:&q;1942b25f4360c2f.jpg&q;,&q;upperBodyPhoto&q;:null,&q;displayCoursePrefix&q;:&q;sydw&q;,&q;teacherStat&q;:{&q;teacherId&q;:52947,&q;episodeCount&q;:528,&q;scoreCount&q;:1131,&q;avgScore&q;:9.835543766578246,&q;fiveGradeAvgScore&q;:4.92,&q;updateTime&q;:1773544951083},&q;auditionEpisode&q;:{&q;episodeTitle&q;:&q;个人展示课&q;,&q;episodeVideoUrl&q;:&q;https://vod.fbstatic.cn/22e9ceb2vodbj1251001446/8010b9c95145403709537877405/oSJCJMLapA8A.mp4?t=f2a4b300&a;us=4070880000&a;sign=a23b3e7bcb54790ed90b33098592e763&q;},&q;memberOfCPC&q;:false,&q;tags&q;:null},&q;teachChannel&q;:1,&q;offline&q;:null,&q;duration&q;:7297,&q;hasAudition&q;:false,&q;bizType&q;:0,&q;bizId&q;:&q;726825&q;,&q;supportReplay&q;:true,&q;extraInfo&q;:null,&q;liveConfig&q;:{&q;episodeId&q;:10795007,&q;supportMultiGroup&q;:false,&q;exerciseBizType&q;:0,&q;videoDisplayType&q;:0,&q;avForwardType&q;:0,&q;useIntelligentRoom&q;:false,&q;hasStrokeKeynote&q;:true,&q;verticalModeType&q;:0,&q;originEpisodeId&q;:0,&q;supportRtmp&q;:false,&q;supportPk&q;:true,&q;supportLuckyBag&q;:true,&q;supportUserNoteStroke&q;:false,&q;communicateType&q;:0,&q;one2One&q;:false,&q;fakeLive&q;:false},&q;validStatus&q;:1,&q;supportLive&q;:true,&q;supportAiCatalog&q;:false,&q;hasIntelligentPen&q;:false,&q;useLocalRecording&q;:false,&q;useIntelligentRoom&q;:false,&q;hasSalePosition&q;:false,&q;hasEpisodeCards&q;:true,&q;lockedForShouna&q;:false,&q;needSignIn&q;:false,&q;needTeacherSignIn&q;:false,&q;enablePadPencil&q;:true,&q;displayExercise&q;:false,&q;supportLuckyBag&q;:true,&q;supportLivePk&q;:true},{&q;id&q;:10795039,&q;kePrefix&q;:&q;sydw&q;,&q;courseId&q;:6,&q;status&q;:3,&q;playStatus&q;:3,&q;type&q;:33,&q;recordingType&q;:0,&q;mediaType&q;:0,&q;title&q;:&q;【综应】精选好题 沉浸刷题&q;,&q;innerTitle&q;:&q;&q;,&q;startTime&q;:1750658400000,&q;endTime&q;:1750665600000,&q;teacher&q;:{&q;id&q;:21868,&q;userId&q;:67827421,&q;name&q;:&q;向亚灵&q;,&q;brief&q;:&q;粉笔优质讲师&q;,&q;desc&q;:&q;粉笔综应优质教师\n6年一线教学授课经验，参与各地区线上线下面试授课，累计授课时长1000+。具有综应科目丰富的实践经验及系统扎实的专业理论知识，熟练掌握各种笔试作答技巧，并且善于结合学员实际情况，对综应知识进行针对性讲解，有效的帮助学员快速提高。授课风格形象生动，能够针对考生心理灵活调整授课的方式、方法，帮助学员找到适合自己的学习风格。&q;,&q;avatar&q;:&q;19854f04cf39e38.jpg&q;,&q;upperBodyPhoto&q;:null,&q;displayCoursePrefix&q;:&q;sydw&q;,&q;teacherStat&q;:{&q;teacherId&q;:21868,&q;episodeCount&q;:568,&q;scoreCount&q;:933,&q;avgScore&q;:9.834941050375134,&q;fiveGradeAvgScore&q;:4.92,&q;updateTime&q;:1773572602303},&q;auditionEpisode&q;:{&q;episodeTitle&q;:&q;个人展示课&q;,&q;episodeVideoUrl&q;:&q;https://vod.fbstatic.cn/22e9ceb2vodbj1251001446/7d3c515f5145403709537706251/k4wf1XAUkbEA.mp4?t=f2a4b300&a;us=4070880000&a;sign=274982009db9fe68de2a8918ec41a92e&q;},&q;memberOfCPC&q;:false,&q;tags&q;:null},&q;teachChannel&q;:1,&q;offline&q;:null,&q;duration&q;:7958,&q;hasAudition&q;:false,&q;bizType&q;:0,&q;bizId&q;:&q;726825&q;,&q;supportReplay&q;:true,&q;extraInfo&q;:null,&q;liveConfig&q;:{&q;episodeId&q;:10795039,&q;supportMultiGroup&q;:false,&q;exerciseBizType&q;:0,&q;videoDisplayType&q;:0,&q;avForwardType&q;:0,&q;useIntelligentRoom&q;:false,&q;hasStrokeKeynote&q;:true,&q;verticalModeType&q;:0,&q;originEpisodeId&q;:0,&q;supportRtmp&q;:false,&q;supportPk&q;:true,&q;supportLuckyBag&q;:true,&q;supportUserNoteStroke&q;:false,&q;communicateType&q;:0,&q;one2One&q;:false,&q;fakeLive&q;:false},&q;validStatus&q;:1,&q;supportLive&q;:true,&q;supportAiCatalog&q;:false,&q;hasIntelligentPen&q;:false,&q;useLocalRecording&q;:false,&q;useIntelligentRoom&q;:false,&q;hasSalePosition&q;:false,&q;hasEpisodeCards&q;:true,&q;lockedForShouna&q;:false,&q;needSignIn&q;:false,&q;needTeacherSignIn&q;:false,&q;enablePadPencil&q;:true,&q;displayExercise&q;:false,&q;supportLuckyBag&q;:true,&q;supportLivePk&q;:true},{&q;id&q;:10795043,&q;kePrefix&q;:&q;sydw&q;,&q;courseId&q;:6,&q;status&q;:3,&q;playStatus&q;:3,&q;type&q;:33,&q;recordingType&q;:0,&q;mediaType&q;:0,&q;title&q;:&q;【言语】精选好题 沉浸刷题&q;,&q;innerTitle&q;:&q;&q;,&q;startTime&q;:1750665600000,&q;endTime&q;:1750672800000,&q;teacher&q;:{&q;id&q;:16948,&q;userId&q;:69316245,&q;name&q;:&q;巨琼&q;,&q;brief&q;:&q;粉笔优质讲师&q;,&q;desc&q;:&q;粉笔优质教师\n6年以上一线教学授课经验，累计授课时长2000+，授课人数10000+，授课评分4.9分，累计获得学员好评上千条。具有扎实系统的言语专业知识体系且线上线下均授课经验丰富，线上授课涵盖联考、山东、安徽等各省言语课程，线下曾多次担任联考、江苏等省份言语主讲。长期参与言语科目教研工作，真题解析、模拟题撰写、参与《职测3000题》 单题录制等，全面了解事业单位各省份言语命题规律及答题技巧。教学中，曾获事业单位教师风采大赛“三等奖”，持续积极探索生动有趣的教学方式，精准把握言语考点，帮助学员快速理解并掌握言语技巧，能以独特的方法引导学员攻克难关，提升答题准确率与速度，深受学员认可，助力多名学员成功实现自己的职业目标。&q;,&q;avatar&q;:&q;1746cf3620ab526.jpg&q;,&q;upperBodyPhoto&q;:null,&q;displayCoursePrefix&q;:&q;sydw&q;,&q;teacherStat&q;:{&q;teacherId&q;:16948,&q;episodeCount&q;:595,&q;scoreCount&q;:2018,&q;avgScore&q;:9.865213082259663,&q;fiveGradeAvgScore&q;:4.93,&q;updateTime&q;:1773488367488},&q;auditionEpisode&q;:{&q;episodeTitle&q;:&q;个人展示课&q;,&q;episodeVideoUrl&q;:&q;https://vod.fbstatic.cn/22e9ceb2vodbj1251001446/c5adc5685145403709538521768/r1Y9MG5YjPwA.mp4?t=f2a4b300&a;us=4070880000&a;sign=e92eaa0857512f99b08ff349fc652a92&q;},&q;memberOfCPC&q;:false,&q;tags&q;:null},&q;teachChannel&q;:1,&q;offline&q;:null,&q;duration&q;:7301,&q;hasAudition&q;:false,&q;bizType&q;:0,&q;bizId&q;:&q;726825&q;,&q;supportReplay&q;:true,&q;extraInfo&q;:null,&q;liveConfig&q;:{&q;episodeId&q;:10795043,&q;supportMultiGroup&q;:false,&q;exerciseBizType&q;:0,&q;videoDisplayType&q;:0,&q;avForwardType&q;:0,&q;useIntelligentRoom&q;:false,&q;hasStrokeKeynote&q;:true,&q;verticalModeType&q;:0,&q;originEpisodeId&q;:0,&q;supportRtmp&q;:false,&q;supportPk&q;:true,&q;supportLuckyBag&q;:true,&q;supportUserNoteStroke&q;:false,&q;communicateType&q;:0,&q;one2One&q;:false,&q;fakeLive&q;:false},&q;validStatus&q;:1,&q;supportLive&q;:true,&q;supportAiCatalog&q;:false,&q;hasIntelligentPen&q;:false,&q;useLocalRecording&q;:false,&q;useIntelligentRoom&q;:false,&q;hasSalePosition&q;:false,&q;hasEpisodeCards&q;:true,&q;lockedForShouna&q;:false,&q;needSignIn&q;:false,&q;needTeacherSignIn&q;:false,&q;enablePadPencil&q;:true,&q;displayExercise&q;:false,&q;supportLuckyBag&q;:true,&q;supportLivePk&q;:true},{&q;id&q;:10795169,&q;kePrefix&q;:&q;sydw&q;,&q;courseId&q;:6,&q;status&q;:3,&q;playStatus&q;:3,&q;type&q;:33,&q;recordingType&q;:0,&q;mediaType&q;:0,&q;title&q;:&q;【公基法律】精选好题 沉浸刷题&q;,&q;innerTitle&q;:&q;&q;,&q;startTime&q;:1750730400000,&q;endTime&q;:1750737600000,&q;teacher&q;:{&q;id&q;:28923,&q;userId&q;:80505035,&q;name&q;:&q;林婉华&q;,&q;brief&q;:&q;粉笔优质讲师&q;,&q;desc&q;:&q;粉笔优质教师，\n具有扎实的理论基础，能够熟练掌握笔试考情和命题趋势，多次参加教研会议，教研成果突出，著有多篇教研文章。\n5年一线教学经验，累计授课时长超千小时，授课经验丰富，语言风趣幽默，授课综合评分4.9，广受学员好评。\n累计督学带班超70个，带班人数逾千人，能够及时回复学员疑问，答疑思路清晰，指导学员发现自己的薄弱项并提出针对性的方法辅助解决问题。善于观察，能够从学员的学习情况中总结出易混易错知识点帮助提升。&q;,&q;avatar&q;:&q;1983b2798d5030e.jpg&q;,&q;upperBodyPhoto&q;:null,&q;displayCoursePrefix&q;:&q;sydw&q;,&q;teacherStat&q;:{&q;teacherId&q;:28923,&q;episodeCount&q;:609,&q;scoreCount&q;:802,&q;avgScore&q;:9.822942643391526,&q;fiveGradeAvgScore&q;:4.91,&q;updateTime&q;:1773544599718},&q;auditionEpisode&q;:{&q;episodeTitle&q;:&q;个人展示课&q;,&q;episodeVideoUrl&q;:&q;https://vod.fbstatic.cn/22e9ceb2vodbj1251001446/81e6bc0a5145403709537906845/JafPZKk51JwA.mp4?t=f2a4b300&a;us=4070880000&a;sign=9167ae8a132de87e85e55d782904dc7a&q;},&q;memberOfCPC&q;:false,&q;tags&q;:null},&q;teachChannel&q;:1,&q;offline&q;:null,&q;duration&q;:7054,&q;hasAudition&q;:false,&q;bizType&q;:0,&q;bizId&q;:&q;726825&q;,&q;supportReplay&q;:true,&q;extraInfo&q;:null,&q;liveConfig&q;:{&q;episodeId&q;:10795169,&q;supportMultiGroup&q;:false,&q;exerciseBizType&q;:0,&q;videoDisplayType&q;:0,&q;avForwardType&q;:0,&q;useIntelligentRoom&q;:false,&q;hasStrokeKeynote&q;:true,&q;verticalModeType&q;:0,&q;originEpisodeId&q;:0,&q;supportRtmp&q;:false,&q;supportPk&q;:true,&q;supportLuckyBag&q;:true,&q;supportUserNoteStroke&q;:false,&q;communicateType&q;:0,&q;one2One&q;:false,&q;fakeLive&q;:false},&q;validStatus&q;:1,&q;supportLive&q;:true,&q;supportAiCatalog&q;:false,&q;hasIntelligentPen&q;:false,&q;useLocalRecording&q;:false,&q;useIntelligentRoom&q;:false,&q;hasSalePosition&q;:false,&q;hasEpisodeCards&q;:true,&q;lockedForShouna&q;:false,&q;needSignIn&q;:false,&q;needTeacherSignIn&q;:false,&q;enablePadPencil&q;:true,&q;displayExercise&q;:false,&q;supportLuckyBag&q;:true,&q;supportLivePk&q;:true},{&q;id&q;:10795376,&q;kePrefix&q;:&q;sydw&q;,&q;courseId&q;:6,&q;status&q;:3,&q;playStatus&q;:3,&q;type&q;:33,&q;recordingType&q;:0,&q;mediaType&q;:0,&q;title&q;:&q;【公基非法】精选好题 沉浸刷题&q;,&q;innerTitle&q;:&q;&q;,&q;startTime&q;:1750816800000,&q;endTime&q;:1750824000000,&q;teacher&q;:{&q;id&q;:34183,&q;userId&q;:83886596,&q;name&q;:&q;赵佳佳&q;,&q;brief&q;:&q;粉笔优质讲师&q;,&q;desc&q;:&q;粉笔常识公基优质讲师\n6年一线教学经验，深耕事业单位考试，承担过笔试精品班、刷题班等多种班型，授课和实战经验丰富。\n\n曾参与真题教研解析工作，教研文章撰写工作，模拟题的教研工作，对最新命题趋势方向有深入研究;\n多次参加粉笔授课研讨会议，注重考场思维，针对学生困惑研究教学策略，深入研讨事考命题趋势及最新考情，注重自我提升，积累丰富笔试理论知识;\n累计授课超1400小时，累计评分达4.9分，善于把握学员个性化特点，因材施教，认真负责，真诚对待每一位学员。讲课生动形象，有代入感，学员可以在轻松愉快的氛围中学习，跟着老师节奏主动思考，学习知识，掌握知识。&q;,&q;avatar&q;:&q;1983ba750d61d0b.jpg&q;,&q;upperBodyPhoto&q;:null,&q;displayCoursePrefix&q;:&q;sydw&q;,&q;teacherStat&q;:{&q;teacherId&q;:34183,&q;episodeCount&q;:689,&q;scoreCount&q;:1641,&q;avgScore&q;:9.802559414990869,&q;fiveGradeAvgScore&q;:4.9,&q;updateTime&q;:1771456495223},&q;auditionEpisode&q;:null,&q;memberOfCPC&q;:false,&q;tags&q;:null},&q;teachChannel&q;:1,&q;offline&q;:null,&q;duration&q;:7753,&q;hasAudition&q;:false,&q;bizType&q;:0,&q;bizId&q;:&q;726825&q;,&q;supportReplay&q;:true,&q;extraInfo&q;:null,&q;liveConfig&q;:{&q;episodeId&q;:10795376,&q;supportMultiGroup&q;:false,&q;exerciseBizType&q;:0,&q;videoDisplayType&q;:0,&q;avForwardType&q;:0,&q;useIntelligentRoom&q;:false,&q;hasStrokeKeynote&q;:true,&q;verticalModeType&q;:0,&q;originEpisodeId&q;:0,&q;supportRtmp&q;:false,&q;supportPk&q;:true,&q;supportLuckyBag&q;:true,&q;supportUserNoteStroke&q;:false,&q;communicateType&q;:0,&q;one2One&q;:false,&q;fakeLive&q;:false},&q;validStatus&q;:1,&q;supportLive&q;:true,&q;supportAiCatalog&q;:false,&q;hasIntelligentPen&q;:false,&q;useLocalRecording&q;:false,&q;useIntelligentRoom&q;:false,&q;hasSalePosition&q;:false,&q;hasEpisodeCards&q;:true,&q;lockedForShouna&q;:false,&q;needSignIn&q;:false,&q;needTeacherSignIn&q;:false,&q;enablePadPencil&q;:true,&q;displayExercise&q;:false,&q;supportLuckyBag&q;:true,&q;supportLivePk&q;:true},{&q;id&q;:10795378,&q;kePrefix&q;:&q;sydw&q;,&q;courseId&q;:6,&q;status&q;:3,&q;playStatus&q;:3,&q;type&q;:33,&q;recordingType&q;:0,&q;mediaType&q;:0,&q;title&q;:&q;【判断】精选好题 沉浸刷题&q;,&q;innerTitle&q;:&q;&q;,&q;startTime&q;:1750824000000,&q;endTime&q;:1750831200000,&q;teacher&q;:{&q;id&q;:16684,&q;userId&q;:59358516,&q;name&q;:&q;周晶辉&q;,&q;brief&q;:&q;粉笔优质讲师&q;,&q;desc&q;:&q;粉笔优质教师\n六年一线教学授课经验，累计授课时长1000+小时，综合授课评分4.9+，实战经验丰富，授课逻辑清晰，多次参与科目教研工作、授课研讨会议，参与事业单位真题单题录制、模拟题撰写等，熟练掌握判断科目考情及命题趋势，擅长各省联考、江苏、浙江、广东等多地区考点，擅于从学员角度思考，帮助学员理清解题思路，掌握科目常规考点，突破科目重难考点，具有幽默诙谐、形象生动、条理清晰的授课风格，让学生在轻松的学习氛围中，用更简单的方法，找到更快捷的解题之道，深受广大学员的认可和好评。&q;,&q;avatar&q;:&q;198caf9ea93f698.jpg&q;,&q;upperBodyPhoto&q;:null,&q;displayCoursePrefix&q;:&q;sydw&q;,&q;teacherStat&q;:{&q;teacherId&q;:16684,&q;episodeCount&q;:449,&q;scoreCount&q;:1699,&q;avgScore&q;:9.85638610947615,&q;fiveGradeAvgScore&q;:4.93,&q;updateTime&q;:1773578657175},&q;auditionEpisode&q;:{&q;episodeTitle&q;:&q;个人展示课&q;,&q;episodeVideoUrl&q;:&q;https://vod.fbstatic.cn/22e9ceb2vodbj1251001446/85b397c93560136620837741859/inWAKAms518A.mp4?t=f2a4b300&a;us=4070880000&a;sign=8ae71ff49f003e5c8d83058d09cdc3db&q;},&q;memberOfCPC&q;:false,&q;tags&q;:null},&q;teachChannel&q;:1,&q;offline&q;:null,&q;duration&q;:6658,&q;hasAudition&q;:false,&q;bizType&q;:0,&q;bizId&q;:&q;726825&q;,&q;supportReplay&q;:true,&q;extraInfo&q;:null,&q;liveConfig&q;:{&q;episodeId&q;:10795378,&q;supportMultiGroup&q;:false,&q;exerciseBizType&q;:0,&q;videoDisplayType&q;:0,&q;avForwardType&q;:0,&q;useIntelligentRoom&q;:false,&q;hasStrokeKeynote&q;:true,&q;verticalModeType&q;:0,&q;