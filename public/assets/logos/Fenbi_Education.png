yBag&q;:true,&q;supportLivePk&q;:true},{&q;id&q;:11094704,&q;kePrefix&q;:&q;sydw&q;,&q;courseId&q;:6,&q;status&q;:3,&q;playStatus&q;:3,&q;type&q;:33,&q;recordingType&q;:0,&q;mediaType&q;:0,&q;title&q;:&q;【判断】精选好题 沉浸刷题&q;,&q;innerTitle&q;:&q;&q;,&q;startTime&q;:1761026400000,&q;endTime&q;:1761033600000,&q;teacher&q;:{&q;id&q;:56388,&q;userId&q;:95971831,&q;name&q;:&q;林栗&q;,&q;brief&q;:&q;粉笔优质讲师&q;,&q;desc&q;:&q;粉笔优质教师\n多年一线教学授课经验，具有判断科目丰富的实践经验及系统扎实的专业理论知识，全面了解事业单位判断推理部分的命题规律及管题技巧，善于结合学员实际情况，对知识点进行针对性讲解，善于通过启发式教学，激发学员自主思考能力，有效帮助学员快速提高。&q;,&q;avatar&q;:&q;1985a5de8a9346e.jpg&q;,&q;upperBodyPhoto&q;:null,&q;displayCoursePrefix&q;:&q;sydw&q;,&q;teacherStat&q;:{&q;teacherId&q;:56388,&q;episodeCount&q;:290,&q;scoreCount&q;:1061,&q;avgScore&q;:9.877474081055611,&q;fiveGradeAvgScore&q;:4.94,&q;updateTime&q;:1773473571043},&q;auditionEpisode&q;:{&q;episodeTitle&q;:&q;个人展示课&q;,&q;episodeVideoUrl&q;:&q;https://vod.fbstatic.cn/22e9ceb2vodbj1251001446/c81f82965145403714072054931/hyScwfm0Fo8A.mp4?t=f2a4b300&a;us=4070880000&a;sign=9fe4d91480a427e06131a0f5f04af827&q;},&q;memberOfCPC&q;:false,&q;tags&q;:null},&q;teachChannel&q;:1,&q;offline&q;:null,&q;duration&q;:8258,&q;hasAudition&q;:false,&q;bizType&q;:0,&q;bizId&q;:&q;726825&q;,&q;supportReplay&q;:true,&q;extraInfo&q;:null,&q;liveConfig&q;:{&q;episodeId&q;:11094704,&q;supportMultiGroup&q;:false,&q;exerciseBizType&q;:0,&q;videoDisplayType&q;:0,&q;avForwardType&q;:0,&q;useIntelligentRoom&q;:false,&q;hasStrokeKeynote&q;:true,&q;verticalModeType&q;:0,&q;originEpisodeId&q;:0,&q;supportRtmp&q;:false,&q;supportPk&q;:true,&q;supportLuckyBag&q;:true,&q;supportUserNoteStroke&q;:false,&q;communicateType&q;:0,&q;one2One&q;:false,&q;fakeLive&q;:false},&q;validStatus&q;:1,&q;supportLive&q;:true,&q;supportAiCatalog&q;:false,&q;hasIntelligentPen&q;:false,&q;useLocalRecording&q;:false,&q;useIntelligentRoom&q;:false,&q;hasSalePosition&q;:false,&q;hasEpisodeCards&q;:true,&q;lockedForShouna&q;:false,&q;needSignIn&q;:false,&q;needTeacherSignIn&q;:false,&q;enablePadPencil&q;:true,&q;displayExercise&q;:false,&q;supportLuckyBag&q;:true,&q;supportLivePk&q;:true},{&q;id&q;:11094708,&q;kePrefix&q;:&q;sydw&q;,&q;courseId&q;:6,&q;status&q;:3,&q;playStatus&q;:3,&q;type&q;:33,&q;recordingType&q;:0,&q;mediaType&q;:0,&q;title&q;:&q;【综应】精选好题 沉浸刷题&q;,&q;innerTitle&q;:&q;&q;,&q;startTime&q;:1761033600000,&q;endTime&q;:1761040800000,&q;teacher&q;:{&q;id&q;:17059,&q;userId&q;:67506738,&q;name&q;:&q;李怡辰&q;,&q;brief&q;:&q;粉笔优质讲师&q;,&q;desc&q;:&q;粉笔优质讲师\n硕士毕业985院校、六年事考授课经验，具有扎实一线教学经验，培训学员上千名。\n扎实的综应科目理论功底，能击破应试重点难点，梳理出实用性的解题思路。\n授课中耐心细致，参与提分营等各类产品授课，重点突出，思路逻辑清晰，能将最专业的知识讲得直白易懂，注重对学员思路的引导，实战性强。 \n多次参加粉笔教研活动，对考情梳理有深入研究，快速帮学员提分。&q;,&q;avatar&q;:&q;17470aeb32cd932.jpg&q;,&q;upperBodyPhoto&q;:null,&q;displayCoursePrefix&q;:&q;sydw&q;,&q;teacherStat&q;:{&q;teacherId&q;:17059,&q;episodeCount&q;:491,&q;scoreCount&q;:474,&q;avgScore&q;:9.789029535864975,&q;fiveGradeAvgScore&q;:4.89,&q;updateTime&q;:1773138021859},&q;auditionEpisode&q;:{&q;episodeTitle&q;:&q;个人展示课&q;,&q;episodeVideoUrl&q;:&q;https://vod.fbstatic.cn/22e9ceb2vodbj1251001446/bfd6505e5145403709545092730/laIcdGgauIQA.mp4?t=f2a4b300&a;us=4070880000&a;sign=7cc318009277acd589537d57f313e812&q;},&q;memberOfCPC&q;:false,&q;tags&q;:null},&q;teachChannel&q;:1,&q;offline&q;:null,&q;duration&q;:9106,&q;hasAudition&q;:false,&q;bizType&q;:0,&q;bizId&q;:&q;726825&q;,&q;supportReplay&q;:true,&q;extraInfo&q;:null,&q;liveConfig&q;:{&q;episodeId&q;:11094708,&q;supportMultiGroup&q;:false,&q;exerciseBizType&q;:0,&q;videoDisplayType&q;:0,&q;avForwardType&q;:0,&q;useIntelligentRoom&q;:false,&q;hasStrokeKeynote&q;:true,&q;verticalModeType&q;:0,&q;originEpisodeId&q;:0,&q;supportRtmp&q;:false,&q;supportPk&q;:true,&q;supportLuckyBag&q;:true,&q;supportUserNoteStroke&q;:false,&q;communicateType&q;:0,&q;one2One&q;:false,&q;fakeLive&q;:false},&q;validStatus&q;:1,&q;supportLive&q;:true,&q;supportAiCatalog&q;:false,&q;hasIntelligentPen&q;:false,&q;useLocalRecording&q;:false,&q;useIntelligentRoom&q;:false,&q;hasSalePosition&q;:false,&q;hasEpisodeCards&q;:true,&q;lockedForShouna&q;:false,&q;needSignIn&q;:false,&q;needTeacherSignIn&q;:false,&q;enablePadPencil&q;:true,&q;displayExercise&q;:false,&q;supportLuckyBag&q;:true,&q;supportLivePk&q;:true},{&q;id&q;:11094711,&q;kePrefix&q;:&q;sydw&q;,&q;courseId&q;:6,&q;status&q;:3,&q;playStatus&q;:3,&q;type&q;:33,&q;recordingType&q;:0,&q;mediaType&q;:0,&q;title&q;:&q;【公基法律】精选好题 沉浸刷题&q;,&q;innerTitle&q;:&q;&q;,&q;startTime&q;:1761105600000,&q;endTime&q;:1761112800000,&q;teacher&q;:{&q;id&q;:34129,&q;userId&q;:83514929,&q;name&q;:&q;刘思秀&q;,&q;brief&q;:&q;粉笔优质讲师&q;,&q;desc&q;:&q;粉笔优质教师\n六年一线教学经验，总授课时长累计超2500小时。多年深耕事业单位考试领域，教学经验丰富，紧跟考情时新热点，对考情、真题、命题方向理解深刻。粉笔事业单位笔试教研材料撰写人之一，四年模考命题经验，多次参加粉笔教研活动，分享授课经验心得，助力粉笔理论研发升级。多年小班带队老师，学员累计评分4.9，结班上岸率 72%，名下多位学员岗位第一入面。授课条理清晰，讲解风趣幽默，擅长化难为简，总结做题规律，将复杂的笔试知识点进行系统梳理，帮助学员把握知识点底层逻辑，减轻学员记忆负担，快速掌握笔试答题技巧。&q;,&q;avatar&q;:&q;1983b891b2af100.jpg&q;,&q;upperBodyPhoto&q;:null,&q;displayCoursePrefix&q;:&q;sydw&q;,&q;teacherStat&q;:{&q;teacherId&q;:34129,&q;episodeCount&q;:613,&q;scoreCount&q;:970,&q;avgScore&q;:9.721649484536082,&q;fiveGradeAvgScore&q;:4.86,&q;updateTime&q;:1773558647472},&q;auditionEpisode&q;:null,&q;memberOfCPC&q;:false,&q;tags&q;:null},&q;teachChannel&q;:1,&q;offline&q;:null,&q;duration&q;:8186,&q;hasAudition&q;:false,&q;bizType&q;:0,&q;bizId&q;:&q;726825&q;,&q;supportReplay&q;:true,&q;extraInfo&q;:null,&q;liveConfig&q;:{&q;episodeId&q;:11094711,&q;supportMultiGroup&q;:false,&q;exerciseBizType&q;:0,&q;videoDisplayType&q;:0,&q;avForwardType&q;:0,&q;useIntelligentRoom&q;:false,&q;hasStrokeKeynote&q;:true,&q;verticalModeType&q;:0,&q;originEpisodeId&q;:0,&q;supportRtmp&q;:false,&q;supportPk&q;:true,&q;supportLuckyBag&q;:true,&q;supportUserNoteStroke&q;:false,&q;communicateType&q;:0,&q;one2One&q;:false,&q;fakeLive&q;:false},&q;validStatus&q;:1,&q;supportLive&q;:true,&q;supportAiCatalog&q;:false,&q;hasIntelligentPen&q;:false,&q;useLocalRecording&q;:false,&q;useIntelligentRoom&q;:false,&q;hasSalePositio