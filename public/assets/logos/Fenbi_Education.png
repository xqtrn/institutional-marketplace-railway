&q;:10475669,&q;kePrefix&q;:&q;sydw&q;,&q;courseId&q;:6,&q;status&q;:3,&q;playStatus&q;:3,&q;type&q;:33,&q;recordingType&q;:0,&q;mediaType&q;:0,&q;title&q;:&q;【言语】精选好题 沉浸刷题&q;,&q;innerTitle&q;:&q;&q;,&q;startTime&q;:1744948800000,&q;endTime&q;:1744956000000,&q;teacher&q;:{&q;id&q;:17198,&q;userId&q;:73655782,&q;name&q;:&q;陈灵均&q;,&q;brief&q;:&q;粉笔优质讲师&q;,&q;desc&q;:&q;粉笔优质讲师\n六年教学经验，承担各种班型授课，理论知识扎实，能帮助考生系统备考，提高应试能力。\n深入研究各地真题，多次参与真题解析、模拟题命制等教研活动，准确把握考试动态及命题趋势，为考生提供备考方向和策略。\n授课深入浅出，化繁为简，擅长提炼逻辑和规律，帮助考生掌握核心要点，举一反三&q;,&q;avatar&q;:&q;1823937972498f7.jpg&q;,&q;upperBodyPhoto&q;:null,&q;displayCoursePrefix&q;:&q;sydw&q;,&q;teacherStat&q;:{&q;teacherId&q;:17198,&q;episodeCount&q;:462,&q;scoreCount&q;:1403,&q;avgScore&q;:9.81183178902352,&q;fiveGradeAvgScore&q;:4.91,&q;updateTime&q;:1773580094665},&q;auditionEpisode&q;:{&q;episodeTitle&q;:&q;个人展示课&q;,&q;episodeVideoUrl&q;:&q;https://vod.fbstatic.cn/22e9ceb2vodbj1251001446/48fa213a5145403708523044176/CrD3nYrPU6oA.mp4?t=f2a4b300&a;us=4070880000&a;sign=bdd8d0a92bdac0ab6d9102af2433a663&q;},&q;memberOfCPC&q;:false,&q;tags&q;:null},&q;teachChannel&q;:1,&q;offline&q;:null,&q;duration&q;:7415,&q;hasAudition&q;:false,&q;bizType&q;:0,&q;bizId&q;:&q;726825&q;,&q;supportReplay&q;:true,&q;extraInfo&q;:null,&q;liveConfig&q;:{&q;episodeId&q;:10475669,&q;supportMultiGroup&q;:false,&q;exerciseBizType&q;:0,&q;videoDisplayType&q;:0,&q;avForwardType&q;:0,&q;useIntelligentRoom&q;:false,&q;hasStrokeKeynote&q;:true,&q;verticalModeType&q;:0,&q;originEpisodeId&q;:0,&q;supportRtmp&q;:false,&q;supportPk&q;:true,&q;supportLuckyBag&q;:true,&q;supportUserNoteStroke&q;:false,&q;communicateType&q;:0,&q;one2One&q;:false,&q;fakeLive&q;:false},&q;validStatus&q;:1,&q;supportLive&q;:true,&q;supportAiCatalog&q;:false,&q;hasIntelligentPen&q;:false,&q;useLocalRecording&q;:false,&q;useIntelligentRoom&q;:false,&q;hasSalePosition&q;:false,&q;hasEpisodeCards&q;:true,&q;lockedForShouna&q;:false,&q;needSignIn&q;:false,&q;needTeacherSignIn&q;:false,&q;enablePadPencil&q;:true,&q;displayExercise&q;:false,&q;supportLuckyBag&q;:true,&q;supportLivePk&q;:true},{&q;id&q;:10475689,&q;kePrefix&q;:&q;sydw&q;,&q;courseId&q;:6,&q;status&q;:3,&q;playStatus&q;:3,&q;type&q;:33,&q;recordingType&q;:0,&q;mediaType&q;:0,&q;title&q;:&q;【公基非法】精选好题 沉浸刷题&q;,&q;innerTitle&q;:&q;&q;,&q;startTime&q;:1745028000000,&q;endTime&q;:1745035200000,&q;teacher&q;:{&q;id&q;:34196,&q;userId&q;:83885051,&q;name&q;:&q;马莹萍&q;,&q;brief&q;:&q;粉笔优质讲师&q;,&q;desc&q;:&q;粉笔常识公基优质教师\n6年授课经验，授课实战经验丰富。累计授课时长900+，授课人次2500+，授课评分4.9分，深受学员喜爱。长期扎根于常识公基非法及判断教学教研工作，曾撰写教研文章十余篇，撰写多地政府工作报告解读文件，参与全国常识公基非法密卷课件及讲义制作。授课班级中，公基成绩均有明显提升，历年考试中，均有多名学员取得80+的好成绩。授课风格幽默风趣，贴近实际，能够通过学员特点进行个性化指导，帮助学员突破瓶颈，一举成“公”。&q;,&q;avatar&q;:&q;198412a1819fc20.jpg&q;,&q;upperBodyPhoto&q;:null,&q;displayCoursePrefix&q;:&q;sydw&q;,&q;teacherStat&q;:{&q;teacherId&q;:34196,&q;episodeCount&q;:833,&q;scoreCount&q;:1519,&q;avgScore&q;:9.81566820276498,&q;fiveGradeAvgScore&q;:4.91,&q;updateTime&q;:1773561169054},&q;auditionEpisode&q;:{&q;episodeTitle&q;:&q;个人展示课&q;,&q;episodeVideoUrl&q;:&q;https://vod.fbstatic.cn/22e9ceb2vodbj1251001446/72db76805145403709544091356/dk0lqGQPopcA.mp4?t=f2a4b300&a;us=4070880000&a;sign=c98ccaef848337ae40404519654c80f6&q;},&q;memberOfCPC&q;:false,&q;tags&q;:null},&q;teachChannel&q;:1,&q;offline&q;:null,&q;duration&q;:7733,&q;hasAudition&q;:false,&q;bizType&q;:0,&q;bizId&q;:&q;726825&q;,&q;supportReplay&q;:true,&q;extraInfo&q;:null,&q;liveConfig&q;:{&q;episodeId&q;:10475689,&q;supportMultiGroup&q;:false,&q;exerciseBizType&q;:0,&q;videoDisplayType&q;:0,&q;avForwardType&q;:0,&q;useIntelligentRoom&q;:false,&q;hasStrokeKeynote&q;:true,&q;verticalModeType&q;:0,&q;originEpisodeId&q;:0,&q;supportRtmp&q;:false,&q;supportPk&q;:true,&q;supportLuckyBag&q;:true,&q;supportUserNoteStroke&q;:false,&q;communicateType&q;:0,&q;one2One&q;:false,&q;fakeLive&q;:false},&q;validStatus&q;:1,&q;supportLive&q;:true,&q;supportAiCatalog&q;:false,&q;hasIntelligentPen&q;:false,&q;useLocalRecording&q;:false,&q;useIntelligentRoom&q;:false,&q;hasSalePosition&q;:false,&q;hasEpisodeCards&q;:true,&q;lockedForShouna&q;:false,&q;needSignIn&q;:false,&q;needTeacherSignIn&q;:false,&q;enablePadPencil&q;:true,&q;displayExercise&q;:false,&q;supportLuckyBag&q;:true,&q;supportLivePk&q;:true},{&q;id&q;:10475704,&q;kePrefix&q;:&q;sydw&q;,&q;courseId&q;:6,&q;status&q;:3,&q;playStatus&q;:3,&q;type&q;:33,&q;recordingType&q;:0,&q;mediaType&q;:0,&q;title&q;:&q;【数资】精选好题 沉浸刷题&q;,&q;innerTitle&q;:&q;&q;,&q;startTime&q;:1745042400000,&q;endTime&q;:1745049600000,&q;teacher&q;:{&q;id&q;:16574,&q;userId&q;:73028298,&q;name&q;:&q;廖雅云&q;,&q;brief&q;:&q;粉笔优质讲师&q;,&q;desc&q;:&q;粉笔优质讲师\n多年一线教学授课经验，深耕事业单位考试，承担过笔试精品班、刷题班、冲刺班等多种班型,授课经验丰富。\n深入了解职测数资近年来的考情、重难点以及不同考点的解题技巧，理论扎实。\n参与笔试真题教研和解析撰写、终审工作,并多次参与图书以及相关资料的编写，对数资最新命题趋势方向有深入研究；\n多次参加粉笔授课研讨会议，针对学生困惑研究教学策略，拓展考场思维，能够帮助学员将所学理论更好应用在实际解题当中，拓展解题思路；\n授课风格:授课累计评分达4.9分，讲课耐心细致，课堂氛围轻松活跃，与学员重在沟通，能够从学员角度出发去找问题、解决问题，深受学员的喜爱。&q;,&q;avatar&q;:&q;19854f590ec1eda.jpg&q;,&q;upperBodyPhoto&q;:null,&q;displayCoursePrefix&q;:&q;sydw&q;,&q;teacherStat&q;:{&q;teacherId&q;:16574,&q;episodeCount&q;:739,&q;scoreCount&q;:6952,&q;avgScore&q;:9.825373993095512,&q;fiveGradeAvgScore&q;:4.91,&q;updateTime&q;:1773622398088},&q;auditionEpisode&q;:{&q;episodeTitle&q;:&q;个人展示课&q;,&q;episodeVideoUrl&q;:&q;https://vod.fbstatic.cn/22e9ceb2vodbj1251001446/725c3a375145403709544020247/E4rt1kFdZL4A.mp4?t=f2a4b300&a;us=4070880000&a;sign=423b76444fe4ed707f565354eef136e2&q;},&q;memberOfCPC&q;:false,&q;tags&q;:null},&q;teachChannel&q;:1,&q;offline&q;:null,&q;duration&q;:8153,&q;hasAudition&q;:false,&q;bizType&q;:0,&q;bizId&q;:&q;726825&q;,&q;supportReplay&q;:true,&q;extraInfo&q;:null,&q;liveConfig&q;:{&q;episodeId&q;:10475704,&q;supportMultiGroup&q;:false,&q;exerciseBizType&q;:0,&q;videoDisplayType&q;:0,&q;avForwardType&q;:0,&q;useIntelligentRoom&q;:false,&q;hasStrokeKeynote&q;:true,&q;verticalModeType&q;:0,&q;originEpisodeId&q;:0,&q;supportRtmp&q;:false,&q;supportPk&q;:true,&q;supportLuckyBag&q;:true,&q;supportUserNoteStroke&q;:false,&q;communicateType&q;:0,&q;one2One&q;:false,&q;fakeLive&q;:false},&q;validStatus&q;:1,&q;supportLive&q;:true,&q;supportAiCatalog&q;:false,&q;hasIntelligentPen&q;:false,&q;useLocalRecording&q;:false,&q;useIntelligentRoom&q;:false,&q;hasSalePosition&q;:false,&q;hasEpisodeCards&q;:true,&q;lockedForShouna&q;:false,&q;needSignIn&q;:false,&q;needTeacherSignIn&q;:false,&q;enablePadPencil&q;:true,&q;displayExercise&q;:false,&q;supportLuckyBag&q;:true,&q;supportLivePk&q;:true},{&q;id&q;:10475713,&q;kePrefix&q;:&q;sydw&q;,&q;courseId&q;:6,&q;status&q;:3,&q;playStatus&q;:3,&q;type&q;:33,&q;recordingType&q;:0,&q;mediaType&q;:0,&q;title&q;:&q;【判断】精选好题 沉浸刷题&q;,&q;innerTitle&q;:&q;&q;,&q;startTime&q;:1745128800000,&q;endTime&q;:1745136000000,&q;teacher&q;:{&q;id&q;:16608,&q;userId&q;:69120773,&q;name&q;:&q;熊超&q;,&q;brief&q;:&q;粉笔优质讲师&q;,&q;desc&q;:&q;粉笔优质教师\n1.6年一线教学授课经验，多年深耕事业单位考试，承担线上多种面试课程，授课经验丰富，逻辑清晰，擅长引导与拓展。\n2.具有丰富的实战经验，考场应试能力突出，专业理论知识系统扎实，对事业单位、军队文职等考情有深入研究:\n①多年参与面试题目真题教研和解析撰写、教研文章等的制作工作，全面了解事业单位考试近年来命题特点以及答题逻辑与技巧;\n②多次参加粉笔授课研讨会，针对面试题目进行深入探讨，多次分享答题经验及授课经验;\n3.学生口碑：风格独特，讲解幽默风趣，同时不失严谨，且擅长引导思考、深入浅出、举一反三、思维发散，以简单的方式激发学员学习热情，快速提高。&q;,&q;avatar&q;:&q;1746836fc090a43.jpg&q;,&q;upperBodyPhoto&q;:null,&q;displayCoursePrefix&q;:&q;sydw&q;,&q;teacherStat&q;:{&q;teacherId&q;:16608,&q;episodeCount&q;:501,&q;scoreCount&q;:2365,&q;avgScore&q;:9.671881606765316,&q;fiveGradeAvgScore&q;:4.84,&q;updateTime&q;:1773561581097},&q;auditionEpisode&q;:null,&q;memberOfCPC&q;:false,&q;tags&q;:null},&q;teachChannel&q;:1,&q;offline&q;:null,&q;duration&q;:8954,&q;hasAudition&q;:false,&q;bizType&q;:0,&q;bizId&q;:&q;726825&q;,&q;supportReplay&q;:true,&q;extraInfo&q;:null,&q;liveConfig&q;:{&q;episodeId&q;:10475713,&q;supportMultiGroup&q;:false,&q;exerciseBizType&q;:0,&q;videoDisplayType&q;:0,&q;avForwardType&q;:0,&q;useIntelligentRoom&q;:false,&q;hasStrokeKeynote&q;:true,&q;verticalModeType&q;:0,&q;originEpisodeId&q;:0,&q;supportRtmp&q;:false,&q;supportPk&q;:true,&q;supportLuckyBag&q;:true,&q;supportUserNoteStroke&q;:false,&q;communicateType&q;:0,&q;one2One&q;:false,&q;fakeLive&q;:false},&q;validStatus&q;:1,&q;supportLive&q;:true,&q;supportAiCatalog&q;:false,&q;hasIntelligentPen&q;:false,&q;useLocalRecording&q;:false,&q;useIntelligentRoom&q;:false,&q;hasSalePosition&q;:false,&q;hasEpisodeCards&q;:true,&q;lockedForShouna&q;:false,&q;needSignIn&q;:false,&q;needTeacherSignIn&q;:false,&q;enablePadPencil&q;:true,&q;displayExercise&q;:false,&q;supportLuckyBag&q;:true,&q;supportLivePk&q;:true},{&q;id&q;:10475728,&q;kePrefix&q;:&q;sydw&q;,&q;courseId&q;:6,&q;status&q;:3,&q;playStatus&q;:3,&q;type&q;:33,&q;recordingType&q;:0,&q;mediaType&q;:0,&q;title&q;:&q;【判断】精选好题 沉浸刷题&q;,&q;innerTitle&q;:&q;&q;,&q;startTime&q;:1745200800000,&q;endTime&q;:1745208000000,&q;teacher&q;:{&q;id&q;:16569,&q;userId&q;:70075243,&q;name&q;:&q;尚美琦&q;,&q;brief&q;:&q;粉笔优质讲师&q;,&q;desc&q;:&q;粉笔优质教师\n六年一线教学授课经验，曾承担线上+线下精品班、刷题班授课，授课时长3000+小时 具有判断科目丰富的实践经验及系统扎实的专业理论知识，对事业编联考及军队文职考情深入研究 ①撰写多篇事业单位笔试教研材料，在粉笔教师内部进行共享； ②多次参加粉笔授课研讨会议，全面把握事考命题趋势及最新考情，多次参加粉笔教研活动，分享授课经验心得，助力粉笔理论研发升级 累计评分达4.9，细致幽默的讲解风格，让学生在轻松的学习氛围中，用更简单的方法，更通俗的例子解题，深受广大学员的认可和好评；在学员中具有非常好的口碑，是值得信赖的好导师。&q;,&q;avatar&q;:&q;17467e73b22e1a8.jpg&q;,&q;upperBodyPhoto&q;:null,&q;displayCoursePrefix&q;:&q;sydw&q;,&q;teacherStat&q;:{&q;teacherId&q;:16569,&q;episodeCount&q;:480,&q;scoreCount&q;:1699,&q;avgScore&q;:9.822248381400826,&q;fiveGradeAvgScore&q;:4.91,&q;updateTime&q;:1773611259167},&q;auditionEpisode&q;:{&q;episodeTitle&q;:&q;个人展示课&q;,&q;episodeVideoUrl&q;:&q;https://vod.fbstatic.cn/22e9ceb2vodbj1251001446/e44a7b0c5145403708868581059/9u4GtiC34EwA.mp4?t=f2a4b300&a;us=4070880000&a;sign=100de2e81d7376355ed86e067629ba50&q;},&q;memberOfCPC&q;:false,&q;tags&q;:null},&q;teachChannel&q;:1,&q;offline&q;:null,&q;duration&q;:7266,&q;hasAudition&q;:false,&q;bizType&q;:0,&q;bizId&q;:&q;726825&q;,&q;supportReplay&q;:true,&q;extraInfo&q;:null,&q;liveConfig&q;:{&q;episodeId&q;:10475728,&q;supportMultiGroup&q;:false,&q;exerciseBizType&q;:0,&q;videoDisplayType&q;:0,&q;avForwardType&q;:0,&q;useIntelligentRoom&q;:false,&q;hasStrokeKeynote&q;:true,&q;verticalModeType&q;:0,&q;originEpisodeId&q;:0,&q;supportRtmp&q;:false,&q;supportPk&q;:true,&q;supportLuckyBag&q;:true,&q;supportUserNoteStroke&q;:false,&q;communicateType&q;:0,&q;one2One&q;:false,&q;fakeLive&q;:false},&q;validStatus&q;:1,&q;supportLive&q;:true,&q;supportAiCatalog&q;:false,&q;hasIntelligentPen&q;:false,&q;useLocalRecording&q;:false,&q;useIntelligentRoom&q;:false,&q;hasSalePosition&q;:false,&q;hasEpisodeCards&q;:true,&q;lockedForShouna&q;:false,&q;needSignIn&q;:false,&q;needTeacherSignIn&q;:false,&q;enablePadPencil&q;:true,&q;displayExercise&q;:false,&q;supportLuckyBag&q;:true,&q;supportLivePk&q;:true},{&q;id&q;:10475765,&q;kePrefix&q;:&q;sydw&q;,&q;courseId&q;:6,&q;status&q;:3,&q;playStatus&q;:3,&q;type&q;:33,&q;recordingType&q;:0,&q;mediaType&q;:0,&q;title&q;:&q;【综应】精选好题 沉浸刷题&q;,&q;innerTitle&q;:&q;&q;,&q;startTime&q;:1745208000000,&q;endTime&q;:1745215200000,&q;teacher&q;:{&q;id&q;:64119,&q;userId&q;:90008449,&q;name&q;:&q;黄于晨&q;,&q;brief&q;:&q;粉笔优质讲师&q;,&q;desc&q;:&q;粉笔综应科目优质讲师\n多年一线教学经验，承担过线下笔试精品班，刷题班等多种班型，多次参加粉笔授课研讨会议，全面把握事考笔试命题趋势及最新考情，长期从事相关科目的教研工作，授课经验丰富，思路清晰，能够调动学员积极性。授课重点突出，能够及时总结拓展，针对性的解决学生的问题，制定合适的教学计划，进行个性化指导，助力学员上岸。&q;,&q;avatar&q;:&q;1945f2bc8a79ca7.jpg&q;,&q;upperBodyPhoto&q;:null,&q;displayCoursePrefix&q;:&q;sydw&q;,&q;teacherStat&q;:{&q;teacherId&q;:64119,&q;episodeCount&q;:501,&q;scoreCount&q;:524,&q;avgScore&q;:9.977099236641225,&q;fiveGradeAvgScore&q;:4.99,&q;updateTime&q;:1773581373076},&q;auditionEpisode&q;:{&q;episodeTitle&q;:&q;个人展示课&q;,&q;episodeVideoUrl&q;:&q;https://vod.fbstatic.cn/22e9ceb2vodbj1251001446/87956e2f5145403709544958863/UMDoH2GAdAIA.mp4?t=f2a4b300&a;us=4070880000&a;sign=5277a4d363f925d16bd6c83ac5410861&q;},&q;memberOfCPC&q;:false,&q;tags&q;:null},&q;teachChannel&q;:1,&q;offline&q;:null,&q;duration&q;:6885,&q;hasAudition&q;:false,&q;bizType&q;:0,&q;bizId&q;:&q;726825&q;,&q;supportReplay&q;:true,&q;extraInfo&q;:null,&q;liveConfig&q;:{&q;episodeId&q;:10475765,&q;supportMultiGroup&q;:false,&q;exerciseBizType&q;:0,&q;videoDisplayType&q;:0,&q;avForwardType&q;:0,&q;useIntelligentRoom&q;:false,&q;hasStrokeKeynote&q;:true,&q;verticalModeType&q;:0,&q;originEpisodeId&q;:0,&q;supportRtmp&q;:false,&q;supportPk&q;:true,&q;supportLuckyBag&q;:true,&q;supportUserNoteStroke&q;:false,&q;communicateType&q;:0,&q;one2One&q;:false,&q;fakeLive&q;:false},&q;validStatus&q;:1,&q;supportLive&q;:true,&q;supportAiCatalog&q;:false,&q;hasIntelligentPen&q;:false,&q;useLocalRecording&q;:false,&q;useIntelligentRoom&q;:false,&q;hasSalePosition&q;:false,&q;hasEpisodeCards&q;:true,&q;lockedForShouna&q;:false,&q;needSignIn&q;:false,&q;needTeacherSignIn&q;:false,&q;enablePadPencil&q;:true,&q;displayExercise&q;:false,&q;supportLuckyBag&q;:true,&q;supportLivePk&q;:true},{&q;id&q;:10475787,&q;kePrefix&q;:&q;sydw&q;,&q;courseId&q;:6,&q;status&q;:3,&q;playStatus&q;:3,&q;type&q;:33,&q;recordingType&q;:0,&q;mediaType&q;:0,&q;title&q;:&q;【综应】精选好题 沉浸刷题&q;,&q;innerTitle&q;:&q;&q;,&q;startTime&q;:1745294400000,&q;endTime&q;:1745301600000,&q;teacher&q;:{&q;id&q;:16833,&q;userId&q;:57723890,&q;name&q;:&q;李珍芳&q;,&q;brief&q;:&q;粉笔优质讲师&q;,&q;desc&q;:&q;粉笔优质教师\n7年以上公考教学经验，授课经验丰富，线上累计授课时长1000+，授课人次3000+，授课累计评分4.9。多次参与全国事业单位综应考情以及热点梳理，熟悉事业单位联考综应ABC考情、命题特点和答题技巧。擅长联考、山东、江苏、浙江等地事业单位以及三支一扶的综应课程，并参与综应各大题型人工批改服务上千份，了解学员作答综应的难点、痛点，能精准定位学员薄弱点，对综应有独到的见解。授课思路清晰，逻辑严谨，操作性强，擅长因材施教，在学员中具有非常好的口碑，是值得信赖的好老师。&q;,&q;avatar&q;:&q;19841215f64df6f.jpg&q;,&q;upperBodyPhoto&q;:null,&q;displayCoursePrefix&q;:&q;sydw&q;,&q;teacherStat&q;:{&q;teacherId&q;:16833,&q;episodeCount&q;:409,&q;scoreCount&q;:405,&q;avgScore&q;:9.841975308641969,&q;fiveGradeAvgScore&q;:4.92,&q;updateTime&q;:1773052091382},&q;auditionEpisode&q;:{&q;episodeTitle&q;:&q;个人展示课&q;,&q;episodeVideoUrl&q;:&q;https://vod.fbstatic.cn/22e9ceb2vodbj1251001446/7a0a71cb5145403709466476960/iuy2CLkvs8gA.mp4?t=f2a4b300&a;us=4070880000&a;sign=9b6fa00b91c85f610da0b5f435be8997&q;},&q;memberOfCPC&q;:false,&q;tags&q;:null},&q;teachChannel&q;:1,&q;offline&q;:null,&q;duration&q;:6984,&q;hasAudition&q;:false,&q;bizType&q;:0,&q;bizId&q;:&q;726825&q;,&q;supportReplay&q;:true,&q;extraInfo&q;:null,&q;liveConfig&q;:{&q;episodeId&q;:10475787,&q;supportMultiGroup&q;:false,&q;exerciseBizType&q;:0,&q;videoDisplayType&q;:0,&q;avForwardType&q;:0,&q;useIntelligentRoom&q;:false,&q;hasStrokeKeynote&q;:true,&q;verticalModeType&q;:0,&q;originEpisodeId&q;:0,&q;supportRtmp&q;:false,&q;supportPk&q;:true,&q;supportLuckyBag&q;:true,&q;supportUserNoteStroke&q;:false,&q;communicateType&q;:0,&q;one2One&q;:false,&q;fakeLive&q;:false},&q;validStatus&q;:1,&q;supportLive&q;:true,&q;supportAiCatalog&q;:false,&q;hasIntelligentPen&q;:false,&q;useLocalRecording&q;:false,&q;useIntelligentRoom&q;:false,&q;hasSalePosition&q;:false,&q;hasEpisodeCards&q;:true,&q;lockedForShouna&q;:false,&q;needSignIn&q;:false,&q;needTeacherSignIn&q;:false,&q;enablePadPencil&q;:true,&q;displayExercise&q;:false,&q;supportLuckyBag&q;:true,&q;supportLivePk&q;:true},{&q;id&q;:10475794,&q;kePrefix&q;:&q;sydw&q;,&q;courseId&q;:6,&q;status&q;:3,&q;playStatus&q;:3,&q;type&q;:33,&q;recordingType&q;:0,&q;mediaType&q;:0,&q;title&q;:&q;【言语】精选好题 沉浸刷题&q;,&q;innerTitle&q;:&q;&q;,&q;startTime&q;:1745301600000,&q;endTime&q;:1745308800000,&q;teacher&q;:{&q;id&q;:56429,&q;userId&q;:74160353,&q;name&q;:&q;邱宜静&q;,&q;brief&q;:&q;粉笔优质讲师&q;,&q;desc&q;:&q;粉笔优质教师\n五年一线教学授课经验，长期致力于事业单位考试研究与教学，对事业单位招聘考试体系有着深入的理解和扎实的教学经验。\n具有言语科目丰富的实践经验及系统扎实的专业理论知识和对事业单位言语考情的深入研究:\n多次参与笔试真题教研和解析撰写工作，对言语命题趋势方向有着深入的研究;\n多次参加粉笔授课研讨会议，深入研讨事考言语命题趋势及最新考情;\n授课特点:擅长将复杂的知识点转化为易于理解的教学内容，通过循序渐进的教学方式，引导学生逐步掌握所需的知识点，帮助学员快速掌握言语科目的核心要点，提升解题能力和应试技巧，成功帮助数百名考生顺利通过事业单位招聘考试。&q;,&q;avatar&q;:&q;18408e0ee9a5e5d.jpg&q;,&q;upperBodyPhoto&q;:null,&q;displayCoursePrefix&q;:&q;sydw&q;,&q;teacherStat&q;:{&q;teacherId&q;:56429,&q;episodeCount&q;:185,&q;scoreCount&q;:627,&q;avgScore&q;:9.763955342902712,&q;fiveGradeAvgScore&q;:4.88,&q;updateTime&q;:1773327807084},&q;auditionEpisode&q;:{&q;episodeTitle&q;