;:1,&q;supportLive&q;:true,&q;supportAiCatalog&q;:false,&q;hasIntelligentPen&q;:false,&q;useLocalRecording&q;:false,&q;useIntelligentRoom&q;:false,&q;hasSalePosition&q;:false,&q;hasEpisodeCards&q;:true,&q;lockedForShouna&q;:false,&q;needSignIn&q;:false,&q;needTeacherSignIn&q;:false,&q;enablePadPencil&q;:true,&q;displayExercise&q;:false,&q;supportLuckyBag&q;:true,&q;supportLivePk&q;:true},{&q;id&q;:10850122,&q;kePrefix&q;:&q;sydw&q;,&q;courseId&q;:6,&q;status&q;:3,&q;playStatus&q;:3,&q;type&q;:33,&q;recordingType&q;:0,&q;mediaType&q;:0,&q;title&q;:&q;【判断】精选好题 沉浸刷题&q;,&q;innerTitle&q;:&q;&q;,&q;startTime&q;:1753689600000,&q;endTime&q;:1753696800000,&q;teacher&q;:{&q;id&q;:56388,&q;userId&q;:95971831,&q;name&q;:&q;林栗&q;,&q;brief&q;:&q;粉笔优质讲师&q;,&q;desc&q;:&q;粉笔优质教师\n多年一线教学授课经验，具有判断科目丰富的实践经验及系统扎实的专业理论知识，全面了解事业单位判断推理部分的命题规律及管题技巧，善于结合学员实际情况，对知识点进行针对性讲解，善于通过启发式教学，激发学员自主思考能力，有效帮助学员快速提高。&q;,&q;avatar&q;:&q;1985a5de8a9346e.jpg&q;,&q;upperBodyPhoto&q;:null,&q;displayCoursePrefix&q;:&q;sydw&q;,&q;teacherStat&q;:{&q;teacherId&q;:56388,&q;episodeCount&q;:290,&q;scoreCount&q;:1061,&q;avgScore&q;:9.877474081055611,&q;fiveGradeAvgScore&q;:4.94,&q;updateTime&q;:1773473571043},&q;auditionEpisode&q;:{&q;episodeTitle&q;:&q;个人展示课&q;,&q;episodeVideoUrl&q;:&q;https://vod.fbstatic.cn/22e9ceb2vodbj1251001446/c81f82965145403714072054931/hyScwfm0Fo8A.mp4?t=f2a4b300&a;us=4070880000&a;sign=9fe4d91480a427e06131a0f5f04af827&q;},&q;memberOfCPC&q;:false,&q;tags&q;:null},&q;teachChannel&q;:1,&q;offline&q;:null,&q;duration&q;:8282,&q;hasAudition&q;:false,&q;bizType&q;:0,&q;bizId&q;:&q;726825&q;,&q;supportReplay&q;:true,&q;extraInfo&q;:null,&q;liveConfig&q;:{&q;episodeId&q;:10850122,&q;supportMultiGroup&q;:false,&q;exerciseBizType&q;:0,&q;videoDisplayType&q;:0,&q;avForwardType&q;:0,&q;useIntelligentRoom&q;:false,&q;hasStrokeKeynote&q;:true,&q;verticalModeType&q;:0,&q;originEpisodeId&q;:0,&q;supportRtmp&q;:false,&q;supportPk&q;:true,&q;supportLuckyBag&q;:true,&q;supportUserNoteStroke&q;:false,&q;communicateType&q;:0,&q;one2One&q;:false,&q;fakeLive&q;:false},&q;validStatus&q;:1,&q;supportLive&q;:true,&q;supportAiCatalog&q;:false,&q;hasIntelligentPen&q;:false,&q;useLocalRecording&q;:false,&q;useIntelligentRoom&q;:false,&q;hasSalePosition&q;:false,&q;hasEpisodeCards&q;:true,&q;lockedForShouna&q;:false,&q;needSignIn&q;:false,&q;needTeacherSignIn&q;:false,&q;enablePadPencil&q;:true,&q;displayExercise&q;:false,&q;supportLuckyBag&q;:true,&q;supportLivePk&q;:true},{&q;id&q;:10850125,&q;kePrefix&q;:&q;sydw&q;,&q;courseId&q;:6,&q;status&q;:3,&q;playStatus&q;:3,&q;type&q;:33,&q;recordingType&q;:0,&q;mediaType&q;:0,&q;title&q;:&q;【综应】精选好题 沉浸刷题&q;,&q;innerTitle&q;:&q;&q;,&q;startTime&q;:1753754400000,&q;endTime&q;:1753761600000,&q;teacher&q;:{&q;id&q;:33464,&q;userId&q;:79618484,&q;name&q;:&q;钟页心&q;,&q;brief&q;:&q;粉笔优质讲师&q;,&q;desc&q;:&q;粉笔优质教师\n多次参加粉笔教研会议，全面把握各地区最新考情，积累丰富知识。\n五年一线教学经验，承担线上和线下精品班、系统班多种班型授课。课堂互动性佳，授课内容深入浅出，引导性强，激发学员学习热情，通过大量真实案例和实战演练让学生在练习中掌握答题技巧，灵活应对各类题目。\n累计线上授课超900小时，积累评分4.9分以上。针对性指导，发掘个人优势，帮助学员树立信心，答出自己真实的思考，突破自我，提高答题逻辑性和准确性，深受学生信赖。&q;,&q;avatar&q;:&q;17880f97c0ca868.jpg&q;,&q;upperBodyPhoto&q;:null,&q;displayCoursePrefix&q;:&q;sydw&q;,&q;teacherStat&q;:{&q;teacherId&q;:33464,&q;episodeCount&q;:462,&q;scoreCount&q;:280,&q;avgScore&q;:9.757142857142858,&q;fiveGradeAvgScore&q;:4.88,&q;updateTime&q;:1773388977630},&q;auditionEpisode&q;:{&q;episodeTitle&q;:&q;个人展示课&q;,&q;episodeVideoUrl&q;:&q;https://vod.fbstatic.cn/22e9ceb2vodbj1251001446/b4d00d621253642695657120814/yj7Ea7PjTXcA.mp4?t=f2a4b300&a;us=4070880000&a;sign=385e5bb2e5dde920bf1d27a23669c23f&q;},&q;memberOfCPC&q;:false,&q;tags&q;:null},&q;teachChannel&q;:1,&q;offline&q;:null,&q;duration&q;:8632,&q;hasAudition&q;:false,&q;bizType&q;:0,&q;bizId&q;:&q;726825&q;,&q;supportReplay&q;:true,&q;extraInfo&q;:null,&q;liveConfig&q;:{&q;episodeId&q;:10850125,&q;supportMultiGroup&q;:false,&q;exerciseBizType&q;:0,&q;videoDisplayType&q;:0,&q;avForwardType&q;:0,&q;useIntelligentRoom&q;:false,&q;hasStrokeKeynote&q;:true,&q;verticalModeType&q;:0,&q;originEpisodeId&q;:0,&q;supportRtmp&q;:false,&q;supportPk&q;:true,&q;supportLuckyBag&q;:true,&q;supportUserNoteStroke&q;:false,&q;communicateType&q;:0,&q;one2One&q;:false,&q;fakeLive&q;:false},&q;validStatus&q;:1,&q;supportLive&q;:true,&q;supportAiCatalog&q;:false,&q;hasIntelligentPen&q;:false,&q;useLocalRecording&q;:false,&q;useIntelligentRoom&q;:false,&q;hasSalePosition&q;:false,&q;hasEpisodeCards&q;:true,&q;lockedForShouna&q;:false,&q;needSignIn&q;:false,&q;needTeacherSignIn&q;:false,&q;enablePadPencil&q;:true,&q;displayExercise&q;:false,&q;supportLuckyBag&q;:true,&q;supportLivePk&q;:true},{&q;id&q;:10850126,&q;kePrefix&q;:&q;sydw&q;,&q;courseId&q;:6,&q;status&q;:3,&q;playStatus&q;:3,&q;type&q;:33,&q;recordingType&q;:0,&q;mediaType&q;:0,&q;title&q;:&q;【公基法律】精选好题 沉浸刷题&q;,&q;innerTitle&q;:&q;&q;,&q;startTime&q;:1753761600000,&q;endTime&q;:1753768800000,&q;teacher&q;:{&q;id&q;:17032,&q;userId&q;:73005297,&q;name&q;:&q;李婕&q;,&q;brief&q;:&q;粉笔优质讲师&q;,&q;desc&q;:&q;粉笔常识公基优质教师\n7年以上一线授课经验，累计授课时长超1000+小时，授课人数超20000+，对常识公基板块理解透彻，曾多次参与命制笔试教研，对民法、刑法等考情有着深入研究，出过近500道优质模拟题，在常识公基教研方面取得不小成果。擅长结合时事热点将晦涩难懂的知识具象化。教学方法也独具匠心深受同学好评，在课堂上经常采用思维导图+口诀记忆法，将繁杂的知识点串联成清晰的知识体系，面对易错易混点也能通过对比分析来加深理解，多年来深受广大学员的认可和五星好评，在学员中具有非常好的口碑，是一位值得信赖的好导师。&q;,&q;avatar&q;:&q;19bc4b46802c805.jpg&q;,&q;upperBodyPhoto&q;:null,&q;displayCoursePrefix&q;:&q;sydw&q;,&q;teacherStat&q;:{&q;teacherId&q;:17032,&q;episodeCount&q;:999,&q;scoreCount&q;:2265,&q;avgScore&q;:9.766887417218552,&q;fiveGradeAvgScore&q;:4.88,&q;updateTime&q;:1773397773324},&q;auditionEpisode&q;:{&q;episodeTitle&q;:&q;个人展示课&q;,&q;episodeVideoUrl&q;:&q;https://vod.fbstatic.cn/22e9ceb2vodbj1251001446/2eda4b7c5145403709227505228/MwwhZdSfiwYA.mp4?t=f2a4b300&a;us=4070880000&a;sign=6b3a5523cd064638f6e21c89c8efeea0&q;},&q;memberOfCPC&q;:false,&q;tags&q;:null},&q;teachChannel&q;:1,&q;offline&q;:null,&q;duration&q;:8545,&q;hasAudition&q;:false,&q;bizType&q;:0,&q;bizId&q;:&q;726825&q;,&q;supportReplay&q;:true,&q;extraInfo&q;:null,&q;liveConfig&q;:{&q;episodeId&q;:10850126,&q;supportMultiGroup&q;:false,&q;exerciseBizType&q;:0,&q;videoDisplayType&q;:0,&q;avForwardType&q;:0,&q;useIntelligentRoom&q;:false,&q;hasStrokeKeynote&q;:true,&q;verticalModeType&q;:0,&q;originEpisodeId&q;:0,&q;supportRtmp&q;:false,&q;supportPk&q;:true,&q;supportLuckyBag&q;:true,&q;supportUserNoteStroke&q;:false,&q;communicateType&q;:0,&q;one2One&q;:false,&q;fakeLive&q;:false},&q;validStatus&q;:1,&q;supportLive&q;:true,&q;supportAiCatalog&q;:false,&q;hasIntelligentPen&q;:false,&q;useLocalRecording&q;:false,&q;useIntelligentRoom&q;:false,&q;hasSalePosition&q;:false,&q;hasEpisodeCards&q;:true,&q;lockedForShouna&q;:false,&q;needSignIn&q;:false,&q;needTeacherSignIn&q;:false,&q;enablePadPencil&q;:true,&q;displayExercise&q;:false,&q;supportLuckyBag&q;:true,&q;supportLivePk&q;:true},{&q;id&q;:10850128,&q;kePrefix&q;:&q;sydw&q;,&q;courseId&q;:6,&q;status&q;:3,&q;playStatus&q;:3,&q;type&q;:33,&q;recordingType&q;:0,&q;mediaType&q;:0,&q;title&q;:&q;【数资】精选好题 沉浸刷题&q;,&q;innerTitle&q;:&q;&q;,&q;startTime&q;:1753768800000,&q;endTime&q;:1753776000000,&q;teacher&q;:{&q;id&q;:16588,&q;userId&q;:73651929,&q;name&q;:&q;王雅平&q;,&q;brief&q;:&q;粉笔优质讲师&q;,&q;desc&q;:&q;粉笔优质讲师\n6年一线教学经验，授课时长3000+小时，所带学员综合通过率达68%，具有数资科目丰富的实践经验及系统扎实的专业理论知识，对考情深入研究，授课经验丰富：①撰写多篇教研材料，在粉笔教师内部进行共享；②多次参加粉笔授课研讨会议，全面把握数资命题趋势及最新考情，积累丰富知识；③多次参加粉笔教研活动，分享授课经验心得。&q;,&q;avatar&q;:&q;17467ff056cb0e3.jpg&q;,&q;upperBodyPhoto&q;:null,&q;displayCoursePrefix&q;:&q;sydw&q;,&q;teacherStat&q;:{&q;teacherId&q;:16588,&q;episodeCount&q;:645,&q;scoreCount&q;:1598,&q;avgScore&q;:9.801001251564475,&q;fiveGradeAvgScore&q;:4.9,&q;updateTime&q;:1773543164175},&q;auditionEpisode&q;:{&q;episodeTitle&q;:&q;个人展示课&q;,&q;episodeVideoUrl&q;:&q;https://vod.fbstatic.cn/22e9ceb2vodbj1251001446/3d7922af5145403708051711222/4CdLbW9JRzEA.mp4?t=f2a4b300&a;us=4070880000&a;sign=db9e82e392a8449558ccd8e4eedf3845&q;},&q;memberOfCPC&q;:false,&q;tags&q;:null},&q;teachChannel&q;:1,&q;offline&q;:null,&q;duration&q;:9912,&q;hasAudition&q;:false,&q;bizType&q;:0,&q;bizId&q;:&q;726825&q;,&q;supportReplay&q;:true,&q;extraInfo&q;:null,&q;liveConfig&q;:{&q;episodeId&q;:10850128,&q;supportMultiGroup&q;:false,&q;exerciseBizType&q;:0,&q;videoDisplayType&q;:0,&q;avForwardType&q;:0,&q;useIntelligentRoom&q;:false,&q;hasStrokeKeynote&q;:true,&q;verticalModeType&q;:0,&q;originEpisodeId&q;:0,&q;supportRtmp&q;:false,&q;supportPk&q;:true,&q;supportLuckyBag&q;:true,&q;supportUserNoteStroke&q;:false,&q;communicateType&q;:0,&q;one2One&q;:false,&q;fakeLive&q;:false},&q;validStatus&q;:1,&q;supportLive&q;:true,&q;supportAiCatalog&q;:false,&q;hasIntelligentPen&q;:false,&q;useLocalRecording&q;:false,&q;useIntelligentRoom&q;:false,&q;hasSalePosition&q;:false,&q;hasEpisodeCards&q;:true,&q;lockedForShouna&q;:false,&q;needSignIn&q;:false,&q;needTeacherSignIn&q;:false,&q;enablePadPencil&q;:true,&q;displayExercise&q;:false,&q;supportLuckyBag&q;:true,&q;supportLivePk&q;:true},{&q;id&q;:10850129,&q;kePrefix&q;:&q;sydw&q;,&q;courseId&q;:6,&q;status&q;:3,&q;playStatus&q;:3,&q;type&q;:33,&q;recordingType&q;:0,&q;mediaType&q;:0,&q;title&q;:&q;【公基非法】精选好题 沉浸刷题&q;,&q;innerTitle&q;:&q;&q;,&q;startTime&q;:1753776000000,&q;endTime&q;:1753783200000,&q;teacher&q;:{&q;id&q;:34183,&q;userId&q;:83886596,&q;name&q;:&q;赵佳佳&q;,&q;brief&q;:&q;粉笔优质讲师&q;,&q;desc&q;:&q;粉笔常识公基优质讲师\n6年一线教学经验，深耕事业单位考试，承担过笔试精品班、刷题班等多种班型，授课和实战经验丰富。\n\n曾参与真题教研解析工作，教研文章撰写工作，模拟题的教研工作，对最新命题趋势方向有深入研究;\n多次参加粉笔授课研讨会议，注重考场思维，针对学生困惑研究教学策略，深入研讨事考命题趋势及最新考情，注重自我提升，积累丰富笔试理论知识;\n累计授课超1400小时，累计评分达4.9分，善于把握学员个性化特点，因材施教，认真负责，真诚对待每一位学员。讲课生动形象，有代入感，学员可以在轻松愉快的氛围中学习，跟着老师节奏主动思考，学习知识，掌握知识。&q;,&q;avatar&q;:&q;1983ba750d61d0b.jpg&q;,&q;upperBodyPhoto&q;:null,&q;displayCoursePrefix&q;:&q;sydw&q;,&q;teacherStat&q;:{&q;teacherId&q;:34183,&q;episodeCount&q;:689,&q;scoreCount&q;:1641,&q;avgScore&q;:9.802559414990869,&q;fiveGradeAvgScore&q;:4.9,&q;updateTime&q;:1771456495223},&q;auditionEpisode&q;:null,&q;memberOfCPC&q;:false,&q;tags&q;:null},&q;teachChannel&q;:1,&q;offline&q;:null,&q;duration&q;:8966,&q;hasAudition&q;:false,&q;bizType&q;:0,&q;bizId&q;:&q;726825&q;,&q;supportReplay&q;:true,&q;extraInfo&q;:null,&q;liveConfig&q;:{&q;episodeId&q;:10850129,&q;supportMultiGroup&q;:false,&q;exerciseBizType&q;:0,&q;videoDisplayType&q;:0,&q;avForwardType&q;:0,&q;useIntelligentRoom&q;:false,&q;hasStrokeKeynote&q;:true,&q;verticalModeType&q;:0,&q;originEpisodeId&q;:0,&q;supportRtmp&q;:false,&q;supportPk&q;:true,&q;supportLuckyBag&q;:true,&q;supportUserNoteStroke&q;:false,&q;communicateType&q;:0,&q;one2One&q;:false,&q;fakeLive&q;:false},&q;validStatus&q;:1,&q;supportLive&q;:true,&q;supportAiCatalog&q;:false,&q;hasIntelligentPen&q;:false,&q;useLocalRecording&q;:false,&q;useIntelligentRoom&q;:false,&q;hasSalePosition&q;:false,&q;hasEpisodeCards&q;:true,&q;lockedForShouna&q;:false,&q;needSignIn&q;:false,&q;needTeacherSignIn&q;:false,&q;enablePadPencil&q;:true,&q;displayExercise&q;:false,&q;supportLuckyBag&q;:true,&q;supportLivePk&q;:true},{&q;id&q;:10850131,&q;kePrefix&q;:&q;sydw&q;,&q;courseId&q;:6,&q;status&q;:3,&q;playStatus&q;:3,&q;type&q;:33,&q;recordingType&q;:0,&q;mediaType&q;:0,&q;title&q;:&q;【综应】精选好题 沉浸刷题&q;,&q;innerTitle&q;:&q;&q;,&q;startTime&q;:1753840800000,&q;endTime&q;:1753848000000,&q;teacher&q;:{&q;id&q;:38553,&q;userId&q;:68550168,&q;name&q;:&q;崔伟婷&q;,&q;brief&q;:&q;粉笔优质讲师&q;,&q;desc&q;:&q;粉笔优质教师\n多年深耕事业单位笔试，线上线下双轨授课，累计课时1500+，教学经验丰富。 精通综应、申论核心考点，兼具系统专业理论与实战教研经历，多次参与事业单位模拟题编写及解析打磨，对考情变化、命题规律理解深刻。 授课耐心细致、逻辑清晰，擅长结合实际场景拆解知识点，手把手引导学员将理论转化为答题能力，助力高效提分。&q;,&q;avatar&q;:&q;1983b8cd0938fc3.jpg&q;,&q;upperBodyPhoto&q;:null,&q;displayCoursePrefix&q;:&q;sydw&q;,&q;teacherStat&q;:{&q;teacherId&q;:38553,&q;episodeCount&q;:400,&q;scoreCount&q;:1897,&q;avgScore&q;:9.697416974169741,&q;fiveGradeAvgScore&q;:4.85,&q;updateTime&q;:1773125884452},&q;auditionEpisode&q;:{&q;episodeTitle&q;:&q;个人展示课&q;,&q;episodeVideoUrl&q;:&q;https://vod.fbstatic.cn/22e9ceb2vodbj1251001446/30f743a05145403707591723084/YyjElD5VJdgA.mp4?t=f2a4b300&a;us=4070880000&a;sign=af88950ebae760