isodeId&q;:11508359,&q;supportMultiGroup&q;:false,&q;exerciseBizType&q;:0,&q;videoDisplayType&q;:0,&q;avForwardType&q;:0,&q;useIntelligentRoom&q;:false,&q;hasStrokeKeynote&q;:true,&q;verticalModeType&q;:0,&q;originEpisodeId&q;:0,&q;supportRtmp&q;:false,&q;supportPk&q;:false,&q;supportLuckyBag&q;:false,&q;supportUserNoteStroke&q;:false,&q;communicateType&q;:0,&q;one2One&q;:false,&q;fakeLive&q;:false},&q;validStatus&q;:1,&q;supportLive&q;:true,&q;supportAiCatalog&q;:true,&q;hasIntelligentPen&q;:false,&q;useLocalRecording&q;:false,&q;useIntelligentRoom&q;:false,&q;hasSalePosition&q;:false,&q;hasEpisodeCards&q;:false,&q;lockedForShouna&q;:false,&q;needSignIn&q;:false,&q;needTeacherSignIn&q;:false,&q;enablePadPencil&q;:true,&q;displayExercise&q;:false,&q;supportLuckyBag&q;:false,&q;supportLivePk&q;:false},{&q;id&q;:11508360,&q;kePrefix&q;:&q;gwy&q;,&q;courseId&q;:1,&q;status&q;:3,&q;playStatus&q;:3,&q;type&q;:1,&q;recordingType&q;:0,&q;mediaType&q;:0,&q;title&q;:&q;判断赛后复盘-26上半年省考第9季通用卷&q;,&q;innerTitle&q;:&q;&q;,&q;startTime&q;:1769917200000,&q;endTime&q;:1769920800000,&q;teacher&q;:{&q;id&q;:1958,&q;userId&q;:16094527,&q;name&q;:&q;程永乐&q;,&q;brief&q;:&q;粉笔判断优质教师&q;,&q;desc&q;:&q;粉笔判断优质教师，985高校工科硕士。\n10年公考授课经验，打分人次超60万，学员评分高达4.9分，学员口中的“永乐大帝”。\n深谙判断推理出题特点，理论功底扎实，授课思路清晰，耐心细致，风趣幽默。善于从出题思路入手快速破题，深入浅出，注重归纳总结，举一反三。&q;,&q;avatar&q;:&q;196ec50ad55a6e0.jpg&q;,&q;upperBodyPhoto&q;:null,&q;displayCoursePrefix&q;:&q;gwy&q;,&q;teacherStat&q;:{&q;teacherId&q;:1958,&q;episodeCount&q;:1573,&q;scoreCount&q;:820068,&q;avgScore&q;:9.86799387367887,&q;fiveGradeAvgScore&q;:4.93,&q;updateTime&q;:1773623069509},&q;auditionEpisode&q;:{&q;episodeTitle&q;:&q;个人展示课&q;,&q;episodeVideoUrl&q;:&q;https://vod.fbstatic.cn/22e9ceb2vodbj1251001446/ea647b293560136621448493397/AgNBj9JryZ0A.mp4?t=f2a4b300&a;us=4070880000&a;sign=f2afee40504dffe0d47170f69b331867&q;},&q;memberOfCPC&q;:false,&q;tags&q;:null},&q;teachChannel&q;:1,&q;offline&q;:null,&q;duration&q;:7704,&q;hasAudition&q;:false,&q;bizType&q;:0,&q;bizId&q;:&q;710082&q;,&q;supportReplay&q;:true,&q;extraInfo&q;:null,&q;liveConfig&q;:{&q;episodeId&q;:11508360,&q;supportMultiGroup&q;:false,&q;exerciseBizType&q;:0,&q;videoDisplayType&q;:0,&q;avForwardType&q;:0,&q;useIntelligentRoom&q;:false,&q;hasStrokeKeynote&q;:true,&q;verticalModeType&q;:0,&q;originEpisodeId&q;:0,&q;supportRtmp&q;:false,&q;supportPk&q;:false,&q;supportLuckyBag&q;:false,&q;supportUserNoteStroke&q;:false,&q;communicateType&q;:0,&q;one2One&q;:false,&q;fakeLive&q;:false},&q;validStatus&q;:1,&q;supportLive&q;:true,&q;supportAiCatalog&q;:true,&q;hasIntelligentPen&q;:false,&q;useLocalRecording&q;:false,&q;useIntelligentRoom&q;:false,&q;hasSalePosition&q;:false,&q;hasEpisodeCards&q;:false,&q;lockedForShouna&q;:false,&q;needSignIn&q;:false,&q;needTeacherSignIn&q;:false,&q;enablePadPencil&q;:true,&q;displayExercise&q;:false,&q;supportLuckyBag&q;:false,&q;supportLivePk&q;:false},{&q;id&q;:11587398,&q;kePrefix&q;:&q;gwy&q;,&q;courseId&q;:1,&q;status&q;:3,&q;playStatus&q;:3,&q;type&q;:1,&q;recordingType&q;:0,&q;mediaType&q;:0,&q;title&q;:&q;言语赛后复盘-26上半年省考第10季通用卷&q;,&q;innerTitle&q;:&q;&q;,&q;startTime&q;:1770522000000,&q;endTime&q;:1770525600000,&q;teacher&q;:{&q;id&q;:5418,&q;userId&q;:57004843,&q;name&q;:&q;王得权&q;,&q;brief&q;:&q;粉笔言语优质教师&q;,&q;desc&q;:&q;粉笔言语优质教师，9年授课经验，累计授课学员超10万人。课程讲解深入浅出，易于理解。方法和技巧并重，能够让学员学会举一反三，提高备考效率。善于归纳总结，能及时帮助学员梳理知识点和易错点，让大家在备考过程中少走许多弯路。 \n参与组织各类教研工作，曾参与《行测的思维》《笔试系统讲义》《行测5000题》等多个套图书的编写工作，同时参与了多套模拟题的命制和审核工作。&q;,&q;avatar&q;:&q;171ee8c61a66542.jpg&q;,&q;upperBodyPhoto&q;:null,&q;displayCoursePrefix&q;:&q;gwy&q;,&q;teacherStat&q;:{&q;teacherId&q;:5418,&q;episodeCount&q;:1247,&q;scoreCount&q;:277061,&q;avgScore&q;:9.83515543508472,&q;fiveGradeAvgScore&q;:4.92,&q;updateTime&q;:1773623450694},&q;auditionEpisode&q;:{&q;episodeTitle&q;:&q;个人展示课&q;,&q;episodeVideoUrl&q;:&q;https://vod.fbstatic.cn/22e9ceb2vodbj1251001446/0f225a083560136621445998641/a18MDSiKuD8A.mp4?t=f2a4b300&a;us=4070880000&a;sign=37d51c78dbb190aa30426da491044bdf&q;},&q;mem