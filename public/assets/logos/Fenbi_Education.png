默，课堂互动性强，善于从学员角度出发解决个性化问题，激发学员学习热情和自主意识，注重理论与实践相结合。&q;,&q;avatar&q;:&q;1746bbe5d160d43.jpg&q;,&q;upperBodyPhoto&q;:null,&q;displayCoursePrefix&q;:&q;sydw&q;,&q;teacherStat&q;:{&q;teacherId&q;:16686,&q;episodeCount&q;:447,&q;scoreCount&q;:2045,&q;avgScore&q;:9.762347188264059,&q;fiveGradeAvgScore&q;:4.88,&q;updateTime&q;:1773546406556},&q;auditionEpisode&q;:{&q;episodeTitle&q;:&q;个人展示课&q;,&q;episodeVideoUrl&q;:&q;https://vod.fbstatic.cn/22e9ceb2vodbj1251001446/077558931397757911915926552/PpFe6z48T8UA.mp4?t=f2a4b300&a;us=4070880000&a;sign=6bc5b6dbf5223797c9f2083c2bb5bf66&q;},&q;memberOfCPC&q;:false,&q;tags&q;:null},&q;teachChannel&q;:1,&q;offline&q;:null,&q;duration&q;:7279,&q;hasAudition&q;:false,&q;bizType&q;:0,&q;bizId&q;:&q;726825&q;,&q;supportReplay&q;:true,&q;extraInfo&q;:null,&q;liveConfig&q;:{&q;episodeId&q;:10849667,&q;supportMultiGroup&q;:false,&q;exerciseBizType&q;:0,&q;videoDisplayType&q;:0,&q;avForwardType&q;:0,&q;useIntelligentRoom&q;:false,&q;hasStrokeKeynote&q;:true,&q;verticalModeType&q;:0,&q;originEpisodeId&q;:0,&q;supportRtmp&q;:false,&q;supportPk&q;:true,&q;supportLuckyBag&q;:true,&q;supportUserNoteStroke&q;:false,&q;communicateType&q;:0,&q;one2One&q;:false,&q;fakeLive&q;:false},&q;validStatus&q;:1,&q;supportLive&q;:true,&q;supportAiCatalog&q;:false,&q;hasIntelligentPen&q;:false,&q;useLocalRecording&q;:false,&q;useIntelligentRoom&q;:false,&q;hasSalePosition&q;:false,&q;hasEpisodeCards&q;:true,&q;lockedForShouna&q;:false,&q;needSignIn&q;:false,&q;needTeacherSignIn&q;:false,&q;enablePadPencil&q;:true,&q;displayExercise&q;:false,&q;supportLuckyBag&q;:true,&q;supportLivePk&q;:true},{&q;id&q;:10849670,&q;kePrefix&q;:&q;sydw&q;,&q;courseId&q;:6,&q;status&q;:3,&q;playStatus&q;:3,&q;type&q;:33,&q;recordingType&q;:0,&q;mediaType&q;:0,&q;title&q;:&q;【公基非法】精选好题 沉浸刷题&q;,&q;innerTitle&q;:&q;&q;,&q;startTime&q;:1752645600000,&q;endTime&q;:1752652800000,&q;teacher&q;:{&q;id&q;:32758,&q;userId&q;:73286911,&q;name&q;:&q;陆梦媛&q;,&q;brief&q;:&q;粉笔优质讲师&q;,&q;desc&q;:&q;粉笔优质讲师。\n5年教学经验。具有常识公基非法和综应科目系统扎实的专业理论知识，熟悉各地考情和命题特点。\n授课思路清晰，重点突出，善于用简洁明了的语言讲授知识点，上课氛围轻松愉快。累计授课时常超过2000小时，所带学员超过7000人。\n学生口碑：具有亲切幽默的授课风格，让学生在轻松的学习氛围中用更简单的方法获得知识。有耐心，对于学生的问题能够循循善诱，深受广大学员认可和好评。&q;,&q;avatar&q;:&q;1785909ecba60f3.jpg&q;,&q;upperBodyPhoto&q;:null,&q;displayCoursePrefix&q;:&q;sydw&q;,&q;teacherStat&q;:{&q;teacherId&q;:32758,&q;episodeCount&q;:631,&q;scoreCount&q;:1268,&q;avgScore&q;:9.686119873817033,&q;fiveGradeAvgScore&q;:4.84,&q;updateTime&q;:1773286316489},&q;auditionEpisode&q;:{&q;episodeTitle&q;:&q;个人展示课&q;,&q;episodeVideoUrl&q;:&q;https://vod.fbstatic.cn/22e9ceb2vodbj1251001446/7b763e815145403709537683006/3CUFIQRQUPwA.mp4?t=f2a4b300&a;us=4070880000&a;sign=314d5a744ab57c15cab13ba6ac8488bb&q;},&q;memberOfCPC&q;:false,&q;tags&q;:null},&q;teachChannel&q;:1,&q;offline&q;:null,&q;duration&q;:8657,&q;hasAudition&q;:false,&q;bizType&q;:0,&q;bizId&q;:&q;726825&q;,&q;supportReplay&q;:true,&q;extraInfo&q;:null,&q;liveConfig&q;:{&q;episodeId&q;:10849670,&q;supportMultiGroup&q;:false,&q;exerciseBizType&q;:0,&q;videoDisplayType&q;:0,&q;avForwardType&q;:0,&q;useIntelligentRoom&q;:false,&q;hasStrokeKeynote&q;:true,&q;verticalModeType&q;:0,&q;originEpisodeId&q;:0,&q;supportRtmp&q;:false,&q;supportPk&q;:true,&q;supportLuckyBag&q;:true,&q;supportUserNoteStroke&q;:false,&q;communicateType&q;:0,&q;one2One&q;:false,&q;fakeLive&q;:false},&q;validStatus&q;:1,&q;supportLive&q;:true,&q;supportAiCatalog&q;:false,&q;hasIntelligentPen&q;:false,&q;useLocalRecording&q;:false,&q;useIntelligentRoom&q;:false,&q;hasSalePosition&q;:false,&q;hasEpisodeCards&q;:true,&q;lockedForShouna&q;:false,&q;needSignIn&q;:false,&q;needTeacherSignIn&q;:false,&q;enablePadPencil&q;:true,&q;displayExercise&q;:false,&q;supportLuckyBag&q;:true,&q;supportLivePk&q;:true},{&q;id&q;:10849671,&q;kePrefix&q;:&q;sydw&q;,&q;courseId&q;:6,&q;status&q;:3,&q;playStatus&q;:3,&q;type&q;:33,&q;recordingType&q;:0,&q;mediaType&q;:0,&q;title&q;:&q;【公基法律】精选好题 沉浸刷题&q;,&q;innerTitle&q;:&q;&q;,&q;startTime&q;:1752652800000,&q;endTime&q;:1752660000000,&q;teacher&q;:{&q;id&q;:26000,&q;userId&q;:79045931,&q;name&q;:&q;曾国芳&q;,&q;brief&q;:&q;粉笔优质讲师&q;,&q;desc&q;:&q;粉笔常识公基优质教师。\n5年一线教学授课经验。多次参与粉笔授课研讨会议，具有法律科目丰富的实践经验及系统扎实的专业理论知识，曾参与命制笔试教研和真题解析撰写工作，熟悉常识公基笔试考情。\n累计授课时长1000+，综合评分4.9，授课思路清晰明了，条理分明，能够准确地把握课程的重点，讲解风格流畅自然，语言通俗易懂，注重及时对所学内容进行总结、梳理与回顾，帮助学员巩固所学知识，构建知识框架。&q;,&q;avatar&q;:&q;1983b115f298514.jpg&q;,&q;upperBodyPhoto&q;:null,&q;displayCoursePrefix&q;:&q;sydw&q;,&q;teacherStat&q;:{&q;teacherId&q;:26000,&q;episodeCount&q;:550,&q;scoreCount&q;:786,&q;avgScore&q;:9.715012722646309,&q;fiveGradeAvgScore&q;:4.86,&q;updateTime&q;:1773579521495},&q;auditionEpisode&q;:{&q;episodeTitle&q;:&q;个人展示课&q;,&q;episodeVideoUrl&q;:&q;https://vod.fbstatic.cn/22e9ceb2vodbj1251001446/62b81e155145403710098214091/A9nD0SODvSgA.mp4?t=f2a4b300&a;us=4070880000&a;sign=c9496142d0c559efda8f86b4d90a68a7&q;},&q;memberOfCPC&q;:false,&q;tags&q;:null},&q;teachChannel&q;:1,&q;offline&q;:null,&q;duration&q;:7606,&q;hasAudition&q;:false,&q;bizType&q;:0,&q;bizId&q;:&q;726825&q;,&q;supportReplay&q;:true,&q;extraInfo&q;:null,&q;liveConfig&q;:{&q;episodeId&q;:10849671,&q;supportMultiGroup&q;:false,&q;exerciseBizType&q;:0,&q;videoDisplayType&q;:0,&q;avForwardType&q;:0,&q;useIntelligentRoom&q;:false,&q;hasStrokeKeynote&q;:true,&q;verticalModeType&q;:0,&q;originEpisodeId&q;:0,&q;supportRtmp&q;:false,&q;supportPk&q;:true,&q;supportLuckyBag&q;:true,&q;supportUserNoteStroke&q;:false,&q;communicateType&q;:0,&q;one2One&q;:false,&q;fakeLive&q;:false},&q;validStatus&q;:1,&q;supportLive&q;:true,&q;supportAiCatalog&q;:false,&q;hasIntelligentPen&q;:false,&q;useLocalRecording&q;:false,&q;useIntelligentRoom&q;:false,&q;hasSalePosition&q;:false,&q;hasEpisodeCards&q;:true,&q;lockedForShouna&q;:false,&q;needSignIn&q;:false,&q;needTeacherSignIn&q;:false,&q;enablePadPencil&q;:true,&q;displayExercise&q;:false,&q;supportLuckyBag&q;:true,&q;supportLivePk&q;:true},{&q;id&q;:10849674,&q;kePrefix&q;:&q;sydw&q;,&q;courseId&q;:6,&q;status&q;:3,&q;playStatus&q;:3,&q;type&q;:33,&q;recordingType&q;:0,&q;mediaType&q;:0,&q;title&q;:&q;【言语】精选好题 沉浸刷题&q;,&q;innerTitle&q;:&q;&q;,&q;startTime&q;:1752724800000,&q;endTime&q;:1752732000000,&q;teacher&q;:{&q;id&q;:52949,&q;userId&q;:80481411,&q;name&q;:&q;王臻瑶&q;,&q;brief&q;:&q;粉笔优质讲师&q;,&q;desc&q;:&q;粉笔优质讲师\n211高校毕业，6年一线教学、教研经验，线上线下授课人数千余人，累计授课时长3000+。\n对于言语理解与表达科目有丰富的实践经验及系统扎实的专业理论知识。\n亲和力强，注重与学员的互动和交流，对各省份考情熟悉，注重理论与实践相结合，引导学员发现问题，帮助学员高分上岸，深受学员喜爱。\n教学风格注重条理性和逻辑性，善于通过生动的例子，帮助学员深入理解题目背后的逻辑关系和解题技巧。&q;,&q;avatar&q;:&q;1945f3b6384d792.jpg&q;,&q;upperBodyPhoto&q;:null,&q;displayCoursePrefix&q;:&q;sydw&q;,&q;teacherStat&q;:{&q;teacherId&q;:52949,&q;episodeCount&q;:342,&q;scoreCount&q;:1475,&q;avgScore&q;:9.738305084745754,&q;fiveGradeAvgScore&q;:4.87,&q;updateTime&q;:1773588704179},&q;auditionEpisode&q;:{&q;episodeTitle&q;:&q;个人展示课&q;,&q;episodeVideoUrl&q;:&q;https://nodestatic.fbstatic.cn/video_qhd/1714474745775.mp4&q;},&q;memberOfCPC&q;:false,&q;tags&q;:null},&q;teachChannel&q;:1,&q;offline&q;:null,&q;duration&q;:8945,&q;hasAudition&q;:false,&q;bizType&q;:0,&q;bizId&q;:&q;726825&q;,&q;supportReplay&q;:true,&q;extraInfo&q;:null,&q;liveConfig&q;:{&q;episodeId&q;:10849674,&q;supportMultiGroup&q;:false,&q;exerciseBizType&q;:0,&q;videoDisplayType&q;:0,&q;avForwardType&q;:0,&q;useIntelligentRoom&q;:false,&q;hasStrokeKeynote&q;:true,&q;verticalModeType&q;:0,&q;originEpisodeId&q;:0,&q;supportRtmp&q;:false,&q;supportPk&q;:true,&q;supportLuckyBag&q;:true,&q;supportUserNoteStroke&q;:false,&q;communicateType&q;:0,&q;one2One&q;:false,&q;fakeLive&q;:false},&q;validStatus&q;:1,&q;supportLive&q;:true,&q;supportAiCatalog&q;:false,&q;hasIntelligentPen&q;:false,&q;useLocalRecording&q;:false,&q;useIntelligentRoom&q;:false,&q;hasSalePosition&q;:false,&q;hasEpisodeCards&q;:true,&q;lockedForShouna&q;:false,&q;needSignIn&q;:false,&q;needTeacherSignIn&q;:false,&q;enablePadPencil&q;:true,&q;displayExercise&q;:false,&q;supportLuckyBag&q;:true,&q;supportLivePk&q;:true},{&q;id&q;:10849811,&q;kePrefix&q;:&q;sydw&q;,&q;courseId&q;:6,&q;status&q;:3,&q;playStatus&q;:3,&q;type&q;:33,&q;recordingType&q;:0,&q;mediaType&q;:0,&q;title&q;:&q;【公基非法】精选好题 沉浸刷题&q;,&q;innerTitle&q;:&q;&q;,&q;startTime&q;:1752732000000,&q;endTime&q;:1752739200000,&q;teacher&q;:{&q;id&q;:32970,&q;userId&q;:83438578,&q;name&q;:&q;朱湘依&q;,&q;brief&q;:&q;粉笔优质讲师&q;,&q;desc&q;:&q;粉笔优质讲师\n毕业于双一流院校，6年一线教学经验，承担线上、线下多种班型课程，授课经验丰富。\n承担常识公基非法律部分与数资科目授课、教研与培训工作。撰写多篇笔试教研材料。\n上课风格条理清晰，逻辑性强，擅长理论与实际相结合，授课有方法与技巧，积极引导并激发学员学习热情和自主意识，深受学员喜爱与好评。&q;,&q;avatar&q;:&q;1965c4972230508.jpg&q;,&q;upperBodyPhoto&q;:null,&q;displayCoursePrefix&q;:&q;sydw&q;,&q;teacherStat&q;:{&q;teacherId&q;:32970,&q;episodeCount&q;:707,&q;scoreCount&q;:1045,&q;avgScore&q;:9.666985645933023,&q;fiveGradeAvgScore&q;:4.83,&q;updateTime&q;:1773622939242},&q;auditionEpisode&q;:{&q;episodeTitle&q;:&q;个人展示课&q;,&q;episodeVideoUrl&q;:&q;https://vod.fbstatic.cn/22e9ceb2vodbj1251001446/499072d75145403715606210097/s5aPkRTv9zwA.mp4?t=f2a4b300&a;us=4070880000&a;sign=e5a5a9ce7c1f73488eb51fc79567a0aa&q;},&q;memberOfCPC&q;:false,&q;tags&q;:null},&q;teachChannel&q;:1,&q;offline&q;:null,&q;duration&q;:7333,&q;hasAudition&q;:false,&q;bizType&q;:0,&q;bizId&q;:&q;726825&q;,&q;supportReplay&q;:true,&q;extraInfo&q;:null,&q;liveConfig&q;:{&q;episodeId&q;:10849811,&q;supportMultiGroup&q;:false,&q;exerciseBizType&q;:0,&q;videoDisplayType&q;:0,&q;avForwardType&q;:0,&q;useIntelligentRoom&q;:false,&q;hasStrokeKeynote&q;:true,&q;verticalModeType&q;:0,&q;originEpisodeId&q;:0,&q;supportRtmp&q;:false,&q;supportPk&q;:true,&q;supportLuckyBag&q;:true,&q;supportUserNoteStroke&q;:false,&q;communicateType&q;:0,&q;one2One&q;:false,&q;fakeLive&q;:false},&q;validStatus&q;:1,&q;supportLive&q;:true,&q;supportAiCatalog&q;:false,&q;hasIntelligentPen&q;:false,&q;useLocalRecording&q;:false,&q;useIntelligentRoom&q;:false,&q;hasSalePosition&q;:false,&q;hasEpisodeCards&q;:true,&q;lockedForShouna&q;:false,&q;needSignIn&q;:false,&q;needTeacherSignIn&q;:false,&q;enablePadPencil&q;:true,&q;displayExercise&q;:false,&q;supportLuckyBag&q;:true,&q;supportLivePk&q;:true},{&q;id&q;:10849815,&q;kePrefix&q;:&q;sydw&q;,&q;courseId&q;:6,&q;status&q;:3,&q;playStatus&q;:3,&q;type&q;:33,&q;recordingType&q;:0,&q;mediaType&q;:0,&q;title&q;:&q;【数资】精选好题 沉浸刷题&q;,&q;innerTitle&q;:&q;&q;,&q;startTime&q;:1752739200000,&q;endTime&q;:1752746400000,&q;teacher&q;:{&q;id&q;:34199,&q;userId&q;:73996160,&q;name&q;:&q;卫斗妮&q;,&q;brief&q;:&q;粉笔优质讲师&q;,&q;desc&q;:&q;粉笔优质讲师\n5年一线教学授课经验\n具有数量关系和资料分析科目丰富的实践经验及系统扎实的专业理论知识\n多次参加粉笔授课研讨会议，全面把握公考面试命题趋势及最新考情，积累丰富面试知识；\n多次参加粉笔教研活动，分享授课经验心得，助力粉笔理论研发升级；\n累计获得广泛好评，具有启发式的授课风格，让学生在轻松的学习氛围中，用更简单的方法，找到更快捷的解题之道，深受广大学员的认可和好评；在学员中具有非常好的口碑，是值得信赖的好导师。&q;,&q;avatar&q;:&q;198594b4cf62f8a.jpg&q;,&q;upperBodyPhoto&q;:null,&q;displayCoursePrefix&q;:&q;sydw&q;,&q;teacherStat&q;:{&q;teacherId&q;:34199,&q;episodeCount&q;:556,&q;scoreCount&q;:1224,&q;avgScore&q;:9.869281045751636,&q;fiveGradeAvgScore&q;:4.93,&q;updateTime&q;:1773544378749},&q;auditionEpisode&q;:null,&q;memberOfCPC&q;:false,&q;tags&q;:null},&q;teachChannel&q;:1,&q;offline&q;:null,&q;duration&q;:9327,&q;hasAudition&q;:false,&q;bizType&q;:0,&q;bizId&q;:&q;726825&q;,&q;supportReplay&q;:true,&q;extraInfo&q;:null,&q;liveConfig&q;:{&q;episodeId&q;:10849815,&q;supportMultiGroup&q;:false,&q;exerciseBizType&q;:0,&q;videoDisplayType&q;:0,&q;avForwardType&q;:0,&q;useIntelligentRoom&q;:false,&q;hasStrokeKeynote&q;:true,&q;verticalModeType&q;:0,&q;originEpisodeId&q;:0,&q;supportRtmp&q;:false,&q;supportPk&q;:true,&q;supportLuckyBag&q;:true,&q;supportUserNoteStroke&q;:false,&q;communicateType&q;:0,&q;one2One&q;:false,&q;fakeLive&q;:false},&q;validStatus&q;:1,&q;supportLive&q;:true,&q;supportAiCatalog&q;:false,&q;hasIntelligentPen&q;:false,&q;useLocalRecording&q;:false,&q;useIntelligentRoom&q;:false,&q;hasSalePosition&q;:false,&q;hasEpisodeCards&q;:true,&q;lockedForShouna&q;:false,&q;needSignIn&q;:false,&q;needTeacherSignIn&q;:false,&q;enablePadPencil&q;:true,&q;displayExercise&q;:false,&q;supportLuckyBag&q;:true,&q;supportLivePk&q;:true},{&q;id&q;:10849820,&q;kePrefix&q;:&q;sydw&q;,&q;courseId&q;:6,&q;status&q;:3,&q;playStatus&q;:3,&q;type&q;:33,&q;recordingType&q;:0,&q;mediaType&q;:0,&q;title&q;:&q;【综应】精选好题 沉浸刷题&q;,&q;innerTitle&q;:&q;&q;,&q;startTime&q;:1752804000000,&q;endTime&q;:1752811200000,&q;teacher&q;:{&q;id&q;:35873,&q;userId&q;:83868400,&q;name&q;:&q;张雪峰&q;,&q;brief&q;:&q;粉笔优质讲师&q;,&q;desc&q;:&q;粉笔优质讲师\n6年一线教学经验，曾就职于省级科研院所。师资中心学科组长及其他项目负责人，累计服务学员数千人，注重学员考场实战思维的培养，辅导数名学员笔面第一成功上岸；\n承担各种线上线下授课任务，累计授课超过1000小时；\n长期参与粉笔内部教研工作，定期参与模拟题撰写、真题解析等，对于各类考试考情、考试重点有深入了解；\n授课风格上，风趣幽默、生动有趣、讲解细致、通俗易懂、富有亲和力；\n授课方式上，深入浅出、逻辑清晰、技巧性强、重点明确、化繁为简。深受学员喜爱与好评。&q;,&q;avatar&q;:&q;19854136e94d1f4.jpg&q;,&q;upperBodyPhoto&q;:null,&q;displayCoursePrefix&q;:&q;sydw&q;,&q;teacherStat&q;:{&q;teacherId&q;:35873,&q;episodeCount&q;:336,&q;scoreCount&q;:610,&q;avgScore&q;:9.537704918032789,&q;fiveGradeAvgScore&q;:4.77,&q;updateTime&q;:1773405613935},&q;auditionEpisode&q;:{&q;episodeTitle&q;:&q;个人展示课&q;,&q;episodeVideoUrl&q;:&q;https://vod.fbstatic.cn/22e9ceb2vodbj1251001446/35a538255145403709543712965/oxwk7Paiwr4A.mp4?t=f2a4b300&a;us=4070880000&a;sign=97faf61ced98c6e79a4e46aa81fb41e2&q;},&q;memberOfCPC&q;:false,&q;tags&q;:null},&q;teachChannel&q;:1,&q;offline&q;:null,&q;duration&q;:7308,&q;hasAudition&q;:false,&q;bizType&q;:0,&q;bizId&q;:&q;726825&q;,&q;supportReplay&q;:true,&q;extraInfo&q;:null,&q;liveConfig&q;:{&q;episodeId&q;:10849820,&q;supportMultiGroup&q;:false,&q;exerciseBizType&q;:0,&q;videoDisplayType&q;:0,&q;avForwardType&q;:0,&q;useIntelligentRoom&q;:false,&q;hasStrokeKeynote&q;:true,&q;verticalModeType&q;:0,&q;originEpisodeId&q;:0,&q;supportRtmp&q;:false,&q;supportPk&q;:true,&q;supportLuckyBag&q;:true,&q;supportUserNoteStroke&q;:false,&q;communicateType&q;:0,&q;one2One&q;:false,&q;fakeLive&q;:false},&q;validStatus&q;:1,&q;supportLive&q;:true,&q;supportAiCatalog&q;:false,&q;hasIntelligentPen&q;:false,&q;useLocalRecording&q;:false,&q;useIntelligentRoom&q;:false,&q;hasSalePosition&q;:false,&q;hasEpisodeCards&q;:true,&q;lockedForShouna&q;:false,&q;needSignIn&q;:false,&q;needTeacherSignIn&q;:false,&q;enablePadPencil&q;:true,&q;displayExercise&q;:false,&q;supportLuckyBag&q;:true,&q;supportLivePk&q;:true},{&q;id&q;:10849824,&q;kePrefix&q;:&q;sydw&q;,&q;courseId&q;:6,&q;status&q;:3,&q;playStatus&q;:3,&q;type&q;:33,&q;recordingType&q;:0,&q;mediaType&q;:0,&q;title&q;:&q;【言语】精选好题 沉浸刷题&q;,&q;innerTitle&q;:&q;&q;,&q;startTime&q;:1752811200000,&q;endTime&q;:1752818400000,&q;teacher&q;:{&q;id&q;:52905,&q;userId&q;:64869017,&q;name&q;:&q;迟琳&q;,&q;brief&q;:&q;粉笔优质讲师&q;,&q;desc&q;:&q;粉笔优质讲师\n5年一线教学深耕，主讲线上精品班、刷题班等多元班型，累计授课时长超3000小时，教学经验扎实丰富。\n深耕言语理解模块，凭借对考情的敏锐洞察，能精准捕捉考试趋势与命题方向。擅长将复杂知识点拆解为“可吸收”的清晰模块，结合生动案例与通俗表达，让抽象解题技巧变得直观易懂，帮助学生快速突破学习难点。\n教学中始终以学员为核心，不仅注重解题方法的传授，更着力培养学生的逻辑思维与自主学习能力。通过“举一反三”的引导式教学，助力学员实现知识的灵活迁移与运用，学员好评率稳居前列，深受信赖与喜爱。&q;,&q;avatar&q;:&q;17f3f0375916d72.jpg&q;,&q;upperBodyPhoto&q;:null,&q;displayCoursePrefix&q;:&q;sydw&q;,&q;teacherStat&q;:{&q;teacherId&q;:52905,&q;episodeCount&q;:351,&q;scoreCount&q;:1137,&q;avgScore&q;:9.829375549692163,&q;fiveGradeAvgScore&q;:4.91,&q;updateTime&q;:1773566236546},&q;auditionEpisode&q;:{&q;episodeTitle&q;:&q;个人展示课&q;,&q;episodeVideoUrl&q;:&q;https://vod.fbstatic.cn/22e9ceb2vodbj1251001446/ba3aba5f5145403709538052229/NBGfnV7d2IEA.mp4?t=f2a4b300&a;us=4070880000&a;sign=783070f866ba71370a8c3a086a82aa91&q;},&q;memberOfCPC&q;:false,&q;tags&q;:null},&q;teachChannel&q;:1,&q;offline&q;:null,&q;duration&q;:7628,&q;hasAudition&q;:false,&q;bizType&q;:0,&q;bizId&q;:&q;726825&q;,&q;supportReplay&q;:true,&q;extraInfo&q;:null,&q;liveConfig&q;:{&q;episodeId&q;:10849824,&q;supportMultiGroup&q;:false,&q;exerciseBizType&q;:0,&q;videoDisplayType&q;:0,&q;avForwardType&q;:0,&q;useIntelligentRoom&q;:false,&q;hasStrokeKeynote&q;:true,&q;verticalModeType&q;:0,&q;originEpisodeId&q;:0,&q;supportRtmp&q;:false,&q;supportPk&q;:true,&q;supportLuckyBag&q;:true,&q;supportUserNoteStroke&q;:false,&q;communicateType&q;:0,&q;one2One&q;:false,&q;fakeLive&q;:false},&q;validStatus&q;:1,&q;supportLive&q;:true,&q;supportAiCatalog&q;:false,&q;hasIntelligentPen&q;:false,&q;useLocalRecording&q;:false,&q;useIntelligentRoom&q;:false,&q;hasSalePosition&q;:false,&q;hasEpisodeCards&q;:true,&q;lockedForShouna&q;:false,&q;needSignIn&q;:false,&q;needTeacherSignIn&q;:false,&q;enablePadPencil&q;:true,&q;displayExercise&q;:false,&q;supportLuckyBag&q;:true,&q;supportLivePk&q;:true},{&q;id&q;:10849825,&q;kePrefix&q;:&q;sydw&q;,&q;courseId&q;:6,&q;status&q;:3,&q;playStatus&q;:3,&q;type&q;:33,&q;recordingType&q;:0,&q;mediaType&q;:0,&q;title&q;:&q;【公基非法】精选好题 沉浸刷题&q;,&q;innerTitle&q;:&q;&q;,&q;startTime&q;:1752818400000,&q;endTime&q;:1752825600000,&q;teacher&q;:{&q;id&q;:16905,&q;userId&q;:73838220,&q;name&q;:&q;袁鑫&q;,&q;brief&q;:&q;粉笔优质讲师&q;,&q;desc&q;:&q;6年一线教育经验，拥有丰富的线上授课经验，累计授课时长1000+。\n在常识公基非法与言语理解两个学科领域，承担包括但不限于授课、模拟题命制、单题录制等核心工作。\n多次参与粉笔授课研讨会议，精准捕捉考试命题的最新趋势；\n累计评分达4.9分，学员口碑较好，授课节奏张弛有度，授课风格条理分明，善于援引生活案例解读专业理论内容，能够充分调动学员积极性，备受学员喜爱与好评&q;,&q;avatar&q;:&q;194261e229cc8c5.jpg&q;,&q;upperBodyPhoto&q;:null,&q;displayCoursePrefix&q;:&q;sydw&q;,&q;teacherStat&q;:{&q;teacherId&q;:16905,&q;episodeCount&q;:781,&q;scoreCount&q;:1375,&q;avgScore&q;:9.796363636363642,&q;fiveGradeAvgScore&q;:4.9,&q;updateTime&q;:1773370334277},&q;auditionEpisode&q;:{&q;episodeTitle&q;:&q;个人展示课&q;,&q;episodeVideoUrl&q;:&q;https://vod.fbstatic.cn/22e9ceb2vodbj1251001446/680585e95145403708191968166/297Y8tgm67sA.mp4?t=f2a4b300&a;us=4070880000&a;sign=77be52f07081e2ea4e26d74248e8765e&q;},&q;memberOfCPC&q;:false,&q;tags&q;:null},&q;teachChannel&q;:1,&q;offline&q;:null,&q;duration&q;:8853,&q;hasAudition&q;:false,&q;bizType&q;:0,&q;bizId&q;:&q;726825&q;,&q;supportReplay&q;:true,&q;extraInfo&q;:null,&q;liveConfig&q;:{&q;episodeId&q;:10849825,&q;supportMultiGroup&q;:false,&q;exerciseBizType&q;:0,&q;videoDisplayType&q;:0,&q;avForwardType&q;:0,&q;useIntelligentRoom&q;:false,&q;hasStrokeKeynote&q;:true,&q;verticalModeType&q;:0,&q;originEpisodeId&q;:0,&q;supportRtmp&q;:false,&q;supportPk&q;:true,&q;support