,&q;teacherStat&q;:{&q;teacherId&q;:34155,&q;episodeCount&q;:400,&q;scoreCount&q;:523,&q;avgScore&q;:9.789674952198864,&q;fiveGradeAvgScore&q;:4.89,&q;updateTime&q;:1773022083070},&q;auditionEpisode&q;:{&q;episodeTitle&q;:&q;个人展示课&q;,&q;episodeVideoUrl&q;:&q;https://vod.fbstatic.cn/22e9ceb2vodbj1251001446/a24a99a55145403709334290849/y0iTp4HJ8GkA.mp4?t=f2a4b300&a;us=4070880000&a;sign=aa5d046c3225db7891d3c4c81f7b7542&q;},&q;memberOfCPC&q;:false,&q;tags&q;:null},&q;teachChannel&q;:1,&q;offline&q;:null,&q;duration&q;:7374,&q;hasAudition&q;:false,&q;bizType&q;:0,&q;bizId&q;:&q;726825&q;,&q;supportReplay&q;:true,&q;extraInfo&q;:null,&q;liveConfig&q;:{&q;episodeId&q;:11002543,&q;supportMultiGroup&q;:false,&q;exerciseBizType&q;:0,&q;videoDisplayType&q;:0,&q;avForwardType&q;:0,&q;useIntelligentRoom&q;:false,&q;hasStrokeKeynote&q;:true,&q;verticalModeType&q;:0,&q;originEpisodeId&q;:0,&q;supportRtmp&q;:false,&q;supportPk&q;:true,&q;supportLuckyBag&q;:true,&q;supportUserNoteStroke&q;:false,&q;communicateType&q;:0,&q;one2One&q;:false,&q;fakeLive&q;:false},&q;validStatus&q;:1,&q;supportLive&q;:true,&q;supportAiCatalog&q;:false,&q;hasIntelligentPen&q;:false,&q;useLocalRecording&q;:false,&q;useIntelligentRoom&q;:false,&q;hasSalePosition&q;:false,&q;hasEpisodeCards&q;:true,&q;lockedForShouna&q;:false,&q;needSignIn&q;:false,&q;needTeacherSignIn&q;:false,&q;enablePadPencil&q;:true,&q;displayExercise&q;:false,&q;supportLuckyBag&q;:true,&q;supportLivePk&q;:true},{&q;id&q;:11002544,&q;kePrefix&q;:&q;sydw&q;,&q;courseId&q;:6,&q;status&q;:3,&q;playStatus&q;:3,&q;type&q;:33,&q;recordingType&q;:0,&q;mediaType&q;:0,&q;title&q;:&q;【言语】精选好题 沉浸刷题&q;,&q;innerTitle&q;:&q;&q;,&q;startTime&q;:1758427200000,&q;endTime&q;:1758434400000,&q;teacher&q;:{&q;id&q;:17075,&q;userId&q;:44061788,&q;name&q;:&q;余寅波&q;,&q;brief&q;:&q;粉笔优质讲师&q;,&q;desc&q;:&q;粉笔优质教师\n拥有长达六年的一线教学授课经验，专注深耕于事业单位考试领域。曾承担过笔试精品班、刷题班等多种班型的教学任务。\n在言语科目方面，理论功底极为扎实，对各类言语考点均进行了细致入微的研究与梳理。授课过程中，逻辑清晰明了，态度耐心负责，课堂上十分注重将知识点与真题紧密结合，助力学员迅速掌握做题技巧。\n参与笔试教研以及解析撰写工作，对最新命题趋势有着精准把握，还多次踊跃参加授课研讨会议，秉持注重考场思维的理念，针对学生在学习过程中产生的困惑深入研究教学策略。\n累计授课时长超过 2000 小时，累计评分高达 4.9 分。教学中注重采用启发式引导方式，致力于让学生在轻松愉悦的学习氛围中，探寻到更为快捷的解题之道，深受广大学员的认可与好评。坚信 “没有比人更高的山”，始终愿助力每一位学员翻越自身面临的那座高山。&q;,&q;avatar&q;:&q;17470c205d4814c.jpg&q;,&q;upperBodyPhoto&q;:null,&q;displayCoursePrefix&q;:&q;sydw&q;,&q;teacherStat&q;:{&q;teacherId&q;:17075,&q;episodeCount&q;:379,&q;scoreCount&q;:1504,&q;avgScore&q;:9.699468085106375,&q;fiveGradeAvgScore&q;:4.85,&q;updateTime&q;:1773571929826},&q;auditionEpisode&q;:null,&q;memberOfCPC&q;:false,&q;tags&q;:null},&q;teachChannel&q;:1,&q;offline&q;:null,&q;duration&q;:7228,&q;hasAudition&q;:false,&q;bizType&q;:0,&q;bizId&q;:&q;726825&q;,&q;supportReplay&q;:true,&q;extraInfo&q;:null,&q;liveConfig&q;:{&q;episodeId&q;:11002544,&q;supportMultiGroup&q;:false,&q;exerciseBizType&q;:0,&q;videoDisplayType&q;:0,&q;avForwardType&q;:0,&q;useIntelligentRoom&q;:false,&q;hasStrokeKeynote&q;:true,&q;verticalModeType&q;:0,&q;originEpisodeId&q;:0,&q;supportRtmp&q;:false,&q;supportPk&q;:true,&q;supportLuckyBag&q;:true,&q;supportUserNoteStroke&q;:false,&q;communicateType&q;:0,&q;one2One&q;:false,&q;fakeLive&q;:false},&q;validStatus&q;:1,&q;supportLive&q;:true,&q;supportAiCatalog&q;:false,&q;hasIntelligentPen&q;:false,&q;useLocalRecording&q;:false,&q;useIntelligentRoom&q;:false,&q;hasSalePosition&q;:false,&q;hasEpisodeCards&q;:true,&q;lockedForShouna&q;:false,&q;needSignIn&q;:false,&q;needTeacherSignIn&q;:false,&q;enablePadPencil&q;:true,&q;displayExercise&q;:false,&q;supportLuckyBag&q;:true,&q;supportLivePk&q;:true},{&q;id&q;:11000983,&q;kePrefix&q;:&q;sydw&q;,&q;courseId&q;:6,&q;status&q;:3,&q;playStatus&q;:3,&q;type&q;:33,&q;recordingType&q;:0,&q;mediaType&q;:0,&q;title&q;:&q;【数资】精选好题 沉浸刷题&q;,&q;innerTitle&q;:&q;&q;,&q;startTime&q;:1758434400000,&q;endTime&q;:1758441600000,&q;teacher&q;:{&q;id&q;:26292,&q;userId&q;:79327575,&q;name&q;:&q;郑美娟&q;,&q;brief&q;:&q;粉笔优质讲师&q;,&q;desc&q;:&q;粉笔数量关系与资料分析科目优质教师\n5年一线教学授课经验。\n具有数资科目丰富的实践经验及系统扎实的专业理论知识。多次参与粉笔数资授课研讨，教学教研能力扎实。承担过线下笔试精品班、刷题班、冲刺班等多种班型，授课经验丰富，思路清晰，讲解全面细致。\n授课形式生动形象，能够有针对性的引导学生进行主动思考，课堂氛围轻松无压力。擅长化繁为简，适合各个阶段的学生，深受广大学员好评。&q;,&q;avatar&q;:&q;1777f9e082273e5.jpg&q;,&q;upperBodyPhoto&q;:null,&q;displayCoursePrefix&q;:&q;sydw&q;,&q;teacherStat&q;:{&q;teacherId&q;:26292,&q;episodeCount&q;:567,&q;scoreCount&q;:1594,&q;avgScore&q;:9.803011292346305,&q;fiveGradeAvgScore&q;:4.9,&q;updateTime&q;:1773586366104},&q;auditionEpisode&q;:{&q;episodeTitle&q;:&q;个人展示课&q;,&q;episodeVideoUrl&q;:&q;https://vod.fbstatic.cn/22e9ceb2vodbj1251001446/9f3a48475145403713947309566/MDmpFEIP6G8A.mp4?t=f2a4b300&a;us=4070880000&a;sign=39fd01bda5913d3e938e577986d9db4b&q;},&q;memberOfCPC&q;:false,&q;tags&q;:null},&q;teachChannel&q;:1,&q;offline&q;:null,&q;duration&q;:8532,&q;hasAudition&q;:false,&q;bizType&q;:0,&q;bizId&q;:&q;726825&q;,&q;supportReplay&q;:true,&q;extraInfo&q;:null,&q;liveConfig&q;:{&q;episodeId&q;:11000983,&q;supportMultiGroup&q;:false,&q;exerciseBizType&q;:0,&q;videoDisplayType&q;:0,&q;avForwardType&q;:0,&q;useIntelligentRoom&q;:false,&q;hasStrokeKeynote&q;:true,&q;verticalModeType&q;:0,&q;originEpisodeId&q;:0,&q;supportRtmp&q;:false,&q;supportPk&q;:true,&q;supportLuckyBag&q;:true,&q;supportUserNoteStroke&q;:false,&q;communicateType&q;:0,&q;one2One&q;:false,&q;fakeLive&q;:false},&q;validStatus&q;:1,&q;supportLive&q;:true,&q;supportAiCatalog&q;:false,&q;hasIntelligentPen&q;:false,&q;useLocalRecording&q;:false,&q;useIntelligentRoom&q;:false,&q;hasSalePosition&q;:false,&q;hasEpisodeCards&q;:true,&q;lockedForShouna&q;:false,&q;needSignIn&q;:false,&q;needTeacherSignIn&q;:false,&q;enablePadPencil&q;:true,&q;displayExercise&q;:false,&q;supportLuckyBag&q;:true,&q;supportLivePk&q;:true},{&q;id&q;:11002545,&q;kePrefix&q;:&q;sydw&q;,&q;courseId&q;:6,&q;status&q;:3,&q;playStatus&q;:3,&q;type&q;:33,&q;recordingType&q;:0,&q;mediaType&q;:0,&q;title&q;:&q;【公基法律】精选好题 沉浸刷题&q;,&q;innerTitle&q;:&q;&q;,&q;startTime&q;:1758506400000,&q;endTime&q;:1758513600000,&q;teacher&q;:{&q;id&q;:56386,&q;userId&q;:76976071,&q;name&q;:&q;郁青&q;,&q;brief&q;:&q;粉笔优质讲师&q;,&q;desc&q;:&q;粉笔常识公基优质教师，法学专业毕业，授课严谨细致，讲解通俗易懂，授课过程中，注重课堂氛围，氛围生动有趣，课堂上注重基础，帮助学员查缺补漏，不断提高做题技巧。耐心细致，照顾到每个学员，给予学习信心。&q;,&q;avatar&q;:&q;184183d8b0babee.jpg&q;,&q;upperBodyPhoto&q;:null,&q;displayCoursePrefix&q;:&q;sydw&q;,&q;teacherStat&q;:{&q;teacherId&q;:56386,&q;episodeCount&q;:171,&q;scoreCount&q;:369,&q;avgScore&q;:9.485094850948508,&q;fiveGradeAvgScore&q;:4.74,&q;updateTime&q;:1769951409746},&q;auditionEpisode&q;:{&q;episodeTitle&q;:&q;个人展示课&q;,&q;episodeVideoUrl&q;:&q;https://vod.fbstatic.cn/22e9ceb2vodbj1251001446/cdcd208f1397757888023754303/1Gdmjad6mt8A.mp4?t=f2a4b300&a;us=4070880000&a;sign=56553ea9151bf559787449a83a34d47b&q;},&q;memberOfCPC&q;:false,&q;tags&q;:null},&q;teachChannel&q;:1,&q;offline&q;:null,&q;duration&q;:6921,&q;hasAudition&q;:false,&q;bizType&q;:0,&q;bizId&q;:&q;726825&q;,&q;supportReplay&q;:true,&q;extraInfo&q;:null,&q;liveConfig&q;:{&q;episodeId&q;:11002545,&q;supportMultiGroup&q;:false,&q;exerciseBizType&q;:0,&q;videoDisplayType&q;:0,&q;avForwardType&q;:0,&q;useIntelligentRoom&q;:false,&q;hasStrokeKeynote&q;:true,&q;verticalModeType&q;:0,&q;originEpisodeId&q;:0,&q;supportRtmp&q;:false,&q;supportPk&q;:true,&q;supportLuckyBag&q;:true,&q;supportUserNoteStroke&q;:false,&q;communicateType&q;:0,&q;one2One&q;:false,&q;fakeLive&q;:false},&q;validStatus&q;:1,&q;supportLive&q;:true,&q;supportAiCatalog&q;:false,&q;hasIntelligentPen&q;:false,&q;useLocalRecording&q;:false,&q;useIntelligentRoom&q;:false,&q;hasSalePosition&q;:false,&q;hasEpisodeCards&q;:true,&q;lockedForShouna&q;:false,&q;needSignIn&q;:false,&q;needTeacherSignIn&q;:false,&q;enablePadPencil&q;:true,&q;displayExercise&q;:false,&q;supportLuckyBag&q;:true,&q;supportLivePk&q;:true},{&q;id&q;:11002546,&q;kePrefix&q;:&q;sydw&q;,&q;courseId&q;:6,&q;status&q;:3,&q;playStatus&q;:3,&q;type&q;:33,&q;recordingType&q;:0,&q;mediaType&q;:0,&q;title&q;:&q;【数资】精选好题 沉浸刷题&q;,&q;innerTitle&q;:&q;&q;,&q;startTime&q;:1758513600000,&q;endTime&q;:1758520800000,&q;teacher&q;:{&q;id&q;:16588,&q;userId&q;:73651929,&q;name&q;:&q;王雅平&q;,&q;brief&q;:&q;粉笔优质讲师&q;,&q;desc&q;:&q;粉笔优质讲师\n6年一线教学经验，授课时长3000+小时，所带学员综合通过率达68%，具有数资科目丰富的实践经验及系统扎实的专业理论知识，对考情深入研究，授课经验丰富：①撰写多篇教研材料，在粉笔教师内部进行共享；②多次参加粉笔授课研讨会议，全面把握数资命题趋势及最新考情，积累丰富知识；③多次参加粉笔教研活动，分享授课经验心得。&q;,&q;avatar&q;:&q;17467ff056cb0e3.jpg&q;,&q;upperBodyPhoto&q;:null,&q;displayCoursePrefix&q;:&q;sydw&q;,&q;teacherStat&q;:{&q;teacherId&q;:16588,&q;episodeCount&q;:645,&q;scoreCount&q;:1598,&q;avgScore&q;:9.801001251564475,&q;fiveGradeAvgScore&q;:4.9,&q;updateTime&q;:1773543164175},&q;auditionEpisode&q;:{&q;episodeTitle&q;:&q;个人展示课&q;,&q;episodeVideoUrl&q;:&q;https://vod.fbstatic.cn/22e9ceb2vodbj1251001446/3d7922af5145403708051711222/4CdLbW9JRzEA.mp4?t=f2a4b300&a;us=4070880000&a;sign=db9e82e392a8449558ccd8e4eedf3845&q;},&q;memberOfCPC&q;:false,&q;tags&q;:null},&q;teachChannel&q;:1,&q;offline&q;:null,&q;duration&q;:8260,&q;hasAudition&q;:false,&q;bizType&q;:0,&q;bizId&q;:&q;726825&q;,&q;supportReplay&q;:true,&q;extraInfo&q;:null,&q;liveConfig&q;:{&q;episodeId&q;:11002546,&q;supportMultiGroup&q;:false,&q;exerciseBizType&q;:0,&q;videoDisplayType&q;:0,&q;avForwardType&q;:0,&q;useIntelligentRoom&q;:false,&q;hasStrokeKeynote&q;:true,&q;verticalModeType&q;:0,&q;originEpisodeId&q;:0,&q;supportRtmp&q;:false,&q;supportPk&q;:true,&q;supportLuckyBag&q;:true,&q;supportUserNoteStroke&q;:false,&q;communicateType&q;:0,&q;one2One&q;:false,&q;fakeLive&q;:false},&q;validStatus&q;:1,&q;supportLive&q;:true,&q;supportAiCatalog&q;:false,&q;hasIntelligentPen&q;:false,&q;useLocalRecording&q;:false,&q;useIntelligentRoom&q;:false,&q;hasSalePosition&q;:false,&q;hasEpisodeCards&q;:true,&q;lockedForShouna&q;:false,&q;needSignIn&q;:false,&q;needTeacherSignIn&q;:false,&q;enablePadPencil&q;:true,&q;displayExercise&q;:false,&q;supportLuckyBag&q;:true,&q;supportLivePk&q;:true},{&q;id&q;:11002561,&q;kePrefix&q;:&q;sydw&q;,&q;courseId&q;:6,&q;status&q;:3,&q;playStatus&q;:3,&q;type&q;:33,&q;recordingType&q;:0,&q;mediaType&q;:0,&q;title&q;:&q;【公基非法】精选好题 沉浸刷题&q;,&q;innerTitle&q;:&q;&q;,&q;startTime&q;:1758520800000,&q;endTime&q;:1758528000000,&q;teacher&q;:{&q;id&q;:52906,&q;userId&q;:88669957,&q;name&q;:&q;陶静&q;,&q;brief&q;:&q;粉笔优质讲师&q;,&q;desc&q;:&q;粉笔优质讲师\n6年一线教学，深耕线上线下授课，累计覆盖全国超万名学员，授课时长已突破2500小时，教学经验扎实且全面。\n深耕常识与公共基础知识、判断科目领域，兼具扎实的专业理论功底与丰富实践经验。对全国多地考试考情、真题规律及命题趋势有着深刻洞察，授课理念独到新颖，始终秉持理论与实践相结合的教学原则，致力于帮助学员系统掌握解题技巧，让大家在轻松高效的学习氛围中稳步提升。\n授课风格独树一帜，条理清晰，又风趣幽默，把复杂课程内容拆解得层次分明、脉络清晰，让学员轻松跟上学习节奏，再搭配专业完善的教学体系，学习效率直接拉满。&q;,&q;avatar&q;:&q;1984fe9e02e27a3.jpg&q;,&q;upperBodyPhoto&q;:null,&q;displayCoursePrefix&q;:&q;sydw&q;,&q;teacherStat&q;:{&q;teacherId&q;:52906,&q;episodeCount&q;:640,&q;scoreCount&q;:952,&q;avgScore&q;:9.83823529411764,&q;fiveGradeAvgScore&q;:4.92,&q;updateTime&q;:1773495035648},&q;auditionEpisode&q;:{&q;episodeTitle&q;:&q;个人展示课&q;,&q;episodeVideoUrl&q;:&q;https://vod.fbstatic.cn/22e9ceb2vodbj1251001446/d568fd2c1397757888047530032/UZNkfXcuVicA.mp4?t=f2a4b300&a;us=4070880000&a;sign=a17687f4fba4def68220de9a1cbf4eef&q;},&q;memberOfCPC&q;:false,&q;tags&q;:null},&q;teachChannel&q;:1,&q;offline&q;:null,&q;duration&q;:7698,&q;hasAudition&q;:false,&q;bizType&q;:0,&q;bizId&q;:&q;726825&q;,&q;supportReplay&q;:true,&q;extraInfo&q;:null,&q;liveConfig&q;:{&q;episodeId&q;:11002561,&q;supportMultiGroup&q;:false,&q;exerciseBizType&q;:0,&q;videoDisplayType&q;:0,&q;avForwardType&q;:0,&q;useIntelligentRoom&q;:false,&q;hasStrokeKeynote&q;:true,&q;verticalModeType&q;:0,&q;originEpisodeId&q;:0,&q;supportRtmp&q;:false,&q;supportPk&q;:true,&q;supportLuckyBag&q;:true,&q;supportUserNoteStroke&q;:false,&q;communicateType&q;:0,&q;one2One&q;:false,&q;fakeLive&q;:false},&q;validStatus&q;:1,&q;supportLive&q;:true,&q;supportAiCatalog&q;:false,&q;hasIntelligentPen&q;:false,&q;useLocalRecording&q;:false,&q;useIntelligentRoom&q;:false,&q;hasSalePosition&q;:false,&q;hasEpisodeCards&q;:true,&q;lockedForShouna&q;:false,&q;needSignIn&q;:false,&q;needTeacherSignIn&q;:false,&q;enablePadPencil&q;:true,&q;displayExercise&q;:false,&q;supportLuckyBag&q;:true,&q;supportLivePk&q;:true},{&q;id&q;:11002568,&q;kePrefix&q;:&q;sydw&q;,&q;courseId&q;:6,&q;status&q;:3,&q;playStatus&q;:3,&q;type&q;:33,&q;recordingType&q;:0,&q;mediaType&q;:0,&q;title&q;:&q;【言语】精选好题 沉浸刷题&q;,&q;innerTitle&q;:&q;&q;,&q;startTime&q;:1758528000000,&q;endTime&q;:1758535200000,&q;teacher&q;:{&q;id&q;:53299,&q;userId&q;:74949917,&q;name&q;:&q;谭双艳&q;,&q;brief&q;:&q;粉笔优质讲师&q;,&q;desc&q;:&q;粉笔优质教师\n5年一线教学授课经验，具有言语科目丰富的实践经验以及系统扎实的的专业理论知识研究。授课逻辑清晰，教学过程耐心细致。课堂注重多角度解答问题，对言语各类知识均有细致的研究。多次参与真题解析、出具模拟题、真题录制、教学教研等多项专业工作。整体授课风格轻松幽默，帮助学员快速掌握做题技巧，获得学员一致好评。&q;,&q;avatar&q;:&q;17f8b66017fc8f3.jpg&q;,&q;upperBodyPhoto&q;:null,&q;displayCoursePrefix&q;:&q;sydw&q;,&q;teacherStat&q;:{&q;teacherId&q;:53299,&q;episodeCount&q;:417,&q;scoreCount&q;:991,&q;avgScore&q;:9.773965691220996,&q;fiveGradeAvgScore&q;:4.89,&q;updateTime&q;:1773540926444},&q;auditionEpisode&q;:{&q;episodeTitle&q;:&q;个人展示课&q;,&q;episodeVideoUrl&q;:&q;https://vod.fbstatic.cn/22e9ceb2vodbj1251001446/182852a05145403709308556163/kRnCUqYoxM4A.mp4?t=f2a4b300&a;us=4070880000&a;sign=4db1b0f971b8cacfe8e4004ba2017ed5&q;},&q;memberOfCPC&q;:false,&q;tags&q;:null},&q;teachChannel&q;:1,&q;offline&q;:null,&q;duration&q;:7045,&q;hasAudition&q;:false,&q;bizType&q;:0,&q;bizId&q;:&q;726825&q;,&q;supportReplay&q;:true,&q;extraInfo&q;:null,&q;liveConfig&q;:{&q;episodeId&q;:11002568,&q;supportMultiGroup&q;:false,&q;exerciseBizType&q;:0,&q;videoDisplayType&q;:0,&q;avForwardType&q;:0,&q;useIntelligentRoom&q;:false,&q;hasStrokeKeynote&q;:true,&q;verticalModeType&q;:0,&q;originEpisodeId&q;:0,&q;supportRtmp&q;:false,&q;supportPk&q;:true,&q;supportLuckyBag&q;:true,&q;supportUserNoteStroke&q;:false,&q;communicateType&q;:0,&q;one2One&q;:false,&q;fakeLive&q;:false},&q;validStatus&q;:1,&q;supportLive&q;:true,&q;supportAiCatalog&q;:false,&q;hasIntelligentPen&q;:false,&q;useLocalRecording&q;:false,&q;useIntelligentRoom&q;:false,&q;hasSalePosition&q;:false,&q;hasEpisodeCards&q;:true,&q;lockedForShouna&q;:false,&q;needSignIn&q;:false,&q;needTeacherSignIn&q;:false,&q;enablePadPencil&q;:true,&q;displayExercise&q;:false,&q;supportLuckyBag&q;:true,&q;supportLivePk&q;:true},{&q;id&q;:11002573,&q;kePrefix&q;:&q;sydw&q;,&q;courseId&q;:6,&q;status&q;:3,&q;playStatus&q;:3,&q;type&q;:33,&q;recordingType&q;:0,&q;mediaType&q;:0,&q;title&q;:&q;【言语】精选好题 沉浸刷题&q;,&q;innerTitle&q;:&q;&q;,&q;startTime&q;:1758592800000,&q;endTime&q;:1758600000000,&q;teacher&q;:{&q;id&q;:16948,&q;userId&q;:69316245,&q;name&q;:&q;巨琼&q;,&q;brief&q;:&q;粉笔优质讲师&q;,&q;desc&q;:&q;粉笔优质教师\n6年以上一线教学授课经验，累计授课时长2000+，授课人数10000+，授课评分4.9分，累计获得学员好评上千条。具有扎实系统的言语专业知识体系且线上线下均授课经验丰富，线上授课涵盖联考、山东、安徽等各省言语课程，线下曾多次担任联考、江苏等省份言语主讲。长期参与言语科目教研工作，真题解析、模拟题撰写、参与《职测3000题》 单题录制等，全面了解事业单位各省份言语命题规律及答题技巧。教学中，曾获事业单位教师风采大赛“三等奖”，持续积极探索生动有趣的教学方式，精准把握言语考点，帮助学员快速理解并掌握言语技巧，能以独特的方法引导学员攻克难关，提升答题准确率与速度，深受学员认可，助力多名学员成功实现自己的职业目标。&q;,&q;avatar&q;:&q;1746cf3620ab526.jpg&q;,&q;upperBodyPhoto&q;:null,&q;displayCoursePrefix&q;:&q;sydw&q;,&q;teacherStat&q;:{&q;teacherId&q;:16948,&q;episodeCount&q;:595,&q;scoreCount&q;:2018,&q;avgScore&q;:9.865213082259663,&q;fiveGradeAvgScore&q;:4.93,&q;updateTime&q;:1773488367488},&q;auditionEpisode&q;:{&q;episodeTitle&q;:&q;个人展示课&q;,&q;episodeVideoUrl&q;:&q;https://vod.fbstatic.cn/22e9ceb2vodbj1251001446/c5adc5685145403709538521768/r1Y9MG5YjPwA.mp4?t=f2a4b300&a;us=4070880000&a;sign=e92eaa0857512f99b08ff349fc652a92&q;},&q;memberOfCPC&q;:false,&q;tags&q;:null},&q;teachChannel&q;:1,&q;offline&q;:null,&q;duration&q;:7938,&q;hasAudition&q;:false,&q;bizType&q;:0,&q;bizId&q;:&q;726825&q;,&q;supportReplay&q;:true,&q;extraInfo&q;:null,&q;liveConfig&q;:{&q;episodeId&q;:11002573,&q;supportMultiGroup&q;:false,&q;exerciseBizType&q;:0,&q;videoDisplayType&q;:0,&q;avForwardType&q;:0,&q;useIntelligentRoom&q;:false,&q;hasStrokeKeynote&q;:true,&q;verticalModeType&q;:0,&q;originEpisodeId&q;:0,&q;supportRtmp&q;:false,&q;supportPk&q;:true,&q;supportLuckyBag&q;:true,&q;supportUserNoteStroke&q;:false,&q;communicateType&q;:0,&q;one2One&q;:false,&q;fakeLive&q;:false},&q;validStatus&q;:1,&q;supportLive&q;:true,&q;supportAiCatalog&q;:false,&q;hasIntelligentPen&q;:false,&q;useLocalRecording&q;:false,&q;useIntelligentRoom&q;:false,&q;hasSalePosition&q;:false,&q;hasEpisodeCards&q;:true,&q;lockedForShouna&q;:false,&q;needSignIn&q;:false,&q;needTeacherSignIn&q;:false,&q;enablePadPencil&q;:true,&q;displayExercise&q;:false,&q;supportLuckyBag&q;:true,&q;supportLivePk&q;:true},{&q;id&q;:11002574,&q;kePrefix&q;:&q;sydw&q;,&q;courseId&q;:6,&q;status&q;:3,&q;playStatus&q;:3,&q;type&q;:33,&q;recordingType&q;:0,&q;mediaType&q;:0,&q;title&q;:&q;【综应】精选好题 沉浸刷题&q;,&q;innerTitle&q;:&q;&q;,&q;startTime&q;:1758600000000,&q;endTime&q;:1758607200000,&q;teacher&q;:{&q;id&q;:32807,&q;userId&q;:58353585,&q;name&q;:&q;陈婷真&q;,&q;brief&q;:&q;粉笔优质讲师&q;,&q;desc&q;:&q;粉笔优质教师\n五年教学经验，多次参加综应教研会，了解各地区对应考情，专业理论知识扎实。\n累计带班数量超40＋，学员整体评分维持4.9以上。\n善于结合学员实际学习情况针对性讲解作答技巧，注重与学员的互动，课堂引导性强，通俗易懂，授课逻辑清晰，将实践做题与知识理论相结合，让学员了解到自身不足并对应提高作答能力，深受学员好评。&q;,&q;avatar&q;:&q;1785cfe2779256e.jpg&q;,&q;upperBodyPhoto&q;:null,&q;displayCoursePrefix&q;:&q;sydw&q;,&q;teacherStat&q;:{&q;teacherId&q;:32807,&q;episodeCount&q;:450,&q;scoreCount&q;:510,&q;avgScore&q;:9.917647058823535,&q;fiveGradeAvgScore&q;:4.96,&q;updateTime&q;:1773373705667},&q;auditionEpisode&q;:{&q;episodeTitle&q;:&q;个人展示课&q;,&q;episodeVideoUrl&q;:&q;https://vod.fbstatic.cn/22e9ceb2vodbj1251001446/14944d765145403707370134821/S4R1s6rQfvEA.mp4?t=f2a4b300&a;us=4070880000&a;sign=75cde947cd4df73767b77c947740ce48&q;},&q;memberOfCPC&q;:false,&q;tags&q;:null},&q;teachChannel&q;:1,&q;offline&q;:null,&q;duration&q;:6690,&q;hasAudition&q;:false,&q;bizType&q;:0,&q;bizId&q;:&q;726825&q;,&q;supportReplay&q;:true,&q;extraInfo&q;:null,&q;liveConfig&q;:{&q;episodeId&q;:11002574,&q;supportMultiGroup&q;:false,&q;exerciseBizType&q;:0,&q;videoDisplayType&q;:0,&q;avForwardType&q;:0,&q;useIntelligentRoom&q;:false,&q;hasStrokeKeynote&q;:true,&q;verticalModeType&q;:0,&q;originEpisodeId&q;:0,&q;supportRtmp&q;:false,&q;supportPk&q;:true,&q;supportLuckyBag&q;:true,&q;supportUserNoteStroke&q;:false,&q;communicateType&q;:0,&q;one2One&q;:false,&q;fakeLive&q;:false},&q;validStatus&q;:1,&q;supportLive&q;:true,&q;supportAiCatalog&q;:false,&q;hasIntelligentPen&q;:false,&q;useLocalRecording&q;:false,&q;useIntelligentRoom&q;:false,&q;hasSalePosition&q;:false,&q;hasEpisodeCards&q;:true,&q;lockedForShouna&q;:false,&q;needSignIn&q;:false,&q;needTeacherSignIn&q;:false,&q;enablePadPencil&q;:true,&q;displayExercise&q;:false,&q;supportLuckyBag&q;:true,&q;supportLivePk&q;:true},{&q;id&q;:11002577,&q;kePrefix&q;:&q;sydw&q;,&q;courseId&q;:6,&q;status&q;:3,&q;playStatus&q;:3,&q;type&q;:33,&q;recordingType&q;:0,&q;mediaType&q;:0,&q;title&q;:&q;【数资】精选好题 沉浸刷题&q;,&q;innerTitle&q;:&q;&q;,&q;startTime&q;:1758607200000,&q;endTime&q;:1758614400000,&q;teacher&q;:{&q;id&q;:32043,&q;userId&q;:72042434,&q;name&q;:&q;吴丽欢&q;,&q;brief&q;:&q;粉笔优质讲师&q;,&q;desc&q;:&q;粉笔优质教师\n5年一线教学经验。承担过线下笔试精品班，授课经验丰富。\n熟悉事业单位考试内容和流程，具有数资科目丰富的实践经验及系统扎实的专业理论知识。多次参加粉笔授课研讨会议和笔试真题校验和解析撰写工作，对事业单位数资考情有深入研究。\n累计带班人数2000人次以上，累计授课评分4.8分以上。讲课生动、讲解详细、思路清晰，让学生在轻松的学习氛围中，用更简单的方法，找到更快捷的解题之道，深受广大学员的认可和好评。&q;,&q;avatar&q;:&q;19661616e0054b7.jpg&q;,&q;upperBodyPhoto&q;:null,&q;displayCoursePrefix&q;:&q;sydw&q;,&q;teacherStat&q;:{&q;teacherId&q;:32043,&q;episodeCount&q;:438,&q;scoreCount&q;:1157,&q;avgScore&q;:9.640449438202257,&q;fiveGradeAvgScore&q;:4.82,&q;updateTime&q;:1773418100874},&q;auditionEpisode&q;:{&q;episodeTitle&q;:&q;个人展示课&q;,&q;episodeVideoUrl&q;:&q;https://vod.fbstatic.cn/22e9ceb2vodbj1251001446/12fa0b4f5145403711103506705/gFRqcWCGD10A.mp4?t=f2a4b300&a;us=4070880000&a;sign=ab6f65c7516eea1b1fd3553d05b71090&q;},&q;memberOfCPC&q;:false,&q;tags&q;:null},&q;teachChannel&q;:1,&q;offline&q;:null,&q;duration&q;:8056,&q;hasAudition&q;:false,&q;bizType&q;:0,&q;bizId&q;:&q;726825&q;,&q;supportReplay&q;:true,&q;extraInfo&q;:null,&q;liveConfig&q;:{&q;episodeId&q;:11002577,&q;supportMultiGroup&q;:false,&q;exerciseBizType&q;:0,&q;videoDisplayType&q;:0,&q;avForwar