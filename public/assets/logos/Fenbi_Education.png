&q;粉笔数资优质教师，10年公考授课经验，百化分口诀中“77腿长一米三”的戚七本七 。授课逻辑清晰，对题目剖析全面，注重对学生思维的启发，善于归纳技巧总结经验。授课风格清新明快，课堂气氛轻松有趣，深受学员好评。&q;,&q;avatar&q;:&q;171a184fdc57f68.jpg&q;,&q;upperBodyPhoto&q;:null,&q;displayCoursePrefix&q;:&q;gwy&q;,&q;teacherStat&q;:{&q;teacherId&q;:4707,&q;episodeCount&q;:1380,&q;scoreCount&q;:145728,&q;avgScore&q;:9.769817742643832,&q;fiveGradeAvgScore&q;:4.88,&q;updateTime&q;:1773622979346},&q;auditionEpisode&q;:{&q;episodeTitle&q;:&q;个人展示课&q;,&q;episodeVideoUrl&q;:&q;https://vod.fbstatic.cn/22e9ceb2vodbj1251001446/59912ccc3560136621446868819/CrZHOnpTvoAA.mp4?t=f2a4b300&a;us=4070880000&a;sign=303b062e9bd2fe154863f9991d75a247&q;},&q;memberOfCPC&q;:false,&q;tags&q;:null},&q;teachChannel&q;:1,&q;offline&q;:null,&q;duration&q;:12073,&q;hasAudition&q;:false,&q;bizType&q;:0,&q;bizId&q;:&q;710082&q;,&q;supportReplay&q;:true,&q;extraInfo&q;:null,&q;liveConfig&q;:{&q;episodeId&q;:10764572,&q;supportMultiGroup&q;:false,&q;exerciseBizType&q;:0,&q;videoDisplayType&q;:0,&q;avForwardType&q;:0,&q;useIntelligentRoom&q;:false,&q;hasStrokeKeynote&q;:true,&q;verticalModeType&q;:0,&q;originEpisodeId&q;:0,&q;supportRtmp&q;:false,&q;supportPk&q;:false,&q;supportLuckyBag&q;:false,&q;supportUserNoteStroke&q;:false,&q;communicateType&q;:0,&q;one2One&q;:false,&q;fakeLive&q;:false},&q;validStatus&q;:1,&q;supportLive&q;:true,&q;supportAiCatalog&q;:true,&q;hasIntelligentPen&q;:false,&q;useLocalRecording&q;:false,&q;useIntelligentRoom&q;:false,&q;hasSalePosition&q;:false,&q;hasEpisodeCards&q;:false,&q;lockedForShouna&q;:false,&q;needSignIn&q;:false,&q;needTeacherSignIn&q;:false,&q;enablePadPencil&q;:true,&q;displayExercise&q;:false,&q;supportLuckyBag&q;:false,&q;supportLivePk&q;:false},{&q;id&q;:10786967,&q;kePrefix&q;:&q;gwy&q;,&q;courseId&q;:1,&q;status&q;:3,&q;playStatus&q;:3,&q;type&q;:1,&q;recordingType&q;:0,&q;mediaType&q;:0,&q;title&q;:&q;言语-【2026国考第25季&a;2025下半年省考第17季】行测模考大赛&q;,&q;innerTitle&q;:&q;&q;,&q;startTime&q;:1752404400000,&q;endTime&q;:1752413400000,&q;teacher&q;:{&q;id&q;:5221,&q;userId&q;:45428554,&q;name&q;:&q;许顺&q;,&q;brief&q;:&q;粉笔言语优质教师&q;,&q;desc&q;:&q;粉笔言语优质教师，8年一线授课经验，培训师资数百人，服务学员超百万人，实战经验丰富，曾多次高分进面。长期深耕公务员考试领域，对试题有独到见解和深刻把握。授课风格独树一帜，课堂氛围轻松幽默，考情剖析精准入微，用专业与热情为学子点亮求知之路，引领其在知识海洋破浪前行。 \n参与组织各类授课研讨会议和教研活动，参与编撰《笔试系统讲义》《精品系统讲义》《行测的思维》《决战行测5000题》等多套图书。&q;,&q;avatar&q;:&q;164688ac9182991.png&q;,&q;upperBodyPhoto&q;:null,&q;displayCoursePrefix&q;:&q;gwy&q;,&q;teacherStat&q;:{&q;teacherId&q;:5221,&q;episodeCount&q;:1330,&q;scoreCount&q;:217776,&q;avgScore&q;:9.756887811329094,&q;fiveGradeAvgScore&q;:4.88,&q;updateTime&q;:1773623380485},&q;auditionEpisode&q;:{&q;episodeTitle&q;:&q;个人展示课&q;,&q;episodeVideoUrl&q;:&q;https://vod.fbstatic.cn/22e9ceb2vodbj1251001446/570389653560136621446734838/9l2Tds3aXxkA.mp4?t=f2a4b300&a;us=4070880000&a;sign=47533fe75a70ebac353439ec55a7b251&q;},&q;memberOfCPC&q;:false,&q;tags&q;:null},&q;teachChannel&q;:1,&q;offline&q;:null,&q;duration&q;:9778,&q;hasAudition&q;:false,&q;bizType&q;:0,&q;bizId&q;:&q;710082&q;,&q;supportReplay&q;:true,&q;extraInfo&q;:null,&q;liveConfig&q;:{&q;episodeId&q;:10786967,&q;supportMultiGroup&q;:false,&q;exerciseBizType&q;:0,&q;videoDisplayType&q;:0,&q;avForwardType&q;:0,&q;useIntelligentRoom&q;:false,&q;hasStrokeKeynote&q;:true,&q;verticalModeType&q;:0,&q;originEpisodeId&q;:0,&q;supportRtmp&q;:false,&q;supportPk&q;:false,&q;supportLuckyBag&q;:false,&q;supportUserNoteStroke&q;:false,&q;communicateType&q;:0,&q;one2One&q;:false,&q;fakeLive&q;:false},&q;validStatus&q;:1,&q;supportLive&q;:true,&q;supportAiCatalog&q;:true,&q;hasIntelligentPen&q;:false,&q;useLocalRecording&q;:false,&q;useIntelligentRoom&q;:false,&q;hasSalePosition&q;:false,&q;hasEpisodeCards&q;:false,&q;lockedForShouna&q;:false,&q;needSignIn&q;:false,&q;needTeacherSignIn&q;:false,&q;enablePadPencil&q;:true,&q;displayExercise&q;:false,&q;supportLuckyBag&q;:false,&q;supportLivePk&q;:false},{&q;id&q;:10786968,&q;kePrefix&q;:&q;gwy&q;,&q;courseId&q;:1,&q;status&q;:3,&q;playStatus&q;:3,&q;type&q;:1,&q;recordingType&q;:0,&q;mediaType&q;:0,&q;title&q;:&q;判断-【2026国考第25季&a;2025下半年省考第17季】行测模考大赛&q;,&q;innerTitle&q;:&q;&q;,&q;startTime&q;:1752404400000,&q;endTime&q;:1752415200000,&q;teacher&q;:{&q;id&q;:15984,&q;userId&q;:66492815,&q;name&q;:&q;李宏&q;,&q;brief&q;:&q;粉笔判断优质教师&q;,&q;desc&q;:&q;粉笔判断优质教师，中国农业大学硕士毕业。 \n已在公考行业深耕5年，累计授课时长超4000小时，直接培训学员逾10万人次。长期专注于公务员考试命题规律研究，对判断推理模块的解题逻辑与应试技巧有独到的理解，擅长将抽象逻辑具象化，复杂考点条理化。注重因材施教，课堂呈现脉络清晰，语言生动风趣，解题技巧实用易掌握，学员提分效果显著。 \n作为核心教研成员连续多年参与粉笔题库建设，参与编撰《决战行测5000题》、《行测思维》等图书。&q;,&q;avatar&q;:&q;1774c009210598e.jpg&q;,&q;upperBodyPhoto&q;:null,&q;displayCoursePrefix&q;:&q;gwy&q;,&q;teacherStat&q;:{&q;teacherId&q;:15984,&q;episodeCount&q;:1062,&q;scoreCount&q;:72125,&q;avgScore&q;:9.857830155979219,&q;fiveGradeAvgScore&q;:4.93,&q;updateTime&q;:1773622748783},&q;auditionEpisode&q;:{&q;episodeTitle&q;:&q;个人展示课&q;,&q;episodeVideoUrl&q;:&q;https://vod.fbstatic.cn/22e9ceb2vodbj1251001446/4bb439203560136621446284860/xtBZqkpEykYA.mp4?t=f2a4b300&a;us=4070880000&a;sign=fd8fe2f310790fadd1c5df5f9c647383&q;},&q;memberOfCPC&q;:false,&q;tags&q;:null},&q;teachChannel&q;:1,&q;offline&q;:null,&q;duration&q;:11027,&q;hasAudition&q;:false,&q;bizType&q;:0,&q;bizId&q;:&q;710082&q;,&q;supportReplay&q;:true,&q;extraInfo&q;:null,&q;liveConfig&q;:{&q;episodeId&q;:10786968,&q;supportMultiGroup&q;:false,&q;exerciseBizType&q;:0,&q;videoDisplayType&q;:0,&q;avForwardType&q;:0,&q;useIntelligentRoom&q;:false,&q;hasStrokeKeynote&q;:true,&q;verticalModeType&q;:0,&q;originEpisodeId&q;:0,&q;supportRtmp&q;:false,&q;supportPk&q;:false,&q;supportLuckyBag&q;:false,&q;supportUserNoteStroke&q;:false,&q;communicateType&q;:0,&q;one2One&q;:false,&q;fakeLive&q;:false},&q;validStatus&q;:1,&q;supportLive&q;:true,&q;supportAiCatalog&q;:true,&q;hasIntelligentPen&q;:false,&q;useLocalRecording&q;:false,&q;useIntelligentRoom&q;:false,&q;hasSalePosition&q;:false,&q;hasEpisodeCards&q;:false,&q;lockedForShouna&q;:false,&q;needSignIn&q;:false,&q;needTeacherSignIn&q;:false,&q;enablePadPencil&q;:true,&q;displayExercise&q;:false,&q;supportLuckyBag&q;:false,&q;supportLivePk&q;:false},{&q;id&q;:10786969,&q;kePrefix&q;:&q;gwy&q;,&q;courseId&q;:1,&q;status&q;:3,&q;playStatus&q;:3,&q;type&q;:1,&q;recordingType&q;:0,&q;mediaType&q;:0,&q;title&q;:&q;数资-【2026国考第25季&a;2025下半年省考第17季】行测模考大赛&q;,&q;innerTitle&q;:&q;&q;,&q;startTime&q;:1752404400000,&q;endTime&q;:1752415200000,&q;teacher&q;:{&q;id&q;:1650,&q;userId&q;:41404874,&q;name&q;:&q;杜岩&q;,&q;brief&q;:&q;粉笔数资优质教师&q;,&q;desc&q;:&q;粉笔数资优质教师，985高校毕业。9年公考授课经验，累计授课时长超过10000小时，培训学员超百万人次。擅长数学及资料分析模块。具有深厚理论知识和海量做题经验，实践经验丰富，授课亲切耐心，逻辑思维严谨，能有效的理清学员思路，针对不同类型的学员因材施教。参与组织各类授课教研活动，参与编著《行测的思维》《决战行测5000题》等多套图书。&q;,&q;avatar&q;:&q;1794076b312aeeb.jpg&q;,&q;upperBodyPhoto&q;:null,&q;displayCoursePrefix&q;:&q;gwy&q;,&q;teacherStat&q;:{&q;teacherId&q;:1650,&q;episodeCount&q;:1529,&q;scoreCount&q;:385901,&q;avgScore&q;:9.836621309610486,&q;fiveGradeAvgScore&q;:4.92,&q;updateTime&q;:1773622127258},&q;auditionEpisode&q;:{&q;episodeTitle&q;:&q;个人展示课&q;,&q;episodeVideoUrl&q;:&q;https://vod.fbstatic.cn/22e9ceb2vodbj1251001446/f12edcc73560136621448765915/n1xP1SZ27ocA.mp4?t=f2a4b300&a;us=4070880000&a;sign=a4a772a12aff8e2ff0ee57598cafe585&q;},&q;memberOfCPC&q;:false,&q;tags&q;:null},&q;teachChannel&q;:1,&q;offline&q;:null,&q;duration&q;:11569,&q;hasAudition&q;:false,&q;bizType&q;:0,&q;bizId&q;:&q;710082&q;,&q;supportReplay&q;:true,&q;extraInfo&q;:null,&q;liveConfig&q;:{&q;episodeId&q;:10786969,&q;supportMultiGroup&q;:false,&q;exerciseBizType&q;:0,&q;videoDisplayType&q;:0,&q;avForwardType&q;:0,&q;useIntelligentRoom&q;:false,&q;hasStrokeKeynote&q;:true,&q;verticalModeType&q;:0,&q;originEpisodeId&q;:0,&q;supportRtmp&q;:false,&q;supportPk&q;:false,&q;supportLuckyBag&q;:false,&q;supportUserNoteStroke&q;:false,&q;communicateType&q;:0,&q;one2One&q;:false,&q;fakeLive&q;:false},&q;validStatus&q;:1,&q;supportLive&q;:true,&q;supportAiCatalog&q;:true,&q;hasIntelligentPen&q;:false,&q;useLocalRecording&q;:false,&q;useIntelligentRoom&q;:false,&q;hasSalePosition&q;:false,&q;hasEpisodeCards&q;:false,&q