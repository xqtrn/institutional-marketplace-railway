odbj1251001446/626c33885145403709703283976/HyB5QWvOOscA.mp4?t=f2a4b300&a;us=4070880000&a;sign=f54bd80bca68d19c515ce2f10857170c&q;},&q;memberOfCPC&q;:false,&q;tags&q;:null},&q;teachChannel&q;:1,&q;offline&q;:null,&q;duration&q;:7457,&q;hasAudition&q;:false,&q;bizType&q;:0,&q;bizId&q;:&q;726825&q;,&q;supportReplay&q;:true,&q;extraInfo&q;:null,&q;liveConfig&q;:{&q;episodeId&q;:10844981,&q;supportMultiGroup&q;:false,&q;exerciseBizType&q;:0,&q;videoDisplayType&q;:0,&q;avForwardType&q;:0,&q;useIntelligentRoom&q;:false,&q;hasStrokeKeynote&q;:true,&q;verticalModeType&q;:0,&q;originEpisodeId&q;:0,&q;supportRtmp&q;:false,&q;supportPk&q;:true,&q;supportLuckyBag&q;:true,&q;supportUserNoteStroke&q;:false,&q;communicateType&q;:0,&q;one2One&q;:false,&q;fakeLive&q;:false},&q;validStatus&q;:1,&q;supportLive&q;:true,&q;supportAiCatalog&q;:false,&q;hasIntelligentPen&q;:false,&q;useLocalRecording&q;:false,&q;useIntelligentRoom&q;:false,&q;hasSalePosition&q;:false,&q;hasEpisodeCards&q;:true,&q;lockedForShouna&q;:false,&q;needSignIn&q;:false,&q;needTeacherSignIn&q;:false,&q;enablePadPencil&q;:true,&q;displayExercise&q;:false,&q;supportLuckyBag&q;:true,&q;supportLivePk&q;:true},{&q;id&q;:10849391,&q;kePrefix&q;:&q;sydw&q;,&q;courseId&q;:6,&q;status&q;:3,&q;playStatus&q;:3,&q;type&q;:33,&q;recordingType&q;:0,&q;mediaType&q;:0,&q;title&q;:&q;【言语】精选好题 沉浸刷题&q;,&q;innerTitle&q;:&q;&q;,&q;startTime&q;:1752292800000,&q;endTime&q;:1752300000000,&q;teacher&q;:{&q;id&q;:16575,&q;userId&q;:58269049,&q;name&q;:&q;王秀敏&q;,&q;brief&q;:&q;粉笔优质讲师&q;,&q;desc&q;:&q;粉笔优质教师\n211高校毕业，五年一线教学授课经验，专注于事业单位笔试领域，主讲线上精品班、线下刷题特训营等多种班型，教学积淀深厚。\n在言语科目上拥有坚实而系统的理论功底，对事业单位考试中言语题目的命题规律有着透彻的分析，多次参与真题解析和模拟试题撰写工作；积极参与授课教学研讨会，不断探索高效教学策略，针对学员痛点定制个性化学习方案，同时注重个人教学技能的持续精进。\n累计授课时长超过2000小时，平均评分达4.9分；授课风格条理清晰，生动活泼，能够引导学生循序渐进地掌握知识要点，构建起牢固的知识框架。始终将助力学员成功上岸为己任，无论是备考策略的指导还是心理调适的建议，都力求做到无微不至，深受学员喜爱。&q;,&q;avatar&q;:&q;17467f0d079109a.jpg&q;,&q;upperBodyPhoto&q;:null,&q;displayCoursePrefix&q;:&q;sydw&q;,&q;teacherStat&q;:{&q;teacherId&q;:16575,&q;episodeCount&q;:413,&q;scoreCount&q;:1597,&q;avgScore&q;:9.864746399499051,&q;fiveGradeAvgScore&q;:4.93,&q;updateTime&q;:1773571217222},&q;auditionEpisode&q;:{&q;episodeTitle&q;:&q;个人展示课&q;,&q;episodeVideoUrl&q;:&q;https://vod.fbstatic.cn/22e9ceb2vodbj1251001446/59aca01b5145403708150262575/K8o1L1IyA2EA.mp4?t=f2a4b300&a;us=4070880000&a;sign=f6f692abf8c56bf7df3b7838fa316ab6&q;},&q;memberOfCPC&q;:false,&q;tags&q;:null},&q;teachChannel&q;:1,&q;offline&q;:null,&q;duration&q;:7748,&q;hasAudition&q;:false,&q;bizType&q;:0,&q;bizId&q;:&q;726825&q;,&q;supportReplay&q;:true,&q;extraInfo&q;:null,&q;liveConfig&q;:{&q;episodeId&q;:10849391,&q;supportMultiGroup&q;:false,&q;exerciseBizType&q;:0,&q;videoDisplayType&q;:0,&q;avForwardType&q;:0,&q;useIntelligentRoom&q;:false,&q;hasStrokeKeynote&q;:true,&q;verticalModeType&q;:0,&q;originEpisodeId&q;:0,&q;supportRtmp&q;:false,&q;supportPk&q;:true,&q;supportLuckyBag&q;:true,&q;supportUserNoteStroke&q;:false,&q;communicateType&q;:0,&q;one2One&q;:false,&q;fakeLive&q;:false},&q;validStatus&q;:1,&q;supportLive&q;:true,&q;supportAiCatalog&q;:false,&q;hasIntelligentPen&q;:false,&q;useLocalRecording&q;:false,&q;useIntelligentRoom&q;:false,&q;hasSalePosition&q;:false,&q;hasEpisodeCards&q;:true,&q;lockedForShouna&q;:false,&q;needSignIn&q;:false,&q;needTeacherSignIn&q;:false,&q;enablePadPencil&q;:true,&q;displayExercise&q;:false,&q;supportLuckyBag&q;:true,&q;supportLivePk&q;:true},{&q;id&q;:10849422,&q;kePrefix&q;:&q;sydw&q;,&q;courseId&q;:6,&q;status&q;:3,&q;playStatus&q;:3,&q;type&q;:33,&q;recordingType&q;:0,&q;mediaType&q;:0,&q;title&q;:&q;【公基非法】精选好题 沉浸刷题&q;,&q;innerTitle&q;:&q;&q;,&q;startTime&q;:1752300000000,&q;endTime&q;:1752307200000,&q;teacher&q;:{&q;id&q;:34141,&q;userId&q;:67002168,&q;name&q;:&q;温东升&q;,&q;brief&q;:&q;粉笔优质讲师&q;,&q;desc&q;:&q;粉笔优质教师\n6年以上一线授课经验。带班学生10000+；熟悉国考、省考、事业单位考情，参与四川、山东、甘肃等省考情分析；长期扎根于公考、省考、事业单位教学教研工作，参与粉笔题库真题、模拟题解析编撰工作，时政文件解析工作，参与全国常识公基非法密卷课件及教案制作，农业农村书籍编撰工作。长期担任常识公基、判断课程主讲。课堂氛围轻松幽默，寓教于乐，能够结合当下时政，灵活运用到实际讲解之中，逻辑思维性强，善于沟通，能够迅速帮助考生进行全方位提升。&q;,&q;avatar&q;:&q;19841271adb989c.jpg&q;,&q;upperBodyPhoto&q;:null,&q;displayCoursePrefix&q;:&q;sydw&q;,&q;teacherStat&q;:{&q;teacherId&q;:34141,&q;episodeCount&q;:708,&q;scoreCount&q;:1467,&q;avgScore&q;:9.745057941376977,&q;fiveGradeAvgScore&q;:4.87,&q;updateTime&q;:1773480813169},&q;auditionEpisode&q;:{&q;episodeTitle&q;:&q;个人展示课&q;,&q;episodeVideoUrl&q;:&q;https://vod.fbstatic.cn/22e9ceb2vodbj1251001446/7b5794655145403710132043113/2OaZlykd0yAA.mp4?t=f2a4b300&a;us=4070880000&a;sign=63dc74bcedbc74171e790ef405ff495e&q;},&q;memberOfCPC&q;:false,&q;tags&q;:null},&q;teachChannel&q;:1,&q;offline&q;:null,&q;duration&q;:7801,&q;hasAudition&q;:false,&q;bizType&q;:0,&q;bizId&q;:&q;726825&q;,&q;supportReplay&q;:true,&q;extraInfo&q;:null,&q;liveConfig&q;:{&q;episodeId&q;:10849422,&q;supportMultiGroup&q;:false,&q;exerciseBizType&q;:0,&q;videoDisplayType&q;:0,&q;avForwardType&q;:0,&q;useIntelligentRoom&q;:false,&q;hasStrokeKeynote&q;:true,&q;verticalModeType&q;:0,&q;originEpisodeId&q;:0,&q;supportRtmp&q;:false,&q;supportPk&q;:true,&q;supportLuckyBag&q;:true,&q;supportUserNoteStroke&q;:false,&q;communicateType&q;:0,&q;one2One&q;:false,&q;fakeLive&q;:false},&q;validStatus&q;:1,&q;supportLive&q;:true,&q;supportAiCatalog&q;:false,&q;hasIntelligentPen&q;:false,&q;useLocalRecording&q;:false,&q;useIntelligentRoom&q;:false,&q;hasSalePosition&q;:false,&q;hasEpisodeCards&q;:true,&q;lockedForShouna&q;:false,&q;needSignIn&q;:false,&q;needTeacherSignIn&q;:false,&q;enablePadPencil&q;:true,&q;displayExercise&q;:false,&q;supportLuckyBag&q;:true,&q;supportLivePk&q;:true},{&q;id&q;:10849371,&q;kePrefix&q;:&q;sydw&q;,&q;courseId&q;:6,&q;status&q;:3,&q;playStatus&q;:3,&q;type&q;:33,&q;recordingType&q;:0,&q;mediaType&q;:0,&q;title&q;:&q;【综应】精选好题 沉浸刷题&q;,&q;innerTitle&q;:&q;&q;,&q;startTime&q;:1752372000000,&q;endTime&q;:1752379200000,&q;teacher&q;:{&q;id&q;:35908,&q;userId&q;:81360450,&q;name&q;:&q;林雨晴&q;,&q;brief&q;:&q;粉笔优质讲师&q;,&q;desc&q;:&q;粉笔优质讲师\n6年一线教学经验，辅导学员数千人，承接各类线上线下精品班，善于从考官思维审视题目，助力多位学员高分上岸；累计授课时长超千个小时，累计授课评分4.9分，深受学员认可；\n长期参与笔试教研工作，定期参与模拟题撰写、真题解析录制等，对最新命题方向、考试重点有深入研究；\n授课风格严谨而不乏幽默，擅长为学员量身定制有效提升解题能力的授课方案，让学员轻松掌握科目本质，目标明确针对提分。&q;,&q;avatar&q;:&q;193b4909bf0801c.jpg&q;,&q;upperBodyPhoto&q;:null,&q;displayCoursePrefix&q;:&q;sydw&q;,&q;teacherStat&q;:{&q;teacherId&q;:35908,&q;episodeCount&q;:324,&q;scoreCount&q;:674,&q;avgScore&q;:9.866468842729965,&q;fiveGradeAvgScore&q;:4.93,&q;updateTime&q;:1773546577229},&q;auditionEpisode&q;:{&q;episodeTitle&q;:&q;个人展示课&q;,&q;episodeVideoUrl&q;:&q;https://vod.fbstatic.cn/22e9ceb2vodbj1251001446/33875c205145403709543644434/6gvJN35dXAIA.mp4?t=f2a4b300&a;us=4070880000&a;sign=c135dd3259c53c86cfd11d55836ec0b2&q;},&q;memberOfCPC&q;:false,&q;tags&q;:null},&q;teachChannel&q;:1,&q;offline&q;:null,&q;duration&q;:7400,&q;hasAudition&q;:false,&q;bizType&q;:0,&q;bizId&q;:&q;726825&q;,&q;supportReplay&q;:true,&q;extraInfo&q;:null,&q;liveConfig&q;:{&q;episodeId&q;:10849371,&q;supportMultiGroup&q;:false,&q;exerciseBizType&q;:0,&q;videoDisplayType&q;:0,&q;avForwardType&q;:0,&q;useIntelligentRoom&q;:false,&q;hasStrokeKeynote&q;:true,&q;verticalModeType&q;:0,&q;originEpisodeId&q;:0,&q;supportRtmp&q;:false,&q;supportPk&q;:true,&q;supportLuckyBag&q;:true,&q;supportUserNoteStroke&q;:false,&q;communicateType&q;:0,&q;one2One&q;:false,&q;fakeLive&q;:false},&q;validStatus&q;:1,&q;supportLive&q;:true,&q;supportAiCatalog&q;:false,&q;hasIntelligentPen&q;:false,&q;useLocalRecording&q;:false,&q;useIntelligentRoom&q;:false,&q;hasSalePosition&q;:false,&q;hasEpisodeCards&q;:true,&q;lockedForShouna&q;:false,&q;needSignIn&q;:false,&q;needTeacherSignIn&q;:false,&q;enablePadPencil&q;:true,&q;displayExercise&q;:false,&q;supportLuckyBag&q;:true,&q;supportLivePk&q;:true},{&q;id&q;:10843567,&q;kePrefix&q;:&q;sydw&q;,&q;courseId&q;:6,&q;status&q;:3,&q;playStatus&q;:3,&q;type&q;:33,&q;recordingType&q;:0,&q;mediaType&q;:0,&q;title&q;:&q;【言语】精选好题 沉浸刷题&q;,&q;innerTitle&q;:&q;&q;,&q;startTime&q;:1752379200000,&q;endTime&q;:1752386400000,&q;teacher&q;:{&q;id&q;:56428,&q;userId&q;:87702759,&q;name&q;:&q;徐雨婷&q;,&q;brief&q;:&q;粉笔优质讲师&q;,&q;desc&q;:&q;粉笔优质讲师\n拥有5年的考编辅导经验，深入研究各类考编考试，熟练掌握考点与解题技巧，能够精准把握考试动态；\n多年授课经验，深耕言语类教学，长期从事相关教研工作，熟知事业单位命题格式和答题技巧；\n累计授课辅导学员近15000人，综合评分达4.95分，注重启发式引导，授课思路清晰直接，讲解细致耐心，富有亲和力。&q;,&q;avatar&q;:&q;19bbc410c81476e.jpg&q;,&q;upperBodyPhoto&q;:null,&q;displayCoursePrefix&q;:&q;sydw&q;,&q;teacherStat&q;:{&q;teacherId&q;:56428,&q;episodeCount&q;:304,&q;scoreCount&q;:866,&q;avgScore&q;:9.736720554272521,&q;fiveGradeAvgScore&q;:4.87,&q;updateTime&q;:1770692599396},&q;auditionEpisode&q;:{&q;episodeTitle&q;:&q;个人展示课&q;,&q;episodeVideoUrl&q;:&q;https://vod.fbstatic.cn/22e9ceb2vodbj1251001446/829ecf005145403709544711366/wKTZNI4y06UA.mp4?t=f2a4b300&a;us=4070880000&a;sign=50d98f18eca2d6b1d5bb116b66e23690&q;},&q;memberOfCPC&q;:false,&q;tags&q;:null},&q;teachChannel&q;:1,&q;offline&q;:null,&q;duration&q;:8435,&q;hasAudition&q;:false,&q;bizType&q;:0,&q;bizId&q;:&q;726825&q;,&q;supportReplay&q;:true,&q;extraInfo&q;:null,&q;liveConfig&q;:{&q;episodeId&q;:10843567,&q;supportMultiGroup&q;:false,&q;exerciseBizType&q;:0,&q;videoDisplayType&q;:0,&q;avForwardType&q;:0,&q;useIntelligentRoom&q;:false,&q;hasStrokeKeynote&q;:true,&q;verticalModeType&q;:0,&q;originEpisodeId&q;:0,&q;supportRtmp&q;:false,&q;supportPk&q;:true,&q;supportLuckyBag&q;:true,&q;supportUserNoteStroke&q;:false,&q;communicateType&q;:0,&q;one2One&q;:false,&q;fakeLive&q;:false},&q;validStatus&q;:1,&q;supportLive&q;:true,&q;supportAiCatalog&q;:false,&q;hasIntelligentPen&q;:false,&q;useLocalRecording&q;:false,&q;useIntelligentRoom&q;:false,&q;hasSalePosition&q;:false,&q;hasEpisodeCards&q;:true,&q;lockedForShouna&q;:false,&q;needSignIn&q;:false,&q;needTeacherSignIn&q;:false,&q;enablePadPencil&q;:true,&q;displayExercise&q;:false,&q;supportLuckyBag&q;:true,&q;supportLivePk&q;:true},{&q;id&q;:10849428,&q;kePrefix&q;:&q;sydw&q;,&q;courseId&q;:6,&q;status&q;:3,&q;playStatus&q;:3,&q;type&q;:33,&q;recordingType&q;:0,&q;mediaType&q;:0,&q;title&q;:&q;【综应】精选好题 沉浸刷题&q;,&q;innerTitle&q;:&q;&q;,&q;startTime&q;:1752458400000,&q;endTime&q;:1752465600000,&q;teacher&q;:{&q;id&q;:16894,&q;userId&q;:72656719,&q;name&q;:&q;代俊玲&q;,&q;brief&q;:&q;粉笔优质讲师&q;,&q;desc&q;:&q;粉笔优质讲师\n师范专业毕业，从事编制考试工作6年，拥有扎实的教学授课、答疑经验。\n6年带班中，一对一答疑解惑的学员2600+，深谙学员的备考心理、备考难点；因此无论在答疑还是在授课中都能快速清晰明了地解决学员的疑难点且给出有效的备考方法。\n备考不仅仅需要理论，还需要实际操作，平时喜欢研究考题，熟悉掌握全国大部分地区综应的考情和考题，积累了大量的做题的经验，做到和学员同频共振。\n累计授课时长7000+，授课通俗易懂；督学答疑打分达到5.0分，答疑具有启发性，坚持的理念就是“题目没有办法穷尽，但是我们可以用思维和技巧来覆盖”。&q;,&q;avatar&q;:&q;1746cbb834cec32.jpg&q;,&q;upperBodyPhoto&q;:null,&q;displayCoursePrefix&q;:&q;sydw&q;,&q;teacherStat&q;:{&q;teacherId&q;:16894,&q;episodeCount&q;:509,&q;scoreCount&q;:691,&q;avgScore&q;:9.777134587554272,&q;fiveGradeAvgScore&q;:4.89,&q;updateTime&q;:1773373967128},&q;auditionEpisode&q;:{&q;episodeTitle&q;:&q;个人展示课&q;,&q;episodeVideoUrl&q;:&q;https://vod.fbstatic.cn/22e9ceb2vodbj1251001446/cb018db65145403710133193708/w90mLpc9KUMA.mp4?t=f2a4b300&a;us=4070880000&a;sign=71534e640e22bf9148a2e806842810e0&q;},&q;memberOfCPC&q;:false,&q;tags&q;:null},&q;teachChannel&q;:1,&q;offline&q;:null,&q;duration&q;:7478,&q;hasAudition&q;:false,&q;bizType&q;:0,&q;bizId&q;:&q;726825&q;,&q;supportReplay&q;:true,&q;extraInfo&q;:null,&q;liveConfig&q;:{&q;episodeId&q;:10849428,&q;supportMultiGroup&q;:false,&q;exerciseBizType&q;:0,&q;videoDisplayType&q;:0,&q;avForwardType&q;:0,&q;useIntelligentRoom&q;:false,&q;hasStrokeKeynote&q;:true,&q;verticalModeType&q;:0,&q;originEpisodeId&q;:0,&q;supportRtmp&q;:false,&q;supportPk&q;:true,&q;supportLuckyBag&q;:true,&q;supportUserNoteStroke&q;:false,&q;communicateType&q;:0,&q;one2One&q;:false,&q;fakeLive&q;:false},&q;validStatus&q;:1,&q;supportLive&q;:true,&q;supportAiCatalog&q;:false,&q;hasIntelligentPen&q;:false,&q;useLocalRecording&q;:false,&q;useIntelligentRoom&q;:false,&q;hasSalePosition&q;:false,&q;hasEpisodeCards&q;:true,&q;lockedForShouna&q;:false,&q;needSignIn&q;:false,&q;needTeacherSignIn&q;:false,&q;enablePadPencil&q;:true,&q;displayExercise&q;:false,&q;supportLuckyBag&q;:true,&q;supportLivePk&q;:true},{&q;id&q;:10849450,&q;kePrefix&q;:&q;sydw&q;,&q;courseId&q;:6,&q;status&q;:3,&q;playStatus&q;:3,&q;type&q;:33,&q;recordingType&q;:0,&q;mediaType&q;:0,&q;title&q;:&q;【言语】精选好题 沉浸刷题&q;,&q;innerTitle&q;:&q;&q;,&q;startTime&q;:1752465600000,&q;endTime&q;:1752472800000,&q;teacher&q;:{&q;id&q;:16555,&q;userId&q;:73245747,&q;name&q;:&q;周俐&q;,&q;brief&q;:&q;粉笔优质讲师&q;,&q;desc&q;:&q;粉笔优质讲师\n五年半一线教学授课及带班经验，深耕事业单位言语考试，承担过安徽、四川、江苏、浙江、陕西、福建、河北、湖北、内蒙等地以及全国联考、军队文职等线上笔试精品班、刷题班、冲刺班等多种班型，累计带班级数60+授课及带班经验丰富。在言语理解与表达科目教研工作中，多次参与真题解析的撰写、解析的终审工作、模拟题命制、单题录制以及言语考情分析文件撰写等工作，面了解事业单位言语考试近年来命题规律、重难点及不同类型题目答题技巧，教研教学基础扎实。授课条理清晰，考点突出，注重理论知识点与技巧并用，经验丰富，亲和生动，学员好评度高。&q;,&q;avatar&q;:&q;198551c014a41f3.jpg&q;,&q;upperBodyPhoto&q;:null,&q;displayCoursePrefix&q;:&q;sydw&q;,&q;teacherStat&q;:{&q;teacherId&q;:16555,&q;episodeCount&q;:530,&q;scoreCount&q;:2177,&q;avgScore&q;:9.700505282498847,&q;fiveGradeAvgScore&q;:4.85,&q;updateTime&q;:1773613829705},&q;auditionEpisode&q;:{&q;episodeTitle&q;:&q;个人展示课&q;,&q;episodeVideoUrl&q;:&q;https://vod.fbstatic.cn/22e9ceb2vodbj1251001446/db6f1af21253642695732607997/uneyCgdRfuQA.mp4?t=f2a4b300&a;us=4070880000&a;sign=62a7a37a62d4578410dcec90c07ea1ce&q;},&q;memberOfCPC&q;:false,&q;tags&q;:null},&q;teachChannel&q;:1,&q;offline&q;:null,&q;duration&q;:7324,&q;hasAudition&q;:false,&q;bizType&q;:0,&q;bizId&q;:&q;726825&q;,&q;supportReplay&q;:true,&q;extraInfo&q;:null,&q;liveConfig&q;:{&q;episodeId&q;:10849450,&q;supportMultiGroup&q;:false,&q;exerciseBizType&q;:0,&q;videoDisplayType&q;:0,&q;avForwardType&q;:0,&q;useIntelligentRoom&q;:false,&q;hasStrokeKeynote&q;:true,&q;verticalModeType&q;:0,&q;originEpisodeId&q;:0,&q;supportRtmp&q;:false,&q;supportPk&q;:true,&q;supportLuckyBag&q;:true,&q;supportUserNoteStroke&q;:false,&q;communicateType&q;:0,&q;one2One&q;:false,&q;fakeLive&q;:false},&q;validStatus&q;:1,&q;supportLive&q;:true,&q;supportAiCatalog&q;:false,&q;hasIntelligentPen&q;:false,&q;useLocalRecording&q;:false,&q;useIntelligentRoom&q;:false,&q;hasSalePosition&q;:false,&q;hasEpisodeCards&q;:true,&q;lockedForShouna&q;:false,&q;needSignIn&q;:false,&q;needTeacherSignIn&q;:false,&q;enablePadPencil&q;:true,&q;displayExercise&q;:false,&q;supportLuckyBag&q;:true,&q;supportLivePk&q;:true},{&q;id&q;:10844666,&q;kePrefix&q;:&q;sydw&q;,&q;courseId&q;:6,&q;status&q;:3,&q;playStatus&q;:3,&q;type&q;:33,&q;recordingType&q;:0,&q;mediaType&q;:0,&q;title&q;:&q;【综应】精选好题 沉浸刷题&q;,&q;innerTitle&q;:&q;&q;,&q;startTime&q;:1752472800000,&q;endTime&q;:1752480000000,&q;teacher&q;:{&q;id&q;:34144,&q;userId&q;:83886683,&q;name&q;:&q;成远&q;,&q;brief&q;:&q;粉笔优质讲师&q;,&q;desc&q;:&q;粉笔优质教师\n五年一线教学授课经验 具有综应科目丰富的实践经验及系统扎实的专业理论知识，对综应考情深入研究 教学经验：多次积极参加综应科目的教研培训，对各省份综应考情进行深入研究，积累丰富的综应知识 学生口碑：授课风格细腻认真，根据学员的学习风格，灵活调整教学策略，使每位学员都能跟上课堂进度。课堂氛围轻松，能够让学员们积极参与讨论，互相分享自己的见解。与学员之间的互动频繁，学员提出的问题能够及时耐心解答。&q;,&q;avatar&q;:&q;178a5ed9b29baae.jpg&q;,&q;upperBodyPhoto&q;:null,&q;displayCoursePrefix&q;:&q;sydw&q;,&q;teacherStat&q;:{&q;teacherId&q;:34144,&q;episodeCount&q;:379,&q;scoreCount&q;:278,&q;avgScore&q;:9.812949640287767,&q;fiveGradeAvgScore&q;:4.91,&q;updateTime&q;:1773283970717},&q;auditionEpisode&q;:{&q;episodeTitle&q;:&q;个人展示课&q;,&q;episodeVideoUrl&q;:&q;https://vod.fbstatic.cn/22e9ceb2vodbj1251001446/dded7c315145403709430054231/MetXyTQDR9MA.mp4?t=f2a4b300&a;us=4070880000&a;sign=5cfd13ce7c9af3e4a44ad6a7c92fffaa&q;},&q;memberOfCPC&q;:false,&q;tags&q;:null},&q;teachChannel&q;:1,&q;offline&q;:null,&q;duration&q;:9819,&q;hasAudition&q;:false,&q;bizType&q;:0,&q;bizId&q;:&q;726825&q;,&q;supportReplay&q;:true,&q;extraInfo&q;:null,&q;liveConfig&q;:{&q;episodeId&q;:10844666,&q;supportMultiGroup&q;:false,&q;exerciseBizType&q;:0,&q;videoDisplayType&q;:0,&q;avForwardType&q;:0,&q;useIntelligentRoom&q;:false,&q;hasStrokeKeynote&q;:true,&q;verticalModeType&q;:0,&q;originEpisodeId&q;:0,&q;supportRtmp&q;:false,&q;supportPk&q;:true,&q;supportLuckyBag&q;:true,&q;supportUserNoteStroke&q;:false,&q;communicateType&q;:0,&q;one2One&q;:false,&q;fakeLive&q;:false},&q;validStatus&q;:1,&q;supportLive&q;:true,&q;supportAiCatalog&q;:false,&q;hasIntelligentPen&q;:false,&q;useLocalRecording&q;:false,&q;useIntelligentRoom&q;:false,&q;hasSalePosition&q;:false,&q;hasEpisodeCards&q;:true,&q;lockedForShouna&q;:false,&q;needSignIn&q;:false,&q;needTeacherSignIn&q;:false,&q;enablePadPencil&q;:true,&q;displayExercise&q;:false,&q;supportLuckyBag&q;:true,&q;supportLivePk&q;:true},{&q;id&q;:10849572,&q;kePrefix&q;:&q;sydw&q;,&q;courseId&q;:6,&q;status&q;:3,&q;playStatus&q;:3,&q;type&q;:33,&q;recordingType&q;:0,&q;mediaType&q;:0,&q;title&q;:&q;【数资】精选好题 沉浸刷题&q;,&q;innerTitle&q;:&q;&q;,&q;startTime&q;:1752480000000,&q;endTime&q;:1752487200000,&q;teacher&q;:{&q;id&q;:16574,&q;userId&q;:73028298,&q;name&q;:&q;廖雅云&q;,&q;brief&q;:&q;粉笔优质讲师&q;,&q;desc&q;:&q;粉笔优质讲师\n多年一线教学授课经验，深耕事业单位考试，承担过笔试精品班、刷题班、冲刺班等多种班型,授课经验丰富。\n深入了解职测数资近年来的考情、重难点以及不同考点的解题技巧，理论扎实。\n参与笔试真题教研和解析撰写、终审工作,并多次参与图书以及相关资料的编写，对数资最新命题趋势方向有深入研究；\n多次参加粉笔授课研讨会议，针对学生困惑研究教学策略，拓展考场思维，能够帮助学员将所学理论更好应用在实际解题当中，拓展解题思路；\n授课风格:授课累计评分达4.9分，讲课耐心细致，课堂氛围轻松活跃，与学员重在沟通，能够从学员角度出发去找问题、解决问题，深受学员的喜爱。&q;,&q;avatar&q;:&q;19854f590ec1eda.jpg&q;,&q;upperBodyPhoto&q;:null,&q;displayCoursePrefix&q;:&q;sydw&q;,&q;teacherStat&q;:{&q;teacherId&q;:16574,&q;episodeCount&q;:739,&q;scoreCount&q;:6952,&q;avgScore&q;:9.825373993095512,&q;fiveGradeAvgScore&q;:4.91,&q;updateTime&q;:1773622398088},&q;auditionEpisode&q;:{&q;episodeTitle&q;:&q;个人展示课&q;,&q;episodeVideoUrl&q;:&q;https://vod.fbstatic.cn/22e9ceb2vodbj1251001446/725c3a375145403709544020247/E4rt1kFdZL4A.mp4?t=f2a4b300&a;us=4070880000&a;sign=423b76444fe4ed707f565354eef136e2&q;},&q;memberOfCPC&q;:false,&q;tags&q;:null},&q;teachChannel&q;:1,&q;offline&q;:null,&q;duration&q;:9662,&q;hasAudition&q;:false,&q;bizType&q;:0,&q;bizId&q;:&q;726825&q;,&q;supportReplay&q;:true,&q;extraInfo&q;:null,&q;liveConfig&q;:{&q;episodeId&q;:10849572,&q;supportMultiGroup&q;:false,&q;exerciseBizType&q;:0,&q;videoDisplayType&q;:0,&q;avForwardType&q;:0,&q;useIntelligentRoom&q;:false,&q;hasStrokeKeynote&q;:true,&q;verticalModeType&q;:0,&q;originEpisodeId&q;:0,&q;supportRtmp&q;:false,&q;supportPk&q;:true,&q;supportLuckyBag&q;:true,&q;supportUserNoteStroke&q;:false,&q;communicateType&q;:0,&q;one2One&q;:false,&q;fakeLive&q;:false},&q;validStatus&q;:1,&q;supportLive&q;:true,&q;supportAiCatalog&q;:false,&q;hasIntelligentPen&q;:false,&q;useLocalRecording&q;:false,&q;useIntelligentRoom&q;:false,&q;hasSalePosition&q;:false,&q;hasEpisodeCards&q;:true,&q;lockedForShouna&q;:false,&q;needSignIn&q;:false,&q;needTeacherSignIn&q;:false,&q;enablePadPencil&q;:true,&q;displayExercise&q;:false,&q;supportLuckyBag&q;:true,&q;supportLivePk&q;:true},{&q;id&q;:10849573,&q;kePrefix&q;:&q;sydw&q;,&q;courseId&q;:6,&q;status&q;:3,&q;playStatus&q;:3,&q;type&q;:33,&q;recordingType&q;:0,&q;mediaType&q;:0,&q;title&q;:&q;【综应】精选好题 沉浸刷题&q;,&q;innerTitle&q;:&q;&q;,&q;startTime&q;:1752544800000,&q;endTime&q;:1752552000000,&q;teacher&q;:{&q;id&q;:35903,&q;userId&q;:72269679,&q;name&q;:&q;曲源&q;,&q;brief&q;:&q;粉笔优质讲师&q;,&q;desc&q;:&q;粉笔优质讲师\n6年一线教学经验，累计服务学员近千人，累计评分4.9分，承担过线上和线下系统班、冲刺班、刷题班等多种班型，累计授课时长超1200小时。\n笔试授课和教研经验丰富。长期参与综应真题教研与撰写答案解析工作，对最新命题方向具有深入研究，具备丰富的知识储备，理论功底扎实。\n授课思路清晰善于调动课堂氛围,幽默风趣，激发学员学习兴趣。同时,具有较强研发能力和责任心，坚持课上精准指导，课后心理疏导，因材施教，深受学员喜爱。&q;,&q;avatar&q;:&q;193cd4344de169d.jpg&q;,&q;upperBodyPhoto&q;:null,&q;displayCoursePrefix&q;:&q;sydw&q;,&q;teacherStat&q;:{&q;teacherId&q;:35903,&q;episodeCount&q;:311,&q;scoreCount&q;:744,&q;avgScore&q;:9.78494623655914,&q;fiveGradeAvgScore&q;:4.89,&q;updateTime&q;:1773577783468},&q;auditionEpisode&q;:{&q;episodeTitle&q;:&q;个人展示课&q;,&q;episodeVideoUrl&q;:&q;https://vod.fbstatic.cn/22e9ceb2vodbj1251001446/72602ee15145403709544027961/PagTAbrHihoA.mp4?t=f2a4b300&a;us=4070880000&a;sign=d64222f31d058dfe1c94af887873312d&q;},&q;memberOfCPC&q;:false,&q;tags&q;:null},&q;teachChannel&q;:1,&q;offline&q;:null,&q;duration&q;:7187,&q;hasAudition&q;:false,&q;bizType&q;:0,&q;bizId&q;:&q;726825&q;,&q;supportReplay&q;:true,&q;extraInfo&q;:null,&q;liveConfig&q;:{&q;episodeId&q;:10849573,&q;supportMultiGroup&q;:false,&q;exerciseBizType&q;:0,&q;videoDisplayType&q;:0,&q;avForwardType&q;:0,&q;useIntelligentRoom&q;:false,&q;hasStrokeKeynote&q;:true,&q;verticalModeType&q;:0,&q;originEpisodeId&q;:0,&q;supportRtmp&q;:false,&q;supportPk&q;:true,&q;supportLuckyBag&q;:true,&q;supportUserNoteStroke&q;:false,&q;communicateType&q;:0,&q;one2One&q;:false,&q;fakeLive&q;:false},&q;validStatus&q;:1,&q;supportLive&q;:true,&q;supportAiCatalog&q;:false,&q;hasIntelligentPen&q;:false,&q;useLocalRecording&q;:false,&q;useIntelligentRoom&q;:false,&q;hasSalePosition&q;:false,&q;hasEpisodeCards&q;:true,&q;lockedForShouna&q;:false,&q;needSignIn&q;:false,&q;needTeacherSignIn&q;:false,&q;enablePadPencil&q;:true,&q;displayExercise&q;:false,&q;supportLuckyBag&q;:true,&q;supportLivePk&q;:true},{&q;id&q;:10849575,&q;kePrefix&q;:&q;sydw&q;,&q;courseId&q;:6,&q;status&q;:3,&q;playStatus&q;:3,&q;type&q;:33,&q;recordingType&q;:0,&q;mediaType&q;:0,&q;title&q;:&q;【言语】精选好题 沉浸刷题&q;,&q;innerTitle&q;:&q;&q;,&q;startTime&q;:1752552000000,&q;endTime&q;:1752559200000,&q;teacher&q;:{&q;id&q;:56429,&q;userId&q;:74160353,&q;name&q;:&q;邱宜静&q;,&q;brief&q;:&q;粉笔优质讲师&q;,&q;desc&q;:&q;粉笔优质教师\n五年一线教学授课经验，长期致力于事业单位考试研究与教学，对事业单位招聘考试体系有着深入的理解和扎实的教学经验。\n具有言语科目丰富的实践经验及系统扎实的专业理论知识和对事业单位言语考情的深入研究:\n多次参与笔试真题教研和解析撰写工作，对言语命题趋势方向有着深入的研究;\n多次参加粉笔授课研讨会议，深入研讨事考言语命题趋势及最新考情;\n授课特点:擅长将复杂的知识点转化为易于理解的教学内容，通过循序渐进的教学方式，引导学生逐步掌握所需的知识点，帮助学员快速掌握言语科目的核心要点，提升解题能力和应试技巧，成功帮助数百名考生顺利通过事业单位招聘考试。&q;,&q;avatar&q;:&q;18408e0ee9a5e5d.jpg&q;,&q;upperBodyPhoto&q;:null,&q;displayCoursePrefix&q;:&q;sydw&q;,&q;teacherStat&q;:{&q;teacherId&q;:56429,&q;episodeCount&q;:185,&q;scoreCount&q;:627,&q;avgScore&q;:9.763955342902712,&q;fiveGradeAvgScore&q;:4.88,&q;updateTime&q;:1773327807084},&q;auditionEpisode&q;:{&q;episodeTitle&q;:&q;个人展示课&q;,&q;episodeVideoUrl&q;:&q;https://vod.fbstatic.cn/22e9ceb2vodbj1251001446/cfc0c3501253642695688501785/bsDyySXGJLgA.mp4?t=f2a4b300&a;us=4070880000&a;sign=41a1d807640af0e9a33d92a3917850c4&q;},&q;memberOfCPC&q;:false,&q;tags&q;:null},&q;teachChannel&q;:1,&q;offline&q;:null,&q;duration&q;:8561,&q;hasAudition&q;:false,&q;bizType&q;:0,&q;bizId&q;:&q;726825&q;,&q;supportReplay&q;:true,&q;extraInfo&q;:null,&q;liveConfig&q;:{&q;episodeId&q;:10849575,&q;supportMultiGroup&q;:false,&q;exerciseBizType&q;:0,&q;videoDisplayType&q;:0,&q;avForwardType&q;:0,&q;useIntelligentRoom&q;:false,&q;hasStrokeKeynote&q;:true,&q;verticalModeType&q;:0,&q;originEpisodeId&q;:0,&q;supportRtmp&q;:false,&q;supportPk&q;:true,&q;supportLuckyBag&q;:true,&q;supportUserNoteStroke&q;:false,&q;communicateType&q;:0,&q;one2One&q;:false,&q;fakeLive&q;:false},&q;validStatus&q;:1,&q;supportLive&q;:true,&q;supportAiCatalog&q;:false,&q;hasIntelligentPen&q;:false,&q;useLocalRecording&q;:false,&q;useIntelligentRoom&q;:false,&q;hasSalePosition&q;:false,&q;hasEpisodeCards&q;:true,&q;lockedForShouna&q;:false,&q;needSignIn&q;:false,&q;needTeacherSignIn&q;:false,&q;enablePadPencil&q;:true,&q;displayExercise&q;:false,&q;supportLuckyBag&q;:true,&q;supportLivePk&q;:true},{&q;id&q;:10849662,&q;kePrefix&q;:&q;sydw&q;,&q;courseId&q;:6,&q;status&q;:3,&q;playStatus&q;:3,&q;type&q;:33,&q;recordingType&q;:0,&q;mediaType&q;:0,&q;title&q;:&q;【公基非法】精选好题 沉浸刷题&q;,&q;innerTitle&q;:&q;&q;,&q;startTime&q;:1752559200000,&q;endTime&q;:1752566400000,&q;teacher&q;:{&q;id&q;:18292,&q;userId&q;:64594928,&q;name&q;:&q;户春月&q;,&q;brief&q;:&q;粉笔优质讲师&q;,&q;desc&q;:&q;粉笔优质讲师\n具有6年常识公基非法学科授课及督学经验，授课评分4.9。\n具有常识公基非法科目扎实理论基础，对全国各地考情有充分的了解。曾参与粉笔模拟题、教研文章等撰写工作，具有考场思维以及丰富的笔试答题经验。通过近年的督学工作，积累了丰富的个性化辅导经验，会根据学员的学习风格和学习目标，调整教学内容和方法。\n在教学中，擅长将抽象的专业知识转化为生动有趣的案例，引导学员深入理解。在讲解复杂知识点时，通过引入具体案例，让学员可以轻松掌握了该知识点的核心，教学效果显著。&q;,&q;avatar&q;:&q;1983b73707f7b5b.jpg&q;,&q;upperBodyPhoto&q;:null,&q;displayCoursePrefix&q;:&q;sydw&q;,&q;teacherStat&q;:{&q;teacherId&q;:18292,&q;episodeCount&q;:852,&q;scoreCount&q;:1699,&q;avgScore&q;:9.878752207180701,&q;fiveGradeAvgScore&q;:4.94,&q;updateTime&q;:1773573836788},&q;auditionEpisode&q;:{&q;episodeTitle&q;:&q;个人展示课&q;,&q;episodeVideoUrl&q;:&q;https://vod.fbstatic.cn/22e9ceb2vodbj1251001446/800f0cec5145403709537874267/DEgQJna6VSoA.mp4?t=f2a4b300&a;us=4070880000&a;sign=f2f66baef1eb0ec074e19dd7713d70ab&q;},&q;memberOfCPC&q;:false,&q;tags&q;:null},&q;teachChannel&q;:1,&q;offline&q;:null,&q;duration&q;:7406,&q;hasAudition&q;:false,&q;bizType&q;:0,&q;bizId&q;:&q;726825&q;,&q;supportReplay&q;:true,&q;extraInfo&q;:null,&q;liveConfig&q;:{&q;episodeId&q;:10849662,&q;supportMultiGroup&q;:false,&q;exerciseBizType&q;:0,&q;videoDisplayType&q;:0,&q;avForwardType&q;:0,&q;useIntelligentRoom&q;:false,&q;hasStrokeKeynote&q;:true,&q;verticalModeType&q;:0,&q;originEpisodeId&q;:0,&q;supportRtmp&q;:false,&q;supportPk&q;:true,&q;supportLuckyBag&q;:true,&q;supportUserNoteStroke&q;:false,&q;communicateType&q;:0,&q;one2One&q;:false,&q;fakeLive&q;:false},&q;validStatus&q;:1,&q;supportLive&q;:true,&q;supportAiCatalog&q;:false,&q;hasIntelligentPen&q;:false,&q;useLocalRecording&q;:false,&q;useIntelligentRoom&q;:false,&q;hasSalePosition&q;:false,&q;hasEpisodeCards&q;:true,&q;lockedForShouna&q;:false,&q;needSignIn&q;:false,&q;needTeacherSignIn&q;:false,&q;enablePadPencil&q;:true,&q;displayExercise&q;:false,&q;supportLuckyBag&q;:true,&q;supportLivePk&q;:true},{&q;id&q;:10849664,&q;kePrefix&q;:&q;sydw&q;,&q;courseId&q;:6,&q;status&q;:3,&q;playStatus&q;:3,&q;type&q;:33,&q;recordingType&q;:0,&q;mediaType&q;:0,&q;title&q;:&q;【数资】精选好题 沉浸刷题&q;,&q;innerTitle&q;:&q;&q;,&q;startTime&q;:1752566400000,&q;endTime&q;:1752573600000,&q;teacher&q;:{&q;id&q;:21457,&q;userId&q;:52931102,&q;name&q;:&q;罗亚君&q;,&q;brief&q;:&q;粉笔优质讲师&q;,&q;desc&q;:&q;粉笔优质讲师\n过往授课经验：曾参加过数次笔试面试实战考试，多年笔试授课经验。\n累计授课时长1000+,累计授课人数10000+人次，累计评分9.8分以上。\n对事考、军队文职、三支一扶等考情深入研究，取得良好的教研成果；在考试中所授课学员取得优异成绩；多次参加粉笔授课研讨会议，全面把握笔试考试命题趋势及最新考情，积累丰富面试知识；多次参加粉笔教研活动，分享授课经验心得，助力粉笔理论研发升级。\n授课幽默诙谐、形象生动、条理清晰，让学生在轻松的学习氛围中，用更简单的方法，找到更快捷的解题之道，深受广大学员的认可和好评。&q;,&q;avatar&q;:&q;1965cd13968c972.jpg&q;,&q;upperBodyPhoto&q;:null,&q;displayCoursePrefix&q;:&q;sydw&q;,&q;teacherStat&q;: