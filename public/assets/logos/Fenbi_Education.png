oreCount&q;:253,&q;avgScore&q;:9.794466403162055,&q;fiveGradeAvgScore&q;:4.9,&q;updateTime&q;:1773542090440},&q;auditionEpisode&q;:null,&q;memberOfCPC&q;:false,&q;tags&q;:null},&q;teachChannel&q;:1,&q;offline&q;:null,&q;duration&q;:6715,&q;hasAudition&q;:false,&q;bizType&q;:0,&q;bizId&q;:&q;726825&q;,&q;supportReplay&q;:true,&q;extraInfo&q;:null,&q;liveConfig&q;:{&q;episodeId&q;:11000053,&q;supportMultiGroup&q;:false,&q;exerciseBizType&q;:0,&q;videoDisplayType&q;:0,&q;avForwardType&q;:0,&q;useIntelligentRoom&q;:false,&q;hasStrokeKeynote&q;:true,&q;verticalModeType&q;:0,&q;originEpisodeId&q;:0,&q;supportRtmp&q;:false,&q;supportPk&q;:true,&q;supportLuckyBag&q;:true,&q;supportUserNoteStroke&q;:false,&q;communicateType&q;:0,&q;one2One&q;:false,&q;fakeLive&q;:false},&q;validStatus&q;:1,&q;supportLive&q;:true,&q;supportAiCatalog&q;:false,&q;hasIntelligentPen&q;:false,&q;useLocalRecording&q;:false,&q;useIntelligentRoom&q;:false,&q;hasSalePosition&q;:false,&q;hasEpisodeCards&q;:true,&q;lockedForShouna&q;:false,&q;needSignIn&q;:false,&q;needTeacherSignIn&q;:false,&q;enablePadPencil&q;:true,&q;displayExercise&q;:false,&q;supportLuckyBag&q;:true,&q;supportLivePk&q;:true},{&q;id&q;:11001114,&q;kePrefix&q;:&q;sydw&q;,&q;courseId&q;:6,&q;status&q;:3,&q;playStatus&q;:3,&q;type&q;:33,&q;recordingType&q;:0,&q;mediaType&q;:0,&q;title&q;:&q;【综应】精选好题 沉浸刷题&q;,&q;innerTitle&q;:&q;&q;,&q;startTime&q;:1757916000000,&q;endTime&q;:1757923200000,&q;teacher&q;:{&q;id&q;:16967,&q;userId&q;:73695412,&q;name&q;:&q;周雯&q;,&q;brief&q;:&q;粉笔优质讲师&q;,&q;desc&q;:&q;粉笔优质教师\n六年事考、公考教学经验，累计授课时长1000+，授课经验丰富，教研教学扎实，全面了解事业单位综合应用能力考试的命题规律及答题技巧，授课重点突出，能及时总结拓展，讲解语言通俗易懂。课堂氛围轻松活跃，擅长引导学生自主思考，能够在课堂互动中发现学员的问题并给出针对性的解决措施，对待学生认真负责、有耐心，深受学生喜爱。&q;,&q;avatar&q;:&q;17549fe18ee3d2f.jpg&q;,&q;upperBodyPhoto&q;:null,&q;displayCoursePrefix&q;:&q;sydw&q;,&q;teacherStat&q;:{&q;teacherId&q;:16967,&q;episodeCount&q;:453,&q;scoreCount&q;:481,&q;avgScore&q;:9.817047817047817,&q;fiveGradeAvgScore&q;:4.91,&q;updateTime&q;:177310354364