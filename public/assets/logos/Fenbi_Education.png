nablePadPencil&q;:true,&q;displayExercise&q;:false,&q;supportLuckyBag&q;:true,&q;supportLivePk&q;:true},{&q;id&q;:10771528,&q;kePrefix&q;:&q;sydw&q;,&q;courseId&q;:6,&q;status&q;:3,&q;playStatus&q;:3,&q;type&q;:33,&q;recordingType&q;:0,&q;mediaType&q;:0,&q;title&q;:&q;【公基法律】精选好题 沉浸刷题&q;,&q;innerTitle&q;:&q;&q;,&q;startTime&q;:1749009600000,&q;endTime&q;:1749016800000,&q;teacher&q;:{&q;id&q;:33438,&q;userId&q;:51475986,&q;name&q;:&q;白景明&q;,&q;brief&q;:&q;粉笔优质讲师&q;,&q;desc&q;:&q;粉笔常识公基优质教师\n      5年一线授课经验，具有事业单位考试丰富的实践经验及系统扎实的专业理论知识。个性热情开朗，善于营造积极向上、充满活力的课堂氛围。始终保持耐心细致的态度，无论是对基础知识的讲解还是针对复杂题型的解析，都能深入浅出，确保每位学员都能跟上节奏，消化吸收。授课逻辑严密，内容条理，思路清晰明了，帮助学员构建起坚实的知识框架，深受学员好评。&q;,&q;avatar&q;:&q;1965cdb4f4e6ff3.jpg&q;,&q;upperBodyPhoto&q;:null,&q;displayCoursePrefix&q;:&q;sydw&q;,&q;teacherStat&q;:{&q;teacherId&q;:33438,&q;episodeCount&q;:629,&q;scoreCount&q;:1064,&q;avgScore&q;:9.744360902255647,&q;fiveGradeAvgScore&q;:4.87,&q;updateTime&q;:1773306736144},&q;auditionEpisode&q;:{&q;episodeTitle&q;:&q;个人展示课&q;,&q;episodeVideoUrl&q;:&q;https://vod.fbstatic.cn/22e9ceb2vodbj1251001446/5a2fa8c05145403707364076346/qCxnz3H1QbYA.mp4?t=f2a4b300&a;us=4070880000&a;sign=69c46a19011c3aeb0a079e1e2363c676&q;},&q;memberOfCPC&q;:false,&q;tags&q;:null},&q;teachChannel&q;:1,&q;offline&q;:null,&q;duration&q;:7683,&q;hasAudition&q;:false,&q;bizType&q;:0,&q;bizId&q;:&q;726825&q;,&q;supportReplay&q;:true,&q;extraInfo&q;:null,&q;liveConfig&q;:{&q;episodeId&q;:10771528,&q;supportMultiGroup&q;:false,&q;exerciseBizType&q;:0,&q;videoDisplayType&q;:0,&q;avForwardType&q;:0,&q;useIntelligentRoom&q;:false,&q;hasStrokeKeynote&q;:true,&q;verticalModeType&q;:0,&q;originEpisodeId&q;:0,&q;supportRtmp&q;:false,&q;supportPk&q;:true,&q;supportLuckyBag&q;:true,&q;supportUserNoteStroke&q;:false,&q;communicateType&q;:0,&q;one2One&q;:false,&q;fakeLive&q;:false},&q;validStatus&q;:1,&q;supportLive&q;:true,&q;supportAiCatalog&q;:false,&q;hasIntelligentPen&q;:false,&q;useLocalRecording&q;:false,&q;useIntelligentRoom&q;:false,&q;hasSa