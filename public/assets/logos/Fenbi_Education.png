pdateTime&q;:1773619984052},&q;auditionEpisode&q;:{&q;episodeTitle&q;:&q;个人展示课&q;,&q;episodeVideoUrl&q;:&q;https://vod.fbstatic.cn/22e9ceb2vodbj1251001446/e9d708e03560136621448419516/mQaYrVTtQNwA.mp4?t=f2a4b300&a;us=4070880000&a;sign=564c448672d97809fd0ccf050a169884&q;},&q;memberOfCPC&q;:false,&q;tags&q;:null},{&q;id&q;:6261,&q;userId&q;:61945679,&q;name&q;:&q;刘大娥&q;,&q;brief&q;:&q;粉笔数资优质教师&q;,&q;desc&q;:&q;粉笔数资优质教师，11年公考授课经验，致力于公务员考试研究，对试题有深刻的把握和独到的见解。注重因材施教，善于引导启发思维，让学生能轻松上手，掌握不同类型题目的应试技巧。授课条理清晰，富有激情又不失幽默，课堂氛围活跃，细心，耐心，有责任心，深受学员好评。&q;,&q;avatar&q;:&q;171831baa78157d.png&q;,&q;upperBodyPhoto&q;:null,&q;displayCoursePrefix&q;:&q;gwy&q;,&q;teacherStat&q;:{&q;teacherId&q;:6261,&q;episodeCount&q;:1042,&q;scoreCount&q;:126302,&q;avgScore&q;:9.80605216069421,&q;fiveGradeAvgScore&q;:4.9,&q;updateTime&q;:1773622357767},&q;auditionEpisode&q;:{&q;episodeTitle&q;:&q;个人展示课&q;,&q;episodeVideoUrl&q;:&q;https://vod.fbstatic.cn/22e9ceb2vodbj1251001446/ef0e552f3560136621448692888/BxCPeS7tZkUA.mp4?t=f2a4b300&a;us=4070880000&a;sign=a8a518156c1d39b0052ef2e0c79abc4e&q;},&q;memberOfCPC&q;:false,&q;tags&q;:null},{&q;id&q;:104,&q;userId&q;:4835461,&q;name&q;:&q;张跃瀚&q;,&q;brief&q;:&q;粉笔申论优质教师&q;,&q;desc&q;:&q;粉笔申论优质教师，教研负责人，毕业于中国政法大学。 \n15年公考培训经验，学员评分高达4.9分，被学员亲切地称为“瀚叔”。 \n授课系统性、严谨性和逻辑性并重，深入浅出、脉络清晰，既能充分挖掘材料细节，又善于从宏观角度架构解题思路。被考生认为是接地气与高大上的完美结合，效率与效果俱佳。 \n2014年进入粉笔团队，负责申论学科的教学教研工作，主持申论新手特训营、申论小题精训、作文精训等产品的开发，统筹申论智能批改、申论模考等多个申论核心产品，组织编写多部申论图书。 &q;,&q;avatar&q;:&q;15161c629f4a31f.jpg&q;,&q;upperBodyPhoto&q;:null,&q;displayCoursePrefix&q;:&q;gwy&q;,&q;teacherStat&q;:{&q;teacherId&q;:104,&q;episodeCount&q;:1280,&q;scoreCount&q;:419528,&q;avgScore&q;:9.77153849087548,&q;fiveGradeAvgScore&q;:4.89,&q;updateTime&q;:1773589586792},&q;auditionEpisode&q;:null,&q;memberOfCPC&q;:false,&q;tags&q;:null},{&q;id&q;:2774,&q;userId&q;:28109961,&q;name&q;:&q;魏倩&q;,&q;brief&q;:&q;粉笔判断优质教师&q;,&q;desc&q;:&q;粉笔判断优质教师， 9年授课经验，长期致力于公务员考试研究，具有扎实的专业理论知识，严谨的授课思维，善于引导学员思路，总结做题方法，认真负责，细致耐心，帮助学员触类旁通，让学员在轻松愉快的氛围中掌握解题技巧。 \n参与各类授课研讨会议和教研活动，参与编写《行测的思维》《专项题集》等多套图书。 &q;,&q;avatar&q;:&q;171a64f9a5acea6.jpg&q;,&q;upperBodyPhoto&q;:null,&q;displayCoursePrefix&q;:&q;gwy&q;,&q;teacherStat&q;:{&q;teacherId&q;:2774,&q;episodeCount&q;:1189,&q;scoreCount&q;:343403,&q;avgScore&q;:9.776233754510049,&q;fiveGradeAvgScore&q;:4.89,&q;updateTime&q;:1773587098907},&q;auditionEpisode&q;:{&q;episodeTitle&q;:&q;个人展示课&q;,&q;episodeVideoUrl&q;:&q;https://vod.fbstatic.cn/22e9ceb2vodbj1251001446/9cc905d93560136621447406307/DEgSjqlUU9IA.mp4?t=f2a4b300&a;us=4070880000&a;sign=64520ebea0bb372ee32fddb86886973a&q;},&q;memberOfCPC&q;:false,&q;tags&q;:null},{&q;id&q;:1619,&q;userId&q;:40623880,&q;name&q;:&q;杨爽&q;,&q;brief&q;:&q;粉笔申论优质教师&q;,&q;desc&q;:&q;粉笔申论优质教师，十年公考授课经验。思维严谨缜密，授课逻辑清晰，善于进行写作方法指导，旨在通过一道题帮助学生解决一类题。 心理学专业毕业，面对考试压力环境，能够指导学生有效排解焦虑情绪，树立答题信心。&q;,&q;avatar&q;:&q;1927e97f97f2d5b.jpg&q;,&q;upperBodyPhoto&q;:null,&q;displayCoursePrefix&q;:&q;gwy&q;,&q;teacherStat&q;:{&q;teacherId&q;:1619,&q;episodeCount&q;:1989,&q;scoreCount&q;:21714,&q;avgScore&q;:9.866998249976952,&q;fiveGradeAvgScore&q;:4.93,&q;updateTime&q;:1773592532218},&q;auditionEpisode&q;:{&q;episodeTitle&q;:&q;个人展示课&q;,&q;episodeVideoUrl&q;:&q;https://vod.fbstatic.cn/22e9ceb2vodbj1251001446/bee80dbe1397757891881287347/jkONAupEhr0A.mp4?t=f2a4b300&a;us=4070880000&a;sign=5662af5b78222cfc97db6a9867ac02fc&q;},&q;memberOfCPC&q;:false,&q;tags&q;:null},{&q;id&q;:247,&q;userId&q;:926505,&q;name&q;:&q;宋文涛&q;,&q;brief&q;:&q;粉笔判断优质教师&q;,&q;desc&q;:&q;粉笔判断优质教师，硕士研究生。\n14年授课经验，累计授课时长超过20000小时。长期致力于公务员考试研究，对判断推理试题有深刻的把握和独到的见解。深刻了解学员的痛点难点，授课深入浅出，注重因材施教，语言通俗易懂，善于引导式教学，让学生在思考中真正将方法内化于心，深受学员好评。&q;,&q;avatar&q;:&q;1516a6f0b36a6bb.jpg&q;,&q;upperBodyPhoto&q;:null,&q;displayCoursePrefix&q;:&q;gwy&q;,&q;teacherStat&q;:{&q;teacherId&q;:247,&q;episodeCount&q;:1434,&q;scoreCount&q;:1011124,&q;avgScore&q;:9.74495314125666,&q;fiveGradeAvgScore&q;:4.87,&q;updateTime&q;:1773593974177},&q;auditionEpisode&q;:{&q;episodeTitle&q;:&q;个人展示课&q;,&q;episodeVideoUrl&q;:&q;https://vod.fbstatic.cn/22e9ceb2vodbj1251001446/94051f7f3560136621447086156/GBVB9UAAPakA.mp4?t=f2a4b300&a;us=4070880000&a;sign=f942a92a070dd34d6bbca7be5fb4e76d&q;},&q;memberOfCPC&q;:false,&q;tags&q;:null},{&q;id&q;:1576,&q;userId&q;:41884178,&q;name&q;:&q;张小飞&q;,&q;brief&q;:&q;粉笔数资优质教师&q;,&q;desc&q;:&q;粉笔数资优质教师，985硕士研究生。12年公考授课经验，累计授课时长超过5000小时，培训学员超过70万人次。长期在数资模块的教研教学一线，专业知识扎实，经验丰富。授课思路清晰、逻辑严谨，讲解细致全面、循循善诱，注重培养学生的思考能力。&q;,&q;avatar&q;:&q;1582e76375670dd.jpg&q;,&q;upperBodyPhoto&q;:null,&q;displayCoursePrefix&q;:&q;gwy&q;,&q;teacherStat&q;:{&q;teacherId&q;:1576,&q;episodeCount&q;:1281,&q;scoreCount&q;:194309,&q;avgScore&q;:9.781327679109058,&q;fiveGradeAvgScore&q;:4.89,&q;updateTime&q;:1773623310346},&q;auditionEpisode&q;:{&q;episodeTitle&q;:&q;个人展示课&q;,&q;episodeVideoUrl&q;:&q;https://vod.fbstatic.cn/22e9ceb2vodbj1251001446/a432f2e43560136621447762754/LVYCqVy94ZAA.mp4?t=f2a4b300&a;us=4070880000&a;sign=0a8aa8c2cbbe95df3980acde39801ed9&q;},&q;memberOfCPC&q;:false,&q;tags&q;:null},{&q;id&q;:2558,&q;userId&q;:39578390,&q;name&q;:&q;蒋君&q;,&q;brief&q;:&q;粉笔数资优质教师&q;,&q;desc&q;:&q;粉笔数资优质教师，数学专业硕士，12年公考培训经验，对考点熟悉理论扎实。授课注重因材施教，追求讲解深入浅出易于理解，并在授课过程注重互动与引导，从学生角度发现解题误区与思维盲点，有针对性的解决问题。&q;,&q;avatar&q;:&q;1717d3fbc84acec.jpg&q;,&q;upperBodyPhoto&q;:null,&q;displayCoursePrefix&q;:&q;gwy&q;,&q;teacherStat&q;:{&q;teacherId&q;:2558,&q;episodeCount&q;:1349,&q;scoreCount&q;:136512,&q;avgScore&q;:9.78895628223158,&q;fiveGradeAvgScore&q;:4.89,&q;updateTime&q;:1773585312206},&q;auditionEpisode&q;:{&q;episodeTitle&q;:&q;个人展示课&q;,&q;episodeVideoUrl&q;:&q;https://vod.fbstatic.cn/22e9ceb2vodbj1251001446/ec4fc5613560136621448538137/tazwXF3NjEIA.mp4?t=f2a4b300&a;us=4070880000&a;sign=03973b3208fabc5b14e9f815e00117c3&q;},&q;memberOfCPC&q;:false,&q;tags&q;:null},{&q;id&q;:35047,&q;userId&q;:80612953,&q;name&q;:&q;果晨竹&q;,&q;brief&q;:&q;粉笔申论优质教师&q;,&q;desc&q;:&q;粉笔申论优质教师。\n9年公考培训经验，始终坚持一线授课，经验丰富。授课风格轻松愉悦，善于调动学员情绪。逻辑性强，强调实战思维，善于总结技巧和问题，举一反三，深受学员好评。&q;,&q;avatar&q;:&q;1928e17d6cb242c.jpg&q;,&q;upperBodyPhoto&q;:null,&q;displayCoursePrefix&q;:&q;gwy&q;,&q;teacherStat&q;:{&q;teacherId&q;:35047,&q;episodeCount&q;:1256,&q;scoreCount&q;:7284,&q;avgScore&q;:9.90691927512355,&q;fiveGradeAvgScore&q;:4.95,&q;updateTime&q;:1773574137706},&q;auditionEpisode&q;:{&q;episodeTitle&q;:&q;个人展示课&q;,&q;episodeVideoUrl&q;:&q;https://vod.fbstatic.cn/22e9ceb2vodbj1251001446/40e306971397757891879500543/WsGldFpug6oA.mp4?t=f2a4b300&a;us=4070880000&a;sign=fec470eb19f8df64cefa89fc43f6a930&q;},&q;memberOfCPC&q;:false,&q;tags&q;:null},{&q;id&q;:2323,&q;userId&q;:31774545,&q;name&q;:&q;程梓&q;,&q;brief&q;:&q;粉笔数资优质教师&q;,&q;desc&q;:&q;粉笔数资优质教师，211理工科大学硕士毕业。 \n8年授课经验，服务学员众多。专业功底扎实，授课风格严谨又不失幽默。擅于引导学员积极思考，能够让同学们在轻松有趣的氛围里掌握知识点，构建完整的知识框架。是学员公考路上的良师益友。 \n积极参与各类培训活动、线上线下讲义制作及相关图书的编纂工作。&q;,&q;avatar&q;:&q;18d1fd64b1c2dcf.jpg&q;,&q;upperBodyPhoto&q;:null,&q;displayCoursePrefix&q;:&q;gwy&q;,&q;teacherStat&q;:{&q;teacherId&q;:2323,&q;episodeCount&q;:981,&q;scoreCount&q;:148614,&q;avgScore&q;:9.776710134980526,&q;fiveGradeAvgScore&q;:4.89,&q;updateTime&q;:1773622167332},&q;auditionEpisode&q;:{&q;episodeTitle&q;:&q;个人展示课&q;,&q;episodeVideoUrl&q;:&q;https://vod.fbstatic.cn/22e9ceb2vodbj1251001446/46c42a7f3560136621446049284/IoTRss2aoNwA.mp4?t=f2a4b300&a;us=4070880000&a;sign=83ac1184ca9aba5bede57969d7cadf2a&q;},&q;memberOfCPC&q;:false,&q;tags&q;:null},{&q;id&q;:1786,&q;userId&q;:44770470,&q;name&q;:&q;叶萌&q;,&q;brief&q;:&q;粉笔言语优质教师&q;,&q;desc&q;:&q;粉笔言语优质教师，东南大学中文专业硕士，14年公考培训经验，江湖人称“刀姐”，专业功底扎实，授课风格严谨风趣，课堂气氛活泼，从命题角度出发，揣摩规律总结技巧，从学生角度出发，将专业知识转化为通俗易懂的解题方法，提高同学们解题的效率和正确率。&q;,&q;avatar&q;:&q;15d9317546d163a.png&q;,&q;upperBodyPhoto&q;:null,&q;displayCoursePrefix&q;:&q;gwy&q;,&q;teacherStat&q;:{&q;teacherId&q;:1786,&q;episodeCount&q;:1272,&q;scoreCount&q;:327341,&q;avgScore&q;:9.75322370249985,&q;fiveGradeAvgScore&q;:4.88,&q;updateTime&q;:1773587038718},&q;auditionEpisode&q;:{&q;episodeTitle&q;:&q;个人展示课&q;,&q;episodeVideoUrl&q;:&q;https://vod.fbstatic.cn/22e9ceb2vodbj1251001446/f13064a93560136621448768257/KayYR8mH2w4A.mp4?t=f2a4b300&a;us=40