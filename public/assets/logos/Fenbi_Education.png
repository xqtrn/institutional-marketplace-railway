le&q;:&q;&q;,&q;startTime&q;:1758081600000,&q;endTime&q;:1758088800000,&q;teacher&q;:{&q;id&q;:17032,&q;userId&q;:73005297,&q;name&q;:&q;李婕&q;,&q;brief&q;:&q;粉笔优质讲师&q;,&q;desc&q;:&q;粉笔常识公基优质教师\n7年以上一线授课经验，累计授课时长超1000+小时，授课人数超20000+，对常识公基板块理解透彻，曾多次参与命制笔试教研，对民法、刑法等考情有着深入研究，出过近500道优质模拟题，在常识公基教研方面取得不小成果。擅长结合时事热点将晦涩难懂的知识具象化。教学方法也独具匠心深受同学好评，在课堂上经常采用思维导图+口诀记忆法，将繁杂的知识点串联成清晰的知识体系，面对易错易混点也能通过对比分析来加深理解，多年来深受广大学员的认可和五星好评，在学员中具有非常好的口碑，是一位值得信赖的好导师。&q;,&q;avatar&q;:&q;19bc4b46802c805.jpg&q;,&q;upperBodyPhoto&q;:null,&q;displayCoursePrefix&q;:&q;sydw&q;,&q;teacherStat&q;:{&q;teacherId&q;:17032,&q;episodeCount&q;:999,&q;scoreCount&q;:2265,&q;avgScore&q;:9.766887417218552,&q;fiveGradeAvgScore&q;:4.88,&q;updateTime&q;:1773397773324},&q;auditionEpisode&q;:{&q;episodeTitle&q;:&q;个人展示课&q;,&q;episodeVideoUrl&q;:&q;https://vod.fbstatic.cn/22e9ceb2vodbj1251001446/2eda4b7c5145403709227505228/MwwhZdSfiwYA.mp4?t=f2a4b300&a;us=4070880000&a;sign=6b3a5523cd064638f6e21c89c8efeea0&q;},&q;memberOfCPC&q;:false,&q;tags&q;:null},&q;teachChannel&q;:1,&q;offline&q;:null,&q;duration&q;:7329,&q;hasAudition&q;:false,&q;bizType&q;:0,&q;bizId&q;:&q;726825&q;,&q;supportReplay&q;:true,&q;extraInfo&q;:null,&q;liveConfig&q;:{&q;episodeId&q;:11001146,&q;supportMultiGroup&q;:false,&q;exerciseBizType&q;:0,&q;videoDisplayType&q;:0,&q;avForwardType&q;:0,&q;useIntelligentRoom&q;:false,&q;hasStrokeKeynote&q;:true,&q;verticalModeType&q;:0,&q;originEpisodeId&q;:0,&q;supportRtmp&q;:false,&q;supportPk&q;:true,&q;supportLuckyBag&q;:true,&q;supportUserNoteStroke&q;:false,&q;communicateType&q;:0,&q;one2One&q;:false,&q;fakeLive&q;:false},&q;validStatus&q;:1,&q;supportLive&q;:true,&q;supportAiCatalog&q;:false,&q;hasIntelligentPen&q;:false,&q;useLocalRecording&q;:false,&q;useIntelligentRoom&q;:false,&q;hasSalePosition&q;:false,&q;hasEpisodeCards&q;:true,&q;lockedForShouna&q;:false,&q;needSignIn&q;:false,&q;needTeacherSignIn&q;:false,&q;enablePadPencil&q;:true,&q;displayExercise&q;:false,&q;supportLuckyBag&q;:true,&q;supportLivePk&q;:true},{&q;id&q;:11001147,&q;kePrefix&q;:&q;sydw&q;,&q;courseId&q;:6,&q;status&q;:3,&q;playStatus&q;:3,&q;type&q;:33,&q;recordingType&q;:0,&q;mediaType&q;:0,&q;title&q;:&q;【数资】精选好题 沉浸刷题&q;,&q;innerTitle&q;:&q;&q;,&q;startTime&q;:1758088800000,&q;endTime&q;:1758096000000,&q;teacher&q;:{&q;id&q;:16585,&q;userId&q;:72433744,&q;name&q;:&q;李志超&q;,&q;brief&q;:&q;粉笔优质讲师&q;,&q;desc&q;:&q;粉笔优质讲师\n6年一线教育教学经验，累计授课时长超过1500小时，具有丰富的实践经验和系统扎实的理论知识，承担各种线上线下授课任务，累计评分达4.9分\n多次参加模拟题撰写、真题解析等日常教研工作\n授课内容风趣幽默，授课思维活跃，逻辑性强，注重理论与实践相结合，讲解细致，富有亲和力，深受学员喜爱&q;,&q;avatar&q;:&q;193b375ef299d45.jpg&q;,&q;upperBodyPhoto&q;:null,&q;displayCoursePrefix&q;:&q;sydw&q;,&q;teacherStat&q;:{&q;teacherId&q;:16585,&q;episodeCount&q;:552,&q;scoreCount&q;:1401,&q;avgScore&q;:9.822983583154892,&q;fiveGradeAvgScore&q;:4.91,&q;updateTime&q;:1773561621338},&q;auditionEpisode&q;:{&q;episodeTitle&q;:&q;个人展示课&q;,&q;episodeVideoUrl&q;:&q;https://vod.fbstatic.cn/22e9ceb2vodbj1251001446/8083c2095145403709544648249/NKx7gKaPMmIA.mp4?t=f2a4b300&a;us=4070880000&a;sign=b125bc598cde7445acb1a34c322b7d05&q;},&q;memberOfCPC&q;:false,&q;tags&q;:null},&q;teachChannel&q;:1,&q;offline&q;:null,&q;duration&q;:9711,&q;hasAudition&q;:false,&q;bizType&q;:0,&q;bizId&q;:&q;726825&q;,&q;supportReplay&q;:true,&q;extraInfo&q;:null,&q;liveConfig&q;:{&q;episodeId&q;:11001147,&q;supportMultiGroup&q;:false,&q;exerciseBizType&q;:0,&q;videoDisplayType&q;:0,&q;avForwardType&q;:0,&q;useIntelligentRoom&q;:false,&q;hasStrokeKeynote&q;:true,&q;verticalModeType&q;:0,&q;originEpisodeId&q;:0,&q;supportRtmp&q;:false,&q;supportPk&q;:true,&q;supportLuckyBag&q;:true,&q;supportUserNoteStroke&q;:false,&q;communicateType&q;:0,&q;one2One&q;:false,&q;fakeLive&q;:false},&q;validStatus&q;:1,&q;supportLive&q;:true,&q;supportAiCatalog&q;:false,&q;hasIntelligentPen&q;:false,&q;useLocalRecording&q;:false,&q;useIntelligentRoom&q;:false,&q;hasSalePosition&q;:false,&q;hasEpisodeCards&q;:true,&q;lockedForShouna&q;:false,&q;needSignIn&q;:false,&q;needTeacherSignIn&q;:false,&q;enablePadPencil&q;:true,&q;displayExercise&q;:false,&q;supportLuckyBag&q;:true,&q;supportLivePk&q;:true},{&q;id&q;:11001150,&q;kePrefix&q;:&q;sydw&q;,&q;courseId&q;:6,&q;status&q;:3,&q;playStatus&q;:3,&q;type&q;:33,&q;recordingType&q;:0,&q;mediaType&q;:0,&q;title&q;:&q;【判断】精选好题 沉浸刷题&q;,&q;innerTitle&q;:&q;&q;,&q;startTime&q;:1758096000000,&q;endTime&q;:1758103200000,&q;teacher&q;:{&q;id&q;:16940,&q;userId&q;:73888389,&q;name&q;:&q;周晓英&q;,&q;brief&q;:&q;粉笔优质讲师&q;,&q;desc&q;:&q;粉笔优质教师\n6年一线教学授课经验，累计授课时长1000+小时，授课人数20000+，10000+人次累计评分4.9，具有判断推理科目丰富的实践经验和系统扎实的专业理论。多次参与江苏、浙江等地判断推理的考情撰写，长期参与系统班和精品班的教研工作，2021-2024年进行精品班课程的讲义制作与修订，撰写教研文章20余篇，为模考大赛等累计出题200+道。授课风格形象生动、条理清晰，擅于从学员角度思考，帮助学员突破科目重难考点，让学生在轻松的学习氛围中，用更简单的方法，找到更快捷的解题之道，深受广大学员的认可和好评。&q;,&q;avatar&q;:&q;198411a7c789ded.jpg&q;,&q;upperBodyPhoto&q;:null,&q;displayCoursePrefix&q;:&q;sydw&q;,&q;teacherStat&q;:{&q;teacherId&q;:16940,&q;episodeCount&q;:581,&q;scoreCount&q;:2248,&q;avgScore&q;:9.711743772241979,&q;fiveGradeAvgScore&q;:4.86,&q;updateTime&q;:1773552283828},&q;auditionEpisode&q;:{&q;episodeTitle&q;:&q;个人展示课&q;,&q;episodeVideoUrl&q;:&q;https://vod.fbstatic.cn/22e9ceb2vodbj1251001446/fa3033da5145403715605102983/v52FMFBfuysA.mp4?t=f2a4b300&a;us=4070880000&a;sign=4762cae37a00902e1eaae792a9dd93cd&q;},&q;memberOfCPC&q;:false,&q;tags&q;:null},&q;teachChannel&q;:1,&q;offline&q;:null,&q;duration&q;:6796,&q;hasAudition&q;:false,&q;bizType&q;:0,&q;bizId&q;:&q;726825&q;,&q;supportReplay&q;:true,&q;extraInfo&q;:null,&q;liveConfig&q;:{&q;episodeId&q;:11001150,&q;supportMultiGroup&q;:false,&q;exerciseBizType&q;:0,&q;videoDisplayType&q;:0,&q;avForwardType&q;:0,&q;useIntelligentRoom&q;:false,&q;hasStrokeKeynote&q;:true,&q;verticalModeType&q;:0,&q;originEpisodeId&q;:0,&q;supportRtmp&q;:false,&q;supportPk&q;:true,&q;supportLuckyBag&q;:true,&q;supportUserNoteStroke&q;:false,&q;communicateType&q;:0,&q;one2One&q;:false,&q;fakeLive&q;:false},&q;validStatus&q;:1,&q;supportLive&q;:true,&q;supportAiCatalog&q;:false,&q;hasIntelligentPen&q;:false,&q;useLocalRecording&q;:false,&q;useIntelligentRoom&q;:false,&q;hasSalePosition&q;:false,&q;hasEpisodeCards&q;:true,&q;lockedForShouna&q;:false,&q;needSignIn&q;:false,&q;needTeacherSignIn&q;:false,&q;enablePadPencil&q;:true,&q;displayExercise&q;:false,&q;supportLuckyBag&q;:true,&q;supportLivePk&q;:true},{&q;id&q;:11001157,&q;kePrefix&q;:&q;sydw&q;,&q;courseId&q;:6,&q;status&q;:3,&q;playStatus&q;:3,&q;type&q;:33,&q;recordingType&q;:0,&q;mediaType&q;:0,&q;title&q;:&q;【综应】精选好题 沉浸刷题&q;,&q;innerTitle&q;:&q;&q;,&q;startTime&q;:1758168000000,&q;endTime&q;:1758175200000,&q;teacher&q;:{&q;id&q;:35889,&q;userId&q;:59452309,&q;name&q;:&q;王昭媛&q;,&q;brief&q;:&q;粉笔优质讲师&q;,&q;desc&q;:&q;粉笔优质讲师\n985院校硕士毕业，投身教育事业6年，拥有扎实一线教学经验。多次参与真题解析以及真题解析视频录制，积累大量实用经验，对各省份考情深入钻研，精准把握各地考试要点。\n授课思路清晰，熟练掌握各类题型的作答技巧，理论扎实，逻辑清晰，重点突出，耐心细致，在教学过程中因材施教，采用启发式教学法，激发学员的学习兴趣与思考能力。\n承担各种线上线下授课任务，累计服务学员上千人，授课超1000小时，累计评分达4.9分。始终秉持着“以学员为中心”的教学理念，在教学过程中因材施教，并能及时跟进学员的学习进度，耐心解答学员的疑问，为学员提供个性化的辅导与建议，深受学员喜爱。&q;,&q;avatar&q;:&q;18f7000bcd332c6.jpg&q;,&q;upperBodyPhoto&q;:null,&q;displayCoursePrefix&q;:&q;sydw&q;,&q;teacherStat&q;:{&q;teacherId&q;:35889,&q;episodeCount&q;:313,&q;scoreCount&q;:848,&q;avgScore&q;:9.818396226415093,&q;fiveGradeAvgScore&q;:4.91,&q;updateTime&q;:1773575413148},&q;auditionEpisode&q;:{&q;episodeTitle&q;:&q;个人展示课&q;,&q;episodeVideoUrl&q;:&q;https://vod.fbstatic.cn/22e9ceb2vodbj1251001446/22bda7be5145403707387441415/gXaZC0lUKVsA.mp4?t=f2a4b300&a;us=4070880000&a;sign=a57ab9a520ff41c2fe2822f31d725d60&q;},&q;memberOfCPC&q;:false,&q;tags&q;:null},&q;teachChannel&q;:1,&q;offline&q;:null,&q;duration&q;:7214,&q;hasAudition&q;:false,&q;bizType&q;:0,&q;bizId&q;:&q;726825&q;,&q;supportReplay&q;:true,&q;extraInfo&q;:null,&q;liveConfig&q;:{&q;episodeId&q;:11001157,&q;supportMultiGroup&q;:false,&q;exerciseBizType&q;:0,&q;videoDisplayType&q;:0,&q;avForwardType&q;:0,&q;useIntelligentRoom&q;:false,&q;hasStrokeKeynote&q;:true,&q;verticalModeType&q;:0,&q;originEpisodeId&q;:0,&q;supportRtmp&q;:false,&q;sup