Live&q;:true,&q;supportAiCatalog&q;:false,&q;hasIntelligentPen&q;:false,&q;useLocalRecording&q;:false,&q;useIntelligentRoom&q;:false,&q;hasSalePosition&q;:false,&q;hasEpisodeCards&q;:true,&q;lockedForShouna&q;:false,&q;needSignIn&q;:false,&q;needTeacherSignIn&q;:false,&q;enablePadPencil&q;:true,&q;displayExercise&q;:false,&q;supportLuckyBag&q;:true,&q;supportLivePk&q;:true},{&q;id&q;:11097172,&q;kePrefix&q;:&q;sydw&q;,&q;courseId&q;:6,&q;status&q;:3,&q;playStatus&q;:3,&q;type&q;:33,&q;recordingType&q;:0,&q;mediaType&q;:0,&q;title&q;:&q;【判断】精选好题 沉浸刷题&q;,&q;innerTitle&q;:&q;&q;,&q;startTime&q;:1761638400000,&q;endTime&q;:1761645600000,&q;teacher&q;:{&q;id&q;:64430,&q;userId&q;:136519339,&q;name&q;:&q;张雨星&q;,&q;brief&q;:&q;粉笔优质讲师&q;,&q;desc&q;:&q;粉笔优质教师\n长期从事公考一线教学，具有判断科目丰富的实践经验及系统扎实的专业理论知识，多次参加粉笔授课研讨会议，全面把握公考判断科目趋势及最新考情。 对判断科目有独到的见解，深度解剖知识点，擅长将复杂的判断知识点用通俗易懂的语言讲解，从而化解学员心中的谜团，让学员豁然开朗，全面吸收重点知识，增长自信心，在考场上从容自如。&q;,&q;avatar&q;:&q;193af918ace06f9.jpg&q;,&q;upperBodyPhoto&q;:null,&q;displayCoursePrefix&q;:&q;sydw&q;,&q;teacherStat&q;:{&q;teacherId&q;:64430,&q;episodeCount&q;:245,&q;scoreCount&q;:627,&q;avgScore&q;:9.799043062200955,&q;fiveGradeAvgScore&q;:4.9,&q;updateTime&q;:1773558667592},&q;auditionEpisode&q;:{&q;episodeTitle&q;:&q;个人展示课&q;,&q;episodeVideoUrl&q;:&q;https://vod.fbstatic.cn/22e9ceb2vodbj1251001446/dd034cbe5145403709542216483/M9ba77bUylwA.mp4?t=f2a4b300&a;us=4070880000&a;sign=acce949c38e0c790835300ba625a4e10&q;},&q;memberOfCPC&q;:false,&q;tags&q;:null},&q;teachChannel&q;:1,&q;offline&q;:null,&q;duration&q;:8188,&q;hasAudition&q;:false,&q;bizType&q;:0,&q;bizId&q;:&q;726825&q;,&q;supportReplay&q;:true,&q;extraInfo&q;:null,&q;liveConfig&q;:{&q;episodeId&q;:11097172,&q;supportMultiGroup&q;:false,&q;exerciseBizType&q;:0,&q;videoDisplayType&q;:0,&q;avForwardType&q;:0,&q;useIntelligentRoom&q;:false,&q;hasStrokeKeynote&q;:true,&q;verticalModeType&q;:0,&q;originEpisodeId&q;:0,&q;supportRtmp&q;:false,&q;supportPk&q;:true,&q;supportLuckyBag&q;:true,&q;supportUserNoteStroke&q;:false,&q;communicateType&q;:0,&q;one2One&q;:false,&q;fakeLive&q;:false},&q;validStatus&q;:1,&q;supportLive&q;:true,&q;supportAiCatalog&q;:false,&q;hasIntelligentPen&q;:false,&q;useLocalRecording&q;:false,&q;useIntelligentRoom&q;:false,&q;hasSalePosition&q;:false,&q;hasEpisodeCards&q;:true,&q;lockedForShouna&q;:false,&q;needSignIn&q;:false,&q;needTeacherSignIn&q;:false,&q;enablePadPencil&q;:true,&q;displayExercise&q;:false,&q;supportLuckyBag&q;:true,&q;supportLivePk&q;:true},{&q;id&q;:11097179,&q;kePrefix&q;:&q;sydw&q;,&q;courseId&q;:6,&q;status&q;:3,&q;playStatus&q;:3,&q;type&q;:33,&q;recordingType&q;:0,&q;mediaType&q;:0,&q;title&q;:&q;【数资】精选好题 沉浸刷题&q;,&q;innerTitle&q;:&q;&q;,&q;startTime&q;:1761703200000,&q;endTime&q;:1761710400000,&q;teacher&q;:{&q;id&q;:16892,&q;userId&q;:64000402,&q;name&q;:&q;陈实&q;,&q;brief&q;:&q;粉笔优质讲师&q;,&q;desc&q;:&q;粉笔优质讲师\n六年教学经验，承担各种班型授课，理论知识扎实，了解事业单位数量关系和资料分析的答题技巧，注重专业知识的传递，授课有亲和力，逻辑性强，能激发学生学习的热情，得到许多学生的好评和喜爱。&q;,&q;avatar&q;:&q;17a757d0def9021.jpg&q;,&q;upperBodyPhoto&q;:null,&q;displayCoursePrefix&q;:&q;sydw&q;,&q;teacherStat&q;:{&q;teacherId&q;:16892,&q;episodeCount&q;:366,&q;scoreCount&q;:1043,&q;avgScore&q;:9.892617449664424,&q;fiveGradeAvgScore&q;:4.95,&q;updateTime&q;:1773542090436},&q;auditionEpisode&q;:{&q;episodeTitle&q;:&q;个人展示课&q;,&q;episodeVideoUrl&q;:&q;https://vod.fbstatic.cn/22e9ceb2vodbj1251001446/c851eb6f5145403710133043770/P6pa1nY0NqgA.mp4?t=f2a4b300&a;us=4070880000&a;sign=560efd01ae975cc0d0456e09500eb8d0&q;},&q;memberOfCPC&q;:false,&q;tags&q;:null},&q;teachChannel&q;:1,&q;offline&q;:null,&q;duration&q;:8474,&q;hasAudition&q;:false,&q;bizType&q;:0,&q;bizId&q;:&q;726825&q;,&q;supportReplay&q;:true,&q;extraInfo&q;:null,&q;liveConfig&q;:{&q;episodeId&q;:11097179,&q;supportMultiGroup&q;:false,&q;exerciseBizType&q;:0,&q;videoDisplayType&q;:0,&q;avForwardType&q;:0,&q;useIntelligentRoom&q;:false,&q;hasStrokeKeynote&q;:true,&q;verticalModeType&q;:0,&q;originEpisodeId&q;:0,&q;supportRtmp&q;:false,&q;supportPk&q;:true,&q;supportLuckyBag&q;:true,&q;supportUserNoteStroke&q;:false,&q;communicateType&q;:0,&q;one2One&q;:false,&q;fakeLive&q;:false},&q;validStatus&q;:1,&q;supportLive&q;:true,&q;supportAiCatalog&q;:false,&q;hasIntelligentPen&q;:false,&q;useLocalRecording&q;:false,&q;useIntelligentRoom&q;:false,&q;hasSalePosition&q;:false,&q;hasEpisodeCards&q;:true,&q;lockedForShouna&q;:false,&q;needSignIn&q;:false,&q;needTeacherSignIn&q;:false,&q;enablePadPencil&q;:true,&q;displayExercise&q;:false,&q;supportLuckyBag&q;:true,&q;supportLivePk&q;:true},{&q;id&q;:11097180,&q;kePrefix&q;:&q;sydw&q;,&q;courseId&q;:6,&q;status&q;:3,&q;playStatus&q;:3,&q;type&q;:33,&q;recordingType&q;:0,&q;mediaType&q;:0,&q;title&q;:&q;【综应】精选好题 沉浸刷题&q;,&q;innerTitle&q;:&q;&q;,&q;startTime&q;:1761710400000,&q;endTime&q;:1761717600000,&q;teacher&q;:{&q;id&q;:35912,&q;userId&q;:84301173,&q;name&q;:&q;黄迟驰&q;,&q;brief&q;:&q;粉笔优质讲师&q;,&q;desc&q;:&q;粉笔优质讲师\n投身教育事业5年，拥有扎实一线教学经验。承接过各省份笔试系统班，刷题冲刺营，冲刺营，刷题营等班型，服务过近千名学员。参与题库解析课录制，综应一对一课程，综应刷题课。深耕事业单位考试，全面了解事业单位综合应用能力科目考试的命题规律及答题技巧。针对学生困惑研究教学策略，深入研讨最新考情。注重自我提升，每年度多次参加培训学习和综应科目教研，并取得优异成绩。积极分享经验心得，助力粉笔理论研发持续升级，积累丰富笔试理论知识。注重理论与实践相结合，让学生在轻松的学习氛围中，用更简单的方法，找到更快捷的解题之道，深受学员的认可和好评。&q;,&q;avatar&q;:&q;193af66b81fc0b1.jpg&q;,&q;upperBodyPhoto&q;:null,&q;displayCoursePrefix&q;:&q;sydw&q;,&q;teacherStat&q;:{&q;teacherId&q;:35912,&q;episodeCount&q;:195,&q;scoreCount&q;:305,&q;avgScore&q;:9.947540983606558,&q;fiveGradeAvgScore&q;:4.97,&q;updateTime&q;:1773557231120},&q;auditionEpisode&q;:{&q;episodeTitle&q;:&q;个人展示课&q;,&q;episodeVideoUrl&q;:&q;https://vod.fbstatic.cn/22e9ceb2vodbj1251001446/ba2b7e275145403709538047971/m0NVEgAoIxsA.mp4?t=f2a4b300&a;us=4070880000&a;sign=90823bb2aa3547011e7a0d5700585e7c&q;},&q;memberOfCPC&q;:false,&q;tags&q;:null},&q;teachChannel&q;:1,&q;offline&q;:null,&q;duration&q;:7062,&q;hasAudition&q;:false,&q;bizType&q;:0,&q;bizId&q;:&q;726825&q;,&q;supportReplay&q;:true,&q;extraInfo&q;:null,&q;liveConfig&q;:{&q;episodeId&q;:11097180,&q;supportMultiGroup&q;:false,&q;exerciseBizType&q;:0,&q;videoDisplayType&q;:0,&q;avForwardType&q;:0,&q;useIntelligentRoom&q;:false,&q;hasStrokeKeynote&q;:true,&q;verticalModeType&q;:0,&q;originEpisodeId&q;:0,&q;supportRtmp&q;:false,&q;supportPk&q;:true,&q;supportLuckyBag&q;:true,&q;supportUserNoteStroke&q;:false,&q;communicateType&q;:0,&q;one2One&q;:false,&q;fakeLive&q;:false},&q;validStatus&q;:1,&q;supportLive&q;:true,&q;supportAiCatalog&q;:false,&q;hasIntelligentPen&q;:false,&q;useLocalRecording&q;:false,&q;useIntelligentRoom&q;:false,&q;hasSalePosition&q;:false,&q;hasEpisodeCards&q;:true,&q;lockedForShouna&q;:false,&q;needSignIn&q;:false,&q;needTeacherSignIn&q;:false,&q;enablePadPencil&q;:true,&q;displayExercise&q;:false,&q;supportLuckyBag&q;:true,&q;supportLivePk&q;:true},{&q;id&q;:11165216,&q;kePrefix&q;:&q;sydw&q;,&q;courseId&q;:6,&q;status&q;:3,&q;playStatus&q;:3,&q;type&q;:33,&q;recordingType&q;:0,&q;mediaType&q;:0,&q;title&q;:&q;【言语】精选好题 沉浸刷题&q;,&q;innerTitle&q;:&q;&q;,&q;startTime&q;:1761717600000,&q;endTime&q;:1761724800000,&q;teacher&q;:{&q;id&q;:32974,&q;userId&q;:83441510,&q;name&q;:&q;何铖&q;,&q;brief&q;:&q;粉笔优质讲师&q;,&q;desc&q;:&q;粉笔优质讲师\n6年一线教学经验，承担过线上、线下笔试多种班型课程，累计授课超3100小时，授课经验丰富。\n承担言语科目授课、教研与培训工作，上课亲和生动，互动性强，擅长理论与实际相结合，授课逻辑性强，善于发现学员解题症结并总结答题技巧，积极引导并激发学员学习热情和自主意识。\n课程累计评分4.97，在学员中具有良好口碑，是值得信赖的好导师。&q;,&q;avatar&q;:&q;1984f2383973c17.jpg&q;,&q;upperBodyPhoto&q;:null,&q;displayCoursePrefix&q;:&q;sydw&q;,&q;teacherStat&q;:{&q;teacherId&q;:32974,&q;episodeCount&q;:741,&q;scoreCount&q;:1778,&q;avgScore&q;:9.923509561304837,&q;fiveGradeAvgScore&q;:4.96,&q;updateTime&q;:1773235895215},&q;auditionEpisode&q;:{&q;episodeTitle&q;:&q;个人展示课&q;,&q;episodeVideoUrl&q;:&q;https://vod.fbstatic.cn/22e9ceb2vodbj1251001446/4349be535145403710131933552/nPy2nunV3pAA.mp4?t=f2a4b300&a;us=4070880000&a;sign=864a8580f53c566b64ff5ba2e13209fc&q;},&q;memberOfCPC&q;:false,&q;tags&q;:null},&q;teachChannel&q;:1,&q;offline&q;:null,&q;duration&q;:7337,&q;hasAudition&q;:false,&q;bizType&q;:0,&q;bizId&q;:&q;726825&q;,&q;supportReplay&q;:true,&q;extraInfo&q;:null,&q;liveConfig&q;:{&q;episodeId&q;:11165216,&q;supportMultiGroup&q;:false,&q;exerciseBizType&q;:0,&q;videoDisplayType&q;:0,&q;avForwardType&q;:0,&q;useIntelligentRoom&q;:false,&q;hasStrokeKeynote&q;:true,&q;verticalModeType&q;:0,&q;originEpisodeId&q;:0,&q;supportRtmp&q;:false,&q;supportPk&q;:true,&q;supportLuckyBag&q;:true,&q;supportUserNoteStroke&q;:false,&q;communicateType&q;:0,&q;one2One&q;:false,&q;fakeLive&q;:false},&q;validStatus&q;:1,&q;supportLive&q;:true,&q;supportAiCatalog&q;:false,&q;hasIntelligentPen&q;:false,&q;useLocalRecording&q;:false,&q;useIntelligentRoom&q;:false,&q;hasSalePosition&q;:false,&q;hasEpisodeCards&q;:true,&q;lockedForShouna&q;:false,&q;needSignIn&q;:false,&q;needTeacherSignIn&q;:false,&q;enablePadPencil&q;:true,&q;displayExercise&q;:false,&q;supportLuckyBag&q;:true,&q;supportLivePk&q;:true},{&q;id&q;:11097198,&q;kePrefix&q;:&q;sydw&q;,&q;courseId&q;:6,&q;status&q;:3,&q;playStatus&q;:3,&q;type&q;:33,&q;recordingType&q;:0,&q;mediaType&q;:0,&q;title&q;:&q;【判断】精选好题 沉浸刷题&q;,&q;innerTitle&q;:&q;&q;,&q;startTime&q;:1761789600000,&q;endTime&q;:1761796800000,&q;teacher&q;:{&q;id&q;:16991,&q;userId&q;:46502384,&q;name&q;:&q;岑红&q;,&q;brief&q;:&q;粉笔优质讲师&q;,&q;desc&q;:&q;粉笔优质教师\n       6年教学授课经验，具有判断科目丰富的实践经验及系统扎实的专业理论知识，参与笔试判断科目模拟题命制和解析审核且多次参加粉笔授课研讨会议，全面了解事业单位判断类题型的命题规律及答题技巧。善于将知识点简单化、条理化和趣味化以激发学生的学习热情，同时授课逻辑性强，思维严谨，能够意识到学生在知识点上的问题并给予相应的指导，深受广大学员的认可和好评。&q;,&q;avatar&q;:&q;19854eea5710183.jpg&q;,&q;upperBodyPhoto&q;:null,&q;displayCoursePrefix&q;:&q;sydw&q;,&q;teacherStat&q;:{&q;teacherId&q;:16991,&q;episodeCount&q;:496,&q;scoreCount&q;:2569,&q;avgScore&q;:9.792915531335142,&q;fiveGradeAvgScore&q;:4.9,&q;updateTime&q;:1773604268370},&q;auditionEpisode&q;:{&q;episodeTitle&q;:&q;个人展示课&q;,&q;episodeVideoUrl&q;:&q;https://vod.fbstatic.cn/22e9ceb2vodbj1251001446/10d5dbb55145403709539499496/emXm1Ym9kfIA.mp4?t=f2a4b300&a;us=4070880000&a;sign=fc844b010265e86e6742934e4dffdd3c&q;},&q;memberOfCPC&q;:false,&q;tags&q;:null},&