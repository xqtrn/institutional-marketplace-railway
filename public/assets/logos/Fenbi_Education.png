;:false,&q;hasSalePosition&q;:false,&q;hasEpisodeCards&q;:true,&q;lockedForShouna&q;:false,&q;needSignIn&q;:false,&q;needTeacherSignIn&q;:false,&q;enablePadPencil&q;:true,&q;displayExercise&q;:false,&q;supportLuckyBag&q;:true,&q;supportLivePk&q;:true},{&q;id&q;:9969367,&q;kePrefix&q;:&q;sydw&q;,&q;courseId&q;:6,&q;status&q;:3,&q;playStatus&q;:3,&q;type&q;:33,&q;recordingType&q;:0,&q;mediaType&q;:0,&q;title&q;:&q;【判断】精选好题 沉浸刷题&q;,&q;innerTitle&q;:&q;&q;,&q;startTime&q;:1735963200000,&q;endTime&q;:1735970400000,&q;teacher&q;:{&q;id&q;:64007,&q;userId&q;:54668660,&q;name&q;:&q;姚雨言&q;,&q;brief&q;:&q;粉笔优质讲师&q;,&q;desc&q;:&q;粉笔优质讲师\n一线教学经验丰富，承担事业单位线上线下各类课程：如笔试精讲、刷题、拔高、冲刺等阶段；\n参与事业单位真题解析和模拟题撰写工作，能够把握命题人思维，能够结合命题人思维和学生思维，做到双向把握；\n兼具幽默的授课风格和严谨的逻辑思维，寓教于乐中传授判断技巧，多维关注中攻克学习壁垒，始终把学员学习的事当作自己的事，深受学生喜爱。&q;,&q;avatar&q;:&q;1945f3d73434704.jpg&q;,&q;upperBodyPhoto&q;:null,&q;displayCoursePrefix&q;:&q;sydw&q;,&q;teacherStat&q;:{&q;teacherId&q;:64007,&q;episodeCount&q;:589,&q;scoreCount&q;:1397,&q;avgScore&q;:9.365783822476725,&q;fiveGradeAvgScore&q;:4.68,&q;updateTime&q;:1773568406538},&q;auditionEpisode&q;:{&q;episodeTitle&q;:&q;个人展示课&q;,&q;episodeVideoUrl&q;:&q;https://vod.fbstatic.cn/22e9ceb2vodbj1251001446/2b4fc3451397757890101326227/usEitiGCa8gA.mp4?t=f2a4b300&a;us=4070880000&a;sign=7332cda439b401241158abd03efa5e47&q;},&q;memberOfCPC&q;:false,&q;tags&q;:null},&q;teachChannel&q;:1,&q;offline&q;:null,&q;duration&q;:8198,&q;hasAudition&q;:false,&q;bizType&q;:0,&q;bizId&q;:&q;726825&q;,&q;supportReplay&q;:true,&q;extraInfo&q;:null,&q;liveConfig&q;:{&q;episodeId&q;:9969367,&q;supportMultiGroup&q;:false,&q;exerciseBizType&q;:0,&q;videoDisplayType&q;:0,&q;avForwardType&q;:0,&q;useIntelligentRoom&q;:false,&q;hasStrokeKeynote&q;:true,&q;verticalModeType&q;:0,&q;originEpisodeId&q;:0,&q;supportRtmp&q;:false,&q;supportPk&q;:true,&q;supportLuckyBag&q;:true,&q;supportUserNoteStroke&q;:false,&q;communicateType&q;:0,&q;one2One&q;:false,&q;fakeLive&q;:false},&q;validStatus&q;:1,&q;supportLive&q;:t