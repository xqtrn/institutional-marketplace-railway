roke&q;:false,&q;communicateType&q;:0,&q;one2One&q;:false,&q;fakeLive&q;:false},&q;validStatus&q;:1,&q;supportLive&q;:true,&q;supportAiCatalog&q;:false,&q;hasIntelligentPen&q;:false,&q;useLocalRecording&q;:false,&q;useIntelligentRoom&q;:false,&q;hasSalePosition&q;:false,&q;hasEpisodeCards&q;:true,&q;lockedForShouna&q;:false,&q;needSignIn&q;:false,&q;needTeacherSignIn&q;:false,&q;enablePadPencil&q;:true,&q;displayExercise&q;:false,&q;supportLuckyBag&q;:true,&q;supportLivePk&q;:true},{&q;id&q;:11000133,&q;kePrefix&q;:&q;sydw&q;,&q;courseId&q;:6,&q;status&q;:3,&q;playStatus&q;:3,&q;type&q;:33,&q;recordingType&q;:0,&q;mediaType&q;:0,&q;title&q;:&q;【言语】精选好题 沉浸刷题&q;,&q;innerTitle&q;:&q;&q;,&q;startTime&q;:1756792800000,&q;endTime&q;:1756800000000,&q;teacher&q;:{&q;id&q;:14565,&q;userId&q;:48370970,&q;name&q;:&q;王清悦&q;,&q;brief&q;:&q;粉笔优质讲师&q;,&q;desc&q;:&q;粉笔优质讲师\n8年一线教学经验，教学风格严谨而不失活泼，善于将复杂的知识点以生动有趣的方式呈现，让学生轻松掌握。对于考试考点有着敏锐的洞察力和精准的把握能力，帮助学生有效备考，事半功倍。我坚信，教育不仅仅是知识的传授，更是思维的启迪与人格的塑造，因此，始终致力于培养学生的独立思考能力与解决问题的能力，助力他们在人生的每一个阶段都能自信前行。&q;,&q;avatar&q;:&q;173d720cea24b6c.jpg&q;,&q;upperBodyPhoto&q;:null,&q;displayCoursePrefix&q;:&q;sydw&q;,&q;teacherStat&q;:{&q;teacherId&q;:14565,&q;episodeCount&q;:477,&q;scoreCount&q;:1439,&q;avgScore&q;:9.745656706045871,&q;fiveGradeAvgScore&q;:4.87,&q;updateTime&q;:1773559873082},&q;auditionEpisode&q;:{&q;episodeTitle&q;:&q;个人展示课&q;,&q;episodeVideoUrl&q;:&q;https://vod.fbstatic.cn/22e9ceb2vodbj1251001446/cbd1293d5145403707742801437/WSGdVtt1L3AA.mp4?t=f2a4b300&a;us=4070880000&a;sign=a446564dcadd70a9b99e6d27e1f0ecde&q;},&q;memberOfCPC&q;:false,&q;tags&q;:null},&q;teachChannel&q;:1,&q;offline&q;:null,&q;duration&q;:7980,&q;hasAudition&q;:false,&q;bizType&q;:0,&q;bizId&q;:&q;726825&q;,&q;supportReplay&q;:true,&q;extraInfo&q;:null,&q;liveConfig&q;:{&q;episodeId&q;:11000133,&q;supportMultiGroup&q;:false,&q;exerciseBizType&q;:0,&q;videoDisplayType&q;:0,&q;avForwardType&q;:0,&q;useIntelligentRoom&q;:false,&q;hasStrokeKeynote&q;:true,&q;verticalModeType&q;:0,&q;originEpisodeId&q;:0,&q;supportRtmp&q;:false,&q;supportPk&q;:true,&q;supportLuckyBag&q;:true,&q;supportUserNoteStroke&q;:false,&q;communicateType&q;:0,&q;one2One&q;:false,&q;fakeLive&q;:false},&q;validStatus&q;:1,&q;supportLive&q;:true,&q;supportAiCatalog&q;:false,&q;hasIntelligentPen&q;:false,&q;useLocalRecording&q;:false,&q;useIntelligentRoom&q;:false,&q;hasSalePosition&q;:false,&q;hasEpisodeCards&q;:true,&q;lockedForShouna&q;:false,&q;needSignIn&q;:false,&q;needTeacherSignIn&q;:false,&q;enablePadPencil&q;:true,&q;displayExercise&q;:false,&q;supportLuckyBag&q;:true,&q;supportLivePk&q;:true},{&q;id&q;:11048902,&q;kePrefix&q;:&q;sydw&q;,&q;courseId&q;:6,&q;status&q;:3,&q;playStatus&q;:3,&q;type&q;:33,&q;recordingType&q;:0,&q;mediaType&q;:0,&q;title&q;:&q;【言语】精选好题 沉浸刷题&q;,&q;innerTitle&q;:&q;&q;,&q;startTime&q;:1756800000000,&q;endTime&q;:1756807200000,&q;teacher&q;:{&q;id&q;:35776,&q;userId&q;:83534698,&q;name&q;:&q;魏兰婷&q;,&q;brief&q;:&q;粉笔优质讲师&q;,&q;desc&q;:&q;粉笔优质讲师\n拥有7年一线教学授课经验，毕业于双一流院校。深耕言语理解与表达科目，对国考及各省考情有精准把握。具有言语科目丰富的实践经验及系统扎实的专业理论知识。\n①多次参与粉笔授课研讨与教研活动，持续更新教学理论与方法；\n②承担线上公开课及线上直播课等工作，累计全国授课超万人次，学员评分长期稳定在4.9分以上；\n③曾2次在粉笔“师资风采大赛”中入围并获奖，教学能力获得内部认可。\n授课风格耐心细致，善于将复杂的知识点转化为通俗易懂的讲解，营造轻松积极的学习氛围。其高效的解题方法与亲切的指导深受学员好评，是学员信赖的良师。&q;,&q;avatar&q;:&q;1984fca9fbd6325.jpg&q;,&q;upperBodyPhoto&q;:null,&q;displayCoursePrefix&q;:&q;sydw&q;,&q;teacherStat&q;:{&q;teacherId&q;:35776,&q;episodeCount&q;:610,&q;scoreCount&q;:4222,&q;avgScore&q;:9.801989578398866,&q;fiveGradeAvgScore&q;:4.9,&q;updateTime&q;:1773576447340},&q;auditionEpisode&q;:{&q;episodeTitle&q;:&q;个人展示课&q;,&q;episodeVideoUrl&q;:&q;https://vod.fbstatic.cn/22e9ceb2vodbj1251001446/bcb7f84d5145403709538179593/LKKkDheS6YsA.mp4?t=f2a4b300&a;us=4070880000&a;sign=ade5c614ffe4fa0bcf0395aa689081c8&q;},&q;memberOfCPC&q;:false,&q;tags&q;:null},&q;teachChannel&q;:1,&q;offline&q;:null,&q;duration&q;:7526,&q;hasAudition&q;:false,&q;bizType&q;:0,&q;bizId&q;:&q;726825&q;,&q;supportReplay&q;:true,&q;extraInfo&q;:null,&q;liveCo