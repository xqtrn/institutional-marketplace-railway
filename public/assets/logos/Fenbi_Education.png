pe&q;:0,&q;title&q;:&q;晚课-热点夜话35&q;,&q;innerTitle&q;:&q;&q;,&q;startTime&q;:1776434400000,&q;endTime&q;:1776437100000,&q;teacher&q;:{&q;id&q;:14952,&q;userId&q;:48263990,&q;name&q;:&q;赵博&q;,&q;brief&q;:&q;粉笔面试研究院成员、高级面试讲师&q;,&q;desc&q;:&q;8年公考面试授课经验，粉笔大区面试教学教研负责人，面试直播工作负责人，粉笔面试教材主编，主要承担粉笔国省考理论大课及各类线上公开课与直播工作，参与过多省市、多部门面试教材的教研与题本的研发设计工作。曾任高校讲师，并受邀担任华语网辩联赛评委。 \n赵博老师多年深耕于教学一线，具备出众的表达能力与严谨的逻辑思维，深谙面试作答之道，对内容思考以及语言表达都有着非常独到的见解。授课风格严谨却不失幽默，善于通过启发式教学，激发学员自主思考的能力。不仅能帮助学员迅速掌握应试技巧，更能在授课中传递正确的三观与为人处世的态度。&q;,&q;avatar&q;:&q;19b4f428479021e.jpg&q;,&q;upperBodyPhoto&q;:null,&q;displayCoursePrefix&q;:&q;gwy&q;,&q;teacherStat&q;:{&q;teacherId&q;:14952,&q;episodeCount&q;:1056,&q;scoreCount&q;:31594,&q;avgScore&q;:9.872444134962334,&q;fiveGradeAvgScore&q;:4.94,&q;updateTime&q;:1773622989376},&q;auditionEpisode&q;:{&q;episodeTitle&q;:&q;个人展示课&q;,&q;episodeVideoUrl&q;:&q;https://vod.fbstatic.cn/22e9ceb2vodbj1251001446/3d4dee423270835013757846611/qL4f3aEL8qMA.mp4?t=f2a4b300&a;us=4070880000&a;sign=5b7cf4d0d4b9823356332971b3f930b7&q;},&q;memberOfCPC&q;:false,&q;tags&q;:null},&q;teachChannel&q;:1,&q;offline&q;:null,&q;duration&q;:2700,&q;hasAudition&q;:false,&q;bizType&q;:0,&q;bizId&q;:&q;773251&q;,&q;supportReplay&q;:true,&q;extraInfo&q;:null,&q;liveConfig&q;:{&q;episodeId&q;:11706796,&q;supportMultiGroup&q;:false,&q;exerciseBizType&q;:0,&q;videoDisplayType&q;:0,&q;avForwardType&q;:0,&q;useIntelligentRoom&q;:false,&q;hasStrokeKeynote&q;:false,&q;verticalModeType&q;:0,&q;originEpisodeId&q;:0,&q;supportRtmp&q;:false,&q;supportPk&q;:false,&q;supportLuckyBag&q;:false,&q;supportUserNoteStroke&q;:false,&q;communicateType&q;:0,&q;fakeLive&q;:false,&q;one2One&q;:false},&q;validStatus&q;:1,&q;supportLive&q;:true,&q;supportAiCatalog&q;:false,&q;hasIntelligentPen&q;:false,&q;useLocalRecording&q;:false,&q;useIntelligentRoom&q;:false,&q;hasSalePosition&q;:false,&q;hasEpisodeCards&q;:false,&q;lockedForShouna&q;:false,&q;needSignIn&q;:false,&q;needTeacherSignIn&q;:false,&q;enablePadPencil&q;:false,&q;dis