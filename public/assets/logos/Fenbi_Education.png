odeId&q;:0,&q;supportRtmp&q;:false,&q;supportPk&q;:false,&q;supportLuckyBag&q;:false,&q;supportUserNoteStroke&q;:false,&q;communicateType&q;:0,&q;one2One&q;:false,&q;fakeLive&q;:false},&q;validStatus&q;:1,&q;supportLive&q;:true,&q;supportAiCatalog&q;:true,&q;hasIntelligentPen&q;:false,&q;useLocalRecording&q;:false,&q;useIntelligentRoom&q;:false,&q;hasSalePosition&q;:false,&q;hasEpisodeCards&q;:false,&q;lockedForShouna&q;:false,&q;needSignIn&q;:false,&q;needTeacherSignIn&q;:false,&q;enablePadPencil&q;:true,&q;displayExercise&q;:false,&q;supportLuckyBag&q;:false,&q;supportLivePk&q;:false},{&q;id&q;:11560800,&q;kePrefix&q;:&q;gwy&q;,&q;courseId&q;:1,&q;status&q;:3,&q;playStatus&q;:3,&q;type&q;:1,&q;recordingType&q;:0,&q;mediaType&q;:0,&q;title&q;:&q;2026省考行测申论联合终极模考大赛《申论》（县乡卷）&q;,&q;innerTitle&q;:&q;&q;,&q;startTime&q;:1773054000000,&q;endTime&q;:1773064800000,&q;teacher&q;:{&q;id&q;:104,&q;userId&q;:4835461,&q;name&q;:&q;张跃瀚&q;,&q;brief&q;:&q;粉笔申论优质教师&q;,&q;desc&q;:&q;粉笔申论优质教师，教研负责人，毕业于中国政法大学。 \n15年公考培训经验，学员评分高达4.9分，被学员亲切地称为“瀚叔”。 \n授课系统性、严谨性和逻辑性并重，深入浅出、脉络清晰，既能充分挖掘材料细节，又善于从宏观角度架构解题思路。被考生认为是接地气与高大上的完美结合，效率与效果俱佳。 \n2014年进入粉笔团队，负责申论学科的教学教研工作，主持申论新手特训营、申论小题精训、作文精训等产品的开发，统筹申论智能批改、申论模考等多个申论核心产品，组织编写多部申论图书。 &q;,&q;avatar&q;:&q;15161c629f4a31f.jpg&q;,&q;upperBodyPhoto&q;:null,&q;displayCoursePrefix&q;:&q;gwy&q;,&q;teacherStat&q;:{&q;teacherId&q;:104,&q;episodeCount&q;:1280,&q;scoreCount&q;:419528,&q;avgScore&q;:9.77153849087548,&q;fiveGradeAvgScore&q;:4.89,&q;updateTime&q;:1773589586792},&q;auditionEpisode&q;:null,&q;memberOfCPC&q;:false,&q;tags&q;:null},&q;teachChannel&q;:1,&q;offline&q;:null,&q;duration&q;:16002,&q;hasAudition&q;:false,&q;bizType&q;:0,&q;bizId&q;:&q;710082&q;,&q;supportReplay&q;:true,&q;extraInfo&q;:null,&q;liveConfig&q;:{&q;episodeId&q;:11560800,&q;supportMultiGroup&q;:false,&q;exerciseBizType&q;:0,&q;videoDisplayType&q;:0,&q;avForwardType&q;:0,&q;useIntelligentRoom&q;:false,&q;hasStrokeKeynote&q;:true,&q;verticalModeType&q;:0,&q;originEpisodeId&q;:0,&q;sup