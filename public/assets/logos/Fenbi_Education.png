;:0,&q;avForwardType&q;:0,&q;useIntelligentRoom&q;:false,&q;hasStrokeKeynote&q;:true,&q;verticalModeType&q;:0,&q;originEpisodeId&q;:0,&q;supportRtmp&q;:false,&q;supportPk&q;:true,&q;supportLuckyBag&q;:true,&q;supportUserNoteStroke&q;:false,&q;communicateType&q;:0,&q;one2One&q;:false,&q;fakeLive&q;:false},&q;validStatus&q;:1,&q;supportLive&q;:true,&q;supportAiCatalog&q;:false,&q;hasIntelligentPen&q;:false,&q;useLocalRecording&q;:false,&q;useIntelligentRoom&q;:false,&q;hasSalePosition&q;:false,&q;hasEpisodeCards&q;:true,&q;lockedForShouna&q;:false,&q;needSignIn&q;:false,&q;needTeacherSignIn&q;:false,&q;enablePadPencil&q;:true,&q;displayExercise&q;:false,&q;supportLuckyBag&q;:true,&q;supportLivePk&q;:true},{&q;id&q;:11094794,&q;kePrefix&q;:&q;sydw&q;,&q;courseId&q;:6,&q;status&q;:3,&q;playStatus&q;:3,&q;type&q;:33,&q;recordingType&q;:0,&q;mediaType&q;:0,&q;title&q;:&q;【判断】精选好题 沉浸刷题&q;,&q;innerTitle&q;:&q;&q;,&q;startTime&q;:1761271200000,&q;endTime&q;:1761278400000,&q;teacher&q;:{&q;id&q;:25387,&q;userId&q;:60845482,&q;name&q;:&q;余嘉怡&q;,&q;brief&q;:&q;粉笔优质讲师&q;,&q;desc&q;:&q;粉笔优质教师\n6年一线教学经验。\n具有丰富的的实践经验和专业系统的理论知识，多次参与粉笔判断授课研讨，教学教研能力扎实。\n授课思路清晰，语言通俗易懂，让学生在轻松的学习氛围中，善于引导学生思考，用更简单的方法，帮助学生找到更快捷的解题之道，深受学员好评。&q;,&q;avatar&q;:&q;1768392a849ac12.jpg&q;,&q;upperBodyPhoto&q;:null,&q;displayCoursePrefix&q;:&q;sydw&q;,&q;teacherStat&q;:{&q;teacherId&q;:25387,&q;episodeCount&q;:583,&q;scoreCount&q;:1076,&q;avgScore&q;:9.851301115241625,&q;fiveGradeAvgScore&q;:4.93,&q;updateTime&q;:1773583624765},&q;auditionEpisode&q;:null,&q;memberOfCPC&q;:false,&q;tags&q;:null},&q;teachChannel&q;:1,&q;offline&q;:null,&q;duration&q;:7675,&q;hasAudition&q;:false,&q;bizType&q;:0,&q;bizId&q;:&q;726825&q;,&q;supportReplay&q;:true,&q;extraInfo&q;:null,&q;liveConfig&q;:{&q;episodeId&q;:11094794,&q;supportMultiGroup&q;:false,&q;exerciseBizType&q;:0,&q;videoDisplayType&q;:0,&q;avForwardType&q;:0,&q;useIntelligentRoom&q;:false,&q;hasStrokeKeynote&q;:true,&q;verticalModeType&q;:0,&q;originEpisodeId&q;:0,&q;supportRtmp&q;:false,&q;supportPk&q;:true,&q;supportLuckyBag&q;:true,&q;supportUserNoteStroke&q;:false,&q;communicateType&q;:0,&q;one2One&q;:false,&q;fakeLive&q;:false},&q;validStatus&q;:1,&q;supportLive&q;:true,&q;supportAiCatalog&q;:false,&q;hasIntelligentPen&q;:false,&q;useLocalRecording&q;:false,&q;useIntelligentRoom&q;:false,&q;hasSalePosition&q;:false,&q;hasEpisodeCards&q;:true,&q;lockedForShouna&q;:false,&q;needSignIn&q;:false,&q;needTeacherSignIn&q;:false,&q;enablePadPencil&q;:true,&q;displayExercise&q;:false,&q;supportLuckyBag&q;:true,&q;supportLivePk&q;:true},{&q;id&q;:11094795,&q;kePrefix&q;:&q;sydw&q;,&q;courseId&q;:6,&q;status&q;:3,&q;playStatus&q;:3,&q;type&q;:33,&q;recordingType&q;:0,&q;mediaType&q;:0,&q;title&q;:&q;【公基非法】精选好题 沉浸刷题&q;,&q;innerTitle&q;:&q;&q;,&q;startTime&q;:1761278400000,&q;endTime&q;:1761285600000,&q;teacher&q;:{&q;id&q;:52906,&q;userId&q;:88669957,&q;name&q;:&q;陶静&q;,&q;brief&q;:&q;粉笔优质讲师&q;,&q;desc&q;:&q;粉笔优质讲师\n6年一线教学，深耕线上线下授课，累计覆盖全国超万名学员，授课时长已突破2500小时，教学经验扎实且全面。\n深耕常识与公共基础知识、判断科目领域，兼具扎实的专业理论功底与丰富实践经验。对全国多地考试考情、真题规律及命题趋势有着深刻洞察，授课理念独到新颖，始终秉持理论与实践相结合的教学原则，致力于帮助学员系统掌握解题技巧，让大家在轻松高效的学习氛围中稳步提升。\n授课风格独树一帜，条理清晰，又风趣幽默，把复杂课程内容拆解得层次分明、脉络清晰，让学员轻松跟上学习节奏，再搭配专业完善的教学体系，学习效率直接拉满。&q;,&q;avatar&q;:&q;1984fe9e02e27a3.jpg&q;,&q;upperBodyPhoto&q;:null,&q;displayCoursePrefix&q;:&q;sydw&q;,&q;teacherStat&q;:{&q;teacherId&q;:52906,&q;episodeCount&q;:640,&q;scoreCount&q;:952,&q;avgScore&q;:9.83823529411764,&q;fiveGradeAvgScore&q;:4.92,&q;updateTime&q;:1773495035648},&q;auditionEpisode&q;:{&q;episodeTitle&q;:&q;个人展示课&q;,&q;episodeVideoUrl&q;:&q;https://vod.fbstatic.cn/22e9ceb2vodbj1251001446/d568fd2c1397757888047530032/UZNkfXcuVicA.mp4?t=f2a4b300&a;us=4070880000&a;sign=a17687f4fba4def68220de9a1cbf4eef&q;},&q;memberOfCPC&q;:false,&q;tags&q;:null},&q;teachChannel&q;:1,&q;offline&q;:null,&q;duration&q;:7284,&q;hasAudition&q;:false,&q;bizType&q;:0,&q;bizId&q;:&q;726825&q;,&q;supportReplay&q;:true,&q;extraInfo&q;:null,&q;liveConfig&q;:{&q;episodeId&q;:11094795,&q;supportMultiGroup&q;:false,&q;exerciseBizType&q;:0,&q;videoDisplayType&q;:0,&q;avForwardType&q;:0,&q;useIntelligentRoom&q;:false,&q;hasStrokeKeynote&q;:true,&q;verticalModeType&q;:0,&q;originEpisodeId&q;:0,&q;supportRtmp&q;:false,&q;supportPk&q;:true,&q;supportLuckyBag&q;:true,&q;supportUserNoteStroke&q;:false,&q;communicateType&q;:0,&q;one2One&q;:false,&q;fakeLive&q;:false},&q;validStatus&q;:1,&q;supportLive&q;:true,&q;supportAiCatalog&q;:false,&q;hasIntelligentPen&q;:false,&q;useLocalRecording&q;:false,&q;useIntelligentRoom&q;:false,&q;hasSalePosition&q;:false,&q;hasEpisodeCards&q;:true,&q;lockedForShouna&q;:false,&q;needSignIn&q;:false,&q;needTeacherSignIn&q;:false,&q;enablePadPencil&q;:true,&q;displayExercise&q;:false,&q;supportLuckyBag&q;:true,&q;supportLivePk&q;:true},{&q;id&q;:11094796,&q;kePrefix&q;:&q;sydw&q;,&q;courseId&q;:6,&q;status&q;:3,&q;playStatus&q;:3,&q;type&q;:33,&q;recordingType&q;:0,&q;mediaType&q;:0,&q;title&q;:&q;【数资】精选好题 沉浸刷题&q;,&q;innerTitle&q;:&q;&q;,&q;startTime&q;:1761285600000,&q;endTime&q;:1761292800000,&q;teacher&q;:{&q;id&q;:18293,&q;userId&q;:67808406,&q;name&q;:&q;任忠生&q;,&q;brief&q;:&q;粉笔优质讲师&q;,&q;desc&q;:&q;粉笔优质讲师\n6年一线教学经验，承担过线上线下多种课程，授课经验丰富，深受学员喜爱，累计授课评分4.9分。\n授课思路清晰，风趣幽默，妙语连珠，课堂中知识与段子齐飞，答题声与欢笑声连成一片，课堂氛围极佳。\n定期参加粉笔笔试教研，多次参与真题解析以及真题解析视频录制，对笔试理论体系有深入的研究，了解最新命题趋势方向。&q;,&q;avatar&q;:&q;193b4b22415b966.jpg&q;,&q;upperBodyPhoto&q;:null,&q;displayCoursePrefix&q;:&q;sydw&q;,&q;teacherStat&q;:{&q;teacherId&q;:18293,&q;episodeCount&q;:418,&q;scoreCount&q;:1609,&q;avgScore&q;:9.794903666873825,&q;fiveGradeAvgScore&q;:4.9,&q;updateTime&q;:1773490915782},&q;auditionEpisode&q;:{&q;episodeTitle&q;:&q;个人展示课&q;,&q;episodeVideoUrl&q;:&q;https://vod.fbstatic.cn/22e9ceb2vodbj1251001446/bfb29f3c5145403709545073450/6OUlHaE0u2UA.mp4?t=f2a4b300&a;us=4070880000&a;sign=4672d88aaa0f986bf84441ae77d619a3&q;},&q;memberOfCPC&q;:false,&q;tags&q;:null},&q;teachChannel&q;:1,&q;offline&q;:null,&q;duration&q;:7420,&q;hasAudition&q;:false,&q;bizType&q;:0,&q;bizId&q;:&q;726825&q;,&q;supportReplay&q;:true,&q;extraInfo&q;:null,&q;liveConfig&q;:{&q;episodeId&q;:11094796,&q;supportMultiGroup&q;:false,&q;exerciseBizType&q;:0,&q;videoDisplayType&q;:0,&q;avForwardType&q;:0,&q;useIntelligentRoom&q;:false,&q;hasStrokeKeynote&q;:true,&q;verticalModeType&q;:0,&q;originEpisodeId&q;:0,&q;supportRtmp&q;:false,&q;supportPk&q;:true,&q;supportLuckyBag&q;:true,&q;supportUserNoteStroke&q;:false,&q;communicateType&q;:0,&q;one2One&q;:false,&q;fakeLive&q;:false},&q;validStatus&q;:1,&q;supportLive&q;:true,&q;supportAiCatalog&q;:false,&q;hasIntelligentPen&q;:false,&q;useLocalRecording&q;:false,&q;useIntelligentRoom&q;:false,&q;hasSalePosition&q;:false,&q;hasEpisodeCards&q;:true,&q;lockedForShouna&q;:false,&q;needSignIn&q;:false,&q;needTeacherSignIn&q;:false,&q;enablePadPencil&q;:true,&q;displayExercise&q;:false,&q;supportLuckyBag&q;:true,&q;supportLivePk&q;:true},{&q;id&q;:11094797,&q;kePrefix&q;:&q;sydw&q;,&q;courseId&q;:6,&q;status&q;:3,&q;playStatus&q;:3,&q;type&q;:33,&q;recordingType&q;:0,&q;mediaType&q;:0,&q;title&q;:&q;【综应】精选好题 沉浸刷题&q;,&q;innerTitle&q;:&q;&q;,&q;startTime&q;:1761292800000,&q;endTime&q;:1761300000000,&q;teacher&q;:{&q;id&q;:13527,&q;userId&q;:72790831,&q;name&q;:&q;安爱霞&q;,&q;brief&q;:&q;粉笔优质讲师&q;,&q;desc&q;:&q;粉笔综应优质讲师。\n5年多一线综应教学和带班经验，累计授课时长1200+，带班人次2000+，所带班级进面率高，学员整体评分5.0。\n多次参加粉笔综应科目教研，熟悉各类事业单位综应科目命题规律，重难点及不同题型的答题思路和方法，对联考、山东、江苏、浙江等省份事业单位的考情和备考策略了然于胸，专业知识扎实，带班经验丰富。\n清新温和，擅长总结做题规律和答题技巧，能够举一反三，帮助同学通过一道题掌握一类题的解题思路，谙熟学生各个阶段的备考心理，善于思维点拨和个性化辅导，实践性强，深受学员喜爱。&q;,&q;avatar&q;:&q;1737ee8a423e625.jpg&q;,&q;upperBodyPhoto&q;:null,&q;displayCoursePrefix&q;:&q;sydw&q;,&q;teacherStat&q;:{&q;teacherId&q;:13527,&q;episodeCount&q;:432,&q;scoreCount&q;:650,&q;avgScore&q;:9.95076923076923,&q;fiveGradeAvgScore&q;:4.98,&q;updateTime&q;:1773460026169},&q;auditionEpisode&q;:{&q;episodeTitle&q;:&q;个人展示课&q;,&q;episodeVideoUrl&q;:&q;https://vod.fbstatic.cn/22e9ceb2vodbj1251001446/c89b3a775145403709545414401/EobO1hNUCfwA.mp4?t=f2a4b300&a;us=4070880000&a;sign=235394db2773c64ad274454799390cd9&q;},&q;memberOfCPC&q;:false,&q;tags&q;:null},&q;teachChannel&q;:1,&q;offline&q;:null,&q;duration&q;:7342,&q;hasAudition&q;:false,&q;bizType&q;:0,&q;bizId&q;:&q;726825&q;,&q;supportReplay&q;:true,&q;extraInfo&q;:null,&q;liveConfig&q;:{&q;episodeId&q;:11094797,&q;supportMultiGroup&q;:false,&q;exerciseBizType&q;:0,&q;videoDisplayType&q;:0,&q;avForwardType&q;:0,&q;useIntelligentRoom&q;:false,&q;hasStrokeKeynote&q;:true,&q;verticalModeType&q;:0,&q;originEpisodeId&q;:0,&q;supportRtmp&q;:false,&q;supportPk&q;:true,&q;supportLuckyBag&q;:true,&q;supportUserNoteStroke&q;:false,&q;communicateType&q;:0,&q;one2One&q;:false,&q;fakeLive&q;:false},&q;validStatus&q;:1,&q;supportLive&q;:true,&q;supportAiCatalog&q;:false,&q;hasIntelligentPen&q;:false,&q;useLocalRecording&q;:false,&q;useIntelligentRoom&q;:false,&q;hasSalePosition&q;:false,&q;hasEpisodeCards&q;:true,&q;lockedForShouna&q;:false,&q;needSignIn&q;:false,&q;needTeacherSignIn&q;:false,&q;enablePadPencil&q;:true,&q;displayExercise&q;:false,&q;supportLuckyBag&q;:true,&q;supportLivePk&q;:true},{&q;id&q;:11096047,&q;kePrefix&q;:&q;sydw&q;,&q;courseId&q;:6,&q;status&q;:3,&q;playStatus&q;:3,&q;type&q;:33,&q;recordingType&q;:0,&q;mediaType&q;:0,&q;title&q;:&q;【数资】精选好题 沉浸刷题&q;,&q;innerTitle&q;:&q;&q;,&q;startTime&q;:1761357600000,&q;endTime&q;:1761364800000,&q;teacher&q;:{&q;id&q;:16574,&q;userId&q;:73028298,&q;name&q;:&q;廖雅云&q;,&q;brief&q;:&q;粉笔优质讲师&q;,&q;desc&q;:&q;粉笔优质讲师\n多年一线教学授课经验，深耕事业单位考试，承担过笔试精品班、刷题班、冲刺班等多种班型,授课经验丰富。\n深入了解职测数资近年来的考情、重难点以及不同考点的解题技巧，理论扎实。\n参与笔试真题教研和解析撰写、终审工作,并多次参与图书以及相关资料的编写，对数资最新命题趋势方向有深入研究；\n多次参加粉笔授课研讨会议，针对学生困惑研究教学策略，拓展考场思维，能够帮助学员将所学理论更好应用在实际解题当中，拓展解题思路；\n授课风格:授课累计评分达4.9分，讲课耐心细致，课堂氛围轻松活跃，与学员重在沟通，能够从学员角度出发去找问题、解决问题，深受学员的喜爱。&q;,&q;avatar&q;:&q;19854f590ec1eda.jpg&q;,&q;upperBodyPhoto&q;:null,&q;displayCoursePrefix&q;:&q;sydw&q;,&q;teacherStat&q;:{&q;teacherId&q;:16574,&q;episodeCount&q;:739,&q;scoreCount&q;:6952,&q;avgScore&q;:9.825373993095512,&q;fiveGradeAvgScore&q;:4.91,&q;updateTime&q;:1773622398088},&q;auditionEpisode&q;:{&q;episodeTitle&q;:&q;个人展示课&q;,&q;episodeVideoUrl&q;:&q;https://vod.fbstatic.cn/22e9ceb2vodbj1251001446/725c3a375145403709544020247/E4rt1kFdZL4A.mp4?t=f2a4b300&a;us=4070880000&a;sign=423b76444fe4ed707f565354eef136e2&q;},&q;memberOfCPC&q;:false,&q;tags&q;:null},&q;teachChannel&q;:1,&q;offline&q;:null,&q;duration&q;:7850,&q;hasAudition&q;:false,&q;bizType&q;:0,&q;bizId&q;:&q;726825&q;,&q;supportReplay&q;:true,&q;extraInfo&q;:null,&q;liveConfig&q;:{&q;episodeId&q;:11096047,&q;supportMultiGroup&q;:false,&q;exerciseBizType&q;:0,&q;videoDisplayType&q;:0,&q;avForwardType&q;:0,&q;useIntelligentRoom&q;:false,&q;hasStrokeKeynote&q;:true,&q;verticalModeType&q;:0,&q;originEpisodeId&q;:0,&q;supportRtmp&q;:false,&q;supportPk&q;:true,&q;supportLuckyBag&q;:true,&q;supportUserNoteStroke&q;:false,&q;communicateType&q;:0,&q;one2One&q;:false,&q;fakeLive&q;:false},&q;validStatus&q;:1,&q;supportLive&q;:true,&q;supportAiCatalog&q;:false,&q;hasIntelligentPen&q;:false,&q;useLocalRecording&q;:false,&q;useIntelligentRoom&q;:false,&q;hasSalePosition&q;:false,&q;hasEpisodeCards&q;:true,&q;lockedForShouna&q;:false,&q;needSignIn&q;:false,&q;needTeacherSignIn&q;:false,&q;enablePadPencil&q;:true,&q;displayExercise&q;:false,&q;supportLuckyBag&q;:true,&q;supportLivePk&q;:true},{&q;id&q;:11096126,&q;kePrefix&q;:&q;sydw&q;,&q;courseId&q;:6,&q;status&q;:3,&q;playStatus&q;:3,&q;type&q;:33,&q;recordingType&q;:0,&q;mediaType&q;:0,&q;title&q;:&q;【言语】精选好题 沉浸刷题&q;,&q;innerTitle&q;:&q;&q;,&q;startTime&q;:1761372000000,&q;endTime&q;:1761379200000,&q;teacher&q;:{&q;id&q;:56429,&q;userId&q;:74160353,&q;name&q;:&q;邱宜静&q;,&q;brief&q;:&q;粉笔优质讲师&q;,&q;desc&q;:&q;粉笔优质教师\n五年一线教学授课经验，长期致力于事业单位考试研究与教学，对事业单位招聘考试体系有着深入的理解和扎实的教学经验。\n具有言语科目丰富的实践经验及系统扎实的专业理论知识和对事业单位言语考情的深入研究:\n多次参与笔试真题教研和解析撰写工作，对言语命题趋势方向有着深入的研究;\n多次参加粉笔授课研讨会议，深入研讨事考言语命题趋势及最新考情;\n授课特点:擅长将复杂的知识点转化为易于理解的教学内容，通过循序渐进的教学方式，引导学生逐步掌握所需的知识点，帮助学员快速掌握言语科目的核心要点，提升解题能力和应试技巧，成功帮助数百名考生顺利通过事业单位招聘考试。&q;,&q;avatar&q;:&q;18408e0ee9a5e5d.jpg&q;,&q;upperBodyPhoto&q;:null,&q;displayCoursePrefix&q;:&q;sydw&q;,&q;teacherStat&q;:{&q;teacherId&q;:56429,&q;episodeCount&q;:185,&q;scoreCount&q;:627,&q;avgScore&q;:9.763955342902712,&q;fiveGradeAvgScore&q;:4.88,&q;updateTime&q;:1773327807084},&q;auditionEpisode&q;:{&q;episodeTitle&q;:&q;个人展示课&q;,&q;episodeVideoUrl&q;:&q;https://vod.fbstatic.cn/22e9ceb2vodbj1251001446/cfc0c3501253642695688501785/bsDyySXGJLgA.mp4?t=f2a4b300&a;us=4070880000&a;sign=41a1d807640af0e9a33d92a3917850c4&q;},&q;memberOfCPC&q;:false,&q;tags&q;:null},&q;teachChannel&q;:1,&q;offline&q;:null,&q;duration&q;:8409,&q;hasAudition&q;:false,&q;bizType&q;:0,&q;bizId&q;:&q;726825&q;,&q;supportReplay&q;:true,&q;extraInfo&q;:null,&q;liveConfig&q;:{&q;episodeId&q;:11096126,&q;supportMultiGroup&q;:false,&q;exerciseBizType&q;:0,&q;videoDisplayType&q;:0,&q;avForwardType&q;:0,&q;useIntelligentRoom&q;:false,&q;hasStrokeKeynote&q;:true,&q;verticalModeType&q;:0,&q;originEpisodeId&q;:0,&q;supportRtmp&q;:false,&q;supportPk&q;:true,&q;supportLuckyBag&q;:true,&q;supportUserNoteStroke&q;:false,&q;communicateType&q;:0,&q;one2One&q;:false,&q;fakeLive&q;:false},&q;validStatus&q;:1,&q;supportLive&q;:true,&q;supportAiCatalog&q;:false,&q;hasIntelligentPen&q;:false,&q;useLocalRecording&q;:false,&q;useIntelligentRoom&q;:false,&q;hasSalePosition&q;:false,&q;hasEpisodeCards&q;:true,&q;lockedForShouna&q;:false,&q;needSignIn&q;:false,&q;needTeacherSignIn&q;:false,&q;enablePadPencil&q;:true,&q;displayExercise&q;:false,&q;supportLuckyBag&q;:true,&q;supportLivePk&q;:true},{&q;id&q;:11096154,&q;kePrefix&q;:&q;sydw&q;,&q;courseId&q;:6,&q;status&q;:3,&q;playStatus&q;:3,&q;type&q;:33,&q;recordingType&q;:0,&q;mediaType&q;:0,&q;title&q;:&q;【判断】精选好题 沉浸刷题&q;,&q;innerTitle&q;:&q;&q;,&q;startTime&q;:1761444000000,&q;endTime&q;:1761451200000,&q;teacher&q;:{&q;id&q;:26520,&q;userId&q;:63229933,&q;name&q;:&q;胡佳欢&q;,&q;brief&q;:&q;粉笔优质讲师&q;,&q;desc&q;:&q;粉笔优质教师\n6年一线教学授课经验，授课思路清晰，语言通俗易懂，善于引导学员思考，深受广大学员的认可和好评。\n累计评分达4.9分，授课逻辑清晰，耐心细致，善于总结学习方法，能够帮助学员举一反三、学以致用。\n多次参与粉笔判断授课研讨，能够熟练掌握笔试考情和命题趋势，具有判断科目丰富的实践经验及系统扎实的专业理论知识。&q;,&q;avatar&q;:&q;176ac86208b0412.jpg&q;,&q;upperBodyPhoto&q;:null,&q;displayCoursePrefix&q;:&q;sydw&q;,&q;teacherStat&q;:{&q;teacherId&q;:26520,&q;episodeCount&q;:480,&q;scoreCount&q;:2615,&q;avgScore&q;:9.841682600382423,&q;fiveGradeAvgScore&q;:4.92,&q;updateTime&q;:1773565925020},&q;auditionEpisode&q;:{&q;episodeTitle&q;:&q;个人展示课&q;,&q;episodeVideoUrl&q;:&q;https://vod.fbstatic.cn/22e9ceb2vodbj1251001446/9ad51b645145403713947143855/qXaIJaoHik0A.mp4?t=f2a4b300&a;us=4070880000&a;sign=cff2cd400b2cd41eabd3f8407019a6d3&q;},&q;memberOfCPC&q;:false,&q;tags&q;:null},&q;teachChannel&q;:1,&q;offline&q;:null,&q;duration&q;:8414,&q;hasAudition&q;:false,&q;bizType&q;:0,&q;bizId&q;:&q;726825&q;,&q;supportReplay&q;:true,&q;extraInfo&q;:null,&q;liveConfig&q;:{&q;episodeId&q;:11096154,&q;supportMultiGroup&q;:false,&q;exerciseBizType&q;:0,&q;videoDisplayType&q;:0,&q;avForwardType&q;:0,&q;useIntelligentRoom&q;:false,&q;hasStrokeKeynote&q;:true,&q;verticalModeType&q;:0,&q;originEpisodeId&q;:0,&q;supportRtmp&q;:false,&q;supportPk&q;:true,&q;supportLuckyBag&q;:true,&q;supportUserNoteStroke&q;:false,&q;communicateType&q;:0,&q;one2One&q;:false,&q;fakeLive&q;:false},&q;validStatus&q;:1,&q;supportLive&q;:true,&q;supportAiCatalog&q;:false,&q;hasIntelligentPen&q;:false,&q;useLocalRecording&q;:false,&q;useIntelligentRoom&q;:false,&q;hasSalePosition&q;:false,&q;hasEpisodeCards&q;:true,&q;lockedForShouna&q;:false,&q;needSignIn&q;:false,&q;needTeacherSignIn&q;:false,&q;enablePadPencil&q;:true,&q;displayExercise&q;:false,&q;supportLuckyBag&q;:true,&q;supportLivePk&q;:true},{&q;id&q;:11096164,&q;kePrefix&q;:&q;sydw&q;,&q;courseId&q;:6,&q;status&q;:3,&q;playStatus&q;:3,&q;type&q;:33,&q;recordingType&q;:0,&q;mediaType&q;:0,&q;title&q;:&q;【综应】精选好题 沉浸刷题&q;,&q;innerTitle&q;:&q;&q;,&q;startTime&q;:1761451200000,&q;endTime&q;:1761458400000,&q;teacher&q;:{&q;id&q;:33486,&q;userId&q;:52618928,&q;name&q;:&q;艾思莹&q;,&q;brief&q;:&q;粉笔优质讲师&q;,&q;desc&q;:&q;粉笔优质讲师\n6年一线教学经验，辅导学员数千人，累计授课评分4.9分，承接各类型线上线下精品班，深耕事业单位笔试，善于以考场思维审视题目，助力多位学员高分上岸。\n长期参与内部教研工作，定期参与真题解析录制，对最新命题方向、考试重点有深入研究。\n理论基础扎实，授课思路清晰，擅长理论与实际相结合。能够激发学员学习热情和自主意识，让学员可以在轻松愉快的氛围中学习，跟着老师节奏主动思考，深受学员一致好评和喜爱。&q;,&q;avatar&q;:&q;1798d8fc9d33bea.jpg&q;,&q;upperBodyPhoto&q;:null,&q;displayCoursePrefix&q;:&q;sydw&q;,&q;teacherStat&q;:{&q;teacherId&q;:33486,&q;episodeCount&q;:408,&q;scoreCount&q;:460,&q;avgScore&q;:9.839130434782604,&q;fiveGradeAvgScore&q;:4.92,&q;updateTime&q;:1773623079529},&q;auditionEpisode&q;:{&q;episodeTitle&q;:&q;社会现象&q;,&q;episodeVideoUrl&q;:&q;https://vod.fbstatic.cn/22e9ceb2vodbj1251001446/76dd9c915145403709537492897/eQAVoEQ87mAA.mp4?t=f2a4b300&a;us=4070880000&a;sign=ef57ee8d5c8eca5e1bcee39dbc785fe4&q;},&q;memberOfCPC&q;:false,&q;tags&q;:null},&q;teachChannel&q;:1,&q;offline&q;:null,&q;duration&q;:7878,&q;hasAudition&q;:false,&q;bizType&q;:0,&q;bizId&q;:&q;726825&q;,&q;supportReplay&q;:true,&q;extraInfo&q;:null,&q;liveConfig&q;:{&q;episodeId&q;:11096164,&q;supportMultiGroup&q;:false,&q;exerciseBizType&q;:0,&q;videoDisplayType&q;:0,&q;avForwardType&q;:0,&q;useIntelligentRoom&q;:false,&q;hasStrokeKeynote&q;:true,&q;verticalModeType&q;:0,&q;originEpisodeId&q;:0,&q;supportRtmp&q;:false,&q;supportPk&q;:true,&q;supportLuckyBag&q;:true,&q;supportUserNoteStroke&q;:false,&q;communicateType&q;:0,&q;one2One&q;:false,&q;fakeLive&q;:false},&q;validStatus&q;:1,&q;supportLive&q;:true,&q;supportAiCatalog&q;:false,&q;hasIntelligentPen&q;:false,&q;useLocalRecording&q;:false,&q;useIntelligentRoom&q;:false,&q;hasSalePosition&q;:false,&q;hasEpisodeCards&q;:true,&q;lockedForShouna&q;:false,&q;needSignIn&q;:false,&q;needTeacherSignIn&q;:false,&q;enablePadPencil&q;:true,&q;displayExercise&q;:false,&q;supportLuckyBag&q;:true,&q;supportLivePk&q;:true},{&q;id&q;:11096186,&q;kePrefix&q;:&q;sydw&q;,&q;courseId&q;:6,&q;status&q;:3,&q;playStatus&q;:3,&q;type&q;:33,&q;recordingType&q;:0,&q;mediaType&q;:0,&q;title&q;:&q;【数资】精选好题 沉浸刷题&q;,&q;innerTitle&q;:&q;&q;,&q;startTime&q;:1761530400000,&q;endTime&q;:1761537600000,&q;teacher&q;:{&q;id&q;:16588,&q;userId&q;:73651929,&q;name&q;:&q;王雅平&q;,&q;brief&q;:&q;粉笔优质讲师&q;,&q;desc&q;:&q;粉笔优质讲师\n6年一线教学经验，授课时长3000+小时，所带学员综合通过率达68%，具有数资科目丰富的实践经验及系统扎实的专业理论知识，对考情深入研究，授课经验丰富：①撰写多篇教研材料，在粉笔教师内部进行共享；②多次参加粉笔授课研讨会议，全面把握数资命题趋势及最新考情，积累丰富知识；③多次参加粉笔教研活动，分享授课经验心得。&q;,&q;avatar&q;:&q;17467ff056cb0e3.jpg&q;,&q;upperBodyPhoto&q;:null,&q;displayCoursePrefix&q;:&q;sydw&q;,&q;teacherStat&q;:{&q;teacherId&q;:16588,&q;episodeCount&q;:645,&q;scoreCount&q;:1598,&q;avgScore&q;:9.801001251564475,&q;fiveGradeAvgScore&q;:4.9,&q;updateTime&q;:1773543164175},&q;auditionEpisode&q;:{&q;episodeTitle&q;:&q;个人展示课&q;,&q;episodeVideoUrl&q;:&q;https://vod.fbstatic.cn/22e9ceb2vodbj1251001446/3d7922af5145403708051711222/4CdLbW9JRzEA.mp4?t=f2a4b300&a;us=4070880000&a;sign=db9e82e392a8449558ccd8e4eedf3845&q;},&q;memberOfCPC&q;:false,&q;tags&q;:null},&q;teachChannel&q;:1,&q;offline&q;:null,&q;duration&q;:9528,&q;hasAudition&q;:false,&q;bizType&q;:0,&q;bizId&q;:&q;726825&q;,&q;supportReplay&q;:true,&q;extraInfo&q;:null,&q;liveConfig&q;:{&q;episodeId&q;:11096186,&q;supportMultiGroup&q;:false,&q;exerciseBizType&q;:0,&q;videoDisplayType&q;:0,&q;avForwardType&q;:0,&q;useIntelligentRoom&q;:false,&q;hasStrokeKeynote&q;:true,&q;verticalModeType&q;:0,&q;originEpisodeId&q;:0,&q;supportRtmp&q;:false,&q;supportPk&q;:true,&q;supportLuckyBag&q;:true,&q;supportUserNoteStroke&q;:false,&q;communicateType&q;:0,&q;one2One&q;:false,&q;fakeLive&q;:false},&q;validStatus&q;:1,&q;supportLive&q;:true,&q;supportAiCatalog&q;:false,&q;hasIntelligentPen&q;:false,&q;useLocalRecording&q;:false,&q;useIntelligentRoom&q;:false,&q;hasSalePosition&q;:false,&q;hasEpisodeCards&q;:true,&q;lockedForShouna&q;:false,&q;needSignIn&q;:false,&q;needTeacherSignIn&q;:false,&q;enablePadPencil&q;:true,&q;displayExercise&q;:false,&q;supportLuckyBag&q;:true,&q;supportLivePk&q;:true},{&q;id&q;:11096210,&q;kePrefix&q;:&q;sydw&q;,&q;courseId&q;:6,&q;status&q;:3,&q;playStatus&q;:3,&q;type&q;:33,&q;recordingType&q;:0,&q;mediaType&q;:0,&q;title&q;:&q;【公基法律】精选好题 沉浸刷题&q;,&q;innerTitle&q;:&q;&q;,&q;startTime&q;:1761537600000,&q;endTime&q;:1761544800000,&q;teacher&q;:{&q;id&q;:32713,&q;userId&q;:74303567,&q;name&q;:&q;李佳琪&q;,&q;brief&q;:&q;粉笔优质讲师&q;,&q;desc&q;:&q;粉笔优质讲师\n5年一线教学经验，承担过线上多种班型。\n承担常识公基法律与判断推理两个学科领域的督学与授课，相关理论内容基础扎实，日常承担多项工作，包括真题解析、单题录制、撰写教研文章以及直播授课等，总授课时长超过一千小时。\n学员口碑：课程累计评分为达4.9，课堂氛围轻松，考点讲解清晰，擅长举例讲解，让学员易于接受知识点。课堂上也善于引导学员思考，加深对考点的记忆，备受学员喜爱。&q;,&q;avatar&q;:&q;1984f1cfc0e94f5.jpg&q;,&q;upperBodyPhoto&q;:null,&q;displayCoursePrefix&q;:&q;sydw&q;,&q;teacherStat&q;:{&q;teacherId&q;:32713,&q;episodeCount&q;:636,&q;scoreCount&q;:868,&q;avgScore&q;:9.887096774193548,&q;fiveGradeAvgScore&q;:4.94,&q;updateTime&q;:1773579049093},&q;auditionEpisode&q;:{&q;episodeTitle&q;:&q;个人展示课&q;,&q;episodeVideoUrl&q;:&q;https://vod.fbstatic.cn/22e9ceb2vodbj1251001446/ca9a07581397757888016826661/lrMasTgKVqQA.mp4?t=f2a4b300&a;us=4070880000&a;sign=2b5bbe0bde9ea6d06b056222865a2b6a&q;},&q;memberOfCPC&q;:false,&q;tags&q;:null},&q;teachChannel&q;:1,&q;offline&q;:null,&q;duration&q;:8451,&q;hasAudition&q;:false,&q;bizType&q;:0,&q;bizId&q;:&q;726825&q;,&q;supportReplay&q;:true,&q;extraInfo&q;:null,&q;liveConfig&q;:{&q;episodeId&q;:11096210,&q;supportMultiGroup&q;:false,&q;exerciseBizType&q;:0,&q;videoDisplayType&q;:0,&q;avForwardType&q;:0,&q;useIntelligentRoom&q;:false,&q;hasStrokeKeynote&q;:true,&q;verticalModeType&q;:0,&q;originEpisodeId&q;:0,&q;supportRtmp&q;:false,&q;supportPk&q;:true,&q;supportLuckyBag&q;:true,&q;supportUserNoteStroke&q;:false,&q;communicateType&q;:0,&q;one2One&q;:false,&q;fakeLive&q;:false},&q;validStatus&q;:1,&q;supportLive&q;:true,&q;supportAiCatalog&q;:false,&q;hasIntelligentPen&q;:false,&q;useLocalRecording&q;:false,&q;useIntelligentRoom&q;:false,&q;hasSalePosition&q;:false,&q;hasEpisodeCards&q;:true,&q;lockedForShouna&q;:false,&q;needSignIn&q;:false,&q;needTeacherSignIn&q;:false,&q;enablePadPencil&q;:true,&q;displayExercise&q;:false,&q;supportLuckyBag&q;:true,&q;supportLivePk&q;:true},{&q;id&q;:11096229,&q;kePrefix&q;:&q;sydw&q;,&q;courseId&q;:6,&q;status&q;:3,&q;playStatus&q;:3,&q;type&q;:33,&q;recordingType&q;:0,&q;mediaType&q;:0,&q;title&q;:&q;【言语】精选好题 沉浸刷题&q;,&q;innerTitle&q;:&q;&q;,&q;startTime&q;:1761544800000,&q;endTime&q;:1761552000000,&q;teacher&q;:{&q;id&q;:18603,&q;userId&q;:68241941,&q;name&q;:&q;陈小微&q;,&q;brief&q;:&q;粉笔优质讲师&q;,&q;desc&q;:&q;粉笔优质教师\n双一流硕士毕业，六年一线教学经验，深耕事业单位考试，对考情分析、命题思路深入钻研。\n具有言语科目丰富的实践经验及系统扎实的专业理论知识。\n善用启发式的授课方法，注重题目分析的严谨性与授课的逻辑性，让学生在轻松的学习氛围中，用更简单的方法，找到更快捷的解题之道，授课累计评分4.9，深受广大学员的认可和好评。            \n多次参与粉笔授课研讨会议，注重自我提升，不断夯实与更新教学讲法。&q;,&q;avatar&q;:&q;174cea1032f86a6.jpg&q;,&q;upperBodyPhoto&q;:null,&q;displayCoursePrefix&q;:&q;sydw&q;,&q;teacherStat&q;:{&q;teacherId&q;:18603,&q;episodeCount&q;:285,&q;scoreCount&q;:1085,&q;avgScore&q;:9.88018433179723,&q;fiveGradeAvgScore&q;:4.94,&q;updateTime&q;:1773613889725},&q;auditionEpisode&q;:{&q;episodeTitle&q;:&q;个人展示课&q;,&q;episodeVideoUrl&q;:&q;https://vod.fbstatic.cn/22e9ceb2vodbj1251001446/e1f5f7455145403709542456268/X8EEqKKa2aYA.mp4?t=f2a4b300&a;us=4070880000&a;sign=2c3fe60aa2311d5b5129c494fd5245a0&q;},&q;memberOfCPC&q;:false,&q;tags&q;:null},&q;teachChannel&q;:1,&q;offline&q;:null,&q;duration&q;:8039,&q;hasAudition&q;:false,&q;bizType&q;:0,&q;bizId&q;:&q;726825&q;,&q;supportReplay&q;:true,&q;extraInfo&q;:null,&q;liveConfig&q;:{&q;episodeId&q;:11096229,&q;supportMultiGroup&q;:false,&q;exerciseBizType&q;:0,&q;videoDisplayType&q;:0,&q;avForwardType&q;:0,&q;useIntelligentRoom&q;:false,&q;hasStrokeKeynote&q;:true,&q;verticalModeType&q;:0,&q;originEpisodeId&q;:0,&q;supportRtmp&q;:false,&q;supportPk&q;:true,&q;supportLuckyBag&q;:true,&q;supportUserNoteStroke&q;:false,&q;communicateType&q;:0,&q;one2One&q;:false,&q;fakeLive&q;:false},&q;validStatus&q;:1,&q;supportLive&q;:true,&q;supportAiCatalog&q;:false,&q;hasIntelligentPen&q;:false,&q;useLocalRecording&q;:false,&q;useIntelligentRoom&q;:false,&q;hasSalePosition&q;:f