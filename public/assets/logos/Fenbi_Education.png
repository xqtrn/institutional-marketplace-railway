&q;videoDisplayType&q;:0,&q;avForwardType&q;:0,&q;useIntelligentRoom&q;:false,&q;hasStrokeKeynote&q;:true,&q;verticalModeType&q;:0,&q;originEpisodeId&q;:0,&q;supportRtmp&q;:false,&q;supportPk&q;:true,&q;supportLuckyBag&q;:true,&q;supportUserNoteStroke&q;:false,&q;communicateType&q;:0,&q;one2One&q;:false,&q;fakeLive&q;:false},&q;validStatus&q;:1,&q;supportLive&q;:true,&q;supportAiCatalog&q;:false,&q;hasIntelligentPen&q;:false,&q;useLocalRecording&q;:false,&q;useIntelligentRoom&q;:false,&q;hasSalePosition&q;:false,&q;hasEpisodeCards&q;:true,&q;lockedForShouna&q;:false,&q;needSignIn&q;:false,&q;needTeacherSignIn&q;:false,&q;enablePadPencil&q;:true,&q;displayExercise&q;:false,&q;supportLuckyBag&q;:true,&q;supportLivePk&q;:true},{&q;id&q;:10922252,&q;kePrefix&q;:&q;sydw&q;,&q;courseId&q;:6,&q;status&q;:3,&q;playStatus&q;:3,&q;type&q;:33,&q;recordingType&q;:0,&q;mediaType&q;:0,&q;title&q;:&q;【公基非法】精选好题 沉浸刷题&q;,&q;innerTitle&q;:&q;&q;,&q;startTime&q;:1755050400000,&q;endTime&q;:1755057600000,&q;teacher&q;:{&q;id&q;:32970,&q;userId&q;:83438578,&q;name&q;:&q;朱湘依&q;,&q;brief&q;:&q;粉笔优质讲师&q;,&q;desc&q;:&q;粉笔优质讲师\n毕业于双一流院校，6年一线教学经验，承担线上、线下多种班型课程，授课经验丰富。\n承担常识公基非法律部分与数资科目授课、教研与培训工作。撰写多篇笔试教研材料。\n上课风格条理清晰，逻辑性强，擅长理论与实际相结合，授课有方法与技巧，积极引导并激发学员学习热情和自主意识，深受学员喜爱与好评。&q;,&q;avatar&q;:&q;1965c4972230508.jpg&q;,&q;upperBodyPhoto&q;:null,&q;displayCoursePrefix&q;:&q;sydw&q;,&q;teacherStat&q;:{&q;teacherId&q;:32970,&q;episodeCount&q;:707,&q;scoreCount&q;:1045,&q;avgScore&q;:9.666985645933023,&q;fiveGradeAvgScore&q;:4.83,&q;updateTime&q;:1773622939242},&q;auditionEpisode&q;:{&q;episodeTitle&q;:&q;个人展示课&q;,&q;episodeVideoUrl&q;:&q;https://vod.fbstatic.cn/22e9ceb2vodbj1251001446/499072d75145403715606210097/s5aPkRTv9zwA.mp4?t=f2a4b300&a;us=4070880000&a;sign=e5a5a9ce7c1f73488eb51fc79567a0aa&q;},&q;memberOfCPC&q;:false,&q;tags&q;:null},&q;teachChannel&q;:1,&q;offline&q;:null,&q;duration&q;:7275,&q;hasAudition&q;:false,&q;bizType&q;:0,&q;bizId&q;:&q;726825&q;,&q;supportReplay&q;:true,&q;extraInfo&q;:null,&q;liveConfig&q;:{&q;episodeId&q;:10922252,&q;supportMultiGroup&q;:false,&q;exerciseBizType&q;:0,&q;videoDisplayType&q;:0,&q;avForwardType&q;:0,&q;useIntelligentRoom&q;:false,&q;hasStrokeKeynote&q;:true,&q;verticalModeType&q;:0,&q;originEpisodeId&q;:0,&q;supportRtmp&q;:false,&q;supportPk&q;:true,&q;supportLuckyBag&q;:true,&q;supportUserNoteStroke&q;:false,&q;communicateType&q;:0,&q;one2One&q;:false,&q;fakeLive&q;:false},&q;validStatus&q;:1,&q;supportLive&q;:true,&q;supportAiCatalog&q;:false,&q;hasIntelligentPen&q;:false,&q;useLocalRecording&q;:false,&q;useIntelligentRoom&q;:false,&q;hasSalePosition&q;:false,&q;hasEpisodeCards&q;:true,&q;lockedForShouna&q;:false,&q;needSignIn&q;:false,&q;needTeacherSignIn&q;:false,&q;enablePadPencil&q;:true,&q;displayExercise&q;:false,&q;supportLuckyBag&q;:true,&q;supportLivePk&q;:true},{&q;id&q;:10922253,&q;kePrefix&q;:&q;sydw&q;,&q;courseId&q;:6,&q;status&q;:3,&q;playStatus&q;:3,&q;type&q;:33,&q;recordingType&q;:0,&q;mediaType&q;:0,&q;title&q;:&q;【数资】精选好题 沉浸刷题&q;,&q;innerTitle&q;:&q;&q;,&q;startTime&q;:1755057600000,&q;endTime&q;:1755064800000,&q;teacher&q;:{&q;id&q;:26292,&q;userId&q;:79327575,&q;name&q;:&q;郑美娟&q;,&q;brief&q;:&q;粉笔优质讲师&q;,&q;desc&q;:&q;粉笔数量关系与资料分析科目优质教师\n5年一线教学授课经验。\n具有数资科目丰富的实践经验及系统扎实的专业理论知识。多次参与粉笔数资授课研讨，教学教研能力扎实。承担过线下笔试精品班、刷题班、冲刺班等多种班型，授课经验丰富，思路清晰，讲解全面细致。\n授课形式生动形象，能够有针对性的引导学生进行主动思考，课堂氛围轻松无压力。擅长化繁为简，适合各个阶段的学生，深受广大学员好评。&q;,&q;avatar&q;:&q;1777f9e082273e5.jpg&q;,&q;upperBodyPhoto&q;:null,&q;displayCoursePrefix&q;:&q;sydw&q;,&q;teacherStat&q;:{&q;teacherId&q;:26292,&q;episodeCount&q;:567,&q;scoreCount&q;:1594,&q;avgScore&q;:9.803011292346305,&q;fiveGradeAvgScore&q;:4.9,&q;updateTime&q;:1773586366104},&q;auditionEpisode&q;:{&q;episodeTitle&q;:&q;个人展示课&q;,&q;episodeVideoUrl&q;:&q;https://vod.fbstatic.cn/22e9ceb2vodbj1251001446/9f3a48475145403713947309566/MDmpFEIP6G8A.mp4?t=f2a4b300&a;us=4070880000&a;sign=39fd01bda5913d3e938e577986d9db4b&q;},&q;memberOfCPC&q;:false,&q;tags&q;:null},&q;teachChannel&q;:1,&q;offline&q;:null,&q;duration&q;:8706,&q;hasAudition&q;:false,&q;bizType&q;:0,&q;bizId&q;:&q;726825&q;,&q;supportReplay&q;:true,&q;extraInfo&q;:null,&q;liveConfig&q;:{&q;episodeId&q;:10922253,&q;supportMultiGroup&q;:false,&q;exerciseBizType&q;:0,&q;videoDisplayType&q;:0,&q;avForwardType&q;:0,&q;useIntelligentRoom&q;:false,&q;hasStrokeKeynote&q;:true,&q;verticalModeType&q;:0,&q;originEpisodeId&q;:0,&q;supportRtmp&q;:false,&q;supportPk&q;:true,&q;supportLuckyBag&q;:true,&q;supportUserNoteStroke&q;:false,&q;communicateType&q;:0,&q;one2One&q;:false,&q;fakeLive&q;:false},&q;validStatus&q;:1,&q;supportLive&q;:true,&q;supportAiCatalog&q;:false,&q;hasIntelligentPen&q;:false,&q;useLocalRecording&q;:false,&q;useIntelligentRoom&q;:false,&q;hasSalePosition&q;:false,&q;hasEpisodeCards&q;:true,&q;lockedForShouna&q;:false,&q;needSignIn&q;:false,&q;needTeacherSignIn&q;:false,&q;enablePadPencil&q;:true,&q;displayExercise&q;:false,&q;supportLuckyBag&q;:true,&q;supportLivePk&q;:true},{&q;id&q;:10922335,&q;kePrefix&q;:&q;sydw&q;,&q;courseId&q;:6,&q;status&q;:3,&q;playStatus&q;:3,&q;type&q;:33,&q;recordingType&q;:0,&q;mediaType&q;:0,&q;title&q;:&q;【综应】精选好题 沉浸刷题&q;,&q;innerTitle&q;:&q;&q;,&q;startTime&q;:1755064800000,&q;endTime&q;:1755072000000,&q;teacher&q;:{&q;id&q;:35003,&q;userId&q;:83142599,&q;name&q;:&q;史芯蕊&q;,&q;brief&q;:&q;粉笔优质讲师&q;,&q;desc&q;:&q;粉笔优质讲师\n6年一线教学经验，承担过线上线下多种课程，包含安徽、武汉地区联考A，联考C，以及江苏等线下课程。线上部分以精品系统班，刷题班，线下考前冲刺班为主，授课经验丰富，深受学员喜爱，服务学员上千人，累计授课时长超千小时，授课评分4.9分。\n授课思路清晰，逻辑较强，善于从学员的角度切入，用更轻松的方式灵活运用答题技巧，同时给出学员针对性又个性化的指导方案。\n定期参加粉笔教研，多次参与真题解析以及真题解析视频录制，对理论体系有深入的研究，了解最新命题趋势方向。&q;,&q;avatar&q;:&q;18f656de50744c0.jpg&q;,&q;upperBodyPhoto&q;:null,&q;displayCoursePrefix&q;:&q;sydw&q;,&q;teacherStat&q;:{&q;teacherId&q;:35003,&q;episodeCount&q;:281,&q;scoreCount&q;:638,&q;avgScore&q;:9.877742946708466,&q;fiveGradeAvgScore&q;:4.94,&q;updateTime&q;:1773590037796},&q;auditionEpisode&q;:{&q;episodeTitle&q;:&q;个人展示课&q;,&q;episodeVideoUrl&q;:&q;https://vod.fbstatic.cn/22e9ceb2vodbj1251001446/fb1642195145403708057024670/r8VrOUODYOYA.mp4?t=f2a4b300&a;us=4070880000&a;sign=66f06661bf427c9cc98ffaf63d1aef4e&q;},&q;memberOfCPC&q;:false,&q;tags&q;:null},&q;teachChannel&q;:1,&q;offline&q;:null,&q;duration&q;:7919,&q;hasAudition&q;:false,&q;bizType&q;:0,&q;bizId&q;:&q;726825&q;,&q;supportReplay&q;:true,&q;extraInfo&q;:null,&q;liveConfig&q;:{&q;episodeId&q;:10922335,&q;supportMultiGroup&q;:false,&q;exerciseBizType&q;:0,&q;videoDisplayType&q;:0,&q;avForwardType&q;:0,&q;useIntelligentRoom&q;:false,&q;hasStrokeKeynote&q;:true,&q;verticalModeType&q;:0,&q;originEpisodeId&q;:0,&q;supportRtmp&q;:false,&q;supportPk&q;:true,&q;supportLuckyBag&q;:true,&q;supportUserNoteStroke&q;:false,&q;communicateType&q;:0,&q;one2One&q;:false,&q;fakeLive&q;:false},&q;validStatus&q;:1,&q;supportLive&q;:true,&q;supportAiCatalog&q;:false,&q;hasIntelligentPen&q;:false,&q;useLocalRecording&q;:false,&q;useIntelligentRoom&q;:false,&q;hasSalePosition&q;:false,&q;hasEpisodeCards&q;:true,&q;lockedForShouna&q;:false,&q;needSignIn&q;:false,&q;needTeacherSignIn&q;:false,&q;enablePadPencil&q;:true,&q;displayExercise&q;:false,&q;supportLuckyBag&q;:true,&q;supportLivePk&q;:true},{&q;id&q;:10922382,&q;kePrefix&q;:&q;sydw&q;,&q;courseId&q;:6,&q;status&q;:3,&q;playStatus&q;:3,&q;type&q;:33,&q;recordingType&q;:0,&q;mediaType&q;:0,&q;title&q;:&q;【判断】精选好题 沉浸刷题&q;,&q;innerTitle&q;:&q;&q;,&q;startTime&q;:1755072000000,&q;endTime&q;:1755079200000,&q;teacher&q;:{&q;id&q;:12512,&q;userId&q;:58005817,&q;name&q;:&q;王红艳&q;,&q;brief&q;:&q;粉笔优质讲师&q;,&q;desc&q;:&q;粉笔优质教师\n5年一线教学授课经验，具有判断科日丰富的实践经验及系统扎实的专业理论知识多次参加粉笔授课研讨会议，全面把握笔试命题趋势及最新考情，积累丰富笔试知识;多次参加粉笔教研活动，助力粉笔理论研发升级。 具有轻松愉快的授课风格，让学生在轻松的学习氛围中，用更简单的方法，找到更快捷的解题之道，深受广大学员的认可和好评;在学员中具有非常好的口碑，是值得信赖的好老师。&q;,&q;avatar&q;:&q;173282b5ad9bf5d.jpg&q;,&q;upperBodyPhoto&q;:null,&q;displayCoursePrefix&q;:&q;sydw&q;,&q;teacherStat&q;:{&q;teacherId&q;:12512,&q;episodeCount&q;:450,&q;scoreCount&q;:1751,&q;avgScore&q;:9.837806967447161,&q;fiveGradeAvgScore&q;:4.92,&q;updateTime&q;:1773544368704}