lse,&q;enablePadPencil&q;:false,&q;displayExercise&q;:false,&q;supportLuckyBag&q;:true,&q;supportLivePk&q;:true,&q;feedId&q;:&q;1_11975650&q;,&q;hasReserved&q;:false,&q;kePrefixName&q;:&q;公考笔试&q;},{&q;id&q;:11681300,&q;kePrefix&q;:&q;sydw&q;,&q;courseId&q;:6,&q;status&q;:0,&q;playStatus&q;:0,&q;type&q;:33,&q;recordingType&q;:0,&q;mediaType&q;:0,&q;title&q;:&q;【判断】精选好题 沉浸刷题&q;,&q;innerTitle&q;:&q;&q;,&q;startTime&q;:1773626400000,&q;endTime&q;:1773633600000,&q;teacher&q;:{&q;id&q;:25387,&q;userId&q;:60845482,&q;name&q;:&q;余嘉怡&q;,&q;brief&q;:&q;粉笔优质讲师&q;,&q;desc&q;:&q;粉笔优质教师\n6年一线教学经验。\n具有丰富的的实践经验和专业系统的理论知识，多次参与粉笔判断授课研讨，教学教研能力扎实。\n授课思路清晰，语言通俗易懂，让学生在轻松的学习氛围中，善于引导学生思考，用更简单的方法，帮助学生找到更快捷的解题之道，深受学员好评。&q;,&q;avatar&q;:&q;1768392a849ac12.jpg&q;,&q;upperBodyPhoto&q;:null,&q;displayCoursePrefix&q;:&q;&q;,&q;teacherStat&q;:{&q;teacherId&q;:25387,&q;episodeCount&q;:583,&q;scoreCount&q;:1076,&q;avgScore&q;:9.851301115241625,&q;fiveGradeAvgScore&q;:4.93,&q;updateTime&q;:1773583624765},&q;auditionEpisode&q;:null,&q;memberOfCPC&q;:false,&q;tags&q;:null},&q;teachChannel&q;:1,&q;offline&q;:null,&q;duration&q;:7200,&q;hasAudition&q;:false,&q;bizType&q;:56,&q;bizId&q;:&q;0&q;,&q;supportReplay&q;:true,&q;extraInfo&q;:null,&q;liveConfig&q;:{&q;episodeId&q;:11681300,&q;supportMultiGroup&q;:false,&q;exerciseBizType&q;:0,&q;videoDisplayType&q;:0,&q;avForwardType&q;:0,&q;useIntelligentRoom&q;:false,&q;hasStrokeKeynote&q;:false,&q;verticalModeType&q;:0,&q;originEpisodeId&q;:0,&q;supportRtmp&q;:false,&q;supportPk&q;:true,&q;supportLuckyBag&q;:true,&q;supportUserNoteStroke&q;:false,&q;communicateType&q;:0,&q;fakeLive&q;:false,&q;one2One&q;:false},&q;validStatus&q;:1,&q;supportLive&q;:true,&q;supportAiCatalog&q;:false,&q;hasIntelligentPen&q;:false,&q;useLocalRecording&q;:false,&q;useIntelligentRoom&q;:false,&q;hasSalePosition&q;:false,&q;hasEpisodeCards&q;:true,&q;lockedForShouna&q;:false,&q;needSignIn&q;:false,&q;needTeacherSignIn&q;:false,&q;enablePadPencil&q;:true,&q;displayExercise&q;:false,&q;supportLuckyBag&q;:true,&q;supportLivePk&q;:true,&q;feedId&q;:&q;1_11681300&q;,&q;hasReserved&q;:false,&q;kePrefixName&q;:&q;事业单位&q;},{&q;id&q;:11967379,&q;kePrefix&q;:&q;gwy&q;,&q;courseId&q;:1,&q;status&q;:0,&q;playStatus&q;:0,&q;type&q;:33,&q;recordingType&q;:0,&q;mediaType&q;:0,&q;title&q;:&q;【数资】备考破局秘籍&q;,&q;innerTitle&q;:&q;&q;,&q;startTime&q;:1773626400000,&q;endTime&q;:1773633600000,&q;teacher&q;:{&q;id&q;:44096,&q;userId&q;:82985544,&q;name&q;:&q;赵亚平&q;,&q;brief&q;:&q;粉笔数资、科推优质教师&q;,&q;desc&q;:&q;粉笔数资、科推优质教师。\n5年公考授课经验，累计授课人次3000+，授课时长2000+，学员评分高达5.0分。理论功底扎实，授课逻辑缜密、思路清晰。教学方式多样，因材施教，讲解耐心细致，使不同基础的学生都能获得良好的上课体验。&q;,&q;avatar&q;:&q;17ac3208d90fee5.jpg&q;,&q;upperBodyPhoto&q;:null,&q;displayCoursePrefix&q;:&q;&q;,&q;teacherStat&q;:{&q;teacherId&q;:44096,&q;episodeCount&q;:992,&q;scoreCount&q;:1283,&q;avgScore&q;:9.906469212782547,&q;fiveGradeAvgScore&q;:4.95,&q;updateTime&q;:1770031653158},&q;auditionEpisode&q;:{&q;episodeTitle&q;:&q;个人展示课&q;,&q;episodeVideoUrl&q;:&q;https://vod.fbstatic.cn/22e9ceb2vodbj1251001446/9a8b62841397757891887852259/wHu1DADFXaEA.mp4?t=f2a4b300&a;us=4070880000&a;sign=1b8f30550a9919ac5b15e98624b346c5&q;},&q;memberOfCPC&q;:false,&q;tags&q;:null},&q;teachChannel&q;:1,&q;offline&q;:null,&q;duration&q;:7200,&q;hasAudition&q;:false,&q;bizType&q;:56,&q;bizId&q;:&q;0&q;,&q;supportReplay&q;:true,&q;extraInfo&q;:null,&q;liveConfig&q;:{&q;episodeId&q;:11967379,&q;supportMultiGroup&q;:false,&q;exerciseBizType&q;:0,&q;videoDisplayType&q;:0,&q;avForwardType&q;:0,&q;useIntelligentRoom&q;:false,&q;hasStrokeKeynote&q;:false,&q;verticalModeType&q;:0,&q;originEpisodeId&q;:0,&q;supportRtmp&q;:false,&q;supportPk&q;:true,&q;supportLuckyBag&q;:true,&q;supportUserNoteStroke&q;:false,&q;communicateType&q;:0,&q;fakeLive&q;:false,&q;one2One&q;:false},&q;validStatus&q;:1,&q;supportLive&q;:true,&q;supportAiCatalog&q;:false,&q;hasIntelligentPen&q;:false,&q;useLocalRecording&q;:false,&q;useIntelligentRoom&q;:false,&q;hasSalePosition&q;:true,&q;hasEpisodeCards&q;:true,&q;lockedForShouna&q;:false,&q;needSignIn&q;:false,&q;needTeacherSignIn&q;:false,&q;enablePadPencil&q;:false,&q;displayExercise&q;:false,&q;supportLuckyBag&q;:true,&q;supportLivePk&q;:true,&q;feedId&q;:&q;1_11967379&q;,&q;hasReserved&q;:false,&q;kePrefixName&q;:&q;公考笔试&q;},{&q;id&q;:11967390,&q;kePrefix&q;:&q;gwy&q;,&q;courseId&q;:1,&q;status&q;:0,&q;playStatus&q;:0,&q;type&q;:33,&q;recordingType&q;:0,&q;mediaType&q;:0,&q;title&q;:&q;【言语】备考破局秘籍&q;,&q;innerTitle&q;:&q;&q;,&q;startTime&q;:1773626400000,&q;endTime&q;:1773633600000,&q;teacher&q;:{&q;id&q;:20629,&q;userId&q;:73730825,&q;name&q;:&q;孙长城&q;,&q;brief&q;:&q;粉笔面试优质教师&q;,&q;desc&q;:&q;粉笔面试优质教师。\n五年一线教学授课经验，充分了解河南、陕西、湖南等地的面试情况，2023年陕西省考小班10人上岸7人，带培学员多次荣获岗位第一。面试理论知识扎实，熟悉各类面试考试形式，深入研究国省考、事业单位各类面试的考情及命题特色，善于把握命题趋势和规律。同时善于把握学员个性化特点，因材施教，认真负责，讲课生动形象，机智诙谐，听课体验好，学员可以在轻松愉快的氛围中学习，跟着教师。节奏主动思考，充分掌握面试内容。\n粉笔面试教研教学团队成员，受邀参与出境录制粉笔智慧教室面试真题示范答题，并多次参与粉笔组织的各类授课能研讨会议和面试教研活动，共同助力粉笔面试理论的研发与升级。&q;,&q;avatar&q;:&q;19863fca5d3f48e.jpg&q;,&q;upperBodyPhoto&q;:null,&q;displayCoursePrefix&q;:&q;&q;,&q;teacherStat&q;:{&q;teacherId&q;:20629,&q;episodeCount&q;:1272,&q;scoreCount&q;:2852,&q;avgScore&q;:9.864656381486672,&q;fiveGradeAvgScore&q;:4.93,&q;updateTime&q;:1772637518224},&q;auditionEpisode&q;:{&q;episodeTitle&q;:&q;个人展示课&q;,&q;episodeVideoUrl&q;:&q;https://vod.fbstatic.cn/22e9ceb2vodbj1251001446/72fcb71e1397757888317766075/a2RkgMvcM5kA.mp4?t=f2a4b300&a;us=4070880000&a;sign=8dbf9ca58a2994b2c734927b6be3ff26&q;},&q;memberOfCPC&q;:false,&q;tags&q;:null},&q;teachChannel&q;:1,&q;offline&q;:null,&q;duration&q;:7200,&q;hasAudition&q;:false,&q;bizType&q;:56,&q;bizId&q;:&q;0&q;,&q;supportReplay&q;:true,&q;extraInfo&q;:null,&q;liveConfig&q;:{&q;episodeId&q;:11967390,&q;supportMultiGroup&q;:false,&q;exerciseBizType&q;:0,&q;videoDisplayType&q;:0,&q;avForwardType&q;:0,&q;useIntelligentRoom&q;:false,&q;hasStrokeKeynote&q;:false,&q;verticalModeType&q;:0,&q;originEpisodeId&q;:0,&q;supportRtmp&q;:false,&q;supportPk&q;:true,&q;supportLuckyBag&q;:true,&q;supportUserNoteStroke&q;:false,&q;communicateType&q;:0,&q;fakeLive&q;:false,&q;one2One&q;:false},&q;validStatus&q;:1,&q;supportLive&q;:true,&q;supportAiCatalog&q;:false,&q;hasIntelligentPen&q;:false,&q;useLocalRecording&q;:false,&q;useIntelligentRoom&q;:false,&q;hasSalePosition&q;:true,&q;hasEpisodeCards&q;:true,&q;lockedForShouna&q;:false,&q;needSignIn&q;:false,&q;needTeacherSignIn&q;:false,&q;enablePadPencil&q;:false,&q;displayExercise&q;:false,&q;supportLuckyBag&q;:true,&q;supportLivePk&q;:true,&q;feedId&q;:&q;1_11967390&q;,&q;hasReserved&q;:false,&q;kePrefixName&q;:&q;公考笔试&q;},{&q;id&q;:11975651,&q;kePrefix&q;:&q;gwy&q;,&q;courseId&q;:1,&q;status&q;:0,&q;playStatus&q;:0,&q;type&q;:33,&q;recordingType&q;:0,&q;mediaType&q;:0,&q;title&q;:&q;【常识】每日带练刷题营&q;,&q;innerTitle&q;:&q;&q;,&q;startTime&q;:1773631501000,&q;endTime&q;:1773639000000,&q;teacher&q;:{&q;id&q;:61558,&q;userId&q;:52525182,&q;name&q;:&q;赞赞老师&q;,&q;brief&q;:&q;粉笔公考教师&q;,&q;desc&q;:&q;粉笔公考教师&q;,&q;avatar&q;:&q;18a7369b7e12a1c.jpg&q;,&q;upperBodyPhoto&q;:null,&q;displayCoursePrefix&q;:&q;&q;,&q;teacherStat&q;:{&q;teacherId&q;:61558,&q;episodeCount&q;:1174,&q;scoreCount&q;:10536,&q;avgScore&q;:9.633637053910379,&q;fiveGradeAvgScore&q;:4.82,&q;updateTime&q;:1773611609241},&q;auditionEpisode&q;:null,&q;memberOfCPC&q;:false,&q;tags&q;:null},&q;teachChannel&q;:1,&q;offline&q;:null,&q;duration&q;:7499,&q;hasAudition&q;:false,&q;bizType&q;:56,&q;bizId&q;:&q;0&q;,&q;supportReplay&q;:true,&q;extraInfo&q;:null,&q;liveConfig&q;:{&q;episodeId&q;:11975651,&q;supportMultiGroup&q;:false,&q;exerciseBizType&q;:0,&q;videoDisplayType&q;:0,&q;avForwardType&q;:0,&q;useIntelligentRoom&q;:false,&q;hasStrokeKeynote&q;:false,&q;verticalModeType&q;:0,&q;originEpisodeId&q;:0,&q;supportRtmp&q;:false,&q;supportPk&q;:true,&q;supportLuckyBag&q;:true,&q;supportUserNoteStroke&q;:false,&q;communicateType&q;:0,&q;fakeLive&q;:false,&q;one2One&q;:false},&q;validStatus&q;:1,&q;supportLive&q;:true,&q;supportAiCatalog&q;:false,&q;hasIntelligentPen&q;:false,&q;useLocalRecording&q;:false,&q;useIntelligentRoom&q;:false,&q;hasSalePosition&q;:true,&q;hasEpisodeCards&q;:true,&q;lockedForShouna&q;:false,&q;needSignIn&q;:false,&q;needTeacherSignIn&q;:false,&q;enablePadPencil&q;:false,&q;displayExercise&q;:false,&q;supportLuckyBag&q;:true,&q;supportLivePk&q;:true,&q;feedId&q;:&q;1_11975651&q;,&q;hasReserved&q;:false,&q;kePrefixName&q;:&q;公考笔试&q;}]}}},&q;headers&q;:{&q;date&q;:[&q;Mon, 16 Mar 2026 01:13:51 GMT&q;],&q;content-type&q;:[&q;text/html; charset=utf-8&q;],&q;content-length&q;:[&q;20265&q;],&q;connection&q;:[&q;keep-alive&q;],&q;server&q;:[&q;Tengine&q;],&q;vary&q;:[&q;Accept-Encoding, Origin&q;],&q;x-powered-by&q;:[&q;Express&q;],&q;access-control-allow-credentials&q;:[&q;true&q;],&q;etag&q;:[&q;W/\&q;4f29-va08RUQIAE+V7SskhicHlhAuScc\&q;&q;],&q;x-frame-options&q;:[&q;SAMEORIGIN&q;],&q;x-content-type-options&q;:[&q;nosniff&q;]},&q;status&q;:200,&q;statusText&q;:&q;OK&q;,&q;url&q;:&q;https://webapi.fenbi.com/doc/api/wwwcms/get/popular_lives?app=web&a;av=100&a;hav=100&a;kav=100&q;},&q;G.https://webapi.fenbi.com/doc/api/wwwcms/get/teacher_introductions?app=web&a;av=100&a;hav=100&a;kav=100?&q;:{&q;body&q;:{&q;code&q;:1,&q;msg&q;:&q;&q;,&q;total&q;:4,&q;datas&q;:[{&q;id&q;:98,&q;gid&q;:61,&q;umask&q;:6627,&q;name&q;:&q;张小龙&q;,&q;title&q;:&q;张小龙&q;,&q;desc&q;:&q;      中国职业教育领域领军人物，粉笔教育创始人兼CEO，互联网教育模式创新践行者，申论、面试行业名师，凭借专业知识与独特教学，助力数千万考生成功上岸。\n      健康新品牌创立者，搭建“健康科普+优质产品+康养服务”三位一体产业架构，精心打造高性价比产品与服务体系，为大众在追求知识提升与健康生活的道路上提供更切实落地的健康服务方案，以实际行动推动两大行业的发展。&q;,&q;ubbText&q;:&q;&l;p&g;在线教育创业者，粉笔有限公司CEO&l;/p&g;&q;,&q;imgUrl&q;:&q;//nodestatic.fbstatic.cn/pan/downloads/aeee90d494c84c420c4069c0d5fe242a.jpg&q;,&q;linkUrl&q;:&q;&q;,&q;type&q;:502,&q;typeName&q;:&q;师资详情&q;,&q;weight&q;:1000,&q;status&q;:1,&q;isPublished&q;:1,&q;course&q;:0,&q;courseType&q;:0,&q;position&q;:0,&q;source&q;:&q;&q;,&q;uploadTime&q;:&q;&q;,&q;updatedTime&q;:&q;2024-08-02T11:03:40.000Z&q;,&q;createdTime&q;:&q;2022-11-21T10:02:55.326Z&q;,&q;teacherId&q;:4,&q;teacherAvatar&q;:&q;//nodestatic.fbstatic.cn/pan/downloads/6d2041526269d79c5e0351830b56a0bf.png&q;,&q;teacherProtrait&q;:&q;//nodestatic.fbstatic.cn/pan/downloads/9e16ac8aacf60eaf2f35e9b1c1cd5a44.png&q;,&q;brief&q;:&q;公考申论、面试优质讲师&q;,&q;videoUrl&q;:&q;&q;,&q;coverUrl&q;:&q;&q;,&q;subjectInformation&q;:{&q;examInformation&q;:[],&q;historyExams&q;:[],&q;examPreparationMaterials&q;:[]},&q;homepageTopic&q;:{&q;examAnnouncements&q;:[{&q;title&q;:&q;&q;,&q;subtitle&q;:&q;&q;,&q;jumpLink&q;:&q;&q;}],&q;guidanceArticles&q;:[{&q;title&q;:&q;&q;,&q;jumpLink&q;:&q;&q;}],&q;mainImages&q;:[{&q;title&q;:&q;&q;,&q;jumpLink&q;:&q;&q;,&q;imgUrl&q;:&q;&q;,&q;weight&q;:0}],&q;table&q;:{&q;title&q;:&q;&q;,&q;row&q;:0,&q;column&q;:0,&q;contents&q;:[]}},&q;homepageExams&q;:[{&q;title&q;:&q;&q;,&q;jumpLink&q;:&q;&q;}],&q;publisher&q;:&q;&q;,&q;image&q;:&q;https://ke.fbstatic.cn/api/images/170328acabae0dc.jpg&q;,&q;personalDetails&q;:&q;在线教育创业者，粉笔网CEO&q;,&q;videoCover&q;:&q;&q;,&q;introductionVideo&q;:&q;&q;,&q;fiveGradeAvgScore&q;:4.9,&q;scoreCount&q;:776117},{&q;id&q;:99,&q;gid&q;:61,&q;umask&q;:6627,&q;name&q;:&q;李梦圆&q;,&q;title&q;:&q;李梦圆&q;,&q;desc&q;:&q;粉笔申论面试资深讲师，武汉大学思想教育学士，清华大学马克思主义理论硕士。 \n13年公务员考试培训经验，有丰富的基层政府挂职经历，多次参加公务员、人才引进等考试，考场实战经验丰富。曾担任清华大学高校德育中心辅导员；半月谈专栏作家，在《时事政治》等知名杂志发表文章，并出版多本教材专著。授课深入浅出、化繁为简，逻辑清晰、生动有趣、实战性强，广受学员好评。&q;,&q;ubbText&q;:&q;&l;p style=\&q;text-align: center;\&q;&g;&l;span style=\&q;white-space: nowrap;\&q;&g;她是美女学霸&l;/span&g;&l;/p&g;&l;p style=\&q;text-align: center;\&q;&g;&l;span style=\&q;white-space: nowrap;\&q;&g;一个天生的规则玩家&l;/span&g;&l;/p&g;&l;p style=\&q;text-align: center;\&q;&g;&l;span style=\&q;white-space: nowrap;\&q;&g;总是能用更短的时间找到规律，摸透玩法&l;/span&g;&l;/p&g;&l;p style=\&q;text-align: center;\&q;&g;&l;span style=\&q;white-space: nowrap;\&q;&g;即使是让大家无法把握得分规则的的申论&l;/span&g;&l;/p&g;&l;p style=\&q;text-align: center;\&q;&g;&l;span style=\&q;white-space: nowrap;\&q;&g;对她来说也轻而易举，不在话下&l;/span&g;&l;/p&g;&l;p style=\&q;text-align: center;\&q;&g;&l;span style=\&q;white-space: nowrap;\&q;&g;&l;br/&g;&l;/span&g;&l;/p&g;&l;p style=\&q;text-align: center;\&q;&g;&l;span style=\&q;white-space: nowrap;\&q;&g;她曾经为了爱情&l;/span&g;&l;/p&g;&l;p style=\&q;text-align: center;\&q;&g;&l;span style=\&q;white-space: nowrap;\&q;&g;从武大考入了清华&l;/span&g;&l;/p&g;&l;p style=\&q;text-align: center;\&q;&g;&l;span style=\&q;white-space: nowrap;\&q;&g;如今有了一个漂亮的女儿和一个幸福温暖的家&l;/span&g;&l;/p&g;&l;p style=\&q;text-align: center;\&q;&g;&l;span style=\&q;white-space: nowrap;\&q;&g;&l;br/&g;&l;/span&g;&l;/p&g;&l;p style=\&q;text-align: center;\&q;&g;&l;span style=\&q;white-space: nowrap;\&q;&g;大学时的她&l;/span&g;&l;/p&g;&l;p style=\&q;text-align: center;\&q;&g;&l;span style=\&q;white-space: nowrap;\&q;&g;曾经给留守儿童开设课程&l;/span&g;&l;/p&g;&l;p style=\&q;text-align: center;\&q;&g;&l;span style=\&q;white-space: nowrap;\&q;&g;对同学们特别的关爱&l;/span&g;&l;/p&g;&l;p style=\&q;text-align: center;\&q;&g;&l;span style=\&q;white-space: nowrap;\&q;&g;让她明白了每一次站上讲台&l;/span&g;&l;/p&g;&l;p style=\&q;text-align: center;\&q;&g;&l;span style=\&q;white-space: nowrap;\&q;&g;“不是要看自己讲什么，而是要看学生要什么&a;quot;&l;/span&g;&l;/p&g;&l;p style=\&q;text-align: center;\&q;&g;&l;span style=\&q;white-space: nowrap;\&q;&g;&l;br/&g;&l;/span&g;&l;/p&g;&l;p style=\&q;text-align: center;\&q;&g;&l;span style=\&q;white-space: nowrap;\&q;&g;所以今天&l;/span&g;&l;/p&g;&l;p style=\&q;text-align: center;\&q;&g;&l;span style=\&q;white-space: nowrap;\&q;&g;即使她上几千人的直播课&l;/span&g;&l;/p&g;&l;p style=\&q;text-align: center;\&q;&g;&l;span style=\&q;white-space: nowrap;\&q;&g;同学们依然觉得&l;/span&g;&l;/p&g;&l;p style=\&q;text-align: center;\&q;&g;&l;span style=\&q;white-space: nowrap;\&q;&g;她讲的每一个知识点&l;/span&g;&l;/p&g;&l;p style=\&q;text-align: center;\&q;&g;&l;span style=\&q;white-space: nowrap;\&q;&g;都是为了解答自己最真实的疑惑&l;/span&g;&l;/p&g;&l;p style=\&q;text-align: center;\&q;&g;&l;span style=\&q;white-space: nowrap;\&q;&g;&l;br/&g;&l;/span&g;&l;/p&g;&l;p style=\&q;text-align: center;\&q;&g;&l;span style=\&q;white-space: nowrap;\&q;&g;她说&l;/span&g;&l;/p&g;&l;p style=\&q;text-align: center;\&q;&g;&l;span style=\&q;white-space: nowrap;\&q;&g;同学们的每一次挑剔&l;/span&g;&l;/p&g;&l;p style=\&q;text-align: center;\&q;&g;&l;span style=\&q;white-space: nowrap;\&q;&g;都是为了让我们变得更好&l;/span&g;&l;/p&g;&l;p style=\&q;text-align: center;\&q;&g;&l;span style=\&q;white-space: nowrap;\&q;&g;我能改的我一定改&l;/span&g;&l;/p&g;&l;p style=\&q;text-align: center;\&q;&g;&l;span style=\&q;white-space: nowrap;\&q;&g;我改不了的我慢慢去改&l;/span&g;&l;/p&g;&l;p style=\&q;text-align: center;\&q;&g;&l;span style=\&q;white-space: nowrap;\&q;&g;但是总是下一次要比上一次更好&l;/span&g;&l;/p&g;&l;p style=\&q;text-align: center;\&q;&g;&l;span style=\&q;white-space: nowrap;\&q;&g;&l;br/&g;&l;/span&g;&l;/p&g;&l;p style=\&q;text-align: center;\&q;&g;&l;span style=\&q;white-space: nowrap;\&q;&g;她说&l;/span&g;&l;/p&g;&l;p style=\&q;text-align: center;\&q;&g;&l;span style=\&q;white-space: nowrap;\&q;&g;生活本身就是麻烦&l;/span&g;&l;/p&g;&l;p style=\&q;text-align: center;\&q;&g;&l;span style=\&q;white-space: nowrap;\&q;&g;其实一地鸡毛就是生活的常态&l;/span&g;&l;/p&g;&l;p style=\&q;text-align: center;\&q;&g;&l;span style=\&q;white-space: nowrap;\&q;&g;在我们不断的解决一个又一个的麻烦时&l;/span&g;&l;/p&g;&l;p style=\&q;text-align: center;\&q;&g;&l;span style=\&q;white-space: nowrap;\&q;&g;我们就成为了不一样的自己&l;/span&g;&l;/p&g;&l;p style=\&q;text-align: center;\&q;&g;&l;span style=\&q;white-space: nowrap;\&q;&g;&l;br/&g;&l;/span&g;&l;/p&g;&l;p style=\&q;text-align: center;\&q;&g;&l;span style=\&q;white-space: nowrap;\&q;&g;她是一个乐观又积极的引路者&l;/span&g;&l;/p&g;&l;p style=\&q;text-align: center;\&q;&g;&l;span style=\&q;white-space: nowrap;\&q;&g;她是一位认真又努力的粉笔人&l;/span&g;&l;/p&g;&l;p style=\&q;text-align: center;\&q;&g;&l;span style=\&q;white-space: nowrap;\&q;&g;&l;br/&g;&l;/span&g;&l;/p&g;&l;p style=\&q;text-align: center;\&q;&g;&l;span style=\&q;white-space: nowrap;\&q;&g;她是粉笔不一样的老师——李梦圆&l;/span&g;&l;/p&g;&l;p style=\&q;text-align: center;\&q;&g;&l;br/&g;&l;/p&g;&q;,&q;imgUrl&q;:&q;https://ke.fbstatic.cn/api/images/1703232f87fc1bf.jpg&q;,&q;linkUrl&q;:&q;&q;,&q;type&q;:502,&q;typeName&q;:&q;师资详情&q;,&q;weight&q;:980,&q;status&q;:1,&q;isPublished&q;:1,&q;course&q;:0,&q;courseType&q;:0,&q;position&q;:0,&q;source&q;:&q;&q;,&q;uploadTime&q;:&q;&q;,&q;updatedTime&q;:&q;2024-08-02T09:53:27.000Z&q;,&q;createdTime&q;:&q;2022-11-21T10:10:15.382Z&q;,&q;teacherId&q;:287,&q;teacherAvatar&q;:&q;//nodestatic.fbstatic.cn/pan/downloads/e2e718095aa176a987f49528809aff3f.png&q;,&q;teacherProtrait&q;:&q;//nodestatic.fbstatic.cn/pan/downloads/93a1ca09d9069042269c61680222b27a.png&q;,&q;brief&q;:&q;公考申论、面试主讲&q;,&q;videoUrl&q;:&q;https://nodestatic.fbstatic.cn/video_qhd/english-reading/limengyuan-1554194670062.mp4&q;,&q;coverUrl&q;:&q;https://ke.fbstatic.cn/api/images/169e1dbc5d8a0c6.jpg&q;,&q;subjectInformation&q;:{&q;examInformation&q;:[],&q;historyExams&q;:[],&q;examPreparationMaterials&q;:[]},&q;homepageTopic&q;:{&q;examAnnouncements&q;:[{&q;title&q;:&q;&q;,&q;subtitle&q;:&q;&q;,&q;jumpLink&q;:&q;&q;}],&q;guidanceArticles&q;:[{&q;title&q;:&q;&q;,&q;jumpLink&q;:&q;&q;}],&q;mainImages&q;:[{&q;title&q;:&q;&q;,&q;jumpLink&q;:&q;&q;,&q;imgUrl&q;:&q;&q;,&q;weight&q;:0}],&q;table&q;:{&q;title&q;:&q;&q;,&q;row&q;:0,&q;column&q;:0,&q;contents&q;:[]}},&q;homepageExams&q;:[{&q;title&q;:&q;&q;,&q;jumpLink&q;:&q;&q;}],&q;publisher&q;:&q;&q;,&q;image&q;:&q;https://ke.fbstatic.cn/api/images/1703232f87fc1bf.jpg&q;,&q;personalDetails&q;:&q;&l;div style=\&q;text-align: center;\&q;&g;\r\n\t她是美女学霸&l;br /&g;\r\n\t一个天生的规则玩家&l;br /&g;\r\n\t总是能用更短的时间找到规律，摸透玩法&l;br /&g;\r\n\t即使是让大家无法把握得分规则的的申论&l;br /&g;\r\n\t对她来说也轻而易举，不在话下&l;br /&g;\r\n\t&l;br /&g;\r\n\t她曾经为了爱情&l;br /&g;\r\n\t从武大考入了清华&l;br /&g;\r\n\t如今有了一个漂亮的女儿和一个幸福温暖的家&l;br /&g;\r\n\t&l;br /&g;\r\n\t大学时的她&l;br /&g;\r\n\t曾经给留守儿童开设课程&l;br /&g;\r\n\t对同学们特别的关爱&l;br /&g;\r\n\t让她明白了每一次站上讲台&l;br /&g;\r\n\t&a;ldquo;不是要看自己讲什么，而是要看学生要什么&a;quot;&l;br /&g;\r\n\t&l;br /&g;\r\n\t所以今天&l;br /&g;\r\n\t即使她上几千人的直播课&l;br /&g;\r\n\t同学们依然觉得&l;br /&g;\r\n\t她讲的每一个知识点&l;br /&g;\r\n\t都是为了解答自己最真实的疑惑&l;br /&g;\r\n\t&l;br /&g;\r\n\t她说&l;br /&g;\r\n\t同学们的每一次挑剔&l;br /&g;\r\n\t都是为了让我们变得更好&l;br /&g;\r\n\t我能改的我一定改&l;br /&g;\r\n\t我改不了的我慢慢去改&l;br /&g;\r\n\t但是总是下一次要比上一次更好&l;br /&g;\r\n\t&l;br /&g;\r\n\t她说&l;br /&g;\r\n\t生活本身就是麻烦&l;br /&g;\r\n\t其实一地鸡毛就是生活的常态&l;br /&g;\r\n\t在我们不断的解决一个又一个的麻烦时&l;br /&g;\r\n\t我们就成为了不一样的自己&l;br /&g;\r\n\t&l;br /&g;\r\n\t她是一个乐观又积极的引路者&l;br /&g;\r\n\t她是一位认真又努力的粉笔人&l;br /&g;\r\n\t&l;br /&g;\r\n\t她是粉笔不一样的老师&a;mdash;&a;mdash;李梦圆&l;/div&g;&q;,&q;videoCover&q;:&q;https://ke.fbstatic.cn/api/images/169e1dbc5d8a0c6.jpg&q;,&q;introductionVideo&q;:&q;https://nodestatic.fbstatic.cn/video_qhd/english-reading/limengyuan-1554194670062.mp4&q;,&q;fiveGradeAvgScore&q;:4.93,&q;scoreCount&q;:1206690},{&q;id&q;:100,&q;gid&q;:61,&q;umask&q;:6627,&q;name&q;:&q;赵晓曦&q;,&q;title&q;:&q;赵晓曦&q;,&q;desc&q;:&q;粉笔言语优质教师，211大学文科类博士 \n15年公考授课经验，打分人次超25万，学员评分高达4.9分。 \n长期从事言语理解与表达的授课和教研工作，功底扎实，耐心负责。对于言语题目、教学思路、授课模式有非常深入的研究和理解，并在教学实践中充分贯彻和体现。授课思路清晰严谨，讲解细致入微，条理清楚，是“极高明而道中庸”的典范。 \n粉笔公考笔试教研教学总负责人，组织各类授课研讨会议和教研活动，带领教研师资团队制作《行测5000题》《申论100题》《极致模考卷》《模考80分》等优质图书，深受学员认可。&q;,&q;ubbText&q;:&q;&l;p style=\&q;text-align: center;\&q;&g;&l;span style=\&q;white-space: nowrap;\&q;&g;她是粉笔的第一位言语老师&l;/span&g;&l;/p&g;&l;p style=\&q;text-align: center;\&q;&g;&l;span style=\&q;white-space: nowrap;\&q;&g;几年前只因看了罗振宇的跨年演讲视频&l;/span&g;&l;/p&g;&l;p style=\&q;text-align: center;\&q;&g;&l;span style=\&q;white-space: nowrap;\&q;&g;便加入了当时只有六七个人的粉笔团队&l;/span&g;&l;/p&g;&l;p style=\&q;text-align: center;\&q;&g;&l;span style=\&q;white-space: nowrap;\&q;&g;她一个人扛下了所有言语理解的教研工作&l;/span&g;&l;/p&g;&l;p style=\&q;text-align: center;\&q;&g;&l;span style=\&q;white-space: nowrap;\&q;&g;也因此不得不与远在维也纳工作的丈夫&l;/span&g;&l;/p&g;&l;p style=\&q;text-align: center;\&q;&g;&l;span style=\&q;white-space: nowrap;\&q;&g;维持了长达4年的异国生活&l;/span&g;&l;/p&g;&l;p style=\&q;text-align: center;\&q;&g;&l;span style=\&q;white-space: nowrap;\&q;&g;&l;br/&g;&l;/span&g;&l;/p&g;&l;p style=\&q;text-align: center;\&q;&g;&l;span style=\&q;white-space: nowrap;\&q;&g;她说：&l;/span&g;&l;/p&g;&l;p style=\&q;text-align: center;\&q;&g;&l;span style=\&q;white-space: nowrap;\&q;&g;粉笔就像她的孩子一样&l;/span&g;&l;/p&g;&l;p style=\&q;text-align: center;\&q;&g;&l;span style=\&q;white-space: nowrap;\&q;&g;看着他出生、陪着他长大&l;/span&g;&l;/p&g;&l;p style=\&q;text-align: center;\&q;&g;&l;span style=\&q;white-space: nowrap;\&q;&g;一千五百多个日日夜夜的陪伴&l;/span&g;&l;/p&g;&l;p style=\&q;text-align: center;\&q;&g;&l;span style=\&q;white-space: nowrap;\&q;&g;她对粉笔的爱 早已无法割舍&l;/span&g;&l;/p&g;&l;p style=\&q;text-align: center;\&q;&g;&l;span style=\&q;white-space: nowrap;\&q;&g;也因为丈夫的支持&l;/span&g;&l;/p&g;&l;p style=\&q;text-align: center;\&q;&g;&l;span style=\&q;white-space: nowrap;\&q;&g;她才能安心的当一个“好妈妈”&l;/span&g;&l;/p&g;&l;p style=\&q;text-align: center;\&q;&g;&l;span style=\&q;white-space: nowrap;\&q;&g;&l;br/&g;&l;/span&g;&l;/p&g;&l;p style=\&q;text-align: center;\&q;&g;&l;span style=\&q;white-space: nowrap;\&q;&g;&l;br/&g;&l;/span&g;&l;/p&g;&l;p style=\&q;text-align: center;\&q;&g;&l;span style=\&q;white-space: nowrap;\&q;&g;曾经的她在硕士毕业后&l;/span&g;&l;/p&g;&l;p style=\&q;text-align: center;\&q;&g;&l;span style=\&q;white-space: nowrap;\&q;&g;同时考上了博士和北京市公务员&l;/span&g;&l;/p&g;&l;p style=\&q;text-align: center;\&q;&g;&l;span style=\&q;white-space: nowrap;\&q;&g;又在读博期间误打误撞的进入到了公考培训行业&l;/span&g;&l;/p&g;&l;p style=\&q;text-align: center;\&q;&g;&l;span style=\&q;white-space: nowrap;\&q;&g;一路走来，九年风雨&l;/span&g;&l;/p&g;&l;p style=\&q;text-align: center;\&q;&g;&l;span style=\&q;white-space: nowrap;\&q;&g;如今的她早已成为公考培训行业里的顶尖优秀老师&l;/span&g;&l;/p&g;&l;p style=\&q;text-align: center;\&q;&g;&l;span style=\&q;white-space: nowrap;\&q;&g;她喜欢研究出题人&l;/span&g;&l;/p&g;&l;p style=\&q;text-align: center;\&q;&g;&l;span style=\&q;white-space: nowrap;\&q;&g;从出题人的角度研究问题总能给她带来不一样的乐趣&l;/span&g;&l;/p&g;&l;p style=\&q;text-align: center;\&q;&g;&l;span style=\&q;white-space: nowrap;\&q;&g;每当有新的言语考试题目出现时&l;/span&g;&l;/p&g;&l;p style=\&q;text-align: center;\&q;&g;&l;span style=\&q;white-space: nowrap;\&q;&g;她都迫不及待的拿到手&l;/span&g;&l;/p&g;&l;p style=\&q;text-align: center;\&q;&g;&l;span style=\&q;white-space: nowrap;\&q;&g;并沉浸其中，乐此不疲&l;/span&g;&l;/p&g;&l;p style=\&q;text-align: center;\&q;&g;&l;span style=\&q;white-space: nowrap;\&q;&g;她说：“我就想赶紧看看出题人还有什么招”&l;/span&g;&l;/p&g;&l;p style=\&q;text-align: center;\&q;&g;&l;span style=\&q;white-space: nowrap;\&q;&g;&l;br/&g;&l;/span&g;&l;/p&g;&l;p style=\&q;text-align: center;\&q;&g;&l;span style=\&q;white-space: nowrap;\&q;&g;&l;br/&g;&l;/span&g;&l;/p&g;&l;p style=\&q;text-align: center;\&q;&g;&l;span style=\&q;white-space: nowrap;\&q;&g;因为粉笔&l;/span&g;&l;/p&g;&l;p style=\&q;text-align: center;\&q;&g;&l;span style=\&q;white-space: nowrap;\&q;&g;她的人生轨迹产生了决定性的改变&l;/span&g;&l;/p&g;&l;p style=\&q;text-align: center;\&q;&g;&l;span style=\&q;white-space: nowrap;\&q;&g;原本等着她去维也纳一起定居生活的丈夫&l;/span&g;&l;/p&g;&l;p style=\&q;text-align: center;\&q;&g;&l;span style=\&q;white-space: nowrap;\&q;&g;辞去了工作、放弃了原本的生活&l;/span&g;&l;/p&g;&l;p style=\&q;text-align: center;\&q;&g;&l;span style=\&q;white-space: nowrap;\&q;&g;不远万里回国陪着她当“北漂”&l;/span&g;&l;/p&g;&l;p style=\&q;text-align: center;\&q;&g;&l;span style=\&q;white-space: nowrap;\&q;&g;&l;br/&g;&l;/span&g;&l;/p&g;&l;p style=\&q;text-align: center;\&q;&g;&l;span style=\&q;white-space: nowrap;\&q;&g;因为粉笔&l;/span&g;&l;/p&g;&l;p style=\&q;text-align: center;\&q;&g;&l;span style=\&q;white-space: nowrap;\&q;&g;她找到了一群志同道合、随时互怼的伙伴&l;/span&g;&l;/p&g;&l;p style=\&q;text-align: center;\&q;&g;&l;span style=\&q;white-space: nowrap;\&q;&g;也找到了一份为之奋斗并乐在其中的事业&l;/span&g;&l;/p&g;&l;p style=\&q;text-align: center;\&q;&g;&l;span style=\&q;white-space: nowrap;\&q;&g;她在这里，遇见了不一样的自己&l;/span&g;&l;/p&g;&l;p style=\&q;text-align: center;\&q;&g;&l;span style=\&q;white-space: nowrap;\&q;&g;&l;br/&g;&l;/span&g;&l;/p&g;&l;p style=\&q;text-align: center;\&q;&g;&l;span style=\&q;white-space: nowrap;\&q;&g;彪悍的人生不需要解释&l;/span&g;&l;/p&g;&l;p style=\&q;text-align: center;\&q;&g;&l;span style=\&q;white-space: nowrap;\&q;&g;她就是粉笔不一样的老师——赵晓曦&l;/span&g;&l;/p&g;&l;p style=\&q;text-align: center;\&q;&g;&l;br/&g;&l;/p&g;&q;,&q;imgUrl&q;:&q;//nodestatic.fbstatic.cn/pan/downloads/88f5ee6359ea3ca8a90617a23a0c12bd.jpg&q;,&q;linkUrl&q;:&q;&q;,&q;type&q;:502,&q;typeName&q;:&q;师资详情&q;,&q;weight&q;:960,&q;status&q;:1,&q;isPublished&q;:1,&q;course&q;:0,&q;courseType&q;:0,&q;position&q;:0,&q;source&q;:&q;&q;,&q;uploadTime&q;:&q;&q;,&q;updatedTime&q;:&q;2024-08-02T10:14:19.000Z&q;,&q;createdTime&q;:&q;2022-11-21T10:10:50.900Z&q;,&q;teacherId&q;:115,&q;teacherAvatar&q;:&q;//nodestatic.fbstatic.cn/pan/downloads/b7d47f2b4e76f7a23d5dc61c02e317a6.png&q;,&q;teacherProtrait&q;:&q;//nodestatic.fbstatic.cn/pan/downloads/cfc4e9cfc4f12731378b63c6d52cdd07.png&q;,&q;brief&q;:&q;言语理解与表达优质讲师&q;,&q;videoUrl&q;:&q;https://nodestatic.fbstatic.cn/video_qhd/english-reading/1559212711429.mp4&q;,&q;coverUrl&q;:&q;https://ke.fbstatic.cn/api/images/16b0be490c34787.png&q;,&q;subjectInformation&q;:{&q;examInformation&q;:[],&q;historyExams&q;:[],&q;examPreparationMaterials&q;:[]},&q;homepageTopic&q;:{&q;examAnnouncements&q;:[{&q;title&q;:&q;&q;,&q;subtitle&q;:&q;&q;,&q;jumpLink&q;:&q;&q;}],&q;guidanceArticles&q;:[{&q;title&q;:&q;&q;,&q;jumpLink&q;:&q;&q;}],&q;mainImages&q;:[{&q;title&q;:&q;&q;,&q;jumpLink&q;:&q;&q;,&q;imgUrl&q;:&q;&q;,&q;weight&q;:0}],&q;table&q;:{&q;title&q;:&q;&q;,&q;row&q;:0,&q;column&q;:0,&q;contents&q;:[]}},&q;homepageExams&q;:[{&q;title&q;:&q;&q;,&q;jumpLink&q;:&q;&q;}],&q;publisher&q;:&q;&q;,&q;image&q;:&q;https://ke.fbstatic.cn/api/images/1712a854bfc37e7.jpg&q;,&q;personalDetails&q;:&q;&l;div style=\&q;text-align: center;\&q;&g;\r\n\t她是粉笔的第一位言语老师&l;br /&g;\r\n\t几年前只因看了罗振宇的跨年演讲视频&l;br /&g;\r\n\t便加入了当时只有六七个人的粉笔团队&l;br /&g;\r\n\t她一个人扛下了所有言语理解的教研工作&l;br /&g;\r\n\t也因此不得不与远在维也纳工作的丈夫&l;br /&g;\r\n\t维持了长达4年的异国生活&l;br /&g;\r\n\t&l;br /&g;\r\n\t她说：&l;br /&g;\r\n\t粉笔就像她的孩子一样&l;br /&g;\r\n\t看着他出生、陪着他长大&l;br /&g;\r\n\t一千五百多个日日夜夜的陪伴&l;br /&g;\r\n\t她对粉笔的爱 早已无法割舍&l;br /&g;\r\n\t也因为丈夫的支持&l;br /&g;\r\n\t她才能安心的当一个&a;ldquo;好妈妈&a;rdquo;&l;br /&g;\r\n\t&l;br /&g;\r\n\t&l;br /&g;\r\n\t曾经的她在硕士毕业后&l;br /&g;\r\n\t同时考上了博士和北京市公务员&l;br /&g;\r\n\t又在读博期间误打误撞的进入到了公考培训行业&l;br /&g;\r\n\t一路走来，九年风雨&l;br /&g;\r\n\t如今的她早已成为公考培训行业里的顶尖优秀老师&l;br /&g;\r\n\t她喜欢研究出题人&l;br /&g;\r\n\t从出题人的角度研究问题总能给她带来不一样的乐趣&l;br /&g;\r\n\t每当有新的言语考试题目出现时&l;br /&g;\r\n\t她都迫不及待的拿到手&l;br /&g;\r\n\t并沉浸其中，乐此不疲&l;br /&g;\r\n\t她说：&a;ldquo;我就想赶紧看看出题人还有什么招&a;rdquo;&l;br /&g;\r\n\t&l;br /&g;\r\n\t&l;br /&g;\r\n\t因为粉笔&l;br /&g;\r\n\t她的人生轨迹产生了决定性的改变&l;br /&g;\r\n\t原本等着她去维也纳一起定居生活的丈夫&l;br /&g;\r\n\t辞去了工作、放弃了原本的生活&l;br /&g;\r\n\t不远万里回国陪着她当&a;ldquo;北漂&a;rdquo;&l;br /&g;\r\n\t&l;br /&g;\r\n\t因为粉笔&l;br /&g;\r\n\t她找到了一群志同道合、随时互怼的伙伴&l;br /&g;\r\n\t也找到了一份为之奋斗并乐在其中的事业&l;br /&g;\r\n\t她在这里，遇见了不一样的自己&l;br /&g;\r\n\t&l;br /&g;\r\n\t彪悍的人生不需要解释&l;br /&g;\r\n\t她就是粉笔不一样的老师&a;mdash;&a;mdash;赵晓曦&l;/div&g;&q;,&q;videoCover&q;:&q;https://ke.fbstatic.cn/api/images/16b0be490c34787.png&q;,&q;introductionVideo&q;:&q;https://nodestatic.fbstatic.cn/video_qhd/english-reading/1559212711429.mp4&q;,&q;fiveGradeAvgScore&q;:4.91,&q;scoreCount&q;:322342},{&q;id&q;:172,&q;gid&q;:61,&q;umask&q;:6627,&q;name&q;:&q;郭熙&q;,&q;title&q;:&q;郭熙&q;,&q;desc&q;:&q;粉笔言语优质教师，13年公考授课经验，打分人次超100万，学员评分高达4.9分，被学员亲切地称为“粉笔柯南”。 \n专业功底扎实，教学经验丰富，教学方法针对性强，能让学员在短时间内熟练掌握解题技巧。善于引导和启发学员，亦庄亦谐、寓教于乐。&q;,&q;ubbText&q;:&q;&q;,&q;imgUrl&q;:&q;//nodestatic.fbstatic.cn/pan/downloads/28b6086f32ad50e877077b080dcccc74.jpg&q;,&q;linkUrl&q;:&q;&q;,&q;type&q;:502,&q;typeName&q;:&q;师资详情&q;,&q;weight&q;:947,&q;status&q;:1,&q;isPublished&q;:1,&q;course&q;:0,&q;courseType&q;:0,&q;position&q;:0,&q;source&q;:&q;&q;,&q;uploadTime&q;:&q;&q;,&q;updatedTime&q;:&q;2024-08-02T10:15:12.000Z&q;,&q;createdTime&q;:&q;2024-01-04T10:35:21.317Z&q;,&q;teacherId&q;:733,&q;teacherAvatar&q;:&q;//nodestatic.fbstatic.cn/pan/downloads/e142e4f795b91d50da88c8ab9acd2429.png&q;,&q;teacherProtrait&q;:&q;//nodestatic.fbstatic.cn/pan/downloads/5b15efdd434c70c04b40076d05d1c2af.png&q;,&q;brief&q;:&q;言语理解与表达、面试讲师&q;,&q;videoUrl&q;:&q;&q;,&q;coverUrl&q;:&q;&q;,&q;subjectInformation&q;:{&q;examInformation&q;:[],&q;historyExams&q;:[],&q;examPreparationMaterials&q;:[]},&q;homepageTopic&q;:{&q;examAnnouncements&q;:[{&q;title&q;:&q;&q;,&q;subtitle&q;:&q;&q;,&q;jumpLink&q;:&q;&q;}],&q;guidanceArticles&q;:[{&q;title&q;:&q;&q;,&q;jumpLink&q;:&q;&q;}],&q;mainImages&q;:[{&q;title&q;:&q;&q;,&q;jumpLink&q;:&q;&q;,&q;imgUrl&q;:&q;&q;,&q;weight&q;:0}],&q;table&q;:{&q;title&q;:&q;&q;,&q;row&q;:0,&q;column&q;:0,&q;contents&q;:[]}},&q;homepageExams&q;:[{&q;title&q;:&q;&q;,&q;jumpLink&q;:&q;&q;}],&q;publisher&q;:&q;&q;,&q;image&q;:&q;https://ke.fbstatic.cn/api/images/18cd2872fc744ed.jpg&q;,&q;personalDetails&q;:&q;粉笔公考言语理解与表达、面试优质讲师。10年公考授课经验，评分人数超过150万。专业功底扎实，教学经验丰富，教学方法针对性强，能让学员在短时间内熟练掌握解题技巧；善于引导和启发学员，亦庄亦谐、寓教于乐，深受学员好评。&q;,&q;videoCover&q;:&q;&q;,&q;introductionVideo&q;:&q;&q;,&q;fiveGradeAvgScore&q;:4.94,&q;scoreCount&q;:1272992}]},&q;headers&q;:{&q;date&q;:[&q;Mon, 16 Mar 2026 01:13:51 GMT&q;],&q;content-type&q;:[&q;text/html; charset=utf-8&q;],&q;content-length&q;:[&q;20808&q;],&q;connection&q;:[&q;keep-alive&q;],&q;server&q;:[&q;Tengine&q;],&q;vary&q;:[&q;Accept-Encoding, Origin&q;],&q;x-powered-by&q;:[&q;Express&q;],&q;access-control-allow-credentials&q;:[&q;true&q;],&q;etag&q;:[&q;W/\&q;5148-4ESTNz9yx7oG/B0XU/0GVvyL6TM\&q;&q;],&q;x-frame-options&q;:[&q;SAMEORIGIN&q;],&q;x-content-type-options&q;:[&q;nosniff&q;]},&q;status&q;:200,&q;statusText&q;:&q;OK&q;,&q;url&q;:&q;https://webapi.fenbi.com/doc/api/wwwcms/get/teacher_introductions?app=web&a;av=100&a;hav=100&a;kav=100&q;},&q;G.https://webapi.fenbi.com/doc/api/wwwcms/get/exams_preparation_materials_groups?app=web&a;av=100&a;hav=100&a;kav=100?&q;:{&q;body&q;:{&q;code&q;:1,&q;msg&q;:&q;&q;,&q;total&q;:9,&q;datas&q;:[{&q;id&q;:178,&q;name&q;:&q;行测小讲堂&q;,&q;icon&q;:&q;https://hera.fbstatic.cn/website_icon/icon-备考-1-行测@2x.png&q;,&q;stickTopArticles&q;:[],&q;articles&q;:[{&q;id&q;:454670134832128,&q;title&q;:&q;逻辑判断—论证之找论点与论据&q;,&q;source&q;:&q;行测小讲堂&q;,&q;issueTime&q;:1753955279498,&q;updateTime&q;:1773410755242,&q;favoriteTime&q;:-1,&q;favoriteNum&q;:144,&q;contentType&q;:1,&q;businessType&q;:4,&q;contentURL&q;:&q;https://hera-webapp.fenbi.com/api/article/detail?id=454670134832128&q;,&q;cardType&q;:3,&q;visitors&q;:71059,&q;score&q;:454670134832128,&q;imgURLs&q;:[&q;https://hera.fbstatic.cn/454670093461504.jpg&q;],&q;highlights&q;:[],&q;video&q;:null,&q;audio&q;:null,&q;extendInfo&q;:{&q;from&q;:2,&q;reqId&q;:-1},&q;commentNum&q;:314,&q;likeNum&q;:146,&q;sourceInfo&q;:{&q;id&q;:178,&q;name&q;:&q;行测小讲堂&q;,&q;icon&q;:&q;https://hera.fbstatic.cn/429980702028800.png&q;,&q;interest&q;:false,&q;interestNum&q;:0,&q;score&q;:0,&q;articleNum&q;:0},&q;showType&q;:0,&q;isLike&q;:0,&q;isFavor&q;:0,&q;preface&q;:&q;前言加强和削弱题型是逻辑判断中的重点题型，要想做好这类题目，首先要学习的是如何在题干中快速准确找到论点和论据，只有找到论点和论据才能对其加强或者削弱。本文主要给大家介绍找论点和论据的几种方式。1、典型&q;,&q;digest&q;:&q;逻辑判断—论证之找论点与论据&q;,&q;digestRowInfo&q;:[],&q;tagsList&q;:[],&q;category&q;:0,&q;memberArticle&q;:false,&q;vipLecture&q;:false,&q;announcementArticleInfoRet&q;:{&q;enrollStatus&q;:0,&q;enrollStartTime&q;:0,&q;enrollEndTime&q;:0,&q;recruitNum&q;:0,&q;recruitNumRet&q;:null,&q;positionNum&q;:0,&q;reason&q;:null,&q;matchPositionTag&q;:null,&q;remarkBanner&q;:null,&q;hasGlobalStatistic&q;:false,&q;authorized&q;:false,&q;timeStatus&q;:null,&q;timeStatusInfo&q;:null,&q;registerWebsiteInfo&q;:{&q;websitePurpose&q;:null,&q;websiteName&q;:&q;&q;,&q;url&q;:null},&q;affixInfos&q;:null,&q;selectedExam&q;:false,&q;inHotQuery&q;:false,&q;sourceInfo&q;:null,&q;contactInfos&q;:null,&q;digestRemark&q;:null,&q;collectionChildrenNum&q;:0,&q;collectionChildrenUpdateTime&q;:0,&q;companyId&q;:0},&q;enrollStatus&q;:0,&q;enrollStartTime&q;:0,&q;enrollEndTime&q;:0,&q;memberArticleInfoRet&q;:{&q;memberTypes&q;:null},&q;likedUsers&q;:null,&q;relatedObject&q;:null,&q;relatedAds&q;:[],&q;rollingBanners&q;:null,&q;articleTaskStatus&q;:-1,&q;floatBanner&q;:null,&q;experienceTagList&q;:[],&q;morningReadingSpeakerTimeAudio&q;:null,&q;adBanner&q;:null},{&q;id&q;:454670080570368,&q;title&q;:&q;矛盾关系分析不清&q;,&q;source&q;:&q;行测小讲堂&q;,&q;issueTime&q;:1752141222203,&q;updateTime&q;:1770337956703,&q;favoriteTime&q;:-1,&q;favoriteNum&q;:64,&q;contentType&q;:1,&q;businessType&q;:4,&q;contentURL&q;:&q;https://hera-webapp.fenbi.com/api/article/detail?id=454670080570368&q;,&q;cardType&q;:3,&q;visitors&q;:54898,&q;score&q;:454670080570368,&q;imgURLs&q;:[&q;https://hera.fbstatic.cn/454670061481984.jpg&q;],&q;highlights&q;:[],&q;video&q;:null,&q;audio&q;:null,&q;extendInfo&q;:{&q;from&q;:2,&q;reqId&q;:-1},&q;commentNum&q;:281,&q;likeNum&q;:85,&q;sourceInfo&q;:{&q;id&q;:178,&q;name&q;:&q;行测小讲堂&q;,&q;icon&q;:&q;https://hera.fbstatic.cn/429980702028800.png&q;,&q;interest&q;:false,&q;interestNum&q;:0,&q;score&q;:0,&q;articleNum&q;:0},&q;showType&q;:0,&q;isLike&q;:0,&q;isFavor&q;:0,&q;preface&q;:&q;知识梳理并列关系相信大家都有所了解，但是如果这类题往难考就会涉及区分矛盾关系和反对关系，大家可能会对二者有些疑惑，经常分不清楚，本文就主要带着大家来学习一下二者的区别。矛盾关系是符合并列关系的A和B构&q;,&q;digest&q;:&q;矛盾关系分析不清&q;,&q;digestRowInfo&q;:[],&q;tagsList&q;:[],&q;category&q;:0,&q;memberArticle&q;:false,&q;vipLecture&q;:false,&q;announcementArticleInfoRet&q;:{&q;enrollStatus&q;:0,&q;enrollStartTime&q;:0,&q;enrollEndTime&q;:0,&q;recruitNum&q;:0,&q;recruitNumRet&q;:null,&q;positionNum&q;:0,&q;reason&q;:null,&q;matchPositionTag&q;:null,&q;remarkBanner&q;:null,&q;hasGlobalStatistic&q;:false,&q;authorized&q;:false,&q;timeStatus&q;:null,&q;timeStatusInfo&q;:null,&q;registerWebsiteInfo&q;:{&q;websitePurpose&q;:null,&q;websiteName&q;:&q;&q;,&q;url&q;:null},&q;affixInfos&q;:null,&q;selectedExam&q;:false,&q;inHotQuery&q;:false,&q;sourceInfo&q;:null,&q;contactInfos&q;:null,&q;digestRemark&q;:null,&q;collectionChildrenNum&q;:0,&q;collectionChildrenUpdateTime&q;:0,&q;companyId&q;:0},&q;enrollStatus&q;:0,&q;enrollStartTime&q;:0,&q;enrollEndTime&q;:0,&q;memberArticleInfoRet&q;:{&q;memberTypes&q;:null},&q;likedUsers&q;:null,&q;relatedObject&q;:null,&q;relatedAds&q;:[],&q;rollingBanners&q;:null,&q;articleTaskStatus&q;:-1,&q;floatBanner&q;:null,&q;experienceTagList&