e,&q;needSignIn&q;:false,&q;needTeacherSignIn&q;:false,&q;enablePadPencil&q;:true,&q;displayExercise&q;:false,&q;supportLuckyBag&q;:true,&q;supportLivePk&q;:true},{&q;id&q;:11003571,&q;kePrefix&q;:&q;sydw&q;,&q;courseId&q;:6,&q;status&q;:3,&q;playStatus&q;:3,&q;type&q;:33,&q;recordingType&q;:0,&q;mediaType&q;:0,&q;title&q;:&q;【判断】精选好题 沉浸刷题&q;,&q;innerTitle&q;:&q;&q;,&q;startTime&q;:1759125600000,&q;endTime&q;:1759132800000,&q;teacher&q;:{&q;id&q;:16569,&q;userId&q;:70075243,&q;name&q;:&q;尚美琦&q;,&q;brief&q;:&q;粉笔优质讲师&q;,&q;desc&q;:&q;粉笔优质教师\n六年一线教学授课经验，曾承担线上+线下精品班、刷题班授课，授课时长3000+小时 具有判断科目丰富的实践经验及系统扎实的专业理论知识，对事业编联考及军队文职考情深入研究 ①撰写多篇事业单位笔试教研材料，在粉笔教师内部进行共享； ②多次参加粉笔授课研讨会议，全面把握事考命题趋势及最新考情，多次参加粉笔教研活动，分享授课经验心得，助力粉笔理论研发升级 累计评分达4.9，细致幽默的讲解风格，让学生在轻松的学习氛围中，用更简单的方法，更通俗的例子解题，深受广大学员的认可和好评；在学员中具有非常好的口碑，是值得信赖的好导师。&q;,&q;avatar&q;:&q;17467e73b22e1a8.jpg&q;,&q;upperBodyPhoto&q;:null,&q;displayCoursePrefix&q;:&q;sydw&q;,&q;teacherStat&q;:{&q;teacherId&q;:16569,&q;episodeCount&q;:480,&q;scoreCount&q;:1699,&q;avgScore&q;:9.822248381400826,&q;fiveGradeAvgScore&q;:4.91,&q;updateTime&q;:1773611259167},&q;auditionEpisode&q;:{&q;episodeTitle&q;:&q;个人展示课&q;,&q;episodeVideoUrl&q;:&q;https://vod.fbstatic.cn/22e9ceb2vodbj1251001446/e44a7b0c5145403708868581059/9u4GtiC34EwA.mp4?t=f2a4b300&a;us=4070880000&a;sign=100de2e81d7376355ed86e067629ba50&q;},&q;memberOfCPC&q;:false,&q;tags&q;:null},&q;teachChannel&q;:1,&q;offline&q;:null,&q;duration&q;:7404,&q;hasAudition&q;:false,&q;bizType&q;:0,&q;bizId&q;:&q;726825&q;,&q;supportReplay&q;:true,&q;extraInfo&q;:null,&q;liveConfig&q;:{&q;episodeId&q;:11003571,&q;supportMultiGroup&q;:false,&q;exerciseBizType&q;:0,&q;videoDisplayType&q;:0,&q;avForwardType&q;:0,&q;useIntelligentRoom&q;:false,&q;hasStrokeKeynote&q;:true,&q;verticalModeType&q;:0,&q;originEpisodeId&q;:0,&q;supportRtmp&q;:false,&q;supportPk&q;:true,&q;supportLuckyBag&q;:true,&q;supportUserNoteStroke&q;:false,&q;communicateType&q;:0,&q;one2One&q;:false,&q;fakeLive&q;:false},&q;validStatus&q;:1,&q;supportLive&q;:true,&q;supportAiCatalog&q;:false,&q;hasIntelligentPen&q;:false,&q;useLocalRecording&q;:false,&q;useIntelligentRoom&q;:false,&q;hasSalePosition&q;:false,&q;hasEpisodeCards&q;:true,&q;lockedForShouna&q;:false,&q;needSignIn&q;:false,&q;needTeacherSignIn&q;:false,&q;enablePadPencil&q;:true,&q;displayExercise&q;:false,&q;supportLuckyBag&q;:true,&q;supportLivePk&q;:true},{&q;id&q;:11003586,&q;kePrefix&q;:&q;sydw&q;,&q;courseId&q;:6,&q;status&q;:3,&q;playStatus&q;:3,&q;type&q;:33,&q;recordingType&q;:0,&q;mediaType&q;:0,&q;title&q;:&q;【言语】精选好题 沉浸刷题&q;,&q;innerTitle&q;:&q;&q;,&q;startTime&q;:1759132800000,&q;endTime&q;:1759140000000,&q;teacher&q;:{&q;id&q;:16686,&q;userId&q;:69893637,&q;name&q;:&q;刘期期&q;,&q;brief&q;:&q;粉笔优质讲师&q;,&q;desc&q;:&q;粉笔优质讲师\n毕业于211大学，投身教育事业6年时间，对言语科目有丰富的实践经验，参与真题的解析和模拟题的命制，课程累计评分4.9分。了解考场答题思维及应变技巧，注重启发式授课，让学生在轻松的氛围中找到高效的解题方法。授课风格风趣幽默，课堂互动性强，善于从学员角度出发解决个性化问题，激发学员学习热情和自主意识，注重理论与实践相结合。&q;,&q;avatar&q;:&q;1746bbe5d160d43.jpg&q;,&q;upperBodyPhoto&q;:null,&q;displayCoursePrefix&q;:&q;sydw&q;,&q;teacherStat&q;:{&q;teacherId&q;:16686,&q;episodeCount&q;:447,&q;scoreCount&q;:2045,&q;avgScore&q;:9.762347188264059,&q;fiveGradeAvgScore&q;:4.88,&q;updateTime&q;:1773546406556},&q;auditionEpisode&q;:{&q;episodeTitle&q;:&q;个人展示课&q;,&q;episodeVideoUrl&q;:&q;https://vod.fbstatic.cn/22e9ceb2vodbj1251001446/077558931397757911915926552/PpFe6z48T8UA.mp4?t=f2a4b300&a;us=4070880000&a;sign=6bc5b6dbf5223797c9f2083c2bb5bf66&q;},&q;memberOfCPC&q;:false,&q;tags&q;:null},&q;teachChannel&q;:1,&q;offline&q;:null,&q;duration&q;:7976,&q;hasAudition&q;:false,&q;bizType&q;:0,&q;bizId&q;:&q;726825&q;,&q;supportReplay&q;:true,&q;extraInfo&q;:null,&q;liveConfig&q;:{&q;episodeId&q;:11003586,&q;supportMultiGroup&q;:false,&q;exerciseBizType&q;:0,&q;videoDisplayType&q;:0,&q;avForwardType&q;:0,&q;useIntelligentRoom&q;:false,&q;hasStrokeKeynote&q;:true,&q;verticalModeType&q;:0,&q;originEpisodeId&q;:0,&q;supportRtmp&q;:false,&q;supportPk&q;:true,&q;supportLuckyBag&q;:true,&q;supportUserNoteStroke&q;:false,&q;communicateType&q;:0,&q;one2One&q;:false,&q;fakeLive&q;:false},&q;validStatus&q;:1,&q;supportLive&q;:true,&q;supportAiCatalog&q;:false,&q;hasIntelligentPen&q;:false,&q;useLocalRecording&q;:false,&q;useIntelligentRoom&q;:false,&q;hasSalePosition&q;:false,&q;hasEpisodeCards&q;:true,&q;lockedForShouna&q;:false,&q;needSignIn&q;:false,&q;needTeacherSignIn&q;:false,&q;enablePadPencil&q;:true,&q;displayExercise&q;:false,&q;supportLuckyBag&q;:true,&q;supportLivePk&q;:true},{&q;id&q;:11003587,&q;kePrefix&q;:&q;sydw&q;,&q;courseId&q;:6,&q;status&q;:3,&q;playStatus&q;:3,&q;type&q;:33,&q;recordingType&q;:0,&q;mediaType&q;:0,&q;title&q;:&q;【综应】精选好题 沉浸刷题&q;,&q;innerTitle&q;:&q;&q;,&q;startTime&q;:1759197600000,&q;endTime&q;:1759204800000,&q;teacher&q;:{&q;id&q;:35912,&q;userId&q;:84301173,&q;name&q;:&q;黄迟驰&q;,&q;brief&q;:&q;粉笔优质讲师&q;,&q;desc&q;:&q;粉笔优质讲师\n投身教育事业5年，拥有扎实一线教学经验。承接过各省份笔试系统班，刷题冲刺营，冲刺营，刷题营等班型，服务过近千名学员。参与题库解析课录制，综应一对一课程，综应刷题课。深耕事业单位考试，全面了解事业单位综合应用能力科目考试的命题规律及答题技巧。针对学生困惑研究教学策略，深入研讨最新考情。注重自我提升，每年度多次参加培训学习和综应科目教研，并取得优异成绩。积极分享经验心得，助力粉笔理论研发持续升级，积累丰富笔试理论知识。注重理论与实践相结合，让学生在轻松的学习氛围中，用更简单的方法，找到更快捷的解题之道，深受学员的认可和好评。&q;,&q;avatar&q;:&q;193af66b81fc0b1.jpg&q;,&q;upperBodyPhoto&q;:null,&q;displayCoursePrefix&q;:&q;sydw&q;,&q;teacherStat&q;:{&q;teacherId&q;:35912,&q;episodeCount&q;:195,&q;scoreCount&q;:305,&q;avgScore&q;:9.947540983606558,&q;fiveGradeAvgScore&q;:4.97,&q;updateTime&q;:1773557231120},&q;auditionEpisode&q;:{&q;episodeTitle&q;:&q;个人展示课&q;,&q;episodeVideoUrl&q;:&q;https://vod.fbstatic.cn/22e9ceb2vodbj1251001446/ba2b7e275145403709538047971/m0NVEgAoIxsA.mp4?t=f2a4b300&a;us=4070880000&a;sign=90823bb2aa3547011e7a0d5700585e7c&q;},&q;memberOfCPC&q;:false,&q;tags&q;:null},&q;teachChannel&q;:1,&q;offline&q;:null,&q;duration&q;:7954,&q;hasAudition&q;:false,&q;bizType&q;:0,&q;bizId&q;:&q;726825&q;,&q;supportReplay&q;:true,&q;extraInfo&q;:null,&q;liveConfig&q;:{&q;episodeId&q;:11003587,&q;supportMultiGroup&q;:false,&q;exerciseBizType&q;:0,&q;videoDisplayType&q;:0,&q;avForwardType&q;:0,&q;useIntelligentRoom&q;:false,&q;hasStrokeKeynote&q;:true,&q;verticalModeType&q;:0,&q;originEpisodeId&q;:0,&q;supportRtmp&q;:false,&q;supportPk&q;:true,&q;supportLuckyBag&q;:true,&q;supportUserNoteStroke&q;:false,&q;communicateType&q;:0,&q;one2One&q;:false,&q;fakeLive&q;:false},&q;validStatus&q;:1,&q;supportLive&q;:true,&q;supportAiCatalog&q;:false,&q;hasIntelligentPen&q;:false,&q;useLocalRecording&q;:false,&q;useIntelligentRoom&q;:false,&q;hasSalePosition&q;:false,&q;hasEpisodeCards&q;:true,&q;lockedForShouna&q;:false,&q;needSignIn&q;:false,&q;needTeacherSignIn&q;:false,&q;enablePadPencil&q;:true,&q;displayExercise&q;:false,&q;supportLuckyBag&q;:true,&q;supportLivePk&q;:true},{&q;id&q;:11003598,&q;kePrefix&q;:&q;sydw&q;,&q;courseId&q;:6,&q;status&q;:3,&q;playStatus&q;:3,&q;type&q;:33,&q;recordingType&q;:0,&q;mediaType&q;:0,&q;title&q;:&q;【公基非法】精选好题 沉浸刷题&q;,&q;innerTitle&q;:&q;&q;,&q;startTime&q;:1759204800000,&q;endTime&q;:1759212000000,&q;teacher&q;:{&q;id&q;:22805,&q;userId&q;:70647629,&q;name&q;:&q;韩健&q;,&q;brief&q;:&q;粉笔优质讲师&q;,&q;desc&q;:&q;粉笔优质讲师。从事线上常识公基科目教研授课长达6年，拥有非常丰富扎实的一线授课经验，承担多种产品类型的授课工作。\n教研上，具有非法科目丰富的实践经验及系统扎实的专业理论知识，对常识公基非法考情有着深入的研究，长期承担非法板块小模考授课，曾多次参与命制笔试真题教研和解析撰写工作，致力于研究事业单位的命题规律及答题技巧，并负责非法多科目单题录制工作。\n教学上，教学思路开阔，灵活举一反三，深入浅出，善于引导和启发学生；讲课逻辑性强条分缕析，善长归纳方法技巧；课堂互动性强，善于从学员角度出发解决问题。\n授课风格循循善诱，细致耐心，亲和力强，寓教于乐，课堂氛围轻松有趣无负担，深受学生喜爱，长期累计评分达4.9，广受信赖。&q;,&q;avatar&q;:&q;193af5a8fdca2ae.jpg&q;,&q;upperBodyPhoto&q;:null,&q;displayCoursePrefix&q;:&q;sydw&q;,&q;teacherStat&q;:{&q;teacherId&q;:22805,&q;episodeCount&q;:944,&q;scoreCount&q;:2442,&q;avgScore&q;:9.809172809172814,&q;fiveGradeAvgScore&q;:4.9,&q;updateTime&q;:1773565663692},&q;auditionEpisode&q;:{&q;episodeTitle&q;:&q;个人展示课&q;,&q;episodeVideoUrl&q;:&q;https://vod.fbstatic.cn/22e9ceb2vodbj1251001446/c570221f5145403709396241830/189czrPabqQA.mp4?t=f2a4b300&a;us=4070880000&a;sign=a910a17501a492740f4ece27556c8403&q;},&q;memberOfCPC&q;:false,&q;tags&q;:null},&q;teachChannel&q;:1,&q;offline&q;:null,&q;duration&q;:7507,&q;hasAudition&q;:false,&q;bizType&q;:0,&q;bizId&q;:&q;726825&q;,&q;supportReplay&q;:true,&q;extraInfo&q;:null,&q;liveConfig&q;:{&q;episodeId&q;:11003598,&q;supportMultiGroup&q;:false,&q;exerciseBizType&q;:0,&q;videoDisplayType&q;:0,&q;avForwardType&q;:0,&q;useIntelligentRoom&q;:false,&q;hasStrokeKeynote&q;:true,&q;verticalModeType&q;:0,&q;originEpisodeId&q;:0,&q;supportRtmp&q;:false,&q;supportPk&q;:true,&q;supportLuckyBag&q;:true,&q;supportUserNoteStroke&q;:false,&q;communicateType&q;:0,&q;one2One&q;:false,&q;fakeLive&q;:false},&q;validStatus&q;:1,&q;supportLive&q;:true,&q;supportAiCatalog&q;:false,&q;hasIntelligentPen&q;:false,&q;useLocalRecording&q;:false,&q;useIntelligentRoom&q;:false,&q;hasSalePosition&q;:false,&q;hasEpisodeCards&q;:true,&q;lockedForShouna&q;:false,&q;needSignIn&q;:false,&q;needTeacherSignIn&q;:false,&q;enablePadPencil&q;:true,&q;displayExercise&q;:false,&q;supportLuckyBag&q;:true,&q;supportLivePk&q;:true},{&q;id&q;:11003609,&q;kePrefix&q;:&q;sydw&q;,&q;courseId&q;:6,&q;status&q;:3,&q;playStatus&q;:3,&q;type&q;:33,&q;recordingType&q;:0,&q;mediaType&q;:0,&q;title&q;:&q;【公基非法】精选好题 沉浸刷题&q;,&q;innerTitle&q;:&q;&q;,&q;startTime&q;:1759212000000,&q;endTime&q;:1759219200000,&q;teacher&q;:{&q;id&q;:15525,&q;userId&q;:70929101,&q;name&q;:&q;曾庆顺&q;,&q;brief&q;:&q;粉笔优质讲师&q;,&q;desc&q;:&q;粉笔优质讲师\n7年一线教学经验，长期从事一线教学教研工作，承担过线上精品班、刷题班等多种班型，授课时长逾千小时。\n具有丰富的公共基础知识和言语理解与表达科目实践经验，专业理论知识系统扎实，对各地事业单位考试考情、真题和命题方向理解深刻。\n善于整合梳理琐碎的知识，授课方式轻松、逻辑清晰，针对性强，能够帮助学员快速掌握考试内容，高效应对考试，广受学员好评。&q;,&q;avatar&q;:&q;1942615d3a3ad1d.jpg&q;,&q;upperBodyPhoto&q;:null,&q;displayCoursePrefix&q;:&q;sydw&q;,&q;teacherStat&q;:{&q;teacherId&q;:15525,&q;episodeCount&q;:806,&q;scoreCount&q;:2325,&q;avgScore&q;:9.814193548387102,&q;fiveGradeAvgScore&q;:4.91,&q;updateTime&q;:1773546837992},&q;auditionEpisode&q;:{&q;episodeTitle&q;:&q;个人展示课&q;,&q;episodeVideoUrl&q;:&q;https://vod.fbstatic.cn/22e9ceb2vodbj1251001446/71ee116a5145403709537258089/2LP134uazlcA.mp4?t=f2a4b300&a;us=4070880000&a;sign=2d5f6eba8adee3c57c0ab2f8326a11f5&q;},&q;memberOfCPC&q;:false,&q;tags&q;:null},&q;teachChannel&q;:1,&q;offline&q;:null,&q;duration&q;:8210,&q;hasAudition&q;:false,&q;bizType&q;:0,&q;bizId&q;:&q;726825&q;,&q;supportReplay&q;:true,&q;extraInfo&q;:null,&q;liveConfig&q;:{&q;episodeId&q;:11003609,&q;supportMultiGroup&q;:false,&q;exerciseBizType&q;:0,&q;videoDisplayType&q;:0,&q;avForwardType&q;:0,&q;useIntelligentRoom&q;:false,&q;hasStrokeKeynote&q;:true,&q;verticalModeType&q;:0,&q;originEpisodeId&q;:0,&q;supportRtmp&q;:false,&q;supportPk&q;:true,&q;supportLuckyBag&q;:true,&q;supportUserNoteStroke&q;:false,&q;communicateType&q;:0,&q;one2One&q;:false,&q;fakeLive&q;:false},&q;validStatus&q;:1,&q;supportLive&q;:true,&q;supportAiCatalog&q;:false,&q;hasIntelligentPen&q;:false,&q;useLocalRecording&q;:false,&q;useIntelligentRoom&q;:false,&q;hasSalePosition&q;:false,&q;hasEpisodeCards&q;:true,&q;lockedForShouna&q;:false,&q;needSignIn&q;:false,&q;needTeacherSignIn&q;:false,&q;enablePadPencil&q;:true,&q;displayExercise&q;:false,&q;supportLuckyBag&q;:true,&q;supportLivePk&q;:true},{&q;id&q;:11003685,&q;kePrefix&q;:&q;sydw&q;,&q;courseId&q;:6,&q;status&q;:3,&q;playStatus&q;:3,&q;type&q;:33,&q;recordingType&q;:0,&q;mediaType&q;:0,&q;title&q;:&q;【公基非法】精选好题 沉浸刷题&q;,&q;innerTitle&q;:&q;&q;,&q;startTime&q;:1759219200000,&q;endTime&q;:1759226400000,&q;teacher&q;:{&q;id&q;:34183,&q;userId&q;:83886596,&q;name&q;:&q;赵佳佳&q;,&q;brief&q;:&q;粉笔优质讲师&q;,&q;desc&q;:&q;粉笔常识公基优质讲师\n6年一线教学经验，深耕事业单位考试，承担过笔试精品班、刷题班等多种班型，授课和实战经验丰富。\n\n曾参与真题教研解析工作，教研文章撰写工作，模拟题的教研工作，对最新命题趋势方向有深入研究;\n多次参加粉笔授课研讨会议，注重考场思维，针对学生困惑研究教学策略，深入研讨事考命题趋势及最新考情，注重自我提升，积累丰富笔试理论知识;\n累计授课超1400小时，累计评分达4.9分，善于把握学员个性化特点，因材施教，认真负责，真诚对待每一位学员。讲课生动形象，有代入感，学员可以在轻松愉快的氛围中学习，跟着老师节奏主动思考，学习知识，掌握知识。&q;,&q;avatar&q;:&q;1983ba750d61d0b.jpg&q;,&q;upperBodyPhoto&q;:null,&q;displayCoursePrefix&q;:&q;sydw&q;,&q;teacherStat&q;:{&q;teacherId&q;:34183,&q;episodeCount&q;:689,&q;scoreCount&q;:1641,&q;avgScore&q;:9.802559414990869,&q;fiveGradeAvgScore&q;:4.9,&q;updateTime&q;:1771456495223},&q;auditionEpisode&q;:null,&q;memberOfCPC&q;:false,&q;tags&q;:null},&q;teachChannel&q;:1,&q;offline&q;:null,&q;duration&q;:7896,&q;hasAudition&q;:false,&q;bizType&q;:0,&q;bizId&q;:&q;726825&q;,&q;supportReplay&q;:true,&q;extraInfo&q;:null,&q;liveConfig&q;:{&q;episodeId&q;:11003685,&q;supportMultiGroup&q;:false,&q;exerciseBizType&q;:0,&q;videoDisplayType&q;:0,&q;avForwardType&q;:0,&q;useIntelligentRoom&q;:false,&q;hasStrokeKeynote&q;:true,&q;verticalModeType&q;:0,&q;originEpisodeId&q;:0,&q;supportRtmp&q;:false,&q;supportPk&q;:true,&q;supportLuckyBag&q;:true,&q;supportUserNoteStroke&q;:false,&q;communicateType&q;:0,&q;one2One&q;:false,&q;fakeLive&q;:false},&q;validStatus&q;:1,&q;supportLive&q;:true,&q;supportAiCatalog&q;:false,&q;hasIntelligentPen&q;:false,&q;useLocalRecording&q;:false,&q;useIntelligentRoom&q;:false,&q;hasSalePosition&q;:false,&q;hasEpisodeCards&q;:true,&q;lockedForShouna&q;:false,&q;needSignIn&q;:false,&q;needTeacherSignIn&q;:false,&q;enablePadPencil&q;:true,&q;displayExercise&q;:false,&q;supportLuckyBag&q;:true,&q;supportLivePk&q;:true},{&q;id&q;:10920933,&q;kePrefix&q;:&q;sydw&q;,&q;courseId&q;:6,&q;status&q;:3,&q;playStatus&q;:3,&q;type&q;:33,&q;recordingType&q;:0,&q;mediaType&q;:0,&q;title&q;:&q;【公基非法】精选好题 沉浸刷题&q;,&q;innerTitle&q;:&q;&q;,&q;startTime&q;:1754013600000,&q;endTime&q;:1754020800000,&q;teacher&q;:{&q;id&q;:18668,&q;userId&q;:69522017,&q;name&q;:&q;王杉&q;,&q;brief&q;:&q;粉笔优质讲师&q;,&q;desc&q;:&q;粉笔优质讲师。拥有六年一线授课经验，参与多种课程类型的教学，积累了丰富的授课经验。在常识公共基础知识和言语科目教学中，结合山东、福建、四川、江苏等地的地方考情，深入理解真题命题方向。授课风格幽默活泼，善于将时事热点与理论知识结合，帮助学生更好地理解和记忆。&q;,&q;avatar&q;:&q;193af589c3b05e6.jpg&q;,&q;upperBodyPhoto&q;:null,&q;displayCoursePrefix&q;:&q;sydw&q;,&q;teacherStat&q;:{&q;teacherId&q;:18668,&q;episodeCount&q;:613,&q;scoreCount&q;:1605,&q;avgScore&q;:9.823052959501561,&q;fiveGradeAvgScore&q;:4.91,&q;updateTime&q;:1773481515764},&q;auditionEpisode&q;:null,&q;memberOfCPC&q;:false,&q;tags&q;:null},&q;teachChannel&q;:1,&q;offline&q;:null,&q;duration&q;:7273,&q;hasAudition&q;:false,&q;bizType&q;:0,&q;bizId&q;:&q;726825&q;,&q;supportReplay&q;:true,&q;extraInfo&q;:null,&q;liveConfig&q;:{&q;episodeId&q;:10920933,&q;supportMultiGroup&q;:false,&q;exerciseBizType&q;:0,&q;videoDisplayType&q;:0,&q;avForwardType&q;:0,&q;useIntelligentRoom&q;:false,&q;hasStrokeKeynote&q;:true,&q;verticalModeType&q;:0,&q;originEpisodeId&q;:0,&q;supportRtmp&q;:false,&q;supportPk&q;:true,&q;supportLuckyBag&q;:true,&q;supportUserNoteStroke&q;:false,&q;communicateType&q;:0,&q;one2One&q;:false,&q;fakeLive&q;:false},&q;validStatus&q;:1,&q;supportLive&q;:true,&q;supportAiCatalog&q;:false,&q;hasIntelligentPen&q;:false,&q;useLocalRecording&q;:false,&q;useIntelligentRoom&q;:false,&q;hasSalePosition&q;:false,&q;hasEpisodeCards&q;:true,&q;lockedForShouna&q;:false,&q;needSignIn&q;:false,&q;needTeacherSignIn&q;:false,&q;enablePadPencil&q;:true,&q;displayExercise&q;:false,&q;supportLuckyBag&q;:true,&q;supportLivePk&q;:true},{&q;id&q;:10921278,&q;kePrefix&q;:&q;sydw&q;,&q;courseId&q;:6,&q;status&q;:3,&q;playStatus&q;:3,&q;type&q;:33,&q;recordingType&q;:0,&q;mediaType&q;:0,&q;title&q;:&q;【言语】精选好题 沉浸刷题&q;,&q;innerTitle&q;:&q;&q;,&q;startTime&q;:1754028000000,&q;endTime&q;:1754035200000,&q;teacher&q;:{&q;id&q;:17198,&q;userId&q;:73655782,&q;name&q;:&q;陈灵均&q;,&q;brief&q;:&q;粉笔优质讲师&q;,&q;desc&q;:&q;粉笔优质讲师\n六年教学经验，承担各种班型授课，理论知识扎实，能帮助考生系统备考，提高应试能力。\n深入研究各地真题，多次参与真题解析、模拟题命制等教研活动，准确把握考试动态及命题趋势，为考生提供备考方向和策略。\n授课深入浅出，化繁为简，擅长提炼逻辑和规律，帮助考生掌握核心要点，举一反三&q;,&q;avatar&q;:&q;1823937972498f7.jpg&q;,&q;upperBodyPhoto&q;:null,&q;displayCoursePrefix&q;:&q;sydw&q;,&q;teacherStat&q;:{&q;teacherId&q;:17198,&q;episodeCount&q;:462,&q;scoreCount&q;:1403,&q;avgScore&q;:9.81183178902352,&q;fiveGradeAvgScore&q;:4.91,&q;updateTime&q;:1773580094665},&q;auditionEpisode&q;:{&q;episodeTitle&q;:&q;个人展示课&q;,&q;episodeVideoUrl&q;:&q;https://vod.fbstatic.cn/22e9ceb2vodbj1251001446/48fa213a5145403708523044176/CrD3nYrPU6oA.mp4?t=f2a4b300&a;us=4070880000&a;sign=bdd8d0a92b