nt&q;:1380,&q;scoreCount&q;:145728,&q;avgScore&q;:9.769817742643832,&q;fiveGradeAvgScore&q;:4.88,&q;updateTime&q;:1773622979346},&q;auditionEpisode&q;:{&q;episodeTitle&q;:&q;个人展示课&q;,&q;episodeVideoUrl&q;:&q;https://vod.fbstatic.cn/22e9ceb2vodbj1251001446/59912ccc3560136621446868819/CrZHOnpTvoAA.mp4?t=f2a4b300&a;us=4070880000&a;sign=303b062e9bd2fe154863f9991d75a247&q;},&q;memberOfCPC&q;:false,&q;tags&q;:null},{&q;id&q;:4631,&q;userId&q;:53050352,&q;name&q;:&q;李玟冰&q;,&q;brief&q;:&q;粉笔言语优质教师&q;,&q;desc&q;:&q;粉笔言语优质教师，7年公考培训经验，坚信“因材施教、寓教于乐”的教学理念。言语专业功底扎实，授课逻辑清晰，善于引发学生思考，注重课程实用性，对题型有独特的理解，梳理出实用性的言语解题思路，擅长“深入浅出”的授课风格。&q;,&q;avatar&q;:&q;171a64837d3cc60.jpg&q;,&q;upperBodyPhoto&q;:null,&q;displayCoursePrefix&q;:&q;gwy&q;,&q;teacherStat&q;:{&q;teacherId&q;:4631,&q;episodeCount&q;:1337,&q;scoreCount&q;:188687,&q;avgScore&q;:9.761679394976884,&q;fiveGradeAvgScore&q;:4.88,&q;updateTime&q;:1773621606522},&q;auditionEpisode&q;:{&q;episodeTitle&q;:&q;个人展示课&q;,&q;episodeVideoUrl&q;:&q;https://vod.fbstatic.cn/22e9ceb2vodbj1251001446/e2d793203560136621448119609/9yfzlYT6RAgA.mp4?t=f2a4b300&a;us=4070880000&a;sign=9dde19cf86d5d7cc4cd79b97f111aab8&q;},&q;memberOfCPC&q;:false,&q;tags&q;:null},{&q;id&q;:5221,&q;userId&q;:45428554,&q;name&q;:&q;许顺&q;,&q;brief&q;:&q;粉笔言语优质教师&q;,&q;desc&q;:&q;粉笔言语优质教师，8年一线授课经验，培训师资数百人，服务学员超百万人，实战经验丰富，曾多次高分进面。长期深耕公务员考试领域，对试题有独到见解和深刻把握。授课风格独树一帜，课堂氛围轻松幽默，考情剖析精准入微，用专业与热情为学子点亮求知之路，引领其在知识海洋破浪前行。 \n参与组织各类授课研讨会议和教研活动，参与编撰《笔试系统讲义》《精品系统讲义》《行测的思维》《决战行测5000题》等多套图书。&q;,&q;avatar&q;:&q;164688ac9182991.png&q;,&q;upperBodyPhoto&q;:null,&q;displayCoursePrefix&q;:&q;gwy&q;,&q;teacherStat&q;:{&q;teacherId&q;:5221,&q;episodeCount&q;:1330,&q;scoreCount&q;:217776,&q;avgScore&q;:9.756887811329094,&q;fiveGradeAvgScore&q;:4.88,&q;updateTime&q;:1773623380485},&q;auditionEpisode&q;:{&q;episodeTitle&q;:&q;个人展示课&q;,&q;episodeVideoUrl&q;:&q;https://vod.fbstatic.cn/22e9ceb2vodbj1251001446/570389653560136621446734838/9l2Tds3aXxkA.mp4?t=f2a4b300&a;us=4070880000&a;sign=47533fe75a70ebac353439ec55a7b251&q;},&q;memberOfCPC&q;:false,&q;tags&q;:null},{&q;id&q;:75157,&q;userId&q;:40558696,&q;name&q;:&q;李亚_&q;,&q;brief&q;:&q;粉笔判断优质老师&q;,&q;desc&q;:&q;粉笔判断优质老师\n985院校毕业，10年公考授课经验，培训学员上百万，学员喜欢称其为“亚神”。曾带领教研团队编写图书《公考培训指定讲义》。授课思路清晰，逻辑思维很强，教研经验独到，可以颠覆学员的传统学习认知，通过思维的塑造让学员学会“以不变应万变”，真正实现举一反三，高效学习！&q;,&q;avatar&q;:&q;19647aa58ea964f.jpg&q;,&q;upperBodyPhoto&q;:null,&q;displayCoursePrefix&q;:&q;gwy&q;,&q;teacherStat&q;:{&q;teacherId&q;:75157,&q;episodeCount&q;:209,&q;scoreCount&q;:19729,&q;avgScore&q;:9.838207714531903,&q;fiveGradeAvgScore&q;:4.92,&q;updateTime&q;:1773558978780},&q;auditionEpisode&q;:{&q;episodeTitle&q;:&q;个人展示课&q;,&q;episodeVideoUrl&q;:&q;https://vod.fbstatic.cn/22e9ceb2vodbj1251001446/6a71ea723560136624507360031/qZJU0tdQjZkA.mp4?t=f2a4b300&a;us=4070880000&a;sign=b51dc80e4bc1394244e982f4bf29f506&q;},&q;memberOfCPC&q;:false,&q;tags&q;:null},{&q;id&q;:2772,&q;userId&q;:45155918,&q;name&q;:&q;习明&q;,&q;brief&q;:&q;粉笔公考申论优质讲师&q;,&q;desc&q;:&q;粉笔优质讲师。8年公考培训经验，拥有3次国省考实战经验且都笔试第一进面，985高校毕业，善于并乐于分享学习经验。授课深入浅出，化繁为简，逻辑清晰、生动有趣。能站在学员角度传授方法，站在命题者阅卷者角度解读材料，实用性强。&q;,&q;avatar&q;:&q;193af6f0f1c8020.jpg&q;,&q;upperBodyPhoto&q;:null,&q;displayCoursePrefix&q;:&q;gwy&q;,&q;teacherStat&q;:{&q;teacherId&q;:2772,&q;episodeCount&q;:1020,&q;scoreCount&q;:56843,&q;avgScore&q;:9.792058828703622,&q;fiveGradeAvgScore&q;:4.9,&q;updateTime&q;:1773587480123},&q;auditionEpisode&q;:{&q;episodeTitle&q;:&q;个人展示课&q;,&q;episodeVideoUrl&q;:&q;https://vod.fbstatic.cn/22e9ceb2vodbj1251001446/583198fe1397757891876483714/FFuNblAiaCoA.mp4?t=f2a4b300&a;us=4070880000&a;sign=5372c7a3963b9d8545ab13cdcdb31416&q;},&q;memberOfCPC&q;:false,&q;tags&q;:null},{&q;id&q;:4650,&q;userId&q;:49294864,&q;name&q;:&q;姜然&q;,&q;brief&q;:&q;粉笔言语优质教师&q;,&q;desc&q;:&q;粉笔言语优质教师。\n8年以上公考培训经验，硕士研究生学历，累计授课时长超9000小时，学员评分高达4.9分。理论功底扎实，深入研究国省考、事业单位等各类笔试考情及命题特色，长期从事精讲、刷题、冲刺等等各阶段课程的教学工作，并长期参与真题解析、模拟题命制、师资培训等各类教研工作。授课逻辑清晰、内容严谨、气氛活泼。善于帮助学生总结方法、拓展思维，全面提升学生的解题能力，深受学员好评。&q;,&q;avatar&q;:&q;192d26d31a437b1.jpg&q;,&q;upperBodyPhoto&q;:null,&q;displayCoursePrefix&q;:&q;gwy&q;,&q;teacherStat&q;:{&q;teacherId&q;:4650,&q;episodeCount&q;:1227,&q;scoreCount&q;:34573,&q;avgScore&q;:9.80545512394065,&q;fiveGradeAvgScore&q;:4.9,&q;updateTime&q;:1773583363494},&q;auditionEpisode&q;:{&q;episodeTitle&q;:&q;个人展示课&q;,&q;episodeVideoUrl&q;:&q;https://vod.fbstatic.cn/22e9ceb2vodbj1251001446/43caa7d01397757908836433143/QlBBloizdy4A.mp4?t=f2a4b300&a;us=4070880000&a;sign=a733a0002b502cecaf8e254010c2e7e4&q;},&q;memberOfCPC&q;:false,&q;tags&q;:null},{&q;id&q;:8586,&q;userId&q;:49917444,&q;name&q;:&q;江雅&q;,&q;brief&q;:&q;粉笔言语优质教师&q;,&q;desc&q;:&q;粉笔言语优质教师，6年一线授课经验，累计授课时长10000h＋，授课评分高达4.9，上过国考联考浙江江苏山东北京上海山西福建江西等省份的精讲强化刷题冲刺拔高考前点拨。注重“反套路”教学，善于带领学员走出刷题模板与学习误区。授课深入浅出，条理清楚，层层剖析，环环相扣，论证严密，结构严谨，学生不仅能学到知识，还能锻炼逻辑思维能力，帮助学生快速提高。&q;,&q;avatar&q;:&q;1927f4f2c5ffc0b.jpg&q;,&q;upperBodyPhoto&q;:null,&q;displayCoursePrefix&q;:&q;gwy&q;,&q;teacherStat&q;:{&q;teacherId&q;:8586,&q;episodeCount&q;:1587,&q;scoreCount&q;:15378,&q;avgScore&q;:9.838340486409155,&q;fiveGradeAvgScore&q;:4.92,&q;updateTime&q;:1773584458589},&q;auditionEpisode&q;:{&q;episodeTitle&q;:&q;个人展示课&q;,&q;episodeVideoUrl&q;:&q;https://vod.fbstatic.cn/22e9ceb2vodbj1251001446/5e9bd9473560136621453828487/iNqvNIIUmx8A.mp4?t=f2a4b300&a;us=4070880000&a;sign=f0b0d1615b7d585a3ebba686839bc39a&q;},&q;memberOfCPC&q;:false,&q;tags&q;:null},{&q;id&q;:3258,&q;userId&q;:46235476,&q;name&q;:&q;陈苏&q;,&q;brief&q;:&q;粉笔申论优质教师&q;,&q;desc&q;:&q;粉笔申论优质教师，7年公考培训经验，学员评分高达4.9分，理论知识扎实，授课经验丰富，讲解逻辑清晰，重难点突出。语言风趣幽默，富有激情，善用形象化比喻将复杂问题简单化，擅长发现学员弱点，带领学员重点突破、触类旁通、举一反三，提升学生学习效率。&q;,&q;avatar&q;:&q;176b65e525d0716.jpg&q;,&q;upperBodyPhoto&q;:null,&q;displayCoursePrefix&q;:&q;gwy&q;,&q;teacherStat&q;:{&q;teacherId&q;:3258,&q;episodeCount&q;:1073,&q;scoreCount&q;:168954,&q;avgScore&q;:9.745137729796262,&q;fiveGradeAvgScore&q;:4.87,&q;updateTime&q;:1773586938425},&q;auditionEpisode&q;:{&q;episodeTitle&q;:&q;个人展示课&q;,&q;episodeVideoUrl&q;:&q;https://vod.fbstatic.cn/22e9ceb2vodbj1251001446/9d358d213560136621447466084/kkZrGof7aQQA.mp4?t=f2a4b300&a;us=4070880000&a;sign=9c31e498c59df461e7583f6c558b85d5&q;},&q;memberOfCPC&q;:false,&q;tags&q;:null},{&q;id&q;:3254,&q;userId&q;:44831200,&q;name&q;:&q;刘歆玥&q;,&q;brief&q;:&q;粉笔申论优质教师&q;,&q;desc&q;:&q;粉笔申论优质教师。\n从事公考行业8年，授课时长超10000小时，学员评价高达4.9分。授课以学生需求为主，耐心细致，始终以学生听得懂、用得好为宗旨，善于激发学员思考，循循善诱。授课重点突出、思路清晰、逻辑透彻，擅长总结同类题型规律，主张“从一道题中学会一类题”，助力学员上岸。&q;,&q;avatar&q;:&q;1927039d453dff1.jpg&q;,&q;upperBodyPhoto&q;:null,&q;displayCoursePrefix&q;:&q;gwy&q;,&q;teacherStat&q;:{&q;teacherId&q;:3254,&q;episodeCount&q;:1051,&q;scoreCount&q;:17698,&q;avgScore&q;:9.824612950615887,&q;fiveGradeAvgScore&q;:4.91,&q;updateTime&q;:1773402587333},&q;auditionEpisode&q;:{&q;episodeTitle&q;:&q;个人展示课&q;,&q;episodeVideoUrl&q;:&q;https://vod.fbstatic.cn/22e9ceb2vodbj1251001446/c2c9094f1397757909318429213/KNibOwumJZcA.mp4?t=f2a4b300&a;us=4070880000&a;sign=8f3d44364fa9c342e12deb5b5ac0d3d9&q;},&q;memberOfCPC&q;:false,&q;tags&q;:null},{&q;id&q;:6604,&q;userId&q;:51148746,&q;name&q;:&q;王天鸽&q;,&q;brief&q;:&q;粉笔申论优质教师&q;,&q;desc&q;:&q;粉笔申论优质教师，农业类硕士、公共管理学科背景，六年授课经验，多年参与一线教学教研、师资培训，学科理论扎实、实战经验丰富，对申论考情、考察要点把握精准，授课严谨细致、注重实用性，善于启发学生思考总结，让学员在轻松愉快的氛围中收获满满。&q;,&q;avatar&q;:&q;17f9ba843689a66.jpg&q;,&q;upperBodyPhoto&q;:null,&q;displayCoursePrefix&q;:&q;gwy&q;,&q;teacherStat&q;:{&q;teacherId&q;:6604,&q;episodeCount&q;:1042,&q;scoreCount&q;:55233,&q;avgScore&q;:9.774844748610395,&q;fiveGradeAvgScore&q;:4.89,&q;updateTime&q;:1773587389812},&q;auditionEpisode&q;:{&q;episodeTitle&q;:&q;个人展示课&q;,&q;episodeVideoUrl&q;:&q;https://vod.fbstatic.cn/22e9ceb2vodbj1251001446/07da7de23560136621445658624/Pbyyc2kWw8EA.mp4?t=f2a4b300&a;us=4070880000&a;sign=8d85f29c293df5b84b6be2af7f562c44&q;},&q;memberOfCPC&q;:false,&q;tags&q;:null},{&q;id&q;:73982,&q;userId&q;:69156915,&q;name&q;:&q;李彬青&q;,&q;brief&q;:&q;粉笔申论优质教师&q;,&q;desc&q;:&q;粉笔申论优质教师，中国人民大学国际关系学院硕士毕业。11年授课经验，毕业后即投身于申论的研究和教学，培训申论老师千余人。长期致力于公务员笔试申论研究，申论授课方法实操性强，注重输出干货；擅长文章写作和教学，注重因材施教；授课重点突出，能够及时总结拓展。深受学员好评。 \n参与组织各类授课研讨会议和教研活动，著有《申论新时代》，参与编辑《公务员考试5100题》等图书。&q;,&q;avatar&q;:&q;19482559245a88c.jpg&q;,&q;upperBodyPhoto&q;:null,&q;displayCoursePrefix&q;:&q;gwy&q;,&q;teacherStat&q;:{&q;teacherId&q;:73982,&q;episodeCount&q;:304,&q;scoreCount&q;:4476,&q;avgScore&q;:9.873100983020556,&q;fiveGradeAvgScore&q;:4.94,&q;updateTime&q;:1773574579658},&q;auditionEpisode&q;:{&q;episodeTitle&q;:&q;个人展示课&q;,&q;episodeVideoUrl&q;:&q;https://vod.fbstatic.cn/22e9ceb2vodbj1251001446/b48a2e453560136621451159967/0lZLLuAXUY4A.mp4?t=f2a4b300&a;us=4070880000&a;sign=fe0f50824a047ae068f32dfd9ff663ef&q;},&q;memberOfCPC&q;:false,&q;tags&q;:null},{&q;id&q;:6058,&q;userId&q;:60103386,&q;name&q;:&q;王周&q;,&q;brief&q;:&q;粉笔申论优质教师&q;,&q;desc&q;:&q;粉笔申论优质教师，9年公考授课经验，累计授课时长超过10000小时，培训师资500余人，培训学员百万余人次，认真负责、严谨细致、侧重实战，注重知识的输入，注重思维的总结，善于举一反三，能“一针见血”点出学员问题，稳步提升学员学习成绩。&q;,&q;avatar&q;:&q;173373124b990f2.jpg&q;,&q;upperBodyPhoto&q;:null,&q;displayCoursePrefix&q;:&q;gwy&q;,&q;teacherStat&q;:{&q;teacherId&q;:6058,&q;episodeCount&q;:1187,&q;scoreCount&q;:120664,&q;avgScore&q;:9.72908241066101,&q;fiveGradeAvgScore&q;:4.86,&q;updateTime&q;:1773581000687},&q;auditionEpisode&q;:{&q;episodeTitle&q;:&q;个人展示课&q;,&q;episodeVideoUrl&q;:&q;https://vod.fbstatic.cn/22e9ceb2vodbj1251001446/a8dd48e73560136621447962890/4U2EPvkpNGgA.mp4?t=f2a4b300&a;us=4070880000&a;sign=e8c4156da4ed995461e1bd74d2fa0a76&q;},&q;memberOfCPC&q;:false,&q;tags&q;:null},{&q;id&q;:4999,&q;userId&q;:42647440,&q;name&q;:&q;高昕&q;,&q;brief&q;:&q;粉笔言语优质教师&q;,&q;desc&q;:&q;粉笔言语优质教师\n8年+公考授课经验，累计授课时长超10000小时，学员总评分高达4.9分。长期致力于言语科目的一线教学工作，熟悉各类公职考试（包括国考、各省省考、事业单位、军队文职等）的言语考情、考点及命题特色，授课涵盖线上线下全阶段班型，包括基础精讲、强化刷题、冲刺点睛等。曾负责并长期参与言语真题解析、模拟题命制、师资培训等教研工作。授课风格亲切自然，讲解深入浅出，课堂气氛活跃，既能帮助学员构建完整知识体系，又能精准传授实用解题技巧，教学耐心细致、认真负责，深受广大学员的信赖与好评。&q;,&q;avatar&q;:&q;1927b035d94fb81.jpg&q;,&q;upperBodyPhoto&q;:null,&q;displayCoursePrefix&q;:&q;gwy&q;,&q;teacherStat&q;:{&q;teacherId&q;:4999,&q;episodeCount&q;:1724,&q;scoreCount&q;:23742,&q;avgScore&q;:9.783590261982967,&q;fiveGradeAvgScore&q;:4.89,&q;updateTime&q;:1773391112153},&q;auditionEpisode&q;:{&q;episodeTitle&q;:&q;个人展示课&q;,&q;episodeVideoUrl&q;:&q;https://vod.fbstatic.cn/22e9ceb2vodbj1251001446/ea6dba5d3560136621455209482/pCS2GxN9vZIA.mp4?t=f2a4b300&a;us=4070880000&a;sign=0869459fe45f924bf87816e749915a30&q;},&q;memberOfCPC&q;:false,&q;tags&q;:null},{&q;id&q;:152,&q;userId&q;:18296629,&q;name&q;:&q;辛然&q;,&q;brief&q;:&q;粉笔言语优质教师&q;,&q;desc&q;:&q;粉笔言语优质教师，硕士学历。 \n15年授课经验，累计授课时长超过20000小时，培训学员300余万人次。对言语理解与表达模块有深入研究，深入了解言语理解与表达模块各种题型的考情，根据各题型特点讲解解题方法，讲课态度认真，细致入微，课堂气氛活跃，深受好评。 \n参与组织各类授课研讨会议和教研活动。&q;,&q;avatar&q;:&q;171abe13498b613.jpg&q;,&q;upperBodyPhoto&q;:null,&q;displayCoursePrefix&q;:&q;gwy&q;,&q;teacherStat&q;:{&q;teacherId&q;:152,&q;episodeCount&q;:1129,&q;scoreCount&q;:163191,&q;avgScore&q;:9.714236691974454,&q;fiveGradeAvgScore&q;:4.86,&q;updateTime&q;:1773559752362},&q;auditionEpisode&q;:{&q;episodeTitle&q;:&q;个人展示课&q;,&q;episodeVideoUrl&q;:&q;https://vod.fbstatic.cn/22e9ceb2vodbj1251001446/52c403db3560136621446591026/FXdla8iGgaoA.mp4?t=f2a4b300&a;us=4070880000&a;sign=61bd19a9db40c5fa6fb8e7cbbb0f861b&q;},&q;memberOfCPC&q;:false,&q;tags&q;:null},{&q;id&q;:5236,&q;userId&q;:53659650,&q;name&q;:&q;聂晨&q;,&q;brief&q;:&q;粉笔申论优质教师&q;,&q;desc&q;:&q;粉笔申论优质教师。\n8年公考培训行业授课经验，累计授课人次超50000人，授课时长超8000小时，学员评分高达4.9分。理论功底扎实，教学态度严谨，授课思路清晰，善于因材施教，既重视学生考试能力的提升也能对考生做好心理辅导。&q;,&q;avatar&q;:&q;192d26d5de2e1e2.jpg&q;,&q;upperBodyPhoto&q;:null,&q;displayCoursePrefix&q;:&q;gwy&q;,&q;teacherStat&q;:{&q;teacherId&q;:5236,&q;episodeCount&q;:916,&q;scoreCount&q;:12030,&q;avgScore&q;:9.808811305070666,&q;fiveGradeAvgScore&q;:4.9,&q;updateTime&q;:1773416123905},&q;auditionEpisode&q;:{&q;episodeTitle&q;:&q;个人展示课&q;,&q;episodeVideoUrl&q;:&q;https://vod.fbstatic.cn/22e9ceb2vodbj1251001446/a9d57d3a1397757891877682042/9tNOkdhXjAAA.mp4?t=f2a4b300&a;us=4070880000&a;sign=e574d63eacd9258128e504815659bf01&q;},&q;memberOfCPC&q;:false,&q;tags&q;:null},{&q;id&q;:18443,&q;userId&q;:49764746,&q;name&q;:&q;朱剑泽&q;,&q;brief&q;:&q;粉笔申论优质教师&q;,&q;desc&q;:&q;粉笔申论优质教师，长期致力于公务员考试研究，对试题有深刻的把握和独到的见解。注重因材施教，教学深入浅出，由表及里。独树一帜的教学风格以及优秀的语言表达能力将枯燥的理论知识潜移默化的传授给学员，让学员在课堂中如沐春风、收获颇多。&q;,&q;avatar&q;:&q;175635f5ba06bcb.jpg&q;,&q;upperBodyPhoto&q;:null,&q;displayCoursePrefix&q;:&q;gwy&q;,&q;teacherStat&q;:{&q;teacherId&q;:18443,&q;episodeCount&q;:616,&q;scoreCount&q;:10747,&q;avgScore&q;:9.81204056946125,&q;fiveGradeAvgScore&q;:4.91,&q;updateTime&q;:1773238551421},&q;auditionEpisode&q;:{&q;episodeTitle&q;:&q;个人展示课&q;,&q;episodeVideoUrl&q;:&q;https://vod.fbstatic.cn/22e9ceb2vodbj1251001446/fe29c0353560136621445205740/WKJeJG0BFfAA.mp4?t=f2a4b300&a;us=4070880000&a;sign=d972c91dc1e0ac1dc9ea5e9d6db08efa&q;},&q;memberOfCPC&q;:false,&q;tags&q;:null},{&q;id&q;:2228,&q;userId&q;:23006969,&q;name&q;:&q;柴鑫&q;,&q;brief&q;:&q;粉笔申论优质教师&q;,&q;desc&q;:&q;粉笔申论优质教师。\n13年公考培训经验，211高校政治学硕士。公考笔试实战多次取得优质成绩。累计授课人次超80000人，授课时长超10000小时，学员评分高达4.9分，学员申论取得85分的好成绩；主要授课全国各个省份国省考精讲、强化、刷题、冲刺、专项等课程，理论功底扎实，深入研究国省考、事业单位等各类笔试考情及命题特色；(熟悉各类考试的出题类型，有过辽宁、黑龙江、吉林、内蒙古、江苏、陕西等多省精讲、冲刺等课程的授课经验)。课堂上，以考生为中心，以提升学员能力导向，立足考试实际，扎实推动思维训练和做题训练，让学员有收获，帮助学员在考场脱颖而出。&q;,&q;avatar&q;:&q;1927ab7a76c2808.jpg&q;,&q;upperBodyPhoto&q;:null,&q;displayCoursePrefix&q;:&q;gwy&q;,&q;teacherStat&q;:{&q;teacherId&q;:2228,&q;episodeCount&q;:1847,&q;scoreCount&q;:17251,&q;avgScore&q;:9.774969566981635,&q;fiveGradeAvgScore&q;:4.89,&q;updateTime&q;:1773488838761},&q;auditionEpisode&q;:{&q;episodeTitle&q;:&q;个人展示课&q;,&q;episodeVideoUrl&q;:&q;https://vod.fbstatic.cn/22e9ceb2vodbj1251001446/3a2674403560136621456363708/h3kmtfU6YwYA.mp4?t=f2a4b300&a;us=4070880000&a;sign=96ea1c4002a57a928656415e682e68ff&q;},&q;memberOfCPC&q;:false,&q;tags&q;:null},{&q;id&q;:16734,&q;userId&q;:65372272,&q;name&q;:&q;周浩飞&q;,&q;brief&q;:&q;粉笔面试优质讲师&q;,&q;desc&q;:&q;粉笔面试优质讲师\n6年公考一线教学经验，专业水平扎实，有丰富的实战经历和机关工作经历。多次参与全国各省份公务员、事业单位面试真题教研工作，熟练掌握各种面试作答技巧。授课累计时长6000+，多次承担线下长线班型授课，授课期间多次助力学员逆袭上岸。综合面试通过率72%。授课思路清晰，严谨，善于引导学员、开发学员面试思维，增强学员自主性；课堂氛围活跃，学员互动性强；注重理论与实际相结合，因材施教，有针对性的提升学员能力，深受学员喜爱。&q;,&q;avatar&q;:&q;1945f4a402b3e77.jpg&q;,&q;upperBodyPhoto&q;:null,&q;displayCoursePrefix&q;:&q;gwy&q;,&q;teacherStat&q;:{&q;teacherId&q;:16734,&q;episodeCount&q;:978,&q;scoreCount&q;:31170,&q;avgScore&q;:9.748989412897016,&q;fiveGradeAvgScore&q;:4.87,&q;updateTime&q;:1773575875032},&q;auditionEpisode&q;:{&q;episodeTitle&q;:&q;个人展示课&q;,&q;episodeVideoUrl&q;:&q;https://vod.fbstatic.cn/22e9ceb2vodbj1251001446/e1ada1595145403709542416512/7GtFiqAxArcA.mp4?t=f2a4b300&a;us=4070880000&a;sign=8b3c690173802629092e12b11a5a0ae6&q;},&q;memberOfCPC&q;:false,&q;tags&q;:null},{&q;id&q;:65409,&q;userId&q;:141835629,&q;name&q;:&q;沐杨&q;,&q;brief&q;:&q;粉笔言语优质教师&q;,&q;desc&q;:&q;粉笔言语优质教师，12年公考授课经验，始终以生动有趣、激发学生思维为教学宗旨。“作为一名教师，只要我站在讲台上，就必须把生命中最美好的东西呈现在学生面前，使学生感受到精神上的美。”是他的职业追求。将繁琐的知识点串联成思维框架、将枯燥的语言文字变得生动活泼是他将会给你呈现的方式。&q;,&q;avatar&q;:&q;190dde75143477a.jpg&q;,&q;upperBodyPhoto&q;:null,&q;displayCoursePrefix&q;:&q;gwy&q;,&q;teacherStat&q;:{&q;teacherId&q;:65409,&q;episodeCount&q;:170,&q;scoreCount&q;:11041,&q;avgScore&q;:9.622497962141152,&q;fiveGradeAvgScore&q;:4.81,&q;updateTime&q;:1773495689158},&q;auditionEpisode&q;:{&q;episodeTitle&q;:&q;个人展示课&q;,&q;episodeVideoUrl&q;:&q;https://vod.fbstatic.cn/22e9ceb2vodbj1251001446/255ce6741397757892492058531/DM2ZCzPVvG0A.mp4?t=f2a4b300&a;us=4070880000&a;sign=92bc17de4aaa1524e2e3d34ea7439d42&q;},&q;memberOfCPC&q;:false,&q;tags&q;:null}],&q;lectureStat&q;:{&q;lectureId&q;:710082,&q;playStatus&q;:2,&q;freeAddedStudentCount&q;:0,&q;classMinutes&q;:34835,&q;classStartTime&q;:1742727600000,&q;classStopTime&q;:1773064800000,&q;playProgress&q;:1,&q;updateTime&q;:1773253906942},&q;catIds&q;:[],&q;teachChannel&q;:1,&q;examType&q;:0,&q;typeFlags&q;:{&q;systemLecture&q;:false,&q;interviewLecture&q;:false,&q;writtenLecture&q;:false,&q;writtenSmallClassLecture&q;:false,&q;writtenOfflineLecture&q;:false,&q;smallClassLecture&q;:false},&q;examSeason&q;:null,&q;needAgreement&q;:false,&q;bestDiscount&q;:null,&q;discounts&q;:[],&q;buyLimit&q;:null,&q;grouponRule&q;:null,&q;apeCourseId&q;:1,&q;tradeUnit&q;:0,&q;distributionId&q;:-1,&q;dealPlanI