授课严谨细致又不失幽默，注重与学生的互动，擅长解决学员个性化问题，让学员可以在轻松愉快的氛围中得到个性化提升。希望在公考的道路上可以助您一臂之力。&q;,&q;avatar&q;:&q;1926fe0983d8fe5.jpg&q;,&q;upperBodyPhoto&q;:null,&q;displayCoursePrefix&q;:&q;gwy&q;,&q;teacherStat&q;:{&q;teacherId&q;:4985,&q;episodeCount&q;:1047,&q;scoreCount&q;:168734,&q;avgScore&q;:9.822015717045764,&q;fiveGradeAvgScore&q;:4.91,&q;updateTime&q;:1773617111112},&q;auditionEpisode&q;:{&q;episodeTitle&q;:&q;个人展示课&q;,&q;episodeVideoUrl&q;:&q;https://vod.fbstatic.cn/22e9ceb2vodbj1251001446/4fcec99d3560136621446406348/s1YvcVvNImkA.mp4?t=f2a4b300&a;us=4070880000&a;sign=d2e4f33d8224f412afae2f9043b0e59e&q;},&q;memberOfCPC&q;:false,&q;tags&q;:null},&q;teachChannel&q;:1,&q;offline&q;:null,&q;duration&q;:11818,&q;hasAudition&q;:false,&q;bizType&q;:0,&q;bizId&q;:&q;710082&q;,&q;supportReplay&q;:true,&q;extraInfo&q;:null,&q;liveConfig&q;:{&q;episodeId&q;:10492344,&q;supportMultiGroup&q;:false,&q;exerciseBizType&q;:0,&q;videoDisplayType&q;:0,&q;avForwardType&q;:0,&q;useIntelligentRoom&q;:false,&q;hasStrokeKeynote&q;:true,&q;verticalModeType&q;:0,&q;originEpisodeId&q;:0,&q;supportRtmp&q;:false,&q;supportPk&q;:false,&q;supportLuckyBag&q;:false,&q;supportUserNoteStroke&q;:false,&q;communicateType&q;:0,&q;one2One&q;:false,&q;fakeLive&q;:false},&q;validStatus&q;:1,&q;supportLive&q;:true,&q;supportAiCatalog&q;:true,&q;hasIntelligentPen&q;:false,&q;useLocalRecording&q;:false,&q;useIntelligentRoom&q;:false,&q;hasSalePosition&q;:false,&q;hasEpisodeCards&q;:false,&q;lockedForShouna&q;:false,&q;needSignIn&q;:false,&q;needTeacherSignIn&q;:false,&q;enablePadPencil&q;:false,&q;displayExercise&q;:false,&q;supportLuckyBag&q;:false,&q;supportLivePk&q;:false},{&q;id&q;:10492346,&q;kePrefix&q;:&q;gwy&q;,&q;courseId&q;:1,&q;status&q;:3,&q;playStatus&q;:3,&q;type&q;:1,&q;recordingType&q;:0,&q;mediaType&q;:0,&q;title&q;:&q;数资-【2026国考第12季&a;2025下半年省考第4季】行测模考大赛&q;,&q;innerTitle&q;:&q;&q;,&q;startTime&q;:1744542000000,&q;endTime&q;:1744552800000,&q;teacher&q;:{&q;id&q;:5656,&q;userId&q;:56447654,&q;name&q;:&q;周末&q;,&q;brief&q;:&q;粉笔数资优质教师&q;,&q;desc&q;:&q;粉笔数资优质教师，11年公考培训经验，累计授课时长超过15000小时，培训学员200余万人次。长期致力于公务员考试研究，理论知识扎实，授课风格深入浅出，条理清楚，认真负责，耐心细致，深受学员好评，学员评分4.9分。参与各类授课研讨会议和教研活动，授课内容注重总结实用解题技巧等干货，陪你在“数学的海洋”里成长与收获。&q;,&q;avatar&q;:&q;1811d19c58cc59d.jpg&q;,&q;upperBodyPhoto&q;:null,&q;displayCoursePrefix&q;:&q;gwy&q;,&q;teacherStat&q;:{&q;teacherId&q;:5656,&q;episodeCount&q;:1134,&q;scoreCount&q;:147683,&q;avgScore&q;:9.8125715214344,&q;fiveGradeAvgScore&q;:4.91,&q;updateTime&q;:1773579551677},&q;auditionEpisode&q;:{&q;episodeTitle&q;:&q;个人展示课&q;,&q;episodeVideoUrl&q;:&q;https://vod.fbstatic.cn/22e9ceb2vodbj1251001446/2de943ee3560136621449079896/rmEM5K8RU3UA.mp4?t=f2a4b300&a;us=4070880000&a;sign=934d95150ec82e6e28a12a4798664a8f&q;},&q;memberOfCPC&q;:false,&q;tags&q;:null},&q;teachChannel&q;:1,&q;offline&q;:null,&q;duration&q;:12163,&q;hasAudition&q;:false,&q;bizType&q;:0,&q;bizId&q;:&q;710082&q;,&q;supportReplay&q;:true,&q;extraInfo&q;:null,&q;liveConfig&q;:{&q;episodeId&q;:10492346,&q;supportMultiGroup&q;:false,&q;exerciseBizType&q;:0,&q;videoDisplayType&q;:0,&q;avForwardType&q;:0,&q;useIntelligentRoom&q;:false,&q;hasStrokeKeynote&q;:true,&q;verticalModeType&q;:0,&q;originEpisodeId&q;:0,&q;supportRtmp&q;:false,&q;supportPk&q;:false,&q;supportLuckyBag&q;:false,&q;supportUserNoteStroke&q;:false,&q;communicateType&q;:0,&q;one2One&q;:false,&q;fakeLive&q;:false},&q;validStatus&q;:1,&q;supportLive&q;:true,&q;supportAiCatalog&q;:true,&q;hasIntelligentPen&q;:false,&q;useLocalRecording&q;:false,&q;useIntelligentRoom&q;:false,&q;hasSalePosition&q;:false,&q;hasEpisodeCards&q;:false,&q;lockedForShouna&q;:false,&q;needSignIn&q;:false,&q;needTeacherSignIn&q;:false,&q;enablePadPencil&q;:false,&q;displayExercise&q;:false,&q;supportLuckyBag&q;:false,&q;supportLivePk&q;:false},{&q;id&q;:10492365,&q;kePrefix&q;:&q;gwy&q;,&q;courseId&q;:1,&q;status&q;:3,&q;playStatus&q;:3,&q;type&q;:1,&q;recordingType&q;:0,&q;mediaType&q;:0,&q;title&q;:&q;言语-【2026国考第13季&a;2025下半年省考第5季】行测模考大赛&q;,&q;innerTitle