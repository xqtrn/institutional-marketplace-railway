se,&q;hasStrokeKeynote&q;:true,&q;verticalModeType&q;:0,&q;originEpisodeId&q;:0,&q;supportRtmp&q;:false,&q;supportPk&q;:true,&q;supportLuckyBag&q;:true,&q;supportUserNoteStroke&q;:false,&q;communicateType&q;:0,&q;one2One&q;:false,&q;fakeLive&q;:false},&q;validStatus&q;:1,&q;supportLive&q;:true,&q;supportAiCatalog&q;:false,&q;hasIntelligentPen&q;:false,&q;useLocalRecording&q;:false,&q;useIntelligentRoom&q;:false,&q;hasSalePosition&q;:false,&q;hasEpisodeCards&q;:true,&q;lockedForShouna&q;:false,&q;needSignIn&q;:false,&q;needTeacherSignIn&q;:false,&q;enablePadPencil&q;:true,&q;displayExercise&q;:false,&q;supportLuckyBag&q;:true,&q;supportLivePk&q;:true},{&q;id&q;:10849851,&q;kePrefix&q;:&q;sydw&q;,&q;courseId&q;:6,&q;status&q;:3,&q;playStatus&q;:3,&q;type&q;:33,&q;recordingType&q;:0,&q;mediaType&q;:0,&q;title&q;:&q;【综应】精选好题 沉浸刷题&q;,&q;innerTitle&q;:&q;&q;,&q;startTime&q;:1752890400000,&q;endTime&q;:1752897600000,&q;teacher&q;:{&q;id&q;:35003,&q;userId&q;:83142599,&q;name&q;:&q;史芯蕊&q;,&q;brief&q;:&q;粉笔优质讲师&q;,&q;desc&q;:&q;粉笔优质讲师\n6年一线教学经验，承担过线上线下多种课程，包含安徽、武汉地区联考A，联考C，以及江苏等线下课程。线上部分以精品系统班，刷题班，线下考前冲刺班为主，授课经验丰富，深受学员喜爱，服务学员上千人，累计授课时长超千小时，授课评分4.9分。\n授课思路清晰，逻辑较强，善于从学员的角度切入，用更轻松的方式灵活运用答题技巧，同时给出学员针对性又个性化的指导方案。\n定期参加粉笔教研，多次参与真题解析以及真题解析视频录制，对理论体系有深入的研究，了解最新命题趋势方向。&q;,&q;avatar&q;:&q;18f656de50744c0.jpg&q;,&q;upperBodyPhoto&q;:null,&q;displayCoursePrefix&q;:&q;sydw&q;,&q;teacherStat&q;:{&q;teacherId&q;:35003,&q;episodeCount&q;:281,&q;scoreCount&q;:638,&q;avgScore&q;:9.877742946708466,&q;fiveGradeAvgScore&q;:4.94,&q;updateTime&q;:1773590037796},&q;auditionEpisode&q;:{&q;episodeTitle&q;:&q;个人展示课&q;,&q;episodeVideoUrl&q;:&q;https://vod.fbstatic.cn/22e9ceb2vodbj1251001446/fb1642195145403708057024670/r8VrOUODYOYA.mp4?t=f2a4b300&a;us=4070880000&a;sign=66f06661bf427c9cc98ffaf63d1aef4e&q;},&q;memberOfCPC&q;:false,&q;tags&q;:null},&q;teachChannel&q;:1,&q;offline&q;:null,&q;duration&q;:7690,&q;hasAudition&q;:false,&q;bizType&q;:0,&q;bizId&q;:&q;726825&q;,&q;supportReplay&q;:true,&q;extraInfo&q;:null,&q;liveConfig&q;:{&q;episodeId&q;:10849851,&q;supportMultiGroup&q;:false,&q;exerciseBizType&q;:0,&q;videoDisplayType&q;:0,&q;avForwardType&q;:0,&q;useIntelligentRoom&q;:false,&q;hasStrokeKeynote&q;:true,&q;verticalModeType&q;:0,&q;originEpisodeId&q;:0,&q;supportRtmp&q;:false,&q;supportPk&q;:true,&q;supportLuckyBag&q;:true,&q;supportUserNoteStroke&q;:false,&q;communicateType&q;:0,&q;one2One&q;:false,&q;fakeLive&q;:false},&q;validStatus&q;:1,&q;supportLive&q;:true,&q;supportAiCatalog&q;:false,&q;hasIntelligentPen&q;:false,&q;useLocalRecording&q;:false,&q;useIntelligentRoom&q;:false,&q;hasSalePosition&q;:false,&q;hasEpisodeCards&q;:true,&q;lockedForShouna&q;:false,&q;needSignIn&q;:false,&q;needTeacherSignIn&q;:false,&q;enablePadPencil&q;:true,&q;displayExercise&q;:false,&q;supportLuckyBag&q;:true,&q;supportLivePk&q;:true},{&q;id&q;:10849854,&q;kePrefix&q;:&q;sydw&q;,&q;courseId&q;:6,&q;status&q;:3,&q;playStatus&q;:3,&q;type&q;:33,&q;recordingType&q;:0,&q;mediaType&q;:0,&q;title&q;:&q;【言语】精选好题 沉浸刷题&q;,&q;innerTitle&q;:&q;&q;,&q;startTime&q;:1752897600000,&q;endTime&q;:1752904800000,&q;teacher&q;:{&q;id&q;:32974,&q;userId&q;:83441510,&q;name&q;:&q;何铖&q;,&q;brief&q;:&q;粉笔优质讲师&q;,&q;desc&q;:&q;粉笔优质讲师\n6年一线教学经验，承担过线上、线下笔试多种班型课程，累计授课超3100小时，授课经验丰富。\n承担言语科目授课、教研与培训工作，上课亲和生动，互动性强，擅长理论与实际相结合，授课逻辑性强，善于发现学员解题症结并总结答题技巧，积极引导并激发学员学习热情和自主意识。\n课程累计评分4.97，在学员中具有良好口碑，是值得信赖的好导师。&q;,&q;avatar&q;:&q;1984f2383973c17.jpg&q;,&q;upperBodyPhoto&q;:null,&q;displayCoursePrefix&q;:&q;sydw&q;,&q;teacherStat&q;:{&q;teacherId&q;:32974,&q;episodeCount&q;:741,&q;scoreCount&q;:1778,&q;avgScore&q;:9.923509561304837,&q;fiveGradeAvgScore&q;:4.96,&q;updateTime&q;:1773235895215},&q;auditionEpisode&q;:{&q;episodeTitle&q;:&q;个人展示课&q;,&q;episodeVideoUrl&q;:&q;https://vod.fbstatic.cn/22e9ceb2vodbj1251001446/4349be535145403710131933552/nPy2nunV3pAA.mp4?t=f2a4b300&a;us=4070880000&a;sign=864a8580f53c566b64ff5ba2e13209fc&q;},&q;memberOfCPC&q;:false,&q;tags&q;:null},&q;teachChannel&q;:1,&q;offline&q;:null,