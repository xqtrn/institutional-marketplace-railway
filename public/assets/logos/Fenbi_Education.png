up&q;:false,&q;exerciseBizType&q;:0,&q;videoDisplayType&q;:0,&q;avForwardType&q;:0,&q;useIntelligentRoom&q;:false,&q;hasStrokeKeynote&q;:true,&q;verticalModeType&q;:0,&q;originEpisodeId&q;:0,&q;supportRtmp&q;:false,&q;supportPk&q;:true,&q;supportLuckyBag&q;:true,&q;supportUserNoteStroke&q;:false,&q;communicateType&q;:0,&q;one2One&q;:false,&q;fakeLive&q;:false},&q;validStatus&q;:1,&q;supportLive&q;:true,&q;supportAiCatalog&q;:false,&q;hasIntelligentPen&q;:false,&q;useLocalRecording&q;:false,&q;useIntelligentRoom&q;:false,&q;hasSalePosition&q;:false,&q;hasEpisodeCards&q;:true,&q;lockedForShouna&q;:false,&q;needSignIn&q;:false,&q;needTeacherSignIn&q;:false,&q;enablePadPencil&q;:true,&q;displayExercise&q;:false,&q;supportLuckyBag&q;:true,&q;supportLivePk&q;:true},{&q;id&q;:10795402,&q;kePrefix&q;:&q;sydw&q;,&q;courseId&q;:6,&q;status&q;:3,&q;playStatus&q;:3,&q;type&q;:33,&q;recordingType&q;:0,&q;mediaType&q;:0,&q;title&q;:&q;【公基法律】精选好题 沉浸刷题&q;,&q;innerTitle&q;:&q;&q;,&q;startTime&q;:1750903200000,&q;endTime&q;:1750910400000,&q;teacher&q;:{&q;id&q;:34187,&q;userId&q;:72708960,&q;name&q;:&q;杨建英&q;,&q;brief&q;:&q;粉笔优质讲师&q;,&q;desc&q;:&q;粉笔常识公基优质教师\n六年以上一线教学授课经验，具有公基科目丰富的实践经验及系统扎实的专业理论知识。累计授课课时900+，获得近1300学员好评。曾多次参与命制笔试教研，对民法、刑法考情有着深入研究，出过近600道优质模拟题，在常识公基教研方面取得不小成果。所授课的班级中，学员成绩均有明显提升，在考试当中取得了80+的好成绩。授课形象生动，条理清晰，考法考点突出，能够激发学员的学习热情，深受广大学员的认可和好评。&q;,&q;avatar&q;:&q;178a63030088c51.jpg&q;,&q;upperBodyPhoto&q;:null,&q;displayCoursePrefix&q;:&q;sydw&q;,&q;teacherStat&q;:{&q;teacherId&q;:34187,&q;episodeCount&q;:609,&q;scoreCount&q;:846,&q;avgScore&q;:9.640661938534272,&q;fiveGradeAvgScore&q;:4.82,&q;updateTime&q;:1773583685166},&q;auditionEpisode&q;:{&q;episodeTitle&q;:&q;个人展示课&q;,&q;episodeVideoUrl&q;:&q;https://vod.fbstatic.cn/22e9ceb2vodbj1251001446/b4a41c1f5145403715604466391/YJ5X0UoLJuwA.mp4?t=f2a4b300&a;us=4070880000&a;sign=8b8cab822f930f5bac858256d9951d14&q;},&q;memberOfCPC&q;:false,&q;tags&q;:null},&q;teachChannel&q;:1,&q;offline&q;:null,&q;duration&q;:8751,&q;hasAudition&q;:false,&q;bizType&q;:0,&q;bizId&q;:&q;726825&q;,&q;supportReplay&q;:true,&q;extraInfo&q;:null,&q;liveConfig&q;:{&q;episodeId&q;:10795402,&q;supportMultiGroup&q;:false,&q;exerciseBizType&q;:0,&q;videoDisplayType&q;:0,&q;avForwardType&q;:0,&q;useIntelligentRoom&q;:false,&q;hasStrokeKeynote&q;:true,&q;verticalModeType&q;:0,&q;originEpisodeId&q;:0,&q;supportRtmp&q;:false,&q;supportPk&q;:true,&q;supportLuckyBag&q;:true,&q;supportUserNoteStroke&q;:false,&q;communicateType&q;:0,&q;one2One&q;:false,&q;fakeLive&q;:false},&q;validStatus&q;:1,&q;supportLive&q;:true,&q;supportAiCatalog&q;:false,&q;hasIntelligentPen&q;:false,&q;useLocalRecording&q;:false,&q;useIntelligentRoom&q;:false,&q;hasSalePosition&q;:false,&q;hasEpisodeCards&q;:true,&q;lockedForShouna&q;:false,&q;needSignIn&q;:false,&q;needTeacherSignIn&q;:false,&q;enablePadPencil&q;:true,&q;displayExercise&q;:false,&q;supportLuckyBag&q;:true,&q;supportLivePk&q;:true},{&q;id&q;:10795404,&q;kePrefix&q;:&q;sydw&q;,&q;courseId&q;:6,&q;status&q;:3,&q;playStatus&q;:3,&q;type&q;:33,&q;recordingType&q;:0,&q;mediaType&q;:0,&q;title&q;:&q;【言语】精选好题 沉浸刷题&q;,&q;innerTitle&q;:&q;&q;,&q;startTime&q;:1750910400000,&q;endTime&q;:1750917600000,&q;teacher&q;:{&q;id&q;:32974,&q;userId&q;:83441510,&q;name&q;:&q;何铖&q;,&q;brief&q;:&q;粉笔优质讲师&q;,&q;desc&q;:&q;粉笔优质讲师\n6年一线教学经验，承担过线上、线下笔试多种班型课程，累计授课超3100小时，授课经验丰富。\n承担言语科目授课、教研与培训工作，上课亲和生动，互动性强，擅长理论与实际相结合，授课逻辑性强，善于发现学员解题症结并总结答题技巧，积极引导并激发学员学习热情和自主意识。\n课程累计评分4.97，在学员中具有良好口碑，是值得信赖的好导师。&q;,&q;avatar&q;:&q;1984f2383973c17.jpg&q;,&q;upperBodyPhoto&q;:null,&q;displayCoursePrefix&q;:&q;sydw&q;,&q;teacherStat&q;:{&q;teacherId&q;:32974,&q;episodeCount&q;:741,&q;scoreCount&q;:1778,&q;avgScore&q;:9.923509561304837,&q;fiveGradeAvgScore&q;:4.96,&q;updateTime&q;:1773235895215},&q;auditionEpisode&q;:{&q;episodeTitle&q;:&q;个人展示课&q;,&q;episodeVideoUrl&q;:&q;https://vod.fbstatic.cn/22e9ceb2vodbj1251001446/4349be535145403710131933552/nPy2nunV3pAA.mp4?t=f2a4b300&a;us=4070880000&a;sign=864a8580f53c566b64ff5ba2e13209fc