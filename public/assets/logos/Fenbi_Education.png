a;us=4070880000&a;sign=274982009db9fe68de2a8918ec41a92e&q;},&q;memberOfCPC&q;:false,&q;tags&q;:null},&q;teachChannel&q;:1,&q;offline&q;:null,&q;duration&q;:5164,&q;hasAudition&q;:false,&q;bizType&q;:0,&q;bizId&q;:&q;726825&q;,&q;supportReplay&q;:true,&q;extraInfo&q;:null,&q;liveConfig&q;:{&q;episodeId&q;:11235266,&q;supportMultiGroup&q;:false,&q;exerciseBizType&q;:0,&q;videoDisplayType&q;:0,&q;avForwardType&q;:0,&q;useIntelligentRoom&q;:false,&q;hasStrokeKeynote&q;:true,&q;verticalModeType&q;:0,&q;originEpisodeId&q;:0,&q;supportRtmp&q;:false,&q;supportPk&q;:true,&q;supportLuckyBag&q;:true,&q;supportUserNoteStroke&q;:false,&q;communicateType&q;:0,&q;one2One&q;:false,&q;fakeLive&q;:false},&q;validStatus&q;:1,&q;supportLive&q;:true,&q;supportAiCatalog&q;:false,&q;hasIntelligentPen&q;:false,&q;useLocalRecording&q;:false,&q;useIntelligentRoom&q;:false,&q;hasSalePosition&q;:false,&q;hasEpisodeCards&q;:true,&q;lockedForShouna&q;:false,&q;needSignIn&q;:false,&q;needTeacherSignIn&q;:false,&q;enablePadPencil&q;:true,&q;displayExercise&q;:false,&q;supportLuckyBag&q;:true,&q;supportLivePk&q;:true},{&q;id&q;:11235267,&q;kePrefix&q;:&q;sydw&q;,&q;courseId&q;:6,&q;status&q;:3,&q;playStatus&q;:3,&q;type&q;:33,&q;recordingType&q;:0,&q;mediaType&q;:0,&q;title&q;:&q; 【言语】精选好题 沉浸刷题    &q;,&q;innerTitle&q;:&q;&q;,&q;startTime&q;:1764388800000,&q;endTime&q;:1764396000000,&q;teacher&q;:{&q;id&q;:16735,&q;userId&q;:46275516,&q;name&q;:&q;郭孟楠&q;,&q;brief&q;:&q;粉笔优质讲师&q;,&q;desc&q;:&q;粉笔优质讲师\n5年一线教学经验，对言语理解与表达的命题趋势和解题技巧有着精准的把握。在教学过程中，注重培养学生的语言敏感度和逻辑思维能力，通过系统的知识讲解和大量的真题演练，帮助学生快速掌握解题技巧，提高答题速度和准确率。注重启发式教学，能够及时发现并解决学生在学习过程中遇到的问题，适合各个阶段的学习并深受学员喜爱。&q;,&q;avatar&q;:&q;1746be4c31acce6.jpg&q;,&q;upperBodyPhoto&q;:null,&q;displayCoursePrefix&q;:&q;sydw&q;,&q;teacherStat&q;:{&q;teacherId&q;:16735,&q;episodeCount&q;:386,&q;scoreCount&q;:5679,&q;avgScore&q;:9.730938545518592,&q;fiveGradeAvgScore&q;:4.87,&q;updateTime&q;:1773371290044},&q;auditionEpisode&q;:{&q;episodeTitle&q;:&q;个人展示课&q;,&q;episodeVideoUrl&q;:&q;https://vod.fbstatic.cn/22e9ceb2vodbj1251001446/cf4aa7181397757903434929665/eDPwMVOaVQcA.mp4?t=f2a4b300&a;us=4070880000&a;sign=32ab41a3d56b67eb4d07d67b2bdb9cc6&q;},&q;memberOfCPC&q;:false,&q;tags&q;:null},&q;teachChannel&q;:1,&q;offline&q;:null,&q;duration&q;:7392,&q;hasAudition&q;:false,&q;bizType&q;:0,&q;bizId&q;:&q;726825&q;,&q;supportReplay&q;:true,&q;extraInfo&q;:null,&q;liveConfig&q;:{&q;episodeId&q;:11235267,&q;supportMultiGroup&q;:false,&q;exerciseBizType&q;:0,&q;videoDisplayType&q;:0,&q;avForwardType&q;:0,&q;useIntelligentRoom&q;:false,&q;hasStrokeKeynote&q;:true,&q;verticalModeType&q;:0,&q;originEpisodeId&q;:0,&q;supportRtmp&q;:false,&q;supportPk&q;:true,&q;supportLuckyBag&q;:true,&q;supportUserNoteStroke&q;:false,&q;communicateType&q;:0,&q;one2One&q;:false,&q;fakeLive&q;:false},&q;validStatus&q;:1,&q;supportLive&q;:true,&q;supportAiCatalog&q;:false,&q;hasIntelligentPen&q;:false,&q;useLocalRecording&q;:false,&q;useIntelligentRoom&q;:false,&q;hasSalePosition&q;:false,&q;hasEpisodeCards&q;:true,&q;lockedForShouna&q;:false,&q;needSignIn&q;:false,&q;needTeacherSignIn&q;:false,&q;enablePadPencil&q;:true,&q;displayExercise&q;:false,&q;supportLuckyBag&q;:true,&q;supportLivePk&q;:true},{&q;id&q;:11235232,&q;kePrefix&q;:&q;sydw&q;,&q;courseId&q;:6,&q;status&q;:3,&q;playStatus&q;:3,&q;type&q;:33,&q;recordingType&q;:0,&q;mediaType&q;:0,&q;title&q;:&q;【综应】精选好题 沉浸刷题 &q;,&q;innerTitle&q;:&q;&q;,&q;startTime&q;:1764396000000,&q;endTime&q;:1764403200000,&q;teacher&q;:{&q;id&q;:33464,&q;userId&q;:79618484,&q;name&q;:&q;钟页心&q;,&q;brief&q;:&q;粉笔优质讲师&q;,&q;desc&q;:&q;粉笔优质教师\n多次参加粉笔教研会议，全面把握各地区最新考情，积累丰富知识。\n五年一线教学经验，承担线上和线下精品班、系统班多种班型授课。课堂互动性佳，授课内容深入浅出，引导性强，激发学员学习热情，通过大量真实案例和实战演练让学生在练习中掌握答题技巧，灵活应对各类题目。\n累计线上授课超900小时，积累评分4.9分以上。针对性指导，发掘个人优势，帮助学员树立信心，答出自己真实的思考，突破自我，提高答题逻辑性和准确性，深受学生信赖。&q;,&q;avatar&q;:&q;17880f97c0ca868.jpg&q;,&q;upperBodyPhoto&q;:null,&q;displayCoursePrefix&q;:&q;sydw&q;,&q;teacherStat&q;:{&q;teacherId&q;:33464,&q;episodeCount&q;:462,&q;scoreCount&q;:280,&q;avgScore&q;:9.757142857142858,&q;fiveGradeAvgScore&q;:4.88,&q;updateTime&q;:1773388977630},&q;auditionEpisode&q;:{&q;episodeTitle&q;:&q;个人展示课&q;,&q;episodeVideoUrl&q;:&q;https://vod.fbstatic.cn/22e9ceb2vodbj1251001446/b4d00d621253642695657120814/yj7Ea7PjTXcA.mp4?t=f2a4b300&a;us=4070880000&a;sign=385e5bb2e5dde920bf1d27a23669c23f&q;},&q;memberOfCPC&q;:false,&q;tags&q;:null},&q;teachChannel&q;:1,&q;offline&q;:null,&q;duration&q;:6986,&q;hasAudition&q;:false,&q;bizType&q;:0,&q;bizId&q;:&q;726825&q;,&q;supportReplay&q;:true,&q;extraInfo&q;:null,&q;liveConfig&q;:{&q;episodeId&q;:11235232,&q;supportMultiGroup&q;:false,&q;exerciseBizType&q;:0,&q;videoDisplayType&q;:0,&q;avForwardType&q;:0,&q;useIntelligentRoom&q;:false,&q;hasStrokeKeynote&q;:true,&q;verticalModeType&q;:0,&q;originEpisodeId&q;:0,&q;supportRtmp&q;:false,&q;supportPk&q;:true,&q;supportLuckyBag&q;:true,&q;supportUserNoteStroke&q;:false,&q;communicateType&q;:0,&q;one2One&q;:false,&q;fakeLive&q;:false},&q;validStatus&q;:1,&q;supportLive&q;:true,&q;supportAiCatalog&q;:false,&q;hasIntelligentPen&q;:false,&q;useLocalRecording&q;:false,&q;useIntelligentRoom&q;:false,&q;hasSalePosition&q;:false,&q;hasEpisodeCards&q;:true,&q;lockedForShouna&q;:false,&q;needSignIn&q;:false,&q;needTeacherSignIn&q;:false,&q;enablePadPencil&q;:true,&q;displayExercise&q;:false,&q;supportLuckyBag&q;:true,&q;supportLivePk&q;:true},{&q;id&q;:11235269,&q;kePrefix&q;:&q;sydw&q;,&q;courseId&q;:6,&q;status&q;:3,&q;playStatus&q;:3,&q;type&q;:33,&q;recordingType&q;:0,&q;mediaType&q;:0,&q;title&q;:&q;【数资】精选好题 沉浸刷题       &q;,&q;innerTitle&q;:&q;&q;,&q;startTime&q;:1764468000000,&q;endTime&q;:1764475200000,&q;teacher&q;:{&q;id&q;:16648,&q;userId&q;:74152754,&q;name&q;:&q;陈洋&q;,&q;brief&q;:&q;粉笔优质讲师&q;,&q;desc&q;:&q;粉笔优质教师\n6年一线教学授课经验，具有数资科目丰富的实践经验及系统扎实的专业理论知识，多次参加粉笔教研活动，分享授课经验心得，助力粉笔理论研发升级；\n授课逻辑清晰、重难点突出，课堂学习氛围轻松，让学员用更简单的方法，找到更快捷的解题之道，深受广大学员的认可和好评；在学员中具有非常好的口碑，是值得信赖的好导师。&q;,&q;avatar&q;:&q;1945f259dd30831.jpg&q;,&q;upperBodyPhoto&q;:null,&q;displayCoursePrefix&q;:&q;sydw&q;,&q;teacherStat&q;:{&q;teacherId&q;:16648,&q;episodeCount&q;:782,&q;scoreCount&q;:1917,&q;avgScore&q;:9.812206572769968,&q;fiveGradeAvgScore&q;:4.91,&q;updateTime&q;:1773573616029},&q;auditionEpisode&q;:{&q;episodeTitle&q;:&q;个人展示课&q;,&q;episodeVideoUrl&q;:&q;https://vod.fbstatic.cn/22e9ceb2vodbj1251001446/571009c11397757903436191001/71GyWjiNw7MA.mp4?t=f2a4b300&a;us=4070880000&a;sign=b59a7b96a095f92f99b475fb3660977b&q;},&q;memberOfCPC&q;:false,&q;tags&q;:null},&q;teachChannel&q;:1,&q;offline&q;:null,&q;duration&q;:8886,&q;hasAudition&q;:false,&q;bizType&q;:0,&q;bizId&q;:&q;726825&q;,&q;supportReplay&q;:true,&q;extraInfo&q;:null,&q;liveConfig&q;:{&q;episodeId&q;:11235269,&q;supportMultiGroup&q;:false,&q;exerciseBizType&q;:0,&q;videoDisplayType&q;:0,&q;avForwardType&q;:0,&q;useIntelligentRoom&q;:false,&q;hasStrokeKeynote&q;:true,&q;verticalModeType&q;:0,&q;originEpisodeId&q;:0,&q;supportRtmp&q;:false,&q;supportPk&q;:true,&q;supportLuckyBag&q;:true,&q;supportUserNoteStroke&q;:false,&q;communicateType&q;:0,&q;one2One&q;:false,&q;fakeLive&q;:false},&q;validStatus&q;:1,&q;supportLive&q;:true,&q;supportAiCatalog&q;:false,&q;hasIntelligentPen&q;:false,&q;useLocalRecording&q;:false,&q;useIntelligentRoom&q;:false,&q;hasSalePosition&q;:false,&q;hasEpisodeCards&q;:true,&q;lockedForShouna&q;:false,&q;needSignIn&q;:false,&q;needTeacherSignIn&q;:false,&q;enablePadPencil&q;:true,&q;displayExercise&q;:false,&q;supportLuckyBag&q;:true,&q;supportLivePk&q;:true},{&q;id&q;:11235270,&q;kePrefix&q;:&q;sydw&q;,&q;courseId&q;:6,&q;status&q;:3,&q;playStatus&q;:3,&q;type&q;:33,&q;recordingType&q;:0,&q;mediaType&q;:0,&q;title&q;:&q;【综应】精选好题 沉浸刷题       &q;,&q;innerTitle&q;:&q;&q;,&q;startTime&q;:1764475200000,&q;endTime&q;:1764482400000,&q;teacher&q;:{&q;id&q;:35889,&q;userId&q;:59452309,&q;name&q;:&q;王昭媛&q;,&q;brief&q;:&q;粉笔优质讲师&q;,&q;desc&q;:&q;粉笔优质讲师\n985院校硕士毕业，投身教育事业6年，拥有扎实一线教学经验。多次参与真题解析以及真题解析视频录制，积累大量实用经验，对各省份考情深入钻研，精准把握各地考试要点。\n授课思路清晰，熟练掌握各类题型的作答技巧，理论扎实，逻辑清晰，重点突出，耐心细致，在教学过程中因材施教，采用启发式教学法，激发学员的学习兴趣与思考能力。\n承担各种线上线下授课任务，累计服务学员上千人，授课超1000小时，累计评分达4.9分。始终秉持着“以学员为中心”的教学理念，在教学过程中因材施教，并能及时跟进学员的学习进度，耐心解答学员的疑问，为学员提供个性化的辅导与建议，深受学员喜爱。&q;,&q;avatar&q;:&q;18f7000bcd332c6.jpg&q;,&q;upperBodyPhoto&q;:null,&q;displayCoursePrefix&q;:&q;sydw&q;,&q;teacherStat&q;:{&q;teacherId&q;:35889,&q;episodeCount&q;:313,&q;scoreCount&q;:848,&q;avgScore&q;:9.818396226415093,&q;fiveGradeAvgScore&q;:4.91,&q;updateTime&q;:1773575413148},&q;auditionEpisode&q;:{&q;episodeTitle&q;:&q;个人展示课&q;,&q;episodeVideoUrl&q;:&q;https://vod.fbstatic.cn/22e9ceb2vodbj1251001446/22bda7be5145403707387441415/gXaZC0lUKVsA.mp4?t=f2a4b300&a;us=4070880000&a;sign=a57ab9a520ff41c2fe2822f31d725d60&q;},&q;memberOfCPC&q;:false,&q;tags&q;:null},&q;teachChannel&q;:1,&q;offline&q;:null,&q;duration&q;:6723,&q;hasAudition&q;:false,&q;bizType&q;:0,&q;bizId&q;:&q;726825&q;,&q;supportReplay&q;:true,&q;extraInfo&q;:null,&q;liveConfig&q;:{&q;episodeId&q;:11235270,&q;supportMultiGroup&q;:false,&q;exerciseBizType&q;:0,&q;videoDisplayType&q;:0,&q;avForwardType&q;:0,&q;useIntelligentRoom&q;:false,&q;hasStrokeKeynote&q;:true,&q;verticalModeType&q;:0,&q;originEpisodeId&q;:0,&q;supportRtmp&q;:false,&q;supportPk&q;:true,&q;supportLuckyBag&q;:true,&q;supportUserNoteStroke&q;:false,&q;communicateType&q;:0,&q;one2One&q;:false,&q;fakeLive&q;:false},&q;validStatus&q;:1,&q;supportLive&q;:true,&q;supportAiCatalog&q;:false,&q;hasIntelligentPen&q;:false,&q;useLocalRecording&q;:false,&q;useIntelligentRoom&q;:false,&q;hasSalePosition&q;:false,&q;hasEpisodeCards&q;:true,&q;lockedForShouna&q;:false,&q;needSignIn&q;:false,&q;needTeacherSignIn&q;:false,&q;enablePadPencil&q;:true,&q;displayExercise&q;:false,&q;supportLuckyBag&q;:true,&q;supportLivePk&q;:true},{&q;id&q;:11090951,&q;kePrefix&q;:&q;sydw&q;,&q;courseId&q;:6,&q;status&q;:3,&q;playStatus&q;:3,&q;type&q;:33,&q;recordingType&q;:0,&q;mediaType&q;:0,&q;title&q;:&q;【言语】精选好题 沉浸刷题&q;,&q;innerTitle&q;:&q;&q;,&q;startTime&q;:1759975200000,&q;endTime&q;:1759982400000,&q;teacher&q;:{&q;id&q;:35776,&q;userId&q;:83534698,&q;name&q;:&q;魏兰婷&q;,&q;brief&q;:&q;粉笔优质讲师&q;,&q;desc&q;:&q;粉笔优质讲师\n拥有7年一线教学授课经验，毕业于双一流院校。深耕言语理解与表达科目，对国考及各省考情有精准把握。具有言语科目丰富的实践经验及系统扎实的专业理论知识。\n①多次参与粉笔授课研讨与教研活动，持续更新教学理论与方法；\n②承担线上公开课及线上直播课等工作，累计全国授课超万人次，学员评分长期稳定在4.9分以上；\n③曾2次在粉笔“师资风采大赛”中入围并获奖，教学能力获得内部认可。\n授课风格耐心细致，善于将复杂的知识点转化为通俗易懂的讲解，营造轻松积极的学习氛围。其高效的解题方法与亲切的指导深受学员好评，是学员信赖的良师。&q;,&q;avatar&q;:&q;1984fca9fbd6325.jpg&q;,&q;upperBodyPhoto&q;:null,&q;displayCoursePrefix&q;:&q;sydw&q;,&q;teacherStat&q;:{&q;teacherId&q;:35776,&q;episodeCount&q;:610,&q;scoreCount&q;:4222,&q;avgScore&q;:9.801989578398866,&q;fiveGradeAvgScore&q;:4.9,&q;updateTime&q;:1773576447340},&q;auditionEpisode&q;:{&q;episodeTitle&q;:&q;个人展示课&q;,&q;episodeVideoUrl&q;:&q;https://vod.fbstatic.cn/22e9ceb2vodbj1251001446/bcb7f84d5145403709538179593/LKKkDheS6YsA.mp4?t=f2a4b300&a;us=4070880000&a;sign=ade5c614ffe4fa0bcf0395aa689081c8&q;},&q;memberOfCPC&q;:false,&q;tags&q;:null},&q;teachChannel&q;:1,&q;offline&q;:null,&q;duration&q;:7657,&q;hasAudition&q;:false,&q;bizType&q;:0,&q;bizId&q;:&q;726825&q;,&q;supportReplay&q;:true,&q;extraInfo&q;:null,&q;liveConfig&q;:{&q;episodeId&q;:11090951,&q;supportMultiGroup&q;:false,&q;exerciseBizType&q;:0,&q;videoDisplayType&q;:0,&q;avForwardType&q;:0,&q;useIntelligentRoom&q;:false,&q;hasStrokeKeynote&q;:true,&q;verticalModeType&q;:0,&q;originEpisodeId&q;:0,&q;supportRtmp&q;:false,&q;supportPk&q;:true,&q;supportLuckyBag&q;:true,&q;supportUserNoteStroke&q;:false,&q;communicateType&q;:0,&q;one2One&q;:false,&q;fakeLive&q;:false},&q;validStatus&q;:1,&q;supportLive&q;:true,&q;supportAiCatalog&q;:false,&q;hasIntelligentPen&q;:false,&q;useLocalRecording&q;:false,&q;useIntelligentRoom&q;:false,&q;hasSalePosition&q;:false,&q;hasEpisodeCards&q;:true,&q;lockedForShouna&q;:false,&q;needSignIn&q;:false,&q;needTeacherSignIn&q;:false,&q;enablePadPencil&q;:true,&q;displayExercise&q;:false,&q;supportLuckyBag&q;:true,&q;supportLivePk&q;:true},{&q;id&q;:11090953,&q;kePrefix&q;:&q;sydw&q;,&q;courseId&q;:6,&q;status&q;:3,&q;playStatus&q;:3,&q;type&q;:33,&q;recordingType&q;:0,&q;mediaType&q;:0,&q;title&q;:&q;【公基非法】精选好题 沉浸刷题&q;,&q;innerTitle&q;:&q;&q;,&q;startTime&q;:1759982400000,&q;endTime&q;:1759989600000,&q;teacher&q;:{&q;id&q;:15530,&q;userId&q;:71692629,&q;name&q;:&q;杨意雯&q;,&q;brief&q;:&q;粉笔优质讲师&q;,&q;desc&q;:&q;粉笔优质讲师\n丰富实战背景：\n拥有超过7年的实战教学经验，总授课时长突破2000小时，见证了无数学生的成长与蜕变。\n深厚专业底蕴与实战融合：\n在公基与言语领域，拥有深厚的学术功底与实战经验，能够深入浅出地剖析考点，直击要害。积极参与多次教研会，紧跟国家公务员及事业单位选拔的最新动态，确保教学内容的前沿性与针对性。\n优质教学风采与广泛认可：\n收获超过1000份来自全国各地学员的热烈好评，构建起坚实的口碑基础。\n以“逻辑严谨、寓教于乐”的独特教学风格著称，擅长运用生动实例与趣味互动，将抽象概念具象化，让学习之旅变得生动有趣，极大提升了学生的学习兴趣与效率。&q;,&q;avatar&q;:&q;1760362bb2f7c82.jpg&q;,&q;upperBodyPhoto&q;:null,&q;displayCoursePrefix&q;:&q;sydw&q;,&q;teacherStat&q;:{&q;teacherId&q;:15530,&q;episodeCount&q;:449,&q;scoreCount&q;:1212,&q;avgScore&q;:9.900990099009896,&q;fiveGradeAvgScore&q;:4.95,&q;updateTime&q;:1773411447504},&q;auditionEpisode&q;:null,&q;memberOfCPC&q;:false,&q;tags&q;:null},&q;teachChannel&q;:1,&q;offline&q;:null,&q;duration&q;:7992,&q;hasAudition&q;:false,&q;bizType&q;:0,&q;bizId&q;:&q;726825&q;,&q;supportReplay&q;:true,&q;extraInfo&q;:null,&q;liveConfig&q;:{&q;episodeId&q;:11090953,&q;supportMultiGroup&q;:false,&q;exerciseBizType&q;:0,&q;videoDisplayType&q;:0,&q;avForwardType&q;:0,&q;useIntelligentRoom&q;:false,&q;hasStrokeKeynote&q;:true,&q;verticalModeType&q;:0,&q;originEpisodeId&q;:0,&q;supportRtmp&q;:false,&q;supportPk&q;:true,&q;supportLuckyBag&q;:true,&q;supportUserNoteStroke&q;:false,&q;communicateType&q;:0,&q;one2One&q;:false,&q;fakeLive&q;:false},&q;validStatus&q;:1,&q;supportLive&q;:true,&q;supportAiCatalog&q;:false,&q;hasIntelligentPen&q;:false,&q;useLocalRecording&q;:false,&q;useIntelligentRoom&q;:false,&q;hasSalePosition&q;:false,&q;hasEpisodeCards&q;:true,&q;lockedForShouna&q;:false,&q;needSignIn&q;:false,&q;needTeacherSignIn&q;:false,&q;enablePadPencil&q;:true,&q;displayExercise&q;:false,&q;supportLuckyBag&q;:true,&q;supportLivePk&q;:true},{&q;id&q;:11090957,&q;kePrefix&q;:&q;sydw&q;,&q;courseId&q;:6,&q;status&q;:3,&q;playStatus&q;:3,&q;type&q;:33,&q;recordingType&q;:0,&q;mediaType&q;:0,&q;title&q;:&q;【公基法律】精选好题 沉浸刷题&q;,&q;innerTitle&q;:&q;&q;,&q;startTime&q;:1759989600000,&q;endTime&q;:1759996800000,&q;teacher&q;:{&q;id&q;:18973,&q;userId&q;:59327812,&q;name&q;:&q;李浚文&q;,&q;brief&q;:&q;粉笔优质讲师&q;,&q;desc&q;:&q;粉笔常识公基优质讲师\n8年公考教学经验，撰写多篇事业单位笔试教研材料，在粉笔笔试教师内部进行共享。具备系统扎实的理论知识和教学经验，授课逻辑清晰、考点突出，深受广大学员的认可和好评，是值得信赖的好导师。&q;,&q;avatar&q;:&q;1945f35b54dda3b.jpg&q;,&q;upperBodyPhoto&q;:null,&q;displayCoursePrefix&q;:&q;sydw&q;,&q;teacherStat&q;:{&q;teacherId&q;:18973,&q;episodeCount&q;:659,&q;scoreCount&q;:983,&q;avgScore&q;:9.67446592065106,&q;fiveGradeAvgScore&q;:4.84,&q;updateTime&q;:1773544007368},&q;auditionEpisode&q;:{&q;episodeTitle&q;:&q;个人展示课&q;,&q;episodeVideoUrl&q;:&q;https://vod.fbstatic.cn/22e9ceb2vodbj1251001446/828cc79e5145403709544701770/Sd2p7K2oNYYA.mp4?t=f2a4b300&a;us=4070880000&a;sign=4c4ee7912c75d3f2d0f868bfbbb406b4&q;},&q;memberOfCPC&q;:false,&q;tags&q;:null},&q;teachChannel&q;:1,&q;offline&q;:null,&q;duration&q;:7065,&q;hasAudition&q;:false,&q;bizType&q;:0,&q;bizId&q;:&q;726825&q;,&q;supportReplay&q;:true,&q;extraInfo&q;:null,&q;liveConfig&q;:{&q;episodeId&q;:11090957,&q;supportMultiGroup&q;:false,&q;exerciseBizType&q;:0,&q;videoDisplayType&q;:0,&q;avForwardType&q;:0,&q;useIntelligentRoom&q;:false,&q;hasStrokeKeynote&q;:true,&q;verticalModeType&q;:0,&q;originEpisodeId&q;:0,&q;supportRtmp&q;:false,&q;supportPk&q;:true,&q;supportLuckyBag&q;:true,&q;supportUserNoteStroke&q;:false,&q;communicateType&q;:0,&q;one2One&q;:false,&q;fakeLive&q;:false},&q;validStatus&q;:1,&q;supportLive&q;:true,&q;supportAiCatalog&q;:false,&q;hasIntelligentPen&q;:false,&q;useLocalRecording&q;:false,&q;useIntelligentRoom&q;:false,&q;hasSalePosition&q;:false,&q;hasEpisodeCards&q;:true,&q;lockedForShouna&q;:false,&q;needSignIn&q;:false,&q;needTeacherSignIn&q;:false,&q;enablePadPencil&q;:true,&q;displayExercise&q;:false,&q;supportLuckyBag&q;:true,&q;supportLivePk&q;:true},{&q;id&q;:11090958,&q;kePrefix&q;:&q;sydw&q;,&q;courseId&q;:6,&q;status&q;:3,&q;playStatus&q;:3,&q;type&q;:33,&q;recordingType&q;:0,&q;mediaType&q;:0,&q;title&q;:&q;【判断】精选好题 沉浸刷题&q;,&q;innerTitle&q;:&q;&q;,&q;startTime&q;:1759996800000,&q;endTime&q;:1760004000000,&q;teacher&q;:{&q;id&q;:16684,&q;userId&q;:59358516,&q;name&q;:&q;周晶辉&q;,&q;brief&q;:&q;粉笔优质讲师&q;,&q;desc&q;:&q;粉笔优质教师\n六年一线教学授课经验，累计授课时长1000+小时，综合授课评分4.9+，实战经验丰富，授课逻辑清晰，多次参与科目教研工作、授课研讨会议，参与事业单位真题单题录制、模拟题撰写等，熟练掌握判断科目考情及命题趋势，擅长各省联考、江苏、浙江、广东等多地区考点，擅于从学员角度思考，帮助学员理清解题思路，掌握科目常规考点，突破科目重难考点，具有幽默诙谐、形象生动、条理清晰的授课风格，让学生在轻松的学习氛围中，用更简单的方法，找到更快捷的解题之道，深受广大学员的认可和好评。&q;,&q;avatar&q;:&q;198caf9ea93f698.jpg&q;,&q;upperBodyPhoto&q;:null,&q;displayCoursePrefix&q;:&q;sydw&q;,&q;teacherStat&q;:{&q;teacherId&q;:16684,&q;episodeCount&q;:449,&q;scoreCount&q;:1699,&q;avgScore&q;:9.85638610947615,&q;fiveGradeAvgScore&q;:4.93,&q;updateTime&q;:1773578657175},&q;auditionEpisode&q;:{&q;episodeTitle&q;:&q;个人展示课&q;,&q;episodeVideoUrl&q;:&q;https://vod.fbstatic.cn/22e9ceb2vodbj1251001446/85b397c93560136620837741859/inWAKAms518A.mp4?t=f2a4b300&a;us=4070880000&a;sign=8ae71ff49f003e5c8d83058d09cdc3db&q;},&q;memberOfCPC&q;:false,&q;tags&q;:null},&q;teachChannel&q;:1,&q;offline&q;:null,&q;duration&q;:7666,&q;hasAudition&q;:false,&q;bizType&q;:0,&q;bizId&q;:&q;726825&q;,&q;supportReplay&q;:true,&q;extraInfo&q;:null,&q;liveConfig&q;:{&q;episodeId&q;:11090958,&q;supportMultiGroup&q;:false,&q;exerciseBizType&q;:0,&q;videoDisplayType&q;:0,&q;avForwardType&q;:0,&q;useIntelligentRoom&q;:false,&q;hasStrokeKeynote&q;:true,&q;verticalModeType&q;:0,&q;originEpisodeId&q;:0,&q;supportRtmp&q;:false,&q;supportPk&q;:true,&q;supportLuckyBag&q;:true,&q;supportUserNoteStroke&q;:false,&q;communicateType&q;:0,&q;one2One&q;:false,&q;fakeLive&q;:false},&q;validStatus&q;:1,&q;supportLive&q;:true,&q;supportAiCatalog&q;:false,&q;hasIntelligentPen&q;:false,&q;useLocalRecording&q;:false,&q;useIntelligentRoom&q;:false,&q;hasSalePosition&q;:false,&q;hasEpisodeCards&q;:true,&q;lockedForShouna&q;:false,&q;needSignIn&q;:false,&q;needTeacherSignIn&q;:false,&q;enablePadPencil&q;:true,&q;displayExercise&q;:false,&q;supportLuckyBag&q;:true,&q;supportLivePk&q;:true},{&q;id&q;:11090977,&q;kePrefix&q;:&q;sydw&q;,&q;courseId&q;:6,&q;status&q;:3,&q;playStatus&q;:3,&q;type&q;:33,&q;recordingType&q;:0,&q;mediaType&q;:0,&q;title&q;:&q;【数资】精选好题 沉浸刷题&q;,&q;innerTitle&q;:&q;&q;,&q;startTime&q;:1760061600000,&q;endTime&q;:1760068800000,&q;teacher&q;:{&q;id&q;:16722,&q;userId&q;:52232168,&q;name&q;:&q;王轶琢&q;,&q;brief&q;:&q;粉笔优质讲师&q;,&q;desc&q;:&q;粉笔优质讲师\n6年一线教学授课经验；具有数资科目丰富的实践经验及系统扎实的专业理论知识；多次参加粉笔教研活动，分享授课经验心得，助力粉笔理论研发升级；\n累计授课超过2000小时，累计评分达4.9分；授课与实战经验丰富，熟悉考场答题思维及应变技巧。\n老师授课风格：风趣幽默，灵活引导学员自主思考，激发学员学习热情和自主意识；授课逻辑性强，注重理论与实践相结合，深受学员的喜爱。&q;,&q;avatar&q;:&q;1983bddcd777cc6.jpg&q;,&q;upperBodyPhoto&q;:null,&q;displayCoursePrefix&q;:&q;sydw&q;,&q;teacherStat&q;:{&q;teacherId&q;:16722,&q;episodeCount&q;:870,&q;scoreCount&q;:2527,&q;avgScore&q;:9.784724970320534,&q;fiveGradeAvgScore&q;:4.89,&q;updateTime&q;:1773198754974},&q;auditionEpisode&q;:{&q;episodeTitle&q;:&q;个人展示课&q;,&q;episodeVideoUrl&q;:&q;https://vod.fbstatic.cn/22e9ceb2vodbj1251001446/9ebc23c15145403707375528343/mutMbTelffgA.mp4?t=f2a4b300&a;us=4070880000&a;sign=fa18dfaff16469d1f41c7e7cebb5b1a6&q;},&q;memberOfCPC&q;:false,&q;tags&q;:null},&q;teachChannel&q;:1,&q;offline&q;:null,&q;duration&q;:7428,&q;hasAudition&q;:false,&q;bizType&q;:0,&q;bizId&q;:&q;726825&q;,&q;supportReplay&q;:true,&q;extraInfo&q;:null,&q;liveConfig&q;:{&q;episodeId&q;:11090977,&q;supportMultiGroup&q;:false,&q;exerciseBizType&q;:0,&q;videoDisplayType&q;:0,&q;avForwardType&q;:0,&q;useIntelligentRoom&q;:false,&q;hasStrokeKeynote&q;:true,&q;verticalModeType&q;:0,&q;originEpisodeId&q;:0,&q;supportRtmp&q;:false,&q;supportPk&q;:true,&q;supportLuckyBag&q;:true,&q;supportUserNoteStroke&q;:false,&q;communicateType&q;:0,&q;one2One&q;:false,&q;fakeLive&q;:false},&q;validStatus&q;:1,&q;supportLive&q;:true,&q;supportAiCatalog&q;:false,&q;hasIntelligentPen&q;:false,&q;useLocalRecording&q;:false,&q;useIntelligentRoom&q;:false,&q;hasSalePosition&q;:false,&q;hasEpisodeCards&q;:true,&q;lockedForShouna&q;:false,&q;needSignIn&q;:false,&q;needTeacherSignIn&q;:false,&q;enablePadPencil&q;:true,&q;displayExercise&q;:false,&q;supportLuckyBag&q;:true,&q;supportLivePk&q;:true},{&q;id&q;:11091394,&q;kePrefix&q;:&q;sydw&q;,&q;courseId&q;:6,&q;status&q;:3,&q;playStatus&q;:3,&q;type&q;:33,&q;recordingType&q;:0,&q;mediaType&q;:0,&q;title&q;:&q;【言语】精选好题 沉浸刷题&q;,&q;innerTitle&q;:&q;&q;,&q;startTime&q;:1760068800000,&q;endTime&q;:1760076000000,&q;teacher&q;:{&q;id&q;:16735,&q;userId&q;:46275516,&q;name&q;:&q;郭孟楠&q;,&q;brief&q;:&q;粉笔优质讲师&q;,&q;desc&q;:&q;粉笔优质讲师\n5年一线教学经验，对言语理解与表达的命题趋势和解题技巧有着精准的把握。在教学过程中，注重培养学生的语言敏感度和逻辑思维能力，通过系统的知识讲解和大量的真题演练，帮助学生快速掌握解题技巧，提高答题速度和准确率。注重启发式教学，能够及时发现并解决学生在学习过程中遇到的问题，适合各个阶段的学习并深受学员喜爱。&q;,&q;avatar&q;:&q;1746be4c31acce6.jpg&q;,&q;upperBodyPhoto&q;:null,&q;displayCoursePrefix&q;:&q;sydw&q;,&q;teacherStat&q;:{&q;teacherId&q;:16735,&q;episodeCount&q;:386,&q;scoreCount&q;:5679,&q;avgScore&q;:9.730938545518592,&q;fiveGradeAvgScore&q;:4.87,&q;updateTime&q;:1773371290044},&q;auditionEpisode&q;:{&q;episodeTitle&q;:&q;个人展示课&q;,&q;episodeVideoUrl&q;:&q;https://vod.fbstatic.cn/22e9ceb2vodbj1251001446/cf4aa7181397757903434929665/eDPwMVOaVQcA.mp4?t=f2a4b300&a;us=4070880000&a;sign=32ab41a3d56b67eb4d07d67b2bdb9cc6&q;},&q;memberOfCPC&q;:false,&q;tags&q;:null},&q;teachChannel&q;:1,&q;offline&q;:null,&q;duration&q;:7966,&q;hasAudition&q;:false,&q;bizType&q;:0,&q;bizId&q;:&q;726825&q;,&q;supportReplay&q;:true,&q;extraInfo&q;:null,&q;liveConfig&q;:{&q;episodeId&q;:11091394,&q;supportMultiGroup&q;:false,&q;exerciseBizType&q;:0,&q;videoDisplayType&q;:0,&q;avForwardType&q;:0,&q;useIntelligentRoom&q;:false,&q;hasStrokeKeynote&q;:true,&q;verticalModeType&q;:0,&q;originEpisodeId&q;:0,&q;supportRtmp&q;:false,&q;supportPk&q;:true,&q;supportLuckyBag&q;:true,&q;supportUserNoteStroke&q;:false,&q;communicateType&q;:0,&q;one2One&q;:false,&q;fakeLive&q;:false},&q;validStatus&q;:1,&q;supportLive&q;:true,&q;supportAiCatalog&q;:false,&q;hasIntelligentPen&q;:false,&q;useLocalRecording&q;:false,&q;useIntelligentRoom&q;:false,&q;hasSalePosition&q;:false,&q;hasEpisodeCards&q;:true,&q;lockedForShouna&q;:false,&q;needSignIn&q;:false,&q;needTeacherSignIn&q;:false,&q;enablePadPencil&q;:true,&q;displayExercise&q;:false,&q;supportLuckyBag&q;:true,&q;supportLivePk&q;:true},{&q;id&q;:11091399,&q;kePrefix&q;:&q;sydw&q;,&q;courseId&q;:6,&q;status&q;:3,&q;playStatus&q;:3,&q;type&q;:33,&q;recordingType&q;:0,&q;mediaType&q;:0,&q;title&q;:&q;【公基非法】精选好题 沉浸刷题&q;,&q;innerTitle&q;:&q;&q;,&q;startTime&q;:1760076000000,&q;endTime&q;:1760083200000,&q;teacher&q;:{&q;id&q;:16538,&q;userId&q;:72683674,&q;name&q;:&q;章亦轩&q;,&q;brief&q;:&q;粉笔优质讲师&q;,&q;desc&q;:&q;粉笔常识公基优质教师\n四年一线教学授课经验，深耕一线课程，承担过线上笔试精品班、刷题班等多种班型。\n具有常识公基科目丰富的实践经验及系统扎实的专业理论知识和对常识公基考情的深入研究，曾参与笔试教研和解析撰写工作；注重考场思维，针对学生困惑研究教学策略；深入研讨常识公基命题趋势及最新考情，注重自我提升，积累丰富笔试理论知识。\n累计授课超1000小时，注重启发式引导，让学生在轻松的学习氛围中，用更简单的方法，找到更快捷的解题之道，深受广大学员的认可和好评。&q;,&q;avatar&q;:&q;17467b2f8a0fb3b.jpg&q;,&q;upperBodyPhoto&q;:null,&q;displayCoursePrefix&q;:&q;sydw&q;,&q;teacherStat&q;:{&q;teacherId&q;:16538,&q;episodeCount&q;:914,&q;scoreCount&q;:1035,&q;avgScore&q;:9.62898550724638,&q;fiveGradeAvgScore&q;:4.81,&q;updateTime&q;:1773475961041},&q;auditionEpisode&q;:{&q;episodeTitle&q;:&q;个人展示课&q;,&q;episodeVideoUrl&q;:&q;https://vod.fbstatic.cn/22e9ceb2vodbj1251001446/6ef433b51397757888365410347/0qvJbp7EGrgA.mp4?t=f2a4b300&a;us=4070880000&a;sign=5675190d3b2d1da9f9d0e15ba0571903&q;},&q;memberOfCPC&q;:false,&q;tags&q;:null},&q;teachChannel&q;:1,&q;offline&q;:null,&q;duration&q;:7369,&q;hasAudition&q;:false,&q;bizType&q;:0,&q;bizId&q;:&q;726825&q;,&q;supportReplay&q;:true,&q;extraInfo&q;:null,&q;liveConfig&q;:{&q;episodeId&q;:11091399,&q;supportMultiGroup&q;:false,&q;exerciseBizType&q;:0,&q;videoDisplayType&q;:0,&q;avForwardType&q;:0,&q;useIntelligentRoom&q;:false,&q;hasStrokeKeynote&q;:true,&q;verticalModeType&q;:0,&q;originEpisodeId&q;:0,&q;supportRtmp&q;:false,&q;supportPk&q;:true,&q;supportLuckyBag&q;:true,&q;supportUserNoteStroke&q;:false,&q;communicateType&q;:0,&q;one2One&q;:false,&q;fakeLive&q;:false},&q;validStatus&q;:1,&q;supportLive&q;:true,&q;supportAiCatalog&q;:false,&q;hasIntelligentPen&q;:false,&q;useLocalRecording&q;:false,&q;useIntelligentRoom&q;:false,&q;hasSalePosition&q;:false,&q;hasEpisodeCards&q;:true,&q;lockedForShouna&q;:false,&q;needSignIn&q;:false,&q;needTeacherSignIn&q;:false,&q;enablePadPencil&q;:true,&q;displayExercise&q;:false,&q;supportLuckyBag&q;:true,&q;supportLivePk&q;:true},{&q;id&q;:11091401,&q;kePrefix&q;:&q;sydw&q;,&q;courseId&q;:6,&q;status&q;:3,&q;playStatus&q;:3,&q;type&q;:33,&q;recordingType&q;:0,&q;mediaType&q;:0,&q;title&q;:&q;【判断】精选好题 沉浸刷题&q;,&q;innerTitle&q;:&q;&q;,&q;startTime&q;:1760083200000,&q;endTime&q;:1760090400000,&q;teacher&q;:{&q;id&q;:16852,&q;userId&q;:74701449,&q;name&q;:&q;王琛&q;,&q;brief&q;:&q;粉笔优质讲师&q;,&q;desc&q;:&q;粉笔优质教师\n具有6年教学授课经验，授课重点突出，能够及时总结拓展，讲解语言通俗易懂，广受学员好评。课堂氛围轻松融洽，擅长引导学生自主思考，多次参与粉笔教研活动，全面把握命题趋势和最新考情。善于根据学生的不同情况，进行个性化的指导，助力学员上岸。&q;,&q;avatar&q;:&q;1966b8f5dbc77d6.jpg&q;,&q;upperBodyPhoto&q;:null,&q;displayCoursePrefix&q;:&q;sydw&q;,&q;teacherStat&q;:{&q;teacherId&q;:16852,&q;episodeCount&q;:443,&q;scoreCount&q;:2283,&q;avgScore&q;:9.75295663600527,&q;fiveGradeAvgScore&q;:4.88,&q;updateTime&q;:1773543525445},&q;auditionEpisode&q;:{&q;episodeTitle&q;:&q;个人展示课&q;,&q;episodeVideoUrl&q;:&q;https://vod.fbstatic.cn/22e9ceb2vodbj1251001446/b269fc425145403709334963335/WjukmC5LPh8A.mp4?t=f2a4b300&a;us=4070880000&a;sign=8efff2e71e1428c94e20dd995c2853f2&q;},&q;memberOfCPC&q;:false,&q;tags&q;:null},&q;teachChannel&q;:1,&q;offline&q;:null,&q;duration&q;:7500,&q;hasAudition&q;:false,&q;bizType&q;:0,&q;bizId&q;:&q;726825&q;,&q;supportReplay&q;:true,&q;extraInfo&q;:null,&q;liveConfig&q;:{&q;episodeId&q;:11091401,&q;supportMultiGroup&q;:false,&q;exerciseBizType&q;:0,&q;videoDisplayType&q;:0,&q;avForwardType&q;:0,&q;useIntelligentRoom&q;:false,&q;hasStrokeKeynote&q;:true,&q;verticalModeType&q;:0,&q;originEpisodeId&q;:0,&q;supportRtmp&q;:false,&q;supportPk&q;:true,&q;supportLuckyBag&q;:true,&q;supportUserNoteStroke&q;:false,&q;communicateType&q;:0,&q;one2One&q;:false,&q;fakeLive&q;:false},&q;validStatus&q;:1,&q;supportLive&q;:true,&q;supportAiCatalog&q;:false,&q;hasIntelligentPen&q;:false,&q;useLocalRecording&q;:false,&q;useIntelligentRoom&q;:false,&q;hasSalePosition&q;:false,&q;hasEpisodeCards&q;:true,&q;lockedForShouna&q;:false,&q;needSignIn&q;:false,&q;needTeacherSignIn&q;:false,&q;enablePadPencil&q;:true,&q;displayExercise&q;:false,&q;supportLuckyBag&q;:true,&q;supportLivePk&q;:true},{&q;id&q;:11091407,&q;kePrefix&q;:&q;sydw&q;,&q;courseId&q;:6,&q;status&q;:3,&q;playStatus&q;:3,&q;type&q;:33,&q;recordingType&q;:0,&q;mediaType&q;:0,&q;title&q;:&q;【言语】精选好题 沉浸刷题&q;,&q;innerTitle&q;:&q;&q;,&q;startTime&q;:1760148000000,&q;endTime&q;:1760155200000,&q;teacher&q;:{&q;id&q;:35776,&q;userId&q;:83534698,&q;name&q;:&q;魏兰婷&q;,&q;brief&q;:&q;粉笔优质讲师&q;,&q;desc&q;:&q;粉笔优质讲师\n拥有7年一线教学授课经验，毕业于双一流院校。深耕言语理解与表达科目，对国考及各省考情有精准把握。具有言语科目丰富的实践经验及系统扎实的专业理论知识。\n①多次参与粉笔授课研讨与教研活动，持续更新教学理论与方法；\n②承担线上公开课及线上直播课等工作，累计全国授课超万人次，学员评分长期稳定在4.9分以上；\n③曾2次在粉笔“师资风采大赛”中入围并获奖，教学能力获得内部认可。\n授课风格耐心细致，善于将复杂的知识点转化为通俗易懂的讲解，营造轻松积极的学习氛围。其高效的解题方法与亲切的指导深受学员好评，是学员信赖的良师。&q;,&q;avatar&q;:&q;1984fca9fbd6325.jpg&q;,&q;upperBodyPhoto&q;:null,&q;displayCoursePrefix&q;:&q;sydw&q;,&q;teacherStat&q;:{&q;teacherId&q;:35776,&q;episodeCount&q;:610,&q;scoreCount&q;:4222,&q;avgScore&q;:9.801989578398866,&q;fiveGradeAvgScore&q;:4.9,&q;updateTime&q;:1773576447340},&q;auditionEpisode&q;:{&q;episodeTitle&q;:&q;个人展示课&q;,&q;episodeVideoUrl&q;:&q;https://vod.fbstatic.cn/22e9ceb2vodbj1251001446/bcb7f84d5145403709538179593/LKKkDheS6YsA.mp4?t=f2a4b300&a;us=4070880000&a;sign=ade5c614ffe4fa0bcf0395aa689081c8&q;},&q;memberOfCPC&q;:false,&q;tags&q;:null},&q;teachChannel&q;:1,&q;offline&q;:null,&q;duration&q;:8171,&q;hasAudition&q;:false,&q;bizType&q;:0,&q;bizId&q;:&q;726825&q;,&q;supportReplay&q;:true,&q;extraInfo&q;:null,&q;liveConfig&q;:{&q;episodeId&q;:11091407,&q;supportMultiGroup&q;:false,&q;exerciseBizType&q;:0,&q;videoDisplayType&q;:0,&q;avForwardType&q;:0,&q;useIntelligentRoom&q;:false,&q;hasStrokeKeynote&q;:true,&q;verticalModeType&q;:0,&q;originEpisodeId&q;:0,&q;supportRtmp&q;:false,&q;supportPk&q;:true,&q;supportLuckyBag&q;:true,&q;supportUserNoteStroke&q;:false,&q;communicateType&q;:0,&q;one2One&q;:false,&q;fakeLive&q;:false},&q;validStatus&q;:1,&q;supportLive&q;:true,&q;supportAiCatalog&q;:false,&q;hasIntelligentPen&q;:false,&q;useLocalRecording&q;:false,&q;useIntelligentRoom&q;:false,&q;hasSalePosition&q;:false,&q;hasEpisodeCards&q;:true,&q;lockedForShouna&q;:false,&q;needSignIn&q;:false,&q;needTeacherSignIn&q;:false,&q;enablePadPencil&q;:true,&q;displayExercise&q;:false,&q;supportLuckyBag&q;:true,&q;supportLivePk&q;:true},{&q;id&q;:11091413,&q;kePrefix&q;:&q;sydw&q;,&q;courseId&q;:6,&q;status&q;:3,&q;playStatus&q;:3,&q;type&q;:33,&q;recordingType&q;:0,&q;mediaType&q;:0,&q;title&q;:&q;【综应】精选好题 沉浸刷题&q;,&q;innerTitle&q;:&q;&q;,&q;startTime&q;:1760155200000,&q;endTime&q;:1760162400000,&q;teacher&q;:{&q;id&q;:16970,&q;userId&q;:66988478,&q;name&q;:&q;彭雨青&q;,&q;brief&q;:&q;粉笔优质讲师&q;,&q;desc&q;:&q;粉笔优质讲师。六年一线教学经验，多次事业单位考试实战经历，综应成绩突出，全面了解事业单位综合应用能力考情及答题技巧; 多次参与粉笔线上线下教研活动，理论基础扎实，注重考场思维；授课经验丰富，参与多班型授课，课堂氛围轻松；授课风格成熟，讲解耐心细致，条理清晰，受到学员广泛好评。&q;,&q;avatar&q;:&q;198551f5f2aeddc.jpg&q;,&q;upperBodyPhoto&q;:null,&q;displayCoursePrefix&q;:&q;sydw&q;,&q;teacherStat&q;:{&q;teacherId&q;:16970,&q;episodeCount&q;:426,&q;scoreCount&q;:550,&q;avgScore&q;:9.959999999999994,&q;fiveGradeAvgScore&q;:4.98,&q;updateTime&q;:1773206256359},&q;auditionEpisode&q;:{&q;episodeTitle&q;:&q;个人展示课&q;,&q;episodeVideoUrl&q;:&q;https://vod.fbstatic.cn/22e9ceb2vodbj1251001446/8207a7095145403709537920947/TaUQYutM1mAA.mp4?t=f2a4b300&a;us=4070880000&a;sign=03a53cae536bade8d5d8aa41a688ac08&q;},&q;memberOfCPC&q;:false,&q;tags&q;:null},&q;teachChannel&q;:1,&q;offline&q;:null,&q;duration&q;:7219,&q;hasAudition&q;:false,&q;bizType&q;:0,&q;bizId&q;:&q;726825&q;,&q;supportReplay&q;:true,&q;extraInfo&q;:null,&q;liveConfig&q;:{&q;episodeId&q;:11091413,&q;supportMultiGroup&q;:false,&q;exerciseBizType&q;:0,&q;videoDisplayType&q;:0,&q;avForwardType&q;:0,&q;useIntelligentRoom&q;:false,&q;hasStrokeKeynote&q;:true,&q;verticalModeType&q;:0,&q;originEpisodeId&q;:0,&q;supportRtmp&q;:false,&q;supportPk&q;:true,&q;supportLuckyBag&q;:true,&q;supportUserNoteStroke&q;:false,&q;communicateType&q;:0,&q;one2One&q;:false,&q;fakeLive&q;:false},&q;validStatus&q;:1,&q;supportLive&q;:true,&q;supportAiCatalog&q;:false,&q;hasIntelligentPen&q;:false,&q;useLocalRecording&q;:false,&q;useIntelligentRoom&q;:false,&q;hasSalePosition&q;:false,&q;hasEpisodeCards&q;:true,&q;lockedForShouna&q;:false,&q;needSignIn&q;:false,&q;needTeacherSignIn&q;:false,&q;enablePadPencil&q;:true,&q;displayExercise&q;:false,&q;supportLuckyBag&q;:true,&q;supportLivePk&q;:true},{&q;id&q;:11091416,&q;kePrefix&q;:&q;sydw&q;,&q;courseId&q;:6,&q;status&q;:3,&q;playStatus&q;:3,&q;type&q;:33,&q;recordingType&q;:0,&q;mediaType&q;:0,&q;title&q;:&q;【公基非法】精选好题 沉浸刷题&q;,&q;innerTitle&q;:&q;&q;,&q;startTime&q;:1760234400000,&q;endTime&q;:1760241600000,&q;teacher&q;:{&q;id&q;:17050,&q;userId&q;:69384227,&q;name&q;:&q;刘枭&q;,&q;brief&q;:&q;粉笔优质讲师&q;,&q;desc&q;:&q;粉笔优质讲师。\n硕士毕业，从事线上常识公基科目教研授课长达6年，拥有非常丰富扎实的一线授课经验，承担多种产品类型的授课工作。\n教学上，具有常识公基非法科目丰富的实践经验及扎实的专业知识，对常识公基非法考情有着深入的研究，长期承担非法板块小模考授课，曾多次参与命制笔试真题教研和解析撰写工作，致力于研究事业单位的命题规律及答题技巧。\n授课深入浅出，举一反三，善于引导和启发学生；讲课逻辑性强条分缕析，善长归纳方法技巧；从学员角度出发解决问题，长期累计评分达4.9。细致耐心，寓教于乐，善于营造轻松愉悦的课堂氛围，深受学生喜爱。&q;,&q;avatar&q;:&q;17470a2ced5ee4c.jpg&q;,&q;upperBodyPhoto&q;:null,&q;displayCoursePrefix&q;:&q;sydw&q;,&q;teacherStat&q;:{&q;teacherId&q;:17050,&q;episodeCount&q;:730,&q;scoreCount&q;:2726,&q;avgScore&q;:9.798972853998558,&q;fiveGradeAvgScore&q;:4.9,&q;updateTime&q;:1773476302738},&q;auditionEpisode&q;:{&q;episodeTitle&q;:&q;个人展示课&q;,&q;episodeVideoUrl&q;:&q;https://vod.fbstatic.cn/22e9ceb2vodbj1251001446/9ae2fc415145403708185095920/NpmeJff4ztMA.mp4?t=f2a4b300&a;us=4070880000&a;sign=de1c4dfab32e0a94c2ae19673faed255&q;},&q;memberOfCPC&q;:false,&q;tags&q;:null},&q;teachChannel&q;:1,&q;offline&q;:null,&q;duration&q;:7561,&q;hasAudition&q;:false,&q;bizType&q;:0,&q;bizId&q;:&q;726825&q;,&q;supportReplay&q;:true,&q;extraInfo&q;:null,&q;liveConfig&q;:{&q;episodeId&q;:11091416,&q;supportMultiGroup&q;:false,&q;exerciseBizType&q;:0,&q;videoDisplayType&q;:0,&q;avForwardType&q;:0,&q;useIntelligentRoom&q;:false,&q;hasStrokeKeynote&q;:true,&q;verticalModeType&q;:0,&q;originEpisodeId&q;:0,&q;supportRtmp&q;:false,&q;supportPk&q;:true,&q;supportLuckyBag&q;:true,&q;supportUserNoteStroke&q;:false,&q;communicateType&q;:0,&q;one2One&q;:false,&q;fakeLive&q;:false},&q;validStatus&q;:1,&q;supportLive&q;:true,&q;supportAiCatalog&q;:false,&q;hasIntelligentPen&q;:false,&q;useLocalRecording&q;:false,&q;useIntelligentRoom&q;:false,&q;hasSalePosition&q;:false,&q;hasEpisodeCards&q;:true,&q;lockedForShouna&q;:false,&q;needSignIn&q;:false,&q;needTeacherSignIn&q;:false,&q;enablePadPencil&q;:true,&q;displayExercise&q;:false,&q;supportLuckyBag&q;:true,&q;supportLivePk&q;:true},{&q;id&q;:11091418,&q;kePrefix&q;:&q;sydw&q;,&q;courseId&q;:6,&q;status&q;:3,&q;playStatus&q;:3,&q;type&q;:33,&q;recordingType&q;:0,&q;mediaType&q;:0,&q;title&q;:&q;【数资】精选好题 沉浸刷题&q;,&q;innerTitle&q;:&q;&q;,&q;startTime&q;:1760241600000,&q;endTime&q;:1760248800000,&q;teacher&q;:{&q;id&q;:16648,&q;userId&q;:74152754,&q;name&q;:&q;陈洋&q;,&q;brief&q;:&q;粉笔优质讲师&q;,&q;desc&q;:&q;粉笔优质教师\n6年一线教学授课经验，具有数资科目丰富的实践经验及系统扎实的专业理论知识，多次参加粉笔教研活动，分享授课经验心得，助力粉笔理论研发升级；\n授课逻辑清晰、重难点突出，课堂学习氛围轻松，让学员用更简单的方法，找到更快捷的解题之道，深受广大学员的认可和好评；在学员中具有非常好的口碑，是值得信赖的好导师。&q;,&q;avatar&q;:&q;1945f259dd30831.jpg&q;,&q;upperBodyPhoto&q;:null,&q;displayCoursePrefix&q;:&q;sydw&q;,&q;teacherStat&q;:{&q;teacherId&q;:16648,&q;episodeCount&q;:782,&q;scoreCount&q;:1917,&q;avgScore&q;:9.812206572769968,&q;fiveGradeAvgScore&q;:4.91,&q;updateTime&q;:1773573616029},&q;auditionEpisode&q;:{&q;episodeTitle&q;:&q;个人展示课&q;,&q;episodeVideoUrl&q;:&q;https://vod.fbstatic.cn/22e9ceb2vodbj1251001446/571009c11397757903436191001/71GyWjiNw7MA.mp4?t=f2a4b300&a;us=4070880000&a;sign=b59a7b96a095f92f99b475fb3660977b&q;},&q;memberOfCPC&q;:false,&q;tags&q;:null},&q;teachChannel&q;:1,&q;offline&q;:null,&q;duration&q;:8704,&q;hasAudition&q;:false,&q;bizType&q;:0,&q;bizId&q;:&q;726825&q;,&q;supportReplay&q;:true,&q;extraInfo&q;:null,&q;liveConfig&q;:{&q;episodeId&q;:11091418,&q;supportMultiGroup&q;:false,&q;exerciseBizType&q;:0,&q;videoDisplayType&q;:0,&q;avForwardType&q;:0,&q;useIntelligentRoom&q;:false,&q;hasStrokeKeynote&q;:true,&q;verticalModeType&q;:0,&q;originEpisodeId&q;:0,&q;supportRtmp&q;:false,&q;supportPk&q;:true,&q;supportLuckyBag&q;:true,&q;supportUserNoteStroke&q;:false,&q;communicateType&q;:0,&q;one2One&q;:false,&q;fakeLive&q;:false},&q;validStatus&q;:1,&q;supportLive&q;:true,&q;supportAiCatalog&q;:false,&q;hasIntelligentPen&q;:false,&q;useLocalRecording&q;:false,&q;useIntelligentRoom&q;:false,&q;hasSalePosition&q;:false,&q;hasEpisodeCards&q;:true,&q;lockedForShouna&q;:false,&q;needSignIn&q;:false,&q;needTeacherSignIn&q;:false,&q;enablePadPencil&q;:true,&q;displayExercise&q;:false,&q;supportLuckyBag&q;:true,&q;supportLivePk&q;:true},{&q;id&q;:11003467,&q;kePrefix&q;:&q;sydw&q;,&q;courseId&q;:6,&q;status&q;:3,&q;playStatus&q;:3,&q;type&q;:33,&q;recordingType&q;:0,&q;mediaType&q;:0,&q;title&q;:&q;【判断】精选好题 沉浸刷题&q;,&q;innerTitle&q;:&q;&q;,&q;startTime&q;:1760248800000,&q;endTime&q;:1760256000000,&q;teacher&q;:{&q;id&q;:16991,&q;userId&q;:46502384,&q;name&q;:&q;岑红&q;,&q;brief&q;:&q;粉笔优质讲师&q;,&q;desc&q;:&q;粉笔优质教师\n       6年教学授课经验，具有判断科目丰富的实践经验及系统扎实的专业理论知识，参与笔试判断科目模拟题命制和解析审核且多次参加粉笔授课研讨会议，全面了解事业单位判断类题型的命题规律及答题技巧。善于将知识点简单化、条理化和趣味化以激发学生的学习热情，同时授课逻辑性强，思维严谨，能够意识到学生在知识点上的问题并给予相应的指导，深受广大学员的认可和好评。&q;,&q;avatar&q;:&q;19854eea5710183.jpg&q;,&q;upperBodyPhoto&q;:null,&q;displayCoursePrefix&q;:&q;sydw&q;,&q;teacherStat&q;:{&q;teacherId&q;:16991,&q;episodeCount&q;:496,&q;scoreCount&q;:2569,&q;avgScore&q;:9.792915531335142,&q;fiveGradeAvgScore&q;:4.9,&q;updateTime&q;:1773604268370},&q;auditionEpisode&q;:{&q;episodeTitle&q;:&q;个人展示课&q;,&q;episodeVideoUrl&q;:&q;https://vod.fbstatic.cn/22e9ceb2vodbj1251001446/10d5dbb55145403709539499496/emXm1Ym9kfIA.mp4?t=f2a4b300&a;us=4070880000&a;sign=fc844b010265e86e6742934e4dffdd3c&q;},&q;memberOfCPC&q;:false,&q;tags&q;:null},&q;teachChannel&q;:1,&q;offline&q;:null,&q;duration&q;:7697,&q;hasAudition&q;:false,&q;bizType&q;:0,&q;bizId&q;:&q;726825&q;,&q;supportReplay&q;:true,&q;extraInfo&q;:null,&q;liveConfig&q;:{&q;episodeId&q;:11003467,&q;supportMultiGroup&q;:false,&q;exerciseBizType&q;:0,&q;videoDisplayType&q;:0,&q;avForwardType&q;:0,&q;useIntelligentRoom&q;:false,&q;hasStrokeKeynote&q;:true,&q;verticalModeType&q;:0,&q;originEpisodeId&q;:0,&q;supportRtmp&q;:false,&q;supportPk&q;:true,&q;supportLuckyBag&q;:true,&q;supportUserNoteStroke&q;:false,&q;communicateType&q;:0,&q;one2One&q;:false,&q;fakeLive&q;:false},&q;validStatus&q;:1,&q;supportLive&q;:true,&q;supportAiCatalog&q;:false,&q;hasIntelligentPen&q;:false,&q;useLocalRecording&q;:false,&q;useIntelligentRoom&q;:false,&q;hasSalePosition&q;:false,&q;hasEpisodeCards&q;:true,&q;lockedForShouna&q;:false,&q;needSignIn&q;:false,&q;needTeacherSignIn&q;:false,&q;enablePadPencil&q;:true,&q;displayExercise&q;:false,&q;supportLuckyBag&q;:true,&q;supportLivePk&q;:true},{&q;id&q;:11093141,&q;kePrefix&q;:&q;sydw&q;,&q;courseId&q;:6,&q;status&q;:3,&q;playStatus&q;:3,&q;type&q;:33,&q;recordingType&q;:0,&q;mediaType&q;:0,&q;title&q;:&q;【言语】精选好题 沉浸刷题&q;,&q;innerTitle&q;:&q;&q;,&q;startTime&q;:1760320800000,&q;endTime&q;:1760328000000,&q;teacher&q;:{&q;id&q;:35776,&q;userId&q;:83534698,&q;name&q;:&q;魏兰婷&q;,&q;brief&q;:&q;粉笔优质讲师&q;,&q;desc&q;:&q;粉笔优质讲师\n拥有7年一线教学授课经验，毕业于双一流院校。深耕言语理解与表达科目，对国考及各省考情有精准把握。具有言语科目丰富的实践经验及系统扎实的专业理论知识。\n①多次参与粉笔授课研讨与教研活动，持续更新教学理论与方法；\n②承担线上公开课及线上直播课等工作，累计全国授课超万人次，学员评分长期稳定在4.9分以上；\n③曾2次在粉笔“师资风采大赛”中入围并获奖，教学能力获得内部认可。\n授课风格耐心细致，善于将复杂的知识点转化为通俗易懂的讲解，营造轻松积极的学习氛围。其高效的解题方法与亲切的指导深受学员好评，是学员信赖的良师。&q;,&q;avatar&q;:&q;1984fca9fbd6325.jpg&q;,&q;upperBodyPhoto&q;:null,&q;displayCoursePrefix&q;:&q;sydw&q;,&q;teacherStat&q;:{&q;teacherId&q;:35776,&q;episodeCount&q;:610,&q;scoreCount&q;:4222,&q;avgScore&q;:9.801989578398866,&q;fiveGradeAvgScore&q;:4.9,&q;updateTime&q;:1773576447340},&q;auditionEpisode&q;:{&q;episodeTitle&q;:&q;个人展示课&q;,&q;episodeVideoUrl&q;:&q;https://vod.fbstatic.cn/22e9ceb2vodbj1251001446/bcb7f84d5145403709538179593/LKKkDheS6YsA.mp4?t=f2a4b300&a;us=4070880000&a;sign=ade5c614ffe4fa0bcf0395aa689081c8&q;},&q;memberOfCPC&q;:false,&q;tags&q;:null},&q;teachChannel&q;:1,&q;offline&q;:null,&q;duration&q;:7483,&q;hasAudition&q;:false,&q;bizType&q;:0,&q;bizId&q;:&q;726825&q;,&q;supportReplay&q;:true,&q;extraInfo&q;:null,&q;liveConfig&q;:{&q;episodeId&q;:11093141,&q;supportMultiGroup&q;:false,&q;exerciseBizType&q;:0,&q;videoDisplayType&q;:0,&q;avForwardType&q;:0,&q;useIntelligentRoom&q;:false,&q;hasStrokeKeynote&q;:true,&q;verticalModeType&q;:0,&q;originEpisodeId&q;:0,&q;supportRtmp&q;:false,&q;supportPk&q;:true,&q;supportLuckyBag&q;:true,&q;supportUserNoteStroke&q;:false,&q;communicateType&q;:0,&q;one2One&q;:false,&q;fakeLive&q;:false},&q;validStatus&q;:1,&q;supportLive&q;:true,&q;supportAiCatalog&q;:false,&q;hasIntelligentPen&q;:false,&q;useLocalRecording&q;:false,&q;useIntelligentRoom&q;:false,&q;hasSalePosition&q;:false,&q;hasEpisodeCards&q;:true,&q;lockedForShouna&q;:false,&q;needSignIn&q;:false,&q;needTeacherSignIn&q;:false,&q;enablePadPencil&q;:true,&q;displayExercise&q;:false,&q;supportLuckyBag&q;:true,&q;supportLivePk&q;:true},{&q;id&q;:11093143,&q;kePrefix&q;:&q;sydw&q;,&q;courseId&q;:6,&q;status&q;:3,&q;playStatus&q;:3,&q;type&q;:33,&q;recordingType&q;:0,&q;mediaType&q;:0,&q;title&q;:&q;【综应】精选好题 沉浸刷题&q;,&q;innerTitle&q;:&q;&q;,&q;startTime&q;:1760328000000,&q;endTime&q;:1760335200000,&q;teacher&q;:{&q;id&q;:15514,&q;userId&q;:63317913,&q;name&q;:&q;唐邦杰&q;,&q;brief&q;:&q;粉笔优质讲师&q;,&q;desc&q;:&q;粉笔优质教师\n6年一线教学授课经验，线上累计授课超1000+小时，授课人数2500+，始终教研结合，紧跟命题走向，强调知识更新。善于讲解联考A、江苏、浙江、山东、广东各省综应课程，对于综应解题技巧有独到的见解，并参与综应各大题型人工批改服务上千份，能够多方面把握学员需求，精准定位学员薄弱点。全面了解事业单位综合应用能力考试的命题规律及答题技巧，授课经验丰富，逻辑清晰，思维严谨，擅长总结，深受广大学员的认可和好评，在学员中具有非常好的口碑，是值得信赖的好导师。&q;,&q;avatar&q;:&q;198411427ad51c5.jpg&q;,&q;upperBodyPhoto&q;:null,&q;displayCoursePrefix&q;:&q;sydw&q;,&q;teacherStat&q;:{&q;teacherId&q;:15514,&q;episodeCount&q;:512,&q;scoreCount&q;:787,&q;avgScore&q;:9.9135959339263,&q;fiveGradeAvgScore&q;:4.96,&q;updateTime&q;:1772548329533},&q;auditionEpisode&q;:{&q;episodeTitle&q;:&q;个人展示课&q;,&q;episodeVideoUrl&q;:&q;https://vod.fbstatic.cn/22e9ceb2vodbj1251001446/5402b0855145403709207407994/antnJrlNvLMA.mp4?t=f2a4b300&a;us=4070880000&a;sign=cd84b92e364976b35f69adb6cf6cd1b7&q;},&q;memberOfCPC&q;:false,&q;tags&q;:null},&q;teachChannel&q;:1,&q;offline&q;:null,&q;duration&q;:7755,&q;hasAudition&q;:false,&q;bizType&q;:0,&q;bizId&q;:&q;726825&q;,&q;supportReplay&q;:true,&q;extraInfo&q;:null,&q;liveConfig&q;:{&q;episodeId&q;:11093143,&q;supportMultiGroup&q;:false,&q;exerciseBizType&q;:0,&q;videoDisplayType&q;:0,&q;avForwardType&q;:0,&q;useIntelligentRoom&q;:false,&q;hasStrokeKeynote&q;:true,&q;verticalModeType&q;:0,&q;originEpisodeId&q;:0,&q;supportRtmp&q;:false,&q;supportPk&q;:true,&q;supportLuckyBag&q;:true,&q;supportUserNoteStroke&q;:false,&q;communicateType&q;:0,&q;one2One&q;:false,&q;fakeLive&q;:false},&q;validStatus&q;:1,&q;supportLive&q;:true,&q;supportAiCatalog&q;:false,&q;hasIntelligentPen&q;:false,&q;useLocalRecording&q;:false,&q;useIntelligentRoom&q;:false,&q;hasSalePosition&q;:false,&q;hasEpisodeCards&q;:true,&q;lockedForShouna&q;:false,&q;needSignIn&q;:false,&q;needTeacherSignIn&q;:false,&q;enablePadPencil&q;:true,&q;displayExercise&q;:false,&q;supportLuckyBag&q;:true,&q;supportLivePk&q;:true},{&q;id&q;:11093145,&q;kePrefix&q;:&q;sydw&q;,&q;courseId&q;:6,&q;status&q;:3,&q;playStatus&q;:3,&q;type&q;:33,&q;recordingType&q;:0,&q;mediaType&q;:0,&q;title&q;:&q;【公基法律】精选好题 沉浸刷题&q;,&q;innerTitle&q;:&q;&q;,&q;startTime&q;:1760335200000,&q;endTime&q;:1760342400000,&q;teacher&q;:{&q;id&q;:16813,&q;userId&q;:50366016,&q;name&q;:&q;张煦昕&q;,&q;brief&q;:&q;粉笔优质讲师&q;,&q;desc&q;:&q;粉笔优质教师。\n投身教育事业6年，拥有扎实一线教学经验，对于面试内容有自己独到的见解。\n擅长运用结构化面试、情景模拟等多种方法，全面、客观地评估考生的逻辑思维、问题解决、沟通协调及抗压能力。\n授课评分累计达4.9分，授课耐心细致、严谨，循循善诱，熟悉考场答题技巧，能帮助学员理清答题思路；讲解题目逻辑性强条分缕析，善于总结方法技巧；课堂互动性强，善于通过点评帮助学生找到问题，激发学员学习热情，受到学员欢迎。&q;,&q;avatar&q;:&q;176a72cb2c6d8c4.jpg&q;,&q;upperBodyPhoto&q;:null,&q;displayCoursePrefix&q;:&q;sydw&q;,&q;teacherStat&q;:{&q;teacherId&q;:16813,&q;episodeCount&q;:466,&q;scoreCount&q;:1061,&q;avgScore&q;:9.796418473138555,&q;fiveGradeAvgScore&q;:4.9,&q;updateTime&q;:1773396064102},&q;auditionEpisode&q;:{&q;episodeTitle&q;:&q;个人展示课&q;,&q;episodeVideoUrl&q;:&q;https://vod.fbstatic.cn/22e9ceb2vodbj1251001446/3350025c5145403709543612633/AuAZazr4H98A.mp4?t=f2a4b300&a;us=4070880000&a;sign=d862836cd36bd5e4b2977a502173f189&q;},&q;memberOfCPC&q;:false,&q;tags&q;:null},&q;teachChannel&q;:1,&q;offline&q;:null,&q;duration&q;:7292,&q;hasAudition&q;:false,&q;bizType&q;:0,&q;bizId&q;:&q;726825&q;,&q;supportReplay&q;:true,&q;extraInfo&q;:null,&q;liveConfig&q;:{&q;episodeId&q;:11093145,&q;supportMultiGroup&q;:false,&q;exerciseBizType&q;:0,&q;videoDisplayType&q;:0,&q;avForwardType&q;:0,&q;useIntelligentRoom&q;:false,&q;hasStrokeKeynote&q;:true,&q;verticalModeType&q;:0,&q;originEpisodeId&q;:0,&q;supportRtmp&q;:false,&q;supportPk&q;:true,&q;supportLuckyBag&q;:true,&q;supportUserNoteStroke&q;:false,&q;communicateType&q;:0,&q;one2One&q;:false,&q;fakeLive&q;:false},&q;validStatus&q;:1,&q;supportLive&q;:true,&q;supportAiCatalog&q;:false,&q;hasIntelligentPen&q;:false,&q;useLocalRecording&q;:false,&q;useIntelligentRoom&q;:false,&q;hasSalePosition&q;:false,&q;hasEpisodeCards&q;:true,&q;lockedForShouna&q;:false,&q;needSignIn&q;:false,&q;needTeacherSignIn&q;:false,&q;enablePadPencil&q;:true,&q;displayExercise&q;:false,&q;supportLuckyBag&q;:true,&q;supportLivePk&q;:true},