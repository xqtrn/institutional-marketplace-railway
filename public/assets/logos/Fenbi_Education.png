q;:false,&q;useLocalRecording&q;:false,&q;useIntelligentRoom&q;:false,&q;hasSalePosition&q;:false,&q;hasEpisodeCards&q;:true,&q;lockedForShouna&q;:false,&q;needSignIn&q;:false,&q;needTeacherSignIn&q;:false,&q;enablePadPencil&q;:true,&q;displayExercise&q;:false,&q;supportLuckyBag&q;:true,&q;supportLivePk&q;:true},{&q;id&q;:9969913,&q;kePrefix&q;:&q;sydw&q;,&q;courseId&q;:6,&q;status&q;:3,&q;playStatus&q;:3,&q;type&q;:33,&q;recordingType&q;:0,&q;mediaType&q;:0,&q;title&q;:&q;【言语】精选好题 沉浸刷题&q;,&q;innerTitle&q;:&q;&q;,&q;startTime&q;:1737007200000,&q;endTime&q;:1737014400000,&q;teacher&q;:{&q;id&q;:16555,&q;userId&q;:73245747,&q;name&q;:&q;周俐&q;,&q;brief&q;:&q;粉笔优质讲师&q;,&q;desc&q;:&q;粉笔优质讲师\n五年半一线教学授课及带班经验，深耕事业单位言语考试，承担过安徽、四川、江苏、浙江、陕西、福建、河北、湖北、内蒙等地以及全国联考、军队文职等线上笔试精品班、刷题班、冲刺班等多种班型，累计带班级数60+授课及带班经验丰富。在言语理解与表达科目教研工作中，多次参与真题解析的撰写、解析的终审工作、模拟题命制、单题录制以及言语考情分析文件撰写等工作，面了解事业单位言语考试近年来命题规律、重难点及不同类型题目答题技巧，教研教学基础扎实。授课条理清晰，考点突出，注重理论知识点与技巧并用，经验丰富，亲和生动，学员好评度高。&q;,&q;avatar&q;:&q;198551c014a41f3.jpg&q;,&q;upperBodyPhoto&q;:null,&q;displayCoursePrefix&q;:&q;sydw&q;,&q;teacherStat&q;:{&q;teacherId&q;:16555,&q;episodeCount&q;:530,&q;scoreCount&q;:2177,&q;avgScore&q;:9.700505282498847,&q;fiveGradeAvgScore&q;:4.85,&q;updateTime&q;:1773613829705},&q;auditionEpisode&q;:{&q;episodeTitle&q;:&q;个人展示课&q;,&q;episodeVideoUrl&q;:&q;https://vod.fbstatic.cn/22e9ceb2vodbj1251001446/db6f1af21253642695732607997/uneyCgdRfuQA.mp4?t=f2a4b300&a;us=4070880000&a;sign=62a7a37a62d4578410dcec90c07ea1ce&q;},&q;memberOfCPC&q;:false,&q;tags&q;:null},&q;teachChannel&q;:1,&q;offline&q;:null,&q;duration&q;:7231,&q;hasAudition&q;:false,&q;bizType&q;:0,&q;bizId&q;:&q;726825&q;,&q;supportReplay&q;:true,&q;extraInfo&q;:null,&q;liveConfig&q;:{&q;episodeId&q;:9969913,&q;supportMultiGroup&q;:false,&q;exerciseBizType&q;:0,&q;videoDisplayType&q;:0,&q;avForwardType&q;:0,&q;useIntelligentRoom&q;:false,&q;hasStrokeKeynote&q;:true,&q;verticalModeType&q;:0,&q;originEpisodeId&q;:0,&q;supportRtmp&q;:false,&q;supportPk&q;:true,&q;supportLuckyBag&q;:true,&q;supportUserNoteStroke&q;:false,&q;communicateType&q;:0,&q;one2One&q;:false,&q;fakeLive&q;:false},&q;validStatus&q;:1,&q;supportLive&q;:true,&q;supportAiCatalog&q;:false,&q;hasIntelligentPen&q;:false,&q;useLocalRecording&q;:false,&q;useIntelligentRoom&q;:false,&q;hasSalePosition&q;:false,&q;hasEpisodeCards&q;:true,&q;lockedForShouna&q;:false,&q;needSignIn&q;:false,&q;needTeacherSignIn&q;:false,&q;enablePadPencil&q;:true,&q;displayExercise&q;:false,&q;supportLuckyBag&q;:true,&q;supportLivePk&q;:true},{&q;id&q;:9969941,&q;kePrefix&q;:&q;sydw&q;,&q;courseId&q;:6,&q;status&q;:3,&q;playStatus&q;:3,&q;type&q;:33,&q;recordingType&q;:0,&q;mediaType&q;:0,&q;title&q;:&q;【公基非法】精选好题 沉浸刷题&q;,&q;innerTitle&q;:&q;&q;,&q;startTime&q;:1737014400000,&q;endTime&q;:1737021600000,&q;teacher&q;:{&q;id&q;:34183,&q;userId&q;:83886596,&q;name&q;:&q;赵佳佳&q;,&q;brief&q;:&q;粉笔优质讲师&q;,&q;desc&q;:&q;粉笔常识公基优质讲师\n6年一线教学经验，深耕事业单位考试，承担过笔试精品班、刷题班等多种班型，授课和实战经验丰富。\n\n曾参与真题教研解析工作，教研文章撰写工作，模拟题的教研工作，对最新命题趋势方向有深入研究;\n多次参加粉笔授课研讨会议，注重考场思维，针对学生困惑研究教学策略，深入研讨事考命题趋势及最新考情，注重自我提升，积累丰富笔试理论知识;\n累计授课超1400小时，累计评分达4.9分，善于把握学员个性化特点，因材施教，认真负责，真诚对待每一位学员。讲课生动形象，有代入感，学员可以在轻松愉快的氛围中学习，跟着老师节奏主动思考，学习知识，掌握知识。&q;,&q;avatar&q;:&q;1983ba750d61d0b.jpg&q;,&q;upperBodyPhoto&q;:null,&q;displayCoursePrefix&q;:&q;sydw&q;,&q;teacherStat&q;:{&q;teacherId&q;:34183,&q;episodeCount&q;:689,&q;scoreCount&q;:1641,&q;avgScore&q;:9.802559414990869,&q;fiveGradeAvgScore&q;:4.9,&q;updateTime&q;:1771456495223},&q;auditionEpisode&q;:null,&q;memberOfCPC&q;:false,&q;tags&q;:null},&q;teachChannel&q;:1,&q;offline&q;:null,&q;duration&q;:8453,&q;hasAudition&q;:false,&q;bizType&q;:0,&q;bizId&q;:&q;726825&q;,&q;supportReplay&q;:true,&q;extraInfo&q;:null,&q;liveConfig&q;:{&q;episodeId&q;:9969941,&q;supportMultiGroup&q;:false,&q;exerciseBizType&q;:0,&q;videoDisplayType&q;:0,&q;avForwardType&q;:0,&q;useIntelligentRoom&q;:false,&q;hasStrokeKeynote&q;:true,&q;verticalModeType&q;:0,&q;originEpisodeId&q;:0,&q;supportRtmp&q;:false,&q;supportPk&q;:true