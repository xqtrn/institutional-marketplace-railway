;fiveGradeAvgScore&q;:4.87,&q;updateTime&q;:1773582489052},&q;auditionEpisode&q;:{&q;episodeTitle&q;:&q;个人展示课&q;,&q;episodeVideoUrl&q;:&q;https://vod.fbstatic.cn/22e9ceb2vodbj1251001446/71e3e6f01397757888015316660/Ot6GS9zAJqIA.mp4?t=f2a4b300&a;us=4070880000&a;sign=c773fc7f8cdd4f955379e6633bd2508a&q;},&q;memberOfCPC&q;:false,&q;tags&q;:null},&q;teachChannel&q;:1,&q;offline&q;:null,&q;duration&q;:7475,&q;hasAudition&q;:false,&q;bizType&q;:0,&q;bizId&q;:&q;726825&q;,&q;supportReplay&q;:true,&q;extraInfo&q;:null,&q;liveConfig&q;:{&q;episodeId&q;:10795571,&q;supportMultiGroup&q;:false,&q;exerciseBizType&q;:0,&q;videoDisplayType&q;:0,&q;avForwardType&q;:0,&q;useIntelligentRoom&q;:false,&q;hasStrokeKeynote&q;:true,&q;verticalModeType&q;:0,&q;originEpisodeId&q;:0,&q;supportRtmp&q;:false,&q;supportPk&q;:true,&q;supportLuckyBag&q;:true,&q;supportUserNoteStroke&q;:false,&q;communicateType&q;:0,&q;one2One&q;:false,&q;fakeLive&q;:false},&q;validStatus&q;:1,&q;supportLive&q;:true,&q;supportAiCatalog&q;:false,&q;hasIntelligentPen&q;:false,&q;useLocalRecording&q;:false,&q;useIntelligentRoom&q;:false,&q;hasSalePosition&q;:false,&q;hasEpisodeCards&q;:true,&q;lockedForShouna&q;:false,&q;needSignIn&q;:false,&q;needTeacherSignIn&q;:false,&q;enablePadPencil&q;:true,&q;displayExercise&q;:false,&q;supportLuckyBag&q;:true,&q;supportLivePk&q;:true},{&q;id&q;:10795572,&q;kePrefix&q;:&q;sydw&q;,&q;courseId&q;:6,&q;status&q;:3,&q;playStatus&q;:3,&q;type&q;:33,&q;recordingType&q;:0,&q;mediaType&q;:0,&q;title&q;:&q;【数资】精选好题 沉浸刷题&q;,&q;innerTitle&q;:&q;&q;,&q;startTime&q;:1750996800000,&q;endTime&q;:1751004000000,&q;teacher&q;:{&q;id&q;:16592,&q;userId&q;:62613300,&q;name&q;:&q;顾红阳&q;,&q;brief&q;:&q;粉笔优质讲师&q;,&q;desc&q;:&q;粉笔优质讲师\n七年一线教学授课经验,深耕公务员考试、事业单位考试，承担过线下笔试精品班、刷题班等多种班型，授课经验丰富。\n累计授课超1500小时，累计评分达4.9分。\n多次参与模拟题、题目解析等教研工作。对于出题形式有丰富了解。\n授课严谨认真，心思细腻，善于倾听学员的学习诉求，并及时回应。讲课细致耐心，课堂氛围轻松活跃，学员可以获得良好的学习体验，老师理论基础扎实，能够帮助学员将所学理论更好应用在实际做题中。&q;,&q;avatar&q;:&q;1983b9d837c33ee.jpg&q;,&q;upperBodyPhoto&q;:null,