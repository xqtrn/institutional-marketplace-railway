lse,&q;communicateType&q;:0,&q;one2One&q;:false,&q;fakeLive&q;:false},&q;validStatus&q;:1,&q;supportLive&q;:true,&q;supportAiCatalog&q;:false,&q;hasIntelligentPen&q;:false,&q;useLocalRecording&q;:false,&q;useIntelligentRoom&q;:false,&q;hasSalePosition&q;:false,&q;hasEpisodeCards&q;:true,&q;lockedForShouna&q;:false,&q;needSignIn&q;:false,&q;needTeacherSignIn&q;:false,&q;enablePadPencil&q;:true,&q;displayExercise&q;:false,&q;supportLuckyBag&q;:true,&q;supportLivePk&q;:true},{&q;id&q;:9969463,&q;kePrefix&q;:&q;sydw&q;,&q;courseId&q;:6,&q;status&q;:3,&q;playStatus&q;:3,&q;type&q;:33,&q;recordingType&q;:0,&q;mediaType&q;:0,&q;title&q;:&q;【言语】精选好题 沉浸刷题&q;,&q;innerTitle&q;:&q;&q;,&q;startTime&q;:1735977600000,&q;endTime&q;:1735984800000,&q;teacher&q;:{&q;id&q;:14565,&q;userId&q;:48370970,&q;name&q;:&q;王清悦&q;,&q;brief&q;:&q;粉笔优质讲师&q;,&q;desc&q;:&q;粉笔优质讲师\n8年一线教学经验，教学风格严谨而不失活泼，善于将复杂的知识点以生动有趣的方式呈现，让学生轻松掌握。对于考试考点有着敏锐的洞察力和精准的把握能力，帮助学生有效备考，事半功倍。我坚信，教育不仅仅是知识的传授，更是思维的启迪与人格的塑造，因此，始终致力于培养学生的独立思考能力与解决问题的能力，助力他们在人生的每一个阶段都能自信前行。&q;,&q;avatar&q;:&q;173d720cea24b6c.jpg&q;,&q;upperBodyPhoto&q;:null,&q;displayCoursePrefix&q;:&q;sydw&q;,&q;teacherStat&q;:{&q;teacherId&q;:14565,&q;episodeCount&q;:477,&q;scoreCount&q;:1439,&q;avgScore&q;:9.745656706045871,&q;fiveGradeAvgScore&q;:4.87,&q;updateTime&q;:1773559873082},&q;auditionEpisode&q;:{&q;episodeTitle&q;:&q;个人展示课&q;,&q;episodeVideoUrl&q;:&q;https://vod.fbstatic.cn/22e9ceb2vodbj1251001446/cbd1293d5145403707742801437/WSGdVtt1L3AA.mp4?t=f2a4b300&a;us=4070880000&a;sign=a446564dcadd70a9b99e6d27e1f0ecde&q;},&q;memberOfCPC&q;:false,&q;tags&q;:null},&q;teachChannel&q;:1,&q;offline&q;:null,&q;duration&q;:7244,&q;hasAudition&q;:false,&q;bizType&q;:0,&q;bizId&q;:&q;726825&q;,&q;supportReplay&q;:true,&q;extraInfo&q;:null,&q;liveConfig&q;:{&q;episodeId&q;:9969463,&q;supportMultiGroup&q;:false,&q;exerciseBizType&q;:0,&q;videoDisplayType&q;:0,&q;avForwardType&q;:0,&q;useIntelligentRoom&q;:false,&q;hasStrokeKeynote&q;:true,&q;verticalModeType&q;:0,&q;origi