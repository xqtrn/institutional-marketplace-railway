UserNoteStroke&q;:false,&q;communicateType&q;:0,&q;one2One&q;:false,&q;fakeLive&q;:false},&q;validStatus&q;:1,&q;supportLive&q;:true,&q;supportAiCatalog&q;:false,&q;hasIntelligentPen&q;:false,&q;useLocalRecording&q;:false,&q;useIntelligentRoom&q;:false,&q;hasSalePosition&q;:false,&q;hasEpisodeCards&q;:true,&q;lockedForShouna&q;:false,&q;needSignIn&q;:false,&q;needTeacherSignIn&q;:false,&q;enablePadPencil&q;:true,&q;displayExercise&q;:false,&q;supportLuckyBag&q;:true,&q;supportLivePk&q;:true},{&q;id&q;:10787709,&q;kePrefix&q;:&q;sydw&q;,&q;courseId&q;:6,&q;status&q;:3,&q;playStatus&q;:3,&q;type&q;:33,&q;recordingType&q;:0,&q;mediaType&q;:0,&q;title&q;:&q;【综应】精选好题 沉浸刷题&q;,&q;innerTitle&q;:&q;&q;,&q;startTime&q;:1749621600000,&q;endTime&q;:1749628800000,&q;teacher&q;:{&q;id&q;:16833,&q;userId&q;:57723890,&q;name&q;:&q;李珍芳&q;,&q;brief&q;:&q;粉笔优质讲师&q;,&q;desc&q;:&q;粉笔优质教师\n7年以上公考教学经验，授课经验丰富，线上累计授课时长1000+，授课人次3000+，授课累计评分4.9。多次参与全国事业单位综应考情以及热点梳理，熟悉事业单位联考综应ABC考情、命题特点和答题技巧。擅长联考、山东、江苏、浙江等地事业单位以及三支一扶的综应课程，并参与综应各大题型人工批改服务上千份，了解学员作答综应的难点、痛点，能精准定位学员薄弱点，对综应有独到的见解。授课思路清晰，逻辑严谨，操作性强，擅长因材施教，在学员中具有非常好的口碑，是值得信赖的好老师。&q;,&q;avatar&q;:&q;19841215f64df6f.jpg&q;,&q;upperBodyPhoto&q;:null,&q;displayCoursePrefix&q;:&q;sydw&q;,&q;teacherStat&q;:{&q;teacherId&q;:16833,&q;episodeCount&q;:409,&q;scoreCount&q;:405,&q;avgScore&q;:9.841975308641969,&q;fiveGradeAvgScore&q;:4.92,&q;updateTime&q;:1773052091382},&q;auditionEpisode&q;:{&q;episodeTitle&q;:&q;个人展示课&q;,&q;episodeVideoUrl&q;:&q;https://vod.fbstatic.cn/22e9ceb2vodbj1251001446/7a0a71cb5145403709466476960/iuy2CLkvs8gA.mp4?t=f2a4b300&a;us=4070880000&a;sign=9b6fa00b91c85f610da0b5f435be8997&q;},&q;memberOfCPC&q;:false,&q;tags&q;:null},&q;teachChannel&q;:1,&q;offline&q;:null,&q;duration&q;:6647,&q;hasAudition&q;:false,&q;bizType&q;:0,&q;bizId&q;:&q;726825&q;,&q;supportReplay&q;:true,&q;extraInfo&q;:null,&q;liveConfig&q;:{&q;episodeId&q;:10787709,&q;supportMultiGroup&q;:false,&q;exerciseBizType&q;:0,&q;videoDisplayType&q;:0,&q;avForwardType&q;:0,&q;