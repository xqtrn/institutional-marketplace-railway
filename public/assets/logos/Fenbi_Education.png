:1,&q;supportLive&q;:true,&q;supportAiCatalog&q;:true,&q;hasIntelligentPen&q;:false,&q;useLocalRecording&q;:false,&q;useIntelligentRoom&q;:false,&q;hasSalePosition&q;:false,&q;hasEpisodeCards&q;:false,&q;lockedForShouna&q;:false,&q;needSignIn&q;:false,&q;needTeacherSignIn&q;:false,&q;enablePadPencil&q;:true,&q;displayExercise&q;:false,&q;supportLuckyBag&q;:false,&q;supportLivePk&q;:false},{&q;id&q;:11360211,&q;kePrefix&q;:&q;gwy&q;,&q;courseId&q;:1,&q;status&q;:3,&q;playStatus&q;:3,&q;type&q;:1,&q;recordingType&q;:0,&q;mediaType&q;:0,&q;title&q;:&q;数资-【2026上半年省考第1季】行测模考大赛&q;,&q;innerTitle&q;:&q;&q;,&q;startTime&q;:1765105200000,&q;endTime&q;:1765116000000,&q;teacher&q;:{&q;id&q;:6261,&q;userId&q;:61945679,&q;name&q;:&q;刘大娥&q;,&q;brief&q;:&q;粉笔数资优质教师&q;,&q;desc&q;:&q;粉笔数资优质教师，11年公考授课经验，致力于公务员考试研究，对试题有深刻的把握和独到的见解。注重因材施教，善于引导启发思维，让学生能轻松上手，掌握不同类型题目的应试技巧。授课条理清晰，富有激情又不失幽默，课堂氛围活跃，细心，耐心，有责任心，深受学员好评。&q;,&q;avatar&q;:&q;171831baa78157d.png&q;,&q;upperBodyPhoto&q;:null,&q;displayCoursePrefix&q;:&q;gwy&q;,&q;teacherStat&q;:{&q;teacherId&q;:6261,&q;episodeCount&q;:1042,&q;scoreCount&q;:126302,&q;avgScore&q;:9.80605216069421,&q;fiveGradeAvgScore&q;:4.9,&q;updateTime&q;:1773622357767},&q;auditionEpisode&q;:{&q;episodeTitle&q;:&q;个人展示课&q;,&q;episodeVideoUrl&q;:&q;https://vod.fbstatic.cn/22e9ceb2vodbj1251001446/ef0e552f3560136621448692888/BxCPeS7tZkUA.mp4?t=f2a4b300&a;us=4070880000&a;sign=a8a518156c1d39b0052ef2e0c79abc4e&q;},&q;memberOfCPC&q;:false,&q;tags&q;:null},&q;teachChannel&q;:1,&q;offline&q;:null,&q;duration&q;:11715,&q;hasAudition&q;:false,&q;bizType&q;:0,&q;bizId&q;:&q;710082&q;,&q;supportReplay&q;:true,&q;extraInfo&q;:null,&q;liveConfig&q;:{&q;episodeId&q;:11360211,&q;supportMultiGroup&q;:false,&q;exerciseBizType&q;:0,&q;videoDisplayType&q;:0,&q;avForwardType&q;:0,&q;useIntelligentRoom&q;:false,&q;hasStrokeKeynote&q;:true,&q;verticalModeType&q;:0,&q;originEpisodeId&q;:0,&q;supportRtmp&q;:false,&q;supportPk&q;:false,&q;supportLuckyBag&q;:false,&q;supportUserNoteStroke&q;:false,&q;communicateType&q;:0,&q;one2One&q;:false,&q;fakeLive&q;:false},&q;validStatus&q;:1,&q;supportLive&q;:true,&q;supportAiCatalog&q;:true,&q;hasIntelligentPen&q;:false,&q;useLocalRecording&q;:false,&q;useIntelligentRoom&q;:false,&q;hasSalePosition&q;:false,&q;hasEpisodeCards&q;:false,&q;lockedForShouna&q;:false,&q;needSignIn&q;:false,&q;needTeacherSignIn&q;:false,&q;enablePadPencil&q;:true,&q;displayExercise&q;:false,&q;supportLuckyBag&q;:false,&q;supportLivePk&q;:false},{&q;id&q;:11360222,&q;kePrefix&q;:&q;gwy&q;,&q;courseId&q;:1,&q;status&q;:3,&q;playStatus&q;:3,&q;type&q;:1,&q;recordingType&q;:0,&q;mediaType&q;:0,&q;title&q;:&q;判断-【2026上半年省考第1季】行测模考大赛&q;,&q;innerTitle&q;:&q;&q;,&q;startTime&q;:1765105200000,&q;endTime&q;:1765116000000,&q;teacher&q;:{&q;id&q;:15984,&q;userId&q;:66492815,&q;name&q;:&q;李宏&q;,&q;brief&q;:&q;粉笔判断优质教师&q;,&q;desc&q;:&q;粉笔判断优质教师，中国农业大学硕士毕业。 \n已在公考行业深耕5年，累计授课时长超4000小时，直接培训学员逾10万人次。长期专注于公务员考试命题规律研究，对判断推理模块的解题逻辑与应试技巧有独到的理解，擅长将抽象逻辑具象化，复杂考点条理化。注重因材施教，课堂呈现脉络清晰，语言生动风趣，解题技巧实用易掌握，学员提分效果显著。 \n作为核心教研成员连续多年参与粉笔题库建设，参与编撰《决战行测5000题》、《行测思维》等图书。&q;,&q;avatar&q;:&q;1774c009210598e.jpg&q;,&q;upperBodyPhoto&q;:null,&q;displayCoursePrefix&q;:&q;gwy&q;,&q;teacherStat&q;:{&q;teacherId&q;:15984,&q;episodeCount&q;:1062,&q;scoreCount&q;:72125,&q;avgScore&q;:9.857830155979219,&q;fiveGradeAvgScore&q;:4.93,&q;updateTime&q;:1773622748783},&q;auditionEpisode&q;:{&q;episodeTitle&q;:&q;个人展示课&q;,&q;episodeVideoUrl&q;:&q;https://vod.fbstatic.cn/22e9ceb2vodbj1251001446/4bb439203560136621446284860/xtBZqkpEykYA.mp4?t=f2a4b300&a;us=4070880000&a;sign=fd8fe2f310790fadd1c5df5f9c647383&q;},&q;memberOfCPC&q;:false,&q;tags&q;:null},&q;teachChannel&q;:1,&q;offline&q;:null,&q;duration&q;:12945,&q;hasAudition&q;:false,&q;bizType&q;:0,&q;bizId&q;:&q;710082&q;,&q;supportReplay&q;:true,&q;extraInfo&q;:null,&q;liveConfig&q;:{&q;episodeId&q;:11360222,&q;supportMultiGroup&q;:false,&q;exerciseBizType&q;:0,&q;videoDisplayType&q;:0,&q;avForwardType&q;:0,&q;useIntelligentRoom&q;:false,&q;h