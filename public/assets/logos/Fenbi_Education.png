d&q;:10790020,&q;supportMultiGroup&q;:false,&q;exerciseBizType&q;:0,&q;videoDisplayType&q;:0,&q;avForwardType&q;:0,&q;useIntelligentRoom&q;:false,&q;hasStrokeKeynote&q;:true,&q;verticalModeType&q;:0,&q;originEpisodeId&q;:0,&q;supportRtmp&q;:false,&q;supportPk&q;:true,&q;supportLuckyBag&q;:true,&q;supportUserNoteStroke&q;:false,&q;communicateType&q;:0,&q;one2One&q;:false,&q;fakeLive&q;:false},&q;validStatus&q;:1,&q;supportLive&q;:true,&q;supportAiCatalog&q;:false,&q;hasIntelligentPen&q;:false,&q;useLocalRecording&q;:false,&q;useIntelligentRoom&q;:false,&q;hasSalePosition&q;:false,&q;hasEpisodeCards&q;:true,&q;lockedForShouna&q;:false,&q;needSignIn&q;:false,&q;needTeacherSignIn&q;:false,&q;enablePadPencil&q;:true,&q;displayExercise&q;:false,&q;supportLuckyBag&q;:true,&q;supportLivePk&q;:true},{&q;id&q;:10790050,&q;kePrefix&q;:&q;sydw&q;,&q;courseId&q;:6,&q;status&q;:3,&q;playStatus&q;:3,&q;type&q;:33,&q;recordingType&q;:0,&q;mediaType&q;:0,&q;title&q;:&q;【言语】精选好题 沉浸刷题&q;,&q;innerTitle&q;:&q;&q;,&q;startTime&q;:1750125600000,&q;endTime&q;:1750132800000,&q;teacher&q;:{&q;id&q;:16736,&q;userId&q;:73894787,&q;name&q;:&q;韩娇&q;,&q;brief&q;:&q;粉笔优质讲师&q;,&q;desc&q;:&q;粉笔优质教师\n具有6年丰富的一线授课经验，累计授课时长已超过6000小时。幽默诙谐、形象生动的教学风格，能让学生在轻松愉快的氛围中掌握复杂的知识点。同时，注重条理清晰的讲解和思维跳跃的启发，帮助学生构建系统的知识框架，激发他们的学习潜能，深受广大学员的认可和好评，是学员值得信赖的优秀教师。&q;,&q;avatar&q;:&q;19bbc3030662940.jpg&q;,&q;upperBodyPhoto&q;:null,&q;displayCoursePrefix&q;:&q;sydw&q;,&q;teacherStat&q;:{&q;teacherId&q;:16736,&q;episodeCount&q;:460,&q;scoreCount&q;:1722,&q;avgScore&q;:9.746806039488957,&q;fiveGradeAvgScore&q;:4.87,&q;updateTime&q;:1772978351208},&q;auditionEpisode&q;:{&q;episodeTitle&q;:&q;个人展示课&q;,&q;episodeVideoUrl&q;:&q;https://vod.fbstatic.cn/22e9ceb2vodbj1251001446/d090d8201253642695654270008/uvSzxpw6mywA.mp4?t=f2a4b300&a;us=4070880000&a;sign=2384d20a3124c2fde9b0c3c9ef89cb4a&q;},&q;memberOfCPC&q;:false,&q;tags&q;:null},&q;teachChannel&q;:1,&q;offline&q;:null,&q;duration&q;:7846,&q;hasAudition&q;:false,&q;bizType&q;:0,&q;bizId&q;:&q;726825&q;,&q;supportReplay&q;:true,&q;extraInfo&q;:null,&q;liveConfig&q;:{&q;episodeId&q;:10790050,&q;supportMultiGroup&q;:false,&q;exerciseBizType&q;:0,&q;videoDisplayType&q;:0,&q;avForwardType&q;:0,&q;useIntelligentRoom&q;:false,&q;hasStrokeKeynote&q;:true,&q;verticalModeType&q;:0,&q;originEpisodeId&q;:0,&q;supportRtmp&q;:false,&q;supportPk&q;:true,&q;supportLuckyBag&q;:true,&q;supportUserNoteStroke&q;:false,&q;communicateType&q;:0,&q;one2One&q;:false,&q;fakeLive&q;:false},&q;validStatus&q;:1,&q;supportLive&q;:true,&q;supportAiCatalog&q;:false,&q;hasIntelligentPen&q;:false,&q;useLocalRecording&q;:false,&q;useIntelligentRoom&q;:false,&q;hasSalePosition&q;:false,&q;hasEpisodeCards&q;:true,&q;lockedForShouna&q;:false,&q;needSignIn&q;:false,&q;needTeacherSignIn&q;:false,&q;enablePadPencil&q;:true,&q;displayExercise&q;:false,&q;supportLuckyBag&q;:true,&q;supportLivePk&q;:true},{&q;id&q;:10829330,&q;kePrefix&q;:&q;sydw&q;,&q;courseId&q;:6,&q;status&q;:3,&q;playStatus&q;:3,&q;type&q;:33,&q;recordingType&q;:0,&q;mediaType&q;:0,&q;title&q;:&q;【公基法律】精选好题 沉浸刷题&q;,&q;innerTitle&q;:&q;&q;,&q;startTime&q;:1750132800000,&q;endTime&q;:1750140000000,&q;teacher&q;:{&q;id&q;:17032,&q;userId&q;:73005297,&q;name&q;:&q;李婕&q;,&q;brief&q;:&q;粉笔优质讲师&q;,&q;desc&q;:&q;粉笔常识公基优质教师\n7年以上一线授课经验，累计授课时长超1000+小时，授课人数超20000+，对常识公基板块理解透彻，曾多次参与命制笔试教研，对民法、刑法等考情有着深入研究，出过近500道优质模拟题，在常识公基教研方面取得不小成果。擅长结合时事热点将晦涩难懂的知识具象化。教学方法也独具匠心深受同学好评，在课堂上经常采用思维导图+口诀记忆法，将繁杂的知识点串联成清晰的知识体系，面对易错易混点也能通过对比分析来加深理解，多年来深受广大学员的认可和五星好评，在学员中具有非常好的口碑，是一位值得信赖的好导师。&q;,&q;avatar&q;:&q;19bc4b46802c805.jpg&q;,&q;upperBodyPhoto&q;:null,&q;displayCoursePrefix&q;:&q;sydw&q;,&q;teacherStat&q;:{&q;teacherId&q;:17032,&q;episodeCount&q;:999,&q;scoreCount&q;:2265,&q;avgScore&q;:9.766887417218552,&q;fiveGradeAvgScore&q;:4.88,&q;updateTime&q;:1773397773324},&q;auditionEpisode&q;:{&q;episodeTitle&q;:&q;个人展示课&q;,&q;episodeVideoUrl&q;:&q;https://vod.fbstatic.cn/22e9ceb2vodbj1251001446/2eda4b7c5145403709227505228/MwwhZdSfiwYA.mp4?t=f2a4b300&a;us=4070880000&a;sign=6b3a5523cd064638f6e21c89c8efeea0&q;},&q;memberOfCPC&q;:false,&q;tags&q;:null},&q;teachChannel&q;:1,&q;offline&q;:null,&q;duration&q;:8012,&q;hasAudition&q;:false,&q;bizType&q;:0,&q;bizId&q;:&q;726825&q;,&q;supportReplay&q;:true,&q;extraInfo&q;:null,&q;liveConfig&q;:{&q;episodeId&q;:10829330,&q;supportMultiGroup&q;:false,&q;exerciseBizType&q;:0,&q;videoDisplayType&q;:0,&q;avForwardType&q;:0,&q;useIntelligentRoom&q;:false,&q;hasStrokeKeynote&q;:true,&q;verticalModeType&q;:0,&q;originEpisodeId&q;:0,&q;supportRtmp&q;:false,&q;supportPk&q;:true,&q;supportLuckyBag&q;:true,&q;supportUserNoteStroke&q;:false,&q;communicateType&q;:0,&q;one2One&q;:false,&q;fakeLive&q;:false},&q;validStatus&q;:1,&q;supportLive&q;:true,&q;supportAiCatalog&q;:false,&q;hasIntelligentPen&q;:false,&q;useLocalRecording&q;:false,&q;useIntelligentRoom&q;:false,&q;hasSalePosition&q;:false,&q;hasEpisodeCards&q;:true,&q;lockedForShouna&q;:false,&q;needSignIn&q;:false,&q;needTeacherSignIn&q;:false,&q;enablePadPencil&q;:true,&q;displayExercise&q;:false,&q;supportLuckyBag&q;:true,&q;supportLivePk&q;:true},{&q;id&q;:10790104,&q;kePrefix&q;:&q;sydw&q;,&q;courseId&q;:6,&q;status&q;:3,&q;playStatus&q;:3,&q;type&q;:33,&q;recordingType&q;:0,&q;mediaType&q;:0,&q;title&q;:&q;【综应】精选好题 沉浸刷题&q;,&q;innerTitle&q;:&q;&q;,&q;startTime&q;:1750140000000,&q;endTime&q;:1750147200000,&q;teacher&q;:{&q;id&q;:32032,&q;userId&q;:81559433,&q;name&q;:&q;陈绮桐&q;,&q;brief&q;:&q;粉笔优质讲师&q;,&q;desc&q;:&q;粉笔优质教师\n五年一线教学经验\n熟练掌握各地区事业单位考情，参与多次教研，撰写多篇事业单位笔试教研材料，在粉笔教师内部进行共享。\n线上累计授课小时1000+，学员评分整体维持4.9，也有线下授课经历，授课经验丰富。课堂氛围轻松愉悦，授课思路清晰，深入浅出讲解如何破解综应难题。通过引导学员思考进而巩固理论基础，理顺解题思路，让学员克服难下笔，不动笔难题，达到提高分数的目的。\n提供多样化的辅导技巧，善于结合学员基础进行针对性辅导，有效解决学员疑惑，曾帮助0基础学员在成功提分20+。\n帮助不少学员成功进面，在过往学员评价中深受好评，是学员值得信赖的老师。&q;,&q;avatar&q;:&q;1983b323cb8eb84.jpg&q;,&q;upperBodyPhoto&q;:null,&q;displayCoursePrefix&q;:&q;sydw&q;,&q;teacherStat&q;:{&q;teacherId&q;:32032,&q;episodeCount&q;:290,&q;scoreCount&q;:409,&q;avgScore&q;:9.877750611246935,&q;fiveGradeAvgScore&q;:4.94,&q;updateTime&q;:1773554942877},&q;auditionEpisode&q;:{&q;episodeTitle&q;:&q;个人展示课&q;,&q;episodeVideoUrl&q;:&q;https://vod.fbstatic.cn/22e9ceb2vodbj1251001446/a9b323de5145403714883224921/TLnAfMW95fwA.mp4?t=f2a4b300&a;us=4070880000&a;sign=966d9114718757bc81c712e4601c4943&q;},&q;memberOfCPC&q;:false,&q;tags&q;:null},&q;teachChannel&q;:1,&q;offline&q;:null,&q;duration&q;:6727,&q;hasAudition&q;:false,&q;bizType&q;:0,&q;bizId&q;:&q;726825&q;,&q;supportReplay&q;:true,&q;extraInfo&q;:null,&q;liveConfig&q;:{&q;episodeId&q;:10790104,&q;supportMultiGroup&q;:false,&q;exerciseBizType&q;:0,&q;videoDisplayType&q;:0,&q;avForwardType&q;:0,&q;useIntelligentRoom&q;:false,&q;hasStrokeKeynote&q;:true,&q;verticalModeType&q;:0,&q;originEpisodeId&q;:0,&q;supportRtmp&q;:false,&q;supportPk&q;:true,&q;supportLuckyBag&q;:true,&q;supportUserNoteStroke&q;:false,&q;communicateType&q;:0,&q;one2One&q;:false,&q;fakeLive&q;:false},&q;validStatus&q;:1,&q;supportLive&q;:true,&q;supportAiCatalog&q;:false,&q;hasIntelligentPen&q;:false,&q;useLocalRecording&q;:false,&q;useIntelligentRoom&q;:false,&q;hasSalePosition&q;:false,&q;hasEpisodeCards&q;:true,&q;lockedForShouna&q;:false,&q;needSignIn&q;:false,&q;needTeacherSignIn&q;:false,&q;enablePadPencil&q;:true,&q;displayExercise&q;:false,&q;supportLuckyBag&q;:true,&q;supportLivePk&q;:true},{&q;id&q;:10790107,&q;kePrefix&q;:&q;sydw&q;,&q;courseId&q;:6,&q;status&q;:3,&q;playStatus&q;:3,&q;type&q;:33,&q;recordingType&q;:0,&q;mediaType&q;:0,&q;title&q;:&q;【数资】精选好题 沉浸刷题&q;,&q;innerTitle&q;:&q;&q;,&q;startTime&q;:1750147200000,&q;endTime&q;:1750154400000,&q;teacher&q;:{&q;id&q;:16574,&q;userId&q;:73028298,&q;name&q;:&q;廖雅云&q;,&q;brief&q;:&q;粉笔优质讲师&q;,&q;desc&q;:&q;粉笔优质讲师\n多年一线教学授课经验，深耕事业单位考试，承担过笔试精品班、刷题班、冲刺班等多种班型,授课经验丰富。\n深入了解职测数资近年来的考情、重难点以及不同考点的解题技巧，理论扎实。\n参与笔试真题教研和解析撰写、终审工作,并多次参与图书以及相关资料的编写，对数资最新命题趋势方向有深入研究；\n多次参加粉笔授课研讨会议，针对学生困惑研究教学策略，拓展考场思维，能够帮助学员将所学理论更好应用在实际解题当中，拓展解题思路；\n授课风格:授课累计评分达4.9分，讲课耐心细致，课堂氛围轻松活跃，与学员重在沟通，能够从学员角度出发去找问题、解决问题，深受学员的喜爱。&q;,&q;avatar&q;:&q;19854f590ec1eda.jpg&q;,&q;upperBodyPhoto&q;:null,&q;displayCoursePrefix&q;:&q;sydw&q;,&q;teacherStat&q;:{&q;teacherId&q;:16574,&q;episodeCount&q;:739,&q;scoreCount&q;:6952,&q;avgScore&q;:9.825373993095512,&q;fiveGradeAvgScore&q;:4.91,&q;updateTime&q;:1773622398088},&q;auditionEpisode&q;:{&q;episodeTitle&q;:&q;个人展示课&q;,&q;episodeVideoUrl&q;:&q;https://vod.fbstatic.cn/22e9ceb2vodbj1251001446/725c3a375145403709544020247/E4rt1kFdZL4A.mp4?t=f2a4b300&a;us=4070880000&a;sign=423b76444fe4ed707f565354eef136e2&q;},&q;memberOfCPC&q;:false,&q;tags&q;:null},&q;teachChannel&q;:1,&q;offline&q;:null,&q;duration&q;:8134,&q;hasAudition&q;:false,&q;bizType&q;:0,&q;bizId&q;:&q;726825&q;,&q;supportReplay&q;:true,&q;extraInfo&q;:null,&q;liveConfig&q;:{&q;episodeId&q;:10790107,&q;supportMultiGroup&q;:false,&q;exerciseBizType&q;:0,&q;videoDisplayType&q;:0,&q;avForwardType&q;:0,&q;useIntelligentRoom&q;:false,&q;hasStrokeKeynote&q;:true,&q;verticalModeType&q;:0,&q;originEpisodeId&q;:0,&q;supportRtmp&q;:false,&q;supportPk&q;:true,&q;supportLuckyBag&q;:true,&q;supportUserNoteStroke&q;:false,&q;communicateType&q;:0,&q;one2One&q;:false,&q;fakeLive&q;:false},&q;validStatus&q;:1,&q;supportLive&q;:true,&q;supportAiCatalog&q;:false,&q;hasIntelligentPen&q;:false,&q;useLocalRecording&q;:false,&q;useIntelligentRoom&q;:false,&q;hasSalePosition&q;:false,&q;hasEpisodeCards&q;:true,&q;lockedForShouna&q;:false,&q;needSignIn&q;:false,&q;needTeacherSignIn&q;:false,&q;enablePadPencil&q;:true,&q;displayExercise&q;:false,&q;supportLuckyBag&q;:true,&q;supportLivePk&q;:true},{&q;id&q;:10790110,&q;kePrefix&q;:&q;sydw&q;,&q;courseId&q;:6,&q;status&q;:3,&q;playStatus&q;:3,&q;type&q;:33,&q;recordingType&q;:0,&q;mediaType&q;:0,&q;title&q;:&q;【综应】精选好题 沉浸刷题&q;,&q;innerTitle&q;:&q;&q;,&q;startTime&q;:1750212000000,&q;endTime&q;:1750219200000,&q;teacher&q;:{&q;id&q;:64240,&q;userId&q;:136258833,&q;name&q;:&q;熙儒&q;,&q;brief&q;:&q;粉笔优质讲师&q;,&q;desc&q;:&q;粉笔优质讲师\n主教事业单位笔试综应科目，拥有多年的一线教学授课经验。具备系统扎实的专业理论知识，参与多次相关教研真题录制工作。思路开阔，注重理论与实际相结合教育，善于因材施教，带领多名学生高分上岸。多次收获学生好评，待人亲和，上课教学风格幽默风趣，逻辑清晰，讲解深入浅出，善于引导，让学员在轻松活跃的氛围中快速获取知识，克服重重困难，最终实现梦想。&q;,&q;avatar&q;:&q;1945f3c2db80a69.jpg&q;,&q;upperBodyPhoto&q;:null,&q;displayCoursePrefix&q;:&q;sydw&q;,&q;teacherStat&q;:{&q;teacherId&q;:64240,&q;episodeCount&q;:558,&q;scoreCount&q;:369,&q;avgScore&q;:9.907859078590787,&q;fiveGradeAvgScore&q;:4.95,&q;updateTime&q;:1773584458538},&q;auditionEpisode&q;:{&q;episodeTitle&q;:&q;个人展示课&q;,&q;episodeVideoUrl&q;:&q;https://vod.fbstatic.cn/22e9ceb2vodbj1251001446/ad7e5f071397757909240510562/decWh0KkzDQA.mp4?t=f2a4b300&a;us=4070880000&a;sign=5da92042df829294dca2292b4fe66a70&q;},&q;memberOfCPC&q;:false,&q;tags&q;:null},&q;teachChannel&q;:1,&q;offline&q;:null,&q;duration&q;:8134,&q;hasAudition&q;:false,&q;bizType&q;:0,&q;bizId&q;:&q;726825&q;,&q;supportReplay&q;:true,&q;extraInfo&q;:null,&q;liveConfig&q;:{&q;episodeId&q;:10790110,&q;supportMultiGroup&q;:false,&q;exerciseBizType&q;:0,&q;videoDisplayType&q;:0,&q;avForwardType&q;:0,&q;useIntelligentRoom&q;:false,&q;hasStrokeKeynote&q;:true,&q;verticalModeType&q;:0,&q;originEpisodeId&q;:0,&q;supportRtmp&q;:false,&q;supportPk&q;:true,&q;supportLuckyBag&q;:true,&q;supportUserNoteStroke&q;:false,&q;communicateType&q;:0,&q;one2One&q;:false,&q;fakeLive&q;:false},&q;validStatus&q;:1,&q;supportLive&q;:true,&q;supportAiCatalog&q;:false,&q;hasIntelligentPen&q;:false,&q;useLocalRecording&q;:false,&q;useIntelligentRoom&q;:false,&q;hasSalePosition&q;:false,&q;hasEpisodeCards&q;:true,&q;lockedForShouna&q;:false,&q;needSignIn&q;:false,&q;needTeacherSignIn&q;:false,&q;enablePadPencil&q;:true,&q;displayExercise&q;:false,&q;supportLuckyBag&q;:true,&q;supportLivePk&q;:true},{&q;id&q;:10790812,&q;kePrefix&q;:&q;sydw&q;,&q;courseId&q;:6,&q;status&q;:3,&q;playStatus&q;:3,&q;type&q;:33,&q;recordingType&q;:0,&q;mediaType&q;:0,&q;title&q;:&q;【判断】精选好题 沉浸刷题&q;,&q;innerTitle&q;:&q;&q;,&q;startTime&q;:1750219200000,&q;endTime&q;:1750226400000,&q;teacher&q;:{&q;id&q;:16630,&q;userId&q;:63555782,&q;name&q;:&q;陈贺&q;,&q;brief&q;:&q;粉笔优质讲师&q;,&q;desc&q;:&q;粉笔优质教师\n6年一线教学授课经验，线上累计授课超800+小时，带班学生8000+；具有判断推理科目丰富的实践经验和系统扎实的专业理论，对山东、陕西、甘肃等各省判断推理科目的考情深入研究，全面了解命题规律及答题技巧，长期参与线上系统班和精品班的教研工作，撰写教研文章10余篇，出过近200道优质模拟题；具有幽默诙谐、形象生动、条理清晰的授课风格，让学生在轻松的学习氛围中，用更简单的方法，找到更快捷的解题之道，深受广大学员的认可和好评。&q;,&q;avatar&q;:&q;175d8f143291ec7.jpg&q;,&q;upperBodyPhoto&q;:null,&q;displayCoursePrefix&q;:&q;sydw&q;,&q;teacherStat&q;:{&q;teacherId&q;:16630,&q;episodeCount&q;:508,&q;scoreCount&q;:1860,&q;avgScore&q;:9.8516129032258,&q;fiveGradeAvgScore&q;:4.93,&q;updateTime&q;:1773584418412},&q;auditionEpisode&q;:{&q;episodeTitle&q;:&q;个人展示课&q;,&q;episodeVideoUrl&q;:&q;https://vod.fbstatic.cn/22e9ceb2vodbj1251001446/be9c21bc5145403709538211346/S3YE0Y3AIBoA.mp4?t=f2a4b300&a;us=4070880000&a;sign=aa0da2116ec32854b9c50d64d3429cec&q;},&q;memberOfCPC&q;:false,&q;tags&q;:null},&q;teachChannel&q;:1,&q;offline&q;:null,&q;duration&q;:7642,&q;hasAudition&q;:false,&q;bizType&q;:0,&q;bizId&q;:&q;726825&q;,&q;supportReplay&q;:true,&q;extraInfo&q;:null,&q;liveConfig&q;:{&q;episodeId&q;:10790812,&q;supportMultiGroup&q;:false,&q;exerciseBizType&q;:0,&q;videoDisplayType&q;:0,&q;avForwardType&q;:0,&q;useIntelligentRoom&q;:false,&q;hasStrokeKeynote&q;:true,&q;verticalModeType&q;:0,&q;originEpisodeId&q;:0,&q;supportRtmp&q;:false,&q;supportPk&q;:true,&q;supportLuckyBag&q;:true,&q;supportUserNoteStroke&q;:false,&q;communicateType&q;:0,&q;one2One&q;:false,&q;fakeLive&q;:false},&q;validStatus&q;:1,&q;supportLive&q;:true,&q;supportAiCatalog&q;:false,&q;hasIntelligentPen&q;:false,&q;useLocalRecording&q;:false,&q;useIntelligentRoom&q;:false,&q;hasSalePosition&q;:false,&q;hasEpisodeCards&q;:true,&q;lockedForShouna&q;:false,&q;needSignIn&q;:false,&q;needTeacherSignIn&q;:false,&q;enablePadPencil&q;:true,&q;displayExercise&q;:false,&q;supportLuckyBag&q;:true,&q;supportLivePk&q;:true},{&q;id&q;:10790814,&q;kePrefix&q;:&q;sydw&q;,&q;courseId&q;:6,&q;status&q;:3,&q;playStatus&q;:3,&q;type&q;:33,&q;recordingType&q;:0,&q;mediaType&q;:0,&q;title&q;:&q;【综应】精选好题 沉浸刷题&q;,&q;innerTitle&q;:&q;&q;,&q;startTime&q;:1750226400000,&q;endTime&q;:1750233600000,&q;teacher&q;:{&q;id&q;:34144,&q;userId&q;:83886683,&q;name&q;:&q;成远&q;,&q;brief&q;:&q;粉笔优质讲师&q;,&q;desc&q;:&q;粉笔优质教师\n五年一线教学授课经验 具有综应科目丰富的实践经验及系统扎实的专业理论知识，对综应考情深入研究 教学经验：多次积极参加综应科目的教研培训，对各省份综应考情进行深入研究，积累丰富的综应知识 学生口碑：授课风格细腻认真，根据学员的学习风格，灵活调整教学策略，使每位学员都能跟上课堂进度。课堂氛围轻松，能够让学员们积极参与讨论，互相分享自己的见解。与学员之间的互动频繁，学员提出的问题能够及时耐心解答。&q;,&q;avatar&q;:&q;178a5ed9b29baae.jpg&q;,&q;upperBodyPhoto&q;:null,&q;displayCoursePrefix&q;:&q;sydw&q;,&q;teacherStat&q;:{&q;teacherId&q;:34144,&q;episodeCount&q;:379,&q;scoreCount&q;:278,&q;avgScore&q;:9.812949640287767,&q;fiveGradeAvgScore&q;:4.91,&q;updateTime&q;:1773283970717},&q;auditionEpisode&q;:{&q;episodeTitle&q;:&q;个人展示课&q;,&q;episodeVideoUrl&q;:&q;https://vod.fbstatic.cn/22e9ceb2vodbj1251001446/dded7c315145403709430054231/MetXyTQDR9MA.mp4?t=f2a4b300&a;us=4070880000&a;sign=5cfd13ce7c9af3e4a44ad6a7c92fffaa&q;},&q;memberOfCPC&q;:false,&q;tags&q;:null},&q;teachChannel&q;:1,&q;offline&q;:null,&q;duration&q;:8194,&q;hasAudition&q;:false,&q;bizType&q;:0,&q;bizId&q;:&q;726825&q;,&q;supportReplay&q;:true,&q;extraInfo&q;:null,&q;liveConfig&q;:{&q;episodeId&q;:10790814,&q;supportMultiGroup&q;:false,&q;exerciseBizType&q;:0,&q;videoDisplayType&q;:0,&q;avForwardType&q;:0,&q;useIntelligentRoom&q;:false,&q;hasStrokeKeynote&q;:true,&q;verticalModeType&q;:0,&q;originEpisodeId&q;:0,&q;supportRtmp&q;:false,&q;supportPk&q;:true,&q;supportLuckyBag&q;:true,&q;supportUserNoteStroke&q;:false,&q;communicateType&q;:0,&q;one2One&q;:false,&q;fakeLive&q;:false},&q;validStatus&q;:1,&q;supportLive&q;:true,&q;supportAiCatalog&q;:false,&q;hasIntelligentPen&q;:false,&q;useLocalRecording&q;:false,&q;useIntelligentRoom&q;:false,&q;hasSalePosition&q;:false,&q;hasEpisodeCards&q;:true,&q;lockedForShouna&q;:false,&q;needSignIn&q;:false,&q;needTeacherSignIn&q;:false,&q;enablePadPencil&q;:false,&q;displayExercise&q;:false,&q;supportLuckyBag&q;:true,&q;supportLivePk&q;:true},{&q;id&q;:10790816,&q;kePrefix&q;:&q;sydw&q;,&q;courseId&q;:6,&q;status&q;:3,&q;playStatus&q;:3,&q;type&q;:33,&q;recordingType&q;:0,&q;mediaType&q;:0,&q;title&q;:&q;【言语】精选好题 沉浸刷题&q;,&q;innerTitle&q;:&q;&q;,&q;startTime&q;:1750233600000,&q;endTime&q;:1750240800000,&q;teacher&q;:{&q;id&q;:56429,&q;userId&q;:74160353,&q;name&q;:&q;邱宜静&q;,&q;brief&q;:&q;粉笔优质讲师&q;,&q;desc&q;:&q;粉笔优质教师\n五年一线教学授课经验，长期致力于事业单位考试研究与教学，对事业单位招聘考试体系有着深入的理解和扎实的教学经验。\n具有言语科目丰富的实践经验及系统扎实的专业理论知识和对事业单位言语考情的深入研究:\n多次参与笔试真题教研和解析撰写工作，对言语命题趋势方向有着深入的研究;\n多次参加粉笔授课研讨会议，深入研讨事考言语命题趋势及最新考情;\n授课特点:擅长将复杂的知识点转化为易于理解的教学内容，通过循序渐进的教学方式，引导学生逐步掌握所需的知识点，帮助学员快速掌握言语科目的核心要点，提升解题能力和应试技巧，成功帮助数百名考生顺利通过事业单位招聘考试。&q;,&q;avatar&q;:&q;18408e0ee9a5e5d.jpg&q;,&q;upperBodyPhoto&q;:null,&q;displayCoursePrefix&q;:&q;sydw&q;,&q;teacherStat&q;:{&q;teacherId&q;:56429,&q;episodeCount&q;:185,&q;scoreCount&q;:627,&q;avgScore&q;:9.763955342902712,&q;fiveGradeAvgScore&q;:4.88,&q;updateTime&q;:1773327807084},&q;auditionEpisode&q;:{&q;episodeTitle&q;:&q;个人展示课&q;,&q;episodeVideoUrl&q;:&q;https://vod.fbstatic.cn/22e9ceb2vodbj1251001446/cfc0c3501253642695688501785/bsDyySXGJLgA.mp4?t=f2a4b300&a;us=4070880000&a;sign=41a1d807640af0e9a33d92a3917850c4&q;},&q;memberOfCPC&q;:false,&q;tags&q;:null},&q;teachChannel&q;:1,&q;offline&q;:null,&q;duration&q;:7290,&q;hasAudition&q;:false,&q;bizType&q;:0,&q;bizId&q;:&q;726825&q;,&q;supportReplay&q;:true,&q;extraInfo&q;:null,&q;liveConfig&q;:{&q;episodeId&q;:10790816,&q;supportMultiGroup&q;:false,&q;exerciseBizType&q;:0,&q;videoDisplayType&q;:0,&q;avForwardType&q;:0,&q;useIntelligentRoom&q;:false,&q;hasStrokeKeynote&q;:true,&q;verticalModeType&q;:0,&q;originEpisodeId&q;:0,&q;supportRtmp&q;:false,&q;supportPk&q;:true,&q;supportLuckyBag&q;:true,&q;supportUserNoteStroke&q;:false,&q;communicateType&q;:0,&q;one2One&q;:false,&q;fakeLive&q;:false},&q;validStatus&q;:1,&q;supportLive&q;:true,&q;supportAiCatalog&q;:false,&q;hasIntelligentPen&q;:false,&q;useLocalRecording&q;:false,&q;useIntelligentRoom&q;:false,&q;hasSalePosition&q;:false,&q;hasEpisodeCards&q;:true,&q;lockedForShouna&q;:false,&q;needSignIn&q;:false,&q;needTeacherSignIn&q;:false,&q;enablePadPencil&q;:false,&q;displayExercise&q;:false,&q;supportLuckyBag&q;:true,&q;supportLivePk&q;:true},{&q;id&q;:10791287,&q;kePrefix&q;:&q;sydw&q;,&q;courseId&q;:6,&q;status&q;:3,&q;playStatus&q;:3,&q;type&q;:33,&q;recordingType&q;:0,&q;mediaType&q;:0,&q;title&q;:&q;【公基非法】精选好题 沉浸刷题&q;,&q;innerTitle&q;:&q;&q;,&q;startTime&q;:1750298400000,&q;endTime&q;:1750305600000,&q;teacher&q;:{&q;id&q;:16538,&q;userId&q;:72683674,&q;name&q;:&q;章亦轩&q;,&q;brief&q;:&q;粉笔优质讲师&q;,&q;desc&q;:&q;粉笔常识公基优质教师\n四年一线教学授课经验，深耕一线课程，承担过线上笔试精品班、刷题班等多种班型。\n具有常识公基科目丰富的实践经验及系统扎实的专业理论知识和对常识公基考情的深入研究，曾参与笔试教研和解析撰写工作；注重考场思维，针对学生困惑研究教学策略；深入研讨常识公基命题趋势及最新考情，注重自我提升，积累丰富笔试理论知识。\n累计授课超1000小时，注重启发式引导，让学生在轻松的学习氛围中，用更简单的方法，找到更快捷的解题之道，深受广大学员的认可和好评。&q;,&q;avatar&q;:&q;17467b2f8a0fb3b.jpg&q;,&q;upperBodyPhoto&q;:null,&q;displayCoursePrefix&q;:&q;sydw&q;,&q;teacherStat&q;:{&q;teacherId&q;:16538,&q;episodeCount&q;:914,&q;scoreCount&q;:1035,&q;avgScore&q;:9.62898550724638,&q;fiveGradeAvgScore&q;:4.81,&q;updateTime&q;:1773475961041},&q;auditionEpisode&q;:{&q;episodeTitle&q;:&q;个人展示课&q;,&q;episodeVideoUrl&q;:&q;https://vod.fbstatic.cn/22e9ceb2vodbj1251001446/6ef433b51397757888365410347/0qvJbp7EGrgA.mp4?t=f2a4b300&a;us=4070880000&a;sign=5675190d3b2d1da9f9d0e15ba0571903&q;},&q;memberOfCPC&q;:false,&q;tags&q;:null},&q;teachChannel&q;:1,&q;offline&q;:null,&q;duration&q;:7667,&q;hasAudition&q;:false,&q;bizType&q;:0,&q;bizId&q;:&q;726825&q;,&q;supportReplay&q;:true,&q;extraInfo&q;:null,&q;liveConfig&q;:{&q;episodeId&q;:10791287,&q;supportMultiGroup&q;:false,&q;exerciseBizType&q;:0,&q;videoDisplayType&q;:0,&q;avForwardType&q;:0,&q;useIntelligentRoom&q;:false,&q;hasStrokeKeynote&q;:true,&q;verticalModeType&q;:0,&q;originEpisodeId&q;:0,&q;supportRtmp&q;:false,&q;supportPk&q;:true,&q;supportLuckyBag&q;:true,&q;supportUserNoteStroke&q;:false,&q;communicateType&q;:0,&q;one2One&q;:false,&q;fakeLive&q;:false},&q;validStatus&q;:1,&q;supportLive&q;:true,&q;supportAiCatalog&q;:false,&q;hasIntelligentPen&q;:false,&q;useLocalRecording&q;:false,&q;useIntelligentRoom&q;:false,&q;hasSalePosition&q;:false,&q;hasEpisodeCards&q;:true,&q;lockedForShouna&q;:false,&q;needSignIn&q;:false,&q;needTeacherSignIn&q;:false,&q;enablePadPencil&q;:true,&q;displayExercise&q;:false,&q;supportLuckyBag&q;:true,&q;supportLivePk&q;:true},{&q;id&q;:10791310,&q;kePrefix&q;:&q;sydw&q;,&q;courseId&q;:6,&q;status&q;:3,&q;playStatus&q;:3,&q;type&q;:33,&q;recordingType&q;:0,&q;mediaType&q;:0,&q;title&q;:&q;【数资】精选好题 沉浸刷题&q;,&q;innerTitle&q;:&q;&q;,&q;startTime&q;:1750305600000,&q;endTime&q;:1750312800000,&q;teacher&q;:{&q;id&q;:18293,&q;userId&q;:67808406,&q;name&q;:&q;任忠生&q;,&q;brief&q;:&q;粉笔优质讲师&q;,&q;desc&q;:&q;粉笔优质讲师\n6年一线教学经验，承担过线上线下多种课程，授课经验丰富，深受学员喜爱，累计授课评分4.9分。\n授课思路清晰，风趣幽默，妙语连珠，课堂中知识与段子齐飞，答题声与欢笑声连成一片，课堂氛围极佳。\n定期参加粉笔笔试教研，多次参与真题解析以及真题解析视频录制，对笔试理论体系有深入的研究，了解最新命题趋势方向。&q;,&q;avatar&q;:&q;193b4b22415b966.jpg&q;,&q;upperBodyPhoto&q;:null,&q;displayCoursePrefix&q;:&q;sydw&q;,&q;teacherStat&q;:{&q;teacherId&q;:18293,&q;episodeCount&q;:418,&q;scoreCount&q;:1609,&q;avgScore&q;:9.794903666873825,&q;fiveGradeAvgScore&q;:4.9,&q;updateTime&q;:1773490915782},&q;auditionEpisode&q;:{&q;episodeTitle&q;:&q;个人展示课&q;,&q;episodeVideoUrl&q;:&q;https://vod.fbstatic.cn/22e9ceb2vodbj1251001446/bfb29f3c5145403709545073450/6OUlHaE0u2UA.mp4?t=f2a4b300&a;us=4070880000&a;sign=4672d88aaa0f986bf84441ae77d619a3&q;},&q;memberOfCPC&q;:false,&q;tags&q;:null},&q;teachChannel&q;:1,&q;offline&q;:null,&q;duration&q;:7677,&q;hasAudition&q;:false,&q;bizType&q;:0,&q;bizId&q;:&q;726825&q;,&q;supportReplay&q;:true,&q;extraInfo&q;:null,&q;liveConfig&q;:{&q;episodeId&q;:10791310,&q;supportMultiGroup&q;:false,&q;exerciseBizType&q;:0,&q;videoDisplayType&q;:0,&q;avForwardType&q;:0,&q;useIntelligentRoom&q;:false,&q;hasStrokeKeynote&q;:true,&q;verticalModeType&q;:0,&q;originEpisodeId&q;:0,&q;supportRtmp&q;:false,&q;supportPk&q;:true,&q;supportLuckyBag&q;:true,&q;supportUserNoteStroke&q;:false,&q;communicateType&q;:0,&q;one2One&q;:false,&q;fakeLive&q;:false},&q;validStatus&q;:1,&q;supportLive&q;:true,&q;supportAiCatalog&q;:false,&q;hasIntelligentPen&q;:false,&q;useLocalRecording&q;:false,&q;useIntelligentRoom&q;:false,&q;hasSalePosition&q;:false,&q;hasEpisodeCards&q;:true,&q;lockedForShouna&q;:false,&q;needSignIn&q;:false,&q;needTeacherSignIn&q;:false,&q;enablePadPencil&q;:true,&q;displayExercise&q;:false,&q;supportLuckyBag&q;:true,&q;supportLivePk&q;:true},{&q;id&q;:10791311,&q;kePrefix&q;:&q;sydw&q;,&q;courseId&q;:6,&q;status&q;:3,&q;playStatus&q;:3,&q;type&q;:33,&q;recordingType&q;:0,&q;mediaType&q;:0,&q;title&q;:&q;【言语】精选好题 沉浸刷题&q;,&q;innerTitle&q;:&q;&q;,&q;startTime&q;:1750312800000,&q;endTime&q;:1750320000000,&q;teacher&q;:{&q;id&q;:52287,&q;userId&q;:72752112,&q;name&q;:&q;于小雅&q;,&q;brief&q;:&q;粉笔优质讲师&q;,&q;desc&q;:&q;粉笔优质讲师\n6年一线教学经验，深耕事业单位考试，总授课时长2500+h\n对于言语理解与表达科目有丰富的实践经验及系统扎实的专业理论知识。承担过线上和线下的笔试精品班、刷题班、冲刺班等多种班型。\n教学思路清晰严谨，善于总结；重难点突出，举一反三夯实巩固，深受学员好评。&q;,&q;avatar&q;:&q;19bbc41bac59b83.jpg&q;,&q;upperBodyPhoto&q;:null,&q;displayCoursePrefix&q;:&q;sydw&q;,&q;teacherStat&q;:{&q;teacherId&q;:52287,&q;episodeCount&q;:344,&q;scoreCount&q;:1147,&q;avgScore&q;:9.778552746294684,&q;fiveGradeAvgScore&q;:4.89,&q;updateTime&q;:1773483874192},&q;auditionEpisode&q;:{&q;episodeTitle&q;:&q;个人展示课&q;,&q;episodeVideoUrl&q;:&q;https://vod.fbstatic.cn/22e9ceb2vodbj1251001446/82ea83095145403709544757509/SyP20uThTZcA.mp4?t=f2a4b300&a;us=4070880000&a;sign=41435beb2ad52e1ee5e61334ffdb4056&q;},&q;memberOfCPC&q;:false,&q;tags&q;:null},&q;teachChannel&q;:1,&q;offline&q;:null,&q;duration&q;:7300,&q;hasAudition&q;:false,&q;bizType&q;:0,&q;bizId&q;:&q;726825&q;,&q;supportReplay&q;:true,&q;extraInfo&q;:null,&q;liveConfig&q;:{&q;episodeId&q;:10791311,&q;supportMultiGroup&q;:false,&q;exerciseBizType&q;:0,&q;videoDisplayType&q;:0,&q;avForwardType&q;:0,&q;useIntelligentRoom&q;:false,&q;hasStrokeKeynote&q;:true,&q;verticalModeType&q;:0,&q;originEpisodeId&q;:0,&q;supportRtmp&q;:false,&q;supportPk&q;:true,&q;supportLuckyBag&q;:true,&q;supportUserNoteStroke&q;:false,&q;communicateType&q;:0,&q;one2One&q;:false,&q;fakeLive&q;:false},&q;validStatus&q;:1,&q;supportLive&q;:true,&q;supportAiCatalog&q;:false,&q;hasIntelligentPen&q;:false,&q;useLocalRecording&q;:false,&q;useIntelligentRoom&q;:false,&q;hasSalePosition&q;:false,&q;hasEpisodeCards&q;:true,&q;lockedForShouna&q;:false,&q;needSignIn&q;:false,&q;needTeacherSignIn&q;:false,&q;enablePadPencil&q;:true,&q;displayExercise&q;:false,&q;supportLuckyBag&q;:true,&q;supportLivePk&q;:true},{&q;id&q;:10791312,&q;kePrefix&q;:&q;sydw&q;,&q;courseId&q;:6,&q;status&q;:3,&q;playStatus&q;:3,&q;type&q;:33,&q;recordingType&q;:0,&q;mediaType&q;:0,&q;title&q;:&q;【综应】精选好题 沉浸刷题&q;,&q;innerTitle&q;:&q;&q;,&q;startTime&q;:1750320000000,&q;endTime&q;:1750327200000,&q;teacher&q;:{&q;id&q;:16894,&q;userId&q;:72656719,&q;name&q;:&q;代俊玲&q;,&q;brief&q;:&q;粉笔优质讲师&q;,&q;desc&q;:&q;粉笔优质讲师\n师范专业毕业，从事编制考试工作6年，拥有扎实的教学授课、答疑经验。\n6年带班中，一对一答疑解惑的学员2600+，深谙学员的备考心理、备考难点；因此无论在答疑还是在授课中都能快速清晰明了地解决学员的疑难点且给出有效的备考方法。\n备考不仅仅需要理论，还需要实际操作，平时喜欢研究考题，熟悉掌握全国大部分地区综应的考情和考题，积累了大量的做题的经验，做到和学员同频共振。\n累计授课时长7000+，授课通俗易懂；督学答疑打分达到5.0分，答疑具有启发性，坚持的理念就是“题目没有办法穷尽，但是我们可以用思维和技巧来覆盖”。&q;,&q;avatar&q;:&q;1746cbb834cec32.jpg&q;,&q;upperBodyPhoto&q;:null,&q;displayCoursePrefix&q;:&q;sydw&q;,&q;teacherStat&q;:{&q;teacherId&q;:16894,&q;episodeCount&q;:509,&q;scoreCount&q;:691,&q;avgScore&q;:9.777134587554272,&q;fiveGradeAvgScore&q;:4.89,&q;updateTime&q;:1773373967128},&q;auditionEpisode&q;:{&q;episodeTitle&q;:&q;个人展示课&q;,&q;episodeVideoUrl&q;:&q;https://vod.fbstatic.cn/22e9ceb2vodbj1251001446/cb018db65145403710133193708/w90mLpc9KUMA.mp4?t=f2a4b300&a;us=4070880000&a;sign=71534e640e22bf9148a2e806842810e0&q;},&q;memberOfCPC&q;:false,&q;tags&q;:null},&q;teachChannel&q;:1,&q;offline&q;:null,&q;duration&q;:6995,&q;hasAudition&q;:false,&q;bizType&q;:0,&q;bizId&q;:&q;726825&q;,&q;supportReplay&q;:true,&q;extraInfo&q;:null,&q;liveConfig&q;:{&q;episodeId&q;:10791312,&q;supportMultiGroup&q;:false,&q;exerciseBizType&q;:0,&q;videoDisplayType&q;:0,&q;avForwardType&q;:0,&q;useIntelligentRoom&q;:false,&q;hasStrokeKeynote&q;:true,&q;verticalModeType&q;:0,&q;originEpisodeId&q;:0,&q;supportRtmp&q;:false,&q;supportPk&q;:true,&q;supportLuckyBag&q;:true,&q;supportUserNoteStroke&q;:false,&q;communicateType&q;:0,&q;one2One&q;:false,&q;fakeLive&q;:false},&q;validStatus&q;:1,&q;supportLive&q;:true,&q;supportAiCatalog&q;:false,&q;hasIntelligentPen&q;:false,&q;useLocalRecording&q;:false,&q;useIntelligentRoom&q;:false,&q;hasSalePosition&q;:false,&q;hasEpisodeCards&q;:true,&q;lockedForShouna&q;:false,&q;needSignIn&q;:false,&q;needTeacherSignIn&q;:false,&q;enablePadPencil&q;:true,&q;displayExercise&q;:false,&q;supportLuckyBag&q;:true,&q;supportLivePk&q;:true},{&q;id&q;:10794879,&q;kePrefix&q;:&q;sydw&q;,&q;courseId&q;:6,&q;status&q;:3,&q;playStatus&q;:3,&q;type&q;:33,&q;recordingType&q;:0,&q;mediaType&q;:0,&q;title&q;:&q;【数资】精选好题 沉浸刷题&q;,&q;innerTitle&q;:&q;&q;,&q;startTime&q;:1750392000000,&q;endTime&q;:1750399200000,&q;teacher&q;:{&q;id&q;:34199,&q;userId&q;:73996160,&q;name&q;:&q;卫斗妮&q;,&q;brief&q;:&q;粉笔优质讲师&q;,&q;desc&q;:&q;粉笔优质讲师\n5年一线教学授课经验\n具有数量关系和资料分析科目丰富的实践经验及系统扎实的专业理论知识\n多次参加粉笔授课研讨会议，全面把握公考面试命题趋势及最新考情，积累丰富面试知识；\n多次参加粉笔教研活动，分享授课经验心得，助力粉笔理论研发升级；\n累计获得广泛好评，具有启发式的授课风格，让学生在轻松的学习氛围中，用更简单的方法，找到更快捷的解题之道，深受广大学员的认可和好评；在学员中具有非常好的口碑，是值得信赖的好导师。&q;,&q;avatar&q;:&q;198594b4cf62f8a.jpg&q;,&q;upperBodyPhoto&q;:null,&q;displayCoursePrefix&q;:&q;sydw&q;,&q;teacherStat&q;:{&q;teacherId&q;:34199,&q;episodeCount&q;:556,&q;scoreCount&q;:1224,&q;avgScore&q;:9.869281045751636,&q;fiveGradeAvgScore&q;:4.93,&q;updateTime&q;:1773544378749},&q;auditionEpisode&q;:null,&q;memberOfCPC&q;:false,&q;tags&q;:null},&q;teachChannel&q;:1,&q;offline&q;:null,&q;duration&q;:7283,&q;hasAudition&q;:false,&q;bizType&q;:0,&q;bizId&q;:&q;726825&q;,&q;supportReplay&q;:true,&q;extraInfo&q;:null,&q;liveConfig&q;:{&q;episodeId&q;:10794879,&q;supportMultiGroup&q;:false,&q;exerciseBizType&q;:0,&q;videoDisplayType&q;:0,&q;avForwardType&q;:0,&q;useIntelligentRoom&q;:false,&q;hasStrokeKeynote&q;:true,&q;verticalModeType&q;:0,&q;originEpisodeId&q;:0,&q;supportRtmp&q;:false,&q;supportPk&q;:true,&q;supportLuckyBag&q;:true,&q;supportUserNoteStroke&q;:false,&q;communicateType&q;:0,&q;one2One&q;:false,&q;fakeLive&q;:false},&q;validStatus&q;:1,&q;supportLive&q;:true,&q;supportAiCatalog&q;:false,&q;hasIntelligentPen&q;:false,&q;useLocalRecording&q;:false,&q;useIntelligentRoom&q;:false,&q;hasSalePosition&q;:false,&q;hasEpisodeCards&q;:true,&q;lockedForShouna&q;:false,&q;needSignIn&q;:false,&q;needTeacherSignIn&q;:false,&q;enablePadPencil&q;:true,&q;displayExercise&q;:false,&q;supportLuckyBag&q;:true,&q;supportLivePk&q;:true},{&q;id&q;:10794898,&q;kePrefix&q;:&q;sydw&q;,&q;courseId&q;:6,&q;status&q;:3,&q;playStatus&q;:3,&q;type&q;:33,&q;recordingType&q;:0,&q;mediaType&q;:0,&q;title&q;:&q;【言语】精选好题 沉浸刷题&q;,&q;innerTitle&q;:&q;&q;,&q;startTime&q;:1750399200000,&q;endTime&q;:1750406400000,&q;teacher&q;:{&q;id&q;:16571,&q;userId&q;:68761675,&q;name&q;:&q;严月&q;,&q;brief&q;:&q;粉笔优质讲师&q;,&q;desc&q;:&q;粉笔优质讲师\n六年一线教学授课经验，深入了解地区考情，理论知识扎实，授课与实战经验丰富，熟悉考场答题思维及应变技巧。多次参加粉笔教研活动，分享授课经验心得，助力粉笔理论研发升级。能够从学员角度出发，耐心细致，条理清晰，以帮助学员上岸为己任，深受学员喜爱。&q;,&q;avatar&q;:&q;1985521b0d3aabd.jpg&q;,&q;upperBodyPhoto&q;:null,&q;displayCoursePrefix&q;:&q;sydw&q;,&q;teacherStat&q;:{&q;teacherId&q;:16571,&q;episodeCount&q;:422,&q;scoreCount&q;:1222,&q;avgScore&q;:9.749590834697225,&q;fiveGradeAvgScore&q;:4.87,&q;updateTime&q;:1773497598415},&q;auditionEpisode&q;:{&q;episodeTitle&q;:&q;个人展示课&q;,&q;episodeVideoUrl&q;:&q;https://vod.fbstatic.cn/22e9ceb2vodbj1251001446/49118c181253642696336994975/wwjaigalGDUA.mp4?t=f2a4b300&a;us=4070880000&a;sign=dd1690706078bf2cc49e86a072c4cc90&q;},&q;memberOfCPC&q;:false,&q;tags&q;:null},&q;teachChannel&q;:1,&q;offline&q;:null,&q;duration&q;:7346,&q;hasAudition&q;:false,&q;bizType&q;:0,&q;bizId&q;:&q;726825&q;,&q;supportReplay&q;:true,&q;extraInfo&q;:null,&q;liveConfig&q;:{&q;episodeId&q;:10794898,&q;supportMultiGroup&q;:false,&q;exerciseBizType&q;:0,&q;videoDisplayType&q;:0,&q;avForwardType&q;:0,&q;useIntelligentRoom&q;:false,&q;hasStrokeKeynote&q;:true,&q;verticalModeType&q;:0,&q;originEpisodeId&q;:0,&q;supportRtmp&q;:false,&q;supportPk&q;:true,&q;supportLuckyBag&q;:true,&q;supportUserNoteStroke&q;:false,&q;communicateType&q;:0,&q;one2One&q;:false,&q;fakeLive&q;:false},&q;validStatus&q;:1,&q;supportLive&q;:true,&q;supportAiCatalog&q;:false,&q;hasIntelligentPen&q;:false,&q;useLocalRecording&q;:false,&q;useIntelligentRoom&q;:false,&q;hasSalePosition&q;:false,&q;hasEpisodeCards&q;:true,&q;lockedForShouna&q;:false,&q;needSignIn&q;:false,&q;needTeacherSignIn&q;:false,&q;enablePadPencil&q;:true,&q;displayExercise&q;:false,&q;supportLuckyBag&q;:true,&q;supportLivePk&q;:true},{&q;id&q;:10794899,&q;kePrefix&q;:&q;sydw&q;,&q;courseId&q;:6,&q;status&q;:3,&q;playStatus&q;:3,&q;type&q;:33,&q;recordingType&q;:0,&q;mediaType&q;:0,&q;title&q;:&q;【综应】精选好题 沉浸刷题&q;,&q;innerTitle&q;:&q;&q;,&q;startTime&q;:1750406400000,&q;endTime&q;:1750413600000,&q;teacher&q;:{&q;id&q;:15514,&q;userId&q;:63317913,&q;name&q;:&q;唐邦杰&q;,&q;brief&q;:&q;粉笔优质讲师&q;,&q;desc&q;:&q;粉笔优质教师\n6年一线教学授课经验，线上累计授课超1000+小时，授课人数2500+，始终教研结合，紧跟命题走向，强调知识更新。善于讲解联考A、江苏、浙江、山东、广东各省综应课程，对于综应解题技巧有独到的见解，并参与综应各大题型人工批改服务上千份，能够多方面把握学员需求，精准定位学员薄弱点。全面了解事业单位综合应用能力考试的命题规律及答题技巧，授课经验丰富，逻辑清晰，思维严谨，擅长总结，深受广大学员的认可和好评，在学员中具有非常好的口碑，是值得信赖的好导师。&q;,&q;avatar&q;:&q;198411427ad51c5.jpg&q;,&q;upperBodyPhoto&q;:null,&q;displayCoursePrefix&q;:&q;sydw&q;,&q;teacherStat&q;:{&q;teacherId&q;:15514,&q;episodeCount&q;:512,&q;scoreCount&q;:787,&q;avgScore&q;:9.9135959339263,&q;fiveGradeAvgScore&q;:4.96,&q;updateTime&q;:1772548329533},&q;auditionEpisode&q;:{&q;episodeTitle&q;:&q;个人展示课&q;,&q;episodeVideoUrl&q;:&q;https://vod.fbstatic.cn/22e9ceb2vodbj1251001446/5402b0855145403709207407994/antnJrlNvLMA.mp4?t=f2a4b300&a;us=4070880000&a;sign=cd84b92e364976b35f69adb6cf6cd1b7&q;},&q;memberOfCPC&q;:false,&q;tags&q;:null},&q;teachChannel&q;:1,&q;offline&q;:null,&q;duration&q;:7163,&q;hasAudition&q;:false,&q;bizType&q;:0,&q;bizId&q;:&q;726825&q;,&q;supportReplay&q;:true,&q;extraInfo&q;:null,&q;liveConfig&q;:{&q;episodeId&q;:10794899,&q;supportMultiGroup&q;:false,&q;exerciseBizType&q;:0,&q;videoDisplayType&q;:0,&q;avForwardType&q;:0,&q;useIntelligentRoom&q;:false,&q;hasStrokeKeynote&q;:true,&q;verticalModeType&q;:0,&q;originEpisodeId&q;:0,&q;supportRtmp&q;:false,&q;supportPk&q;:true,&q;supportLuckyBag&q;:true,&q;supportUserNoteStroke&q;:false,&q;communicateType&q;:0,&q;one2One&q;:false,&q;fakeLive&q;:false},&q;validStatus&q;:1,&q;supportLive&q;:true,&q;supportAiCatalog&q;:false,&q;hasIntelligentPen&q;:false,&q;useLocalRecording&q;:false,&q;useIntelligentRoom&q;:false,&q;hasSalePosition&q;:false,&q;hasEpisodeCards&q;:true,&q;lockedForShouna&q;:false,&q;needSignIn&q;:false,&q;needTeacherSignIn&q;:false,&q;enablePadPencil&q;:true,&q;displayExercise&q;:false,&q;supportLuckyBag&q;:true,&q;supportLivePk&q;:true},{&q;id&q;:10794910,&q;kePrefix&q;:&q;sydw&q;,&q;courseId&q;:6,&q;status&q;:3,&q;playStatus&q;:3,&q;type&q;:33,&q;recordingType&q;:0,&q;mediaType&q;:0,&q;title&q;:&q;【判断】精选好题 沉浸刷题&q;,&q;innerTitle&q;:&q;&q;,&q;startTime&q;:1750478400000,&q;endTime&q;:1750485600000,&q;teacher&q;:{&q;id&q;:16940,&q;userId&q;:73888389,&q;name&q;:&q;周晓英&q;,&q;brief&q;:&q;粉笔优质讲师&q;,&q;desc&q;:&q;粉笔优质教师\n6年一线教学授课经验，累计授课时长1000+小时，授课人数20000+，10000+人次累计评分4.9，具有判断推理科目丰富的实践经验和系统扎实的专业理论。多次参与江苏、浙江等地判断推理的考情撰写，长期参与系统班和精品班的教研工作，2021-2024年进行精品班课程的讲义制作与修订，撰写教研文章20余篇，为模考大赛等累计出题200+道。授课风格形象生动、条理清晰，擅于从学员角度思考，帮助学员突破科目重难考点，让学生在轻松的学习氛围中，用更简单的方法，找到更快捷的解题之道，深受广大学员的认可和好评。&q;,&q;avatar&q;:&q;198411a7c789ded.jpg&q;,&q;upperBodyPhoto&q;:null,&q;displayCoursePrefix&q;:&q;sydw&q;,&q;teacherStat&q;:{&q;teacherId&q;:16940,&q;episodeCount&q;:581,&q;scoreCount&q;:2248,&q;avgScore&q;:9.711743772241979,&q;fiveGradeAvgScore&q;:4.86,&q;updateTime&q;:1773552283828},&q;auditionEpisode&q;:{&q;episodeTitle&q;:&q;个人展示课&q;,&q;epi