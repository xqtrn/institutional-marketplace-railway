e&q;:&q;个人展示课&q;,&q;episodeVideoUrl&q;:&q;https://vod.fbstatic.cn/22e9ceb2vodbj1251001446/852adeed5145403709544842797/4NI3eZVTCIgA.mp4?t=f2a4b300&a;us=4070880000&a;sign=8b0451bae7287a818ba1ca53e0d1a8cd&q;},&q;memberOfCPC&q;:false,&q;tags&q;:null},&q;teachChannel&q;:1,&q;offline&q;:null,&q;duration&q;:9051,&q;hasAudition&q;:false,&q;bizType&q;:0,&q;bizId&q;:&q;726825&q;,&q;supportReplay&q;:true,&q;extraInfo&q;:null,&q;liveConfig&q;:{&q;episodeId&q;:10921908,&q;supportMultiGroup&q;:false,&q;exerciseBizType&q;:0,&q;videoDisplayType&q;:0,&q;avForwardType&q;:0,&q;useIntelligentRoom&q;:false,&q;hasStrokeKeynote&q;:true,&q;verticalModeType&q;:0,&q;originEpisodeId&q;:0,&q;supportRtmp&q;:false,&q;supportPk&q;:true,&q;supportLuckyBag&q;:true,&q;supportUserNoteStroke&q;:false,&q;communicateType&q;:0,&q;one2One&q;:false,&q;fakeLive&q;:false},&q;validStatus&q;:1,&q;supportLive&q;:true,&q;supportAiCatalog&q;:false,&q;hasIntelligentPen&q;:false,&q;useLocalRecording&q;:false,&q;useIntelligentRoom&q;:false,&q;hasSalePosition&q;:false,&q;hasEpisodeCards&q;:true,&q;lockedForShouna&q;:false,&q;needSignIn&q;:false,&q;needTeacherSignIn&q;:false,&q;enablePadPencil&q;:true,&q;displayExercise&q;:false,&q;supportLuckyBag&q;:true,&q;supportLivePk&q;:true},{&q;id&q;:10921909,&q;kePrefix&q;:&q;sydw&q;,&q;courseId&q;:6,&q;status&q;:3,&q;playStatus&q;:3,&q;type&q;:33,&q;recordingType&q;:0,&q;mediaType&q;:0,&q;title&q;:&q;【数资】精选好题 沉浸刷题&q;,&q;innerTitle&q;:&q;&q;,&q;startTime&q;:1754618400000,&q;endTime&q;:1754625600000,&q;teacher&q;:{&q;id&q;:16939,&q;userId&q;:66139840,&q;name&q;:&q;张雨晰&q;,&q;brief&q;:&q;粉笔优质讲师&q;,&q;desc&q;:&q;粉笔优质教师\n拥有五年专业理论知识，曾撰写多篇事业单位笔试教研材料，在粉笔教师内部进行共享。在教学风格上，我追求幽默风趣与细致耐心并存，让学生在轻松的学习氛围中，用更简单的方法，找到更快捷的解题之道，深受广大学员的认可和好评；在学员中具有非常好的口碑，是值得信赖的好导师。&q;,&q;avatar&q;:&q;19855196b15bfa5.jpg&q;,&q;upperBodyPhoto&q;:null,&q;displayCoursePrefix&q;:&q;sydw&q;,&q;teacherStat&q;:{&q;teacherId&q;:16939,&q;episodeCount&q;:477,&q;scoreCount&q;:1735,&q;avgScore&q;:9.558501440922182,&q;fiveGradeAvgScore&q;:4.78,&q;updateTime&q;:1773583323250},&q;auditionEpisode&q;:null,&q;memberOfCPC&q;:false,&q;tags&q;:null},&q;teachChannel&q;:1,&q;offline&q;:null,&q;duration&q;:8862,&q;hasAudition&q;:false,&q;bizType&q;:0,&q;bizId&q;:&q;726825&q;,&q;supportReplay&q;:true,&q;extraInfo&q;:null,&q;liveConfig&q;:{&q;episodeId&q;:10921909,&q;supportMultiGroup&q;:false,&q;exerciseBizType&q;:0,&q;videoDisplayType&q;:0,&q;avForwardType&q;:0,&q;useIntelligentRoom&q;:false,&q;hasStrokeKeynote&q;:true,&q;verticalModeType&q;:0,&q;originEpisodeId&q;:0,&q;supportRtmp&q;:false,&q;supportPk&q;:true,&q;supportLuckyBag&q;:true,&q;supportUserNoteStroke&q;:false,&q;communicateType&q;:0,&q;one2One&q;:false,&q;fakeLive&q;:false},&q;validStatus&q;:1,&q;supportLive&q;:true,&q;supportAiCatalog&q;:false,&q;hasIntelligentPen&q;:false,&q;useLocalRecording&q;:false,&q;useIntelligentRoom&q;:false,&q;hasSalePosition&q;:false,&q;hasEpisodeCards&q;:true,&q;lockedForShouna&q;:false,&q;needSignIn&q;:false,&q;needTeacherSignIn&q;:false,&q;enablePadPencil&q;:true,&q;displayExercise&q;:false,&q;supportLuckyBag&q;:true,&q;supportLivePk&q;:true},{&q;id&q;:10921975,&q;kePrefix&q;:&q;sydw&q;,&q;courseId&q;:6,&q;status&q;:3,&q;playStatus&q;:3,&q;type&q;:33,&q;recordingType&q;:0,&q;mediaType&q;:0,&q;title&q;:&q;【综应】精选好题 沉浸刷题&q;,&q;innerTitle&q;:&q;&q;,&q;startTime&q;:1754625600000,&q;endTime&q;:1754632800000,&q;teacher&q;:{&q;id&q;:26278,&q;userId&q;:61736380,&q;name&q;:&q;江丽贤&q;,&q;brief&q;:&q;粉笔优质讲师&q;,&q;desc&q;:&q;粉笔优质教师\n5年一线教学经验，深耕事业单位笔试考试，承担线上精品班、系统班等多种班型，具有综应科目丰富的实践经验及系统扎实的专业理论知识。\n不断更新知识，注重笔试理论知识丰富，多次参与笔试真题教研，对联考ABC以及非联考地区如山东、江苏等地区的命题有深入研究，时刻把握最新考情动态。\n累计带班人数超过2200人，学员整体评分维持在4.9左右，累计授课超900小时，授课评分高达4.9，授课思路清晰，课堂互动性佳，授课内容深入浅出，善于引导学生自主思考，发现学生问题给出针对性建议。&q;,&q;avatar&q;:&q;1983b170cb4f625.jpg&q;,&q;upperBodyPhoto&q;:null,&q;displayCoursePrefix&q;:&q;sydw&q;,&q;teacherStat&q;:{&q;teacherId&q;:26278,&q;episodeCount&q;:288,&q;scoreCount&q;:356,&q;avgScore&q;:9.870786516853938,&q;fiveGradeAvgScore&q;:4.94,&q;updateTime&q;:1773475358078},&q;auditionEpisode&q;:{&q;episodeTitle&q;:&q;个人展示课&q;,&q;episodeVideoUrl&q;:&q;https://vod.fbstatic.cn/22e9ceb2vodbj1251001446/2e926e765145403709543400209/83QW9fZvl34A.mp4?t=f2a4b300&a;us=4070880000&a;sign=c5368d9fae65069fb3bc52cdfc8bc20a&q;},&q;memberOfCPC&q;:false,&q;tags&q;:null},&q;teachChannel&q;:1,&q;offline&q;:null,&q;duration&q;:7226,&q;hasAudition&q;:false,&q;bizType&q;:0,&q;bizId&q;:&q;726825&q;,&q;supportReplay&q;:true,&q;extraInfo&q;:null,&q;liveConfig&q;:{&q;episodeId&q;:10921975,&q;supportMultiGroup&q;:false,&q;exerciseBizType&q;:0,&q;videoDisplayType&q;:0,&q;avForwardType&q;:0,&q;useIntelligentRoom&q;:false,&q;hasStrokeKeynote&q;:true,&q;verticalModeType&q;:0,&q;originEpisodeId&q;:0,&q;supportRtmp&q;:false,&q;supportPk&q;:true,&q;supportLuckyBag&q;:true,&q;supportUserNoteStroke&q;:false,&q;communicateType&q;:0,&q;one2One&q;:false,&q;fakeLive&q;:false},&q;validStatus&q;:1,&q;supportLive&q;:true,&q;supportAiCatalog&q;:false,&q;hasIntelligentPen&q;:false,&q;useLocalRecording&q;:false,&q;useIntelligentRoom&q;:false,&q;hasSalePosition&q;:false,&q;hasEpisodeCards&q;:true,&q;lockedForShouna&q;:false,&q;needSignIn&q;:false,&q;needTeacherSignIn&q;:false,&q;enablePadPencil&q;:true,&q;displayExercise&q;:false,&q;supportLuckyBag&q;:true,&q;supportLivePk&q;:true},{&q;id&q;:10921977,&q;kePrefix&q;:&q;sydw&q;,&q;courseId&q;:6,&q;status&q;:3,&q;playStatus&q;:3,&q;type&q;:33,&q;recordingType&q;:0,&q;mediaType&q;:0,&q;title&q;:&q;【言语】精选好题 沉浸刷题&q;,&q;innerTitle&q;:&q;&q;,&q;startTime&q;:1754632800000,&q;endTime&q;:1754640000000,&q;teacher&q;:{&q;id&q;:35776,&q;userId&q;:83534698,&q;name&q;:&q;魏兰婷&q;,&q;brief&q;:&q;粉笔优质讲师&q;,&q;desc&q;:&q;粉笔优质讲师\n拥有7年一线教学授课经验，毕业于双一流院校。深耕言语理解与表达科目，对国考及各省考情有精准把握。具有言语科目丰富的实践经验及系统扎实的专业理论知识。\n①多次参与粉笔授课研讨与教研活动，持续更新教学理论与方法；\n②承担线上公开课及线上直播课等工作，累计全国授课超万人次，学员评分长期稳定在4.9分以上；\n③曾2次在粉笔“师资风采大赛”中入围并获奖，教学能力获得内部认可。\n授课风格耐心细致，善于将复杂的知识点转化为通俗易懂的讲解，营造轻松积极的学习氛围。其高效的解题方法与亲切的指导深受学员好评，是学员信赖的良师。&q;,&q;avatar&q;:&q;1984fca9fbd6325.jpg&q;,&q;upperBodyPhoto&q;:null,&q;displayCoursePrefix&q;:&q;sydw&q;,&q;teacherStat&q;:{&q;teacherId&q;:35776,&q;episodeCount&q;:610,&q;scoreCount&q;:4222,&q;avgScore&q;:9.801989578398866,&q;fiveGradeAvgScore&q;:4.9,&q;updateTime&q;:1773576447340},&q;auditionEpisode&q;:{&q;episodeTitle&q;:&q;个人展示课&q;,&q;episodeVideoUrl&q;:&q;https://vod.fbstatic.cn/22e9ceb2vodbj1251001446/bcb7f84d5145403709538179593/LKKkDheS6YsA.mp4?t=f2a4b300&a;us=4070880000&a;sign=ade5c614ffe4fa0bcf0395aa689081c8&q;},&q;memberOfCPC&q;:false,&q;tags&q;:null},&q;teachChannel&q;:1,&q;offline&q;:null,&q;duration&q;:7447,&q;hasAudition&q;:false,&q;bizType&q;:0,&q;bizId&q;:&q;726825&q;,&q;supportReplay&q;:true,&q;extraInfo&q;:null,&q;liveConfig&q;:{&q;episodeId&q;:10921977,&q;supportMultiGroup&q;:false,&q;exerciseBizType&q;:0,&q;videoDisplayType&q;:0,&q;avForwardType&q;:0,&q;useIntelligentRoom&q;:false,&q;hasStrokeKeynote&q;:true,&q;verticalModeType&q;:0,&q;originEpisodeId&q;:0,&q;supportRtmp&q;:false,&q;supportPk&q;:true,&q;supportLuckyBag&q;:true,&q;supportUserNoteStroke&q;:false,&q;communicateType&q;:0,&q;one2One&q;:false,&q;fakeLive&q;:false},&q;validStatus&q;:1,&q;supportLive&q;:true,&q;supportAiCatalog&q;:false,&q;hasIntelligentPen&q;:false,&q;useLocalRecording&q;:false,&q;useIntelligentRoom&q;:false,&q;hasSalePosition&q;:false,&q;hasEpisodeCards&q;:true,&q;lockedForShouna&q;:false,&q;needSignIn&q;:false,&q;needTeacherSignIn&q;:false,&q;enablePadPencil&q;:true,&q;displayExercise&q;:false,&q;supportLuckyBag&q;:true,&q;supportLivePk&q;:true},{&q;id&q;:10921979,&q;kePrefix&q;:&q;sydw&q;,&q;courseId&q;:6,&q;status&q;:3,&q;playStatus&q;:3,&q;type&q;:33,&q;recordingType&q;:0,&q;mediaType&q;:0,&q;title&q;:&q;【判断】精选好题 沉浸刷题&q;,&q;innerTitle&q;:&q;&q;,&q;startTime&q;:1754640000000,&q;endTime&q;:1754647200000,&q;teacher&q;:{&q;id&q;:16852,&q;userId&q;:74701449,&q;name&q;:&q;王琛&q;,&q;brief&q;:&q;粉笔优质讲师&q;,&q;desc&q;:&q;粉笔优质教师\n具有6年教学授课经验，授课重点突出，能够及时总结拓展，讲解语言通俗易懂，广受学员好评。课堂氛围轻松融洽，擅长引导学生自主思考，多次参与粉笔教研活动，全面把握命题趋势和最新考情。善于根据学生的不同情况，进行个性化的指导，助力学员上岸。&q;,&q;avatar&q;:&q;1966b8f5dbc77d6.jpg&q;,&q;upperBodyPhoto&q;:null,&q;displayCoursePrefix&q;:&q;sydw&q;,&q;teacherStat&q;:{&q;teacherId&q;:16852,&q;episodeCount&q;:443,&q;scoreCount&q;:2283,&q;avgScore&q;:9.75295663600527,&q;fiveGradeAvgScore&q;:4.88,&q;updateTime&q;:1773543525445},&q;auditionEpisode&q;:{&q;episodeTitle&q;:&q;个人展示课&q;,&q;episodeVideoUrl&q;:&q;https://vod.fbstatic.cn/22e9ceb2vodbj1251001446/b269fc425145403709334963335/WjukmC5LPh8A.mp4?t=f2a4b300&a;us=4070880000&a;sign=8efff2e71e1428c94e20dd995c2853f2&q;},&q;memberOfCPC&q;:false,&q;tags&q;:null},&q;teachChannel&q;:1,&q;offline&q;:null,&q;duration&q;:7967,&q;hasAudition&q;:false,&q;bizType&q;:0,&q;bizId&q;:&q;726825&q;,&q;supportReplay&q;:true,&q;extraInfo&q;:null,&q;liveConfig&q;:{&q;episodeId&q;:10921979,&q;supportMultiGroup&q;:false,&q;exerciseBizType&q;:0,&q;videoDisplayType&q;:0,&q;avForwardType&q;:0,&q;useIntelligentRoom&q;:false,&q;hasStrokeKeynote&q;:true,&q;verticalModeType&q;:0,&q;originEpisodeId&q;:0,&q;supportRtmp&q;:false,&q;supportPk&q;:true,&q;supportLuckyBag&q;:true,&q;supportUserNoteStroke&q;:false,&q;communicateType&q;:0,&q;one2One&q;:false,&q;fakeLive&q;:false},&q;validStatus&q;:1,&q;supportLive&q;:true,&q;supportAiCatalog&q;:false,&q;hasIntelligentPen&q;:false,&q;useLocalRecording&q;:false,&q;useIntelligentRoom&q;:false,&q;hasSalePosition&q;:false,&q;hasEpisodeCards&q;:true,&q;lockedForShouna&q;:false,&q;needSignIn&q;:false,&q;needTeacherSignIn&q;:false,&q;enablePadPencil&q;:true,&q;displayExercise&q;:false,&q;supportLuckyBag&q;:true,&q;supportLivePk&q;:true},{&q;id&q;:10921980,&q;kePrefix&q;:&q;sydw&q;,&q;courseId&q;:6,&q;status&q;:3,&q;playStatus&q;:3,&q;type&q;:33,&q;recordingType&q;:0,&q;mediaType&q;:0,&q;title&q;:&q;【综应】精选好题 沉浸刷题&q;,&q;innerTitle&q;:&q;&q;,&q;startTime&q;:1754704800000,&q;endTime&q;:1754712000000,&q;teacher&q;:{&q;id&q;:33486,&q;userId&q;:52618928,&q;name&q;:&q;艾思莹&q;,&q;brief&q;:&q;粉笔优质讲师&q;,&q;desc&q;:&q;粉笔优质讲师\n6年一线教学经验，辅导学员数千人，累计授课评分4.9分，承接各类型线上线下精品班，深耕事业单位笔试，善于以考场思维审视题目，助力多位学员高分上岸。\n长期参与内部教研工作，定期参与真题解析录制，对最新命题方向、考试重点有深入研究。\n理论基础扎实，授课思路清晰，擅长理论与实际相结合。能够激发学员学习热情和自主意识，让学员可以在轻松愉快的氛围中学习，跟着老师节奏主动思考，深受学员一致好评和喜爱。&q;,&q;avatar&q;:&q;1798d8fc9d33bea.jpg&q;,&q;upperBodyPhoto&q;:null,&q;displayCoursePrefix&q;:&q;sydw&q;,&q;teacherStat&q;:{&q;teacherId&q;:33486,&q;episodeCount&q;:408,&q;scoreCount&q;:460,&q;avgScore&q;:9.839130434782604,&q;fiveGradeAvgScore&q;:4.92,&q;updateTime&q;:1773623079529},&q;auditionEpisode&q;:{&q;episodeTitle&q;:&q;社会现象&q;,&q;episodeVideoUrl&q;:&q;https://vod.fbstatic.cn/22e9ceb2vodbj1251001446/76dd9c915145403709537492897/eQAVoEQ87mAA.mp4?t=f2a4b300&a;us=4070880000&a;sign=ef57ee8d5c8eca5e1bcee39dbc785fe4&q;},&q;memberOfCPC&q;:false,&q;tags&q;:null},&q;teachChannel&q;:1,&q;offline&q;:null,&q;duration&q;:7595,&q;hasAudition&q;:false,&q;bizType&q;:0,&q;bizId&q;:&q;726825&q;,&q;supportReplay&q;:true,&q;extraInfo&q;:null,&q;liveConfig&q;:{&q;episodeId&q;:10921980,&q;supportMultiGroup&q;:false,&q;exerciseBizType&q;:0,&q;videoDisplayType&q;:0,&q;avForwardType&q;:0,&q;useIntelligentRoom&q;:false,&q;hasStrokeKeynote&q;:true,&q;verticalModeType&q;:0,&q;originEpisodeId&q;:0,&q;supportRtmp&q;:false,&q;supportPk&q;:true,&q;supportLuckyBag&q;:true,&q;supportUserNoteStroke&q;:false,&q;communicateType&q;:0,&q;one2One&q;:false,&q;fakeLive&q;:false},&q;validStatus&q;:1,&q;supportLive&q;:true,&q;supportAiCatalog&q;:false,&q;hasIntelligentPen&q;:false,&q;useLocalRecording&q;:false,&q;useIntelligentRoom&q;:false,&q;hasSalePosition&q;:false,&q;hasEpisodeCards&q;:true,&q;lockedForShouna&q;:false,&q;needSignIn&q;:false,&q;needTeacherSignIn&q;:false,&q;enablePadPencil&q;:true,&q;displayExercise&q;:false,&q;supportLuckyBag&q;:true,&q;supportLivePk&q;:true},{&q;id&q;:10921982,&q;kePrefix&q;:&q;sydw&q;,&q;courseId&q;:6,&q;status&q;:3,&q;playStatus&q;:3,&q;type&q;:33,&q;recordingType&q;:0,&q;mediaType&q;:0,&q;title&q;:&q;【言语】精选好题 沉浸刷题&q;,&q;innerTitle&q;:&q;&q;,&q;startTime&q;:1754712000000,&q;endTime&q;:1754719200000,&q;teacher&q;:{&q;id&q;:32923,&q;userId&q;:83087094,&q;name&q;:&q;杨优秀&q;,&q;brief&q;:&q;粉笔优质讲师&q;,&q;desc&q;:&q;粉笔优质教师\n8年一线教学授课经验，线上累计授课超1000小时，授课人数10000+，线下曾担任联考言语主讲老师，具有言语理解与表达科目丰富的实践经验及系统扎实的专业理论知识。线下与线上授课经验丰富，善于讲解联考、江苏、浙江、广东各省言语课程，对于言语题型有独到的见解，能够多方面把握学员需求，精准定位学员薄弱点。多次参加粉笔教研活动，参与笔试真题解析与精品班精品挑战选题，助力粉笔理论研发升级。积极参与各项比赛，曾获粉笔风采大赛“最具风格奖”，娓娓道来的授课风格，让学生在轻松的学习氛围中，用更简单的方法，找到更快捷的解题之道，深受广大学员的认可和好评。&q;,&q;avatar&q;:&q;1785e21dcfe8463.jpg&q;,&q;upperBodyPhoto&q;:null,&q;displayCoursePrefix&q;:&q;sydw&q;,&q;teacherStat&q;:{&q;teacherId&q;:32923,&q;episodeCount&q;:374,&q;scoreCount&q;:1626,&q;avgScore&q;:9.857318573185726,&q;fiveGradeAvgScore&q;:4.93,&q;updateTime&q;:1772881550179},&q;auditionEpisode&q;:null,&q;memberOfCPC&q;:false,&q;tags&q;:null},&q;teachChannel&q;:1,&q;offline&q;:null,&q;duration&q;:8040,&q;hasAudition&q;:false,&q;bizType&q;:0,&q;bizId&q;:&q;726825&q;,&q;supportReplay&q;:true,&q;extraInfo&q;:null,&q;liveConfig&q;:{&q;episodeId&q;:10921982,&q;supportMultiGroup&q;:false,&q;exerciseBizType&q;:0,&q;videoDisplayType&q;:0,&q;avForwardType&q;:0,&q;useIntelligentRoom&q;:false,&q;hasStrokeKeynote&q;:true,&q;verticalModeType&q;:0,&q;originEpisodeId&q;:0,&q;supportRtmp&q;:false,&q;supportPk&q;:true,&q;supportLuckyBag&q;:true,&q;supportUserNoteStroke&q;:false,&q;communicateType&q;:0,&q;one2One&q;:false,&q;fakeLive&q;:false},&q;validStatus&q;:1,&q;supportLive&q;:true,&q;supportAiCatalog&q;:false,&q;hasIntelligentPen&q;:false,&q;useLocalRecording&q;:false,&q;useIntelligentRoom&q;:false,&q;hasSalePosition&q;:false,&q;hasEpisodeCards&q;:true,&q;lockedForShouna&q;:false,&q;needSignIn&q;:false,&q;needTeacherSignIn&q;:false,&q;enablePadPencil&q;:true,&q;displayExercise&q;:false,&q;supportLuckyBag&q;:true,&q;supportLivePk&q;:true},{&q;id&q;:10850139,&q;kePrefix&q;:&q;sydw&q;,&q;courseId&q;:6,&q;status&q;:3,&q;playStatus&q;:3,&q;type&q;:33,&q;recordingType&q;:0,&q;mediaType&q;:0,&q;title&q;:&q;【公基法律】精选好题 沉浸刷题&q;,&q;innerTitle&q;:&q;&q;,&q;startTime&q;:1754719200000,&q;en