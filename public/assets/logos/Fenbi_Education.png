611,&q;kePrefix&q;:&q;sydw&q;,&q;courseId&q;:6,&q;status&q;:3,&q;playStatus&q;:3,&q;type&q;:33,&q;recordingType&q;:0,&q;mediaType&q;:0,&q;title&q;:&q;【公基法律】精选好题 沉浸刷题&q;,&q;innerTitle&q;:&q;&q;,&q;startTime&q;:1756094400000,&q;endTime&q;:1756101600000,&q;teacher&q;:{&q;id&q;:34129,&q;userId&q;:83514929,&q;name&q;:&q;刘思秀&q;,&q;brief&q;:&q;粉笔优质讲师&q;,&q;desc&q;:&q;粉笔优质教师\n六年一线教学经验，总授课时长累计超2500小时。多年深耕事业单位考试领域，教学经验丰富，紧跟考情时新热点，对考情、真题、命题方向理解深刻。粉笔事业单位笔试教研材料撰写人之一，四年模考命题经验，多次参加粉笔教研活动，分享授课经验心得，助力粉笔理论研发升级。多年小班带队老师，学员累计评分4.9，结班上岸率 72%，名下多位学员岗位第一入面。授课条理清晰，讲解风趣幽默，擅长化难为简，总结做题规律，将复杂的笔试知识点进行系统梳理，帮助学员把握知识点底层逻辑，减轻学员记忆负担，快速掌握笔试答题技巧。&q;,&q;avatar&q;:&q;1983b891b2af100.jpg&q;,&q;upperBodyPhoto&q;:null,&q;displayCoursePrefix&q;:&q;sydw&q;,&q;teacherStat&q;:{&q;teacherId&q;:34129,&q;episodeCount&q;:613,&q;scoreCount&q;:970,&q;avgScore&q;:9.721649484536082,&q;fiveGradeAvgScore&q;:4.86,&q;updateTime&q;:1773558647472},&q;auditionEpisode&q;:null,&q;memberOfCPC&q;:false,&q;tags&q;:null},&q;teachChannel&q;:1,&q;offline&q;:null,&q;duration&q;:7635,&q;hasAudition&q;:false,&q;bizType&q;:0,&q;bizId&q;:&q;726825&q;,&q;supportReplay&q;:true,&q;extraInfo&q;:null,&q;liveConfig&q;:{&q;episodeId&q;:10938611,&q;supportMultiGroup&q;:false,&q;exerciseBizType&q;:0,&q;videoDisplayType&q;:0,&q;avForwardType&q;:0,&q;useIntelligentRoom&q;:false,&q;hasStrokeKeynote&q;:true,&q;verticalModeType&q;:0,&q;originEpisodeId&q;:0,&q;supportRtmp&q;:false,&q;supportPk&q;:true,&q;supportLuckyBag&q;:true,&q;supportUserNoteStroke&q;:false,&q;communicateType&q;:0,&q;one2One&q;:false,&q;fakeLive&q;:false},&q;validStatus&q;:1,&q;supportLive&q;:true,&q;supportAiCatalog&q;:false,&q;hasIntelligentPen&q;:false,&q;useLocalRecording&q;:false,&q;useIntelligentRoom&q;:false,&q;hasSalePosition&q;:false,&q;hasEpisodeCards&q;:true,&q;lockedForShouna&q;:false,&q;needSignIn&q;:false,&q;needTeacherSignIn&q;:false,&q;enablePadPencil&q;:true,&q;displayExercise&q;:false,&q;supportLuckyBag&q;:true,&q;supportLivePk&q;:true},{&q;id&q;:10938614,&q;kePrefix&q;:&q;sydw&q;,&q;courseId&q;:6,&q;status&q;:3,&q;playStatus&q;:3,&q;type&q;:33,&q;recordingType&q;:0,&q;mediaType&q;:0,&q;title&q;:&q;【言语】精选好题 沉浸刷题&q;,&q;innerTitle&q;:&q;&q;,&q;startTime&q;:1756101600000,&q;endTime&q;:1756108800000,&q;teacher&q;:{&q;id&q;:16948,&q;userId&q;:69316245,&q;name&q;:&q;巨琼&q;,&q;brief&q;:&q;粉笔优质讲师&q;,&q;desc&q;:&q;粉笔优质教师\n6年以上一线教学授课经验，累计授课时长2000+，授课人数10000+，授课评分4.9分，累计获得学员好评上千条。具有扎实系统的言语专业知识体系且线上线下均授课经验丰富，线上授课涵盖联考、山东、安徽等各省言语课程，线下曾多次担任联考、江苏等省份言语主讲。长期参与言语科目教研工作，真题解析、模拟题撰写、参与《职测3000题》 单题录制等，全面了解事业单位各省份言语命题规律及答题技巧。教学中，曾获事业单位教师风采大赛“三等奖”，持续积极探索生动有趣的教学方式，精准把握言语考点，帮助学员快速理解并掌握言语技巧，能以独特的方法引导学员攻克难关，提升答题准确率与速度，深受学员认可，助力多名学员成功实现自己的职业目标。&q;,&q;avatar&q;:&q;1746cf3620ab526.jpg&q;,&q;upperBodyPhoto&q;:null,&q;displayCoursePrefix&q;:&q;sydw&q;,&q;teacherStat&q;:{&q;teacherId&q;:16948,&q;episodeCount&q;:595,&q;scoreCount&q;:2018,&q;avgScore&q;:9.865213082259663,&q;fiveGradeAvgScore&q;:4.93,&q;updateTime&q;:1773488367488},&q;auditionEpisode&q;:{&q;episodeTitle&q;:&q;个人展示课&q;,&q;episodeVideoUrl&q;:&q;https://vod.fbstatic.cn/22e9ceb2vodbj1251001446/c5adc5685145403709538521768/r1Y9MG5YjPwA.mp4?t=f2a4b300&a;us=4070880000&a;sign=e92eaa0857512f99b08ff349fc652a92&q;},&q;memberOfCPC&q;:false,&q;tags&q;:null},&q;teachChannel&q;:1,&q;offline&q;:null,&q;duration&q;:7239,&q;hasAudition&q;:false,&q;bizType&q;:0,&q;bizId&q;:&q;726825&q;,&q;supportReplay&q;:true,&q;extraInfo&q;:null,&q;liveConfig&q;:{&q;episodeId&q;:10938614,&q;supportMultiGroup&q;:false,&q;exerciseBizType&q;:0,&q;videoDisplayType&q;:0,&q;avForwardType&q;:0,&q;useIntelligentRoom&q;:false,&q;hasStrokeKeynote&q;:true,&q;verticalModeType&q;:0,&q;originEpisodeId&q;:0,&q;supportRtmp&q;:false,&q;supportPk&q;:true,&q;supportLuckyBag&q;:true,&q;supportUserNoteStroke&q;:false,&q;communicateType&q;:0,&q;one2One&q;:false,&q;fakeLive&q;:false},&q;validStatus&q;:1,&q;supportLive&q;:true,&q;supportAiCatalog&q;:false,&q;hasIntelligentPen&q;:false,&q;useLocalRecording&q;:false,&q;useIntelligentRoom&q;:false,&q;hasSalePosition&q;:false,&q;hasEpisodeCards&q;:true,&q;lockedForShouna&q;:false,&q;needSignIn&q;:false,&q;needTeacherSignIn&q;:false,&q;enablePadPencil&q;:true,&q;displayExercise&q;:false,&q;supportLuckyBag&q;:true,&q;supportLivePk&q;:true},{&q;id&q;:10938616,&q;kePrefix&q;:&q;sydw&q;,&q;courseId&q;:6,&q;status&q;:3,&q;playStatus&q;:3,&q;type&q;:33,&q;recordingType&q;:0,&q;mediaType&q;:0,&q;title&q;:&q;【综应】精选好题 沉浸刷题&q;,&q;innerTitle&q;:&q;&q;,&q;startTime&q;:1756108800000,&q;endTime&q;:1756116000000,&q;teacher&q;:{&q;id&q;:35908,&q;userId&q;:81360450,&q;name&q;:&q;林雨晴&q;,&q;brief&q;:&q;粉笔优质讲师&q;,&q;desc&q;:&q;粉笔优质讲师\n6年一线教学经验，辅导学员数千人，承接各类线上线下精品班，善于从考官思维审视题目，助力多位学员高分上岸；累计授课时长超千个小时，累计授课评分4.9分，深受学员认可；\n长期参与笔试教研工作，定期参与模拟题撰写、真题解析录制等，对最新命题方向、考试重点有深入研究；\n授课风格严谨而不乏幽默，擅长为学员量身定制有效提升解题能力的授课方案，让学员轻松掌握科目本质，目标明确针对提分。&q;,&q;avatar&q;:&q;193b4909bf0801c.jpg&q;,&q;upperBodyPhoto&q;:null,&q;displayCoursePrefix&q;:&q;sydw&q;,&q;teacherStat&q;:{&q;teacherId&q;:35908,&q;episodeCount&q;:324,&q;scoreCount&q;:674,&q;avgScore&q;:9.866468842729965,&q;fiveGradeAvgScore&q;:4.93,&q;updateTime&q;:1773546577229},&q;auditionEpisode&q;:{&q;episodeTitle&q;:&q;个人展示课&q;,&q;episodeVideoUrl&q;:&q;https://vod.fbstatic.cn/22e9ceb2vodbj1251001446/33875c205145403709543644434/6gvJN35dXAIA.mp4?t=f2a4b300&a;us=4070880000&a;sign=c135dd3259c53c86cfd11d55836ec0b2&q;},&q;memberOfCPC&q;:false,&q;tags&q;:null},&q;teachChannel&q;:1,&q;offline&q;:null,&q;duration&q;:7144,&q;hasAudition&q;:false,&q;bizType&q;:0,&q;bizId&q;:&q;726825&q;,&q;supportReplay&q;:true,&q;extraInfo&q;:null,&q;liveConfig&q;:{&q;episodeId&q;:10938616,&q;supportMultiGroup&q;:false,&q;exerciseBizType&q;:0,&q;videoDisplayType&q;:0,&q;avForwardType&q;:0,&q;useIntelligentRoom&q;:false,&q;hasStrokeKeynote&q;:true,&q;verticalModeType&q;:0,&q;originEpisodeId&q;:0,&q;supportRtmp&q;:false,&q;supportPk&q;:true,&q;supportLuckyBag&q;:true,&q;supportUserNoteStroke&q;:false,&q;communicateType&q;:0,&q;one2One&q;:false,&q;fakeLive&q;:false},&q;validStatus&q;:1,&q;supportLive&q;:true,&q;supportAiCatalog&q;:false,&q;hasIntelligentPen&q;:false,&q;useLocalRecording&q;:false,&q;useIntelligentRoom&q;:false,&q;hasSalePosition&q;:false,&q;hasEpisodeCards&q;:true,&q;lockedForShouna&q;:false,&q;needSignIn&q;:false,&q;needTeacherSignIn&q;:false,&q;enablePadPencil&q;:true,&q;displayExercise&q;:false,&q;supportLuckyBag&q;:true,&q;supportLivePk&q;:true},{&q;id&q;:10938825,&q;kePrefix&q;:&q;sydw&q;,&q;courseId&q;:6,&q;status&q;:3,&q;playStatus&q;:3,&q;type&q;:33,&q;recordingType&q;:0,&q;mediaType&q;:0,&q;title&q;:&q;【综应】精选好题 沉浸刷题&q;,&q;innerTitle&q;:&q;&q;,&q;startTime&q;:1756173600000,&q;endTime&q;:1756180800000,&q;teacher&q;:{&q;id&q;:38553,&q;userId&q;:68550168,&q;name&q;:&q;崔伟婷&q;,&q;brief&q;:&q;粉笔优质讲师&q;,&q;desc&q;:&q;粉笔优质教师\n多年深耕事业单位笔试，线上线下双轨授课，累计课时1500+，教学经验丰富。 精通综应、申论核心考点，兼具系统专业理论与实战教研经历，多次参与事业单位模拟题编写及解析打磨，对考情变化、命题规律理解深刻。 授课耐心细致、逻辑清晰，擅长结合实际场景拆解知识点，手把手引导学员将理论转化为答题能力，助力高效提分。&q;,&q;avatar&q;:&q;1983b8cd0938fc3.jpg&q;,&q;upperBodyPhoto&q;:null,&q;displayCoursePrefix&q;:&q;sydw&q;,&q;teacherStat&q;:{&q;teacherId&q;:38553,&q;episodeCount&q;:400,&q;scoreCount&q;:1897,&q;avgScore&q;:9.697416974169741,&q;fiveGradeAvgScore&q;:4.85,&q;updateTime&q;:1773125884452},&q;auditionEpisode&q;:{&q;episodeTitle&q;:&q;个人展示课&q;,&q;episodeVideoUrl&q;:&q;https://vod.fbstatic.cn/22e9ceb2vodbj1251001446/30f743a05145403707591723084/YyjElD5VJdgA.mp4?t=f2a4b300&a;us=4070880000&a;sign=af88950ebae760259e0bd24565a6ad0a&q;},&q;memberOfCPC&q;:false,&q;tags&q;:null},&q;teachChannel&q;:1,&q;offline&q;:null,&q;duration&q;:7034,&q;hasAudition&q;:false,&q;bizType&q;:0,&q;bizId&q;:&q;726825&q;,&q;supportReplay&q;:true,&q;extraInfo&q;:null,&q;liveConfig&q;:{&q;episodeId&q;:10938825,&q;supportMultiGroup&q;:false,&q;exerciseBizType&q;:0,&q;videoDisplayType&q;:0,&q;avForwardType&q;:0,&q;useIntelligentRoom&q;:false,&q;hasStrokeKeynote&q;:true,&q;verticalModeType&q;:0,&q;originEpisodeId&q;:0,&q;supportRtmp&q;:false,&q;supportPk&q;:true,&q;supportLuckyBag&q;:true,&q;supportUserNoteSt