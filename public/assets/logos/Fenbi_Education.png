&q;supportLivePk&q;:false},{&q;id&q;:11706799,&q;kePrefix&q;:&q;gwy&q;,&q;courseId&q;:1,&q;status&q;:0,&q;playStatus&q;:0,&q;type&q;:1,&q;recordingType&q;:0,&q;mediaType&q;:0,&q;title&q;:&q;早课-失踪死亡“休止符”：如何厘清失两者的民事关系&q;,&q;innerTitle&q;:&q;&q;,&q;startTime&q;:1776726000000,&q;endTime&q;:1776727800000,&q;teacher&q;:{&q;id&q;:29329,&q;userId&q;:59984840,&q;name&q;:&q;婉君&q;,&q;brief&q;:&q;粉笔公考常识、公安优质讲师&q;,&q;desc&q;:&q;       粉笔常识、公安优质老师。\n       性格耐心细致，善于把握学员个性化特点，因材施教，认真负责，对待课程一丝不苟。讲课生动形象，机智诙谐，听课体验好，学员可以在轻松愉快的氛围中学习，跟着老师节奏主动思考。老师同时注重“反模板”教学，助力学员走出答题模板与误区。&q;,&q;avatar&q;:&q;17cfe442bf3a975.jpg&q;,&q;upperBodyPhoto&q;:null,&q;displayCoursePrefix&q;:&q;gwy&q;,&q;teacherStat&q;:{&q;teacherId&q;:29329,&q;episodeCount&q;:300,&q;scoreCount&q;:21185,&q;avgScore&q;:9.837715364644751,&q;fiveGradeAvgScore&q;:4.92,&q;updateTime&q;:1773579682515},&q;auditionEpisode&q;:null,&q;memberOfCPC&q;:false,&q;tags&q;:null},&q;teachChannel&q;:1,&q;offline&q;:null,&q;duration&q;:1800,&q;hasAudition&q;:false,&q;bizType&q;:0,&q;bizId&q;:&q;773251&q;,&q;supportReplay&q;:true,&q;extraInfo&q;:null,&q;liveConfig&q;:{&q;episodeId&q;:11706799,&q;supportMultiGroup&q;:false,&q;exerciseBizType&q;:0,&q;videoDisplayType&q;:0,&q;avForwardType&q;:0,&q;useIntelligentRoom&q;:false,&q;hasStrokeKeynote&q;:false,&q;verticalModeType&q;:0,&q;originEpisodeId&q;:0,&q;supportRtmp&q;:false,&q;supportPk&q;:false,&q;supportLuckyBag&q;:false,&q;supportUserNoteStroke&q;:false,&q;communicateType&q;:0,&q;fakeLive&q;:false,&q;one2One&q;:false},&q;validStatus&q;:1,&q;supportLive&q;:true,&q;supportAiCatalog&q;:false,&q;hasIntelligentPen&q;:false,&q;useLocalRecording&q;:false,&q;useIntelligentRoom&q;:false,&q;hasSalePosition&q;:false,&q;hasEpisodeCards&q;:false,&q;lockedForShouna&q;:false,&q;needSignIn&q;:false,&q;needTeacherSignIn&q;:false,&q;enablePadPencil&q;:false,&q;displayExercise&q;:false,&q;supportLuckyBag&q;:false,&q;supportLivePk&q;:false},{&q;id&q;:11706800,&q;kePrefix&q;:&q;gwy&q;,&q;courseId&q;:1,&q;status&q;:0,&q;playStatus&q;:0,&q;type&q;:1,&q;recordingType&q;:0,&q;mediaType&q;:0,&q;title&q;:&q;晚课-热点夜话37&q;,&q;innerTitle&q;:&q;&q;,&q;startTime&q;:1776780000000,&q;endTime&q;:1776782700000,&q;teacher&q;:{&q;id&q;:2567,&q;userId&q;:43307158,&q;name&q;:&q;艾小丁&q;,&q;brief&q;:&q;粉笔面试研究院成员、高级面试讲师&q;,&q;desc&q;:&q;8年公考面试授课经验，粉笔大区面试教学教研负责人，主要承担国省考理论大课及各类线上公开课。有过多次面试高分实战经历。曾设计并主持多次粉笔面试老师培训会议，培训面试师资数千人。 \n艾小丁老师有多年一线授课经历与面试教研经验，灵活风趣，课堂氛围轻松。始终秉持“千人千面”的教学理念，善于引导学员理解面试的底层逻辑，发掘自身特点，从自己擅长的角度实现高效提升，成果显著。&q;,&q;avatar&q;:&q;19b0cf4f21e691e.jpg&q;,&q;upperBodyPhoto&q;:null,&q;displayCoursePrefix&q;:&q;gwy&q;,&q;teacherStat&q;:{&q;teacherId&q;:2567,&q;episodeCount&q;:1140,&q;scoreCount&q;:39146,&q;avgScore&q;:9.869054309508025,&q;fiveGradeAvgScore&q;:4.93,&q;updateTime&q;:1773589055187},&q;auditionEpisode&q;:{&q;episodeTitle&q;:&q;个人展示课&q;,&q;episodeVideoUrl&q;:&q;https://vod.fbstatic.cn/22e9ceb2vodbj1251001446/365026ea3270835013757549961/7azwde9iqIAA.mp4?t=f2a4b300&a;us=4070880000&a;sign=7ae333696ea68a3be68e8952550ff6ef&q;},&q;memberOfCPC&q;:false,&q;tags&q;:null},&q;teachChannel&q;:1,&q;offline&q;:null,&q;duration&q;:2700,&q;hasAudition&q;:false,&q;bizType&q;:0,&q;bizId&q;:&q;773251&q;,&q;supportReplay&q;:true,&q;extraInfo&q;:null,&q;liveConfig&q;:{&q;episodeId&q;:11706800,&q;supportMultiGroup&q;:false,&q;exerciseBizType&q;:0,&q;videoDisplayType&q;:0,&q;avForwardType&q;:0,&q;useIntelligentRoom&q;:false,&q;hasStrokeKeynote&q;:false,&q;verticalModeType&q;:0,&q;originEpisodeId&q;:0,&q;supportRtmp&q;:false,&q;supportPk&q;:false,&q;supportLuckyBag&q;:false,&q;supportUserNoteStroke&q;:false,&q;communicateType&q;:0,&q;fakeLive&q;:false,&q;one2One&q;:false},&q;validStatus&q;:1,&q;supportLive&q;:true,&q;supportAiCatalog&q;:false,&q;hasIntelligentPen&q;:false,&q;useLocalRecording&q;:false,&q;useIntelligentRoom&q;:false,&q;hasSalePosition&q;:false,&q;hasEpisodeCards&q;:false,&q;lockedForShouna&q;:false,&q;needSignIn&q;:false,&q;needTeacherSignIn&q;:false,&q;enablePadPencil&q;:false,&q;displayExercise&q;:false,&q;supportLuckyBag&q;:false,&q;supportLivePk&q;:false},{&q;id&q;:11706801,&q;kePrefix&q;:&q;gwy&q;,&q;courseId&q;:1,&q;status&q;:0,&q;playStatus&q;:0,&q;type&q;:1,&q;recordingType&q;:0,&q;mediaType&q;:0,&q;title&q;:&q;早课-成语登科计划（七）&q;,&q;innerTitle&q;:&q;&q;,&q;startTime&q;:1776812400000,&q;endTime&q;:1776815100000,&q;teacher&q;:{&q;id&q;:3198,&q;userId&q;:43782348,&q;name&q;:&q;安杰&q;,&q;brief&q;:&q;粉笔言语优质教师&q;,&q;desc&q;:&q;粉笔言语优质教师，硕士学历，10年公考授课经验，学员评分高达4.9分，被学员亲切称为“二舅”。授课端，善于把握考情趋势，将知识点融会贯通，迅速厘清重点难点。培训端，为行业培养上百名优秀教师。&q;,&q;avatar&q;:&q;171ee8a2fecad21.jpg&q;,&q;upperBodyPhoto&q;:null,&q;displayCoursePrefix&q;:&q;gwy&q;,&q;teacherStat&q;:{&q;teacherId&q;:3198,&q;episodeCount&q;:1375,&q;scoreCount&q;:532049,&q;avgScore&q;:9.863429872060653,&q;fiveGradeAvgScore&q;:4.93,&q;updateTime&q;:1773623129594},&q;auditionEpisode&q;:{&q;episodeTitle&q;:&q;个人展示课&q;,&q;episodeVideoUrl&q;:&q;https://vod.fbstatic.cn/22e9ceb2vodbj1251001446/9f9d6ba73560136621447577483/bsphLRtOyaAA.mp4?t=f2a4b300&a;us=4070880000&a;sign=615c6ec215235eec9be3da23e83f2652&q;},&q;memberOfCPC&q;:false,&q;tags&q;:null},&q;teachChannel&q;:1,&q;offline&q;:null,&q;duration&q;:2700,&q;hasAudition&q;:false,&q;bizType&q;:0,&q;bizId&q;:&q;773251&q;,&q;supportReplay&q;:true,&q;extraInfo&q;:null,&q;liveConfig&q;:{&q;episodeId&q;:11706801,&q;supportMultiGroup&q;:false,&q;exerciseBizType&q;:0,&q;videoDisplayType&q;:0,&q;avForwardType&q;:0,&q;useIntelligentRoom&q;:false,&q;hasStrokeKeynote&q;:false,&q;verticalModeType&q;:0,&q;originEpisodeId&q;:0,&q;supportRtmp&q;:false,&q;supportPk&q;:false,&q;supportLuckyBag&q;:false,&q;supportUserNoteStroke&q;:false,&q;communicateType&q;:0,&q;fakeLive&q;:false,&q;one2One&q;:false},&q;validStatus&q;:1,&q;supportLive&q;:true,&q;supportAiCatalog&q;:false,&q;hasIntelligentPen&q;:false,&q;useLocalRecording&q;:false,&q;useIntelligentRoom&q;:false,&q;hasSalePosition&q;:false,&q;hasEpisodeCards&q;:false,&q;lockedForShouna&q;:false,&q;needSignIn&q;:false,&q;needTeacherSignIn&q;:false,&q;enablePadPencil&q;:false,&q;displayExercise&q;:false,&q;supportLuckyBag&q;:false,&q;supportLivePk&q;:false},{&q;id&q;:11706802,&q;kePrefix&q;:&q;gwy&q;,&q;courseId&q;:1,&q;status&q;:0,&q;playStatus&q;:0,&q;type&q;:1,&q;recordingType&q;:0,&q;mediaType&q;:0,&q;title&q;:&q;晚课-热点夜话38&q;,&q;innerTitle&q;:&q;&q;,&q;startTime&q;:1776866400000,&q;endTime&q;:1776869100000,&q;teacher&q;:{&q;id&q;:12252,&q;userId&q;:60895825,&q;name&q;:&q;朱严&q;,&q;brief&q;:&q;粉笔面试研究院成员、高级面试讲师&q;,&q;desc&q;:&q;7年公考面试授课经验，粉笔培训部项目负责人之一，大区面试教学教研负责人。累计授课时长超过2000小时，负责培训师资2000+，粉笔客户端评分4.9分（满分5分）。主要负责师资面试能力提升的培训工作和一线教学教研工作，善于把自己在一线教学的感悟和实情融入日常师资的培训中，做到融会贯通。有过面试实战高分经历，曾在国考税务考试中从笔试压线进面，逆袭至总分第2名（岗位招3人）。 \n朱严老师教学培训严谨，能够聚焦不同地区的特色，准确把握面试学习的发力方向，授课力求精准化。授课耐心细致，注重因材施教，能够充分发挥学员的创造性。点评指导一针见血，帮助学员明确改进方向，让学员在面试学习中有更多的收获感，助力学员上岸。&q;,&q;avatar&q;:&q;1730e510528a227.jpg&q;,&q;upperBodyPhoto&q;:null,&q;displayCoursePrefix&q;:&q;gwy&q;,&q;teacherStat&q;:{&q;teacherId&q;:12252,&q;episodeCount&q;:492,&q;scoreCount&q;:7803,&q;avgScore&q;:9.870306292451621,&q;fiveGradeAvgScore&q;:4.94,&q;updateTime&q;:1773580246258},&q;auditionEpisode&q;:{&q;episodeTitle&q;:&q;个人展示课&q;,&q;episodeVideoUrl&q;:&q;https://vod.fbstatic.cn/22e9ceb2vodbj1251001446/623149aa1253642695625689240/CLuJL0kCqgQA.mp4?t=f2a4b300&a;us=4070880000&a;sign=39a2dbd4e450b7e9dc3d314f8957a992&q;},&q;memberOfCPC&q;:false,&q;tags&q;:null},&q;teachChannel&q;:1,&q;offline&q;:null,&q;duration&q;:2700,&q;hasAudition&q;:false,&q;bizType&q;:0,&q;bizId&q;:&q;773251&q;,&q;supportReplay&q;:true,&q;extraInfo&q;:null,&q;liveConfig&q;:{&q;episodeId&q;:11706802,&q;supportMultiGroup&q;:false,&q;exerciseBizType&q;:0,&q;videoDisplayType&q;:0,&q;avForwardType&q;:0,&q;useIntelligentRoom&q;:false,&q;hasStrokeKeynote&q;:false,&q;verticalModeType&q;:0,&q;originEpisodeId&q;:0,&q;supportRtmp&q;:false,&q;supportPk&q;:false,&q;supportLuckyBag&q;:false,&q;supportUserNoteStroke&q;:false,&q;communicateType&q;:0,&q;fakeLive&q;:false,&q;one2One&q;:false},&q;validStatus&q;:1,&q;supportLive&q;:true,&q;supportAiCatalog&q;:false,&q;hasIntelligentPen&q;:false,&q;useLocalRecording&q;:false,&q;useIntelligentRoom&q;:false,&q;hasSalePosition&q;:false,&q;hasEpisodeCards&q;:false,&q;lockedForShouna&q;:false,&q;needSignIn&q;:false,&q;needTeacherSignIn&q;:false,&q;enablePadPencil&q;:false,&q;displayExercise&q;:false,&q;supportLuckyBag&q;:false,&q;supportLivePk&q;:false},{&q;id&q;:11706803,&q;kePrefix&q;:&q;gwy&q;,&q;courseId&q;:1,&q;status&q;:0,&q;playStatus&q;:0,&q;type&q;:1,&q;recordingType&q;:0,&q;mediaType&q;:0,&q;title&q;:&q;早课-速记特征图之“框线图”&q;,&q;innerTitle&q;:&q;&q;,&q;startTime&q;:1776898800000,&q;endTime&q;:1776901500000,&q;teacher&q;:{&q;id&q;:4985,&q;userId&q;:49038142,&q;name&q;:&q;王丹娅&q;,&q;brief&q;:&q;粉笔判断优质教师&q;,&q;desc&q;:&q;粉笔判断优质教师，7年公考授课经验，长期致力于判断推理科目的教学及教研工作，善于拓展迁移，注重总结实用答题技巧。授课严谨细致又不失幽默，注重与学生的互动，擅长解决学员个性化问题，让学员可以在轻松愉快的氛围中得到个性化提升。希望在公考的道路上可以助您一臂之力。&q;,&q;avatar&q;:&q;1926fe0983d8fe5.jpg&q;,&q;upperBodyPhoto&q;:null,&q;displayCoursePrefix&q;:&q;gwy&q;,&q;teacherStat&q;:{&q;teacherId&q;:4985,&q;episodeCount&q;:1047,&q;scoreCount&q;:168734,&q;avgScore&q;:9.822015717045764,&q;fiveGradeAvgScore&q;:4.91,&q;updateTime&q;:1773617111112},&q;auditionEpisode&q;:{&q;episodeTitle&q;:&q;个人展示课&q;,&q;episodeVideoUrl&q;:&q;https://vod.fbstatic.cn/22e9ceb2vodbj1251001446/4fcec99d3560136621446406348/s1YvcVvNImkA.mp4?t=f2a4b300&a;us=4070880000&a;sign=d2e4f33d8224f412afae2f9043b0e59e&q;},&q;memberOfCPC&q;:false,&q;tags&q;:null},&q;teachChannel&q;:1,&q;offline&q;:null,&q;duration&q;:2700,&q;hasAudition&q;:false,&q;bizType&q;:0,&q;bizId&q;:&q;773251&q;,&q;supportReplay&q;:true,&q;extraInfo&q;:null,&q;liveConfig&q;:{&q;episodeId&q;:11706803,&q;supportMultiGroup&q;:false,&q;exerciseBizType&q;:0,&q;videoDisplayType&q;:0,&q;avForwardType&q;:0,&q;useIntelligentRoom&q;:false,&q;hasStrokeKeynote&q;:false,&q;verticalModeType&q;:0,&q;originEpisodeId&q;:0,&q;supportRtmp&q;:false,&q;supportPk&q;:false,&q;supportLuckyBag&q;:false,&q;supportUserNoteStroke&q;:false,&q;communicateType&q;:0,&q;fakeLive&q;:false,&q;one2One&q;:false},&q;validStatus&q;:1,&q;supportLive&q;:true,&q;supportAiCatalog&q;:false,&q;hasIntelligentPen&q;:false,&q;useLocalRecording&q;:false,&q;useIntelligentRoom&q;:false,&q;hasSalePosition&q;:false,&q;hasEpisodeCards&q;:false,&q;lockedForShouna&q;:false,&q;needSignIn&q;:false,&q;needTeacherSignIn&q;:false,&q;enablePadPencil&q;:false,&q;displayExercise&q;:false,&q;supportLuckyBag&q;:false,&q;supportLivePk&q;:false},{&q;id&q;:11706804,&q;kePrefix&q;:&q;gwy&q;,&q;courseId&q;:1,&q;status&q;:0,&q;playStatus&q;:0,&q;type&q;:1,&q;recordingType&q;:0,&q;mediaType&q;:0,&q;title&q;:&q;晚课-热点夜话39&q;,&q;innerTitle&q;:&q;&q;,&q;startTime&q;:1776952800000,&q;endTime&q;:1776955500000,&q;teacher&q;:{&q;id&q;:4791,&q;userId&q;:51346254,&q;name&q;:&q;林秋莹&q;,&q;brief&q;:&q;粉笔面试研究院成员、高级面试讲师&q;,&q;desc&q;:&q;8年公考面试授课经验，粉笔大区面试教学教研负责人，主要承担面试各类培训的策划组织、授课培训工作，同时承担国省考各类线上公开课，粉笔培训部项目负责人，获得粉笔”卓越教师”称号。 \n林秋莹老师凭借多年一线授课、培训、研发工作经验，掌握大量的面试方法技巧、干货知识素材与政府思维逻辑，深谙面试作答之道，能够把海量备考内容转化成精简的技巧内容。深入浅出，举一反三答出反套路有深度的内容，让学生高效备考，少走弯路。同时深度结合每位学生的特点，打造个性化，让学员在课堂中展现自我风采，轻松掌握面试。&q;,&q;avatar&q;:&q;1720cd00cce8f13.jpg&q;,&q;upperBodyPhoto&q;:null,&q;displayCoursePrefix&q;:&q;gwy&q;,&q;teacherStat&q;:{&q;teacherId&q;:4791,&q;episodeCount&q;:826,&q;scoreCount&q;:11458,&q;avgScore&q;:9.864025135276655,&q;fiveGradeAvgScore&q;:4.93,&q;updateTime&q;:1773623280272},&q;auditionEpisode&q;:{&q;episodeTitle&q;:&q;个人展示课&q;,&q;episodeVideoUrl&q;:&q;https://vod.fbstatic.cn/22e9ceb2vodbj1251001446/f6a7f0f73270835013753033481/r57CET8eRCMA.mp4?t=f2a4b300&a;us=4070880000&a;sign=ba11551c01f5b7967383de833b064957&q;},&q;memberOfCPC&q;:false,&q;tags&q;:null},&q;teachChannel&q;:1,&q;offline&q;:null,&q;duration&q;:2700,&q;hasAudition&q;:false,&q;bizType&q;:0,&q;bizId&q;:&q;773251&q;,&q;supportReplay&q;:true,&q;extraInfo&q;:null,&q;liveConfig&q;:{&q;episodeId&q;:11706804,&q;supportMultiGroup&q;:false,&q;exerciseBizType&q;:0,&q;videoDisplayType&q;:0,&q;avForwardType&q;:0,&q;useIntelligentRoom&q;:false,&q;hasStrokeKeynote&q;:false,&q;verticalModeType&q;:0,&q;originEpisodeId&q;:0,&q;supportRtmp&q;:false,&q;supportPk&q;:false,&q;supportLuckyBag&q;:false,&q;supportUserNoteStroke&q;:false,&q;communicateType&q;:0,&q;fakeLive&q;:false,&q;one2One&q;:false},&q;validStatus&q;:1,&q;supportLive&q;:true,&q;supportAiCatalog&q;:false,&q;hasIntelligentPen&q;:false,&q;useLocalRecording&q;:false,&q;useIntelligentRoom&q;:false,&q;hasSalePosition&q;:false,&q;hasEpisodeCards&q;:false,&q;lockedForShouna&q;:false,&q;needSignIn&q;:false,&q;needTeacherSignIn&q;:false,&q;enablePadPencil&q;:false,&q;displayExercise&q;:false,&q;supportLuckyBag&q;:false,&q;supportLivePk&q;:false},{&q;id&q;:11706805,&q;kePrefix&q;:&q;gwy&q;,&q;courseId&q;:1,&q;status&q;:0,&q;playStatus&q;:0,&q;type&q;:1,&q;recordingType&q;:0,&q;mediaType&q;:0,&q;title&q;:&q;早课-申论提分必学好文（七）&q;,&q;innerTitle&q;:&q;&q;,&q;startTime&q;:1776985200000,&q;endTime&q;:1776987900000,&q;teacher&q;:{&q;id&q;:1491,&q;userId&q;:40445632,&q;name&q;:&q;李纳&q;,&q;brief&q;:&q;粉笔申论优质教师&q;,&q;desc&q;:&q;粉笔申论优质老师，\n9年公考授课经验，打分人次超20万，学员评分高达4.9分。\n长期致力于公考研究，对试题有深刻的把握和独到的见解。注重因材施教，授课深入浅出、通俗易懂。富有激情又不失幽默，课堂氛围活跃。&q;,&q;avatar&q;:&q;17587d0e130748e.jpg&q;,&q;upperBodyPhoto&q;:null,&q;displayCoursePrefix&q;:&q;gwy&q;,&q;teacherStat&q;:{&q;teacherId&q;:1491,&q;episodeCount&q;:1101,&q;scoreCount&q;:402422,&q;avgScore&q;:9.854351899250036,&q;fiveGradeAvgScore&q;:4.93,&q;updateTime&q;:1773585181685},&q;auditionEpisode&q;:{&q;episodeTitle&q;:&q;个人展示课&q;,&q;episodeVideoUrl&q;:&q;https://vod.fbstatic.cn/22e9ceb2vodbj1251001446/a3c805883560136621447705797/W2Ucye2AjXgA.mp4?t=f2a4b300&a;us=4070880000&a;sign=a628916274f31ee68e9e0419239f215e&q;},&q;memberOfCPC&q;:false,&q;tags&q;:null},&q;teachChannel&q;:1,&q;offline&q;:null,&q;duration&q;:2700,&q;hasAudition&q;:false,&q;bizType&q;:0,&q;bizId&q;:&q;773251&q;,&q;supportReplay&q;:true,&q;extraInfo&q;:null,&q;liveConfig&q;:{&q;episodeId&q;:11706805,&q;supportMultiGroup&q;:false,&q;exerciseBizType&q;:0,&q;videoDisplayType&q;:0,&q;avForwardType&q;:0,&q;useIntelligentRoom&q;:false,&q;hasStrokeKeynote&q;:false,&q;verticalModeType&q;:0,&q;originEpisodeId&q;:0,&q;supportRtmp&q;:false,&q;supportPk&q;:false,&q;supportLuckyBag&q;:false,&q;supportUserNoteStroke&q;:false,&q;communicateType&q;:0,&q;fakeLive&q;:false,&q;one2One&q;:false},&q;validStatus&q;:1,&q;supportLive&q;:true,&q;supportAiCatalog&q;:false,&q;hasIntelligentPen&q;:false,&q;useLocalRecording&q;:false,&q;useIntelligentRoom&q;:false,&q;hasSalePosition&q;:false,&q;hasEpisodeCards&q;:false,&q;lockedForShouna&q;:false,&q;needSignIn&q;:false,&q;needTeacherSignIn&q;:false,&q;enablePadPencil&q;:false,&q;displayExercise&q;:false,&q;supportLuckyBag&q;:false,&q;supportLivePk&q;:false},{&q;id&q;:11706806,&q;kePrefix&q;:&q;gwy&q;,&q;courseId&q;:1,&q;status&q;:0,&q;playStatus&q;:0,&q;type&q;:1,&q;recordingType&q;:0,&q;mediaType&q;:0,&q;title&q;:&q;晚课-热点夜话40&q;,&q;innerTitle&q;:&q;&q;,&q;startTime&q;:1777039200000,&q;endTime&q;:1777041900000,&q;teacher&q;:{&q;id&q;:4432,&q;userId&q;:15393595,&q;name&q;:&q;唐圣楠&q;,&q;brief&q;:&q;粉笔面试研究院成员、高级面试讲师&q;,&q;desc&q;:&q;2年公务员工作经验，7年公考面试授课经验，粉笔卓越教师。\n唐圣楠老师有面试高分实战经历，熟悉政府各项工作。7年来深耕于面试教学一线，线下精品小班和线上千人大课兼顾，从业7年间累计授课人次超过 5000 人，授课时长超过 4000 小时，善于挖掘考生个人优势，突破面试瓶颈。同时是粉笔培训项目负责人，粉笔教学教研团队成员。每年受邀撰写省考面试高频考点和真题解析，主导撰写《真题精练50题》等图书，深度组织参与结构化和结构化小组面试理论的研发升级。&q;,&q;avatar&q;:&q;172984dddabdf3e.jpg&q;,&q;upperBodyPhoto&q;:null,&q;displayCoursePrefix&q;:&q;gwy&q;,&q;teacherStat&q;:{&q;teacherId&q;:4432,&q;episodeCount&q;:1180,&q;scoreCount&q;:9935,&q;avgScore&q;:9.871565173628591,&q;fiveGradeAvgScore&q;:4.94,&q;updateTime&q;:1773615380133},&q;auditionEpisode&q;:{&q;episodeTitle&q;:&q;个人展示课&q;,&q;episodeVideoUrl&q;:&q;https://vod.fbstatic.cn/22e9ceb2vodbj1251001446/e79772521397757910063658844/07JN4CCRa7UA.mp4?t=f2a4b300&a;us=4070880000&a;sign=aadad9d80d32fd5bc0a9f57128cdc699&q;},&q;memberOfCPC&q;:false,&q;tags&q;:null},&q;teachChannel&q;:1,&q;offline&q;:null,&q;duration&q;:2700,&q;hasAudition&q;:false,&q;bizType&q;:0,&q;bizId&q;:&q;773251&q;,&q;supportReplay&q;:true,&q;extraInfo&q;:null,&q;liveConfig&q;:{&q;episodeId&q;:11706806,&q;supportMultiGroup&q;:false,&q;exerciseBizType&q;:0,&q;videoDisplayType&q;:0,&q;avForwardType&q;:0,&q;useIntelligentRoom&q;:false,&q;hasStrokeKeynote&q;:false,&q;verticalModeType&q;:0,&q;originEpisodeId&q;:0,&q;supportRtmp&q;:false,&q;supportPk&q;:false,&q;supportLuckyBag&q;:false,&q;supportUserNoteStroke&q;:false,&q;communicateType&q;:0,&q;fakeLive&q;:false,&q;one2One&q;:false},&q;validStatus&q;:1,&q;supportLive&q;:true,&q;supportAiCatalog&q;:false,&q;hasIntelligentPen&q;:false,&q;useLocalRecording&q;:false,&q;useIntelligentRoom&q;:false,&q;hasSalePosition&q;:false,&q;hasEpisodeCards&q;:false,&q;lockedForShouna&q;:false,&q;needSignIn&q;:false,&q;needTeacherSignIn&q;:false,&q;enablePadPencil&q;:false,&q;displayExercise&q;:false,&q;supportLuckyBag&q;:false,&q;supportLivePk&q;:false},{&q;id&q;:11706807,&q;kePrefix&q;:&q;gwy&q;,&q;courseId&q;:1,&q;status&q;:0,&q;playStatus&q;:0,&q;type&q;:1,&q;recordingType&q;:0,&q;mediaType&q;:0,&q;title&q;:&q;早课-每月时政1&q;,&q;innerTitle&q;:&q;&q;,&q;startTime&q;:1777244400000,&q;endTime&q;:1777246200000,&q;teacher&q;:{&q;id&q;:4372,&q;userId&q;:45812058,&q;name&q;:&q;夏方军&q;,&q;brief&q;:&q;粉笔公基优质教师&q;,&q;desc&q;:&q;粉笔公基优质教师，岗位第一考入食药系统，一年编制工作经历，八年公考事业编授课经历。对政治理论、时政常识、面试有深入研究，擅长从热点、考情维度进行预判。授课细致耐心、思维发散清晰，学生的“小姨夫”。&q;,&q;avatar&q;:&q;19407933436c6d4.jpg&q;,&q;upperBodyPhoto&q;:null,&q;displayCoursePrefix&q;:&q;gwy&q;,&q;teacherStat&q;:{&q;teacherId&q;:4372,&q;episodeCount&q;:1059,&q;scoreCount&q;:209965,&q;avgScore&q;:9.894925344700331,&q;fiveGradeAvgScore&q;:4.95,&q;updateTime&q;:1773623280251},&q;auditionEpisode&q;:{&q;episodeTitle&q;:&q;个人展示课&q;,&q;episodeVideoUrl&q;:&q;https://vod.fbstatic.cn/22e9ceb2vodbj1251001446/65771a37243791580257902972/f0.mp4?t=f2a4b300&a;us=4070880000&a;sign=fe62d49b4742040836cd99e0a96d0768&q;},&q;memberOfCPC&q;:false,&q;tags&q;:null},&q;teachChannel&q;:1,&q;offline&q;:null,&q;duration&q;:1800,&q;hasAudition&q;:false,&q;bizType&q;:0,&q;bizId&q;:&q;773251&q;,&q;supportReplay&q;:true,&q;extraInfo&q;:null,&q;liveConfig&q;:{&q;episodeId&q;:11706807,&q;supportMultiGroup&q;:false,&q;exerciseBizType&q;:0,&q;videoDisplayType&q;:0,&q;avForwardType&q;:0,&q;useIntelligentRoom&q;:false,&q;hasStrokeKeynote&q;:false,&q;verticalModeType&q;:0,&q;originEpisodeId&q;:0,&q;supportRtmp&q;:false,&q;supportPk&q;:false,&q;supportLuckyBag&q;:false,&q;supportUserNoteStroke&q;:false,&q;communicateType&q;:0,&q;fakeLive&q;:false,&q;one2One&q;:false},&q;validStatus&q;:1,&q;supportLive&q;:true,&q;supportAiCatalog&q;:false,&q;hasIntelligentPen&q;:false,&q;useLocalRecording&q;:false,&q;useIntelligentRoom&q;:false,&q;hasSalePosition&q;:false,&q;hasEpisodeCards&q;:false,&q;lockedForShouna&q;:false,&q;needSignIn&q;:false,&q;needTeacherSignIn&q;:false,&q;enablePadPencil&q;:false,&q;displayExercise&q;:false,&q;supportLuckyBag&q;:false,&q;supportLivePk&q;:false},{&q;id&q;:11706808,&q;kePrefix&q;:&q;gwy&q;,&q;courseId&q;:1,&q;status&q;:0,&q;playStatus&q;:0,&q;type&q;:1,&q;recordingType&q;:0,&q;mediaType&q;:0,&q;title&q;:&q;晚课-热点夜话41&q;,&q;innerTitle&q;:&q;&q;,&q;startTime&q;:1777298400000,&q;endTime&q;:1777301100000,&q;teacher&q;:{&q;id&q;:13823,&q;userId&q;:58626581,&q;name&q;:&q;王微&q;,&q;brief&q;:&q;粉笔面试优质教师&q;,&q;desc&q;:&q;       粉笔面试优质教师\n       大区面试教学教研负责人，粉笔面试大课骨干教师，人气面试讲师，高级培训师，直播工作核心教师，曾任某线上公益就业平台主持人。\n8年公考面试授课经验，累计授课时长15000h+，授课学员100000+，累计培训师资5000+；主要承担国省考理论大课、各类线上公开课及平台直播等授课任务，并参与组织多次授课研讨、图书撰写、解析编撰等工作。 授课亲切自然，富有激情，逻辑清晰，讲授内容通俗易懂接地气，深度高度两相宜。深谙面试学习重点难点，善于抓取学员问题并逐个击破，引导学员回归面试本质，让思维不断发散，用真情打动考官！       \n       粉笔教研教学团队成员，参与粉笔多省的教学研发工作，受邀出镜录制面试真题示范答题 22 道，并在粉笔题库进行展示。参加 22 次粉笔面试授课研讨会议，全面把握公考面试命题趋势及最新考情，积累丰富面试知识。参加 48 次粉笔面试教研活动，分享授课经验心得，助力粉笔面试理论研发升级。​&q;,&q;avatar&q;:&q;173998e78802a13.jpg&q;,&q;upperBodyPhoto&q;:null,&q;displayCoursePrefix&q;:&q;gwy&q;,&q;teacherStat&q;:{&q;teacherId&q;:13823,&q;episodeCount&q;:642,&q;scoreCount&q;:30161,&q;avgScore&q;:9.86107887669507,&q;fiveGradeAvgScore&q;:4.93,&q;updateTime&q;:1773574398582},&q;auditionEpisode&q;:{&q;episodeTitle&q;:&q;个人展示课&q;,&q;episodeVideoUrl&q;:&q;https://vod.fbstatic.cn/22e9ceb2vodbj1251001446/ad4d45cf243791580414529514/f0.mp4?t=f2a4b300&a;us=4070880000&a;sign=b8b6ba805911da7e41d00c7ce19dfacd&q;},&q;memberOfCPC&q;:false,&q;tags&q;:null},&q;teachChannel&q;:1,&q;offline&q;:null,&q;duration&q;:2700,&q;hasAudition&q;:false,&q;bizType&q;:0,&q;bizId&q;:&q;773251&q;,&q;supportReplay&q;:true,&q;extraInfo&q;:null,&q;liveConfig&q;:{&q;episodeId&q;:11706808,&q;supportMultiGroup&q;:false,&q;exerciseBizType&q;:0,&q;videoDisplayType&q;:0,&q;avForwardType&q;:0,&q;useIntelligentRoom&q;:false,&q;hasStrokeKeynote&q;:false,&q;verticalModeType&q;:0,&q;originEpisodeId&q;:0,&q;supportRtmp&q;:false,&q;supportPk&q;:false,&q;supportLuckyBag&q;:false,&q;supportUserNoteStroke&q;:false,&q;communicateType&q;:0,&q;fakeLive&q;:false,&q;one2One&q;:false},&q;validStatus&q;:1,&q;supportLive&q;:true,&q;supportAiCatalog&q;:false,&q;hasIntelligentPen&q;:false,&q;useLocalRecording&q;:false,&q;useIntelligentRoom&q;:false,&q;hasSalePosition&q;:false,&q;hasEpisodeCards&q;:false,&q;lockedForShouna&q;:false,&q;needSignIn&q;:false,&q;needTeacherSignIn&q;:false,&q;enablePadPencil&q;:false,&q;displayExercise&q;:false,&q;supportLuckyBag&q;:false,&q;supportLivePk&q;:false},{&q;id&q;:11706809,&q;kePrefix&q;:&q;gwy&q;,&q;courseId&q;:1,&q;status&q;:0,&q;playStatus&q;:0,&q;type&q;:1,&q;recordingType&q;:0,&q;mediaType&q;:0,&q;title&q;:&q;早课-每月时政2&q;,&q;innerTitle&q;:&q;&q;,&q;startTime&q;:1777330800000,&q;endTime&q;:1777332600000,&q;teacher&q;:{&q;id&q;:11676,&q;userId&q;:44787868,&q;name&q;:&q;刘鸿&q;,&q;brief&q;:&q;粉笔公基优质讲师&q;,&q;desc&q;:&q;粉笔公考常识、公共基础知识优质讲师，累计授课1W+。9年公考培训经验，常年从事一线授课工作。对马克思主义哲学、中共党史、中国特色社会主义理论体系、大政方针时事政治等政治理论有系统研究。授课脉络清晰重点突出，课堂风格激情幽默，擅长学员备考规划指导及技巧点拨。&q;,&q;avatar&q;:&q;192d26d60f9ea18.jpg&q;,&q;upperBodyPhoto&q;:null,&q;displayCoursePrefix&q;:&q;gwy&q;,&q;teacherStat&q;:{&q;teacherId&q;:11676,&q;episodeCount&q;:764,&q;scoreCount&q;:235431,&q;avgScore&q;:9.907361392509907,&q;fiveGradeAvgScore&q;:4.95,&q;updateTime&q;:1773623300330},&q;auditionEpisode&q;:null,&q;memberOfCPC&q;:false,&q;tags&q;:null},&q;teachChannel&q;:1,&q;offline&q;:null,&q;duration&q;:1800,&q;hasAudition&q;:false,&q;bizType&q;:0,&q;bizId&q;:&q;773251&q;,&q;supportReplay&q;:true,&q;extraInfo&q;:null,&q;liveConfig&q;:{&q;episodeId&q;:11706809,&q;supportMultiGroup&q;:false,&q;exerciseBizType&q;:0,&q;videoDisplayType&q;:0,&q;avForwardType&q;:0,&q;useIntelligentRoom&q;:false,&q;hasStrokeKeynote&q;:false,&q;verticalModeType&q;:0,&q;originEpisodeId&q;:0,&q;supportRtmp&q;:false,&q;supportPk&q;:false,&q;supportLuckyBag&q;:false,&q;supportUserNoteStroke&q;:false,&q;communicateType&q;:0,&q;fakeLive&q;:false,&q;one2One&q;:false},&q;validStatus&q;:1,&q;supportLive&q;:true,&q;supportAiCatalog&q;:false,&q;hasIntelligentPen&q;:false,&q;useLocalRecording&q;:false,&q;useIntelligentRoom&q;:false,&q;hasSalePosition&q;:false,&q;hasEpisodeCards&q;:false,&q;lockedForShouna&q;:false,&q;needSignIn&q;:false,&q;needTeacherSignIn&q;:false,&q;enablePadPencil&q;:false,&q;displayExercise&q;:false,&q;supportLuckyBag&q;:false,&q;supportLivePk&q;:false},{&q;id&q;:11706810,&q;kePrefix&q;:&q;gwy&q;,&q;courseId&q;:1,&q;status&q;:0,&q;playStatus&q;:0,&q;type&q;:1,&q;recordingType&q;:0,&q;mediaType&q;:0,&q;title&q;:&q;晚课-热点夜话42&q;,&q;innerTitle&q;:&q;&q;,&q;startTime&q;:1777384800000,&q;endTime&q;:1777387500000,&q;teacher&q;:{&q;id&q;:4345,&q;userId&q;:49646700,&q;name&q;:&q;马影&q;,&q;brief&q;:&q;粉笔面试研究院成员、高级面试讲师&q;,&q;desc&q;:&q;       7 年公考面试授课经验，粉笔华南大区面试教学教研负责人，主要承担国省考理论大课及各类线上公开课。曾任粉笔面试培训负责人，作为主培训师培训面试师资数千人。 \n       马影老师多年深耕授课一线，面试教学教研经验丰富，授课逻辑清晰，讲解言简意赅，始终相信“复杂的不是问题，而是看问题的眼睛，好老师应该把复杂的知识简单化，而不是把简单的知识复杂化。”&q;,&q;avatar&q;:&q;171831fc08abd68.png&q;,&q;upperBodyPhoto&q;:null,&q;displayCoursePrefix&q;:&q;gwy&q;,&q;teacherStat&q;:{&q;teacherId&q;:4345,&q;episodeCount&q;:772,&q;scoreCount&q;:27886,&q;avgScore&q;:9.866456286308543,&q;fiveGradeAvgScore&q;:4.93,&q;updateTime&q;:1773621596496},&q;auditionEpisode&q;:{&q;episodeTitle&q;:&q;个人展示课&q;,&q;episodeVideoUrl&q;:&q;https://vod.fbstatic.cn/22e9ceb2vodbj1251001446/2d1f97403270835013757169233/fVNXhL9Rzi8A.mp4?t=f2a4b300&a;us=4070880000&a;sign=c498a50a2a0932f505e4290200e585b7&q;},&q;memberOfCPC&q;:false,&q;tags&q;:null},&q;teachChannel&q;:1,&q;offline&q;:null,&q;duration&q;:2700,&q;hasAudition&q;:false,&q;bizType&q;:0,&q;bizId&q;:&q;773251&q;,&q;supportReplay&q;:true,&q;extraInfo&q;:null,&q;liveConfig&q;:{&q;episodeId&q;:11706810,&q;supportMultiGroup&q;:false,&q;exerciseBizType&q;:0,&q;videoDisplayType&q;:0,&q;avForwardType&q;:0,&q;useIntelligentRoom&q;:false,&q;hasStrokeKeynote&q;:false,&q;verticalModeType&q;:0,&q;originEpisodeId&q;:0,&q;supportRtmp&q;:false,&q;supportPk&q;:false,&q;supportLuckyBag&q;:false,&q;supportUserNoteStroke&q;:false,&q;communicateType&q;:0,&q;fakeLive&q;:false,&q;one2One&q;:false},&q;validStatus&q;:1,&q;supportLive&q;:true,&q;supportAiCatalog&q;:false,&q;hasIntelligentPen&q;:false,&q;useLocalRecording&q;:false,&q;useIntelligentRoom&q;:false,&q;hasSalePosition&q;:false,&q;hasEpisodeCards&q;:false,&q;lockedForShouna&q;:false,&q;needSignIn&q;:false,&q;needTeacherSignIn&q;:false,&q;enablePadPencil&q;:false,&q;displayExercise&q;:false,&q;supportLuckyBag&q;:false,&q;supportLivePk&q;:false},{&q;id&q;:11706811,&q;kePrefix&q;:&q;gwy&q;,&q;courseId&q;:1,&q;status&q;:0,&q;playStatus&q;:0,&q;type&q;:1,&q;recordingType&q;:0,&q;mediaType&q;:0,&q;title&q;:&q;早课-每月时政3&q;,&q;innerTitle&q;:&q;&q;,&q;startTime&q;:1777417200000,&q;endTime&q;:1777419000000,&q;teacher&q;:{&q;id&q;:83780,&q;userId&q;:161829498,&q;name&q;:&q;姜倩倩&q;,&q;brief&q;:&q;粉笔公基优质教师&q;,&q;desc&q;:&q;       粉笔公基优质教师。\n      8年公考授课经验，985高校毕业。从业以来授课人数超5000人，授课时长超1w小时。\n是课堂的“双面手”：一面是严谨的“知识匠人”，用逻辑的刻刀雕琢思维；一面是温暖的“心灵画师”，用共情的色彩疏解学生的情绪。长期深耕在教学、教研一线，有扎实的理论功底，有成熟的实践经验。深入研究国省考、事业单位、三支一扶等各类笔试考情及命题特色，有对针对性的讲解知识点。授课思路清晰，讲解细致全面。课堂上认真负责，内容深入浅出。深受学员的好评。&q;,&q;avatar&q;:&q;19b25114d11aa4b.jpg&q;,&q;upperBodyPhoto&q;:null,&q;displayCoursePrefix&q;:&q;gwy&q;,&q;teacherStat&q;:{&q;teacherId&q;:83780,&q;episodeCount&q;:93,&q;scoreCount&q;:205,&q;avgScore&q;:9.902439024390244,&q;fiveGradeAvgScore&q;:4.95,&q;updateTime&q;:1773582800581},&q;auditionEpisode&q;:null,&q;memberOfCPC&q;:false,&q;tags&q;:null},&q;teachChannel&q;:1,&q;offline&q;:null,&q;duration&q;:1800,&q;hasAudition&q;:false,&q;bizType&q;:0,&q;bizId&q;:&q;773251&q;,&q;supportReplay&q;:true,&q;extraInfo&q;:null,&q;liveConfig&q;:{&q;episodeId&q;:11706811,&q;supportMultiGroup&q;:false,&q;exerciseBizType&q;:0,&q;videoDisplayType&q;:0,&q;avForwardType&q;:0,&q;useIntelligentRoom&q;:false,&q;hasStrokeKeynote&q;:false,&q;verticalModeType&q;:0,&q;originEpisodeId&q;:0,&q;supportRtmp&q;:false,&q;supportPk&q;:false,&q;supportLuckyBag&q;:false,&q;supportUserNoteStroke&q;:false,&q;communicateType&q;:0,&q;fakeLive&q;:false,&q;one2One&q;:false},&q;validStatus&q;:1,&q;supportLive&q;:true,&q;supportAiCatalog&q;:false,&q;hasIntelligentPen&q;:false,&q;useLocalRecording&q;:false,&q;useIntelligentRoom&q;:false,&q;hasSalePosition&q;:false,&q;hasEpisodeCards&q;:false,&q;lockedForShouna&q;:false,&q;needSignIn&q;:false,&q;needTeacherSignIn&q;:false,&q;enablePadPencil&q;:false,&q;displayExercise&q;:false,&q;supportLuckyBag&q;:false,&q;supportLivePk&q;:false},{&q;id&q;:11706812,&q;kePrefix&q;:&q;gwy&q;,&q;courseId&q;:1,&q;status&q;:0,&q;playStatus&q;:0,&q;type&q;:1,&q;recordingType&q;:0,&q;mediaType&q;:0,&q;title&q;:&q;晚课-热点夜话43&q;,&q;innerTitle&q;:&q;&q;,&q;startTime&q;:1777471200000,&q;endTime&q;:1777473900000,&q;teacher&q;:{&q;id&q;:5201,&q;userId&q;:41358262,&q;name&q;:&q;刘秋实&q;,&q;brief&q;:&q;粉笔面试研究院成员、高级面试讲师&q;,&q;desc&q;:&q;8年公考面试授课经验，粉笔大区面试教学教研负责人，主要担任粉笔面试师资的培训师，参与组织各类授课研讨会议和培训工作，培训师资千余人，承担国省考理论大课及各类线上公开课，参与负责面试教研、题本研发等工作，曾获得粉笔“卓越教师”称号，高分实战经验丰富。\n刘秋实老师秉承着“我的梦想就是帮学生实现梦想”的教学目标，和“虚心涵泳、居敬持志”的教育理念，深谙面试答题逻辑，善于寻找命题的趋势和规律，发掘学生自身优势，授课风格轻松幽默、温柔细致、逻辑缜密、严谨专业，致力于去模板化答题和“自信、自主、自然”的精彩表达，帮助学生在面试学习中遇到不一样的自己。&q;,&q;avatar&q;:&q;1720cd2d2210cf1.jpg&q;,&q;upperBodyPhoto&q;:null,&q;displayCoursePrefix&q;:&q;gwy&q;,&q;teacherStat&q;:{&q;teacherId&q;:5201,&q;episodeCount&q;:1163,&q;scoreCount&q;:11921,&q;avgScore&q;:9.812431842966207,&q;fiveGradeAvgScore&q;:4.91,&q;updateTime&q;:1773605088494},&q;auditionEpisode&q;:{&q;episodeTitle&q;:&q;个人展示课&q;,&q;episodeVideoUrl&q;:&q;https://vod.fbstatic.cn/22e9ceb2vodbj1251001446/d434698e243791580126493171/f0.mp4?t=f2a4b300&a;us=4070880000&a;sign=91827eb53851e204f0052b8f6d5ec28d&q;},&q;memberOfCPC&q;:false,&q;tags&q;:null},&q;teachChannel&q;:1,&q;offline&q;:null,&q;duration&q;:2700,&q;hasAudition&q;:false,&q;bizType&q;:0,&q;bizId&q;:&q;773251&q;,&q;supportReplay&q;:true,&q;extraInfo&q;:null,&q;liveConfig&q;:{&q;episodeId&q;:11706812,&q;supportMultiGroup&q;:false,&q;exerciseBizType&q;:0,&q;videoDisplayType&q;:0,&q;avForwardType&q;:0,&q;useIntelligentRoom&q;:false,&q;hasStrokeKeynote&q;:false,&q;verticalModeType&q;:0,&q;originEpisodeId&q;:0,&q;supportRtmp&q;:false,&q;supportPk&q;:false,&q;supportLuckyBag&q;:false,&q;supportUserNoteStroke&q;:false,&q;communicateType&q;:0,&q;fakeLive&q;:false,&q;one2One&q;:false},&q;validStatus&q;:1,&q;supportLive&q;:true,&q;supportAiCatalog&q;:false,&q;hasIntelligentPen&q;:false,&q;useLocalRecording&q;:false,&q;useIntelligentRoom&q;:false,&q;hasSalePosition&q;:false,&q;hasEpisodeCards&q;:false,&q;lockedForShouna&q;:false,&q;needSignIn&q;:false,&q;needTeacherSignIn&q;:false,&q;enablePadPencil&q;:false,&q;displayExercise&q;:false,&q;supportLuckyBag&q;:false,&q;supportLivePk&q;:false},{&q;id&q;:11706813,&q;kePrefix&q;:&q;gwy&q;,&q;courseId&q;:1,&q;status&q;:0,&q;playStatus&q;:0,&q;type&q;:1,&q;recordingType&q;:0,&q;mediaType&q;:0,&q;title&q;:&q;早课-每月时政4&q;,&q;innerTitle&q;:&q;&q;,&q;startTime&q;:1777503600000,&q;endTime&q;:1777505400000,&q;teacher&q;:{&q;id&q;:11249,&q;userId&q;:64782764,&q;name&q;:&q;刘烨&q;,&q;brief&q;:&q;粉笔公基、常识优质教师&q;,&q;desc&q;:&q;粉笔公基、常识优质教师。\n9年一线授课教研经验，累计授课时长超1w小时，学员评分高达4.9分。老师始终以生动有趣、激发学生思维为教学宗旨，善于将课堂内容化繁为简、化难为易，将晦涩知识通过日常生活的案例呈现，使学员在较短时间内能够更清晰地掌握所学知识。&q;,&q;avatar&q;:&q;192d26d6a1107c0.jpg&q;,&q;upperBodyPhoto&q;:null,&q;displayCoursePrefix&q;:&q;gwy&q;,&q;teacherStat&q;:{&q;teacherId&q;:11249,&q;episodeCount&q;:861,&q;scoreCount&q;:51878,&q;avgScore&q;:9.866263155865685,&q;fiveGradeAvgScore&q;:4.93,&q;updateTime&q;:1773622237480},&q;auditionEpisode&q;:null,&q;memberOfCPC&q;:false,&q;tags&q;:null},&q;teachChannel&q;:1,&q;offline&q;:null,&q;duration&q;:1800,&q;hasAudition&q;:false,&q;bizType&q;:0,&q;bizId&q;:&q;773251&q;,&q;supportReplay&q;:true,&q;extraInfo&q;:null,&q;liveConfig&q;:{&q;episodeId&q;:11706813,&q;supportMultiGroup&q;:false,&q;exerciseBizType&q;:0,&q;videoDisplayType&q;:0,&q;avForwardType&q;:0,&q;useIntelligentRoom&q;:false,&q;hasStrokeKeynote&q;:false,&q;verticalModeType&q;:0,&q;originEpisodeId&q;:0,&q;supportRtmp&q;:false,&q;supportPk&q;:false,&q;supportLuckyBag&q;:false,&q;supportUserNoteStroke&q;:false,&q;communicateType&q;:0,&q;fakeLive&q;:false,&q;one2One&q;:false},&q;validStatus&q;:1,&q;supportLive&q;:true,&q;supportAiCatalog&q;:false,&q;hasIntelligentPen&q;:false,&q;useLocalRecording&q;:false,&q;useIntelligentRoom&q;:false,&q;hasSalePosition&q;:false,&q;hasEpisodeCards&q;:false,&q;lockedForShouna&q;:false,&q;needSignIn&q;:false,&q;needTeacherSignIn&q;:false,&q;enablePadPencil&q;:false,&q;displayExercise&q;:false,&q;supportLuckyBag&q;:false,&q;supportLivePk&q;:false},{&q;id&q;:11706814,&q;kePrefix&q;:&q;gwy&q;,&q;courseId&q;:1,&q;status&q;:0,&q;playStatus&q;:0,&q;type&q;:1,&q;recordingType&q;:0,&q;mediaType&q;:0,&q;title&q;:&q;晚课-热点夜话44&q;,&q;innerTitle&q;:&q;&q;,&q;startTime&q;:1777557600000,&q;endTime&q;:1777560300000,&q;teacher&q;:{&q;id&q;:3184,&q;userId&q;:16570049,&q;name&q;:&q;赵公梓&q;,&q;brief&q;:&q;粉笔面试优质教师&q;,&q;desc&q;:&q;       粉笔面试优质教师。\n       2017年从事公考教学工作，授课耐心细致、严谨认真，在给予指导的同时，帮助学生调整心态积极备考。教学注重系统思维，带领学生以清晰的逻辑思路直面问题；授课内容丰富，为学生提供海量答题内容参考；倡导个性化教学，帮助学生短期内形成特色答题风格。\n       粉笔面试教研教学团队成员。受邀参与命制面试模拟预测题目，国省考面试真题解析撰写，并收录至粉笔面试题库；受邀录制面试真题示范答题，并在粉笔题库进行展示；受邀参与《粉笔晨读》等图书编辑撰写工作；多次参与粉笔组织的各类授课研讨会议和面试教研活动，共同助力粉笔面试理论的研发与升级。&q;,&q;avatar&q;:&q;171861d7c8d1831.jpg&q;,&q;upperBodyPhoto&q;:null,&q;displayCoursePrefix&q;:&q;gwy&q;,&q;teacherStat&q;:{&q;teacherId&q;:3184,&q;episodeCount&q;:1543,&q;scoreCount&q;:10976,&q;avgScore&q;:9.847485422740515,&q;fiveGradeAvgScore&q;:4.92,&q;updateTime&q;:1773622909183},&q;auditionEpisode&q;:{&q;episodeTitle&q;:&q;个人展示课&q;,&q;episodeVideoUrl&q;:&q;https://vod.fbstatic.cn/22e9ceb2vodbj1251001446/702e6d723270835014228008314/AU0Hkzm5lf8A.mp4?t=f2a4b300&a;us=4070880000&a;sign=2085272ea9e042a7ec8e7019cfef691e&q;},&q;memberOfCPC&q;:false,&q;tags&q;:null},&q;teachChannel&q;:1,&q;offline&q;:null,&q;duration&q;:2700,&q;hasAudition&q;:false,&q;bizType&q;:0,&q;bizId&q;:&q;773251&q;,&q;supportReplay&q;:true,&q;extraInfo&q;:null,&q;liveConfig&q;:{&q;episodeId&q;:11706814,&q;supportMultiGroup&q;:false,&q;exerciseBizType&q;:0,&q;videoDisplayType&q;:0,&q;avForwardType&q;:0,&q;useIntelligentRoom&q;:false,&q;hasStrokeKeynote&q;:false,&q;verticalModeType&q;:0,&q;originEpisodeId&q;:0,&q;supportRtmp&q;:false,&q;supportPk&q;:false,&q;supportLuckyBag&q;:false,&q;supportUserNoteStroke&q;:false,&q;communicateType&q;:0,&q;fakeLive&q;:false,&q;one2One&q;:false},&q;validStatus&q;:1,&q;supportLive&q;:true,&q;supportAiCatalog&q;:false,&q;hasIntelligentPen&q;:false,&q;useLocalRecording&q;:false,&q;useIntelligentRoom&q;:false,&q;hasSalePosition&q;:false,&q;hasEpisodeCards&q;:false,&q;lockedForShouna&q;:false,&q;needSignIn&q;:false,&q;needTeacherSignIn&q;:false,&q;enablePadPencil&q;:false,&q;displayExercise&q;:false,&q;supportLuckyBag&q;:false,&q;supportLivePk&q;:false},{&q;id&q;:11706815,&q;kePrefix&q;:&q;gwy&q;,&q;courseId&q;:1,&q;status&q;:0,&q;playStatus&q;:0,&q;type&q;:1,&q;recordingType&q;:0,&q;mediaType&q;:0,&q;title&q;:&q;早课-每月时政5&q;,&q;innerTitle&q;:&q;&q;,&q;startTime&q;:1777590000000,&q;endTime&q;:1777591800000,&q;teacher&q;:{&q;id&q;:11676,&q;userId&q;:44787868,&q;name&q;:&q;刘鸿&q;,&q;brief&q;:&q;粉笔公基优质讲师&q;,&q;desc&q;:&q;粉笔公考常识、公共基础知识优质讲师，累计授课1W+。9年公考培训经验，常年从事一线授课工作。对马克思主义哲学、中共党史、中国特色社会主义理论体系、大政方针时事政治等政治理论有系统研究。授课脉络清晰重点突出，课堂风格激情幽默，擅长学员备考规划指导及技巧点拨。&q;,&q;avatar&q;:&q;192d26d60f9ea18.jpg&q;,&q;upperBodyPhoto&q;:null,&q;displayCoursePrefix&q;:&q;gwy&q;,&q;teacherStat&q;:{&q;teacherId&q;:11676,&q;episodeCount&q;:764,&q;scoreCount&q;:235431,&q;avgScore&q;:9.907361392509907,&q;fiveGradeAvgScore&q;:4.95,&q;updateTime&q;:1773623300330},&q;auditionEpisode&q;:null,&q;memberOfCPC&q;:false,&q;tags&q;:null},&q;teachChannel&q;:1,&q;offline&q;:null,&q;duration&q;:1800,&q;hasAudition&q;:false,&q;bizType&q;:0,&q;bizId&q;:&q;773251&q;,&q;supportReplay&q;:true,&q;extraInfo&q;:null,&q;liveConfig&q;:{&q;episodeId&q;:11706815,&q;supportMultiGroup&q;:false,&q;exerciseBizType&q;:0,&q;videoDisplayType&q;:0,&q;avForwardType&q;:0,&q;useIntelligentRoom&q;:false,&q;hasStrokeKeynote&q;:false,&q;verticalModeType&q;:0,&q;originEpisodeId&q;:0,&q;supportRtmp&q;:false,&q;supportPk&q;:false,&q;supportLuckyBag&q;:false,&q;supportUserNoteStroke&q;:false,&q;communicateType&q;:0,&q;fakeLive&q;:false,&q;one2One&q;:false},&q;validStatus&q;:1,&q;supportLive&q;:true,&q;supportAiCatalog&q;:false,&q;hasIntelligentPen&q;:false,&q;useLocalRecording&q;:false,&q;useIntelligentRoom&q;:false,&q;hasSalePosition&q;:false,&q;hasEpisodeCards&q;:false,&q;lockedForShouna&q;:false,&q;needSignIn&q;:false,&q;needTeacherSignIn&q;:false,&q;enablePadPencil&q;:false,&q;displayExercise&q;:false,&q;supportLuckyBag&q;:false,&q;supportLivePk&q;:false},{&q;id&q;:11706816,&q;kePrefix&q;:&q;gwy&q;,&q;courseId&q;:1,&q;status&q;:0,&q;playStatus&q;:0,&q;type&q;:1,&q;recordingType&q;:0,&q;mediaType&q;:0,&q;title&q;:&q;晚课-热点夜话45&q;,&q;innerTitle&q;:&q;&q;,&q;startTime&q;:1777644000000,&q;endTime&q;:1777646700000,&q;teacher&q;:{&q;id&q;:5813,&q;userId&q;:21512867,&q;name&q;:&q;郑小书&q;,&q;brief&q;:&q;粉笔面试优质教师&q;,&q;desc&q;:&q;       粉笔面试优质教师。\n       曾有过丰富公职机关经验，熟悉政府各项工作，对机关单位制度流程较为了解，可以有效帮助学员建立起政府思维。2018年从事公考面试培训工作以来，授课人数超过3000人，授课时长超过2000小时，带班成果突出，曾经创造过100%通过率带班成绩。授课风格亲切自然、娓娓道来，善于与学员在平等、协作、和谐的气氛下，进行双向交流，帮助学员吸收理解知识。\n       粉笔面试教研教学团队成员。多次受邀参与命制面试模拟预测题，并收录粉笔面试题库。参与撰写省情专项、部门专项、面试会员晨读等多项图书教研工作。多次承担基础理论课、热点30分、两会热点分享、刷题课等粉笔公开课授课。&q;,&q;avatar&q;:&q;1717d7c323da4f2.jpg&q;,&q;upperBodyPhoto&q;:null,&q;displayCoursePrefix&q;:&q;gwy&q;,&q;teacherStat&q;:{&q;teacherId&q;:5813,&q;episodeCount&q;:1123,&q;scoreCount&q;:12118,&q;avgScore&q;:9.860042911371524,&q;fiveGradeAvgScore&q;:4.93,&q;updateTime&q;:1773571899660},&q;auditionEpisode&q;:{&q;episodeTitle&q;:&q;个人展示课&q;,&q;episodeVideoUrl&q;:&q;https://vod.fbstatic.cn/22e9ceb2vodbj1251001446/e21863953270835014226535323/zAt6cpf9Fb8A.mp4?t=f2a4b300&a;us=4070880000&a;sign=cbeded212432a1f9637d757b926018ac&q;},&q;memberOfCPC&q;:false,&q;tags&q;:null},&q;teachChannel&q;:1,&q;offline&q;:null,&q;duration&q;:2700,&q;hasAudition&q;:false,&q;bizType&q;:0,&q;bizId&q;:&q;773251&q;,&q;supportReplay&q;:true,&q;extraInfo&q;:null,&q;liveConfig&q;:{&q;episodeId&q;:11706816,&q;supportMultiGroup&q;:false,&q;exerciseBizType&q;:0,&q;videoDisplayType&q;:0,&q;avForwardType&q;:0,&q;useIntelligentRoom&q;:false,&q;hasStrokeKeynote&q;:false,&q;verticalModeType&q;:0,&q;originEpisodeId&q;:0,&q;supportRtmp&q;:false,&q;supportPk&q;:false,&q;supportLuckyBag&q;:false,&q;supportUserNoteStroke&q;:false,&q;communicateType&q;:0,&q;fakeLive&q;:false,&q;one2One&q;:false},&q;validStatus&q;:1,&q;supportLive&q;:true,&q;supportAiCatalog&q;:false,&q;hasIntelligentPen&q;:false,&q;useLocalRecording&q;:false,&q;useIntelligentRoom&q;:false,&q;hasSalePosition&q;:false,&q;hasEpisodeCards&q;:false,&q;lockedForShouna&q;:false,&q;needSignIn&q;:false,&q;needTeacherSignIn&q;:false,&q;enablePadPencil&q;:false,&q;displayExercise&q;:false,&q;supportLuckyBag&q;:false,&q;supportLivePk&q;:false}],&q;episodeCount&q;:90,&q;hasComments&q;:false,&q;individualInfo&q;:{&q;userGroupon&q;:null},&q;paid&q;:false,&q;fillExamInfo&q;:false,&q;payPrice&q;:0,&q;canBuy&q;:true},{&q;id&q;:224,&q;gid&q;:57,&q;umask&q;:6627,&q;name&q;:&q;&q;,&q;title&q;:&q;【精选好题 沉浸刷题】2025事业单位考试（1月课程上新！）&q;,&q;desc&q;:&q;&l;p&g;&l;a href=\&q;http://native.fenbi.com/wechat/miniapp?originId=gh_e4926036e01d&a;href=%2Fmodules%2Fpages%2Fassistant-new%2Fassistant-new%3Fchannel%3D43220%26posterId%3D31%26districtId%3D0\&q;&g;&l;img width=\&q;750px\&q; height=\&q;259px\&q; src=\&q;https://ke.fbstatic.cn/api/images/1978b55086dfe24.jpg?width=1080\&q; /&g;&l;/a&g;&l;img width=\&q;750px\&q; height=\&q;2517px\&q; src=\&q;https://ke.fbstatic.cn/api/images/1978b551e240c39.jpg?width=1080\&q; /&g;&l;/p&g;&q;,&q;ubbText&q;:&q;&q;,&q;imgUrl&q;:&q;//nodestatic.fbstatic.cn/pan/downloads/26e6ab75b6bf2c06f2b6abb7d1030be3.png&q;,&q;linkUrl&q;:&q;https://www.fenbi.com/spa/pwa/lecture/sydw/726825/0&q;,&q;type&q;:0,&q;typeName&q;:&q;热门课程&q;,&q;weight&q;:70,&q;status&q;:-1,&q;isPublished&q;:1,&q;course&q;:0,&q;courseType&q;:0,&q;position&q;:0,&q;source&q;:&q;&q;,&q;uploadTime&q;:&q;&q;,&q;updatedTime&q;:&q;2025-12-22T08:54:15.000Z&q;,&q;createdTime&q;:&q;2024-08-05T08:44:35.183Z&q;,&q;teacherId&q;:&q;0&q;,&q;teacherAvatar&q;:&q;&q;,&q;teacherProtrait&q;:&q;&q;,&q;brief&q;:&q;事业单位专项精选刷题自习室【持续更新】&q;,&q;videoUrl&q;:&q;&q;,&q;coverUrl&q;:&q;&q;,&q;subjectInformation&q;:{&q;examInformation&q;:[],&q;historyExams&q;:[],&q;examPreparationMaterials&q;:[]},&q;homepageTopic&q;:{&q;examAnnouncements&q;:[{&q;title&q;:&q;&q;,&q;subtitle&q;:&q;&q;,&q;jumpLink&q;:&q;&q;}],&q;guidanceArticles&q;:[{&q;title&q;:&q;&q;,&q;jumpLink&q;:&q;&q;}],&q;mainImages&q;:[{&q;title&q;:&q;&q;,&q;jumpLink&q;:&q;&q;,&q;imgUrl&q;:&q;&q;,&q;weight&q;:0}],&q;table&q;:{&q;title&q;:&q;&q;,&q;row&q;:0,&q;column&q;:0,&q;contents&q;:[]}},&q;homepageExams&q;:[{&q;title&q;:&q;&q;,&q;jumpLink&q;:&q;&q;}],&q;publisher&q;:&q;&q;,&q;contentType&q;:0,&q;courseId&q;:726825,&q;saleStatus&q;:-1,&q;salesStatus&q;:-1,&q;shortName&q;:&q;&q;,&q;explanation&q;:&q;&q;,&q;price&q;:0,&q;priceDisplayType&q;:0,&q;floorPrice&q;:0,&q;topPrice&q;:0,&q;promotionPrice&q;:0,&q;promotionDesc&q;:&q;&q;,&q;studentLimit&q;:0,&q;studentCount&q;:25094,&q;salesText&q;:&q;&q;,&q;hasAddress&q;:false,&q;classHours&q;:985,&q;startSaleTime&q;:1747785600000,&q;stopSaleTime&q;:1779321600000,&q;classStartTime&q;:1735783200000,&q;classEndTime&q;:1801303200000,&q;hasExercise&q;:false,&q;hasQQGroup&q;:false,&q;hasImGroup&q;:false,&q;hasClassPeriod&q;:false,&q;hasPosition&q;:false,&q;hasUserContentInfo&q;:false,&q;hasUserExamInfo&q;:false,&q;hasUserFormBeforeOrder&q;:false,&q;hasUserFormAfterOrder&q;:false,&q;hasCustomerService&q;:false,&q;hasRedirectInstructor&q;:true,&q;hasLiveEpisodes&q;:false,&q;hasAudition&q;:false,&q;teachers&q;:[{&q;id&q;:32974,&q;userId&q;:83441510,&q;name&q;:&q;何铖&q;,&q;brief&q;:&q;粉笔优质讲师&q;,&q;desc&q;:&q;粉笔优质讲师\n6年一线教学经验，承担过线上、线下笔试多种班型课程，累计授课超3100小时，授课经验丰富。\n承担言语科目授课、教研与培训工作，上课亲和生动，互动性强，擅长理论与实际相结合，授课逻辑性强，善于发现学员解题症结并总结答题技巧，积极引导并激发学员学习热情和自主意识。\n课程累计评分4.97，在学员中具有良好口碑，是值得信赖的好导师。&q;,&q;avatar&q;:&q;1984f2383973c17.jpg&q;,&q;upperBodyPhoto&q;:null,&q;displayCoursePrefix&q;:&q;sydw&q;,&q;teacherStat&q;:{&q;teacherId&q;:32974,&q;episodeCount&q;:741,&q;scoreCount&q;:1778,&q;avgScore&q;:9.923509561304837,&q;fiveGradeAvgScore&q;:4.96,&q;updateTime&q;:1773235895215},&q;auditionEpisode&q;:{&q;episodeTitle&q;:&q;个人展示课&q;,&q;episodeVideoUrl&q;:&q;https://vod.fbstatic.cn/22e9ceb2vodbj1251001446/4349be535145403710131933552/nPy2nunV3pAA.mp4?t=f2a4b300&a;us=4070880000&a;sign=864a8580f53c566b64ff5ba2e13209fc&q;},&q;memberOfCPC&q;:false,&q;tags&q;:null},{&q;id&q;:24162,&q;userId&q;:59957211,&q;name&q;:&q;金思彤&q;,&q;brief&q;:&q;粉笔优质讲师&q;,&q;desc&q;:&q;粉笔优质讲师\n7年一线教学经验，211大学双一流学科硕士毕业，教学态度认真负责，具有判断科目丰富的实践经验及系统扎实的专业理论知识和对事业单位判断推理考情的深入研究；曾参与命制笔试真题教研和解析撰写工作，对判断推理最新命题趋势方向有深入研究。&q;,&q;avatar&q;:&q;19bbc34197eebfe.jpg&q;,&q;upperBodyPhoto&q;:null,&q;displayCoursePrefix&q;:&q;sydw&q;,&q;teacherStat&q;:{&q;teacherId&q;:24162,&q;episodeCount&q;:506,&q;scoreCount&q;:2157,&q;avgScore&q;:9.907278627723691,&q;fiveGradeAvgScore&q;:4.95,&q;updateTime&q;:1772558154031},&q;auditionEpisode&q;:{&q;episodeTitle&q;:&q;个人展示课&q;,&q;episodeVideoUrl&q;:&q;https://vod.fbstatic.cn/22e9ceb2vodbj1251001446/769646875145403709537454592/AvgGIhEZbfEA.mp4?t=f2a4b300&a;us=4070880000&a;sign=b403d56f99dc2f52a13f62fafb197865&q;},&q;memberOfCPC&q;:false,&q;tags&q;:null},{&q;id&q;:16574,&q;userId&q;:73028298,&q;name&q;:&q;廖雅云&q;,&q;brief&q;:&q;粉笔优质讲师&q;,&q;desc&q;:&q;粉笔优质讲师\n多年一线教学授课经验，深耕事业单位考试，承担过笔试精品班、刷题班、冲刺班等多种班型,授课经验丰富。\n深入了解职测数资近年来的考情、重难点以及不同考点的解题技巧，理论扎实。\n参与笔试真题教研和解析撰写、终审工作,并多次参与图书以及相关资料的编写，对数资最新命题趋势方向有深入研究；\n多次参加粉笔授课研讨会议，针对学生困惑研究教学策略，拓展考场思维，能够帮助学员将所学理论更好应用在实际解题当中，拓展解题思路；\n授课风格:授课累计评分达4.9分，讲课耐心细致，课堂氛围轻松活跃，与学员重在沟通，能够从学员角度出发去找问题、解决问题，深受学员的喜爱。&q;,&q;avatar&q;:&q;19854f590ec1eda.jpg&q;,&q;upperBodyPhoto&q;:null,&q;displayCoursePrefix&q;:&q;sydw&q;,&q;teacherStat&q;:{&q;teacherId&q;:16574,&q;episodeCount&q;:739,&q;scoreCount&q;:6952,&q;avgScore&q;:9.825373993095512,&q;fiveGradeAvgScore&q;:4.91,&q;updateTime&q;:1773622398088},&q;auditionEpisode&q;:{&q;episodeTitle&q;:&q;个人展示课&q;,&q;episodeVideoUrl&q;:&q;https://vod.fbstatic.cn/22e9ceb2vodbj1251001446/725c3a375145403709544020247/E4rt1kFdZL4A.mp4?t=f2a4b300&a;us=4070880000&a;sign=423b76444fe4ed707f565354eef136e2&q;},&q;memberOfCPC&q;:false,&q;tags&q;:null},{&q;id&q;:24528,&q;userId&q;:63710520,&q;name&q;:&q;周士芫&q;,&q;brief&q;:&q;粉笔优质讲师&q;,&q;desc&q;:&q;粉笔优质讲师\n工科背景，5年一线教学经验。\n深耕事业单位考试，具有数资科目丰富的理论知识和实践经验，对数资科目的考情有深入研究。理论基础扎实，实战经验丰富，定期参与真题教研，熟悉考试内容，擅长总结题目特点和解题方法；\n累计带班学员接近2000人次，授课评分达4.9分，逻辑思维严谨，授课思路清晰生动，重难点突出，课堂氛围轻松，且能够切实帮助学员解决考场上时间不够的问题，提高学员正确率和做题速度，深受学员喜爱。&q;,&q;avatar&q;:&q;1945f416ca1db29.jpg&q;,&q;upperBodyPhoto&q;:null,&q;displayCoursePrefix&q;:&q;sydw&q;,&q;teacherStat&q;:{&q;teacherId&q;:24528,&q;episodeCount&q;:484,&q;scoreCount&q;:1653,&q;avgScore&q;:9.888687235329686,&q;fiveGradeAvgScore&q;:4.94,&q;updateTime&q;:1773467230193},&q;auditionEpisode&q;:null,&q;memberOfCPC&q;:false,&q;tags&q;:null},{&q;id&q;:52897,&q;userId&q;:88925186,&q;name&q;:&q;魏涅与&q;,&q;brief&q;:&q;粉笔优质讲师&q;,&q;desc&q;:&q;粉笔优质讲师\n211高校毕业，6年一线教学经验，累计授课时长3000+。\n具有常识公基及判断科目丰富的实践经验及系统扎实的专业理论知识：\n多次参与粉笔授课研讨会议，精准捕捉考试命题的最新趋势；\n多次参加粉笔教学教研活动，分享授课心得，推动教学质量不断攀升。\n授课评分保持在4.9以上，累计超过500条学员好评。拥有“条理清晰、风趣幽默”的授课风格，擅长将复杂的知识点简单化，让学生在轻松愉悦的学习氛围中，快速掌握解题秘诀，深受广大学员的喜爱与信赖。&q;,&q;avatar&q;:&q;1984fd2774f3568.jpg&q;,&q;upperBodyPhoto&q;:null,&q;displayCoursePrefix&q;:&q;sydw&q;,&q;teacherStat&q;:{&q;teacherId&q;:52897,&q;episodeCount&q;:653,&q;scoreCount&q;:1711,&q;avgScore&q;:9.880771478667448,&q;fiveGradeAvgScore&q;:4.94,&q;updateTime&q;:1773204298276},&q;auditionEpisode&q;:{&q;episodeTitle&q;:&q;个人展示课&q;,&q;episodeVideoUrl&q;:&q;https://vod.fbstatic.cn/22e9ceb2vodbj1251001446/c19bce885145403709545114799/2m4bcwkBNWEA.mp4?t=f2a4b300&a;us=4070880000&a;sign=8287b189dcab7ca6525e7380fb25d677&q;},&q;memberOfCPC&q;:false,&q;tags&q;:null},{&q;id&q;:18292,&q;userId&q;:64594928,&q;name&q;:&q;户春月&q;,&q;brief&q;:&q;粉笔优质讲师&q;,&q;desc&q;:&q;粉笔优质讲师\n具有6年常识公基非法学科授课及督学经验，授课评分4.9。\n具有常识公基非法科目扎实理论基础，对全国各地考情有充分的了解。曾参与粉笔模拟题、教研文章等撰写工作，具有考场思维以及丰富的笔试答题经验。通过近年的督学工作，积累了丰富的个性化辅导经验，会根据学员的学习风格和学习目标，调整教学内容和方法。\n在教学中，擅长将抽象的专业知识转化为生动有趣的案例，引导学员深入理解。在讲解复杂知识点时，通过引入具体案例，让学员可以轻松掌握了该知识点的核心，教学效果显著。&q;,&q;avatar&q;:&q;1983b73707f7b5b.jpg&q;,&q;upperBodyPhoto&q;:null,&q;displayCoursePrefix&q;:&q;sydw&q;,&q;teacherStat&q;:{&q;teacherId&q;:18292,&q;episodeCount&q;:852,&q;scoreCount&q;:1699,&q;avgScore&q;:9.878752207180701,&q;fiveGradeAvgScore&q;:4.94,&q;updateTime&q;:1773573836788},&q;auditionEpisode&q;:{&q;episodeTitle&q;:&q;个人展示课&q;,&q;episodeVideoUrl&q;:&q;https://vod.fbstatic.cn/22e9ceb2vodbj1251001446/800f0cec5145403709537874267/DEgQJna6VSoA.mp4?t=f2a4b300&a;us=4070880000&a;sign=f2f66baef1eb0ec074e19dd7713d70ab&q;},&q;memberOfCPC&q;:false,&q;tags&q;:null},{&q;id&q;:16948,&q;userId&q;:69316245,&q;name&q;:&q;巨琼&q;,&q;brief&q;:&q;粉笔优质讲师&q;,&q;desc&q;:&q;粉笔优质教师\n6年以上一线教学授课经验，累计授课时长2000+，授课人数10000+，授课评分4.9分，累计获得学员好评上千条。具有扎实系统的言语专业知识体系且线上线下均授课经验丰富，线上授课涵盖联考、山东、安徽等各省言语课程，线下曾多次担任联考、江苏等省份言语主讲。长期参与言语科目教研工作，真题解析、模拟题撰写、参与《职测3000题》 单题录制等，全面了解事业单位各省份言语命题规律及答题技巧。教学中，曾获事业单位教师风采大赛“三等奖”，持续积极探索生动有趣的教学方式，精准把握言语考点，帮助学员快速理解并掌握言语技巧，能以独特的方法引导学员攻克难关，提升答题准确率与速度，深受学员认可，助力多名学员成功实现自己的职业目标。&q;,&q;avatar&q;:&q;1746cf3620ab526.jpg&q;,&q;upperBodyPhoto&q;:null,&q;displayCoursePrefix&q;:&q;sydw&q;,&q;teacherStat&q;:{&q;teacherId&q;:16948,&q;episodeCount&q;:595,&q;scoreCount&q;:2018,&q;avgScore&q;:9.865213082259663,&q;fiveGradeAvgScore&q;:4.93,&q;updateTime&q;:1773488367488},&q;auditionEpisode&q;:{&q;episodeTitle&q;:&q;个人展示课&q;,&q;episodeVideoUrl&q;:&q;https://vod.fbstatic.cn/22e9ceb2vodbj1251001446/c5adc5685145403709538521768/r1Y9MG5YjPwA.mp4?t=f2a4b300&a;us=4070880000&a;sign=e92eaa0857512f99b08ff349fc652a92&q;},&q;memberOfCPC&q;:false,&q;tags&q;:null},{&q;id&q;:64212,&q;userId&q;:136666695,&q;name&q;:&q;陆祥琴&q;,&q;brief&q;:&q;粉笔优质讲师&q;,&q;desc&q;:&q;粉笔优质讲师\n多年一线教学授课经验，每年授课时长1000h+，具有判断科目丰富的实践经验及系统扎实的专业理论知识。参与教研工作，对判断科目深入研究，多次参加粉笔教研活动，撰写笔试解析，分享授课经验心得。具备出色的表达能力与教学方法，擅长将复杂知识以通俗易懂、逻辑清晰的方式传授给学生。让学生在轻松的学习氛围中，用更简单的方法，找到更快捷的解题之道，深受广大学员的认可和好评。&q;,&q;avatar&q;:&q;19416294943c5aa.jpg&q;,&q;upperBodyPhoto&q;:null,&q;displayCoursePrefix&q;:&q;sydw&q;,&q;teacherStat&q;:{&q;teacherId&q;:64212,&q;episodeCount&q;:700,&q;scoreCount&q;:1817,&q;avgScore&q;:9.87231700605392,&q;fiveGradeAvgScore&q;:4.94,&q;updateTime&q;:1773581533967},&q;auditionEpisode&q;:{&q;episodeTitle&q;:&q;个人展示课&q;,&q;episodeVideoUrl&q;:&q;https://vod.fbstatic.cn/22e9ceb2vodbj1251001446/c6ed6ac41397757891691497378/aQTDyADYQBgA.mp4?t=f2a4b300&a;us=4070880000&a;sign=96cbc84e33860a44c5e48c7aabd1ac34&q;},&q;memberOfCPC&q;:false,&q;tags&q;:null},{&q;id&q;:64119,&q;userId&q;:90008449,&q;name&q;:&q;黄于晨&q;,&q;brief&q;:&q;粉笔优质讲师&q;,&q;desc&q;:&q;粉笔综应科目优质讲师\n多年一线教学经验，承担过线下笔试精品班，刷题班等多种班型，多次参加粉笔授课研讨会议，全面把握事考笔试命题趋势及最新考情，长期从事相关科目的教研工作，授课经验丰富，思路清晰，能够调动学员积极性。授课重点突出，能够及时总结拓展，针对性的解决学生的问题，制定合适的教学计划，进行个性化指导，助力学员上岸。&q;,&q;avatar&q;:&q;1945f2bc8a79ca7.jpg&q;,&q;upperBodyPhoto&q;:null,&q;displayCoursePrefix&q;:&q;sydw&q;,&q;teacherStat&q;:{&q;teacherId&q;:64119,&q;episodeCount&q;:501,&q;scoreCount&q;:524,&q;avgScore&q;:9.977099236641225,&q;fiveGradeAvgScore&q;:4.99,&q;updateTime&q;:1773581373076},&q;auditionEpisode&q;:{&q;episodeTitle&q;:&q;个人展示课&q;,&q;episodeVideoUrl&q;:&q;https://vod.fbstatic.cn/22e9ceb2vodbj1251001446/87956e2f5145403709544958863/UMDoH2GAdAIA.mp4?t=f2a4b300&a;us=4070880000&a;sign=5277a4d363f925d16bd6c83ac5410861&q;},&q;memberOfCPC&q;:false,&q;tags&q;:null},{&q;id&q;:15530,&q;userId&q;:71692629,&q;name&q;:&q;杨意雯&q;,&q;brief&q;:&q;粉笔优质讲师&q;,&q;desc&q;:&q;粉笔优质讲师\n丰富实战背景：\n拥有超过7年的实战教学经验，总授课时长突破2000小时，见证了无数学生的成长与蜕变。\n深厚专业底蕴与实战融合：\n在公基与言语领域，拥有深厚的学术功底与实战经验，能够深入浅出地剖析考点，直击要害。积极参与多次教研会，紧跟国家公务员及事业单位选拔的最新动态，确保教学内容的前沿性与针对性。\n优质教学风采与广泛认可：\n收获超过1000份来自全国各地学员的热烈好评，构建起坚实的口碑基础。\n以“逻辑严谨、寓教于乐”的独特教学风格著称，擅长运用生动实例与趣味互动，将抽象概念具象化，让学习之旅变得生动有趣，极大提升了学生的学习兴趣与效率。&q;,&q;avatar&q;:&q;1760362bb2f7c82.jpg&q;,&q;upperBodyPhoto&q;:null,&q;displayCoursePrefix&q;:&q;sydw&q;,&q;teacherStat&q;:{&q;teacherId&q;:15530,&q;episodeCount&q;:449,&q;scoreCount&q;:1212,&q;avgScore&q;:9.900990099009896,&q;fiveGradeAvgScore&q;:4.95,&q;updateTime&q;:1773411447504},&q;auditionEpisode&q;:null,&q;memberOfCPC&q;:false,&q;tags&q;:null},{&q;id&q;:16530,&q;userId&q;:73216758,&q;name&q;:&q;刘开慧&q;,&q;brief&q;:&q;粉笔优质讲师&q;,&q;desc&q;:&q;粉笔优质讲师\n四年公考教学经验，全面了解事业单位言语科目近年来命题规律、重难点及不同类型题目答题技巧，授课条理清晰，语言通俗易懂，风格幽默风趣，实战经验丰富，且擅长深入浅出，激发学员学习热情，深受学员喜爱。&q;,&q;avatar&q;:&q;198551347778a1e.jpg&q;,&q;upperBodyPhoto&q;:null,&q;displayCoursePrefix&q;:&q;sydw&q;,&q;teacherStat&q;:{&q;teacherId&q;:16530,&q;episodeCount&q;:350,&q;scoreCount&q;:1605,&q;avgScore&q;:9.879127725856709,&q;fiveGradeAvgScore&q;:4.94,&q;updateTime&q;:1773566095917},&q;auditionEpisode&q;:{&q;episodeTitle&q;:&q;个人展示课&q;,&q;episodeVideoUrl&q;:&q;https://vod.fbstatic.cn/22e9ceb2vodbj1251001446/b7e4edc21253642695664039132/hf14S37Vsx0A.mp4?t=f2a4b300&a;us=4070880000&a;sign=7574a5c01ba998ba731acf886001efb3&q;},&q;memberOfCPC&q;:false,&q;tags&q;:null},{&q;id&q;:26520,&q;userId&q;:63229933,&q;name&q;:&q;胡佳欢&q;,&q;brief&q;:&q;粉笔优质讲师&q;,&q;desc&q;:&q;粉笔优质教师\n6年一线教学授课经验，授课思路清晰，语言通俗易懂，善于引导学员思考，深受广大学员的认可和好评。\n累计评分达4.9分，授课逻辑清晰，耐心细致，善于总结学习方法，能够帮助学员举一反三、学以致用。\n多次参与粉笔判断授课研讨，能够熟练掌握笔试考情和命题趋势，具有判断科目丰富的实践经验及系统扎实的专业理论知识。&q;,&q;avatar&q;:&q;176ac86208b0412.jpg&q;,&q;upperBodyPhoto&q;:null,&q;displayCoursePrefix&q;:&q;sydw&q;,&q;teacherStat&q;:{&q;teacherId&q;:26520,&q;episodeCount&q;:480,&q;scoreCount&q;:2615,&q;avgScore&q;:9.841682600382423,&q;fiveGradeAvgScore&q;:4.92,&q;updateTime&q;:1773565925020},&q;auditionEpisode&q;:{&q;episodeTitle&q;:&q;个人展示课&q;,&q;episodeVideoUrl&q;:&q;https://vod.fbstatic.cn/22e9ceb2vodbj1251001446/9ad51b645145403713947143855/qXaIJaoHik0A.mp4?t=f2a4b300&a;us=4070880000&a;sign=cff2cd400b2cd41eabd3f8407019a6d3&q;},&q;memberOfCPC&q;:false,&q;tags&q;:null},{&q;id&q;:13527,&q;userId&q;:72790831,&q;name&q;:&q;安爱霞&q;,&q;brief&q;:&q;粉笔优质讲师&q;,&q;desc&q;:&q;粉笔综应优质讲师。\n5年多一线综应教学和带班经验，累计授课时长1200+，带班人次2000+，所带班级进面率高，学员整体评分5.0。\n多次参加粉笔综应科目教研，熟悉各类事业单位综应科目命题规律，重难点及不同题型的答题思路和方法，对联考、山东、江苏、浙江等省份事业单位的考情和备考策略了然于胸，专业知识扎实，带班经验丰富。\n清新温和，擅长总结做题规律和答题技巧，能够举一反三，帮助同学通过一道题掌握一类题的解题思路，谙熟学生各个阶段的备考心理，善于思维点拨和个性化辅导，实践性强，深受学员喜爱。&q;,&q;avatar&q;:&q;1737ee8a423e625.jpg&q;,&q;upperBodyPhoto&q;:null,&q;displayCoursePrefix&q;:&q;sydw&q;,&q;teacherStat&q;:{&q;teacherId&q;:13527,&q;episodeCount&q;:432,&q;scoreCount&q;:650,&q;avgScore&q;:9.95076923076923,&q;fiveGradeAvgScore&q;:4.98,&q;updateTime&q;:1773460026169},&q;auditionEpisode&q;:{&q;episodeTitle&q;:&q;个人展示课&q;,&q;episodeVideoUrl&q;:&q;https://vod.fbstatic.cn/22e9ceb2vodbj1251001446/c89b3a775145403709545414401/EobO1hNUCfwA.mp4?t=f2a4b300&a;us=4070880000&a;sign=235394db2773c64ad274454799390cd9&q;},&q;memberOfCPC&q;:false,&q;tags&q;:null},{&q;id&q;:16970,&q;userId&q;:66988478,&q;name&q;:&q;彭雨青&q;,&q;brief&q;:&q;粉笔优质讲师&q;,&q;desc&q;:&q;粉笔优质讲师。六年一线教学经验，多次事业单位考试实战经历，综应成绩突出，全面了解事业单位综合应用能力考情及答题技巧; 多次参与粉笔线上线下教研活动，理论基础扎实，注重考场思维；授课经验丰富，参与多班型授课，课堂氛围轻松；授课风格成熟，讲解耐心细致，条理清晰，受到学员广泛好评。&q;,&q;avatar&q;:&q;198551f5f2aeddc.jpg&q;,&q;upperBodyPhoto&q;:null,&q;displayCoursePrefix&q;:&q;sydw&q;,&q;teacherStat&q;:{&q;teacherId&q;:16970,&q;episodeCount&q;:426,&q;scoreCount&q;:550,&q;avgScore&q;:9.959999999999994,&q;fiveGradeAvgScore&q;:4.98,&q;updateTime&q;:1773206256359},&q;auditionEpisode&q;:{&q;episodeTitle&q;:&q;个人展示课&q;,&q;episodeVideoUrl&q;:&q;https://vod.fbstatic.cn/22e9ceb2vodbj1251001446/8207a7095145403709537920947/TaUQYutM1mAA.mp4?t=f2a4b300&a;us=4070880000&a;sign=03a53cae536bade8d5d8aa41a688ac08&q;},&q;memberOfCPC&q;:false,&q;tags&q;:null},{&q;id&q;:13925,&q;userId&q;:72727718,&q;name&q;:&q;苏姌&q;,&q;brief&q;:&q;粉笔优质讲师&q;,&q;desc&q;:&q;粉笔优质教师\n五年一线授课经验，始终以生动有趣、激发学生思维为教学宗旨，课堂氛围轻松融洽，广受学员好评。授课重点突出，能够及时总结拓展，讲解语言通俗易懂。擅长引导学生自主思考，善于根据学生的不同情况和需求，制定合适的教学计划，进行个性化指导，助力学员上岸。&q;,&q;avatar&q;:&q;1739f119df17c73.jpg&q;,&q;upperBodyPhoto&q;:null,&q;displayCoursePrefix&q;:&q;sydw&q;,&q;teacherStat&q;:{&q;teacherId&q;:13925,&q;episodeCount&q;:553,&q;scoreCount&q;:2700,&q;avgScore&q;:9.830370370370371,&q;fiveGradeAvgScore&q;:4.92,&q;updateTime&q;:1773582931239},&q;auditionEpisode&q;:{&q;episodeTitle&q;:&q;个人展示课&q;,&q;episodeVideoUrl&q;:&q;https://vod.fbstatic.cn/22e9ceb2vodbj1251001446/8b5981bd5145403708273174731/gVKofatqWf4A.mp4?t=f2a4b300&a;us=4070880000&a;sign=fe37943678463aae39c69732238cbca1&q;},&q;memberOfCPC&q;:false,&q;tags&q;:null},{&q;id&q;:35776,&q;userId&q;:83534698,&q;name&q;:&q;魏兰婷&q;,&q;brief&q;:&q;粉笔优质讲师&q;,&q;desc&q;:&q;粉笔优质讲师\n拥有7年一线教学授课经验，毕业于双一流院校。深耕言语理解与表达科目，对国考及各省考情有精准把握。具有言语科目丰富的实践经验及系统扎实的专业理论知识。\n①多次参与粉笔授课研讨与教研活动，持续更新教学理论与方法；\n②承担线上公开课及线上直播课等工作，累计全国授课超万人次，学员评分长期稳定在4.9分以上；\n③曾2次在粉笔“师资风采大赛”中入围并获奖，教学能力获得内部认可。\n授课风格耐心细致，善于将复杂的知识点转化为通俗易懂的讲解，营造轻松积极的学习氛围。其高效的解题方法与亲切的指导深受学员好评，是学员信赖的良师。&q;,&q;avatar&q;:&q;1984fca9fbd6325.jpg&q;,&q;upperBodyPhoto&q;:null,&q;displayCoursePrefix&q;:&q;sydw&q;,&q;teacherStat&q;:{&q;teacherId&q;:35776,&q;episodeCount&q;:610,&q;scoreCount&q;:4222,&q;avgScore&q;:9.801989578398866,&q;fiveGradeAvgScore&q;:4.9,&q;updateTime&q;:1773576447340},&q;auditionEpisode&q;:{&q;episodeTitle&q;:&q;个人展示课&q;,&q;episodeVideoUrl&q;:&q;https://vod.fbstatic.cn/22e9ceb2vodbj1251001446/bcb7f84d5145403709538179593/LKKkDheS6YsA.mp4?t=f2a4b300&a;us=4070880000&a;sign=ade5c614ffe4fa0bcf0395aa689081c8&q;},&q;memberOfCPC&q;:false,&q;tags&q;:null},{&q;id&q;:16575,&q;userId&q;:58269049,&q;name&q;:&q;王秀敏&q;,&q;brief&q;:&q;粉笔优质讲师&q;,&q;desc&q;:&q;粉笔优质教师\n211高校毕业，五年一线教学授课经验，专注于事业单位笔试领域，主讲线上精品班、线下刷题特训营等多种班型，教学积淀深厚。\n在言语科目上拥有坚实而系统的理论功底，对事业单位考试中言语题目的命题规律有着透彻的分析，多次参与真题解析和模拟试题撰写工作；积极参与授课教学研讨会，不断探索高效教学策略，针对学员痛点定制个性化学习方案，同时注重个人教学技能的持续精进。\n累计授课时长超过2000小时，平均评分达4.9分；授课风格条理清晰，生动活泼，能够引导学生循序渐进地掌握知识要点，构建起牢固的知识框架。始终将助力学员成功上岸为己任，无论是备考策略的指导还是心理调适的建议，都力求做到无微不至，深受学员喜爱。&q;,&q;avatar&q;:&q;17467f0d079109a.jpg&q;,&q;upperBodyPhoto&q;:null,&q;displayCoursePrefix&q;:&q;sydw&q;,&q;teacherStat&q;:{&q;teacherId&q;:16575,&q;episodeCount&q;:413,&q;scoreCount&q;:1597,&q;avgScore&q;:9.864746399499051,&q;fiveGradeAvgScore&q;:4.93,&q;updateTime&q;:1773571217222},&q;auditionEpisode&q;:{&q;episodeTitle&q;:&q;个人展示课&q;,&q;episodeVideoUrl&q;:&q;https://vod.fbstatic.cn/22e9ceb2vodbj1251001446/59aca01b5145403708150262575/K8o1L1IyA2EA.mp4?t=f2a4b300&a;us=4070880000&a;sign=f6f692abf8c56bf7df3b7838fa316ab6&q;},&q;memberOfCPC&q;:false,&q;tags&q;:null},{&q;id&q;:56632,&q;userId&q;:71763689,&q;name&q;:&q;张程&q;,&q;brief&q;:&q;粉笔优质讲师&q;,&q;desc&q;:&q;粉笔优质教师\n985硕士毕业，深耕事业单位考试，三年一线教学授课经验，实战与授课经验丰富。\n全面了解数量关系和资料分析答题技巧，授课逻辑清晰，教研教学扎实刻苦:\n曾参与笔试真题教研和解析撰写工作;\n注重考场思维，针对学生困惑研究教学策略，授课重点突出，及时总结拓展;\n学生口碑:累计授课超2000小时，累计评分达4.9分，注重启发式引导，课堂氛围轻松融洽，讲解语言通俗易懂。善于根据学生的不同情况和需求，制定合适的教学计划，进行个性化指导，助力学员上岸。&q;,&q;avatar&q;:&q;184e197c2940672.jpg&q;,&q;upperBodyPhoto&q;:null,&q;displayCoursePrefix&q;:&q;sydw&q;,&q;teacherStat&q;:{&q;teacherId&q;:56632,&q;episodeCount&q;:353,&q;scoreCount&q;:1032,&q;avgScore&q;:9.899224806201547,&q;fiveGradeAvgScore&q;:4.95,&q;updateTime&q;:1773106304338},&q;auditionEpisode&q;:{&q;episodeTitle&q;:&q;个人展示课&q;,&q;episodeVideoUrl&q;:&q;https://vod.fbstatic.cn/22e9ceb2vodbj1251001446/c5aecd615145403709538523381/FhVtVkaUXp0A.mp4?t=f2a4b300&a;us=4070880000&a;sign=698fd039e524a09319371f0eda81fd2c&q;},&q;memberOfCPC&q;:false,&q;tags&q;:null},{&q;id&q;:16630,&q;userId&q;:63555782,&q;name&q;:&q;陈贺&q;,&q;brief&q;:&q;粉笔优质讲师&q;,&q;desc&q;:&q;粉笔优质教师\n6年一线教学授课经验，线上累计授课超800+小时，带班学生8000+；具有判断推理科目丰富的实践经验和系统扎实的专业理论，对山东、陕西、甘肃等各省判断推理科目的考情深入研究，全面了解命题规律及答题技巧，长期参与线上系统班和精品班的教研工作，撰写教研文章10余篇，出过近200道优质模拟题；具有幽默诙谐、形象生动、条理清晰的授课风格，让学生在轻松的学习氛围中，用更简单的方法，找到更快捷的解题之道，深受广大学员的认可和好评。&q;,&q;avatar&q;:&q;175d8f143291ec7.jpg&q;,&q;upperBodyPhoto&q;:null,&q;displayCoursePrefix&q;:&q;sydw&q;,&q;teacherStat&q;:{&q;teacherId&q;:16630,&q;episodeCount&q;:508,&q;scoreCount&q;:1860,&q;avgScore&q;:9.8516129032258,&q;fiveGradeAvgScore&q;:4.93,&q;updateTime&q;:1773584418412},&q;auditionEpisode&q;:{&q;episodeTitle&q;:&q;个人展示课&q;,&q;episodeVideoUrl&q;:&q;https://vod.fbstatic.cn/22e9ceb2vodbj1251001446/be9c21bc5145403709538211346/S3YE0Y3AIBoA.mp4?t=f2a4b300&a;us=4070880000&a;sign=aa0da2116ec32854b9c50d64d3429cec&q;},&q;memberOfCPC&q;:false,&q;tags&q;:null},{&q;id&q;:16684,&q;userId&q;:59358516,&q;name&q;:&q;周晶辉&q;,&q;brief&q;:&q;粉笔优质讲师&q;,&q;desc&q;:&q;粉笔优质教师\n六年一线教学授课经验，累计授课时长1000+小时，综合授课评分4.9+，实战经验丰富，授课逻辑清晰，多次参与科目教研工作、授课研讨会议，参与事业单位真题单题录制、模拟题撰写等，熟练掌握判断科目考情及命题趋势，擅长各省联考、江苏、浙江、广东等多地区考点，擅于从学员角度思考，帮助学员理清解题思路，掌握科目常规考点，突破科目重难考点，具有幽默诙谐、形象生动、条理清晰的授课风格，让学生在轻松的学习氛围中，用更简单的方法，找到更快捷的解题之道，深受广大学员的认可和好评。&q;,&q;avatar&q;:&q;198caf9ea93f698.jpg&q;,&q;upperBodyPhoto&q;:null,&q;displayCoursePrefix&q;:&q;sydw&q;,&q;teacherStat&q;:{&q;teacherId&q;:16684,&q;episodeCount&q;:449,&q;scoreCount&q;:1699,&q;avgScore&q;:9.85638610947615,&q;fiveGradeAvgScore&q;:4.93,&q;updateTime&q;:1773578657175},&q;auditionEpisode&q;:{&q;episodeTitle&q;:&q;个人展示课&q;,&q;episodeVideoUrl&q;:&q;https://vod.fbstatic.cn/22e9ceb2vodbj1251001446/85b397c93560136620837741859/inWAKAms518A.mp4?t=f2a4b300&a;us=4070880000&a;sign=8ae71ff49f003e5c8d83058d09cdc3db&q;},&q;memberOfCPC&q;:false,&q;tags&q;:null},{&q;id&q;:64202,&q;userId&q;:83481409,&q;name&q;:&q;纪京男&q;,&q;brief&q;:&q;粉笔优质讲师&q;,&q;desc&q;:&q;粉笔优质讲师\n五年从教经验，言语理解授课条理清晰，践行理解至上理念，擅长逻辑填空板块，能够根据题目拓展成语实词，帮助学生捆绑记忆，无形之中解决积累难题。&q;,&q;avatar&q;:&q;192705b1099705a.jpg&q;,&q;upperBodyPhoto&q;:null,&q;displayCoursePrefix&q;:&q;sydw&q;,&q;teacherStat&q;:{&q;teacherId&q;:64202,&q;episodeCount&q;:738,&q;scoreCount&q;:1109,&q;avgScore&q;:9.888187556357082,&q;fiveGradeAvgScore&q;:4.94,&q;updateTime&q;:1773478985137},&q;auditionEpisode&q;:{&q;episodeTitle&q;:&q;个人展示课&q;,&q;episodeVideoUrl&q;:&q;https://vod.fbstatic.cn/22e9ceb2vodbj1251001446/c5bfd5a85145403709538531587/LTLB1Lqu4MkA.mp4?t=f2a4b300&a;us=4070880000&a;sign=17cda4e2dc0a4a706a7fb34ad560da59&q;},&q;memberOfCPC&q;:false,&q;tags&q;:null},{&q;id&q;:16892,&q;userId&q;:64000402,&q;name&q;:&q;陈实&q;,&q;brief&q;:&q;粉笔优质讲师&q;,&q;desc&q;:&q;粉笔优质讲师\n六年教学经验，承担各种班型授课，理论知识扎实，了解事业单位数量关系和资料分析的答题技巧，注重专业知识的传递，授课有亲和力，逻辑性强，能激发学生学习的热情，得到许多学生的好评和喜爱。&q;,&q;avatar&q;:&q;17a757d0def9021.jpg&q;,&q;upperBodyPhoto&q;:null,&q;displayCoursePrefix&q;:&q;sydw&q;,&q;teacherStat&q;:{&q;teacherId&q;:16892,&q;episodeCount&q;:366,&q;scoreCount&q;:1043,&q;avgScore&q;:9.892617449664424,&q;fiveGradeAvgScore&q;:4.95,&q;updateTime&q;:1773542090436},&q;auditionEpisode&q;:{&q;episodeTitle&q;:&q;个人展示课&q;,&q;episodeVideoUrl&q;:&q;https://vod.fbstatic.cn/22e9ceb2vodbj1251001446/c851eb6f5145403710133043770/P6pa1nY0NqgA.mp4?t=f2a4b300&a;us=4070880000&a;sign=560efd01ae975cc0d0456e09500eb8d0&q;},&q;memberOfCPC&q;:false,&q;tags&q;:null},{&q;id&q;:32923,&q;userId&q;:83087094,&q;name&q;:&q;杨优秀&q;,&q;brief&q;:&q;粉笔优质讲师&q;,&q;desc&q;:&q;粉笔优质教师\n8年一线教学授课经验，线上累计授课超1000小时，授课人数10000+，线下曾担任联考言语主讲老师，具有言语理解与表达科目丰富的实践经验及系统扎实的专业理论知识。线下与线上授课经验丰富，善于讲解联考、江苏、浙江、广东各省言语课程，对于言语题型有独到的见解，能够多方面把握学员需求，精准定位学员薄弱点。多次参加粉笔教研活动，参与笔试真题解析与精品班精品挑战选题，助力粉笔理论研发升级。积极参与各项比赛，曾获粉笔风采大赛“最具风格奖”，娓娓道来的授课风格，让学生在轻松的学习氛围中，用更简单的方法，找到更快捷的解题之道，深受广大学员的认可和好评。&q;,&q;avatar&q;:&q;1785e21dcfe8463.jpg&q;,&q;upperBodyPhoto&q;:null,&q;displayCoursePrefix&q;:&q;sydw&q;,&q;teacherStat&q;:{&q;teacherId&q;:32923,&q;episodeCount&q;:374,&q;scoreCount&q;:1626,&q;avgScore&q;:9.857318573185726,&q;fiveGradeAvgScore&q;:4.93,&q;updateTime&q;:1772881550179},&q;auditionEpisode&q;:null,&q;memberOfCPC&q;:false,&q;tags&q;:null},{&q;id&q;:13526,&q;userId&q;:48601508,&q;name&q;:&q;冯春雨&q;,&q;brief&q;:&q;粉笔优质讲师&q;,&q;desc&q;:&q;粉笔常识公基优质教师\n     六年一线教学授课经验，具有丰富的实践经验及系统扎实的专业理论知识，态度严谨，知识储备深厚，授课思路清晰，风格风趣幽默，善于抓住学员学习薄弱点，因材施教，易于激发学员学习热情，深受广大学员的认可和好评。&q;,&q;avatar&q;:&q;1983b565ff03e7b.jpg&q;,&q;upperBodyPhoto&q;:null,&q;displayCoursePrefix&q;:&q;sydw&q;,&q;teacherStat&q;:{&q;teacherId&q;:13526,&q;episodeCount&q;:661,&q;scoreCount&q;:5775,&q;avgScore&q;:9.77593073593074,&q;fiveGradeAvgScore&q;:4.89,&q;updateTime&q;:1773240032843},&q;auditionEpisode&q;:{&q;episodeTitle&q;:&q;个人展示课&q;,&q;episodeVideoUrl&q;:&q;https://vod.fbstatic.cn/22e9ceb2vodbj1251001446/5ba385475145403708398283831/7GT7IAU0lBMA.mp4?t=f2a4b300&a;us=4070880000&a;sign=b9f34bbf2057adc9158f0bcdd0d61937&q;},&q;memberOfCPC&q;:false,&q;tags&q;:null},{&q;id&q;:17123,&q;userId&q;:72289813,&q;name&q;:&q;金玉蕾&q;,&q;brief&q;:&q;粉笔优质讲师&q;,&q;desc&q;:&q;粉笔优质讲师\n6年一线教学授课经验，对历年事业单位言语模块的考查重点和解题技巧深有研究，多次参加粉笔教研活动，分享授课经验，有较强的授课逻辑，善于用更简单的方法找到更快捷的解题之道，温柔耐心有亲和力，深受学生喜爱。&q;,&q;avatar&q;:&q;1747147a3f70a29.jpg&q;,&q;upperBodyPhoto&q;:null,&q;displayCoursePrefix&q;:&q;sydw&q;,&q;teacherStat&q;:{&q;teacherId&q;:17123,&q;episodeCount&q;:690,&q;scoreCount&q;:1157,&q;avgScore&q;:9.882454624027659,&q;fiveGradeAvgScore&q;:4.94,&q;updateTime&q;:1773559079322},&q;auditionEpisode&q;:{&q;episodeTitle&q;:&q;个人展示课&q;,&q;episodeVideoUrl&q;:&q;https://vod.fbstatic.cn/22e9ceb2vodbj1251001446/5641fbbb5145403709404435570/6rPA2U5971kA.mp4?t=f2a4b300&a;us=4070880000&a;sign=1002b62d9d0f44f513cd6c302085e4da&q;},&q;memberOfCPC&q;:false,&q;tags&q;:null},{&q;id&q;:15514,&q;userId&q;:63317913,&q;name&q;:&q;唐邦杰&q;,&q;brief&q;:&q;粉笔优质讲师&q;,&q;desc&q;:&q;粉笔优质教师\n6年一线教学授课经验，线上累计授课超1000+小时，授课人数2500+，始终教研结合，紧跟命题走向，强调知识更新。善于讲解联考A、江苏、浙江、山东、广东各省综应课程，对于综应解题技巧有独到的见解，并参与综应各大题型人工批改服务上千份，能够多方面把握学员需求，精准定位学员薄弱点。全面了解事业单位综合应用能力考试的命题规律及答题技巧，授课经验丰富，逻辑清晰，思维严谨，擅长总结，深受广大学员的认可和好评，在学员中具有非常好的口碑，是值得信赖的好导师。&q;,&q;avatar&q;:&q;198411427ad51c5.jpg&q;,&q;upperBodyPhoto&q;:null,&q;displayCoursePrefix&q;:&q;sydw&q;,&q;teacherStat&q;:{&q;teacherId&q;:15514,&q;episodeCount&q;:512,&q;scoreCount&q;:787,&q;avgScore&q;:9.9135959339263,&q;fiveGradeAvgScore&q;:4.96,&q;updateTime&q;:1772548329533},&q;auditionEpisode&q;:{&q;episodeTitle&q;:&q;个人展示课&q;,&q;episodeVideoUrl&q;:&q;https://vod.fbstatic.cn/22e9ceb2vodbj1251001446/5402b0855145403709207407994/antnJrlNvLMA.mp4?t=f2a4b300&a;us=4070880000&a;sign=cd84b92e364976b35f69adb6cf6cd1b7&q;},&q;memberOfCPC&q;:false,&q;tags&q;:null},{&q;id&q;:35886,&q;userId&q;:67276705,&q;name&q;:&q;张锜&q;,&q;brief&q;:&q;粉笔优质讲师&q;,&q;desc&q;:&q;粉笔优质讲师\n深耕一线教学已 6 年，累计授课超 1400 小时，服务过数千名学员，无论是线上系统班、线下冲刺营，还是各类专项提升课程，都有丰富的实战授课经验，也凭借稳定的教学质量收获了 4.9 分的累计高分评价。​\n在专业上，始终保持深耕态度，不仅有着扎实的理论功底，还长期参与教研文章撰写、真题解析及模拟题命制工作。对事业单位考试的考情特点、真题规律有着深刻理解，也持续追踪最新命题趋势，能精准抓核心考点、避开备考误区。​\n授课风格偏向深入浅出、化繁为简，习惯用清晰的逻辑拆解复杂知识点，再搭配生动有趣的案例和讲解，让课堂氛围更轻松。在教学过程能让学员摆脱枯燥刷题的困扰，在激发学员学习兴趣的同时，高效掌握解题技巧、稳步提升分数！&q;,&q;avatar&q;:&q;193b4b5885baa1e.jpg&q;,&q;upperBodyPhoto&q;:null,&q;displayCoursePrefix&q;:&q;sydw&q;,&q;teacherStat&q;:{&q;teacherId&q;:35886,&q;episodeCount&q;:234,&q;scoreCount&q;:594,&q;avgScore&q;:9.939393939393938,&q;fiveGradeAvgScore&q;:4.97,&q;updateTime&q;:1772972523561},&q;auditionEpisode&q;:{&q;episodeTitle&q;:&q;个人展示课&q;,&q;episodeVideoUrl&q;:&q;https://vod.fbstatic.cn/22e9ceb2vodbj1251001446/6b3451935145403714882890898/WRAmB8ael4MA.mp4?t=f2a4b300&a;us=4070880000&a;sign=f787cad792e210e99042e97c77ccd181&q;},&q;memberOfCPC&q;:false,&q;tags&q;:null},{&q;id&q;:64162,&q;userId&q;:110832430,&q;name&q;:&q;李习研&q;,&q;brief&q;:&q;粉笔优质讲师&q;,&q;desc&q;:&q;粉笔优质讲师\n多年公考笔试一线授课，同时深度参与行测多省份真题解析，精准把握笔试考点分布、题型规律，擅长拆解笔试重难点。多次负责复读班学员拔高课程，帮学员快速掌握秒解技巧、避坑思路，善于帮助基础薄弱学员进行考点扫盲，进阶学员主攻难点突破和套卷提速，帮助不同阶段学员高效提分，广受学员认可。&q;,&q;avatar&q;:&q;1983b49f6f07173.jpg&q;,&q;upperBodyPhoto&q;:null,&q;displayCoursePrefix&q;:&q;sydw&q;,&q;teacherStat&q;:{&q;teacherId&q;:64162,&q;episodeCount&q;:613,&q;scoreCount&q;:908,&q;avgScore&q;:9.898678414096922,&q;fiveGradeAvgScore&q;:4.95,&q;updateTime&q;:1773565562983},&q;auditionEpisode&q;:{&q;episodeTitle&q;:&q;个人展示课&q;,&q;episodeVideoUrl&q;:&q;https://vod.fbstatic.cn/22e9ceb2vodbj1251001446/87cc220e5145403709544989066/D8SBqUhVQmwA.mp4?t=f2a4b300&a;us=4070880000&a;sign=bdcb568885c47de175330be0361ea43d&q;},&q;memberOfCPC&q;:false,&q;tags&q;:null},{&q;id&q;:18603,&q;userId&q;:68241941,&q;name&q;:&q;陈小微&q;,&q;brief&q;:&q;粉笔优质讲师&q;,&q;desc&q;:&q;粉笔优质教师\n双一流硕士毕业，六年一线教学经验，深耕事业单位考试，对考情分析、命题思路深入钻研。\n具有言语科目丰富的实践经验及系统扎实的专业理论知识。\n善用启发式的授课方法，注重题目分析的严谨性与授课的逻辑性，让学生在轻松的学习氛围中，用更简单的方法，找到更快捷的解题之道，授课累计评分4.9，深受广大学员的认可和好评。            \n多次参与粉笔授课研讨会议，注重自我提升，不断夯实与更新教学讲法。&q;,&q;avatar&q;:&q;174cea1032f86a6.jpg&q;,&q;upperBodyPhoto&q;:null,&q;displayCoursePrefix&q;:&q;sydw&q;,&q;teacherStat&q;:{&q;teacherId&q;:18603,&q;episodeCount&q;:285,&q;scoreCount&q;:1085,&q;avgScore&q;:9.88018433179723,&q;fiveGradeAvgScore&q;:4.94,&q;updateTime&q;:1773613889725},&q;auditionEpisode&q;:{&q;episodeTitle&q;:&q;个人展示课&q;,&q;episodeVideoUrl&q;:&q;https://vod.fbstatic.cn/22e9ceb2vodbj1251001446/e1f5f7455145403709542456268/X8EEqKKa2aYA.mp4?t=f2a4b300&a;us=4070880000&a;sign=2c3fe60aa2311d5b5129c494fd5245a0&q;},&q;memberOfCPC&q;:false,&q;tags&q;:null},{&q;id&q;:34199,&q;userId&q;:73996160,&q;name&q;:&q;卫斗妮&q;,&q;brief&q;:&q;粉笔优质讲师&q;,&q;desc&q;:&q;粉笔优质讲师\n5年一线教学授课经验\n具有数量关系和资料分析科目丰富的实践经验及系统扎实的专业理论知识\n多次参加粉笔授课研讨会议，全面把握公考面试命题趋势及最新考情，积累丰富面试知识；\n多次参加粉笔教研活动，分享授课经验心得，助力粉笔理论研发升级；\n累计获得广泛好评，具有启发式的授课风格，让学生在轻松的学习氛围中，用更简单的方法，找到更快捷的解题之道，深受广大学员的认可和好评；在学员中具有非常好的口碑，是值得信赖的好导师。&q;,&q;avatar&q;:&q;198594b4cf62f8a.jpg&q;,&q;upperBodyPhoto&q;:null,&q;displayCoursePrefix&q;:&q;sydw&q;,&q;teacherStat&q;:{&q;teacherId&q;:34199,&q;episodeCount&q;:556,&q;scoreCount&q;:1224,&q;avgScore&q;:9.869281045751636,&q;fiveGradeAvgScore&q;:4.93,&q;updateTime&q;:1773544378749},&q;auditionEpisode&q;:null,&q;memberOfCPC&q;:false,&q;tags&q;:null},{&q;id&q;:52945,&q;userId&q;:95973685,&q;name&q;:&q;张洪铭&q;,&q;brief&q;:&q;粉笔优质讲师&q;,&q;desc&q;:&q;粉笔常识公基优质讲师\n6年一线教学，教研经验，线上线下授课人数千余人，累计授课时常3000+。\n具有丰富的常识公共基础知识，言语理解与表达学科的教学经验，曾参与模拟题撰写等工作，专业知识丰富，深入了解各地考试的考情以及题型分布及变化\n授课思路严谨，讲解细致全面，善于对知识点进行总结并举一反三，让学生找到解题捷径，轻松掌握学科重难点内容，深受学员高度认可。&q;,&q;avatar&q;:&q;1984fed0d75a637.jpg&q;,&q;upperBodyPhoto&q;:null,&q;displayCoursePrefix&q;:&q;sydw&q;,&q;teacherStat&q;:{&q;teacherId&q;:52945,&q;episodeCount&q;:636,&q;scoreCount&q;:1419,&q;avgScore&q;:9.857646229739261,&q;fiveGradeAvgScore&q;:4.93,&q;updateTime&q;:1773574117595},&q;auditionEpisode&q;:{&q;episodeTitle&q;:&q;个人展示课&q;,&q;episodeVideoUrl&q;:&q;https://vod.fbstatic.cn/22e9ceb2vodbj1251001446/eaefb0e95145403709542805985/PwsWWzAs6BAA.mp4?t=f2a4b300&a;us=4070880000&a;sign=01f34975ceabae066065aaa89a37f57b&q;},&q;memberOfCPC&q;:false,&q;tags&q;:null},{&q;id&q;:56388,&q;userId&q;:95971831,&q;name&q;:&q;林栗&q;,&q;brief&q;:&q;粉笔优质讲师&q;,&q;desc&q;:&q;粉笔优质教师\n多年一线教学授课经验，具有判断科目丰富的实践经验及系统扎实的专业理论知识，全面了解事业单位判断推理部分的命题规律及管题技巧，善于结合学员实际情况，对知识点进行针对性讲解，善于通过启发式教学，激发学员自主思考能力，有效帮助学员快速提高。&q;,&q;avatar&q;:&q;1985a5de8a9346e.jpg&q;,&q;upperBodyPhoto&q;:null,&q;displayCoursePrefix&q;:&q;sydw&q;,&q;teacherStat&q;:{&q;teacherId&q;:56388,&q;episodeCount&q;:290,&q;scoreCount&q;:1061,&q;avgScore&q;:9.877474081055611,&q;fiveGradeAvgScore&q;:4.94,&q;updateTime&q;:1773473571043},&q;auditionEpisode&q;:{&q;episodeTitle&q;:&q;个人展示课&q;,&q;episodeVideoUrl&q;:&q;https://vod.fbstatic.cn/22e9ceb2vodbj1251001446/c81f82965145403714072054931/hyScwfm0Fo8A.mp4?t=f2a4b300&a;us=4070880000&a;sign=9fe4d91480a427e06131a0f5f04af827&q;},&q;memberOfCPC&q;:false,&q;tags&q;:null},{&q;id&q;:12512,&q;userId&q;:58005817,&q;name&q;:&q;王红艳&q;,&q;brief&q;:&q;粉笔优质讲师&q;,&q;desc&q;:&q;粉笔优质教师\n5年一线教学授课经验，具有判断科日丰富的实践经验及系统扎实的专业理论知识多次参加粉笔授课研讨会议，全面把握笔试命题趋势及最新考情，积累丰富笔试知识;多次参加粉笔教研活动，助力粉笔理论研发升级。 具有轻松愉快的授课风格，让学生在轻松的学习氛围中，用更简单的方法，找到更快捷的解题之道，深受广大学员的认可和好评;在学员中具有非常好的口碑，是值得信赖的好老师。&q;,&q;avatar&q;:&q;173282b5ad9bf5d.jpg&q;,&q;upperBodyPhoto&q;:null,&q;displayCoursePrefix&q;:&q;sydw&q;,&q;teacherStat&q;:{&q;teacherId&q;:12512,&q;episodeCount&q;:450,&q;scoreCount&q;:1751,&q;avgScore&q;:9.837806967447161,&q;fiveGradeAvgScore&q;:4.92,&q;updateTime&q;:1773544368704},&q;auditionEpisode&q;:{&q;episodeTitle&q;:&q;个人展示课&q;,&q;episodeVideoUrl&q;:&q;https://vod.fbstatic.cn/22e9ceb2vodbj1251001446/1811c8775145403708030729602/DlZftSuVwFEA.mp4?t=f2a4b300&a;us=4070880000&a;sign=80b23c5d9b327cc41b9292c6620ca934&q;},&q;memberOfCPC&q;:false,&q;tags&q;:null},{&q;id&q;:15889,&q;userId&q;:64389211,&q;name&q;:&q;佟兴苗&q;,&q;brief&q;:&q;粉笔优质讲师&q;,&q;desc&q;:&q;粉笔优质讲师\n6年一线教育教学经验，承担各种线上线下授课任务；\n多次参与模拟题撰写、真题解析等日常教研活动，对于各类考试考情、考试重点有深入了解；\n授课风格严谨认真，心思细腻，善于倾听学员的学习诉求，并及时回应。讲课细致耐心，课堂氛围轻松活跃，学员可以获得良好的学习体验。&q;,&q;avatar&q;:&q;193b3955985d9e8.jpg&q;,&q;upperBodyPhoto&q;:null,&q;displayCoursePrefix&q;:&q;sydw&q;,&q;teacherStat&q;:{&q;teacherId&q;:15889,&q;episodeCount&q;:428,&q;scoreCount&q;:1564,&q;avgScore&q;:9.84526854219949,&q;fiveGradeAvgScore&q;:4.92,&q;updateTime&q;:1773477236816},&q;auditionEpisode&q;:{&q;episodeTitle&q;:&q;个人展示课&q;,&q;episodeVideoUrl&q;:&q;https://vod.fbstatic.cn/22e9ceb2vodbj1251001446/d5f243805145403719017149437/AMt7Sct1Kn4A.mp4?t=f2a4b300&a;us=4070880000&a;sign=65cfa849fb35c3672bb4b6b6eb409bc4&q;},&q;memberOfCPC&q;:false,&q;tags&q;:null},{&q;id&q;:33934,&q;userId&q;:47842292,&q;name&q;:&q;王小雪&q;,&q;brief&q;:&q;粉笔优质讲师&q;,&q;desc&q;:&q;粉笔优质讲师\n6年一线教学经验，累计授课超过2500小时，累计评分达4.9分，深耕事业单位笔试考试，授课和实战经验丰富。\n在综应科目教学中，参与过多次综应真题教研，积累大量使用经验，专业理论知识扎实，对事业单位考试考情、真题等理解深刻。\n授课特色：授课风格多样化，风趣幽默，生动形象。授课内容上，知识点讲解细致，善于化繁为简，能够耐心引导，准确把握重点，深受学员喜爱。&q;,&q;avatar&q;:&q;17d222383a2be22.jpg&q;,&q;upperBodyPhoto&q;:null,&q;displayCoursePrefix&q;:&q;sydw&q;,&q;teacherStat&q;:{&q;teacherId&q;:33934,&q;episodeCount&q;:352,&q;scoreCount&q;:654,&q;avgScore&q;:9.917431192660548,&q;fiveGradeAvgScore&q;:4.96,&q;updateTime&q;:1773322484439},&q;auditionEpisode&q;:{&q;episodeTitle&q;:&q;个人展示课&q;,&q;episodeVideoUrl&q;:&q;https://vod.fbstatic.cn/22e9ceb2vodbj1251001446/cfa2d5445145403707474934084/ZImz8czb8RcA.mp4?t=f2a4b300&a;us=4070880000&a;sign=1521fbe9ea574acc07dbe931b344661e&q;},&q;memberOfCPC&q;:false,&q;tags&q;:null},{&q;id&q;:15525,&q;userId&q;:70929101,&q;name&q;:&q;曾庆顺&q;,&q;brief&q;:&q;粉笔优质讲师&q;,&q;desc&q;:&q;粉笔优质讲师\n7年一线教学经验，长期从事一线教学教研工作，承担过线上精品班、刷题班等多种班型，授课时长逾千小时。\n具有丰富的公共基础知识和言语理解与表达科目实践经验，专业理论知识系统扎实，对各地事业单位考试考情、真题和命题方向理解深刻。\n善于整合梳理琐碎的知识，授课方式轻松、逻辑清晰，针对性强，能够帮助学员快速掌握考试内容，高效应对考试，广受学员好评。&q;,&q;avatar&q;:&q;1942615d3a3ad1d.jpg&q;,&q;upperBodyPhoto&q;:null,&q;displayCoursePrefix&q;:&q;sydw&q;,&q;teacherStat&q;:{&q;teacherId&q;:15525,&q;episodeCount&q;:806,&q;scoreCount&q;:2325,&q;avgScore&q;:9.814193548387102,&q;fiveGradeAvgScore&q;:4.91,&q;updateTime&q;:1773546837992},&q;auditionEpisode&q;:{&q;episodeTitle&q;:&q;个人展示课&q;,&q;episodeVideoUrl&q;:&q;https://vod.fbstatic.cn/22e9ceb2vodbj1251001446/71ee116a5145403709537258089/2LP134uazlcA.mp4?t=f2a4b300&a;us=4070880000&a;sign=2d5f6eba8adee3c57c0ab2f8326a11f5&q;},&q;memberOfCPC&q;:false,&q;tags&q;:null},{&q;id&q;:22805,&q;userId&q;:70647629,&q;name&q;:&q;韩健&q;,&q;brief&q;:&q;粉笔优质讲师&q;,&q;desc&q;:&q;粉笔优质讲师。从事线上常识公基科目教研授课长达6年，拥有非常丰富扎实的一线授课经验，承担多种产品类型的授课工作。\n教研上，具有非法科目丰富的实践经验及系统扎实的专业理论知识，对常识公基非法考情有着深入的研究，长期承担非法板块小模考授课，曾多次参与命制笔试真题教研和解析撰写工作，致力于研究事业单位的命题规律及答题技巧，并负责非法多科目单题录制工作。\n教学上，教学思路开阔，灵活举一反三，深入浅出，善于引导和启发学生；讲课逻辑性强条分缕析，善长归纳方法技巧；课堂互动性强，善于从学员角度出发解决问题。\n授课风格循循善诱，细致耐心，亲和力强，寓教于乐，课堂氛围轻松有趣无负担，深受学生喜爱，长期累计评分达4.9，广受信赖。&q;,&q;avatar&q;:&q;193af5a8fdca2ae.jpg&q;,&q;upperBodyPhoto&q;:null,&q;displayCoursePrefix&q;:&q;sydw&q;,&q;teacherStat&q;:{&q;teacherId&q;:22805,&q;episodeCount&q;:944,&q;scoreCount&q;:2442,&q;avgScore&q;:9.809172809172814,&q;fiveGradeAvgScore&q;:4.9,&q;updateTime&q;:1773565663692},&q;auditionEpisode&q;:{&q;episodeTitle&q;:&q;个人展示课&q;,&q;episodeVideoUrl&q;:&q;https://vod.fbstatic.cn/22e9ceb2vodbj1251001446/c570221f5145403709396241830/189czrPabqQA.mp4?t=f2a4b300&a;us=4070880000&a;sign=a910a17501a492740f4ece27556c8403&q;},&q;memberOfCPC&q;:false,&q;tags&q;:null},{&q;id&q;:64296,&q;userId&q;:82919856,&q;name&q;:&q;李敖&q;,&q;brief&q;:&q;粉笔优质讲师&q;,&q;desc&q;:&q;粉笔优质讲师\n从事4年公考事考授课培训教研工作，累计授课时长超过1500h，承担精讲、刷题、冲刺、二战班多种班型，逻辑思维严谨，教学经验丰富。授课条理清晰且幽默风趣，互动性强，善于总结重难点，引导学生主动思考，开拓思路学会举一反三，在轻松的氛围中掌握知识，学会独立做题的方法和技巧。&q;,&q;avatar&q;:&q;1945f2e8f67c8f7.jpg&q;,&q;upperBodyPhoto&q;:null,&q;displayCoursePrefix&q;:&q;sydw&q;,&q;teacherStat&q;:{&q;teacherId&q;:64296,&q;episodeCount&q;:518,&q;scoreCount&q;:1591,&q;avgScore&q;:9.83909490886235,&q;fiveGradeAvgScore&q;:4.92,&q;updateTime&q;:1773547561335},&q;auditionEpisode&q;:{&q;episodeTitle&q;:&q;个人展示课&q;,&q;episodeVideoUrl&q;:&q;https://vod.fbstatic.cn/22e9ceb2vodbj1251001446/0f56d9f01397757890216433385/ajyRFn5cUesA.mp4?t=f2a4b300&a;us=4070880000&a;sign=ca55008cd46d38ea20f6d87ab15f1455&q;},&q;memberOfCPC&q;:false,&q;tags&q;:null},{&q;id&q;:32713,&q;userId&q;:74303567,&q;name&q;:&q;李佳琪&q;,&q;brief&q;:&q;粉笔优质讲师&q;,&q;desc&q;:&q;粉笔优质讲师\n5年一线教学经验，承担过线上多种班型。\n承担常识公基法律与判断推理两个学科领域的督学与授课，相关理论内容基础扎实，日常承担多项工作，包括真题解析、单题录制、撰写教研文章以及直播授课等，总授课时长超过一千小时。\n学员口碑：课程累计评分为达4.9，课堂氛围轻松，考点讲解清晰，擅长举例讲解，让学员易于接受知识点。课堂上也善于引导学员思考，加深对考点的记忆，备受学员喜爱。&q;,&q;avatar&q;:&q;1984f1cfc0e94f5.jpg&q;,&q;upperBodyPhoto&q;:null,&q;displayCoursePrefix&q;:&q;sydw&q;,&q;teacherStat&q;:{&q;teacherId&q;:32713,&q;episodeCount&q;:636,&q;scoreCount&q;:868,&q;avgScore&q;:9.887096774193548,&q;fiveGradeAvgScore&q;:4.94,&q;updateTime&q;:1773579049093},&q;auditionEpisode&q;:{&q;episodeTitle&q;:&q;个人展示课&q;,&q;episodeVideoUrl&q;:&q;https://vod.fbstatic.cn/22e9ceb2vodbj1251001446/ca9a07581397757888016826661/lrMasTgKVqQA.mp4?t=f2a4b300&a;us=4070880000&a;sign=2b5bbe0bde9ea6d06b056222865a2b6a&q;},&q;memberOfCPC&q;:false,&q;tags&q;:null},{&q;id&q;:17050,&q;userId&q;:69384227,&q;name&q;:&q;刘枭&q;,&q;brief&q;:&q;粉笔优质讲师&q;,&q;desc&q;:&q;粉笔优质讲师。\n硕士毕业，从事线上常识公基科目教研授课长达6年，拥有非常丰富扎实的一线授课经验，承担多种产品类型的授课工作。\n教学上，具有常识公基非法科目丰富的实践经验及扎实的专业知识，对常识公基非法考情有着深入的研究，长期承担非法板块小模考授课，曾多次参与命制笔试真题教研和解析撰写工作，致力于研究事业单位的命题规律及答题技巧。\n授课深入浅出，举一反三，善于引导和启发学生；讲课逻辑性强条分缕析，善长归纳方法技巧；从学员角度出发解决问题，长期累计评分达4.9。细致耐心，寓教于乐，善于营造轻松愉悦的课堂氛围，深受学生喜爱。&q;,&q;avatar&q;:&q;17470a2ced5ee4c.jpg&q;,&q;upperBodyPhoto&q;:null,&q;displayCoursePrefix&q;:&q;sydw&q;,&q;teacherStat&q;:{&q;teacherId&q;:17050,&q;episodeCount&q;:730,&q;scoreCount&q;:2726,&q;avgScore&q;:9.798972853998558,&q;fiveGradeAvgScore&q;:4.9,&q;updateTime&q;:1773476302738},&q;auditionEpisode&q;:{&q;episodeTitle&q;:&q;个人展示课&q;,&q;episodeVideoUrl&q;:&q;https://vod.fbstatic.cn/22e9ceb2vodbj1251001446/9ae2fc415145403708185095920/NpmeJff4ztMA.mp4?t=f2a4b300&a;us=4070880000&a;sign=de1c4dfab32e0a94c2ae19673faed255&q;},&q;memberOfCPC&q;:false,&q;tags&q;:null},{&q;id&q;:52293,&q;userId&q;:80180258,&q;name&q;:&q;张沫沫&q;,&q;brief&q;:&q;粉笔优质讲师&q;,&q;desc&q;:&q;粉笔优质讲师\n6年一线教学，深耕事业单位考试，总授课时长2000+h。\n承担过线上和线下的笔试精品班、刷题班、冲刺班等多种班型。线上公开课引人入胜，平均单次上课人数1000+。\n多次参与模拟题教研与命制、事业单位真题教研与解析，凭借敏锐的洞察力，精准把握考点的变化与走向，为学员备考指引清晰方向。\n高效技巧：总结出一套独特的解题技巧体系，帮助学员在有限时间内快速准确解题。\n因材施教：深知每个学员的基础、学习能力和风格各异，善于将枯燥的知识转化为生动有趣的案例。秉持因材施教的原则，为学员量身定制学习方案。\n凭借其深厚的专业知识、丰富的教学经验和认真负责的教学态度，赢得了学员们的一致赞誉和高度认可。学员们纷纷表示，老师的课程生动有趣、实用性强，不仅帮助他们掌握了知识和技巧，更在备考过程中给予了精神支持和鼓励。所带学员在事业单位笔试中成绩斐然，众多学员在考试中取得优异成绩，成功进入面试环节。&q;,&q;avatar&q;:&q;17ef63de64cbb55.jpg&q;,&q;upperBodyPhoto&q;:null,&q;displayCoursePrefix&q;:&q;sydw&q;,&q;teacherStat&q;:{&q;teacherId&q;:52293,&q;episodeCount&q;:543,&q;scoreCount&q;:2574,&q;avgScore&q;:9.802641802641809,&q;fiveGradeAvgScore&q;:4.9,&q;updateTime&q;:1773281606121},&q;auditionEpisode&q;:{&q;episodeTitle&q;:&q;个人展示课&q;,&q;episodeVideoUrl&q;:&q;https://nodestatic.fbstatic.cn/video_qhd/1714474876942.mp4&q;},&q;memberOfCPC&q;:false,&q;tags&q;:null},{&q;id&q;:16651,&q;userId&q;:43424856,&q;name&q;:&q;杜姿乐&q;,&q;brief&q;:&q;粉笔优质讲师&q;,&q;desc&q;:&q;粉笔常识公基优质讲师。5年教学经验，全面了解考试重难点及不同类型题目答题技巧，授课思路清晰，能帮助学员高效备考。授课思路清晰，考点突出，知识点讲解细致，善诱循循，因材施教，深受学生喜爱。&q;,&q;avatar&q;:&q;19840fb4e37e187.jpg&q;,&q;upperBodyPhoto&q;:null,&q;displayCoursePrefix&q;:&q;sydw&q;,&q;teacherStat&q;:{&q;teacherId&q;:16651,&q;episodeCount&q;:751,&q;scoreCount&q;:6001,&q;avgScore&q;:9.749708381936355,&q;fiveGradeAvgScore&q;:4.87,&q;updateTime&q;:1773580276381},&q;auditionEpisode&q;:{&q;episodeTitle&q;:&q;个人展示课&q;,&q;episodeVideoUrl&q;:&q;https://vod.fbstatic.cn/22e9ceb2vodbj1251001446/3eb3377d5145403710131746857/zh5vva2I9DEA.mp4?t=f2a4b300&a;us=4070880000&a;sign=ba612bd296cc820cb8b2a3a70e21fc52&q;},&q;memberOfCPC&q;:false,&q;tags&q;:null},{&q;id&q;:23908,&q;userId&q;:78283874,&q;name&q;:&q;许苗苗&q;,&q;brief&q;:&q;粉笔优质讲师&q;,&q;desc&q;:&q;粉笔优质讲师\n六年一线教学授课经验，承担过线上、线下笔试精品班多种班型课程，授课经验丰富，擅于总结知识点。\n有扎实的理论知识基础和丰富的实战经验，全面把握各个地区的考试情况和命题趋势，可以更好辨析不同知识点的区别关键点，解决学员的疑惑点；目前授课评分达4.9分，善于归纳和总结数资的学习方法，授课思维逻辑严谨清晰，通俗易懂，能帮助学员提供多种解题思路，更好地理解掌握数资内容，提高答题的正确率和速度，深受学员好评。&q;,&q;avatar&q;:&q;1945f3cf66cbd8c.jpg&q;,&q;upperBodyPhoto&q;:null,&q;displayCoursePrefix&q;:&q;sydw&q;,&q;teacherStat&q;:{&q;teacherId&q;:23908,&q;episodeCount&q;:430,&q;scoreCount&q;:1123,&q;avgScore&q;:9.861086375779168,&q;fiveGradeAvgScore&q;:4.93,&q;updateTime&q;:1766110373004},&q;auditionEpisode&q;:{&q;episodeTitle&q;:&q;个人展示课&q;,&q;episodeVideoUrl&q;:&q;https://vod.fbstatic.cn/22e9ceb2vodbj1251001446/8b9d686f1253642696527671297/OhQurD2xhWsA.mp4?t=f2a4b300&a;us=4070880000&a;sign=41febbbae155f49bcac8f627babcda5f&q;},&q;memberOfCPC&q;:false,&q;tags&q;:null},{&q;id&q;:16920,&q;userId&q;:60928347,&q;name&q;:&q;刘巍&q;,&q;brief&q;:&q;粉笔优质讲师&q;,&q;desc&q;:&q;粉笔优质讲师\n6年一线教学经验，授课与实战经验丰富； \n在判断科目教学中，参与过多次判断真题教研、多次参与模拟题撰写及审核工作，积累大量使用经验，专业理论知识扎实，对事业单位考试考情、真题等理解深刻\n累计授课1000+小时，授课累计评分4.9分，深受学员的喜爱与认可。\n授课逻辑清晰，讲解细致，通俗易懂，因材施教，为学员提供个性化帮助。讲课细致耐心，课堂氛围轻松活跃,能够帮助学员将所学理论更好应用在实际做题中。&q;,&q;avatar&q;:&q;1746cde0ef0f624.jpg&q;,&q;upperBodyPhoto&q;:null,&q;displayCoursePrefix&q;:&q;sydw&q;,&q;teacherStat&q;:{&q;teacherId&q;:16920,&q;episodeCount&q;:662,&q;scoreCount&q;:2601,&q;avgScore&q;:9.796232218377565,&q;fiveGradeAvgScore&q;:4.9,&q;updateTime&q;:1773622939246},&q;auditionEpisode&q;:{&q;episodeTitle&q;:&q;个人展示课&q;,&q;episodeVideoUrl&q;:&q;https://vod.fbstatic.cn/22e9ceb2vodbj1251001446/607279c25145403713946934153/vsAmh2ZkdSwA.mp4?t=f2a4b300&a;us=4070880000&a;sign=eb2972679a3f405d7a8df877bf6117ea&q;},&q;memberOfCPC&q;:false,&q;tags&q;:null},{&q;id&q;:16797,&q;userId&q;:74150937,&q;name&q;:&q;秦婉琳&q;,&q;brief&q;:&q;粉笔优质讲师&q;,&q;desc&q;:&q;粉笔常识公基优质讲师。六年一线教学授课经验，实战经验与教学成果丰富，知识体系完善，多次参与教研活动，全面把握命题趋势和最新考情，精准把握学科重难点，教学内容始终处于学科前沿。授课思路清晰，能拓展学生思维，根据学员情况制定不同的学习方法，助力学员上岸。&q;,&q;avatar&q;:&q;1746c69e9a158f9.jpg&q;,&q;upperBodyPhoto&q;:null,&q;displayCoursePrefix&q;:&q;sydw&q;,&q;teacherStat&q;:{&q;teacherId&q;:16797,&q;episodeCount&q;:573,&q;scoreCount&q;:6338,&q;avgScore&q;:9.741558851372673,&q;fiveGradeAvgScore&q;:4.87,&q;updateTime&q;:1773584669410},&q;auditionEpisode&q;:{&q;episodeTitle&q;:&q;个人展示课&q;,&q;episodeVideoUrl&q;:&q;https://vod.fbstatic.cn/22e9ceb2vodbj1251001446/aabcdc611397757888019551987/XgHb2tiiyfYA.mp4?t=f2a4b300&a;us=4070880000&a;sign=7cee664e2520430e8f66bb562ac9ebba&q;},&q;memberOfCPC&q;:false,&q;tags&q;:null},{&q;id&q;:13583,&q;userId&q;:63832765,&q;name&q;:&q;王志芮&q;,&q;brief&q;:&q;粉笔优质讲师&q;,&q;desc&q;:&q;粉笔常识公基优质教师  \n6年一线教学授课经验，硕士研究生，具有丰富的实践经验及系统扎实的专业理论知识，对事业单位考试、军队文职等考试考情深入研究。授课重点突出，能够及时总结拓展，讲解语言通俗易懂,擅长引导学生自主思考。&q;,&q;avatar&q;:&q;1737b567a8cb978.jpg&q;,&q;upperBodyPhoto&q;:null,&q;displayCoursePrefix&q;:&q;sydw&q;,&q;teacherStat&q;:{&q;teacherId&q;:13583,&q;episodeCount&q;:740,&q;scoreCount&q;:7550,&q;avgScore&q;:9.732185430463575,&q;fiveGradeAvgScore&q;:4.87,&q;updateTime&q;:1773557442022},&q;auditionEpisode&q;:{&q;episodeTitle&q;:&q;个人展示课&q;,&q;episodeVideoUrl&q;:&q;https://vod.fbstatic.cn/22e9ceb2vodbj1251001446/3010a99d5145403710498022656/JgnWsZBTnA4A.mp4?t=f2a4b300&a;us=4070880000&a;sign=996c1c0b8df55178268e7660e1d9ca29&q;},&q;memberOfCPC&q;:false,&q;tags&q;:null},{&q;id&q;:16569,&q;userId&q;:70075243,&q;name&q;:&q;尚美琦&q;,&q;brief&q;:&q;粉笔优质讲师&q;,&q;desc&q;:&q;粉笔优质教师\n六年一线教学授课经验，曾承担线上+线下精品班、刷题班授课，授课时长3000+小时 具有判断科目丰富的实践经验及系统扎实的专业理论知识，对事业编联考及军队文职考情深入研究 ①撰写多篇事业单位笔试教研材料，在粉笔教师内部进行共享； ②多次参加粉笔授课研讨会议，全面把握事考命题趋势及最新考情，多次参加粉笔教研活动，分享授课经验心得，助力粉笔理论研发升级 累计评分达4.9，细致幽默的讲解风格，让学生在轻松的学习氛围中，用更简单的方法，更通俗的例子解题，深受广大学员的认可和好评；在学员中具有非常好的口碑，是值得信赖的好导师。&q;,&q;avatar&q;:&q;17467e73b22e1a8.jpg&q;,&q;upperBodyPhoto&q;:null,&q;displayCoursePrefix&q;:&q;sydw&q;,&q;teacherStat&q;:{&q;teacherId&q;:16569,&q;episodeCount&q;:480,&q;scoreCount&q;:1699,&q;avgScore&q;:9.822248381400826,&q;fiveGradeAvgScore&q;:4.91,&q;updateTime&q;:1773611259167},&q;auditionEpisode&q;:{&q;episodeTitle&q;:&q;个人展示课&q;,&q;episodeVideoUrl&q;:&q;https://vod.fbstatic.cn/22e9ceb2vodbj1251001446/e44a7b0c5145403708868581059/9u4GtiC34EwA.mp4?t=f2a4b300&a;us=4070880000&a;sign=100de2e81d7376355ed86e067629ba50&q;},&q;memberOfCPC&q;:false,&q;tags&q;:null},{&q;id&q;:16991,&q;userId&q;:46502384,&q;name&q;:&q;岑红&q;,&q;brief&q;:&q;粉笔优质讲师&q;,&q;desc&q;:&q;粉笔优质教师\n       6年教学授课经验，具有判断科目丰富的实践经验及系统扎实的专业理论知识，参与笔试判断科目模拟题命制和解析审核且多次参加粉笔授课研讨会议，全面了解事业单位判断类题型的命题规律及答题技巧。善于将知识点简单化、条理化和趣味化以激发学生的学习热情，同时授课逻辑性强，思维严谨，能够意识到学生在知识点上的问题并给予相应的指导，深受广大学员的认可和好评。&q;,&q;avatar&q;:&q;19854eea5710183.jpg&q;,&q;upperBodyPhoto&q;:null,&q;displayCoursePrefix&q;:&q;sydw&q;,&q;teacherStat&q;:{&q;teacherId&q;:16991,&q;episodeCount&q;:496,&q;scoreCount&q;:2569,&q;avgScore&q;:9.792915531335142,&q;fiveGradeAvgScore&q;:4.9,&q;updateTime&q;:1773604268370},&q;auditionEpisode&q;:{&q;episodeTitle&q;:&q;个人展示课&q;,&q;episodeVideoUrl&q;:&q;https://vod.fbstatic.cn/22e9ceb2vodbj1251001446/10d5dbb55145403709539499496/emXm1Ym9kfIA.mp4?t=f2a4b300&a;us=4070880000&a;sign=fc844b010265e86e6742934e4dffdd3c&q;},&q;memberOfCPC&q;:false,&q;tags&q;:null},{&q;id&q;:16648,&q;userId&q;:74152754,&q;name&q;:&q;陈洋&q;,&q;brief&q;:&q;粉笔优质讲师&q;,&q;desc&q;:&q;粉笔优质教师\n6年一线教学授课经验，具有数资科目丰富的实践经验及系统扎实的专业理论知识，多次参加粉笔教研活动，分享授课经验心得，助力粉笔理论研发升级；\n授课逻辑清晰、重难点突出，课堂学习氛围轻松，让学员用更简单的方法，找到更快捷的解题之道，深受广大学员的认可和好评；在学员中具有非常好的口碑，是值得信赖的好导师。&q;,&q;avatar&q;:&q;1945f259dd30831.jpg&q;,&q;upperBodyPhoto&q;:null,&q;displayCoursePrefix&q;:&q;sydw&q;,&q;teacherStat&q;:{&q;teacherId&q;:16648,&q;episodeCount&q;:782,&q;scoreCount&q;:1917,&q;avgScore&q;:9.812206572769968,&q;fiveGradeAvgScore&q;:4.91,&q;updateTime&q;:1773573616029},&q;auditionEpisode&q;:{&q;episodeTitle&q;:&q;个人展示课&q;,&q;episodeVideoUrl&q;:&q;https://vod.fbstatic.cn/22e9ceb2vodbj1251001446/571009c11397757903436191001/71GyWjiNw7MA.mp4?t=f2a4b300&a;us=4070880000&a;sign=b59a7b96a095f92f99b475fb3660977b&q;},&q;memberOfCPC&q;:false,&q;tags&q;:null},{&q;id&q;:18668,&q;userId&q;:69522017,&q;name&q;:&q;王杉&q;,&q;brief&q;:&q;粉笔优质讲师&q;,&q;desc&q;:&q;粉笔优质讲师。拥有六年一线授课经验，参与多种课程类型的教学，积累了丰富的授课经验。在常识公共基础知识和言语科目教学中，结合山东、福建、四川、江苏等地的地方考情，深入理解真题命题方向。授课风格幽默活泼，善于将时事热点与理论知识结合，帮助学生更好地理解和记忆。&q;,&q;avatar&q;:&q;193af589c3b05e6.jpg&q;,&q;upperBodyPhoto&q;:null,&q;displayCoursePrefix&q;:&q;sydw&q;,&q;teacherStat&q;:{&q;teacherId&q;:18668,&q;episodeCount&q;:613,&q;scoreCount&q;:1605,&q;avgScore&q;:9.823052959501561,&q;fiveGradeAvgScore&q;:4.91,&q;updateTime&q;:1773481515764},&q;auditionEpisode&q;:null,&q;memberOfCPC&q;:false,&q;tags&q;:null},{&q;id&q;:16913,&q;userId&q;:73523709,&q;name&q;:&q;曾雨萱&q;,&q;brief&q;:&q;粉笔优质讲师&q;,&q;desc&q;:&q;粉笔优质教师\n专业知识扎实牢靠，5年授课经验，逻辑思维严谨，善于与学生互动且关注到学生的问题所在，并激发学生的学习兴趣，授课生动形象，条理清晰，多次参与粉笔教研活动，分享授课心得，全面把握各地考情。&q;,&q;avatar&q;:&q;193af57249decc0.jpg&q;,&q;upperBodyPhoto&q;:null,&q;displayCoursePrefix&q;:&q;sydw&q;,&q;teacherStat&q;:{&q;teacherId&q;:16913,&q;episodeCount&q;:485,&q;scoreCount&q;:2223,&q;avgScore&q;:9.799370220422855,&q;fiveGradeAvgScore&q;:4.9,&q;updateTime&q;:1773551291366},&q;auditionEpisode&q;:{&q;episodeTitle&q;:&q;个人展示课&q;,&q;episodeVideoUrl&q;:&q;https://vod.fbstatic.cn/22e9ceb2vodbj1251001446/626c33885145403709703283976/HyB5QWvOOscA.mp4?t=f2a4b300&a;us=4070880000&a;sign=f54bd80bca68d19c515ce2f10857170c&q;},&q;memberOfCPC&q;:false,&q;tags&q;:null},{&q;id&q;:25387,&q;userId&q;:60845482,&q;name&q;:&q;余嘉怡&q;,&q;brief&q;:&q;粉笔优质讲师&q;,&q;desc&q;:&q;粉笔优质教师\n6年一线教学经验。\n具有丰富的的实践经验和专业系统的理论知识，多次参与粉笔判断授课研讨，教学教研能力扎实。\n授课思路清晰，语言通俗易懂，让学生在轻松的学习氛围中，善于引导学生思考，用更简单的方法，帮助学生找到更快捷的解题之道，深受学员好评。&q;,&q;avatar&q;:&q;1768392a849ac12.jpg&q;,&q;upperBodyPhoto&q;:null,&q;displayCoursePrefix&q;:&q;sydw&q;,&q;teacherStat&q;:{&q;teacherId&q;:25387,&q;episodeCount&q;:583,&q;scoreCount&q;:1076,&q;avgScore&q;:9.851301115241625,&q;fiveGradeAvgScore&q;:4.93,&q;updateTime&q;:1773583624765},&q;auditionEpisode&q;:null,&q;memberOfCPC&q;:false,&q;tags&q;:null},{&q;id&q;:32807,&q;userId&q;:58353585,&q;name&q;:&q;陈婷真&q;,&q;brief&q;:&q;粉笔优质讲师&q;,&q;desc&q;:&q;粉笔优质教师\n五年教学经验，多次参加综应教研会，了解各地区对应考情，专业理论知识扎实。\n累计带班数量超40＋，学员整体评分维持4.9以上。\n善于结合学员实际学习情况针对性讲解作答技巧，注重与学员的互动，课堂引导性强，通俗易懂，授课逻辑清晰，将实践做题与知识理论相结合，让学员了解到自身不足并对应提高作答能力，深受学员好评。&q;,&q;avatar&q;:&q;1785cfe2779256e.jpg&q;,&q;upperBodyPhoto&q;:null,&q;displayCoursePrefix&q;:&q;sydw&q;,&q;teacherStat&q;:{&q;teacherId&q;:32807,&q;episodeCount&q;:450,&q;scoreCount&q;:510,&q;avgScore&q;:9.917647058823535,&q;fiveGradeAvgScore&q;:4.96,&q;updateTime&q;:1773373705667},&q;auditionEpisode&q;:{&q;episodeTitle&q;:&q;个人展示课&q;,&q;episodeVideoUrl&q;:&q;https://vod.fbstatic.cn/22e9ceb2vodbj1251001446/14944d765145403707370134821/S4R1s6rQfvEA.mp4?t=f2a4b300&a;us=4070880000&a;sign=75cde947cd4df73767b77c947740ce48&q;},&q;memberOfCPC&q;:false,&q;tags&q;:null},{&q;id&q;:21461,&q;userId&q;:67401214,&q;name&q;:&q;杨安霞&q;,&q;brief&q;:&q;粉笔优质讲师&q;,&q;desc&q;:&q;粉笔优质教师\n6年一线教学授课经验 \n具有言语科目丰富的实践经验及系统扎实的专业理论知识 \n撰写多篇事业单位笔试教研材料。\n多次参加粉笔授课研讨会议，全面把握事考笔试命题趋势及最新考情，积累丰富笔试知识。\n多次参加粉笔教研活动，分享授课经验心得，助力粉笔理论研发升级\n学生口碑：累计获得4000条好评，具有幽默活泼的授课风格，让学生在轻松的学习氛围中，用更简单的方法，找到更快捷的解题之道，深受广大学员的认可和好评；在学员中具有非常好的口碑，是值得信赖的好导师。&q;,&q;avatar&q;:&q;18339f430322411.jpg&q;,&q;upperBodyPhoto&q;:null,&q;displayCoursePrefix&q;:&q;sydw&q;,&q;teacherStat&q;:{&q;teacherId&q;:21461,&q;episodeCount&q;:487,&q;scoreCount&q;:3407,&q;avgScore&q;:9.766363369533323,&q;fiveGradeAvgScore&q;:4.88,&q;updateTime&q;:1773574288294},&q;auditionEpisode&q;:{&q;episodeTitle&q;:&q;个人展示课&q;,&q;episodeVideoUrl&q;:&q;https://vod.fbstatic.cn/22e9ceb2vodbj1251001446/cdd909c95145403709545699332/sfl8THAad0IA.mp4?t=f2a4b300&a;us=4070880000&a;sign=6b8df9b6c6dce36e682ba4004a5ad5ec&q;},&q;memberOfCPC&q;:false,&q;tags&q;:null},{&q;id&q;:16722,&q;userId&q;:52232168,&q;name&q;:&q;王轶琢&q;,&q;brief&q;:&q;粉笔优质讲师&q;,&q;desc&q;:&q;粉笔优质讲师\n6年一线教学授课经验；具有数资科目丰富的实践经验及系统扎实的专业理论知识；多次参加粉笔教研活动，分享授课经验心得，助力粉笔理论研发升级；\n累计授课超过2000小时，累计评分达4.9分；授课与实战经验丰富，熟悉考场答题思维及应变技巧。\n老师授课风格：风趣幽默，灵活引导学员自主思考，激发学员学习热情和自主意识；授课逻辑性强，注重理论与实践相结合，深受学员的喜爱。&q;,&q;avatar&q;:&q;1983bddcd777cc6.jpg&q;,&q;upperBodyPhoto&q;:null,&q;displayCoursePrefix&q;:&q;sydw&q;,&q;teacherStat&q;:{&q;teacherId&q;:16722,&q;episodeCount&q;:870,&q;scoreCount&q;:2527,&q;avgScore&q;:9.784724970320534,&q;fiveGradeAvgScore&q;:4.89,&q;updateTime&q;:1773198754974},&q;auditionEpisode&q;:{&q;episodeTitle&q;:&q;个人展示课&q;,&q;episodeVideoUrl&q;:&q;https://vod.fbstatic.cn/22e9ceb2vodbj1251001446/9ebc23c15145403707375528343/mutMbTelffgA.mp4?t=f2a4b300&a;us=4070880000&a;sign=fa18dfaff16469d1f41c7e7cebb5b1a6&q;},&q;memberOfCPC&q;:false,&q;tags&q;:null},{&q;id&q;:16782,&q;userId&q;:62414994,&q;name&q;:&q;李宁宁&q;,&q;brief&q;:&q;粉笔优质讲师&q;,&q;desc&q;:&q;粉笔优质讲师\n6年一线教学授课经验，对于判断科目有丰富的实践经验及系统扎实的专业理论知识，多次参加粉笔授课研讨会议，撰写事业单位笔试教研材料，分享授课经验心得，全面掌握事业单位考试题型及最新考情。授课风格形象生动、条理清晰，受到同学们的一致好评。&q;,&q;avatar&q;:&q;198552a8eb7a710.jpg&q;,&q;upperBodyPhoto&q;:null,&q;displayCoursePrefix&q;:&q;sydw&q;,&q;teacherStat&q;:{&q;teacherId&q;:16782,&q;episodeCount&q;:461,&q;scoreCount&q;:1852,&q;avgScore&q;:9.804535637149028,&q;fiveGradeAvgScore&q;:4.9,&q;updateTime&q;:1773582720099},&q;auditionEpisode&q;:{&q;episodeTitle&q;:&q;个人展示课&q;,&q;episodeVideoUrl&q;:&q;https://vod.fbstatic.cn/22e9ceb2vodbj1251001446/0c9d81075145403709546068429/szLjSYA13EAA.mp4?t=f2a4b300&a;us=4070880000&a;sign=1a1288969d3bff4d5f5deefe5adbc17b&q;},&q;memberOfCPC&q;:false,&q;tags&q;:null},{&q;id&q;:18211,&q;userId&q;:62141778,&q;name&q;:&q;宋悦&q;,&q;brief&q;:&q;粉笔优质讲师&q;,&q;desc&q;:&q;粉笔优质讲师\n6年以上授课经验，累计授课时长超900小时，带班学员超10000人。在教学过程中熟悉事业单位联考、江苏事业单位考试、广东事业单位考试、福建事业单位考试考情，可针对不同地区考情提供更专业的教学内容，教学内容处理细腻，条理清晰，教学方式通俗易通，教学态度认真负责。多次参与真题解析与模拟题的教研，目前已负责解析粉笔题库1000+真题，对题型的特征非常熟悉，善于结合不同地区题型，拓展学员思路，梳理清楚做题技巧，对学员细心耐心，授课内容循序渐进，逻辑性强，具有幽默诙谐、形象生动、条理清晰的授课风格，带学员突破重难点，让大家有所收获有所提高。深受广大学员的认可和好评。&q;,&q;avatar&q;:&q;198412398a677cc.jpg&q;,&q;upperBodyPhoto&q;:null,&q;displayCoursePrefix&q;:&q;sydw&q;,&q;teacherStat&q;:{&q;teacherId&q;:18211,&q;episodeCount&q;:346,&q;scoreCount&q;:2008,&q;avgScore&q;:9.796812749003967,&q;fiveGradeAvgScore&q;:4.9,&q;updateTime&q;:1773560947716},&q;auditionEpisode&q;:null,&q;memberOfCPC&q;:false,&q;tags&q;:null},{&q;id&q;:16585,&q;userId&q;:72433744,&q;name&q;:&q;李志超&q;,&q;brief&q;:&q;粉笔优质讲师&q;,&q;desc&q;:&q;粉笔优质讲师\n6年一线教育教学经验，累计授课时长超过1500小时，具有丰富的实践经验和系统扎实的理论知识，承担各种线上线下授课任务，累计评分达4.9分\n多次参加模拟题撰写、真题解析等日常教研工作\n授课内容风趣幽默，授课思维活跃，逻辑性强，注重理论与实践相结合，讲解细致，富有亲和力，深受学员喜爱&q;,&q;avatar&q;:&q;193b375ef299d45.jpg&q;,&q;upperBodyPhoto&q;:null,&q;displayCoursePrefix&q;:&q;sydw&q;,&q;teacherStat&q;:{&q;teacherId&q;:16585,&q;episodeCount&q;:552,&q;scoreCount&q;:1401,&q;avgScore&q;:9.822983583154892,&q;fiveGradeAvgScore&q;:4.91,&q;updateTime&q;:1773561621338},&q;auditionEpisode&q;:{&q;episodeTitle&q;:&q;个人展示课&q;,&q;episodeVideoUrl&q;:&q;https://vod.fbstatic.cn/22e9ceb2vodbj1251001446/8083c2095145403709544648249/NKx7gKaPMmIA.mp4?t=f2a4b300&a;us=4070880000&a;sign=b125bc598cde7445acb1a34c322b7d05&q;},&q;memberOfCPC&q;:false,&q;tags&q;:null},{&q;id&q;:16735,&q;userId&q;:46275516,&q;name&q;:&q;郭孟楠&q;,&q;brief&q;:&q;粉笔优质讲师&q;,&q;desc&q;:&q;粉笔优质讲师\n5年一线教学经验，对言语理解与表达的命题趋势和解题技巧有着精准的把握。在教学过程中，注重培养学生的语言敏感度和逻辑思维能力，通过系统的知识讲解和大量的真题演练，帮助学生快速掌握解题技巧，提高答题速度和准确率。注重启发式教学，能够及时发现并解决学生在学习过程中遇到的问题，适合各个阶段的学习并深受学员喜爱。&q;,&q;avatar&q;:&q;1746be4c31acce6.jpg&q;,&q;upperBodyPhoto&q;:null,&q;displayCoursePrefix&q;:&q;sydw&q;,&q;teacherStat&q;:{&q;teacherId&q;:16735,&q;episodeCount&q;:386,&q;scoreCount&q;:5679,&q;avgScore&q;:9.730938545518592,&q;fiveGradeAvgScore&q;:4.87,&q;updateTime&q;:1773371290044},&q;auditionEpisode&q;:{&q;episodeTitle&q;:&q;个人展示课&q;,&q;episodeVideoUrl&q;:&q;https://vod.fbstatic.cn/22e9ceb2vodbj1251001446/cf4aa7181397757903434929665/eDPwMVOaVQcA.mp4?t=f2a4b300&a;us=4070880000&a;sign=32ab41a3d56b67eb4d07d67b2bdb9cc6&q;},&q;memberOfCPC&q;:false,&q;tags&q;:null},{&q;id&q;:34196,&q;userId&q;:83885051,&q;name&q;:&q;马莹萍&q;,&q;brief&q;:&q;粉笔优质讲师&q;,&q;desc&q;:&q;粉笔常识公基优质教师\n6年授课经验，授课实战经验丰富。累计授课时长900+，授课人次2500+，授课评分4.9分，深受学员喜爱。长期扎根于常识公基非法及判断教学教研工作，曾撰写教研文章十余篇，撰写多地政府工作报告解读文件，参与全国常识公基非法密卷课件及讲义制作。授课班级中，公基成绩均有明显提升，历年考试中，均有多名学员取得80+的好成绩。授课风格幽默风趣，贴近实际，能够通过学员特点进行个性化指导，帮助学员突破瓶颈，一举成“公”。&q;,&q;avatar&q;:&q;198412a1819fc20.jpg&q;,&q;upperBodyPhoto&q;:null,&q;displayCoursePrefix&q;:&q;sydw&q;,&q;teacherStat&q;:{&q;teacherId&q;:34196,&q;episodeCount&q;:833,&q;scoreCount&q;:1519,&q;avgScore&q;:9.81566820276498,&q;fiveGradeAvgScore&q;:4.91,&q;updateTime&q;:1773561169054},&q;auditionEpisode&q;:{&q;episodeTitle&q;:&q;个人展示课&q;,&q;episodeVideoUrl&q;:&q;https://vod.fbstatic.cn/22e9ceb2vodbj1251001446/72db76805145403709544091356/dk0lqGQPopcA.mp4?t=f2a4b300&a;us=4070880000&a;sign=c98ccaef848337ae40404519654c80f6&q;},&q;memberOfCPC&q;:false,&q;tags&q;:null},{&q;id&q;:64311,&q;userId&q;:87660655,&q;name&q;:&q;毛雨&q;,&q;brief&q;:&q;粉笔优质讲师&q;,&q;desc&q;:&q;粉笔优质教师\n多年一线教学授课经验，深耕事业单位考试，承担过线下笔试精品班、刷题班、冲刺班等多种班型，授课经验丰富。\n具有判断科目丰富的实践经验及系统扎实的专业理论知识和对事业单位判断推理考情的深入研究：\n曾参与命制笔试真题教研和解析撰写工作，对判断推理最新命题趋势方向有深入研究；\n多次参加粉笔授课研讨会议，注重考场思维，针对学生困惑研究教学策略，深入研讨事考判断命题趋势及最新考情，注重自我提升，积累丰富笔试理论知识；\n累计授课超1500小时，累计评分达4.9分，注重启发式引导，让学生在轻松的学习氛围中，用更简单的方法，找到更快捷的解题之道，深受广大学员的认可和好评；在学员中具有非常好的口碑，是值得信赖的好导师。&q;,&q;avatar&q;:&q;1945f3395b1b42e.jpg&q;,&q;upperBodyPhoto&q;:null,&q;displayCoursePrefix&q;:&q;sydw&q;,&q;teacherStat&q;:{&q;teacherId&q;:64311,&q;episodeCount&q;:607,&q;scoreCount&q;:1177,&q;avgScore&q;:9.83347493627868,&q;fiveGradeAvgScore&q;:4.92,&q;updateTime&q;:1773584237682},&q;auditionEpisode&q;:{&q;episodeTitle&q;:&q;个人展示课&q;,&q;episodeVideoUrl&q;:&q;https://vod.fbstatic.cn/22e9ceb2vodbj1251001446/075934a35145403709539072509/hFfKlbfvNUUA.mp4?t=f2a4b300&a;us=4070880000&a;sign=200c5599e3a9767162793d5e286a2d57&q;},&q;memberOfCPC&q;:false,&q;tags&q;:null},{&q;id&q;:52947,&q;userId&q;:64240438,&q;name&q;:&q;鲁媛&q;,&q;brief&q;:&q;粉笔优质讲师&q;,&q;desc&q;:&q;粉笔优质教师\n五年一线教学授课经验，深耕一线考试考情，累计授课时长1000+，经验丰富。\n具有常识公共基础知识和言语科目丰富的实践经验及系统扎实的专业理论知识和对考情有深入研究，对最新命题趋势方向有深入研究。\n注重因材施教，在学员中具有非常好的口碑，理论扎实，讲解细致，上课风格条理清晰，且能够帮助学员全面掌握做题技巧，深受学员喜爱与好评。&q;,&q;avatar&q;:&q;1942b25f4360c2f.jpg&q;,&q;upperBodyPhoto&q;:null,&q;displayCoursePrefix&q;:&q;sydw&q;,&q;teacherStat&q;:{&q;teacherId&q;:52947,&q;episodeCount&q;:528,&q;scoreCount&q;:1131,&q;avgScore&q;:9.835543766578246,&q;fiveGradeAvgScore&q;:4.92,&q;updateTime&q;:1773544951083},&q;auditionEpisode&q;:{&q;episodeTitle&q;:&q;个人展示课&q;,&q;episodeVideoUrl&q;:&q;https://vod.fbstatic.cn/22e9ceb2vodbj1251001446/8010b9c95145403709537877405/oSJCJMLapA8A.mp4?t=f2a4b300&a;us=4070880000&a;sign=a23b3e7bcb54790ed90b33098592e763&q;},&q;memberOfCPC&q;:false,&q;tags&q;:null},{&q;id&q;:34183,&q;userId&q;:83886596,&q;name&q;:&q;赵佳佳&q;,&q;brief&q;:&q;粉笔优质讲师&q;,&q;desc&q;:&q;粉笔常识公基优质讲师\n6年一线教学经验，深耕事业单位考试，承担过笔试精品班、刷题班等多种班型，授课和实战经验丰富。\n\n曾参与真题教研解析工作，教研文章撰写工作，模拟题的教研工作，对最新命题趋势方向有深入研究;\n多次参加粉笔授课研讨会议，注重考场思维，针对学生困惑研究教学策略，深入研讨事考命题趋势及最新考情，注重自我提升，积累丰富笔试理论知识;\n累计授课超1400小时，累计评分达4.9分，善于把握学员个性化特点，因材施教，认真负责，真诚对待每一位学员。讲课生动形象，有代入感，学员可以在轻松愉快的氛围中学习，跟着老师节奏主动思考，学习知识，掌握知识。&q;,&q;avatar&q;:&q;1983ba750d61d0b.jpg&q;,&q;upperBodyPhoto&q;:null,&q;displayCoursePrefix&q;:&q;sydw&q;,&q;teacherStat&q;:{&q;teacherId&q;:34183,&q;episodeCount&q;:689,&q;scoreCount&q;:1641,&q;avgScore&q;:9.802559414990869,&q;fiveGradeAvgScore&q;:4.9,&q;updateTime&q;:1771456495223},&q;auditionEpisode&q;:null,&q;memberOfCPC&q;:false,&q;tags&q;:null},{&q;id&q;:16837,&q;userId&q;:74162051,&q;name&q;:&q;杨晓晓&q;,&q;brief&q;:&q;粉笔优质讲师&q;,&q;desc&q;:&q;粉笔优质教师\n六年一线教学授课经验，具有判断科目丰富的实践经验及系统扎实的专业理论知识，参与判断科目讲义、模拟卷研发。始终以生动有趣、激发学生思维为教学宗旨，课堂氛围轻松融洽，广受学员好评。授课重点突出，能够及时总结拓展，讲解语言通俗易懂。擅长引导学生自主思考，善于根据学生的不同情况和需求,制定合适的教学计划，进行个性化指导，助力学员上岸。&q;,&q;avatar&q;:&q;19661648a9e627d.jpg&q;,&q;upperBodyPhoto&q;:null,&q;displayCoursePrefix&q;:&q;sydw&q;,&q;teacherStat&q;:{&q;teacherId&q;:16837,&q;episodeCount&q;:442,&q;scoreCount&q;:1576,&q;avgScore&q;:9.804568527918779,&q;fiveGradeAvgScore&q;:4.9,&q;updateTime&q;:1773585462870},&q;auditionEpisode&q;:{&q;episodeTitle&q;:&q;个人展示课&q;,&q;episodeVideoUrl&q;:&q;https://vod.fbstatic.cn/22e9ceb2vodbj1251001446/1a7c47ce1253642695750676159/Sc7AGWXJ4K0A.mp4?t=f2a4b300&a;us=4070880000&a;sign=33dc347897be647da623a7048bd9c97b&q;},&q;memberOfCPC&q;:false,&q;tags&q;:null},{&q;id&q;:52905,&q;userId&q;:64869017,&q;name&q;:&q;迟琳&q;,&q;brief&q;:&q;粉笔优质讲师&q;,&q;desc&q;:&q;粉笔优质讲师\n5年一线教学深耕，主讲线上精品班、刷题班等多元班型，累计授课时长超3000小时，教学经验扎实丰富。\n深耕言语理解模块，凭借对考情的敏锐洞察，能精准捕捉考试趋势与命题方向。擅长将复杂知识点拆解为“可吸收”的清晰模块，结合生动案例与通俗表达，让抽象解题技巧变得直观易懂，帮助学生快速突破学习难点。\n教学中始终以学员为核心，不仅注重解题方法的传授，更着力培养学生的逻辑思维与自主学习能力。通过“举一反三”的引导式教学，助力学员实现知识的灵活迁移与运用，学员好评率稳居前列，深受信赖与喜爱。&q;,&q;avatar&q;:&q;17f3f0375916d72.jpg&q;,&q;upperBodyPhoto&q;:null,&q;displayCoursePrefix&q;:&q;sydw&q;,&q;teacherStat&q;:{&q;teacherId&q;:52905,&q;episodeCount&q;:351,&q;scoreCount&q;:1137,&q;avgScore&q;:9.829375549692163,&q;fiveGradeAvgScore&q;:4.91,&q;updateTime&q;:1773566236546},&q;auditionEpisode&q;:{&q;episodeTitle&q;:&q;个人展示课&q;,&q;episodeVideoUrl&q;:&q;https://vod.fbstatic.cn/22e9ceb2vodbj1251001446/ba3aba5f5145403709538052229/NBGfnV7d2IEA.mp4?t=f2a4b300&a;us=4070880000&a;sign=783070f866ba71370a8c3a086a82aa91&q;},&q;memberOfCPC&q;:false,&q;tags&q;:null},{&q;id&q;:26292,&q;userId&q;:79327575,&q;name&q;:&q;郑美娟&q;,&q;brief&q;:&q;粉笔优质讲师&q;,&q;desc&q;:&q;粉笔数量关系与资料分析科目优质教师\n5年一线教学授课经验。\n具有数资科目丰富的实践经验及系统扎实的专业理论知识。多次参与粉笔数资授课研讨，教学教研能力扎实。承担过线下笔试精品班、刷题班、冲刺班等多种班型，授课经验丰富，思路清晰，讲解全面细致。\n授课形式生动形象，能够有针对性的引导学生进行主动思考，课堂氛围轻松无压力。擅长化繁为简，适合各个阶段的学生，深受广大学员好评。&q;,&q;avatar&q;:&q;1777f9e082273e5.jpg&q;,&q;upperBodyPhoto&q;:null,&q;displayCoursePrefix&q;:&q;sydw&q;,&q;teacherStat&q;:{&q;teacherId&q;:26292,&q;episodeCount&q;:567,&q;scoreCount&q;:1594,&q;avgScore&q;:9.803011292346305,&q;fiveGradeAvgScore&q;:4.9,&q;updateTime&q;:1773586366104},&q;auditionEpisode&q;:{&q;episodeTitle&q;:&q;个人展示课&q;,&q;episodeVideoUrl&q;:&q;https://vod.fbstatic.cn/22e9ceb2vodbj1251001446/9f3a48475145403713947309566/MDmpFEIP6G8A.mp4?t=f2a4b300&a;us=4070880000&a;sign=39fd01bda5913d3e938e577986d9db4b&q;},&q;memberOfCPC&q;:false,&q;tags&q;:null},{&q;id&q;:16531,&q;userId&q;:49003194,&q;name&q;:&q;杜蕾&q;,&q;brief&q;:&q;粉笔优质讲师&q;,&q;desc&q;:&q;粉笔优质讲师\n言语理论功底扎实，有六年一线教学授课经验，深耕事业单位考试，授课思路逻辑清晰，幽默有趣，善于将知识点拆分糅合在题目中给学生启发，并能够帮助学生举一反三有效掌握应试技巧,教学效果显著，深受学员喜爱。&q;,&q;avatar&q;:&q;17467a1d8cafdaf.jpg&q;,&q;upperBodyPhoto&q;:null,&q;displayCoursePrefix&q;:&q;sydw&q;,&q;teacherStat&q;:{&q;teacherId&q;:16531,&q;episodeCount&q;:292,&q;scoreCount&q;:1032,&q;avgScore&q;:9.837209302325578,&q;fiveGradeAvgScore&q;:4.92,&q;updateTime&q;:1773574238139},&q;auditionEpisode&q;:{&q;episodeTitle&q;:&q;个人展示课&q;,&q;episodeVideoUrl&q;:&q;https://vod.fbstatic.cn/22e9ceb2vodbj1251001446/7b5aded05145403710132049127/ksqL7J7FwGMA.mp4?t=f2a4b300&a;us=4070880000&a;sign=6133d4e4b5970238c7575d9f4ff28053&q;},&q;memberOfCPC&q;:false,&q;tags&q;:null},{&q;id&q;:17198,&q;userId&q;:73655782,&q;name&q;:&q;陈灵均&q;,&q;brief&q;:&q;粉笔优质讲师&q;,&q;desc&q;:&q;粉笔优质讲师\n六年教学经验，承担各种班型授课，理论知识扎实，能帮助考生系统备考，提高应试能力。\n深入研究各地真题，多次参与真题解析、模拟题命制等教研活动，准确把握考试动态及命题趋势，为考生提供备考方向和策略。\n授课深入浅出，化繁为简，擅长提炼逻辑和规律，帮助考生掌握核心要点，举一反三&q;,&q;avatar&q;:&q;1823937972498f7.jpg&q;,&q;upperBodyPhoto&q;:null,&q;displayCoursePrefix&q;:&q;sydw&q;,&q;teacherStat&q;:{&q;teacherId&q;:17198,&q;episodeCount&q;:462,&q;scoreCount&q;:1403,&q;avgScore&q;:9.81183178902352,&q;fiveGradeAvgScore&q;:4.91,&q;updateTime&q;:1773580094665},&q;auditionEpisode&q;:{&q;episodeTitle&q;:&q;个人展示课&q;,&q;episodeVideoUrl&q;:&q;https://vod.fbstatic.cn/22e9ceb2vodbj1251001446/48fa213a5145403708523044176/CrD3nYrPU6oA.mp4?t=f2a4b300&a;us=4070880000&a;sign=bdd8d0a92bdac0ab6d9102af2433a663&q;},&q;memberOfCPC&q;:false,&q;tags&q;:null},{&q;id&q;:16791,&q;userId&q;:64686941,&q;name&q;:&q;鞠坤&q;,&q;brief&q;:&q;粉笔优质讲师&q;,&q;desc&q;:&q;粉笔优质讲师\n6年一线教学深耕，累计完成1000+小时精品授课。\n具有常识公基及言语科目丰富的实践经验及系统扎实的专业理论知识：\n多次参与粉笔授课研讨会议，精准捕捉考试命题的最新趋势；\n多次参加粉笔教学教研活动，分享授课心得，推动教学质量不断攀升。\n累计超过600条学员好评。拥有“条理清晰、风趣幽默”的授课风格，擅长将复杂的知识点简单化，让学生在轻松愉悦的学习氛围中，快速掌握解题秘诀，深受广大学员的喜爱与信赖。&q;,&q;avatar&q;:&q;174af62f024eaf0.jpg&q;,&q;upperBodyPhoto&q;:null,&q;displayCoursePrefix&q;:&q;sydw&q;,&q;teacherStat&q;:{&q;teacherId&q;:16791,&q;episodeCount&q;:582,&q;scoreCount&q;:1785,&q;avgScore&q;:9.79383753501401,&q;fiveGradeAvgScore&q;:4.9,&q;updateTime&q;:1773426133083},&q;auditionEpisode&q;:{&q;episodeTitle&q;:&q;个人展示课&q;,&q;episodeVideoUrl&q;:&q;https://vod.fbstatic.cn/22e9ceb2vodbj1251001446/27dd957d5145403709543144553/QX5zeW9bv6cA.mp4?t=f2a4b300&a;us=4070880000&a;sign=f428b327bdc9b0aa0d096f2b9749bf2d&q;},&q;memberOfCPC&q;:false,&q;tags&q;:null},{&q;id&q;:16588,&q;userId&q;:73651929,&q;name&q;:&q;王雅平&q;,&q;brief&q;:&q;粉笔优质讲师&q;,&q;desc&q;:&q;粉笔优质讲师\n6年一线教学经验，授课时长3000+小时，所带学员综合通过率达68%，具有数资科目丰富的实践经验及系统扎实的专业理论知识，对考情深入研究，授课经验丰富：①撰写多篇教研材料，在粉笔教师内部进行共享；②多次参加粉笔授课研讨会议，全面把握数资命题趋势及最新考情，积累丰富知识；③多次参加粉笔教研活动，分享授课经验心得。&q;,&q;avatar&q;:&q;17467ff056cb0e3.jpg&q;,&q;upperBodyPhoto&q;:null,&q;displayCoursePrefix&q;:&q;sydw&q;,&q;teacherStat&q;:{&q;teacherId&q;:16588,&q;episodeCount&q;:645,&q;scoreCount&q;:1598,&q;avgScore&q;:9.801001251564475,&q;fiveGradeAvgScore&q;:4.9,&q;updateTime&q;:1773543164175},&q;auditionEpisode&q;:{&q;episodeTitle&q;:&q;个人展示课&q;,&q;episodeVideoUrl&q;:&q;https://vod.fbstatic.cn/22e9ceb2vodbj1251001446/3d7922af5145403708051711222/4CdLbW9JRzEA.mp4?t=f2a4b300&a;us=4070880000&a;sign=db9e82e392a8449558ccd8e4eedf3845&q;},&q;memberOfCPC&q;:false,&q;tags&q;:null},{&q;id&q;:22619,&q;userId&q;:51749464,&q;name&q;:&q;周雨婷&q;,&q;brief&q;:&q;粉笔优质讲师&q;,&q;desc&q;:&q;粉笔常识公基优质教师\n6年一线教学授课经验，具有法律科目丰富的实践经验及系统扎实的专业理论知识，多次参加粉笔授课研讨会议，教学风格幽默、轻松，授课条理清晰，善用简单贴近生活的例子引导学员思考，促进学员对知识的学习和理解，获得学员好评，有效提高上岸率。&q;,&q;avatar&q;:&q;19859270ec0c827.jpg&q;,&q;upperBodyPhoto&q;:null,&q;displayCoursePrefix&q;:&q;sydw&q;,&q;teacherStat&q;:{&q;teacherId&q;:22619,&q;episodeCount&q;:799,&q;scoreCount&q;:2288,&q;avgScore&q;:9.775349650349652,&q;fiveGradeAvgScore&q;:4.89,&q;updateTime&q;:1773500158427},&q;auditionEpisode&q;:{&q;episodeTitle&q;:&q;个人展示课&q;,&q;episodeVideoUrl&q;:&q;https://vod.fbstatic.cn/22e9ceb2vodbj1251001446/fcf535445145403715605268863/2pBmAs0WFUgA.mp4?t=f2a4b300&a;us=4070880000&a;sign=5171b3e4abe67c5fc47f5957b27bd34f&q;},&q;memberOfCPC&q;:false,&q;tags&q;:null},{&q;id&q;:35003,&q;userId&q;:83142599,&q;name&q;:&q;史芯蕊&q;,&q;brief&q;:&q;粉笔优质讲师&q;,&q;desc&q;:&q;粉笔优质讲师\n6年一线教学经验，承担过线上线下多种课程，包含安徽、武汉地区联考A，联考C，以及江苏等线下课程。线上部分以精品系统班，刷题班，线下考前冲刺班为主，授课经验丰富，深受学员喜爱，服务学员上千人，累计授课时长超千小时，授课评分4.9分。\n授课思路清晰，逻辑较强，善于从学员的角度切入，用更轻松的方式灵活运用答题技巧，同时给出学员针对性又个性化的指导方案。\n定期参加粉笔教研，多次参与真题解析以及真题解析视频录制，对理论体系有深入的研究，了解最新命题趋势方向。&q;,&q;avatar&q;:&q;18f656de50744c0.jpg&q;,&q;upperBodyPhoto&q;:null,&q;displayCoursePrefix&q;:&q;sydw&q;,&q;teacherStat&q;:{&q;teacherId&q;:35003,&q;episodeCount&q;:281,&q;scoreCount&q;:638,&q;avgScore&q;:9.877742946708466,&q;fiveGradeAvgScore&q;:4.94,&q;updateTime&q;:1773590037796},&q;auditionEpisode&q;:{&q;episodeTitle&q;:&q;个人展示课&q;,&q;episodeVideoUrl&q;:&q;https://vod.fbstatic.cn/22e9ceb2vodbj1251001446/fb1642195145403708057024670/r8VrOUODYOYA.mp4?t=f2a4b300&a;us=4070880000&a;sign=66f06661bf427c9cc98ffaf63d1aef4e&q;},&q;memberOfCPC&q;:false,&q;tags&q;:null},{&q;id&q;:52906,&q;userId&q;:88669957,&q;name&q;:&q;陶静&q;,&q;brief&q;:&q;粉笔优质讲师&q;,&q;desc&q;:&q;粉笔优质讲师\n6年一线教学，深耕线上线下授课，累计覆盖全国超万名学员，授课时长已突破2500小时，教学经验扎实且全面。\n深耕常识与公共基础知识、判断科目领域，兼具扎实的专业理论功底与丰富实践经验。对全国多地考试考情、真题规律及命题趋势有着深刻洞察，授课理念独到新颖，始终秉持理论与实践相结合的教学原则，致力于帮助学员系统掌握解题技巧，让大家在轻松高效的学习氛围中稳步提升。\n授课风格独树一帜，条理清晰，又风趣幽默，把复杂课程内容拆解得层次分明、脉络清晰，让学员轻松跟上学习节奏，再搭配专业完善的教学体系，学习效率直接拉满。&q;,&q;avatar&q;:&q;1984fe9e02e27a3.jpg&q;,&q;upperBodyPhoto&q;:null,&q;displayCoursePrefix&q;:&q;sydw&q;,&q;teacherStat&q;:{&q;teacherId&q;:52906,&q;episodeCount&q;:640,&q;scoreCount&q;:952,&q;avgScore&q;:9.83823529411764,&q;fiveGradeAvgScore&q;:4.92,&q;updateTime&q;:1773495035648},&q;auditionEpisode&q;:{&q;episodeTitle&q;:&q;个人展示课&q;,&q;episodeVideoUrl&q;:&q;https://vod.fbstatic.cn/22e9ceb2vodbj1251001446/d568fd2c1397757888047530032/UZNkfXcuVicA.mp4?t=f2a4b300&a;us=4070880000&a;sign=a17687f4fba4def68220de9a1cbf4eef&q;},&q;memberOfCPC&q;:false,&q;tags&q;:null},{&q;id&q;:18293,&q;userId&q;:67808406,&q;name&q;:&q;任忠生&q;,&q;brief&q;:&q;粉笔优质讲师&q;,&q;desc&q;:&q;粉笔优质讲师\n6年一线教学经验，承担过线上线下多种课程，授课经验丰富，深受学员喜爱，累计授课评分4.9分。\n授课思路清晰，风趣幽默，妙语连珠，课堂中知识与段子齐飞，答题声与欢笑声连成一片，课堂氛围极佳。\n定期参加粉笔笔试教研，多次参与真题解析以及真题解析视频录制，对笔试理论体系有深入的研究，了解最新命题趋势方向。&q;,&q;avatar&q;:&q;193b4b22415b966.jpg&q;,&q;upperBodyPhoto&q;:null,&q;displayCoursePrefix&q;:&q;sydw&q;,&q;teacherStat&q;:{&q;teacherId&q;:18293,&q;episodeCount&q;:418,&q;scoreCount&q;:1609,&q;avgScore&q;:9.794903666873825,&q;fiveGradeAvgScore&q;:4.9,&q;updateTime&q;:1773490915782},&q;auditionEpisode&q;:{&q;episodeTitle&q;:&q;个人展示课&q;,&q;episodeVideoUrl&q;:&q;https://vod.fbstatic.cn/22e9ceb2vodbj1251001446/bfb29f3c5145403709545073450/6OUlHaE0u2UA.mp4?t=f2a4b300&a;us=4070880000&a;sign=4672d88aaa0f986bf84441ae77d619a3&q;},&q;memberOfCPC&q;:false,&q;tags&q;:null},{&q;id&q;:35908,&q;userId&q;:81360450,&q;name&q;:&q;林雨晴&q;,&q;brief&q;:&q;粉笔优质讲师&q;,&q;desc&q;:&q;粉笔优质讲师\n6年一线教学经验，辅导学员数千人，承接各类线上线下精品班，善于从考官思维审视题目，助力多位学员高分上岸；累计授课时长超千个小时，累计授课评分4.9分，深受学员认可；\n长期参与笔试教研工作，定期参与模拟题撰写、真题解析录制等，对最新命题方向、考试重点有深入研究；\n授课风格严谨而不乏幽默，擅长为学员量身定制有效提升解题能力的授课方案，让学员轻松掌握科目本质，目标明确针对提分。&q;,&q;avatar&q;:&q;193b4909bf0801c.jpg&q;,&q;upperBodyPhoto&q;:null,&q;displayCoursePrefix&q;:&q;sydw&q;,&q;teacherStat&q;:{&q;teacherId&q;:35908,&q;episodeCount&q;:324,&q;scoreCount&q;:674,&q;avgScore&q;:9.866468842729965,&q;fiveGradeAvgScore&q;:4.93,&q;updateTime&q;:1773546577229},&q;auditionEpisode&q;:{&q;episodeTitle&q;:&q;个人展示课&q;,&q;episodeVideoUrl&q;:&q;https://vod.fbstatic.cn/22e9ceb2vodbj1251001446/33875c205145403709543644434/6gvJN35dXAIA.mp4?t=f2a4b300&a;us=4070880000&a;sign=c135dd3259c53c86cfd11d55836ec0b2&q;},&q;memberOfCPC&q;:false,&q;tags&q;:null},{&q;id&q;:16592,&q;userId&q;:62613300,&q;name&q;:&q;顾红阳&q;,&q;brief&q;:&q;粉笔优质讲师&q;,&q;desc&q;:&q;粉笔优质讲师\n七年一线教学授课经验,深耕公务员考试、事业单位考试，承担过线下笔试精品班、刷题班等多种班型，授课经验丰富。\n累计授课超1500小时，累计评分达4.9分。\n多次参与模拟题、题目解析等教研工作。对于出题形式有丰富了解。\n授课严谨认真，心思细腻，善于倾听学员的学习诉求，并及时回应。讲课细致耐心，课堂氛围轻松活跃，学员可以获得良好的学习体验，老师理论基础扎实，能够帮助学员将所学理论更好应用在实际做题中。&q;,&q;avatar&q;:&q;1983b9d837c33ee.jpg&q;,&q;upperBodyPhoto&q;:null,&q;displayCoursePrefix&q;:&q;sydw&q;,&q;teacherStat&q;:{&q;teacherId&q;:16592,&q;episodeCount&q;:602,&q;scoreCount&q;:1714,&q;avgScore&q;:9.788798133022171,&q;fiveGradeAvgScore&q;:4.89,&q;updateTime&q;:1773544238246},&q;auditionEpisode&q;:{&q;episodeTitle&q;:&q;个人展示课&q;,&q;episodeVideoUrl&q;:&q;https://vod.fbstatic.cn/22e9ceb2vodbj1251001446/ccff26455145403708060094996/KIUZRQPlgB4A.mp4?t=f2a4b300&a;us=4070880000&a;sign=aa686489eb6f83d67c8cf9b3593d27dd&q;},&q;memberOfCPC&q;:false,&q;tags&q;:null},{&q;id&q;:6520,&q;userId&q;:62532323,&q;name&q;:&q;刘紫阳&q;,&q;brief&q;:&q;粉笔优质讲师&q;,&q;desc&q;:&q;粉笔优质讲师\n9年一线教学授课经验，总授课时长 15000+，，累计评分4.9。\n具有申论、综应科目丰富的实践经验及系统扎实的专业理论知识，对国考、各地方省考和事业单位考试考情、真题和命题方向理解深刻；曾担任安徽申论教研负责人，参与不同阶段授课讲义制作，参与25年国考复读班、综应C讲义制作；19年在安徽粉笔被评为“年度优秀师资”。\n授课讲解细致，逻辑清晰，重点突出，逻辑与要点结合，课堂轻松活泼，让学生用更简单的方法，找到更快捷的解题之道，快速帮助学生提高，深受学员喜爱。&q;,&q;avatar&q;:&q;1942616de4f802f.jpg&q;,&q;upperBodyPhoto&q;:null,&q;displayCoursePrefix&q;:&q;sydw&q;,&q;teacherStat&q;:{&q;teacherId&q;:6520,&q;episodeCount&q;:1160,&q;scoreCount&q;:2251,&q;avgScore&q;:9.768991559306974,&q;fiveGradeAvgScore&q;:4.88,&q;updateTime&q;:1773583986493},&q;auditionEpisode&q;:{&q;episodeTitle&q;:&q;个人展示课&q;,&q;episodeVideoUrl&q;:&q;https://vod.fbstatic.cn/22e9ceb2vodbj1251001446/1987b2725145403709539809876/indGlBLeP1MA.mp4?t=f2a4b300&a;us=4070880000&a;sign=bf2d115e59de47301f001abb86eb6566&q;},&q;memberOfCPC&q;:false,&q;tags&q;:null},{&q;id&q;:21868,&q;userId&q;:67827421,&q;name&q;:&q;向亚灵&q;,&q;brief&q;:&q;粉笔优质讲师&q;,&q;desc&q;:&q;粉笔综应优质教师\n6年一线教学授课经验，参与各地区线上线下面试授课，累计授课时长1000+。具有综应科目丰富的实践经验及系统扎实的专业理论知识，熟练掌握各种笔试作答技巧，并且善于结合学员实际情况，对综应知识进行针对性讲解，有效的帮助学员快速提高。授课风格形象生动，能够针对考生心理灵活调整授课的方式、方法，帮助学员找到适合自己的学习风格。&q;,&q;avatar&q;:&q;19854f04cf39e38.jpg&q;,&q;upperBodyPhoto&q;:null,&q;displayCoursePrefix&q;:&q;sydw&q;,&q;teacherStat&q;:{&q;teacherId&q;:21868,&q;episodeCount&q;:568,&q;scoreCount&q;:933,&q;avgScore&q;:9.834941050375134,&q;fiveGradeAvgScore&q;:4.92,&q;updateTime&q;:1773572602303},&q;auditionEpisode&q;:{&q;episodeTitle&q;:&q;个人展示课&q;,&q;episodeVideoUrl&q;:&q;https://vod.fbstatic.cn/22e9ceb2vodbj1251001446/7d3c515f5145403709537706251/k4wf1XAUkbEA.mp4?t=f2a4b300&a;us=4070880000&a;sign=274982009db9fe68de2a8918ec41a92e&q;},&q;memberOfCPC&q;:false,&q;tags&q;:null},{&q;id&q;:35912,&q;userId&q;:84301173,&q;name&q;:&q;黄迟驰&q;,&q;brief&q;:&q;粉笔优质讲师&q;,&q;desc&q;:&q;粉笔优质讲师\n投身教育事业5年，拥有扎实一线教学经验。承接过各省份笔试系统班，刷题冲刺营，冲刺营，刷题营等班型，服务过近千名学员。参与题库解析课录制，综应一对一课程，综应刷题课。深耕事业单位考试，全面了解事业单位综合应用能力科目考试的命题规律及答题技巧。针对学生困惑研究教学策略，深入研讨最新考情。注重自我提升，每年度多次参加培训学习和综应科目教研，并取得优异成绩。积极分享经验心得，助力粉笔理论研发持续升级，积累丰富笔试理论知识。注重理论与实践相结合，让学生在轻松的学习氛围中，用更简单的方法，找到更快捷的解题之道，深受学员的认可和好评。&q;,&q;avatar&q;:&q;193af66b81fc0b1.jpg&q;,&q;upperBodyPhoto&q;:null,&q;displayCoursePrefix&q;:&q;sydw&q;,&q;teacherStat&q;:{&q;teacherId&q;:35912,&q;episodeCount&q;:195,&q;scoreCount&q;:305,&q;avgScore&q;:9.947540983606558,&q;fiveGradeAvgScore&q;:4.97,&q;updateTime&q;:1773557231120},&q;auditionEpisode&q;:{&q;episodeTitle&q;:&q;个人展示课&q;,&q;episodeVideoUrl&q;:&q;https://vod.fbstatic.cn/22e9ceb2vodbj1251001446/ba2b7e275145403709538047971/m0NVEgAoIxsA.mp4?t=f2a4b300&a;us=4070880000&a;sign=90823bb2aa3547011e7a0d5700585e7c&q;},&q;memberOfCPC&q;:false,&q;tags&q;:null},{&q;id&q;:17032,&q;userId&q;:73005297,&q;name&q;:&q;李婕&q;,&q;brief&q;:&q;粉笔优质讲师&q;,&q;desc&q;:&q;粉笔常识公基优质教师\n7年以上一线授课经验，累计授课时长超1000+小时，授课人数超20000+，对常识公基板块理解透彻，曾多次参与命制笔试教研，对民法、刑法等考情有着深入研究，出过近500道优质模拟题，在常识公基教研方面取得不小成果。擅长结合时事热点将晦涩难懂的知识具象化。教学方法也独具匠心深受同学好评，在课堂上经常采用思维导图+口诀记忆法，将繁杂的知识点串联成清晰的知识体系，面对易错易混点也能通过对比分析来加深理解，多年来深受广大学员的认可和五星好评，在学员中具有非常好的口碑，是一位值得信赖的好导师。&q;,&q;avatar&q;:&q;19bc4b46802c805.jpg&q;,&q;upperBodyPhoto&q;:null,&q;displayCoursePrefix&q;:&q;sydw&q;,&q;teacherStat&q;:{&q;teacherId&q;:17032,&q;episodeCount&q;:999,&q;scoreCount&q;:2265,&q;avgScore&q;:9.766887417218552,&q;fiveGradeAvgScore&q;:4.88,&q;updateTime&q;:1773397773324},&q;auditionEpisode&q;:{&q;episodeTitle&q;:&q;个人展示课&q;,&q;episodeVideoUrl&q;:&q;https://vod.fbstatic.cn/22e9ceb2vodbj1251001446/2eda4b7c5145403709227505228/MwwhZdSfiwYA.mp4?t=f2a4b300&a;us=4070880000&a;sign=6b3a5523cd064638f6e21c89c8efeea0&q;},&q;memberOfCPC&q;:false,&q;tags&q;:null},{&q;id&q;:35779,&q;userId&q;:80907612,&q;name&q;:&q;惠丹&q;,&q;brief&q;:&q;粉笔优质讲师&q;,&q;desc&q;:&q;粉笔优质教师\n五年事考授课经验。长期从事线上综应科目授课，多次担任江苏等地事考基地班冲刺主讲老师。\n对各省及地区事业单位考情深入研究，每期均有学员顺利过笔进面、过面；\n授课风格轻松幽默，擅长调动学员的思考积极性和课堂参与性！&q;,&q;avatar&q;:&q;1945f2c4af76102.jpg&q;,&q;upperBodyPhoto&q;:null,&q;displayCoursePrefix&q;:&q;sydw&q;,&q;teacherStat&q;:{&q;teacherId&q;:35779,&q;episodeCount&q;:289,&q;scoreCount&q;:377,&q;avgScore&q;:9.92042440318303,&q;fiveGradeAvgScore&q;:4.96,&q;updateTime&q;:1773551391634},&q;auditionEpisode&q;:{&q;episodeTitle&q;:&q;个人展示课&q;,&q;episodeVideoUrl&q;:&q;https://vod.fbstatic.cn/22e9ceb2vodbj1251001446/77dc28fb5145403709313054655/CHLdDpy1gfYA.mp4?t=f2a4b300&a;us=4070880000&a;sign=6c8cfd5bd94f9c872142bfd0e37ea66e&q;},&q;memberOfCPC&q;:false,&q;tags&q;:null},{&q;id&q;:64309,&q;userId&q;:105157457,&q;name&q;:&q;彭行锋&q;,&q;brief&q;:&q;粉笔优质讲师&q;,&q;desc&q;:&q;粉笔优质教师\n长期从事一线公考教学工作，熟悉体制内实际工作，累计授课5年余，每年授课时长超1000小时。理论功底深厚，具有申论、综应科目丰富的实践经验及系统扎实的专业理论知识，对国考、各地方省考和事业单位考试考情、真题和命题方向理解深刻。授课时讲解细致、逻辑清晰、重点突出，能从题型特点和材料逻辑出发，引导学生思考，并善于总结梳理解题方法，让学员能从一道题学会一类题，用更简单的方法，找到更快捷的解题之道，不断提高综应分数，带领多名学生高分上岸，广受学员好评。&q;,&q;avatar&q;:&q;19462c5b766fea8.jpg&q;,&q;upperBodyPhoto&q;:null,&q;displayCoursePrefix&q;:&q;sydw&q;,&q;teacherStat&q;:{&q;teacherId&q;:64309,&q;episodeCount&q;:770,&q;scoreCount&q;:788,&q;avgScore&q;:9.845177664974608,&q;fiveGradeAvgScore&q;:4.92,&q;updateTime&q;:1773391273278},&q;auditionEpisode&q;:{&q;episodeTitle&q;:&q;个人展示课&q;,&q;episodeVideoUrl&q;:&q;https://vod.fbstatic.cn/22e9ceb2vodbj1251001446/b448932f5145403708976968107/Wojnx2AoI0gA.mp4?t=f2a4b300&a;us=4070880000&a;sign=87716c59c7264a28aa85682a04ffbaa8&q;},&q;memberOfCPC&q;:false,&q;tags&q;:null},{&q;id&q;:16905,&q;userId&q;:73838220,&q;name&q;:&q;袁鑫&q;,&q;brief&q;:&q;粉笔优质讲师&q;,&q;desc&q;:&q;6年一线教育经验，拥有丰富的线上授课经验，累计授课时长1000+。\n在常识公基非法与言语理解两个学科领域，承担包括但不限于授课、模拟题命制、单题录制等核心工作。\n多次参与粉笔授课研讨会议，精准捕捉考试命题的最新趋势；\n累计评分达4.9分，学员口碑较好，授课节奏张弛有度，授课风格条理分明，善于援引生活案例解读专业理论内容，能够充分调动学员积极性，备受学员喜爱与好评&q;,&q;avatar&q;:&q;194261e229cc8c5.jpg&q;,&q;upperBodyPhoto&q;:null,&q;displayCoursePrefix&q;:&q;sydw&q;,&q;teacherStat&q;:{&q;teacherId&q;:16905,&q;episodeCount&q;:781,&q;scoreCount&q;:1375,&q;avgScore&q;:9.796363636363642,&q;fiveGradeAvgScore&q;:4.9,&q;updateTime&q;:1773370334277},&q;auditionEpisode&q;:{&q;episodeTitle&q;:&q;个人展示课&q;,&q;episodeVideoUrl&q;:&q;https://vod.fbstatic.cn/22e9ceb2vodbj1251001446/680585e95145403708191968166/297Y8tgm67sA.mp4?t=f2a4b300&a;us=4070880000&a;sign=77be52f07081e2ea4e26d74248e8765e&q;},&q;memberOfCPC&q;:false,&q;tags&q;:null},{&q;id&q;:35007,&q;userId&q;:84101851,&q;name&q;:&q;赵媛媛&q;,&q;brief&q;:&q;粉笔优质讲师&q;,&q;desc&q;:&q;粉笔优质讲师\n6年一线教学经验，深耕事业单位笔试，服务学员达数千人，承担过江西、江苏、山东等线上线下笔试系统班、刷题班、冲刺班等多种班型，累计授课时长超1000小时，累计课程评分4.9分，经验丰富。\n2.定期参与综应科目培训和教研，多次参加真题解析及课程录制，了解最新命题趋势。\n3.理论基础扎实，授课经验丰富，能够从学员角度出发，耐心细致，条理清晰，以帮助学员上岸为己任，深受学员喜爱。&q;,&q;avatar&q;:&q;196616e0bc722b2.jpg&q;,&q;upperBodyPhoto&q;:null,&q;displayCoursePrefix&q;:&q;sydw&q;,&q;teacherStat&q;:{&q;teacherId&q;:35007,&q;episodeCount&q;:431,&q;scoreCount&q;:541,&q;avgScore&q;:9.878003696857672,&q;fiveGradeAvgScore&q;:4.94,&q;updateTime&q;:1773447824001},&q;auditionEpisode&q;:{&q;episodeTitle&q;:&q;个人展示课&q;,&q;episodeVideoUrl&q;:&q;https://vod.fbstatic.cn/22e9ceb2vodbj1251001446/6b00b48a5145403714882865464/ZBjS2hCISDcA.mp4?t=f2a4b300&a;us=4070880000&a;sign=19816a3a520159d196e5ab181217b4d4&q;},&q;memberOfCPC&q;:false,&q;tags&q;:null},{&q;id&q;:56385,&q;userId&q;:50015800,&q;name&q;:&q;庞丹&q;,&q;brief&q;:&q;粉笔优质讲师&q;,&q;desc&q;:&q;粉笔优质教师\n4年一线教学授课经验，具有判断科目丰富的实践经验及系统扎实的专业理论知识，多次参加粉笔授课研讨会议，全面把握命题趋势及最新考情；具有幽默的授课风格，让学生在轻松的学习氛围中，用更简单的方法，找到更快捷的解题之道，深受广大学员的认可和好评。&q;,&q;avatar&q;:&q;1945f34f84341d4.jpg&q;,&q;upperBodyPhoto&q;:null,&q;displayCoursePrefix&q;:&q;sydw&q;,&q;teacherStat&q;:{&q;teacherId&q;:56385,&q;episodeCount&q;:235,&q;scoreCount&q;:800,&q;avgScore&q;:9.839999999999995,&q;fiveGradeAvgScore&q;:4.92,&q;updateTime&q;:1773540635509},&q;auditionEpisode&q;:{&q;episodeTitle&q;:&q;个人展示课&q;,&q;episodeVideoUrl&q;:&q;https://vod.fbstatic.cn/22e9ceb2vodbj1251001446/625f63ce1397757903436641275/wFPjvhJaMUwA.mp4?t=f2a4b300&a;us=4070880000&a;sign=701664771be53d7d1c5fc11587f36f4b&q;},&q;memberOfCPC&q;:false,&q;tags&q;:null},{&q;id&q;:17176,&q;userId&q;:73973279,&q;name&q;:&q;袁美玲&q;,&q;brief&q;:&q;粉笔优质讲师&q;,&q;desc&q;:&q;粉笔优质讲师\n具有五年一线教学授课经验、熟知言语科目考查特点和高频考点、授课风格细致严谨，善于从知识点出发剖析入微，讲解透彻。累计授课时长1000＋、线上线下经验丰富，深得学生喜爱。&q;,&q;avatar&q;:&q;17554099889d717.jpg&q;,&q;upperBodyPhoto&q;:null,&q;displayCoursePrefix&q;:&q;sydw&q;,&q;teacherStat&q;:{&q;teacherId&q;:17176,&q;episodeCount&q;:466,&q;scoreCount&q;:1474,&q;avgScore&q;:9.789687924016283,&q;fiveGradeAvgScore&q;:4.89,&q;updateTime&q;:1773541518378},&q;auditionEpisode&q;:{&q;episodeTitle&q;:&q;个人展示课&q;,&q;episodeVideoUrl&q;:&q;https://vod.fbstatic.cn/22e9ceb2vodbj1251001446/263803ec5145403709584191777/5FAQ6VPPICIA.mp4?t=f2a4b300&a;us=4070880000&a;sign=3fe9e815ea2b44c7adf575846f71ee59&q;},&q;memberOfCPC&q;:false,&q;tags&q;:null},{&q;id&q;:28915,&q;userId&q;:78500265,&q;name&q;:&q;谭晓雯&q;,&q;brief&q;:&q;粉笔优质讲师&q;,&q;desc&q;:&q;粉笔优质教师。\n5年一线教学经验，理论基础扎实，多次参加粉笔授课研讨会议，全面把握笔试考情和命题趋势。并撰写多篇内部教研材料和题库真题参考解析，在粉笔教师内部进行共享。\n授课逻辑清晰，累计授课超千余小时，累计评分达4.9分。授课表达方式浅显易懂，善于帮助学生逐步构建起对知识的全面认知。线上累计带班督学超40+班级，涉及多种班型，根据不同学员的情况和班级设计合理安排复习任务，同时关注学生易混易错点，做到及时答疑和梳理，让学生能够充分发挥自己的潜力，不断取得新的进步和成就。&q;,&q;avatar&q;:&q;1983b28dc337050.jpg&q;,&q;upperBodyPhoto&q;:null,&q;displayCoursePrefix&q;:&q;sydw&q;,&q;teacherStat&q;:{&q;teacherId&q;:28915,&q;episodeCount&q;:689,&q;scoreCount&q;:867,&q;avgScore&q;:9.8316032295271,&q;fiveGradeAvgScore&q;:4.92,&q;updateTime&q;:1773558667564},&q;auditionEpisode&q;:{&q;episodeTitle&q;:&q;个人展示课&q;,&q;episodeVideoUrl&q;:&q;https://vod.fbstatic.cn/22e9ceb2vodbj1251001446/226effd55145403708037005921/gxAp1apwDkQA.mp4?t=f2a4b300&a;us=4070880000&a;sign=83611b1a8d6199dfcaa7b5846e54a716&q;},&q;memberOfCPC&q;:false,&q;tags&q;:null},{&q;id&q;:25998,&q;userId&q;:74893882,&q;name&q;:&q;卜晓&q;,&q;brief&q;:&q;粉笔优质讲师&q;,&q;desc&q;:&q;粉笔优质教师\n6年一线教学授课经验，具有判断科目丰富的实践经验及系统扎实的专业理论知识。多次参加粉笔授课研讨会议，全面把握公考笔试命题趋势及最新考情，积累丰富的笔试知识。\n授课风格形象生动、条理清晰，让学生在轻松的学习氛围中，用更简单的方法，找到更快捷的解题之道，深受广大学员的认可和好评；在学员中具有非常好的口碑，是值得信赖的好导师。&q;,&q;avatar&q;:&q;1983b0eb4544784.jpg&q;,&q;upperBodyPhoto&q;:null,&q;displayCoursePrefix&q;:&q;sydw&q;,&q;teacherStat&q;:{&q;teacherId&q;:25998,&q;episodeCount&q;:241,&q;scoreCount&q;:956,&q;avgScore&q;:9.822175732217573,&q;fiveGradeAvgScore&q;:4.91,&q;updateTime&q;:1772456165442},&q;auditionEpisode&q;:{&q;episodeTitle&q;:&q;个人展示课&q;,&q;episodeVideoUrl&q;:&q;https://vod.fbstatic.cn/22e9ceb2vodbj1251001446/66f828ce1397757903436832264/gWy20rAOGRMA.mp4?t=f2a4b300&a;us=4070880000&a;sign=80068e51d1010737ea53aef5d97ef1a4&q;},&q;memberOfCPC&q;:false,&q;tags&q;:null},{&q;id&q;:21457,&q;userId&q;:52931102,&q;name&q;:&q;罗亚君&q;,&q;brief&q;:&q;粉笔优质讲师&q;,&q;desc&q;:&q;粉笔优质讲师\n过往授课经验：曾参加过数次笔试面试实战考试，多年笔试授课经验。\n累计授课时长1000+,累计授课人数10000+人次，累计评分9.8分以上。\n对事考、军队文职、三支一扶等考情深入研究，取得良好的教研成果；在考试中所授课学员取得优异成绩；多次参加粉笔授课研讨会议，全面把握笔试考试命题趋势及最新考情，积累丰富面试知识；多次参加粉笔教研活动，分享授课经验心得，助力粉笔理论研发升级。\n授课幽默诙谐、形象生动、条理清晰，让学生在轻松的学习氛围中，用更简单的方法，找到更快捷的解题之道，深受广大学员的认可和好评。&q;,&q;avatar&q;:&q;1965cd13968c972.jpg&q;,&q;upperBodyPhoto&q;:null,&q;displayCoursePrefix&q;:&q;sydw&q;,&q;teacherStat&q;:{&q;teacherId&q;:21457,&q;episodeCount&q;:531,&q;scoreCount&q;:1322,&q;avgScore&q;:9.795763993948558,&q;fiveGradeAvgScore&q;:4.9,&q;updateTime&q;:1773569380545},&q;auditionEpisode&q;:{&q;episodeTitle&q;:&q;个人展示课&q;,&q;episodeVideoUrl&q;:&q;https://vod.fbstatic.cn/22e9ceb2vodbj1251001446/cc8d608c5145403709538809385/FA0QT6PoAvcA.mp4?t=f2a4b300&a;us=4070880000&a;sign=6ce7013cb7d665ef392ef86c5e59bfa1&q;},&q;memberOfCPC&q;:false,&q;tags&q;:null},{&q;id&q;:16686,&q;userId&q;:69893637,&q;name&q;:&q;刘期期&q;,&q;brief&q;:&q;粉笔优质讲师&q;,&q;desc&q;:&q;粉笔优质讲师\n毕业于211大学，投身教育事业6年时间，对言语科目有丰富的实践经验，参与真题的解析和模拟题的命制，课程累计评分4.9分。了解考场答题思维及应变技巧，注重启发式授课，让学生在轻松的氛围中找到高效的解题方法。授课风格风趣幽默，课堂互动性强，善于从学员角度出发解决个性化问题，激发学员学习热情和自主意识，注重理论与实践相结合。&q;,&q;avatar&q;:&q;1746bbe5d160d43.jpg&q;,&q;upperBodyPhoto&q;:null,&q;displayCoursePrefix&q;:&q;sydw&q;,&q;teacherStat&q;:{&q;teacherId&q;:16686,&q;episodeCount&q;:447,&q;scoreCount&q;:2045,&q;avgScore&q;:9.762347188264059,&q;fiveGradeAvgScore&q;:4.88,&q;updateTime&q;:1773546406556},&q;auditionEpisode&q;:{&q;episodeTitle&q;:&q;个人展示课&q;,&q;episodeVideoUrl&q;:&q;https://vod.fbstatic.cn/22e9ceb2vodbj1251001446/077558931397757911915926552/PpFe6z48T8UA.mp4?t=f2a4b300&a;us=4070880000&a;sign=6bc5b6dbf5223797c9f2083c2bb5bf66&q;},&q;memberOfCPC&q;:false,&q;tags&q;:null},{&q;id&q;:16524,&q;userId&q;:49155632,&q;name&q;:&q;满晓堂&q;,&q;brief&q;:&q;粉笔优质讲师&q;,&q;desc&q;:&q;粉笔优质讲师\n六年事业单位及公考教学经验，曾备战公考一次成功上岸，以本岗位笔试分数第一、面试第二的成绩顺利通过，原税务局在职公务员。累计授课超过1500小时，累计评分达4.9分。多次参与笔试教研与培训，不断提升，凭借敏锐洞察力与深厚专业素养，对模拟题方向有深刻见解。授课思路清晰，形象生动，擅长理论与实践相结合，举一反三夯实巩固，从而激发学员学习热情和自主意识，让学生在轻松的学习氛围中，用更简单的方法，找到更快捷的解题之道，在学员中具有非常好的口碑。&q;,&q;avatar&q;:&q;17467879686bbe1.jpg&q;,&q;upperBodyPhoto&q;:null,&q;displayCoursePrefix&q;:&q;sydw&q;,&q;teacherStat&q;:{&q;teacherId&q;:16524,&q;episodeCount&q;:492,&q;scoreCount&q;:1665,&q;avgScore&q;:9.77537537537537,&q;fiveGradeAvgScore&q;:4.89,&q;updateTime&q;:1773547501096},&q;auditionEpisode&q;:{&q;episodeTitle&q;:&q;个人展示课&q;,&q;episodeVideoUrl&q;:&q;https://vod.fbstatic.cn/22e9ceb2vodbj1251001446/6d42b8e95145403714882953780/wGKek9PMDbkA.mp4?t=f2a4b300&a;us=4070880000&a;sign=fd2a39d484d775f3acaff1186a7899a6&q;},&q;memberOfCPC&q;:false,&q;tags&q;:null},{&q;id&q;:16852,&q;userId&q;:74701449,&q;name&q;:&q;王琛&q;,&q;brief&q;:&q;粉笔优质讲师&q;,&q;desc&q;:&q;粉笔优质教师\n具有6年教学授课经验，授课重点突出，能够及时总结拓展，讲解语言通俗易懂，广受学员好评。课堂氛围轻松融洽，擅长引导学生自主思考，多次参与粉笔教研活动，全面把握命题趋势和最新考情。善于根据学生的不同情况，进行个性化的指导，助力学员上岸。&q;,&q;avatar&q;:&q;1966b8f5dbc77d6.jpg&q;,&q;upperBodyPhoto&q;:null,&q;displayCoursePrefix&q;:&q;sydw&q;,&q;teacherStat&q;:{&q;teacherId&q;:16852,&q;episodeCount&q;:443,&q;scoreCount&q;:2283,&q;avgScore&q;:9.75295663600527,&q;fiveGradeAvgScore&q;:4.88,&q;updateTime&q;:1773543525445},&q;auditionEpisode&q;:{&q;episodeTitle&q;:&q;个人展示课&q;,&q;episodeVideoUrl&q;:&q;https://vod.fbstatic.cn/22e9ceb2vodbj1251001446/b269fc425145403709334963335/WjukmC5LPh8A.mp4?t=f2a4b300&a;us=4070880000&a;sign=8efff2e71e1428c94e20dd995c2853f2&q;},&q;memberOfCPC&q;:false,&q;tags&q;:null},{&q;id&q;:16718,&q;userId&q;:45061774,&q;name&q;:&q;王霏&q;,&q;brief&q;:&q;粉笔优质讲师&q;,&q;desc&q;:&q;粉笔优质讲师\n5年公培行业从业经验，判断推理基本功扎实，擅长帮助学生分析问题、总结做题思路和技巧，耐心细致，授课思路清晰。&q;,&q;avatar&q;:&q;1746bcb1b6083c9.jpg&q;,&q;upperBodyPhoto&q;:null,&q;displayCoursePrefix&q;:&q;sydw&q;,&q;teacherStat&q;:{&q;teacherId&q;:16718,&q;episodeCount&q;:459,&q;scoreCount&q;:1849,&q;avgScore&q;:9.766360194699821,&q;fiveGradeAvgScore&q;:4.88,&q;updateTime&q;:1773457275604},&q;auditionEpisode&q;:{&q;episodeTitle&q;:&q;个人展示课&q;,&q;episodeVideoUrl&q;:&q;https://vod.fbstatic.cn/22e9ceb2vodbj1251001446/d391ebe15145403707386360563/RiraEc3HyGYA.mp4?t=f2a4b300&a;us=4070880000&a;sign=de75e641b117c04d861c2840d7bcef3f&q;},&q;memberOfCPC&q;:false,&q;tags&q;:null},{&q;id&q;:16843,&q;userId&q;:69995718,&q;name&q;:&q;宋媛&q;,&q;brief&q;:&q;粉笔优质讲师&q;,&q;desc&q;:&q;粉笔优质教师\n6年一线授课讲解，始终以生动有趣、激发学生思维为教学宗旨，课堂氛围轻松融洽，广受学员好评。授课逻辑严谨重点突出，能够及时总结拓展，讲解语言通俗易懂。擅长引导学生自主思考，善于根据学生的不同情况和需求，制定合适的教学计划，进行个性化指导，助力学员上岸。&q;,&q;avatar&q;:&q;1746c88246d8c4b.jpg&q;,&q;upperBodyPhoto&q;:null,&q;displayCoursePrefix&q;:&q;sydw&q;,&q;teacherStat&q;:{&q;teacherId&q;:16843,&q;episodeCount&q;:563,&q;scoreCount&q;:1897,&q;avgScore&q;:9.763837638376383,&q;fiveGradeAvgScore&q;:4.88,&q;updateTime&q;:1773542983485},&q;auditionEpisode&q;:{&q;episodeTitle&q;:&q;个人展示课&q;,&q;episodeVideoUrl&q;:&q;https://vod.fbstatic.cn/22e9ceb2vodbj1251001446/3278835f5145403710498133916/2a2WKmSANLgA.mp4?t=f2a4b300&a;us=4070880000&a;sign=fecd9380c7b878c2b18ec355019021e5&q;},&q;memberOfCPC&q;:false,&q;tags&q;:null},{&q;id&q;:64240,&q;userId&q;:136258833,&q;name&q;:&q;熙儒&q;,&q;brief&q;:&q;粉笔优质讲师&q;,&q;desc&q;:&q;粉笔优质讲师\n主教事业单位笔试综应科目，拥有多年的一线教学授课经验。具备系统扎实的专业理论知识，参与多次相关教研真题录制工作。思路开阔，注重理论与实际相结合教育，善于因材施教，带领多名学生高分上岸。多次收获学生好评，待人亲和，上课教学风格幽默风趣，逻辑清晰，讲解深入浅出，善于引导，让学员在轻松活跃的氛围中快速获取知识，克服重重困难，最终实现梦想。&q;,&q;avatar&q;:&q;1945f3c2db80a69.jpg&q;,&q;upperBodyPhoto&q;:null,&q;displayCoursePrefix&q;:&q;sydw&q;,&q;teacherStat&q;:{&q;teacherId&q;:64240,&q;episodeCount&q;:558,&q;scoreCount&q;:369,&q;avgScore&q;:9.907859078590787,&q;fiveGradeAvgScore&q;:4.95,&q;updateTime&q;:1773584458538},&q;auditionEpisode&q;:{&q;episodeTitle&q;:&q;个人展示课&q;,&q;episodeVideoUrl&q;:&q;https://vod.fbstatic.cn/22e9ceb2vodbj1251001446/ad7e5f071397757909240510562/decWh0KkzDQA.mp4?t=f2a4b300&a;us=4070880000&a;sign=5da92042df829294dca2292b4fe66a70&q;},&q;memberOfCPC&q;:false,&q;tags&q;:null},{&q;id&q;:13993,&q;userId&q;:69689351,&q;name&q;:&q;王一如&q;,&q;brief&q;:&q;粉笔优质讲师&q;,&q;desc&q;:&q;粉笔优质讲师\n法学硕士，具有7年一线授课经验，累计授课超千余小时。\n具有申论、综应科目丰富的实践经验，专业理论知识扎实。能够全面了解考试重难点及不同类型题目答题技巧，精准把握各地考试要点与命题方向。\n学员口碑：累计评分达4.9分。授课思维灵活，教学态度认真负责，富有感染力和亲和力，善于将实战与技巧相结合，让学员用简洁高效的方法找到解题捷径，能够帮助学员做到学以致用，深受学员高度认可。&q;,&q;avatar&q;:&q;1769373e273385e.jpg&q;,&q;upperBodyPhoto&q;:null,&q;displayCoursePrefix&q;:&q;sydw&q;,&q;teacherStat&q;:{&q;teacherId&q;:13993,&q;episodeCount&q;:501,&q;scoreCount&q;:776,&q;avgScore&q;:9.829896907216488,&q;fiveGradeAvgScore&q;:4.91,&q;updateTime&q;:1773403079901},&q;auditionEpisode&q;:{&q;episodeTitle&q;:&q;个人展示课&q;,&q;episodeVideoUrl&q;:&q;https://vod.fbstatic.cn/22e9ceb2vodbj1251001446/48e924035145403708540695624/ZUytViIKFgMA.mp4?t=f2a4b300&a;us=4070880000&a;sign=c6898af63e68d18207f2687b1d8c65ef&q;},&q;memberOfCPC&q;:false,&q;tags&q;:null},{&q;id&q;:32808,&q;userId&q;:83059591,&q;name&q;:&q;杨恬&q;,&q;brief&q;:&q;粉笔优质讲师&q;,&q;desc&q;:&q;粉笔优质讲师。\n五年一线教学授课经验，深耕一线考试，承担过多种班型授课，经验丰富。\n多次参与笔试真题教研和解析撰写、模拟题撰写等工作，具有常识公基法律科目丰富的实践经验及系统扎实的专业理论知识，对常识公基法律考情有深入研究。\n累计带班学员超2000人，累计授课评分达4.9分，善于将知识以通俗易懂的方式进行讲解，课堂氛围轻松融洽。授课重点突出，能够及时总结拓展，广受学员好评。&q;,&q;avatar&q;:&q;193af6183f51cdd.jpg&q;,&q;upperBodyPhoto&q;:null,&q;displayCoursePrefix&q;:&q;sydw&q;,&q;teacherStat&q;:{&q;teacherId&q;:32808,&q;episodeCount&q;:454,&q;scoreCount&q;:842,&q;avgScore&q;:9.821852731591449,&q;fiveGradeAvgScore&q;:4.91,&q;updateTime&q;:1773115152848},&q;auditionEpisode&q;:{&q;episodeTitle&q;:&q;个人展示课&q;,&q;episodeVideoUrl&q;:&q;https://vod.fbstatic.cn/22e9ceb2vodbj1251001446/c5ad3d005145403709538520842/7oXi70wDlacA.mp4?t=f2a4b300&a;us=4070880000&a;sign=fb07f07d913a537688e0a54d439803e7&q;},&q;memberOfCPC&q;:false,&q;tags&q;:null},{&q;id&q;:32041,&q;userId&q;:83032228,&q;name&q;:&q;刘柳利&q;,&q;brief&q;:&q;粉笔优质讲师&q;,&q;desc&q;:&q;粉笔优质教师。\n5年教学经验，累计授课近千课时，综合授课评分4.9，服务超过1000名学员，督学评分平均4.98以上。多次参与真题教研与解析编写，及时掌握各类考试命题特点与趋势。理论基础扎实，知识储备丰富，逻辑清晰，注重理解记忆和高效率，语言通俗易懂，幽默风趣，注重引导学员思考，帮助学员快速理解考点考情。善于倾听学员的学习诉求，并及时回应，讲课细致耐心，课堂氛围轻松活跃，学员可以获得良好的学习体验，深受学员好评。&q;,&q;avatar&q;:&q;1783557a9efc908.jpg&q;,&q;upperBodyPhoto&q;:null,&q;displayCoursePrefix&q;:&q;sydw&q;,&q;teacherStat&q;:{&q;teacherId&q;:32041,&q;episodeCount&q;:607,&q;scoreCount&q;:1396,&q;avgScore&q;:9.777936962750728,&q;fiveGradeAvgScore&q;:4.89,&q;updateTime&q;:1773281123587},&q;auditionEpisode&q;:null,&q;memberOfCPC&q;:false,&q;tags&q;:null},{&q;id&q;:35889,&q;userId&q;:59452309,&q;name&q;:&q;王昭媛&q;,&q;brief&q;:&q;粉笔优质讲师&q;,&q;desc&q;:&q;粉笔优质讲师\n985院校硕士毕业，投身教育事业6年，拥有扎实一线教学经验。多次参与真题解析以及真题解析视频录制，积累大量实用经验，对各省份考情深入钻研，精准把握各地考试要点。\n授课思路清晰，熟练掌握各类题型的作答技巧，理论扎实，逻辑清晰，重点突出，耐心细致，在教学过程中因材施教，采用启发式教学法，激发学员的学习兴趣与思考能力。\n承担各种线上线下授课任务，累计服务学员上千人，授课超1000小时，累计评分达4.9分。始终秉持着“以学员为中心”的教学理念，在教学过程中因材施教，并能及时跟进学员的学习进度，耐心解答学员的疑问，为学员提供个性化的辅导与建议，深受学员喜爱。&q;,&q;avatar&q;:&q;18f7000bcd332c6.jpg&q;,&q;upperBodyPhoto&q;:null,&q;displayCoursePrefix&q;:&q;sydw&q;,&q;teacherStat&q;:{&q;teacherId&q;:35889,&q;episodeCount&q;:313,&q;scoreCount&q;:848,&q;avgScore&q;:9.818396226415093,&q;fiveGradeAvgScore&q;:4.91,&q;updateTime&q;:1773575413148},&q;auditionEpisode&q;:{&q;episodeTitle&q;:&q;个人展示课&q;,&q;episodeVideoUrl&q;:&q;https://vod.fbstatic.cn/22e9ceb2vodbj1251001446/22bda7be5145403707387441415/gXaZC0lUKVsA.mp4?t=f2a4b300&a;us=4070880000&a;sign=a57ab9a520ff41c2fe2822f31d725d60&q;},&q;memberOfCPC&q;:false,&q;tags&q;:null},{&q;id&q;:28923,&q;userId&q;:80505035,&q;name&q;:&q;林婉华&q;,&q;brief&q;:&q;粉笔优质讲师&q;,&q;desc&q;:&q;粉笔优质教师，\n具有扎实的理论基础，能够熟练掌握笔试考情和命题趋势，多次参加教研会议，教研成果突出，著有多篇教研文章。\n5年一线教学经验，累计授课时长超千小时，授课经验丰富，语言风趣幽默，授课综合评分4.9，广受学员好评。\n累计督学带班超70个，带班人数逾千人，能够及时回复学员疑问，答疑思路清晰，指导学员发现自己的薄弱项并提出针对性的方法辅助解决问题。善于观察，能够从学员的学习情况中总结出易混易错知识点帮助提升。&q;,&q;avatar&q;:&q;1983b2798d5030e.jpg&q;,&q;upperBodyPhoto&q;:null,&q;displayCoursePrefix&q;:&q;sydw&q;,&q;teacherStat&q;:{&q;teacherId&q;:28923,&q;episodeCount&q;:609,&q;scoreCount&q;:802,&q;avgScore&q;:9.822942643391526,&q;fiveGradeAvgScore&q;:4.91,&q;updateTime&q;:1773544599718},&q;auditionEpisode&q;:{&q;episodeTitle&q;:&q;个人展示课&q;,&q;episodeVideoUrl&q;:&q;https://vod.fbstatic.cn/22e9ceb2vodbj1251001446/81e6bc0a5145403709537906845/JafPZKk51JwA.mp4?t=f2a4b300&a;us=4070880000&a;sign=9167ae8a132de87e85e55d782904dc7a&q;},&q;memberOfCPC&q;:false,&q;tags&q;:null},{&q;id&q;:35786,&q;userId&q;:84384064,&q;name&q;:&q;张维佳&q;,&q;brief&q;:&q;粉笔优质讲师&q;,&q;desc&q;:&q;粉笔常识公基优质讲师\n累计授课时长近2000小时,累计授课人数千余人，讲课风格耐心细致、思维活跃，帮助学员准确掌握题目考查要点，提供对应解题技巧和记忆技巧，受学员广泛好评。&q;,&q;avatar&q;:&q;178e80c1255ed8a.jpg&q;,&q;upperBodyPhoto&q;:null,&q;displayCoursePrefix&q;:&q;sydw&q;,&q;teacherStat&q;:{&q;teacherId&q;:35786,&q;episodeCount&q;:685,&q;scoreCount&q;:1252,&q;avgScore&q;:9.78434504792333,&q;fiveGradeAvgScore&q;:4.89,&q;updateTime&q;:1773461230882},&q;auditionEpisode&q;:{&q;episodeTitle&q;:&q;个人展示课&q;,&q;episodeVideoUrl&q;:&q;https://vod.fbstatic.cn/22e9ceb2vodbj1251001446/6782dd595145403711104883661/zmrCDiqYuxAA.mp4?t=f2a4b300&a;us=4070880000&a;sign=f959ae28f68f6398cfffa70a2cf025a2&q;},&q;memberOfCPC&q;:false,&q;tags&q;:null},{&q;id&q;:16813,&q;userId&q;:50366016,&q;name&q;:&q;张煦昕&q;,&q;brief&q;:&q;粉笔优质讲师&q;,&q;desc&q;:&q;粉笔优质教师。\n投身教育事业6年，拥有扎实一线教学经验，对于面试内容有自己独到的见解。\n擅长运用结构化面试、情景模拟等多种方法，全面、客观地评估考生的逻辑思维、问题解决、沟通协调及抗压能力。\n授课评分累计达4.9分，授课耐心细致、严谨，循循善诱，熟悉考场答题技巧，能帮助学员理清答题思路；讲解题目逻辑性强条分缕析，善于总结方法技巧；课堂互动性强，善于通过点评帮助学生找到问题，激发学员学习热情，受到学员欢迎。&q;,&q;avatar&q;:&q;176a72cb2c6d8c4.jpg&q;,&q;upperBodyPhoto&q;:null,&q;displayCoursePrefix&q;:&q;sydw&q;,&q;teacherStat&q;:{&q;teacherId&q;:16813,&q;episodeCount&q;:466,&q;scoreCount&q;:1061,&q;avgScore&q;:9.796418473138555,&q;fiveGradeAvgScore&q;:4.9,&q;updateTime&q;:1773396064102},&q;auditionEpisode&q;:{&q;episodeTitle&q;:&q;个人展示课&q;,&q;episodeVideoUrl&q;:&q;https://vod.fbstatic.cn/22e9ceb2vodbj1251001446/3350025c5145403709543612633/AuAZazr4H98A.mp4?t=f2a4b300&a;us=4070880000&a;sign=d862836cd36bd5e4b2977a502173f189&q;},&q;memberOfCPC&q;:false,&q;tags&q;:null},{&q;id&q;:35490,&q;userId&q;:68968810,&q;name&q;:&q;刘斐&q;,&q;brief&q;:&q;粉笔优质讲师&q;,&q;desc&q;:&q;粉笔优质讲师\n过往授课经验:6年一线教学授课经验，总授课时长 7000+h.\n教学经验: 具有常识公基、综应科目丰富的实践经验及系统扎实的专业理论知识，对各省市地方考试考情和命题方向有独到见解； 22 年在武汉粉笔被评为“学员进面率三等奖”。\n授课耐心细致精确高效。讲解知识能抓住重点，剖析难题深邃透彻。教学能力全面，既能精准狙击各类高频考点，帮助学生高效提分，又能深入剖析那些变态难题，拓展学生的思维边界。思维输出逻辑清晰，层次分明，条理井然，能让复杂知识变得简单易懂。&q;,&q;avatar&q;:&q;193b4cc400085a7.jpg&q;,&q;upperBodyPhoto&q;:null,&q;displayCoursePrefix&q;:&q;sydw&q;,&q;teacherStat&q;:{&q;teacherId&q;:35490,&q;episodeCount&q;:772,&q;scoreCount&q;:1768,&q;avgScore&q;:9.75113122171944,&q;fiveGradeAvgScore&q;:4.88,&q;updateTime&q;:1773473369986},&q;auditionEpisode&q;:{&q;episodeTitle&q;:&q;个人展示课&q;,&q;episodeVideoUrl&q;:&q;https://vod.fbstatic.cn/22e9ceb2vodbj1251001446/637a1c8d5145403708072789369/Q935cWiAVDUA.mp4?t=f2a4b300&a;us=4070880000&a;sign=b9e97b132323836b52734dae342e21af&q;},&q;memberOfCPC&q;:false,&q;tags&q;:null},{&q;id&q;:31967,&q;userId&q;:67126019,&q;name&q;:&q;郭一桐&q;,&q;brief&q;:&q;粉笔优质讲师&q;,&q;desc&q;:&q;粉笔优质教师\n投身教育事业四年，拥有扎实一线教学经验，在事业单位公共基础知识科目的教学中，积累大量实用经验，专业理论知识扎实。对各省市考情深入钻研，精准把握各地考试要点与命题方向。多次参加粉笔真题教研与模拟题教研，全面把握事考命题趋势和最新考情。授课风格独具魅力，善于营造轻松愉悦的学习氛围，让学生对知识点茅塞顿开，并灵活运用，深受学员认可。&q;,&q;avatar&q;:&q;1789129960c875a.jpg&q;,&q;upperBodyPhoto&q;:null,&q;displayCoursePrefix&q;:&q;sydw&q;,&q;teacherStat&q;:{&q;teacherId&q;:31967,&q;episodeCount&q;:543,&q;scoreCount&q;:808,&q;avgScore&q;:9.811881188118809,&q;fiveGradeAvgScore&q;:4.91,&q;updateTime&q;:1773133486342},&q;auditionEpisode&q;:{&q;episodeTitle&q;:&q;个人展示课&q;,&q;episodeVideoUrl&q;:&q;https://vod.fbstatic.cn/22e9ceb2vodbj1251001446/e44064b11397757888020613737/LkKFrBQcBMAA.mp4?t=f2a4b300&a;us=4070880000&a;sign=9c612c0ca75f3a068042327bb6f1e7c6&q;},&q;memberOfCPC&q;:false,&q;tags&q;:null},{&q;id&q;:32032,&q;userId&q;:81559433,&q;name&q;:&q;陈绮桐&q;,&q;brief&q;:&q;粉笔优质讲师&q;,&q;desc&q;:&q;粉笔优质教师\n五年一线教学经验\n熟练掌握各地区事业单位考情，参与多次教研，撰写多篇事业单位笔试教研材料，在粉笔教师内部进行共享。\n线上累计授课小时1000+，学员评分整体维持4.9，也有线下授课经历，授课经验丰富。课堂氛围轻松愉悦，授课思路清晰，深入浅出讲解如何破解综应难题。通过引导学员思考进而巩固理论基础，理顺解题思路，让学员克服难下笔，不动笔难题，达到提高分数的目的。\n提供多样化的辅导技巧，善于结合学员基础进行针对性辅导，有效解决学员疑惑，曾帮助0基础学员在成功提分20+。\n帮助不少学员成功进面，在过往学员评价中深受好评，是学员值得信赖的老师。&q;,&q;avatar&q;:&q;1983b323cb8eb84.jpg&q;,&q;upperBodyPhoto&q;:null,&q;displayCoursePrefix&q;:&q;sydw&q;,&q;teacherStat&q;:{&q;teacherId&q;:32032,&q;episodeCount&q;:290,&q;scoreCount&q;:409,&q;avgScore&q;:9.877750611246935,&q;fiveGradeAvgScore&q;:4.94,&q;updateTime&q;:1773554942877},&q;auditionEpisode&q;:{&q;episodeTitle&q;:&q;个人展示课&q;,&q;episodeVideoUrl&q;:&q;https://vod.fbstatic.cn/22e9ceb2vodbj1251001446/a9b323de5145403714883224921/TLnAfMW95fwA.mp4?t=f2a4b300&a;us=4070880000&a;sign=966d9114718757bc81c712e4601c4943&q;},&q;memberOfCPC&q;:false,&q;tags&q;:null},{&q;id&q;:52287,&q;userId&q;:72752112,&q;name&q;:&q;于小雅&q;,&q;brief&q;:&q;粉笔优质讲师&q;,&q;desc&q;:&q;粉笔优质讲师\n6年一线教学经验，深耕事业单位考试，总授课时长2500+h\n对于言语理解与表达科目有丰富的实践经验及系统扎实的专业理论知识。承担过线上和线下的笔试精品班、刷题班、冲刺班等多种班型。\n教学思路清晰严谨，善于总结；重难点突出，举一反三夯实巩固，深受学员好评。&q;,&q;avatar&q;:&q;19bbc41bac59b83.jpg&q;,&q;upperBodyPhoto&q;:null,&q;displayCoursePrefix&q;:&q;sydw&q;,&q;teacherStat&q;:{&q;teacherId&q;:52287,&q;episodeCount&q;:344,&q;scoreCount&q;:1147,&q;avgScore&q;:9.778552746294684,&q;fiveGradeAvgScore&q;:4.89,&q;updateTime&q;:1773483874192},&q;auditionEpisode&q;:{&q;episodeTitle&q;:&q;个人展示课&q;,&q;episodeVideoUrl&q;:&q;https://vod.fbstatic.cn/22e9ceb2vodbj1251001446/82ea83095145403709544757509/SyP20uThTZcA.mp4?t=f2a4b300&a;us=4070880000&a;sign=41435beb2ad52e1ee5e61334ffdb4056&q;},&q;memberOfCPC&q;:false,&q;tags&q;:null},{&q;id&q;:33625,&q;userId&q;:76445485,&q;name&q;:&q;高冰冰&q;,&q;brief&q;:&q;粉笔优质讲师&q;,&q;desc&q;:&q;粉笔优质讲师\n6年一线教学经验。服务学员数千人，承接线上线下各类型精品班，授课实战经验丰富，累计授课时长超1000小时，累计授课评分4.9分，深受学员喜爱。\n综应科目教学中，定期参与真题解析与教研，模拟题撰写，对最新命题方向趋势有深入研究。\n授课风格多样化，风趣幽默，生动形象。理论知识点讲解细致，善于化繁为简，能够耐心引导，准确把握重点，挖掘学员痛点，切实帮助学员提高。&q;,&q;avatar&q;:&q;193af4fd6901679.jpg&q;,&q;upperBodyPhoto&q;:null,&q;displayCoursePrefix&q;:&q;sydw&q;,&q;teacherStat&q;:{&q;teacherId&q;:33625,&q;episodeCount&q;:458,&q;scoreCount&q;:838,&q;avgScore&q;:9.804295942720769,&q;fiveGradeAvgScore&q;:4.9,&q;updateTime&q;:1773579662371},&q;auditionEpisode&q;:{&q;episodeTitle&q;:&q;个人展示课&q;,&q;episodeVideoUrl&q;:&q;https://vod.fbstatic.cn/22e9ceb2vodbj1251001446/6aefbd0e5145403714882857647/re8PB1kyEcQA.mp4?t=f2a4b300&a;us=4070880000&a;sign=48add9a940dd8732002e7716c42ccab9&q;},&q;memberOfCPC&q;:false,&q;tags&q;:null},{&q;id&q;:16736,&q;userId&q;:73894787,&q;name&q;:&q;韩娇&q;,&q;brief&q;:&q;粉笔优质讲师&q;,&q;desc&q;:&q;粉笔优质教师\n具有6年丰富的一线授课经验，累计授课时长已超过6000小时。幽默诙谐、形象生动的教学风格，能让学生在轻松愉快的氛围中掌握复杂的知识点。同时，注重条理清晰的讲解和思维跳跃的启发，帮助学生构建系统的知识框架，激发他们的学习潜能，深受广大学员的认可和好评，是学员值得信赖的优秀教师。&q;,&q;avatar&q;:&q;19bbc3030662940.jpg&q;,&q;upperBodyPhoto&q;:null,&q;displayCoursePrefix&q;:&q;sydw&q;,&q;teacherStat&q;:{&q;teacherId&q;:16736,&q;episodeCount&q;:460,&q;scoreCount&q;:1722,&q;avgScore&q;:9.746806039488957,&q;fiveGradeAvgScore&q;:4.87,&q;updateTime&q;:1772978351208},&q;auditionEpisode&q;:{&q;episodeTitle&q;:&q;个人展示课&q;,&q;episodeVideoUrl&q;:&q;https://vod.fbstatic.cn/22e9ceb2vodbj1251001446/d090d8201253642695654270008/uvSzxpw6mywA.mp4?t=f2a4b300&a;us=4070880000&a;sign=2384d20a3124c2fde9b0c3c9ef89cb4a&q;},&q;memberOfCPC&q;:false,&q;tags&q;:null},{&q;id&q;:17153,&q;userId&q;:73895962,&q;name&q;:&q;姚敏君&q;,&q;brief&q;:&q;粉笔优质讲师&q;,&q;desc&q;:&q;粉笔优质讲师\n5年一线教学经验，曾参加6次实战考试，授课与实战经验丰富，熟悉考场答题思维及应变技巧，多次参加粉笔教研活动，分享授课经验心得，助力粉笔理论研发升级。能够从学员角度出发，耐心细致，条理清晰，以帮助学员上岸为己任，深受学员喜爱。&q;,&q;avatar&q;:&q;193af7f79a57d9c.jpg&q;,&q;upperBodyPhoto&q;:null,&q;displayCoursePrefix&q;:&q;sydw&q;,&q;teacherStat&q;:{&q;teacherId&q;:17153,&q;episodeCount&q;:450,&q;scoreCount&q;:1349,&q;avgScore&q;:9.758339510748682,&q;fiveGradeAvgScore&q;:4.88,&q;updateTime&q;:1773568938721},&q;auditionEpisode&q;:{&q;episodeTitle&q;:&q;个人展示课&q;,&q;episodeVideoUrl&q;:&q;https://vod.fbstatic.cn/22e9ceb2vodbj1251001446/1a272b2b5145403709539893272/s11PsnV83XMA.mp4?t=f2a4b300&a;us=4070880000&a;sign=a4fe617c9843f0d1595e8bb39b5bce04&q;},&q;memberOfCPC&q;:false,&q;tags&q;:null},{&q;id&q;:34159,&q;userId&q;:51375692,&q;name&q;:&q;关青&q;,&q;brief&q;:&q;粉笔优质讲师&q;,&q;desc&q;:&q;粉笔优质教师\n5年一线教学授课经验 \n具有综应科目丰富的实践经验及系统扎实的专业理论知识 \n撰写多篇事业单位笔试教研材料，在粉笔面试教师内部进行共享；\n多次参加粉笔授课研讨会议，全面把握公考面试命题趋势及最新考情，积累丰富面试知识编写 \n授课幽默诙谐、形象生动、条理清晰、思维跳跃。&q;,&q;avatar&q;:&q;178a6013c1b8139.jpg&q;,&q;upperBodyPhoto&q;:null,&q;displayCoursePrefix&q;:&q;sydw&q;,&q;teacherStat&q;:{&q;teacherId&q;:34159,&q;episodeCount&q;:277,&q;scoreCount&q;:362,&q;avgScore&q;:9.878453038674042,&q;fiveGradeAvgScore&q;:4.94,&q;updateTime&q;:1773538390223},&q;auditionEpisode&q;:{&q;episodeTitle&q;:&q;个人展示课&q;,&q;episodeVideoUrl&q;:&q;https://vod.fbstatic.cn/22e9ceb2vodbj1251001446/8934c63e5145403707945023437/EjROdmA4yN4A.mp4?t=f2a4b300&a;us=4070880000&a;sign=e3cdbee186b8a8ed64d03151cfbe033a&q;},&q;memberOfCPC&q;:false,&q;tags&q;:null},{&q;id&q;:16891,&q;userId&q;:68668145,&q;name&q;:&q;闫思辰&q;,&q;brief&q;:&q;粉笔优质讲师&q;,&q;desc&q;:&q;粉笔优质讲师\n6年线上线下授课经验，理论功底扎实——深度参与粉笔教研、内部培训，常分享授课心得；对考情、出题规律、命题套路有精准把控；\n授课风格逻辑清晰、严谨又亲和：既能营造轻松课堂氛围，让学员“听得进、愿意听”；更擅长化繁为简，结合学员特点因材施教，高效提升备考效率与成绩。\n累计授课评分4.9分，是学员公认的“提分好帮手”。&q;,&q;avatar&q;:&q;1983ba13ad3d06d.jpg&q;,&q;upperBodyPhoto&q;:null,&q;displayCoursePrefix&q;:&q;sydw&q;,&q;teacherStat&q;:{&q;teacherId&q;:16891,&q;episodeCount&q;:461,&q;scoreCount&q;:1771,&q;avgScore&q;:9.731225296442677,&q;fiveGradeAvgScore&q;:4.87,&q;updateTime&q;:1773582810652},&q;auditionEpisode&q;:null,&q;memberOfCPC&q;:false,&q;tags&q;:null},{&q;id&q;:34141,&q;userId&q;:67002168,&q;name&q;:&q;温东升&q;,&q;brief&q;:&q;粉笔优质讲师&q;,&q;desc&q;:&q;粉笔优质教师\n6年以上一线授课经验。带班学生10000+；熟悉国考、省考、事业单位考情，参与四川、山东、甘肃等省考情分析；长期扎根于公考、省考、事业单位教学教研工作，参与粉笔题库真题、模拟题解析编撰工作，时政文件解析工作，参与全国常识公基非法密卷课件及教案制作，农业农村书籍编撰工作。长期担任常识公基、判断课程主讲。课堂氛围轻松幽默，寓教于乐，能够结合当下时政，灵活运用到实际讲解之中，逻辑思维性强，善于沟通，能够迅速帮助考生进行全方位提升。&q;,&q;avatar&q;:&q;19841271adb989c.jpg&q;,&q;upperBodyPhoto&q;:null,&q;displayCoursePrefix&q;:&q;sydw&q;,&q;teacherStat&q;:{&q;teacherId&q;:34141,&q;episodeCount&q;:708,&q;scoreCount&q;:1467,&q;avgScore&q;:9.745057941376977,&q;fiveGradeAvgScore&q;:4.87,&q;updateTime&q;:1773480813169},&q;auditionEpisode&q;:{&q;episodeTitle&q;:&q;个人展示课&q;,&q;episodeVideoUrl&q;:&q;https://vod.fbstatic.cn/22e9ceb2vodbj1251001446/7b5794655145403710132043113/2OaZlykd0yAA.mp4?t=f2a4b300&a;us=4070880000&a;sign=63dc74bcedbc74171e790ef405ff495e&q;},&q;memberOfCPC&q;:false,&q;tags&q;:null},{&q;id&q;:45130,&q;userId&q;:64426039,&q;name&q;:&q;张翊&q;,&q;brief&q;:&q;粉笔优质讲师&q;,&q;desc&q;:&q;粉笔优质教师\n9年一线教学授课经验\n具有数资科目丰富的实践经验及系统扎实的专业理论知识\n对事业单位、公务员等笔试考情了解透彻\n参与命制笔试教研，包括模拟题出题及真题解析与改编，一线授课时长数千小时，对数资方向有深入研究；\n对与事业单位、公考笔试理科教研，其中包括国、省考系统精讲、刷题及冲刺讲义的制作及审核，事业单位精讲、刷题、冲刺等讲义的制作及审核，各类考试模拟题的审核及出题；\n多次参加粉笔提升培训及授课研讨会议，准确把握事业单位、公考命题趋势及最新考情，积累丰富笔试知识； \n学生口碑：具有幽默诙谐的授课风格，让学生在轻松的学习氛围中，用更简单的方法，找到更快捷的解题之道，深受广大学员的认可和好评；在学员中具有非常好的口碑，是值得信赖的好导师。&q;,&q;avatar&q;:&q;1983a4d32383c95.jpg&q;,&q;upperBodyPhoto&q;:null,&q;displayCoursePrefix&q;:&q;sydw&q;,&q;teacherStat&q;:{&q;teacherId&q;:45130,&q;episodeCount&q;:1014,&q;scoreCount&q;:1889,&q;avgScore&q;:9.725780836421372,&q;fiveGradeAvgScore&q;:4.86,&q;updateTime&q;:1773051667286},&q;auditionEpisode&q;:{&q;episodeTitle&q;:&q;个人展示课&q;,&q;episodeVideoUrl&q;:&q;https://vod.fbstatic.cn/22e9ceb2vodbj1251001446/99aaad101397757890164256731/ktHzkvJoR0EA.mp4?t=f2a4b300&a;us=4070880000&a;sign=40c9a29fcd4996c26d44b3299ab61713&q;},&q;memberOfCPC&q;:false,&q;tags&q;:null},{&q;id&q;:14565,&q;userId&q;:48370970,&q;name&q;:&q;王清悦&q;,&q;brief&q;:&q;粉笔优质讲师&q;,&q;desc&q;:&q;粉笔优质讲师\n8年一线教学经验，教学风格严谨而不失活泼，善于将复杂的知识点以生动有趣的方式呈现，让学生轻松掌握。对于考试考点有着敏锐的洞察力和精准的把握能力，帮助学生有效备考，事半功倍。我坚信，教育不仅仅是知识的传授，更是思维的启迪与人格的塑造，因此，始终致力于培养学生的独立思考能力与解决问题的能力，助力他们在人生的每一个阶段都能自信前行。&q;,&q;avatar&q;:&q;173d720cea24b6c.jpg&q;,&q;upperBodyPhoto&q;:null,&q;displayCoursePrefix&q;:&q;sydw&q;,&q;teacherStat&q;:{&q;teacherId&q;:14565,&q;episodeCount&q;:477,&q;scoreCount&q;:1439,&q;avgScore&q;:9.745656706045871,&q;fiveGradeAvgScore&q;:4.87,&q;updateTime&q;:1773559873082},&q;auditionEpisode&q;:{&q;episodeTitle&q;:&q;个人展示课&q;,&q;episodeVideoUrl&q;:&q;https://vod.fbstatic.cn/22e9ceb2vodbj1251001446/cbd1293d5145403707742801437/WSGdVtt1L3AA.mp4?t=f2a4b300&a;us=4070880000&a;sign=a446564dcadd70a9b99e6d27e1f0ecde&q;},&q;memberOfCPC&q;:false,&q;tags&q;:null},{&q;id&q;:53299,&q;userId&q;:74949917,&q;name&q;:&q;谭双艳&q;,&q;brief&q;:&q;粉笔优质讲师&q;,&q;desc&q;:&q;粉笔优质教师\n5年一线教学授课经验，具有言语科目丰富的实践经验以及系统扎实的的专业理论知识研究。授课逻辑清晰，教学过程耐心细致。课堂注重多角度解答问题，对言语各类知识均有细致的研究。多次参与真题解析、出具模拟题、真题录制、教学教研等多项专业工作。整体授课风格轻松幽默，帮助学员快速掌握做题技巧，获得学员一致好评。&q;,&q;avatar&q;:&q;17f8b66017fc8f3.jpg&q;,&q;upperBodyPhoto&q;:null,&q;displayCoursePrefix&q;:&q;sydw&q;,&q;teacherStat&q;:{&q;teacherId&q;:53299,&q;episodeCount&q;:417,&q;scoreCount&q;:991,&q;avgScore&q;:9.773965691220996,&q;fiveGradeAvgScore&q;:4.89,&q;updateTime&q;:1773540926444},&q;auditionEpisode&q;:{&q;episodeTitle&q;:&q;个人展示课&q;,&q;episodeVideoUrl&q;:&q;https://vod.fbstatic.cn/22e9ceb2vodbj1251001446/182852a05145403709308556163/kRnCUqYoxM4A.mp4?t=f2a4b300&a;us=4070880000&a;sign=4db1b0f971b8cacfe8e4004ba2017ed5&q;},&q;memberOfCPC&q;:false,&q;tags&q;:null},{&q;id&q;:17145,&q;userId&q;:71659515,&q;name&q;:&q;秦婷&q;,&q;brief&q;:&q;粉笔优质讲师&q;,&q;desc&q;:&q;粉笔优质讲师\n投身教育事业8年,拥有一线教学经验。在综合应用能力(综应)科目教学中,积累大量实用经验专业理论知识扎实。对各省份考情深入钻研,精准把握各地考试要点与命题方向。凭借深厚专业素养,对模拟题方向有深刻见解。积累海量笔试知识，多次参加粉笔教研活动，积极分享经验心得，助力粉笔理论研发持续升级。授课风格独具魅力,善于营造轻松愉悦的学习氛围,让学生用简洁高效方法找到解题捷径,站在学员角度思考问题，深受学员高度认可。&q;,&q;avatar&q;:&q;1758d19cea978b7.jpg&q;,&q;upperBodyPhoto&q;:null,&q;displayCoursePrefix&q;:&q;sydw&q;,&q;teacherStat&q;:{&q;teacherId&q;:17145,&q;episodeCount&q;:266,&q;scoreCount&q;:1048,&q;avgScore&q;:9.769083969465646,&q;fiveGradeAvgScore&q;:4.88,&q;updateTime&q;:1772885260482},&q;auditionEpisode&q;:{&q;episodeTitle&q;:&q;个人展示课&q;,&q;episodeVideoUrl&q;:&q;https://vod.fbstatic.cn/22e9ceb2vodbj1251001446/2b41d0245145403718222395387/e2j9RoEnSuAA.mp4?t=f2a4b300&a;us=4070880000&a;sign=249a5b16a96897b6b53883dcad4caf81&q;},&q;memberOfCPC&q;:false,&q;tags&q;:null},{&q;id&q;:56387,&q;userId&q;:95238878,&q;name&q;:&q;唐可乐&q;,&q;brief&q;:&q;粉笔优质讲师&q;,&q;desc&q;:&q;粉笔优质教师\n6年一线教学经验，具有判断科目丰富的实践经验以及系统扎实的专业理论知识，对事业单位的考情深入研究，多次参与粉笔组织的各类授课能研讨会议和面试教研活动，共同助力粉笔笔试理论的研发与升级，授课风格幽默风趣，耐心解答学生问题，让学生在轻松的学习氛围中，用更简单的方法，找到更快捷的解题之道，深受广大学员的认可和好评。&q;,&q;avatar&q;:&q;1841838ea98e147.jpg&q;,&q;upperBodyPhoto&q;:null,&q;displayCoursePrefix&q;:&q;sydw&q;,&q;teacherStat&q;:{&q;teacherId&q;:56387,&q;episodeCount&q;:244,&q;scoreCount&q;:751,&q;avgScore&q;:9.797603195739004,&q;fiveGradeAvgScore&q;:4.9,&q;updateTime&q;:1773581000733},&q;auditionEpisode&q;:{&q;episodeTitle&q;:&q;个人展示课&q;,&q;episodeVideoUrl&q;:&q;https://vod.fbstatic.cn/22e9ceb2vodbj1251001446/8342d7ee1397757912785015921/dmPKNp90hJgA.mp4?t=f2a4b300&a;us=4070880000&a;sign=c7fe6933f00b336b152ad7e6dc41eff8&q;},&q;memberOfCPC&q;:false,&q;tags&q;:null},{&q;id&q;:16940,&q;userId&q;:73888389,&q;name&q;:&q;周晓英&q;,&q;brief&q;:&q;粉笔优质讲师&q;,&q;desc&q;:&q;粉笔优质教师\n6年一线教学授课经验，累计授课时长1000+小时，授课人数20000+，10000+人次累计评分4.9，具有判断推理科目丰富的实践经验和系统扎实的专业理论。多次参与江苏、浙江等地判断推理的考情撰写，长期参与系统班和精品班的教研工作，2021-2024年进行精品班课程的讲义制作与修订，撰写教研文章20余篇，为模考大赛等累计出题200+道。授课风格形象生动、条理清晰，擅于从学员角度思考，帮助学员突破科目重难考点，让学生在轻松的学习氛围中，用更简单的方法，找到更快捷的解题之道，深受广大学员的认可和好评。&q;,&q;avatar&q;:&q;198411a7c789ded.jpg&q;,&q;upperBodyPhoto&q;:null,&q;displayCoursePrefix&q;:&q;sydw&q;,&q;teacherStat&q;:{&q;teacherId&q;:16940,&q;episodeCount&q;:581,&q;scoreCount&q;:2248,&q;avgScore&q;:9.711743772241979,&q;fiveGradeAvgScore&q;:4.86,&q;updateTime&q;:1773552283828},&q;auditionEpisode&q;:{&q;episodeTitle&q;:&q;个人展示课&q;,&q;episodeVideoUrl&q;:&q;https://vod.fbstatic.cn/22e9ceb2vodbj1251001446/fa3033da5145403715605102983/v52FMFBfuysA.mp4?t=f2a4b300&a;us=4070880000&a;sign=4762cae37a00902e1eaae792a9dd93cd&q;},&q;memberOfCPC&q;:false,&q;tags&q;:null},{&q;id&q;:26278,&q;userId&q;:61736380,&q;name&q;:&q;江丽贤&q;,&q;brief&q;:&q;粉笔优质讲师&q;,&q;desc&q;:&q;粉笔优质教师\n5年一线教学经验，深耕事业单位笔试考试，承担线上精品班、系统班等多种班型，具有综应科目丰富的实践经验及系统扎实的专业理论知识。\n不断更新知识，注重笔试理论知识丰富，多次参与笔试真题教研，对联考ABC以及非联考地区如山东、江苏等地区的命题有深入研究，时刻把握最新考情动态。\n累计带班人数超过2200人，学员整体评分维持在4.9左右，累计授课超900小时，授课评分高达4.9，授课思路清晰，课堂互动性佳，授课内容深入浅出，善于引导学生自主思考，发现学生问题给出针对性建议。&q;,&q;avatar&q;:&q;1983b170cb4f625.jpg&q;,&q;upperBodyPhoto&q;:null,&q;displayCoursePrefix&q;:&q;sydw&q;,&q;teacherStat&q;:{&q;teacherId&q;:26278,&q;episodeCount&q;:288,&q;scoreCount&q;:356,&q;avgScore&q;:9.870786516853938,&q;fiveGradeAvgScore&q;:4.94,&q;updateTime&q;:1773475358078},&q;auditionEpisode&q;:{&q;episodeTitle&q;:&q;个人展示课&q;,&q;episodeVideoUrl&q;:&q;https://vod.fbstatic.cn/22e9ceb2vodbj1251001446/2e926e765145403709543400209/83QW9fZvl34A.mp4?t=f2a4b300&a;us=4070880000&a;sign=c5368d9fae65069fb3bc52cdfc8bc20a&q;},&q;memberOfCPC&q;:false,&q;tags&q;:null},{&q;id&q;:52949,&q;userId&q;:80481411,&q;name&q;:&q;王臻瑶&q;,&q;brief&q;:&q;粉笔优质讲师&q;,&q;desc&q;:&q;粉笔优质讲师\n211高校毕业，6年一线教学、教研经验，线上线下授课人数千余人，累计授课时长3000+。\n对于言语理解与表达科目有丰富的实践经验及系统扎实的专业理论知识。\n亲和力强，注重与学员的互动和交流，对各省份考情熟悉，注重理论与实践相结合，引导学员发现问题，帮助学员高分上岸，深受学员喜爱。\n教学风格注重条理性和逻辑性，善于通过生动的例子，帮助学员深入理解题目背后的逻辑关系和解题技巧。&q;,&q;avatar&q;:&q;1945f3b6384d792.jpg&q;,&q;upperBodyPhoto&q;:null,&q;displayCoursePrefix&q;:&q;sydw&q;,&q;teacherStat&q;:{&q;teacherId&q;:52949,&q;episodeCount&q;:342,&q;scoreCount&q;:1475,&q;avgScore&q;:9.738305084745754,&q;fiveGradeAvgScore&q;:4.87,&q;updateTime&q;:1773588704179},&q;auditionEpisode&q;:{&q;episodeTitle&q;:&q;个人展示课&q;,&q;episodeVideoUrl&q;:&q;https://nodestatic.fbstatic.cn/video_qhd/1714474745775.mp4&q;},&q;memberOfCPC&q;:false,&q;tags&q;:null},{&q;id&q;:33486,&q;userId&q;:52618928,&q;name&q;:&q;艾思莹&q;,&q;brief&q;:&q;粉笔优质讲师&q;,&q;desc&q;:&q;粉笔优质讲师\n6年一线教学经验，辅导学员数千人，累计授课评分4.9分，承接各类型线上线下精品班，深耕事业单位笔试，善于以考场思维审视题目，助力多位学员高分上岸。\n长期参与内部教研工作，定期参与真题解析录制，对最新命题方向、考试重点有深入研究。\n理论基础扎实，授课思路清晰，擅长理论与实际相结合。能够激发学员学习热情和自主意识，让学员可以在轻松愉快的氛围中学习，跟着老师节奏主动思考，深受学员一致好评和喜爱。&q;,&q;avatar&q;:&q;1798d8fc9d33bea.jpg&q;,&q;upperBodyPhoto&q;:null,&q;displayCoursePrefix&q;:&q;sydw&q;,&q;teacherStat&q;:{&q;teacherId&q;:33486,&q;episodeCount&q;:408,&q;scoreCount&q;:460,&q;avgScore&q;:9.839130434782604,&q;fiveGradeAvgScore&q;:4.92,&q;updateTime&q;:1773623079529},&q;auditionEpisode&q;:{&q;episodeTitle&q;:&q;社会现象&q;,&q;episodeVideoUrl&q;:&q;https://vod.fbstatic.cn/22e9ceb2vodbj1251001446/76dd9c915145403709537492897/eQAVoEQ87mAA.mp4?t=f2a4b300&a;us=4070880000&a;sign=ef57ee8d5c8eca5e1bcee39dbc785fe4&q;},&q;memberOfCPC&q;:false,&q;tags&q;:null},{&q;id&q;:16571,&q;userId&q;:68761675,&q;name&q;:&q;严月&q;,&q;brief&q;:&q;粉笔优质讲师&q;,&q;desc&q;:&q;粉笔优质讲师\n六年一线教学授课经验，深入了解地区考情，理论知识扎实，授课与实战经验丰富，熟悉考场答题思维及应变技巧。多次参加粉笔教研活动，分享授课经验心得，助力粉笔理论研发升级。能够从学员角度出发，耐心细致，条理清晰，以帮助学员上岸为己任，深受学员喜爱。&q;,&q;avatar&q;:&q;1985521b0d3aabd.jpg&q;,&q;upperBodyPhoto&q;:null,&q;displayCoursePrefix&q;:&q;sydw&q;,&q;teacherStat&q;:{&q;teacherId&q;:16571,&q;episodeCount&q;:422,&q;scoreCount&q;:1222,&q;avgScore&q;:9.749590834697225,&q;fiveGradeAvgScore&q;:4.87,&q;updateTime&q;:1773497598415},&q;auditionEpisode&q;:{&q;episodeTitle&q;:&q;个人展示课&q;,&q;episodeVideoUrl&q;:&q;https://vod.fbstatic.cn/22e9ceb2vodbj1251001446/49118c181253642696336994975/wwjaigalGDUA.mp4?t=f2a4b300&a;us=4070880000&a;sign=dd1690706078bf2cc49e86a072c4cc90&q;},&q;memberOfCPC&q;:false,&q;tags&q;:null},{&q;id&q;:35903,&q;userId&q;:72269679,&q;name&q;:&q;曲源&q;,&q;brief&q;:&q;粉笔优质讲师&q;,&q;desc&q;:&q;粉笔优质讲师\n6年一线教学经验，累计服务学员近千人，累计评分4.9分，承担过线上和线下系统班、冲刺班、刷题班等多种班型，累计授课时长超1200小时。\n笔试授课和教研经验丰富。长期参与综应真题教研与撰写答案解析工作，对最新命题方向具有深入研究，具备丰富的知识储备，理论功底扎实。\n授课思路清晰善于调动课堂氛围,幽默风趣，激发学员学习兴趣。同时,具有较强研发能力和责任心，坚持课上精准指导，课后心理疏导，因材施教，深受学员喜爱。&q;,&q;avatar&q;:&q;193cd4344de169d.jpg&q;,&q;upperBodyPhoto&q;:null,&q;displayCoursePrefix&q;:&q;sydw&q;,&q;teacherStat&q;:{&q;teacherId&q;:35903,&q;episodeCount&q;:311,&q;scoreCount&q;:744,&q;avgScore&q;:9.78494623655914,&q;fiveGradeAvgScore&q;:4.89,&q;updateTime&q;:1773577783468},&q;auditionEpisode&q;:{&q;episodeTitle&q;:&q;个人展示课&q;,&q;episodeVideoUrl&q;:&q;https://vod.fbstatic.cn/22e9ceb2vodbj1251001446/72602ee15145403709544027961/PagTAbrHihoA.mp4?t=f2a4b300&a;us=4070880000&a;sign=d64222f31d058dfe1c94af887873312d&q;},&q;memberOfCPC&q;:false,&q;tags&q;:null},{&q;id&q;:16555,&q;userId&q;:73245747,&q;name&q;:&q;周俐&q;,&q;brief&q;:&q;粉笔优质讲师&q;,&q;desc&q;:&q;粉笔优质讲师\n五年半一线教学授课及带班经验，深耕事业单位言语考试，承担过安徽、四川、江苏、浙江、陕西、福建、河北、湖北、内蒙等地以及全国联考、军队文职等线上笔试精品班、刷题班、冲刺班等多种班型，累计带班级数60+授课及带班经验丰富。在言语理解与表达科目教研工作中，多次参与真题解析的撰写、解析的终审工作、模拟题命制、单题录制以及言语考情分析文件撰写等工作，面了解事业单位言语考试近年来命题规律、重难点及不同类型题目答题技巧，教研教学基础扎实。授课条理清晰，考点突出，注重理论知识点与技巧并用，经验丰富，亲和生动，学员好评度高。&q;,&q;avatar&q;:&q;198551c014a41f3.jpg&q;,&q;upperBodyPhoto&q;:null,&q;displayCoursePrefix&q;:&q;sydw&q;,&q;teacherStat&q;:{&q;teacherId&q;:16555,&q;episodeCount&q;:530,&q;scoreCount&q;:2177,&q;avgScore&q;:9.700505282498847,&q;fiveGradeAvgScore&q;:4.85,&q;updateTime&q;:1773613829705},&q;auditionEpisode&q;:{&q;episodeTitle&q;:&q;个人展示课&q;,&q;episodeVideoUrl&q;:&q;https://vod.fbstatic.cn/22e9ceb2vodbj1251001446/db6f1af21253642695732607997/uneyCgdRfuQA.mp4?t=f2a4b300&a;us=4070880000&a;sign=62a7a37a62d4578410dcec90c07ea1ce&q;},&q;memberOfCPC&q;:false,&q;tags&q;:null},{&q;id&q;:64430,&q;userId&q;:136519339,&q;name&q;:&q;张雨星&q;,&q;brief&q;:&q;粉笔优质讲师&q;,&q;desc&q;:&q;粉笔优质教师\n长期从事公考一线教学，具有判断科目丰富的实践经验及系统扎实的专业理论知识，多次参加粉笔授课研讨会议，全面把握公考判断科目趋势及最新考情。 对判断科目有独到的见解，深度解剖知识点，擅长将复杂的判断知识点用通俗易懂的语言讲解，从而化解学员心中的谜团，让学员豁然开朗，全面吸收重点知识，增长自信心，在考场上从容自如。&q;,&q;avatar&q;:&q;193af918ace06f9.jpg&q;,&q;upperBodyPhoto&q;:null,&q;displayCoursePrefix&q;:&q;sydw&q;,&q;teacherStat&q;:{&q;teacherId&q;:64430,&q;episodeCount&q;:245,&q;scoreCount&q;:627,&q;avgScore&q;:9.799043062200955,&q;fiveGradeAvgScore&q;:4.9,&q;updateTime&q;:1773558667592},&q;auditionEpisode&q;:{&q;episodeTitle&q;:&q;个人展示课&q;,&q;episodeVideoUrl&q;:&q;https://vod.fbstatic.cn/22e9ceb2vodbj1251001446/dd034cbe5145403709542216483/M9ba77bUylwA.mp4?t=f2a4b300&a;us=4070880000&a;sign=acce949c38e0c790835300ba625a4e10&q;},&q;memberOfCPC&q;:false,&q;tags&q;:null},{&q;id&q;:16776,&q;userId&q;:73198283,&q;name&q;:&q;王媮&q;,&q;brief&q;:&q;粉笔优质讲师&q;,&q;desc&q;:&q;粉笔优质讲师\n6年一线教学经验，拥有丰富的线上授课经验。\n在常识公基非法、言语两科目教学方面，负责授课、课程教研、模拟题命制等工作，同时承担常识公基非法和言语两科目的线上公开课，以及线上直播课等工作。积累丰富笔试理论知识\n善于整合梳理琐碎理论，授课方式轻松、逻辑清晰，针对性强，能够帮助学员快速掌握考试内容，高效应对考试。&q;,&q;avatar&q;:&q;1746c4a0d51bc94.jpg&q;,&q;upperBodyPhoto&q;:null,&q;displayCoursePrefix&q;:&q;sydw&q;,&q;teacherStat&q;:{&q;teacherId&q;:16776,&q;episodeCount&q;:729,&q;scoreCount&q;:1165,&q;avgScore&q;:9.744206008583687,&q;fiveGradeAvgScore&q;:4.87,&q;updateTime&q;:1773582489052},&q;auditionEpisode&q;:{&q;episodeTitle&q;:&q;个人展示课&q;,&q;episodeVideoUrl&q;:&q;https://vod.fbstatic.cn/22e9ceb2vodbj1251001446/71e3e6f01397757888015316660/Ot6GS9zAJqIA.mp4?t=f2a4b300&a;us=4070880000&a;sign=c773fc7f8cdd4f955379e6633bd2508a&q;},&q;memberOfCPC&q;:false,&q;tags&q;:null},{&q;id&q;:16833,&q;userId&q;:57723890,&q;name&q;:&q;李珍芳&q;,&q;brief&q;:&q;粉笔优质讲师&q;,&q;desc&q;:&q;粉笔优质教师\n7年以上公考教学经验，授课经验丰富，线上累计授课时长1000+，授课人次3000+，授课累计评分4.9。多次参与全国事业单位综应考情以及热点梳理，熟悉事业单位联考综应ABC考情、命题特点和答题技巧。擅长联考、山东、江苏、浙江等地事业单位以及三支一扶的综应课程，并参与综应各大题型人工批改服务上千份，了解学员作答综应的难点、痛点，能精准定位学员薄弱点，对综应有独到的见解。授课思路清晰，逻辑严谨，操作性强，擅长因材施教，在学员中具有非常好的口碑，是值得信赖的好老师。&q;,&q;avatar&q;:&q;19841215f64df6f.jpg&q;,&q;upperBodyPhoto&q;:null,&q;displayCoursePrefix&q;:&q;sydw&q;,&q;teacherStat&q;:{&q;teacherId&q;:16833,&q;episodeCount&q;:409,&q;scoreCount&q;:405,&q;avgScore&q;:9.841975308641969,&q;fiveGradeAvgScore&q;:4.92,&q;updateTime&q;:1773052091382},&q;auditionEpisode&q;:{&q;episodeTitle&q;:&q;个人展示课&q;,&q;episodeVideoUrl&q;:&q;https://vod.fbstatic.cn/22e9ceb2vodbj1251001446/7a0a71cb5145403709466476960/iuy2CLkvs8gA.mp4?t=f2a4b300&a;us=4070880000&a;sign=9b6fa00b91c85f610da0b5f435be8997&q;},&q;memberOfCPC&q;:false,&q;tags&q;:null},{&q;id&q;:16606,&q;userId&q;:72504959,&q;name&q;:&q;田文慧&q;,&q;brief&q;:&q;粉笔优质讲师&q;,&q;desc&q;:&q;粉笔优质教师\n五年一线教学授课经验，对事业单位言语考情深入研究，取得考情分析以及真题解析教研成果，线上班级学员进面率在粉笔受到过教学表彰。具有耐心细致，条理清晰的授课风格，让学生在轻松的学习氛围中，用更简单的方法，找到更快捷的解题之道，深受广大学员的认可和好评。&q;,&q;avatar&q;:&q;174683219f2607b.jpg&q;,&q;upperBodyPhoto&q;:null,&q;displayCoursePrefix&q;:&q;sydw&q;,&q;teacherStat&q;:{&q;teacherId&q;:16606,&q;episodeCount&q;:366,&q;scoreCount&q;:1194,&q;avgScore&q;:9.73869346733668,&q;fiveGradeAvgScore&q;:4.87,&q;updateTime&q;:1773369087008},&q;auditionEpisode&q;:{&q;episodeTitle&q;:&q;个人展示课&q;,&q;episodeVideoUrl&q;:&q;https://vod.fbstatic.cn/22e9ceb2vodbj1251001446/2f9c832a1253642695693026547/50GavMWfNWMA.mp4?t=f2a4b300&a;us=4070880000&a;sign=7aff6adf6cedcf12abc57145610c6068&q;},&q;memberOfCPC&q;:false,&q;tags&q;:null},{&q;id&q;:17154,&q;userId&q;:51458062,&q;name&q;:&q;赵雪涵&q;,&q;brief&q;:&q;粉笔优质讲师&q;,&q;desc&q;:&q;粉笔常识公基优质教师\n     6年一线教学授课经验，具有常识公基考试扎实的专业理论知识，耐心细致，理论功底扎实，授课思路清晰，让学生在轻松的学习氛围中，用更简单的方法，找到更快捷的解题之道。善于从学员角度出发解决个性化问题，激发学员学习热情和自主意识，课堂互动性强，深受广大学员的认可和好评。&q;,&q;avatar&q;:&q;1983b59bf2e07dd.jpg&q;,&q;upperBodyPhoto&q;:null,&q;displayCoursePrefix&q;:&q;sydw&q;,&q;teacherStat&q;:{&q;teacherId&q;:17154,&q;episodeCount&q;:733,&q;scoreCount&q;:1519,&q;avgScore&q;:9.71955233706385,&q;fiveGradeAvgScore&q;:4.86,&q;updateTime&q;:1773302238029},&q;auditionEpisode&q;:{&q;episodeTitle&q;:&q;个人展示课&q;,&q;episodeVideoUrl&q;:&q;https://vod.fbstatic.cn/22e9ceb2vodbj1251001446/40756ab31397757888011438770/IB4CB1Y4WYIA.mp4?t=f2a4b300&a;us=4070880000&a;sign=7e40b7ab849e8cfe7d9117e84eb2a609&q;},&q;memberOfCPC&q;:false,&q;tags&q;:null},{&q;id&q;:33438,&q;userId&q;:51475986,&q;name&q;:&q;白景明&q;,&q;brief&q;:&q;粉笔优质讲师&q;,&q;desc&q;:&q;粉笔常识公基优质教师\n      5年一线授课经验，具有事业单位考试丰富的实践经验及系统扎实的专业理论知识。个性热情开朗，善于营造积极向上、充满活力的课堂氛围。始终保持耐心细致的态度，无论是对基础知识的讲解还是针对复杂题型的解析，都能深入浅出，确保每位学员都能跟上节奏，消化吸收。授课逻辑严密，内容条理，思路清晰明了，帮助学员构建起坚实的知识框架，深受学员好评。&q;,&q;avatar&q;:&q;1965cdb4f4e6ff3.jpg&q;,&q;upperBodyPhoto&q;:null,&q;displayCoursePrefix&q;:&q;sydw&q;,&q;teacherStat&q;:{&q;teacherId&q;:33438,&q;episodeCount&q;:629,&q;scoreCount&q;:1064,&q;avgScore&q;:9.744360902255647,&q;fiveGradeAvgScore&q;:4.87,&q;updateTime&q;:1773306736144},&q;auditionEpisode&q;:{&q;episodeTitle&q;:&q;个人展示课&q;,&q;episodeVideoUrl&q;:&q;https://vod.fbstatic.cn/22e9ceb2vodbj1251001446/5a2fa8c05145403707364076346/qCxnz3H1QbYA.mp4?t=f2a4b300&a;us=4070880000&a;sign=69c46a19011c3aeb0a079e1e2363c676&q;},&q;memberOfCPC&q;:false,&q;tags&q;:null},{&q;id&q;:16967,&q;userId&q;:73695412,&q;name&q;:&q;周雯&q;,&q;brief&q;:&q;粉笔优质讲师&q;,&q;desc&q;:&q;粉笔优质教师\n六年事考、公考教学经验，累计授课时长1000+，授课经验丰富，教研教学扎实，全面了解事业单位综合应用能力考试的命题规律及答题技巧，授课重点突出，能及时总结拓展，讲解语言通俗易懂。课堂氛围轻松活跃，擅长引导学生自主思考，能够在课堂互动中发现学员的问题并给出针对性的解决措施，对待学生认真负责、有耐心，深受学生喜爱。&q;,&q;avatar&q;:&q;17549fe18ee3d2f.jpg&q;,&q;upperBodyPhoto&q;:null,&q;displayCoursePrefix&q;:&q;sydw&q;,&q;teacherStat&q;:{&q;teacherId&q;:16967,&q;episodeCount&q;:453,&q;scoreCount&q;:481,&q;avgScore&q;:9.817047817047817,&q;fiveGradeAvgScore&q;:4.91,&q;updateTime&q;:1773103543649},&q;auditionEpisode&q;:null,&q;memberOfCPC&q;:false,&q;tags&q;:null},{&q;id&q;:16637,&q;userId&q;:73362780,&q;name&q;:&q;施孙芳&q;,&q;brief&q;:&q;粉笔优质讲师&q;,&q;desc&q;:&q;粉笔常识公基优质讲师。\n6年一线教学授课经验。具有常识公基科目丰富的实践经验及系统扎实的专业理论知识。多次参加粉笔授课研讨会议，全面把握常识公基考试命题趋势及最新考情，积累丰富笔试知识。具有幽默的授课风格，让学生在轻松的学习氛围中，用更简单的方法，找到更快捷的解题之道，深受广大学员的认可和好评，是值得信赖的好导师。&q;,&q;avatar&q;:&q;1746b726467e4a2.jpg&q;,&q;upperBodyPhoto&q;:null,&q;displayCoursePrefix&q;:&q;sydw&q;,&q;teacherStat&q;:{&q;teacherId&q;:16637,&q;episodeCount&q;:893,&q;scoreCount&q;:3281,&q;avgScore&q;:9.663517220359648,&q;fiveGradeAvgScore&q;:4.83,&q;updateTime&q;:1773547028739},&q;auditionEpisode&q;:{&q;episodeTitle&q;:&q;个人展示课&q;,&q;episodeVideoUrl&q;:&q;https://vod.fbstatic.cn/22e9ceb2vodbj1251001446/5a62805a5145403714882122093/LsABTK490BoA.mp4?t=f2a4b300&a;us=4070880000&a;sign=d987186e83731399b0f26511ecf8d802&q;},&q;memberOfCPC&q;:false,&q;tags&q;:null},{&q;id&q;:64135,&q;userId&q;:122612717,&q;name&q;:&q;付敏&q;,&q;brief&q;:&q;粉笔优质讲师&q;,&q;desc&q;:&q;粉笔优质讲师\n多年一线授课经验，线上线下累计授课时长超1000小时。多次参加粉笔授课教研会议，教研经验丰富，综应理论功底扎实，熟悉近年来考试命题特点及答题技巧。\n教学态度严谨，思路清晰，教学经验丰富，在生动有趣的课堂中帮助学员掌握解题的方法和技巧，培养学员的答题能力。&q;,&q;avatar&q;:&q;18e17d048b2637b.jpg&q;,&q;upperBodyPhoto&q;:null,&q;displayCoursePrefix&q;:&q;sydw&q;,&q;teacherStat&q;:{&q;teacherId&q;:64135,&q;episodeCount&q;:519,&q;scoreCount&q;:324,&q;avgScore&q;:9.85802469135803,&q;fiveGradeAvgScore&q;:4.93,&q;updateTime&q;:1773114084844},&q;auditionEpisode&q;:{&q;episodeTitle&q;:&q;个人展示课&q;,&q;episodeVideoUrl&q;:&q;https://vod.fbstatic.cn/22e9ceb2vodbj1251001446/d02947865145403709545790454/JWAr7oAuaAoA.mp4?t=f2a4b300&a;us=4070880000&a;sign=1670c66c74effc2f2a6b4cb44f0b9bc5&q;},&q;memberOfCPC&q;:false,&q;tags&q;:null},{&q;id&q;:38553,&q;userId&q;:68550168,&q;name&q;:&q;崔伟婷&q;,&q;brief&q;:&q;粉笔优质讲师&q;,&q;desc&q;:&q;粉笔优质教师\n多年深耕事业单位笔试，线上线下双轨授课，累计课时1500+，教学经验丰富。 精通综应、申论核心考点，兼具系统专业理论与实战教研经历，多次参与事业单位模拟题编写及解析打磨，对考情变化、命题规律理解深刻。 授课耐心细致、逻辑清晰，擅长结合实际场景拆解知识点，手把手引导学员将理论转化为答题能力，助力高效提分。&q;,&q;avatar&q;:&q;1983b8cd0938fc3.jpg&q;,&q;upperBodyPhoto&q;:null,&q;displayCoursePrefix&q;:&q;sydw&q;,&q;teacherStat&q;:{&q;teacherId&q;:38553,&q;episodeCount&q;:400,&q;scoreCount&q;:1897,&q;avgScore&q;:9.697416974169741,&q;fiveGradeAvgScore&q;:4.85,&q;updateTime&q;:1773125884452},&q;auditionEpisode&q;:{&q;episodeTitle&q;:&q;个人展示课&q;,&q;episodeVideoUrl&q;:&q;https://vod.fbstatic.cn/22e9ceb2vodbj1251001446/30f743a05145403707591723084/YyjElD5VJdgA.mp4?t=f2a4b300&a;us=4070880000&a;sign=af88950ebae760259e0bd24565a6ad0a&q;},&q;memberOfCPC&q;:false,&q;tags&q;:null},{&q;id&q;:16894,&q;userId&q;:72656719,&q;name&q;:&q;代俊玲&q;,&q;brief&q;:&q;粉笔优质讲师&q;,&q;desc&q;:&q;粉笔优质讲师\n师范专业毕业，从事编制考试工作6年，拥有扎实的教学授课、答疑经验。\n6年带班中，一对一答疑解惑的学员2600+，深谙学员的备考心理、备考难点；因此无论在答疑还是在授课中都能快速清晰明了地解决学员的疑难点且给出有效的备考方法。\n备考不仅仅需要理论，还需要实际操作，平时喜欢研究考题，熟悉掌握全国大部分地区综应的考情和考题，积累了大量的做题的经验，做到和学员同频共振。\n累计授课时长7000+，授课通俗易懂；督学答疑打分达到5.0分，答疑具有启发性，坚持的理念就是“题目没有办法穷尽，但是我们可以用思维和技巧来覆盖”。&q;,&q;avatar&q;:&q;1746cbb834cec32.jpg&q;,&q;upperBodyPhoto&q;:null,&q;displayCoursePrefix&q;:&q;sydw&q;,&q;teacherStat&q;:{&q;teacherId&q;:16894,&q;episodeCount&q;:509,&q;scoreCount&q;:691,&q;avgScore&q;:9.777134587554272,&q;fiveGradeAvgScore&q;:4.89,&q;updateTime&q;:1773373967128},&q;auditionEpisode&q;:{&q;episodeTitle&q;:&q;个人展示课&q;,&q;episodeVideoUrl&q;:&q;https://vod.fbstatic.cn/22e9ceb2vodbj1251001446/cb018db65145403710133193708/w90mLpc9KUMA.mp4?t=f2a4b300&a;us=4070880000&a;sign=71534e640e22bf9148a2e806842810e0&q;},&q;memberOfCPC&q;:false,&q;tags&q;:null},{&q;id&q;:56432,&q;userId&q;:96015899,&q;name&q;:&q;李秋霖&q;,&q;brief&q;:&q;粉笔优质讲师&q;,&q;desc&q;:&q;粉笔优质教师\n4年一线教学授课经验，具有数资科目丰富的实践经验及系统扎实的专业理论知识。参与命制笔试教研，对资料分析方向有深入研究，并撰写多篇事业单位笔试教研材料，在粉笔笔试教师内部进行共享。多次参加粉笔教研活动，分享授课经验心得，助力粉笔理论研发升级。获得学员的多次好评，具有热情洋溢的授课风格，让学生在轻松的学习氛围中，用更简单的方法，找到更快捷的解题之道，深受广大学员的认可和好评。&q;,&q;avatar&q;:&q;18488bc569ccb4d.jpg&q;,&q;upperBodyPhoto&q;:null,&q;displayCoursePrefix&q;:&q;sydw&q;,&q;teacherStat&q;:{&q;teacherId&q;:56432,&q;episodeCount&q;:274,&q;scoreCount&q;:785,&q;avgScore&q;:9.76305732484077,&q;fiveGradeAvgScore&q;:4.88,&q;updateTime&q;:1773590328512},&q;auditionEpisode&q;:{&q;episodeTitle&q;:&q;个人展示课&q;,&q;episodeVideoUrl&q;:&q;https://vod.fbstatic.cn/22e9ceb2vodbj1251001446/160ff7b15145403709427487787/AMGHBIZnUaYA.mp4?t=f2a4b300&a;us=4070880000&a;sign=5bd04e214d72bef5a7d368b737db12f4&q;},&q;memberOfCPC&q;:false,&q;tags&q;:null},{&q;id&q;:64227,&q;userId&q;:84456101,&q;name&q;:&q;欧欧&q;,&q;brief&q;:&q;粉笔优质讲师&q;,&q;desc&q;:&q;粉笔优质讲师\n多年一线教学经验，实战经验丰富。全面深入研究笔试考情与真题，理论知识扎实，熟练掌握判断推理各板块题型解题技巧；撰写百余篇事业单位笔试教研材料，在粉笔教师内部进行共享。\n课堂整体氛围轻松，注重引导学员思考，善于用贴近生活的例子帮助理解，语言较为幽默且通俗易懂。始终将培养学员的逻辑思维和应试能力作为教学核心目标。思维严谨、条理清晰，无论是讲解复杂的知识点还是分析难题，都能做到有条不紊，让学员们一目了然，广受好评。&q;,&q;avatar&q;:&q;1945f34414f3266.jpg&q;,&q;upperBodyPhoto&q;:null,&q;displayCoursePrefix&q;:&q;sydw&q;,&q;teacherStat&q;:{&q;teacherId&q;:64227,&q;episodeCount&q;:627,&q;scoreCount&q;:978,&q;avgScore&q;:9.740286298568497,&q;fiveGradeAvgScore&q;:4.87,&q;updateTime&q;:1773309486141},&q;auditionEpisode&q;:{&q;episodeTitle&q;:&q;个人展示课&q;,&q;episodeVideoUrl&q;:&q;https://vod.fbstatic.cn/22e9ceb2vodbj1251001446/8264528e5145403709537974907/IRjfy5zDTB8A.mp4?t=f2a4b300&a;us=4070880000&a;sign=d0acdce8c2f6d4f5c6bebe8d78c3bfe1&q;},&q;memberOfCPC&q;:false,&q;tags&q;:null},{&q;id&q;:16608,&q;userId&q;:69120773,&q;name&q;:&q;熊超&q;,&q;brief&q;:&q;粉笔优质讲师&q;,&q;desc&q;:&q;粉笔优质教师\n1.6年一线教学授课经验，多年深耕事业单位考试，承担线上多种面试课程，授课经验丰富，逻辑清晰，擅长引导与拓展。\n2.具有丰富的实战经验，考场应试能力突出，专业理论知识系统扎实，对事业单位、军队文职等考情有深入研究:\n①多年参与面试题目真题教研和解析撰写、教研文章等的制作工作，全面了解事业单位考试近年来命题特点以及答题逻辑与技巧;\n②多次参加粉笔授课研讨会，针对面试题目进行深入探讨，多次分享答题经验及授课经验;\n3.学生口碑：风格独特，讲解幽默风趣，同时不失严谨，且擅长引导思考、深入浅出、举一反三、思维发散，以简单的方式激发学员学习热情，快速提高。&q;,&q;avatar&q;:&q;1746836fc090a43.jpg&q;,&q;upperBodyPhoto&q;:null,&q;displayCoursePrefix&q;:&q;sydw&q;,&q;teacherStat&q;:{&q;teacherId&q;:16608,&q;episodeCount&q;:501,&q;scoreCount&q;:2365,&q;avgScore&q;:9.671881606765316,&q;fiveGradeAvgScore&q;:4.84,&q;updateTime&q;:1773561581097},&q;auditionEpisode&q;:null,&q;memberOfCPC&q;:false,&q;tags&q;:null},{&q;id&q;:17075,&q;userId&q;:44061788,&q;name&q;:&q;余寅波&q;,&q;brief&q;:&q;粉笔优质讲师&q;,&q;desc&q;:&q;粉笔优质教师\n拥有长达六年的一线教学授课经验，专注深耕于事业单位考试领域。曾承担过笔试精品班、刷题班等多种班型的教学任务。\n在言语科目方面，理论功底极为扎实，对各类言语考点均进行了细致入微的研究与梳理。授课过程中，逻辑清晰明了，态度耐心负责，课堂上十分注重将知识点与真题紧密结合，助力学员迅速掌握做题技巧。\n参与笔试教研以及解析撰写工作，对最新命题趋势有着精准把握，还多次踊跃参加授课研讨会议，秉持注重考场思维的理念，针对学生在学习过程中产生的困惑深入研究教学策略。\n累计授课时长超过 2000 小时，累计评分高达 4.9 分。教学中注重采用启发式引导方式，致力于让学生在轻松愉悦的学习氛围中，探寻到更为快捷的解题之道，深受广大学员的认可与好评。坚信 “没有比人更高的山”，始终愿助力每一位学员翻越自身面临的那座高山。&q;,&q;avatar&q;:&q;17470c205d4814c.jpg&q;,&q;upperBodyPhoto&q;:null,&q;displayCoursePrefix&q;:&q;sydw&q;,&q;teacherStat&q;:{&q;teacherId&q;:17075,&q;episodeCount&q;:379,&q;scoreCount&q;:1504,&q;avgScore&q;:9.699468085106375,&q;fiveGradeAvgScore&q;:4.85,&q;updateTime&q;:1773571929826},&q;auditionEpisode&q;:null,&q;memberOfCPC&q;:false,&q;tags&q;:null},{&q;id&q;:34155,&q;userId&q;:71560696,&q;name&q;:&q;巩梦&q;,&q;brief&q;:&q;粉笔优质讲师&q;,&q;desc&q;:&q;粉笔优质教师\n5年一线教学授课经验，具有综应科目丰富的实践经验及系统扎实的专业理论知识。\n多次参加粉笔教研活动，分享授课经验心得，助力粉笔理论研发升级。\n具有耐心细致的授课风格，让学生在轻松的学习氛围中，用更简单的方法，找到更快捷的解题之道，深受广大学员的认可和好评，在学员中具有非常好的口碑，是值得信赖的好导师。&q;,&q;avatar&q;:&q;178a5fe93da6095.jpg&q;,&q;upperBodyPhoto&q;:null,&q;displayCoursePrefix&q;:&q;sydw&q;,&q;teacherStat&q;:{&q;teacherId&q;:34155,&q;episodeCount&q;:400,&q;scoreCount&q;:523,&q;avgScore&q;:9.789674952198864,&q;fiveGradeAvgScore&q;:4.89,&q;updateTime&q;:1773022083070},&q;auditionEpisode&q;:{&q;episodeTitle&q;:&q;个人展示课&q;,&q;episodeVideoUrl&q;:&q;https://vod.fbstatic.cn/22e9ceb2vodbj1251001446/a24a99a55145403709334290849/y0iTp4HJ8GkA.mp4?t=f2a4b300&a;us=4070880000&a;sign=aa5d046c3225db7891d3c4c81f7b7542&q;},&q;memberOfCPC&q;:false,&q;tags&q;:null},{&q;id&q;:61431,&q;userId&q;:97072356,&q;name&q;:&q;陈伶&q;,&q;brief&q;:&q;粉笔优质讲师&q;,&q;desc&q;:&q;粉笔优质教师\n长期从事公考一线教学，具有数资科目丰富的实践经验及系统扎实的专业理论知识，参与笔试教研，对数资方向有深入研究；撰写多篇事业单位笔试教研材料，多次参加粉笔教研活动，分享授课经验心得，助力粉笔理论研发升级，累计获得事业编、军队文职学员好评，具有深入浅出的授课风格，让学生在轻松的学习氛围中，用更简单的方法，找到更快捷的解题之道，是值得信赖的好导师。&q;,&q;avatar&q;:&q;193b462a6079080.jpg&q;,&q;upperBodyPhoto&q;:null,&q;displayCoursePrefix&q;:&q;sydw&q;,&q;teacherStat&q;:{&q;teacherId&q;:61431,&q;episodeCount&q;:256,&q;scoreCount&q;:763,&q;avgScore&q;:9.753604193971162,&q;fiveGradeAvgScore&q;:4.88,&q;updateTime&q;:1773491076279},&q;auditionEpisode&q;:{&q;episodeTitle&q;:&q;个人展示课&q;,&q;episodeVideoUrl&q;:&q;https://vod.fbstatic.cn/22e9ceb2vodbj1251001446/92ef045f5145403709541396620/ShNRjQwtmN8A.mp4?t=f2a4b300&a;us=4070880000&a;sign=994c2b763453aa36eee2dbbf67be1373&q;},&q;memberOfCPC&q;:false,&q;tags&q;:null},{&q;id&q;:34151,&q;userId&q;:83887928,&q;name&q;:&q;颜瑞&q;,&q;brief&q;:&q;粉笔优质讲师&q;,&q;desc&q;:&q;粉笔优质讲师\n5年一线教学经验，教学教研经验丰富。授课思路开阔，善于举一反三，引导和启发学生；课堂互动性强，善于从学员角度出发解决问题；授课风格循循善诱，细致耐心，寓教于乐给予个性化帮助，授课产品类型丰富，评分高达4.9，深受学生喜爱。\n教研上，常识公基科目实践经验及专业理论知识扎实丰富，对常识公基非法考情把握恰当，并负责多科目单题录制工作，并且多次参与命制笔试真题教研、解析以及教研文章撰写工作，致力于深入探究常识公基的命题规律及拿分技巧。&q;,&q;avatar&q;:&q;193af63981634c3.jpg&q;,&q;upperBodyPhoto&q;:null,&q;displayCoursePrefix&q;:&q;sydw&q;,&q;teacherStat&q;:{&q;teacherId&q;:34151,&q;episodeCount&q;:764,&q;scoreCount&q;:928,&q;avgScore&q;:9.73275862068965,&q;fiveGradeAvgScore&q;:4.87,&q;updateTime&q;:1773579803077},&q;auditionEpisode&q;:{&q;episodeTitle&q;:&q;个人展示课&q;,&q;episodeVideoUrl&q;:&q;https://vod.fbstatic.cn/22e9ceb2vodbj1251001446/852adeed5145403709544842797/4NI3eZVTCIgA.mp4?t=f2a4b300&a;us=4070880000&a;sign=8b0451bae7287a818ba1ca53e0d1a8cd&q;},&q;memberOfCPC&q;:false,&q;tags&q;:null},{&q;id&q;:56428,&q;userId&q;:87702759,&q;name&q;:&q;徐雨婷&q;,&q;brief&q;:&q;粉笔优质讲师&q;,&q;desc&q;:&q;粉笔优质讲师\n拥有5年的考编辅导经验，深入研究各类考编考试，熟练掌握考点与解题技巧，能够精准把握考试动态；\n多年授课经验，深耕言语类教学，长期从事相关教研工作，熟知事业单位命题格式和答题技巧；\n累计授课辅导学员近15000人，综合评分达4.95分，注重启发式引导，授课思路清晰直接，讲解细致耐心，富有亲和力。&q;,&q;avatar&q;:&q;19bbc410c81476e.jpg&q;,&q;upperBodyPhoto&q;:null,&q;displayCoursePrefix&q;:&q;sydw&q;,&q;teacherStat&q;:{&q;teacherId&q;:56428,&q;episodeCount&q;:304,&q;scoreCount&q;:866,&q;avgScore&q;:9.736720554272521,&q;fiveGradeAvgScore&q;:4.87,&q;updateTime&q;:1770692599396},&q;auditionEpisode&q;:{&q;episodeTitle&q;:&q;个人展示课&q;,&q;episodeVideoUrl&q;:&q;https://vod.fbstatic.cn/22e9ceb2vodbj1251001446/829ecf005145403709544711366/wKTZNI4y06UA.mp4?t=f2a4b300&a;us=4070880000&a;sign=50d98f18eca2d6b1d5bb116b66e23690&q;},&q;memberOfCPC&q;:false,&q;tags&q;:null},{&q;id&q;:56429,&q;userId&q;:74160353,&q;name&q;:&q;邱宜静&q;,&q;brief&q;:&q;粉笔优质讲师&q;,&q;desc&q;:&q;粉笔优质教师\n五年一线教学授课经验，长期致力于事业单位考试研究与教学，对事业单位招聘考试体系有着深入的理解和扎实的教学经验。\n具有言语科目丰富的实践经验及系统扎实的专业理论知识和对事业单位言语考情的深入研究:\n多次参与笔试真题教研和解析撰写工作，对言语命题趋势方向有着深入的研究;\n多次参加粉笔授课研讨会议，深入研讨事考言语命题趋势及最新考情;\n授课特点:擅长将复杂的知识点转化为易于理解的教学内容，通过循序渐进的教学方式，引导学生逐步掌握所需的知识点，帮助学员快速掌握言语科目的核心要点，提升解题能力和应试技巧，成功帮助数百名考生顺利通过事业单位招聘考试。&q;,&q;avatar&q;:&q;18408e0ee9a5e5d.jpg&q;,&q;upperBodyPhoto&q;:null,&q;displayCoursePrefix&q;:&q;sydw&q;,&q;teacherStat&q;:{&q;teacherId&q;:56429,&q;episodeCount&q;:185,&q;scoreCount&q;:627,&q;avgScore&q;:9.763955342902712,&q;fiveGradeAvgScore&q;:4.88,&q;updateTime&q;:1773327807084},&q;auditionEpisode&q;:{&q;episodeTitle&q;:&q;个人展示课&q;,&q;episodeVideoUrl&q;:&q;https://vod.fbstatic.cn/22e9ceb2vodbj1251001446/cfc0c3501253642695688501785/bsDyySXGJLgA.mp4?t=f2a4b300&a;us=4070880000&a;sign=41a1d807640af0e9a33d92a3917850c4&q;},&q;memberOfCPC&q;:false,&q;tags&q;:null},{&q;id&q;:17059,&q;userId&q;:67506738,&q;name&q;:&q;李怡辰&q;,&q;brief&q;:&q;粉笔优质讲师&q;,&q;desc&q;:&q;粉笔优质讲师\n硕士毕业985院校、六年事考授课经验，具有扎实一线教学经验，培训学员上千名。\n扎实的综应科目理论功底，能击破应试重点难点，梳理出实用性的解题思路。\n授课中耐心细致，参与提分营等各类产品授课，重点突出，思路逻辑清晰，能将最专业的知识讲得直白易懂，注重对学员思路的引导，实战性强。 \n多次参加粉笔教研活动，对考情梳理有深入研究，快速帮学员提分。&q;,&q;avatar&q;:&q;17470aeb32cd932.jpg&q;,&q;upperBodyPhoto&q;:null,&q;displayCoursePrefix&q;:&q;sydw&q;,&q;teacherStat&q;:{&q;teacherId&q;:17059,&q;episodeCount&q;:491,&q;scoreCount&q;:474,&q;avgScore&q;:9.789029535864975,&q;fiveGradeAvgScore&q;:4.89,&q;updateTime&q;:1773138021859},&q;auditionEpisode&q;:{&q;episodeTitle&q;:&q;个人展示课&q;,&q;episodeVideoUrl&q;:&q;https://vod.fbstatic.cn/22e9ceb2vodbj1251001446/bfd6505e5145403709545092730/laIcdGgauIQA.mp4?t=f2a4b300&a;us=4070880000&a;sign=7cc318009277acd589537d57f313e812&q;},&q;memberOfCPC&q;:false,&q;tags&q;:null},{&q;id&q;:34129,&q;userId&q;:83514929,&q;name&q;:&q;刘思秀&q;,&q;brief&q;:&q;粉笔优质讲师&q;,&q;desc&q;:&q;粉笔优质教师\n六年一线教学经验，总授课时长累计超2500小时。多年深耕事业单位考试领域，教学经验丰富，紧跟考情时新热点，对考情、真题、命题方向理解深刻。粉笔事业单位笔试教研材料撰写人之一，四年模考命题经验，多次参加粉笔教研活动，分享授课经验心得，助力粉笔理论研发升级。多年小班带队老师，学员累计评分4.9，结班上岸率 72%，名下多位学员岗位第一入面。授课条理清晰，讲解风趣幽默，擅长化难为简，总结做题规律，将复杂的笔试知识点进行系统梳理，帮助学员把握知识点底层逻辑，减轻学员记忆负担，快速掌握笔试答题技巧。&q;,&q;avatar&q;:&q;1983b891b2af100.jpg&q;,&q;upperBodyPhoto&q;:null,&q;displayCoursePrefix&q;:&q;sydw&q;,&q;teacherStat&q;:{&q;teacherId&q;:34129,&q;episodeCount&q;:613,&q;scoreCount&q;:970,&q;avgScore&q;:9.721649484536082,&q;fiveGradeAvgScore&q;:4.86,&q;updateTime&q;:1773558647472},&q;auditionEpisode&q;:null,&q;memberOfCPC&q;:false,&q;tags&q;:null},{&q;id&q;:36424,&q;userId&q;:68075961,&q;name&q;:&q;周凡&q;,&q;brief&q;:&q;粉笔优质讲师&q;,&q;desc&q;:&q;粉笔优质讲师\n五年一线教学授课经验，具有申论、综应科目丰富的实践经验及系统扎实的专业理论知识，承担过笔试精品班、刷题班、冲刺营等多种班型，熟悉各地方事业单位综合应用科目的真题特色和答题技巧。多次参加粉笔教研活动，注重自我提升，积极丰富更新理论知识。\n擅长启发式教学，将理论与实际结合引导学员形成逻辑思维，抓住学员痛点，针对性解决；授课风格生动亲和，互动性强，激发学员自主思考，深受学员喜爱。&q;,&q;avatar&q;:&q;193af6a0ddc74ed.jpg&q;,&q;upperBodyPhoto&q;:null,&q;displayCoursePrefix&q;:&q;sydw&q;,&q;teacherStat&q;:{&q;teacherId&q;:36424,&q;episodeCount&q;:186,&q;scoreCount&q;:310,&q;avgScore&q;:9.832258064516125,&q;fiveGradeAvgScore&q;:4.92,&q;updateTime&q;:1773451850353},&q;auditionEpisode&q;:{&q;episodeTitle&q;:&q;个人展示课&q;,&q;episodeVideoUrl&q;:&q;https://vod.fbstatic.cn/22e9ceb2vodbj1251001446/8069d87c1253642696337003353/yZcT8GBR7s0A.mp4?t=f2a4b300&a;us=4070880000&a;sign=d6adc5739df5884a68595e7bb9a0a63f&q;},&q;memberOfCPC&q;:false,&q;tags&q;:null},{&q;id&q;:32782,&q;userId&q;:79960755,&q;name&q;:&q;吴丽平&q;,&q;brief&q;:&q;粉笔优质讲师&q;,&q;desc&q;:&q;粉笔优质教师。5年一线教学授课经验。具有常识公基非法和言语科目丰富的实践经验及系统扎实的专业理论知识。多次参加粉笔授课研讨会议，全面把握事考命题趋势及最新考情，积累丰富笔试知识。具有条理清晰、重点突出的授课风格，课堂氛围轻松融洽，深受广大学员的认可和好评。&q;,&q;avatar&q;:&q;193af5fba524983.jpg&q;,&q;upperBodyPhoto&q;:null,&q;displayCoursePrefix&q;:&q;sydw&q;,&q;teacherStat&q;:{&q;teacherId&q;:32782,&q;episodeCount&q;:538,&q;scoreCount&q;:909,&q;avgScore&q;:9.722772277227719,&q;fiveGradeAvgScore&q;:4.86,&q;updateTime&q;:1773541187305},&q;auditionEpisode&q;:null,&q;memberOfCPC&q;:false,&q;tags&q;:null},{&q;id&q;:32255,&q;userId&q;:83147129,&q;name&q;:&q;段小涛&q;,&q;brief&q;:&q;粉笔优质讲师&q;,&q;desc&q;:&q;粉笔常识公基优质讲师\n5年一线教学授课经验，经验丰富。授课严谨有序又充满趣味性、重难点清晰，通过幽默风趣的语言深入浅出的帮助学员解决问题，激发学习热情。&q;,&q;avatar&q;:&q;1783f58f0da77bc.jpg&q;,&q;upperBodyPhoto&q;:null,&q;displayCoursePrefix&q;:&q;sydw&q;,&q;teacherStat&q;:{&q;teacherId&q;:32255,&q;episodeCount&q;:537,&q;scoreCount&q;:1267,&q;avgScore&q;:9.690607734806628,&q;fiveGradeAvgScore&q;:4.85,&q;updateTime&q;:1773531142359},&q;auditionEpisode&q;:{&q;episodeTitle&q;:&q;个人展示课&q;,&q;episodeVideoUrl&q;:&q;https://vod.fbstatic.cn/22e9ceb2vodbj1251001446/dac3cdb75145403710133811739/z2Y4lbMbdBUA.mp4?t=f2a4b300&a;us=4070880000&a;sign=15e974fbc21791a1b25433791ff9a66b&q;},&q;memberOfCPC&q;:false,&q;tags&q;:null},{&q;id&q;:32758,&q;userId&q;:73286911,&q;name&q;:&q;陆梦媛&q;,&q;brief&q;:&q;粉笔优质讲师&q;,&q;desc&q;:&q;粉笔优质讲师。\n5年教学经验。具有常识公基非法和综应科目系统扎实的专业理论知识，熟悉各地考情和命题特点。\n授课思路清晰，重点突出，善于用简洁明了的语言讲授知识点，上课氛围轻松愉快。累计授课时常超过2000小时，所带学员超过7000人。\n学生口碑：具有亲切幽默的授课风格，让学生在轻松的学习氛围中用更简单的方法获得知识。有耐心，对于学生的问题能够循循善诱，深受广大学员认可和好评。&q;,&q;avatar&q;:&q;1785909ecba60f3.jpg&q;,&q;upperBodyPhoto&q;:null,&q;displayCoursePrefix&q;:&q;sydw&q;,&q;teacherStat&q;:{&q;teacherId&q;:32758,&q;episodeCount&q;:631,&q;scoreCount&q;:1268,&q;avgScore&q;:9.686119873817033,&q;fiveGradeAvgScore&q;:4.84,&q;updateTime&q;:1773286316489},&q;auditionEpisode&q;:{&q;episodeTitle&q;:&q;个人展示课&q;,&q;episodeVideoUrl&q;:&q;https://vod.fbstatic.cn/22e9ceb2vodbj1251001446/7b763e815145403709537683006/3CUFIQRQUPwA.mp4?t=f2a4b300&a;us=4070880000&a;sign=314d5a744ab57c15cab13ba6ac8488bb&q;},&q;memberOfCPC&q;:false,&q;tags&q;:null},{&q;id&q;:33579,&q;userId&q;:82923568,&q;name&q;:&q;冯树君&q;,&q;brief&q;:&q;粉笔优质讲师&q;,&q;desc&q;:&q;粉笔常识公基优质讲师\n教学授课经验丰富，解惑答疑深入浅出，言简意赅 。授课风格诙谐幽默，课堂氛围活跃。注重理论输出与提问检验相结合。&q;,&q;avatar&q;:&q;19840fd7717d929.jpg&q;,&q;upperBodyPhoto&q;:null,&q;displayCoursePrefix&q;:&q;sydw&q;,&q;teacherStat&q;:{&q;teacherId&q;:33579,&q;episodeCount&q;:1220,&q;scoreCount&q;:965,&q;avgScore&q;:9.699481865284973,&q;fiveGradeAvgScore&q;:4.85,&q;updateTime&q;:1773474825913},&q;auditionEpisode&q;:{&q;episodeTitle&q;:&q;个人展示课&q;,&q;episodeVideoUrl&q;:&q;https://vod.fbstatic.cn/22e9ceb2vodbj1251001446/fdb6705d5145403708057169016/DqUnYKBVk6oA.mp4?t=f2a4b300&a;us=4070880000&a;sign=9c7743818b68419d9335d456f483cb3e&q;},&q;memberOfCPC&q;:false,&q;tags&q;:null},{&q;id&q;:64118,&q;userId&q;:119499857,&q;name&q;:&q;闫瑶&q;,&q;brief&q;:&q;粉笔优质讲师&q;,&q;desc&q;:&q;粉笔优质讲师\n5年综应一线教学经验，累计评分4.9。\n1.具有丰富的综应理论储备，精通公务员，事业单位等考情分析。灵活变通，因材施教，更好帮助学生搭建综应框架。\n2.多次参加粉笔授课线下研讨会议，全面把握事业单位综应的命题趋势及最新考情，互相分享授课经验心得，积累丰富的综应授课方式。\n3.授课风格新颖，擅于引导学生思考，在框架上发散思维，关注个性化培养，让每位学生都能在思维内清晰掌握综应答题技巧，有效提升综应成绩，深受学员喜爱。&q;,&q;avatar&q;:&q;191dfeaf0442e06.jpg&q;,&q;upperBodyPhoto&q;:null,&q;displayCoursePrefix&q;:&q;sydw&q;,&q;teacherStat&q;:{&q;teacherId&q;:64118,&q;episodeCount&q;:723,&q;scoreCount&q;:722,&q;avgScore&q;:9.72299168975069,&q;fiveGradeAvgScore&q;:4.86,&q;updateTime&q;:1773059619278},&q;auditionEpisode&q;:{&q;episodeTitle&q;:&q;个人展示课&q;,&q;episodeVideoUrl&q;:&q;https://vod.fbstatic.cn/22e9ceb2vodbj1251001446/27f1ca815145403709543158075/PPya3Za16c4A.mp4?t=f2a4b300&a;us=4070880000&a;sign=b517e11f2ef0e360a3f9dc46222bd2ab&q;},&q;memberOfCPC&q;:false,&q;tags&q;:null},{&q;id&q;:26000,&q;userId&q;:79045931,&q;name&q;:&q;曾国芳&q;,&q;brief&q;:&q;粉笔优质讲师&q;,&q;desc&q;:&q;粉笔常识公基优质教师。\n5年一线教学授课经验。多次参与粉笔授课研讨会议，具有法律科目丰富的实践经验及系统扎实的专业理论知识，曾参与命制笔试教研和真题解析撰写工作，熟悉常识公基笔试考情。\n累计授课时长1000+，综合评分4.9，授课思路清晰明了，条理分明，能够准确地把握课程的重点，讲解风格流畅自然，语言通俗易懂，注重及时对所学内容进行总结、梳理与回顾，帮助学员巩固所学知识，构建知识框架。&q;,&q;avatar&q;:&q;1983b115f298514.jpg&q;,&q;upperBodyPhoto&q;:null,&q;displayCoursePrefix&q;:&q;sydw&q;,&q;teacherStat&q;:{&q;teacherId&q;:26000,&q;episodeCount&q;:550,&q;scoreCount&q;:786,&q;avgScore&q;:9.715012722646309,&q;fiveGradeAvgScore&q;:4.86,&q;updateTime&q;:1773579521495},&q;auditionEpisode&q;:{&q;episodeTitle&q;:&q;个人展示课&q;,&q;episodeVideoUrl&q;:&q;https://vod.fbstatic.cn/22e9ceb2vodbj1251001446/62b81e155145403710098214091/A9nD0SODvSgA.mp4?t=f2a4b300&a;us=4070880000&a;sign=c9496142d0c559efda8f86b4d90a68a7&q;},&q;memberOfCPC&q;:false,&q;tags&q;:null},{&q;id&q;:64003,&q;userId&q;:68357000,&q;name&q;:&q;王璟璘&q;,&q;brief&q;:&q;粉笔优质讲师&q;,&q;desc&q;:&q;粉笔优质讲师\n从业7年来，长期从事一线教学工作，包含线上和线下所有课程。多次参加授课研讨会议，全面把握公考命题趋势及最新考情。授课过程逻辑清晰，语言精炼，能够化难为简，从本质出发解决问题。课堂互动性较好，学习氛围轻松，通过和学生的互动带动学生学习的热情，能从实战的角度为学生提供更全面的解答，帮助学生实现提升，并获得学生认可&q;,&q;avatar&q;:&q;19840ff68780907.jpg&q;,&q;upperBodyPhoto&q;:null,&q;displayCoursePrefix&q;:&q;sydw&q;,&q;teacherStat&q;:{&q;teacherId&q;:64003,&q;episodeCount&q;:628,&q;scoreCount&q;:1086,&q;avgScore&q;:9.68324125230202,&q;fiveGradeAvgScore&q;:4.84,&q;updateTime&q;:1773477468027},&q;auditionEpisode&q;:{&q;episodeTitle&q;:&q;个人展示课&q;,&q;episodeVideoUrl&q;:&q;https://vod.fbstatic.cn/22e9ceb2vodbj1251001446/169f352e1397757890216774060/CXhHCLtThp4A.mp4?t=f2a4b300&a;us=4070880000&a;sign=d4ddb4c0a4e1df44cc69e662e15f80c0&q;},&q;memberOfCPC&q;:false,&q;tags&q;:null},{&q;id&q;:40124,&q;userId&q;:62346950,&q;name&q;:&q;王宗云&q;,&q;brief&q;:&q;粉笔优质讲师&q;,&q;desc&q;:&q;粉笔优质讲师\n6年一线教学授课经验；具有常识公基科目丰富的实践经验及系统扎实的专业理论知识，参与命制笔试教研，对常识公基方向有深入研究； 多次参加粉笔教研活动，分享授课经验心得，助力粉笔理论研发升级； 具有轻松幽默的授课风格，让学生在轻松的学习氛围中，用更简单的方法，更生动的例子跟口诀记住最核心的知识点，找到更快捷的解题之道，深受广大学员的认可和好评。&q;,&q;avatar&q;:&q;1945f3be0066061.jpg&q;,&q;upperBodyPhoto&q;:null,&q;displayCoursePrefix&q;:&q;sydw&q;,&q;teacherStat&q;:{&q;teacherId&q;:40124,&q;episodeCount&q;:1488,&q;scoreCount&q;:1650,&q;avgScore&q;:9.649696969696974,&q;fiveGradeAvgScore&q;:4.82,&q;updateTime&q;:1773295020000},&q;auditionEpisode&q;:{&q;episodeTitle&q;:&q;个人展示课&q;,&q;episodeVideoUrl&q;:&q;https://vod.fbstatic.cn/22e9ceb2vodbj1251001446/d2fc9d6a5145403711958445856/ehQ8ACZf2zgA.mp4?t=f2a4b300&a;us=4070880000&a;sign=4f5f103ba79a41c34156d948d5bf500c&q;},&q;memberOfCPC&q;:false,&q;tags&q;:null},{&q;id&q;:32718,&q;userId&q;:80360201,&q;name&q;:&q;张宝丁&q;,&q;brief&q;:&q;粉笔优质讲师&q;,&q;desc&q;:&q;粉笔优质教师\n多年一线教学授课经验，具有公基科目丰富的实践经验及系统扎实的专业理论知识，对考情深入研究，多次参加粉笔授课研讨会议，全面把握公考笔试命题趋势及最新考情，积累丰富知识，累计授课时长2000+，让学生在轻松的学习氛围中，用更简单的方法，找到更快捷的解题之道，深受广大学员的认可和好评；在学员中具有非常好的口碑，是值得信赖的好导师。&q;,&q;avatar&q;:&q;1794afa1686d904.jpg&q;,&q;upperBodyPhoto&q;:null,&q;displayCoursePrefix&q;:&q;sydw&q;,&q;teacherStat&q;:{&q;teacherId&q;:32718,&q;episodeCount&q;:665,&q;scoreCount&q;:1043,&q;avgScore&q;:9.681687440076702,&q;fiveGradeAvgScore&q;:4.84,&q;updateTime&q;:1773616820914},&q;auditionEpisode&q;:{&q;episodeTitle&q;:&q;个人展示课&q;,&q;episodeVideoUrl&q;:&q;https://vod.fbstatic.cn/22e9ceb2vodbj1251001446/72b1f9f11397757888022138571/Q1bBr4nSV70A.mp4?t=f2a4b300&a;us=4070880000&a;sign=2f95ac8a59f6994b28f11d556e31ce67&q;},&q;memberOfCPC&q;:false,&q;tags&q;:null},{&q;id&q;:34144,&q;userId&q;:83886683,&q;name&q;:&q;成远&q;,&q;brief&q;:&q;粉笔优质讲师&q;,&q;desc&q;:&q;粉笔优质教师\n五年一线教学授课经验 具有综应科目丰富的实践经验及系统扎实的专业理论知识，对综应考情深入研究 教学经验：多次积极参加综应科目的教研培训，对各省份综应考情进行深入研究，积累丰富的综应知识 学生口碑：授课风格细腻认真，根据学员的学习风格，灵活调整教学策略，使每位学员都能跟上课堂进度。课堂氛围轻松，能够让学员们积极参与讨论，互相分享自己的见解。与学员之间的互动频繁，学员提出的问题能够及时耐心解答。&q;,&q;avatar&q;:&q;178a5ed9b29baae.jpg&q;,&q;upperBodyPhoto&q;:null,&q;displayCoursePrefix&q;:&q;sydw&q;,&q;teacherStat&q;:{&q;teacherId&q;:34144,&q;episodeCount&q;:379,&q;scoreCount&q;:278,&q;avgScore&q;:9.812949640287767,&q;fiveGradeAvgScore&q;:4.91,&q;updateTime&q;:1773283970717},&q;auditionEpisode&q;:{&q;episodeTitle&q;:&q;个人展示课&q;,&q;episodeVideoUrl&q;:&q;https://vod.fbstatic.cn/22e9ceb2vodbj1251001446/dded7c315145403709430054231/MetXyTQDR9MA.mp4?t=f2a4b300&a;us=4070880000&a;sign=5cfd13ce7c9af3e4a44ad6a7c92fffaa&q;},&q;memberOfCPC&q;:false,&q;tags&q;:null},{&q;id&q;:18973,&q;userId&q;:59327812,&q;name&q;:&q;李浚文&q;,&q;brief&q;:&q;粉笔优质讲师&q;,&q;desc&q;:&q;粉笔常识公基优质讲师\n8年公考教学经验，撰写多篇事业单位笔试教研材料，在粉笔笔试教师内部进行共享。具备系统扎实的理论知识和教学经验，授课逻辑清晰、考点突出，深受广大学员的认可和好评，是值得信赖的好导师。&q;,&q;avatar&q;:&q;1945f35b54dda3b.jpg&q;,&q;upperBodyPhoto&q;:null,&q;displayCoursePrefix&q;:&q;sydw&q;,&q;teacherStat&q;:{&q;teacherId&q;:18973,&q;episodeCount&q;:659,&q;scoreCount&q;:983,&q;avgScore&q;:9.67446592065106,&q;fiveGradeAvgScore&q;:4.84,&q;updateTime&q;:1773544007368},&q;auditionEpisode&q;:{&q;episodeTitle&q;:&q;个人展示课&q;,&q;episodeVideoUrl&q;:&q;https://vod.fbstatic.cn/22e9ceb2vodbj1251001446/828cc79e5145403709544701770/Sd2p7K2oNYYA.mp4?t=f2a4b300&a;us=4070880000&a;sign=4c4ee7912c75d3f2d0f868bfbbb406b4&q;},&q;memberOfCPC&q;:false,&q;tags&q;:null},{&q;id&q;:32970,&q;userId&q;:83438578,&q;name&q;:&q;朱湘依&q;,&q;brief&q;:&q;粉笔优质讲师&q;,&q;desc&q;:&q;粉笔优质讲师\n毕业于双一流院校，6年一线教学经验，承担线上、线下多种班型课程，授课经验丰富。\n承担常识公基非法律部分与数资科目授课、教研与培训工作。撰写多篇笔试教研材料。\n上课风格条理清晰，逻辑性强，擅长理论与实际相结合，授课有方法与技巧，积极引导并激发学员学习热情和自主意识，深受学员喜爱与好评。&q;,&q;avatar&q;:&q;1965c4972230508.jpg&q;,&q;upperBodyPhoto&q;:null,&q;displayCoursePrefix&q;:&q;sydw&q;,&q;teacherStat&q;:{&q;teacherId&q;:32970,&q;episodeCount&q;:707,&q;scoreCount&q;:1045,&q;avgScore&q;:9.666985645933023,&q;fiveGradeAvgScore&q;:4.83,&q;updateTime&q;:1773622939242},&q;auditionEpisode&q;:{&q;episodeTitle&q;:&q;个人展示课&q;,&q;episodeVideoUrl&q;:&q;https://vod.fbstatic.cn/22e9ceb2vodbj1251001446/499072d75145403715606210097/s5aPkRTv9zwA.mp4?t=f2a4b300&a;us=4070880000&a;sign=e5a5a9ce7c1f73488eb51fc79567a0aa&q;},&q;memberOfCPC&q;:false,&q;tags&q;:null},{&q;id&q;:16835,&q;userId&q;:74157121,&q;name&q;:&q;汪贝&q;,&q;brief&q;:&q;粉笔优质讲师&q;,&q;desc&q;:&q;粉笔优质讲师。5年一线教学经验，多年教学经验，累计授课超1500小时。熟悉考场答题思维及应变技巧。授课有激情，善于串讲总结。逻辑性强，注重理论与实践相结合，助力众多学员上岸。&q;,&q;avatar&q;:&q;193af5378ec26b3.jpg&q;,&q;upperBodyPhoto&q;:null,&q;displayCoursePrefix&q;:&q;sydw&q;,&q;teacherStat&q;:{&q;teacherId&q;:16835,&q;episodeCount&q;:669,&q;scoreCount&q;:3740,&q;avgScore&q;:9.578074866310153,&q;fiveGradeAvgScore&q;:4.79,&q;updateTime&q;:1773550368908},&q;auditionEpisode&q;:{&q;episodeTitle&q;:&q;个人展示课&q;,&q;episodeVideoUrl&q;:&q;https://vod.fbstatic.cn/22e9ceb2vodbj1251001446/345eb1165145403708051348601/oy5T3Av15NoA.mp4?t=f2a4b300&a;us=4070880000&a;sign=f5c19ea714f95c41c7005dec16975baa&q;},&q;memberOfCPC&q;:false,&q;tags&q;:null},{&q;id&q;:34188,&q;userId&q;:83856586,&q;name&q;:&q;李宗菊&q;,&q;brief&q;:&q;粉笔优质讲师&q;,&q;desc&q;:&q;粉笔优质教师\n6年公考教学经验和多年培训教育经验，授课思路清晰，课堂氛围轻松，重难点突出 擅长引导，激发学员学习热情，学员好评度高。&q;,&q;avatar&q;:&q;178a630cbca5182.jpg&q;,&q;upperBodyPhoto&q;:null,&q;displayCoursePrefix&q;:&q;sydw&q;,&q;teacherStat&q;:{&q;teacherId&q;:34188,&q;episodeCount&q;:596,&q;scoreCount&q;:812,&q;avgScore&q;:9.679802955665014,&q;fiveGradeAvgScore&q;:4.84,&q;updateTime&q;:1773475247640},&q;auditionEpisode&q;:{&q;episodeTitle&q;:&q;个人展示课&q;,&q;episodeVideoUrl&q;:&q;https://vod.fbstatic.cn/22e9ceb2vodbj1251001446/53f4fa301253642695778393524/uGA8MEZ6dXgA.mp4?t=f2a4b300&a;us=4070880000&a;sign=53f612c946fe50fbc2fe02f9de9341e1&q;},&q;memberOfCPC&q;:false,&q;tags&q;:null},{&q;id&q;:26288,&q;userId&q;:52871684,&q;name&q;:&q;刘开心&q;,&q;brief&q;:&q;粉笔优质讲师&q;,&q;desc&q;:&q;粉笔优质教师\n5年一线教学经验，具有系统的专业理论知识。在职期间除了完成授课，同时兼顾教学研讨，熟悉命题及各地区考情动态，能力扎实。\n累计带笔试班学员人数超2000人，学员整体评分维持在4.8分以上；累计授课超过1000小时，评分达4.9分以上。\n课堂氛围轻松融洽，授课重点突出，思路清晰，讲解耐心细致，语言通俗易懂，擅长引导学生自主思考，并根据学生的不同情况和需求进行个性化指导。&q;,&q;avatar&q;:&q;17692b3ab794012.jpg&q;,&q;upperBodyPhoto&q;:null,&q;displayCoursePrefix&q;:&q;sydw&q;,&q;teacherStat&q;:{&q;teacherId&q;:26288,&q;episodeCount&q;:281,&q;scoreCount&q;:253,&q;avgScore&q;:9.794466403162055,&q;fiveGradeAvgScore&q;:4.9,&q;updateTime&q;:1773542090440},&q;auditionEpisode&q;:null,&q;memberOfCPC&q;:false,&q;tags&q;:null},{&q;id&q;:32043,&q;userId&q;:72042434,&q;name&q;:&q;吴丽欢&q;,&q;brief&q;:&q;粉笔优质讲师&q;,&q;desc&q;:&q;粉笔优质教师\n5年一线教学经验。承担过线下笔试精品班，授课经验丰富。\n熟悉事业单位考试内容和流程，具有数资科目丰富的实践经验及系统扎实的专业理论知识。多次参加粉笔授课研讨会议和笔试真题校验和解析撰写工作，对事业单位数资考情有深入研究。\n累计带班人数2000人次以上，累计授课评分4.8分以上。讲课生动、讲解详细、思路清晰，让学生在轻松的学习氛围中，用更简单的方法，找到更快捷的解题之道，深受广大学员的认可和好评。&q;,&q;avatar&q;:&q;19661616e0054b7.jpg&q;,&q;upperBodyPhoto&q;:null,&q;displayCoursePrefix&q;:&q;sydw&q;,&q;teacherStat&q;:{&q;teacherId&q;:32043,&q;episodeCount&q;:438,&q;scoreCount&q;:1157,&q;avgScore&q;:9.640449438202257,&q;fiveGradeAvgScore&q;:4.82,&q;updateTime&q;:1773418100874},&q;auditionEpisode&q;:{&q;episodeTitle&q;:&q;个人展示课&q;,&q;episodeVideoUrl&q;:&q;https://vod.fbstatic.cn/22e9ceb2vodbj1251001446/12fa0b4f5145403711103506705/gFRqcWCGD10A.mp4?t=f2a4b300&a;us=4070880000&a;sign=ab6f65c7516eea1b1fd3553d05b71090&q;},&q;memberOfCPC&q;:false,&q;tags&q;:null},{&q;id&q;:64640,&q;userId&q;:78567138,&q;name&q;:&q;李莱莱&q;,&q;brief&q;:&q;粉笔优质讲师&q;,&q;desc&q;:&q;粉笔优质讲师\n4年事业单位一线教学授课经验，深耕事业单位考试，承担过线下笔试精品班、刷题班等多种班型，授课经验丰富。累计授课超2000小时，累计评分高达 4.9 分，致力于为学员营造轻松愉悦的学习氛围，精心提炼更简单的方法，帮助学员找到快捷的解题之道。&q;,&q;avatar&q;:&q;193d86b8b4350a8.jpg&q;,&q;upperBodyPhoto&q;:null,&q;displayCoursePrefix&q;:&q;sydw&q;,&q;teacherStat&q;:{&q;teacherId&q;:64640,&q;episodeCount&q;:541,&q;scoreCount&q;:671,&q;avgScore&q;:9.669150521609541,&q;fiveGradeAvgScore&q;:4.83,&q;updateTime&q;:1773581000694},&q;auditionEpisode&q;:{&q;episodeTitle&q;:&q;个人展示课&q;,&q;episodeVideoUrl&q;:&q;https://vod.fbstatic.cn/22e9ceb2vodbj1251001446/2a7654ad1397757890128841233/3JuzLnW3PP0A.mp4?t=f2a4b300&a;us=4070880000&a;sign=2b619ef29d307c5ddea5cee231a19928&q;},&q;memberOfCPC&q;:false,&q;tags&q;:null},{&q;id&q;:16538,&q;userId&q;:72683674,&q;name&q;:&q;章亦轩&q;,&q;brief&q;:&q;粉笔优质讲师&q;,&q;desc&q;:&q;粉笔常识公基优质教师\n四年一线教学授课经验，深耕一线课程，承担过线上笔试精品班、刷题班等多种班型。\n具有常识公基科目丰富的实践经验及系统扎实的专业理论知识和对常识公基考情的深入研究，曾参与笔试教研和解析撰写工作；注重考场思维，针对学生困惑研究教学策略；深入研讨常识公基命题趋势及最新考情，注重自我提升，积累丰富笔试理论知识。\n累计授课超1000小时，注重启发式引导，让学生在轻松的学习氛围中，用更简单的方法，找到更快捷的解题之道，深受广大学员的认可和好评。&q;,&q;avatar&q;:&q;17467b2f8a0fb3b.jpg&q;,&q;upperBodyPhoto&q;:null,&q;displayCoursePrefix&q;:&q;sydw&q;,&q;teacherStat&q;:{&q;teacherId&q;:16538,&q;episodeCount&q;:914,&q;scoreCount&q;:1035,&q;avgScore&q;:9.62898550724638,&q;fiveGradeAvgScore&q;:4.81,&q;updateTime&q;:1773475961041},&q;auditionEpisode&q;:{&q;episodeTitle&q;:&q;个人展示课&q;,&q;episodeVideoUrl&q;:&q;https://vod.fbstatic.cn/22e9ceb2vodbj1251001446/6ef433b51397757888365410347/0qvJbp7EGrgA.mp4?t=f2a4b300&a;us=4070880000&a;sign=5675190d3b2d1da9f9d0e15ba0571903&q;},&q;memberOfCPC&q;:false,&q;tags&q;:null},{&q;id&q;:33464,&q;userId&q;:79618484,&q;name&q;:&q;钟页心&q;,&q;brief&q;:&q;粉笔优质讲师&q;,&q;desc&q;:&q;粉笔优质教师\n多次参加粉笔教研会议，全面把握各地区最新考情，积累丰富知识。\n五年一线教学经验，承担线上和线下精品班、系统班多种班型授课。课堂互动性佳，授课内容深入浅出，引导性强，激发学员学习热情，通过大量真实案例和实战演练让学生在练习中掌握答题技巧，灵活应对各类题目。\n累计线上授课超900小时，积累评分4.9分以上。针对性指导，发掘个人优势，帮助学员树立信心，答出自己真实的思考，突破自我，提高答题逻辑性和准确性，深受学生信赖。&q;,&q;avatar&q;:&q;17880f97c0ca868.jpg&q;,&q;upperBodyPhoto&q;:null,&q;displayCoursePrefix&q;:&q;sydw&q;,&q;teacherStat&q;:{&q;teacherId&q;:33464,&q;episodeCount&q;:462,&q;scoreCount&q;:280,&q;avgScore&q;:9.757142857142858,&q;fiveGradeAvgScore&q;:4.88,&q;updateTime&q;:1773388977630},&q;auditionEpisode&q;:{&q;episodeTitle&q;:&q;个人展示课&q;,&q;episodeVideoUrl&q;:&q;https://vod.fbstatic.cn/22e9ceb2vodbj1251001446/b4d00d621253642695657120814/yj7Ea7PjTXcA.mp4?t=f2a4b300&a;us=4070880000&a;sign=385e5bb2e5dde920bf1d27a23669c23f&q;},&q;memberOfCPC&q;:false,&q;tags&q;:null},{&q;id&q;:34187,&q;userId&q;:72708960,&q;name&q;:&q;杨建英&q;,&q;brief&q;:&q;粉笔优质讲师&q;,&q;desc&q;:&q;粉笔常识公基优质教师\n六年以上一线教学授课经验，具有公基科目丰富的实践经验及系统扎实的专业理论知识。累计授课课时900+，获得近1300学员好评。曾多次参与命制笔试教研，对民法、刑法考情有着深入研究，出过近600道优质模拟题，在常识公基教研方面取得不小成果。所授课的班级中，学员成绩均有明显提升，在考试当中取得了80+的好成绩。授课形象生动，条理清晰，考法考点突出，能够激发学员的学习热情，深受广大学员的认可和好评。&q;,&q;avatar&q;:&q;178a63030088c51.jpg&q;,&q;upperBodyPhoto&q;:null,&q;displayCoursePrefix&q;:&q;sydw&q;,&q;teacherStat&q;:{&q;teacherId&q;:34187,&q;episodeCount&q;:609,&q;scoreCount&q;:846,&q;avgScore&q;:9.640661938534272,&q;fiveGradeAvgScore&q;:4.82,&q;updateTime&q;:1773583685166},&q;auditionEpisode&q;:{&q;episodeTitle&q;:&q;个人展示课&q;,&q;episodeVideoUrl&q;:&q;https://vod.fbstatic.cn/22e9ceb2vodbj1251001446/b4a41c1f5145403715604466391/YJ5X0UoLJuwA.mp4?t=f2a4b300&a;us=4070880000&a;sign=8b8cab822f930f5bac858256d9951d14&q;},&q;memberOfCPC&q;:false,&q;tags&q;:null},{&q;id&q;:34963,&q;userId&q;:84101455,&q;name&q;:&q;如霞&q;,&q;brief&q;:&q;粉笔优质讲师&q;,&q;desc&q;:&q;粉笔优质教师\n5年一线教学授课经验，授课经验丰富。具有综应科目丰富的实践经验及系统扎实的专业理论知识，多次参加粉笔授课研讨会议，专业能力强，具有独特的授课风格，结合学生自身情况因材施教，耐心细致解答学生问题，让学生学有所获。&q;,&q;avatar&q;:&q;178c41303e0e2c5.jpg&q;,&q;upperBodyPhoto&q;:null,&q;displayCoursePrefix&q;:&q;sydw&q;,&q;teacherStat&q;:{&q;teacherId&q;:34963,&q;episodeCount&q;:315,&q;scoreCount&q;:325,&q;avgScore&q;:9.729230769230776,&q;fiveGradeAvgScore&q;:4.86,&q;updateTime&q;:1772957940845},&q;auditionEpisode&q;:{&q;episodeTitle&q;:&q;个人展示课&q;,&q;episodeVideoUrl&q;:&q;https://vod.fbstatic.cn/22e9ceb2vodbj1251001446/1bda03c55145403709539904282/4v4nhCA680YA.mp4?t=f2a4b300&a;us=4070880000&a;sign=84480a4d2ba2069cf8ef3e33bba01ed4&q;},&q;memberOfCPC&q;:false,&q;tags&q;:null},{&q;id&q;:64161,&q;userId&q;:107611277,&q;name&q;:&q;彭珏&q;,&q;brief&q;:&q;粉笔优质讲师&q;,&q;desc&q;:&q;粉笔优质讲师\n多年一线教学经验，深耕事业单位考试，承担过线下笔试精品班、刷题班、冲刺班等多种班型，授课经验丰富。\n多次参与粉笔数资科目教研，熟悉命题特点及做题技巧。累计授课超3000小时，累计评分达4.9分。\n善于对于不同类型的题目进行归类与总结，并从中找出共同点。授课形式生动形象，对学生亲和有礼，能够有针对性的引导学生进行主动思考，课堂氛围轻松无压力。&q;,&q;avatar&q;:&q;19405df58deb903.jpg&q;,&q;upperBodyPhoto&q;:null,&q;displayCoursePrefix&q;:&q;sydw&q;,&q;teacherStat&q;:{&q;teacherId&q;:64161,&q;episodeCount&q;:575,&q;scoreCount&q;:853,&q;avgScore&q;:9.61547479484174,&q;fiveGradeAvgScore&q;:4.81,&q;updateTime&q;:1772813556150},&q;auditionEpisode&q;:{&q;episodeTitle&q;:&q;个人展示课&q;,&q;episodeVideoUrl&q;:&q;https://vod.fbstatic.cn/22e9ceb2vodbj1251001446/cd7329fa1397757890484177284/6aPPHzaMBg8A.mp4?t=f2a4b300&a;us=4070880000&a;sign=11ee5ab2f8f129a9f10f76ab8f103533&q;},&q;memberOfCPC&q;:false,&q;tags&q;:null},{&q;id&q;:16939,&q;userId&q;:66139840,&q;name&q;:&q;张雨晰&q;,&q;brief&q;:&q;粉笔优质讲师&q;,&q;desc&q;:&q;粉笔优质教师\n拥有五年专业理论知识，曾撰写多篇事业单位笔试教研材料，在粉笔教师内部进行共享。在教学风格上，我追求幽默风趣与细致耐心并存，让学生在轻松的学习氛围中，用更简单的方法，找到更快捷的解题之道，深受广大学员的认可和好评；在学员中具有非常好的口碑，是值得信赖的好导师。&q;,&q;avatar&q;:&q;19855196b15bfa5.jpg&q;,&q;upperBodyPhoto&q;:null,&q;displayCoursePrefix&q;:&q;sydw&q;,&q;teacherStat&q;:{&q;teacherId&q;:16939,&q;episodeCount&q;:477,&q;scoreCount&q;:1735,&q;avgScore&q;:9.558501440922182,&q;fiveGradeAvgScore&q;:4.78,&q;updateTime&q;:1773583323250},&q;auditionEpisode&q;:null,&q;memberOfCPC&q;:false,&q;tags&q;:null},{&q;id&q;:64242,&q;userId&q;:136924485,&q;name&q;:&q;叶柒&q;,&q;brief&q;:&q;粉笔优质讲师&q;,&q;desc&q;:&q;粉笔优质讲师\n主讲言语理解与表达，4年一线授课经验，课堂内容深入，知识点剖析详尽；授课风格生动活泼，课堂氛围轻松愉快；在理论讲解过程中，擅长运用思维导图进行总结，有效帮助学生深化对知识点的理解和记忆，显著提升学习效率；注重以考生视角展开教学，认真负责，针对不同学员在不同学习阶段的情况，提供个性化指导，广受学员认可与好评。&q;,&q;avatar&q;:&q;191dfed6f853cf5.jpg&q;,&q;upperBodyPhoto&q;:null,&q;displayCoursePrefix&q;:&q;sydw&q;,&q;teacherStat&q;:{&q;teacherId&q;:64242,&q;episodeCount&q;:536,&q;scoreCount&q;:973,&q;avgScore&q;:9.601233299075032,&q;fiveGradeAvgScore&q;:4.8,&q;updateTime&q;:1773583835913},&q;auditionEpisode&q;:{&q;episodeTitle&q;:&q;个人展示课&q;,&q;episodeVideoUrl&q;:&q;https://vod.fbstatic.cn/22e9ceb2vodbj1251001446/03b640811397757889903156983/A4bNsSQyBDUA.mp4?t=f2a4b300&a;us=4070880000&a;sign=ac8bb95ff3a0a50768b3382353a5de35&q;},&q;memberOfCPC&q;:false,&q;tags&q;:null},{&q;id&q;:35773,&q;userId&q;:61422364,&q;name&q;:&q;房柯宇&q;,&q;brief&q;:&q;粉笔优质讲师&q;,&q;desc&q;:&q;粉笔优质教师\n拥有5年粉笔笔试教学经验，累计授课时长超2000小时，熟悉公务员、事业单位等各类笔试考试大纲与命题规律。 所带学员笔试通过率高，助力多名学员成功上岸心仪岗位，深受学员好评。 授课逻辑清晰，深入浅出，擅长将复杂知识点简单化，通过生动案例和实用技巧帮助学员快速掌握解题方法，提升学习效率。&q;,&q;avatar&q;:&q;178e7f4bd2ccdd4.jpg&q;,&q;upperBodyPhoto&q;:null,&q;displayCoursePrefix&q;:&q;sydw&q;,&q;teacherStat&q;:{&q;teacherId&q;:35773,&q;episodeCount&q;:280,&q;scoreCount&q;:159,&q;avgScore&q;:9.798742138364785,&q;fiveGradeAvgScore&q;:4.9,&q;updateTime&q;:1773051018040},&q;auditionEpisode&q;:{&q;episodeTitle&q;:&q;个人展示课&q;,&q;episodeVideoUrl&q;:&q;https://vod.fbstatic.cn/22e9ceb2vodbj1251001446/54ba57ed5145403707849588163/7cTaDQuDWaEA.mp4?t=f2a4b300&a;us=4070880000&a;sign=343a49e21ca1a21ee2c075236d99900b&q;},&q;memberOfCPC&q;:false,&q;tags&q;:null},{&q;id&q;:56390,&q;userId&q;:108843942,&q;name&q;:&q;王予&q;,&q;brief&q;:&q;粉笔优质讲师&q;,&q;desc&q;:&q;粉笔常识公基优质教师\n4年一线教学授课经验；\n具有公基科目丰富的实践经验及系统扎实的专业理论知识；\n授课风格简洁明了、富有激情、以学生为中心、灵活应变和积极互动，鼓励学员积极参与并提出问题，深受广大学员的认可和好评，努力为学员提供更好的教学服务&q;,&q;avatar&q;:&q;1985955411131f1.jpg&q;,&q;upperBodyPhoto&q;:null,&q;displayCoursePrefix&q;:&q;sydw&q;,&q;teacherStat&q;:{&q;teacherId&q;:56390,&q;episodeCount&q;:334,&q;scoreCount&q;:571,&q;avgScore&q;:9.635726795096327,&q;fiveGradeAvgScore&q;:4.82,&q;updateTime&q;:1773622859018},&q;auditionEpisode&q;:{&q;episodeTitle&q;:&q;个人展示课&q;,&q;episodeVideoUrl&q;:&q;https://vod.fbstatic.cn/22e9ceb2vodbj1251001446/1fe35dde5145403708149165280/qRbX9Ea90C4A.mp4?t=f2a4b300&a;us=4070880000&a;sign=a20de253a6b02bd2d3ec2b6d0b5c83a7&q;},&q;memberOfCPC&q;:false,&q;tags&q;:null},{&q;id&q;:18201,&q;userId&q;:65021959,&q;name&q;:&q;和羽&q;,&q;brief&q;:&q;粉笔优质讲师&q;,&q;desc&q;:&q;粉笔优质教师\n六年以上公考教学经验，深耕判断推理领域多年，具有丰富的实践经验及系统扎实的专业理论知识，特别对联考，江苏，广东地区的考情有深刻的了解，曾正确预测广东2023年统考判断题目考点，参与命制笔试教研，对判断方向有深入研究。&q;,&q;avatar&q;:&q;175de1603793be8.jpg&q;,&q;upperBodyPhoto&q;:null,&q;displayCoursePrefix&q;:&q;sydw&q;,&q;teacherStat&q;:{&q;teacherId&q;:18201,&q;episodeCount&q;:448,&q;scoreCount&q;:2492,&q;avgScore&q;:9.51685393258427,&q;fiveGradeAvgScore&q;:4.76,&q;updateTime&q;:1773579873374},&q;auditionEpisode&q;:{&q;episodeTitle&q;:&q;个人展示课&q;,&q;episodeVideoUrl&q;:&q;https://vod.fbstatic.cn/22e9ceb2vodbj1251001446/44f952535145403715606022056/4LBzOwv6V2sA.mp4?t=f2a4b300&a;us=4070880000&a;sign=0c9562cc28065d90b6940e468cbb4ddd&q;},&q;memberOfCPC&q;:false,&q;tags&q;:null},{&q;id&q;:34572,&q;userId&q;:66471305,&q;name&q;:&q;肖莹&q;,&q;brief&q;:&q;粉笔优质讲师&q;,&q;desc&q;:&q;粉笔优质教师\n6年一线教学经验，全面了解综合应用能力考试近年来命题规律、重难点及不同类型题目答题技巧，考试重难点讲解详细。多次参与国考、省考等考试，实战经验丰富。授课经验丰富，教研教学扎实，注重实教，善于反思，授课幽默风趣，特别能激发学生学习的热心，深受学生喜爱。&q;,&q;avatar&q;:&q;196615b50841253.jpg&q;,&q;upperBodyPhoto&q;:null,&q;displayCoursePrefix&q;:&q;sydw&q;,&q;teacherStat&q;:{&q;teacherId&q;:34572,&q;episodeCount&q;:318,&q;scoreCount&q;:435,&q;avgScore&q;:9.636781609195408,&q;fiveGradeAvgScore&q;:4.82,&q;updateTime&q;:1773235026252},&q;auditionEpisode&q;:null,&q;memberOfCPC&q;:false,&q;tags&q;:null},{&q;id&q;:64294,&q;userId&q;:93612758,&q;name&q;:&q;廖雅莉&q;,&q;brief&q;:&q;粉笔优质讲师&q;,&q;desc&q;:&q;粉笔优质教师\n多年授课培训经验，线上线下累计课时2000+，承担过线下笔试精品班、刷题班等多种班型，授课经验丰富。\n具有系统扎实的专业理论知识，多次参加粉笔授课研讨会议，参与撰写事业单位笔试言语科目的模拟题和解析等。授课通俗易懂，逻辑清晰，让学生在轻松的学习氛围中学习，累计学员评分达4.9，在学员中具有非常好的口碑。&q;,&q;avatar&q;:&q;19462d33edc1264.jpg&q;,&q;upperBodyPhoto&q;:null,&q;displayCoursePrefix&q;:&q;sydw&q;,&q;teacherStat&q;:{&q;teacherId&q;:64294,&q;episodeCount&q;:551,&q;scoreCount&q;:501,&q;avgScore&q;:9.588822355289425,&q;fiveGradeAvgScore&q;:4.79,&q;updateTime&q;:1771042016415},&q;auditionEpisode&q;:{&q;episodeTitle&q;:&q;个人展示课&q;,&q;episodeVideoUrl&q;:&q;https://vod.fbstatic.cn/22e9ceb2vodbj1251001446/35ec741d5145403709543750622/VAM9ofipGR4A.mp4?t=f2a4b300&a;us=4070880000&a;sign=3c7ebe0346b1f19aea8386d8ea861ae8&q;},&q;memberOfCPC&q;:false,&q;tags&q;:null},{&q;id&q;:2560,&q;userId&q;:45327634,&q;name&q;:&q;蒋振&q;,&q;brief&q;:&q;粉笔优质讲师&q;,&q;desc&q;:&q;粉笔优质教师\n毕业于“双一流”院校，六年一线教学经验。承担过线下笔试精品班、刷题班、冲刺班等多种班型，授课经验丰富。理论基础扎实，曾参与笔试模拟题命制和真题解析撰写等，对于命题方向有深入的研究。授课思路清晰，注重启发式引导；教学严谨认真，耐心帮助学员答疑解惑；重难点突出，帮助学员积累知识，构建知识脉络；授课风格幽默，深受广大学员的认可和好评。&q;,&q;avatar&q;:&q;191e0193bb6469a.jpg&q;,&q;upperBodyPhoto&q;:null,&q;displayCoursePrefix&q;:&q;sydw&q;,&q;teacherStat&q;:{&q;teacherId&q;:2560,&q;episodeCount&q;:2502,&q;scoreCount&q;:6719,&q;avgScore&q;:9.376097633576396,&q;fiveGradeAvgScore&q;:4.69,&q;updateTime&q;:1773557231050},&q;auditionEpisode&q;:{&q;episodeTitle&q;:&q;个人展示课&q;,&q;episodeVideoUrl&q;:&q;https://vod.fbstatic.cn/22e9ceb2vodbj1251001446/d60900ae5145403710133604541/BDv8n0eoBXAA.mp4?t=f2a4b300&a;us=4070880000&a;sign=1d8cfbae9d98190f57767564a0b31419&q;},&q;memberOfCPC&q;:false,&q;tags&q;:null},{&q;id&q;:35873,&q;userId&q;:83868400,&q;name&q;:&q;张雪峰&q;,&q;brief&q;:&q;粉笔优质讲师&q;,&q;desc&q;:&q;粉笔优质讲师\n6年一线教学经验，曾就职于省级科研院所。师资中心学科组长及其他项目负责人，累计服务学员数千人，注重学员考场实战思维的培养，辅导数名学员笔面第一成功上岸；\n承担各种线上线下授课任务，累计授课超过1000小时；\n长期参与粉笔内部教研工作，定期参与模拟题撰写、真题解析等，对于各类考试考情、考试重点有深入了解；\n授课风格上，风趣幽默、生动有趣、讲解细致、通俗易懂、富有亲和力；\n授课方式上，深入浅出、逻辑清晰、技巧性强、重点明确、化繁为简。深受学员喜爱与好评。&q;,&q;avatar&q;:&q;19854136e94d1f4.jpg&q;,&q;upperBodyPhoto&q;:null,&q;displayCoursePrefix&q;:&q;sydw&q;,&q;teacherStat&q;:{&q;teacherId&q;:35873,&q;episodeCount&q;:336,&q;scoreCount&q;:610,&q;avgScore&q;:9.537704918032789,&q;fiveGradeAvgScore&q;:4.77,&q;updateTime&q;:1773405613935},&q;auditionEpisode&q;:{&q;episodeTitle&q;:&q;个人展示课&q;,&q;episodeVideoUrl&q;:&q;https://vod.fbstatic.cn/22e9ceb2vodbj1251001446/35a538255145403709543712965/oxwk7Paiwr4A.mp4?t=f2a4b300&a;us=4070880000&a;sign=97faf61ced98c6e79a4e46aa81fb41e2&q;},&q;memberOfCPC&q;:false,&q;tags&q;:null},{&q;id&q;:64420,&q;userId&q;:118340918,&q;name&q;:&q;徐化雨&q;,&q;brief&q;:&q;粉笔优质讲师&q;,&q;desc&q;:&q;粉笔优质讲师\n6年一线线上线下数资授课及教研工作，承担过线下笔试精品班、刷题班、冲刺班等多种班型，具有丰富的实战经验；\n了解数量关系与资料分析的命题规律及答题技巧，多次参与命制笔试真题教研和解析撰写工作；\n授课逻辑性强，操作性强，知识点详细，重难点突出，了解学生解题过程中容易出错的点，帮助学生解决学习过程中遇到的难题，注重不同教学方法和技巧的拓展，开拓学生的思维，深受学生喜爱，广受好评。&q;,&q;avatar&q;:&q;193af7d4cbf360d.jpg&q;,&q;upperBodyPhoto&q;:null,&q;displayCoursePrefix&q;:&q;sydw&q;,&q;teacherStat&q;:{&q;teacherId&q;:64420,&q;episodeCount&q;:639,&q;scoreCount&q;:1186,&q;avgScore&q;:9.465430016863413,&q;fiveGradeAvgScore&q;:4.73,&q;updateTime&q;:1773574509026},&q;auditionEpisode&q;:{&q;episodeTitle&q;:&q;个人展示课&q;,&q;episodeVideoUrl&q;:&q;https://vod.fbstatic.cn/22e9ceb2vodbj1251001446/c1bf7a9e5145403709545133914/m6dJlzi9NsEA.mp4?t=f2a4b300&a;us=4070880000&a;sign=205797ab3c5e47054fafe87d2b29f65d&q;},&q;memberOfCPC&q;:false,&q;tags&q;:null},{&q;id&q;:64204,&q;userId&q;:85074167,&q;name&q;:&q;沐馨&q;,&q;brief&q;:&q;粉笔优质讲师&q;,&q;desc&q;:&q;粉笔优质教师\n5年一线教学经验，申论、综应科目实战经验丰富，对国省考、事业单位出题逻辑及答题技巧有独到见解。教学经验丰富，承担过线上线下笔试精讲、刷题、冲刺等多种班型。授课方式细致全面，能够通过全方位、多角度的讲解帮助学员提升答题能力。注重培养学生考场思维，做到主题找准、归纳到位、要点找全且字数限制下要点取舍有序，从而灵活应对综应各类题目。&q;,&q;avatar&q;:&q;1983b4c6f967bdc.jpg&q;,&q;upperBodyPhoto&q;:null,&q;displayCoursePrefix&q;:&q;sydw&q;,&q;teacherStat&q;:{&q;teacherId&q;:64204,&q;episodeCount&q;:581,&q;scoreCount&q;:540,&q;avgScore&q;:9.518518518518517,&q;fiveGradeAvgScore&q;:4.76,&q;updateTime&q;:1773392482017},&q;auditionEpisode&q;:{&q;episodeTitle&q;:&q;个人展示课&q;,&q;episodeVideoUrl&q;:&q;https://vod.fbstatic.cn/22e9ceb2vodbj1251001446/12bdfa105145403709539538983/GqJEYBA7ZmEA.mp4?t=f2a4b300&a;us=4070880000&a;sign=e326808f7ab4d9be6e6a7958cd133f5d&q;},&q;memberOfCPC&q;:false,&q;tags&q;:null},{&q;id&q;:56386,&q;userId&q;:76976071,&q;name&q;:&q;郁青&q;,&q;brief&q;:&q;粉笔优质讲师&q;,&q;desc&q;:&q;粉笔常识公基优质教师，法学专业毕业，授课严谨细致，讲解通俗易懂，授课过程中，注重课堂氛围，氛围生动有趣，课堂上注重基础，帮助学员查缺补漏，不断提高做题技巧。耐心细致，照顾到每个学员，给予学习信心。&q;,&q;avatar&q;:&q;184183d8b0babee.jpg&q;,&q;upperBodyPhoto&q;:null,&q;displayCoursePrefix&q;:&q;sydw&q;,&q;teacherStat&q;:{&q;teacherId&q;:56386,&q;episodeCount&q;:171,&q;scoreCount&q;:369,&q;avgScore&q;:9.485094850948508,&q;fiveGradeAvgScore&q;:4.74,&q;updateTime&q;:1769951409746},&q;auditionEpisode&q;:{&q;episodeTitle&q;:&q;个人展示课&q;,&q;episodeVideoUrl&q;:&q;https://vod.fbstatic.cn/22e9ceb2vodbj1251001446/cdcd208f1397757888023754303/1Gdmjad6mt8A.mp4?t=f2a4b300&a;us=4070880000&a;sign=56553ea9151bf559787449a83a34d47b&q;},&q;memberOfCPC&q;:false,&q;tags&q;:null},{&q;id&q;:64007,&q;userId&q;:54668660,&q;name&q;:&q;姚雨言&q;,&q;brief&q;:&q;粉笔优质讲师&q;,&q;desc&q;:&q;粉笔优质讲师\n一线教学经验丰富，承担事业单位线上线下各类课程：如笔试精讲、刷题、拔高、冲刺等阶段；\n参与事业单位真题解析和模拟题撰写工作，能够把握命题人思维，能够结合命题人思维和学生思维，做到双向把握；\n兼具幽默的授课风格和严谨的逻辑思维，寓教于乐中传授判断技巧，多维关注中攻克学习壁垒，始终把学员学习的事当作自己的事，深受学生喜爱。&q;,&q;avatar&q;:&q;1945f3d73434704.jpg&q;,&q;upperBodyPhoto&q;:null,&q;displayCoursePrefix&q;:&q;sydw&q;,&q;teacherStat&q;:{&q;teacherId&q;:64007,&q;episodeCount&q;:589,&q;scoreCount&q;:1397,&q;avgScore&q;:9.365783822476725,&q;fiveGradeAvgScore&q;:4.68,&q;updateTime&q;:1773568406538},&q;auditionEpisode&q;:{&q;episodeTitle&q;:&q;个人展示课&q;,&q;episodeVideoUrl&q;:&q;https://vod.fbstatic.cn/22e9ceb2vodbj1251001446/2b4fc3451397757890101326227/usEitiGCa8gA.mp4?t=f2a4b300&a;us=4070880000&a;sign=7332cda439b401241158abd03efa5e47&q;},&q;memberOfCPC&q;:false,&q;tags&q;:null},{&q;id&q;:64008,&q;userId&q;:62894300,&q;name&q;:&q;周芸枫&q;,&q;brief&q;:&q;粉笔优质讲师&q;,&q;desc&q;:&q;粉笔优质讲师\n授课风格:注重实战技巧，理论扎实，讲解细致，学员成绩提升显著\n授课经验丰富，从事公考培训六年时间，累计授课时长8000+小时，深受学员喜爱\n具有创新性和开拓性，能够独立研发课程和理论体系，编写制作讲义以及模拟卷和解析制作。&q;,&q;avatar&q;:&q;191e5a135d2bb31.jpg&q;,&q;upperBodyPhoto&q;:null,&q;displayCoursePrefix&q;:&q;sydw&q;,&q;teacherStat&q;:{&q;teacherId&q;:64008,&q;episodeCount&q;:211,&q;scoreCount&q;:371,&q;avgScore&q;:9.423180592991912,&q;fiveGradeAvgScore&q;:4.71,&q;updateTime&q;:1756469989545},&q;auditionEpisode&q;:{&q;episodeTitle&q;:&q;试听课时&q;,&q;episodeVideoUrl&q;:&q;https://vod.fbstatic.cn/22e9ceb2vodbj1251001446/dd3ef6d21397757890205754167/lInZYbbscFoA.mp4?t=f2a4b300&a;us=4070880000&a;sign=d5daf4fa4bb88b0ed33cf083e8478b11&q;},&q;memberOfCPC&q;:false,&q;tags&q;:null},{&q;id&q;:63611,&q;userId&q;:58899236,&q;name&q;:&q;白薇薇&q;,&q;brief&q;:&q;粉笔优质讲师&q;,&q;desc&q;:&q;粉笔优质教师\n拥有7年综应科目一线教学经验，毕业于双一流高校，长期专注于事业单位综应A/B、申论的授课与研究，善于帮助学员系统提升应试能力。深入钻研国省考及联考综应及申论命题规律，多次参与笔试教研与题目命制，独立撰写多篇内部教研资料，持续跟踪考情动态，为教学注入扎实的理论与实践依据。累计授课8000+课时，擅长以轻松易懂的方式讲解复杂题型，注重从考生视角出发，提炼高效实用的解题方法与技巧。课堂氛围积极，学员反馈良好，口碑持续领先，致力于让每位学生获得清晰、可落地的学习提升。&q;,&q;avatar&q;:&q;191e986ee694dfb.jpg&q;,&q;upperBodyPhoto&q;:null,&q;displayCoursePrefix&q;:&q;sydw&q;,&q;teacherStat&q;:{&q;teacherId&q;:63611,&q;episodeCount&q;:465,&q;scoreCount&q;:597,&q;avgScore&q;:9.333333333333325,&q;fiveGradeAvgScore&q;:4.67,&q;updateTime&q;:1769766321538},&q;auditionEpisode&q;:{&q;episodeTitle&q;:&q;个人展示课&q;,&q;episodeVideoUrl&q;:&q;https://vod.fbstatic.cn/22e9ceb2vodbj1251001446/804e05425145403709544619271/9PT8iriA2a0A.mp4?t=f2a4b300&a;us=4070880000&a;sign=4f2616e5434215789c4917fa2aec237c&q;},&q;memberOfCPC&q;:false,&q;tags&q;:null},{&q;id&q;:64241,&q;userId&q;:94114835,&q;name&q;:&q;江岸&q;,&q;brief&q;:&q;粉笔优质讲师&q;,&q;desc&q;:&q;粉笔优质教师\n4年一线教学授课经验，具有判断科目丰富的实践经验及系统扎实的专业理论知识，对江苏考情深入研究；撰写多篇事业单位笔试职测判断教研材料，在粉笔笔试教师内部进行共享；多次参加粉笔授课研讨会议，全面把握事业单位职测命题趋势及最新考情，积累丰富理论知识；具有激情且幽默的授课风格，让学生在轻松的学习氛围中，用更简单的方法，找到更快捷的解题之道，深受广大学员的认可和好评；在学员中具有非常好的口碑。&q;,&q;avatar&q;:&q;1921cc3618774fe.jpg&q;,&q;upperBodyPhoto&q;:null,&q;displayCoursePrefix&q;:&q;sydw&q;,&q;teacherStat&q;:{&q;teacherId&q;:64241,&q;episodeCount&q;:662,&q;scoreCount&q;:825,&q;avgScore&q;:9.21212121212121,&q;fiveGradeAvgScore&q;:4.61,&q;updateTime&q;:1773555193575},&q;auditionEpisode&q;:{&q;episodeTitle&q;:&q;个人展示课&q;,&q;episodeVideoUrl&q;:&q;https://vod.fbstatic.cn/22e9ceb2vodbj1251001446/82a0801e5145403709544714604/LbHaOjpCQHIA.mp4?t=f2a4b300&a;us=4070880000&a;sign=a70170838675f9f5bfac5511ceacffc2&q;},&q;memberOfCPC&q;:false,&q;tags&q;:null},{&q;id&q;:64221,&q;userId&q;:93507673,&q;name&q;:&q;愉悦&q;,&q;brief&q;:&q;粉笔优质讲师&q;,&q;desc&q;:&q;粉笔优质讲师\n4年一线教学经验，线上线下累计授课时长千余小时，授课学员累计超2千名，授课经验丰富，授课涵盖精品班、刷题班、冲刺班等多种核心班型，实战教学功底扎实；理论知识扎实专业，深入参与粉笔授课研讨和教研开发工作，熟悉命题特点及做题技巧。深耕教学一线，讲解耐心细致，能够帮助学生培养解题能力、擅长引导学生提升构建分析思路，针对不同学生的做题习惯和性格特点做到因材施教，课堂氛围轻松活跃，深受学生喜爱。&q;,&q;avatar&q;:&q;1945f3e00e265fc.jpg&q;,&q;upperBodyPhoto&q;:null,&q;displayCoursePrefix&q;:&q;sydw&q;,&q;teacherStat&q;:{&q;teacherId&q;:64221,&q;episodeCount&q;:612,&q;scoreCount&q;:523,&q;avgScore&q;:9.25047801147226,&q;fiveGradeAvgScore&q;:4.63,&q;updateTime&q;:1773374429765},&q;auditionEpisode&q;:{&q;episodeTitle&q;:&q;个人展示课&q;,&q;episodeVideoUrl&q;:&q;https://vod.fbstatic.cn/22e9ceb2vodbj1251001446/48e2d0af1397757890251845324/9NqyfZLKGAoA.mp4?t=f2a4b300&a;us=4070880000&a;sign=40d904973e9a1a669ad07b969805ee1a&q;},&q;memberOfCPC&q;:false,&q;tags&q;:null},{&q;id&q;:65355,&q;userId&q;:141196510,&q;name&q;:&q;贺诗意&q;,&q;brief&q;:&q;粉笔优质讲师&q;,&q;desc&q;:&q;粉笔优质教师\n1.五年一线教学授课经验。\n2.公职经历：曾在四川省经济和信息化厅下属事业单位就职二年\n3.内部工作经历：\n①撰写多篇事业单位笔试教研材料和题库习题编辑，在粉笔笔试教师内部进行共享；\n②多次参加粉笔授课研讨会，全面把握事业单位笔试命题趋势及最新考情；\n③多次参加粉笔教研活动，分享授课经验，助力粉笔理论研发升级。\n4.教学风格：法律基础知识扎实，善于将知识化繁为简，化难为易，帮助学员解决理论难题。&q;,&q;avatar&q;:&q;1945f29d2532ac8.jpg&q;,&q;upperBodyPhoto&q;:null,&q;displayCoursePrefix&q;:&q;sydw&q;,&q;teacherStat&q;:{&q;teacherId&q;:65355,&q;episodeCount&q;:146,&q;scoreCount&q;:112,&q;avgScore&q;:8.303571428571429,&q;fiveGradeAvgScore&q;:4.15,&q;updateTime&q;:1773579551681},&q;auditionEpisode&q;:{&q;episodeTitle&q;:&q;个人展示课&q;,&q;episodeVideoUrl&q;:&q;https://vod.fbstatic.cn/22e9ceb2vodbj1251001446/b89a06dd1397757912605549987/l1kvXYxtfLkA.mp4?t=f2a4b300&a;us=4070880000&a;sign=6d89f1bb77d95131b48487582a5dcac8&q;},&q;memberOfCPC&q;:false,&q;tags&q;:null}],&q;lectureStat&q;:{&q;lectureId&q;:726825,&q;playStatus&q;:1,&q;freeAddedStudentCount&q;:0,&q;classMinutes&q;:118079,&q;classStartTime&q;:1735783200000,&q;classStopTime&q;:1801303200000,&q;playProgress&q;:0.5,&q;updateTime&q;:1769567774647},&q;catIds&q;:[],&q;teachChannel&q;:1,&q;examType&q;:0,&q;typeFlags&q;:{&q;systemLecture&q;:false,&q;interviewLecture&q;:false,&q;writtenLecture&q;:false,&q;writtenSmallClassLecture&q;:false,&q;writtenOfflineLecture&q;:false,&q;smallClassLecture&q;:false},&q;examSeason&q;:null,&q;needAgreement&q;:false,&q;bestDiscount&q;:null,&q;discounts&q;:[],&q;buyLimit&q;:null,&q;grouponRule&q;:null,&q;apeCourseId&q;:1,&q;tradeUnit&q;:0,&q;distributionId&q;:-1,&q;dealPlanId&q;:-1,&q;productType&q;:{&q;type&q;:7,&q;name&q;:&q;0元课&q;},&q;contentHighlights&q;:[],&q;specialIdentities&q;:[],&q;kePrefix&q;:&q;sydw&q;,&q;imageBrief&q;:null,&q;hasRedirectInstructorAfterPaid&q;:true,&q;commentTargetId&q;:0,&q;promotionMedias&q;:[],&q;keFuConfig&q;:{&q;hasOnlineChat&q;:true,&q;hasPhoneSupport&q;:false,&q;hasWechatInstructor&q;:false,&q;schoolKeFuConfig&q;:{&q;id&q;:0,&q;schoolId&q;:0,&q;courseId&q;:0,&q;wechatInstructorUrl&q;:&q;&q;,&q;messageEnable&q;:false,&q;udeskGroupId&q;:&q;&q;,&q;udeskPhone&q;:&q;&q;}},&q;episodes&q;:[{&q;id&q;:11346015,&q;kePrefix&q;:&q;sydw&q;,&q;courseId&q;:6,&q;status&q;:3,&q;playStatus&q;:3,&q;type&q;:33,&q;recordingType&q;:0,&q;mediaType&q;:0,&q;title&q;:&q;【数资】精选好题 沉浸刷题&q;,&q;innerTitle&q;:&q;&q;,&q;startTime&q;:1766808000000,&q;endTime&q;:1766815200000,&q;teacher&q;:{&q;id&q;:18293,&q;userId&q;:67808406,&q;name&q;:&q;任忠生&q;,&q;brief&q;:&q;粉笔优质讲师&q;,&q;desc&q;:&q;粉笔优质讲师\n6年一线教学经验，承担过线上线下多种课程，授课经验丰富，深受学员喜爱，累计授课评分4.9分。\n授课思路清晰，风趣幽默，妙语连珠，课堂中知识与段子齐飞，答题声与欢笑声连成一片，课堂氛围极佳。\n定期参加粉笔笔试教研，多次参与真题解析以及真题解析视频录制，对笔试理论体系有深入的研究，了解最新命题趋势方向。&q;,&q;avatar&q;:&q;193b4b22415b966.jpg&q;,&q;upperBodyPhoto&q;:null,&q;displayCoursePrefix&q;:&q;sydw&q;,&q;teacherStat&q;:{&q;teacherId&q;:18293,&q;episodeCount&q;:418,&q;scoreCount&q;:1609,&q;avgScore&q;:9.794903666873825,&q;fiveGradeAvgScore&q;:4.9,&q;updateTime&q;:1773490915782},&q;auditionEpisode&q;:{&q;episodeTitle&q;:&q;个人展示课&q;,&q;episodeVideoUrl&q;:&q;https://vod.fbstatic.cn/22e9ceb2vodbj1251001446/bfb29f3c5145403709545073450/6OUlHaE0u2UA.mp4?t=f2a4b300&a;us=4070880000&a;sign=4672d88aaa0f986bf84441ae77d619a3&q;},&q;memberOfCPC&q;:false,&q;tags&q;:null},&q;teachChannel&q;:1,&q;offline&q;:null,&q;duration&q;:7493,&q;hasAudition&q;:false,&q;bizType&q;:0,&q;bizId&q;:&q;726825&q;,&q;supportReplay&q;:true,&q;extraInfo&q;:null,&q;liveConfig&q;:{&q;episodeId&q;:11346015,&q;supportMultiGroup&q;:false,&q;exerciseBizType&q;:0,&q;videoDisplayType&q;:0,&q;avForwardType&q;:0,&q;useIntelligentRoom&q;:false,&q;hasStrokeKeynote&q;:true,&q;verticalModeType&q;:0,&q;originEpisodeId&q;:0,&q;supportRtmp&q;:false,&q;supportPk&q;:true,&q;supportLuckyBag&q;:true,&q;supportUserNoteStroke&q;:false,&q;communicateType&q;:0,&q;one2One&q;:false,&q;fakeLive&q;:false},&q;validStatus&q;:1,&q;supportLive&q;:true,&q;supportAiCatalog&q;:false,&q;hasIntelligentPen&q;:false,&q;useLocalRecording&q;:false,&q;useIntelligentRoom&q;:false,&q;hasSalePosition&q;:false,&q;hasEpisodeCards&q;:true,&q;lockedForShouna&q;:false,&q;needSignIn&q;:false,&q;needTeacherSignIn&q;:false,&q;enablePadPencil&q;:true,&q;displayExercise&q;:false,&q;supportLuckyBag&q;:true,&q;supportLivePk&q;:true},{&q;id&q;:11346019,&q;kePrefix&q;:&q;sydw&q;,&q;courseId&q;:6,&q;status&q;:3,&q;playStatus&q;:3,&q;type&q;:33,&q;recordingType&q;:0,&q;mediaType&q;:0,&q;title&q;:&q;【判断】精选好题  沉浸刷题&q;,&q;innerTitle&q;:&q;&q;,&q;startTime&q;:1766887200000,&q;endTime&q;:1766894400000,&q;teacher&q;:{&q;id&q;:56385,&q;use