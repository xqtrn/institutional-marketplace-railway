onfig&q;:{&q;episodeId&q;:10475138,&q;supportMultiGroup&q;:false,&q;exerciseBizType&q;:0,&q;videoDisplayType&q;:0,&q;avForwardType&q;:0,&q;useIntelligentRoom&q;:false,&q;hasStrokeKeynote&q;:true,&q;verticalModeType&q;:0,&q;originEpisodeId&q;:0,&q;supportRtmp&q;:false,&q;supportPk&q;:true,&q;supportLuckyBag&q;:true,&q;supportUserNoteStroke&q;:false,&q;communicateType&q;:0,&q;one2One&q;:false,&q;fakeLive&q;:false},&q;validStatus&q;:1,&q;supportLive&q;:true,&q;supportAiCatalog&q;:false,&q;hasIntelligentPen&q;:false,&q;useLocalRecording&q;:false,&q;useIntelligentRoom&q;:false,&q;hasSalePosition&q;:false,&q;hasEpisodeCards&q;:true,&q;lockedForShouna&q;:false,&q;needSignIn&q;:false,&q;needTeacherSignIn&q;:false,&q;enablePadPencil&q;:true,&q;displayExercise&q;:false,&q;supportLuckyBag&q;:true,&q;supportLivePk&q;:true},{&q;id&q;:10475140,&q;kePrefix&q;:&q;sydw&q;,&q;courseId&q;:6,&q;status&q;:3,&q;playStatus&q;:3,&q;type&q;:33,&q;recordingType&q;:0,&q;mediaType&q;:0,&q;title&q;:&q;【综应】精选好题 沉浸刷题&q;,&q;innerTitle&q;:&q;&q;,&q;startTime&q;:1744610400000,&q;endTime&q;:1744617600000,&q;teacher&q;:{&q;id&q;:35873,&q;userId&q;:83868400,&q;name&q;:&q;张雪峰&q;,&q;brief&q;:&q;粉笔优质讲师&q;,&q;desc&q;:&q;粉笔优质讲师\n6年一线教学经验，曾就职于省级科研院所。师资中心学科组长及其他项目负责人，累计服务学员数千人，注重学员考场实战思维的培养，辅导数名学员笔面第一成功上岸；\n承担各种线上线下授课任务，累计授课超过1000小时；\n长期参与粉笔内部教研工作，定期参与模拟题撰写、真题解析等，对于各类考试考情、考试重点有深入了解；\n授课风格上，风趣幽默、生动有趣、讲解细致、通俗易懂、富有亲和力；\n授课方式上，深入浅出、逻辑清晰、技巧性强、重点明确、化繁为简。深受学员喜爱与好评。&q;,&q;avatar&q;:&q;19854136e94d1f4.jpg&q;,&q;upperBodyPhoto&q;:null,&q;displayCoursePrefix&q;:&q;sydw&q;,&q;teacherStat&q;:{&q;teacherId&q;:35873,&q;episodeCount&q;:336,&q;scoreCount&q;:610,&q;avgScore&q;:9.537704918032789,&q;fiveGradeAvgScore&q;:4.77,&q;updateTime&q;:1773405613935},&q;auditionEpisode&q;:{&q;episodeTitle&q;:&q;个人展示课&q;,&q;episodeVideoUrl&q;:&q;https://vod.fbstatic.cn/22e9ceb2vodbj1251001446/35a538255145403709543712965/oxwk7Paiwr4A.mp4?t=f2a4b300&a;us=4070880000&a;sign=97faf61ced98c6e79a4e46aa81fb41e2&q;},&q;memberOfCPC&q;:false,&q;tags&q;:null},&q;teachChannel&q;:1,&q;offline&q;:null,&q;duration&q;:7602,&q;hasAudition&q;:false,&q;bizType&q;:0,&q;bizId&q;:&q;726825&q;,&q;supportReplay&q;:true,&q;extraInfo&q;:null,&q;liveConfig&q;:{&q;episodeId&q;:10475140,&q;supportMultiGroup&q;:false,&q;exerciseBizType&q;:0,&q;videoDisplayType&q;:0,&q;avForwardType&q;:0,&q;useIntelligentRoom&q;:false,&q;hasStrokeKeynote&q;:true,&q;verticalModeType&q;:0,&q;originEpisodeId&q;:0,&q;supportRtmp&q;:false,&q;supportPk&q;:true,&q;supportLuckyBag&q;:true,&q;supportUserNoteStroke&q;:false,&q;communicateType&q;:0,&q;one2One&q;:false,&q;fakeLive&q;:false},&q;validStatus&q;:1,&q;supportLive&q;:true,&q;supportAiCatalog&q;:false,&q;hasIntelligentPen&q;:false,&q;useLocalRecording&q;:false,&q;useIntelligentRoom&q;:false,&q;hasSalePosition&q;:false,&q;hasEpisodeCards&q;:true,&q;lockedForShouna&q;:false,&q;needSignIn&q;:false,&q;needTeacherSignIn&q;:false,&q;enablePadPencil&q;:true,&q;displayExercise&q;:false,&q;supportLuckyBag&q;:true,&q;supportLivePk&q;:true},{&q;id&q;:10475177,&q;kePrefix&q;:&q;sydw&q;,&q;courseId&q;:6,&q;status&q;:3,&q;playStatus&q;:3,&q;type&q;:33,&q;recordingType&q;:0,&q;mediaType&q;:0,&q;title&q;:&q;【公基法律】精选好题 沉浸刷题&q;,&q;innerTitle&q;:&q;&q;,&q;startTime&q;:1744682400000,&q;endTime&q;:1744689600000,&q;teacher&q;:{&q;id&q;:16813,&q;userId&q;:50366016,&q;name&q;:&q;张煦昕&q;,&q;brief&q;:&q;粉笔优质讲师&q;,&q;desc&q;:&q;粉笔优质教师。\n投身教育事业6年，拥有扎实一线教学经验，对于面试内容有自己独到的见解。\n擅长运用结构化面试、情景模拟等多种方法，全面、客观地评估考生的逻辑思维、问题解决、沟通协调及抗压能力。\n授课评分累计达4.9分，授课耐心细致、严谨，循循善诱，熟悉考场答题技巧，能帮助学员理清答题思路；讲解题目逻辑性强条分缕析，善于总结方法技巧；课堂互动性强，善于通过点评帮助学生找到问题，激发学员学习热情，受到学员欢迎。&q;,&q;avatar&q;:&q;176a72cb2c6d8c4.jpg&q;,&q;upperBodyPhoto&q;:null,&q;displayCoursePrefix&q;:&q;sydw&q;,&q;teacherStat&q;:{&q;teacherId&q;:16813,&q;episodeCount&q;:466,&q;scoreCount&q;:1061,&q;avgScore&q;:9.796418473138555,&q;fiveGradeAvgScore&q;:4.9,&q;updateTime&q;:1773396064102},&q;auditionEpisode&q;:{&q;episodeTitle&q;:&q;个人展示课&q;,&q;episodeVideoUrl&q;:&q;https://vod.fbstatic.cn/22e9ceb2vodbj1251001446/3350025c5145403709543612633/AuAZazr4H98A.mp4?t=f2a4b300&a;us=4070880000&a;sign=d862836cd36bd5e4b2977a502173f189&q;},&q;memberOfCPC&q;:false,&q;tags&q;:null},&q;teachChannel&q;:1,&q;offline&q;:null,&q;duration&q;:7217,&q;hasAudition&q;:false,&q;bizType&q;:0,&q;bizId&q;:&q;726825&q;,&q;supportReplay&q;:true,&q;extraInfo&q;:null,&q;liveConfig&q;:{&q;episodeId&q;:10475177,&q;supportMultiGroup&q;:false,&q;exerciseBizType&q;:0,&q;videoDisplayType&q;:0,&q;avForwardType&q;:0,&q;useIntelligentRoom&q;:false,&q;hasStrokeKeynote&q;:true,&q;verticalModeType&q;:0,&q;originEpisodeId&q;:0,&q;supportRtmp&q;:false,&q;supportPk&q;:true,&q;supportLuckyBag&q;:true,&q;supportUserNoteStroke&q;:false,&q;communicateType&q;:0,&q;one2One&q;:false,&q;fakeLive&q;:false},&q;validStatus&q;:1,&q;supportLive&q;:true,&q;supportAiCatalog&q;:false,&q;hasIntelligentPen&q;:false,&q;useLocalRecording&q;:false,&q;useIntelligentRoom&q;:false,&q;hasSalePosition&q;:false,&q;hasEpisodeCards&q;:true,&q;lockedForShouna&q;:false,&q;needSignIn&q;:false,&q;needTeacherSignIn&q;:false,&q;enablePadPencil&q;:true,&q;displayExercise&q;:false,&q;supportLuckyBag&q;:true,&q;supportLivePk&q;:true},{&q;id&q;:10475182,&q;kePrefix&q;:&q;sydw&q;,&q;courseId&q;:6,&q;status&q;:3,&q;playStatus&q;:3,&q;type&q;:33,&q;recordingType&q;:0,&q;mediaType&q;:0,&q;title&q;:&q;【判断】精选好题 沉浸刷题&q;,&q;innerTitle&q;:&q;&q;,&q;startTime&q;:1744689600000,&q;endTime&q;:1744696800000,&q;teacher&q;:{&q;id&q;:16630,&q;userId&q;:63555782,&q;name&q;:&q;陈贺&q;,&q;brief&q;:&q;粉笔优质讲师&q;,&q;desc&q;:&q;粉笔优质教师\n6年一线教学授课经验，线上累计授课超800+小时，带班学生8000+；具有判断推理科目丰富的实践经验和系统扎实的专业理论，对山东、陕西、甘肃等各省判断推理科目的考情深入研究，全面了解命题规律及答题技巧，长期参与线上系统班和精品班的教研工作，撰写教研文章10余篇，出过近200道优质模拟题；具有幽默诙谐、形象生动、条理清晰的授课风格，让学生在轻松的学习氛围中，用更简单的方法，找到更快捷的解题之道，深受广大学员的认可和好评。&q;,&q;avatar&q;:&q;175d8f143291ec7.jpg&q;,&q;upperBodyPhoto&q;:null,&q;displayCoursePrefix&q;:&q;sydw&q;,&q;teacherStat&q;:{&q;teacherId&q;:16630,&q;episodeCount&q;:508,&q;scoreCount&q;:1860,&q;avgScore&q;:9.8516129032258,&q;fiveGradeAvgScore&q;:4.93,&q;updateTime&q;:1773584418412},&q;auditionEpisode&q;:{&q;episodeTitle&q;:&q;个人展示课&q;,&q;episodeVideoUrl&q;:&q;https://vod.fbstatic.cn/22e9ceb2vodbj1251001446/be9c21bc5145403709538211346/S3YE0Y3AIBoA.mp4?t=f2a4b300&a;us=4070880000&a;sign=aa0da2116ec32854b9c50d64d3429cec&q;},&q;memberOfCPC&q;:false,&q;tags&q;:null},&q;teachChannel&q;:1,&q;offline&q;:null,&q;duration&q;:7888,&q;hasAudition&q;:false,&q;bizType&q;:0,&q;bizId&q;:&q;726825&q;,&q;supportReplay&q;:true,&q;extraInfo&q;:null,&q;liveConfig&q;:{&q;episodeId&q;:10475182,&q;supportMultiGroup&q;:false,&q;exerciseBizType&q;:0,&q;videoDisplayType&q;:0,&q;avForwardType&q;:0,&q;useIntelligentRoom&q;:false,&q;hasStrokeKeynote&q;:true,&q;verticalModeType&q;:0,&q;originEpisodeId&q;:0,&q;supportRtmp&q;:false,&q;supportPk&q;:true,&q;supportLuckyBag&q;:true,&q;supportUserNoteStroke&q;:false,&q;communicateType&q;:0,&q;one2One&q;:false,&q;fakeLive&q;:false},&q;validStatus&q;:1,&q;supportLive&q;:true,&q;supportAiCatalog&q;:false,&q;hasIntelligentPen&q;:false,&q;useLocalRecording&q;:false,&q;useIntelligentRoom&q;:false,&q;hasSalePosition&q;:false,&q;hasEpisodeCards&q;:true,&q;lockedForShouna&q;:false,&q;needSignIn&q;:false,&q;needTeacherSignIn&q;:false,&q;enablePadPencil&q;:true,&q;displayExercise&q;:false,&q;supportLuckyBag&q;:true,&q;supportLivePk&q;:true},{&q;id&q;:10475183,&q;kePrefix&q;:&q;sydw&q;,&q;courseId&q;:6,&q;status&q;:3,&q;playStatus&q;:3,&q;type&q;:33,&q;recordingType&q;:0,&q;mediaType&q;:0,&q;title&q;:&q;【综应】精选好题 沉浸刷题&q;,&q;innerTitle&q;:&q;&q;,&q;startTime&q;:1744696800000,&q;endTime&q;:1744704000000,&q;teacher&q;:{&q;id&q;:35889,&q;userId&q;:59452309,&q;name&q;:&q;王昭媛&q;,&q;brief&q;:&q;粉笔优质讲师&q;,&q;desc&q;:&q;粉笔优质讲师\n985院校硕士毕业，投身教育事业6年，拥有扎实一线教学经验。多次参与真题解析以及真题解析视频录制，积累大量实用经验，对各省份考情深入钻研，精准把握各地考试要点。\n授课思路清晰，熟练掌握各类题型的作答技巧，理论扎实，逻辑清晰，重点突出，耐心细致，在教学过程中因材施教，采用启发式教学法，激发学员的学习兴趣与思考能力。\n承担各种线上线下授课任务，累计服务学员上千人，授课超1000小时，累计评分达4.9分。始终秉持着“以学员为中心”的教学理念，在教学过程中因材施教，并能及时跟进学员的学习进度，耐心解答学员的疑问，为学员提供个性化的辅导与建议，深受学员喜爱。&q;,&q;a