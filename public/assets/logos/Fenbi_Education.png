e&q;:0,&q;bizId&q;:&q;726825&q;,&q;supportReplay&q;:true,&q;extraInfo&q;:null,&q;liveConfig&q;:{&q;episodeId&q;:10787765,&q;supportMultiGroup&q;:false,&q;exerciseBizType&q;:0,&q;videoDisplayType&q;:0,&q;avForwardType&q;:0,&q;useIntelligentRoom&q;:false,&q;hasStrokeKeynote&q;:true,&q;verticalModeType&q;:0,&q;originEpisodeId&q;:0,&q;supportRtmp&q;:false,&q;supportPk&q;:true,&q;supportLuckyBag&q;:true,&q;supportUserNoteStroke&q;:false,&q;communicateType&q;:0,&q;one2One&q;:false,&q;fakeLive&q;:false},&q;validStatus&q;:1,&q;supportLive&q;:true,&q;supportAiCatalog&q;:false,&q;hasIntelligentPen&q;:false,&q;useLocalRecording&q;:false,&q;useIntelligentRoom&q;:false,&q;hasSalePosition&q;:false,&q;hasEpisodeCards&q;:true,&q;lockedForShouna&q;:false,&q;needSignIn&q;:false,&q;needTeacherSignIn&q;:false,&q;enablePadPencil&q;:true,&q;displayExercise&q;:false,&q;supportLuckyBag&q;:true,&q;supportLivePk&q;:true},{&q;id&q;:10787788,&q;kePrefix&q;:&q;sydw&q;,&q;courseId&q;:6,&q;status&q;:3,&q;playStatus&q;:3,&q;type&q;:33,&q;recordingType&q;:0,&q;mediaType&q;:0,&q;title&q;:&q;【综应】精选好题 沉浸刷题&q;,&q;innerTitle&q;:&q;&q;,&q;startTime&q;:1749708000000,&q;endTime&q;:1749715200000,&q;teacher&q;:{&q;id&q;:35908,&q;userId&q;:81360450,&q;name&q;:&q;林雨晴&q;,&q;brief&q;:&q;粉笔优质讲师&q;,&q;desc&q;:&q;粉笔优质讲师\n6年一线教学经验，辅导学员数千人，承接各类线上线下精品班，善于从考官思维审视题目，助力多位学员高分上岸；累计授课时长超千个小时，累计授课评分4.9分，深受学员认可；\n长期参与笔试教研工作，定期参与模拟题撰写、真题解析录制等，对最新命题方向、考试重点有深入研究；\n授课风格严谨而不乏幽默，擅长为学员量身定制有效提升解题能力的授课方案，让学员轻松掌握科目本质，目标明确针对提分。&q;,&q;avatar&q;:&q;193b4909bf0801c.jpg&q;,&q;upperBodyPhoto&q;:null,&q;displayCoursePrefix&q;:&q;sydw&q;,&q;teacherStat&q;:{&q;teacherId&q;:35908,&q;episodeCount&q;:324,&q;scoreCount&q;:674,&q;avgScore&q;:9.866468842729965,&q;fiveGradeAvgScore&q;:4.93,&q;updateTime&q;:1773546577229},&q;auditionEpisode&q;:{&q;episodeTitle&q;:&q;个人展示课&q;,&q;episodeVideoUrl&q;:&q;https://vod.fbstatic.cn/22e9ceb2vodbj1251001446/33875c205145403709543644434/6gvJN35dXAIA.mp4?t=f2a4b300&a;us=4070880000&a;sign=c135dd3259c53c86cfd11d55836ec0b2&q;},&q;memberOfCPC&q;:false,&q;tags&q;:null},&q;teachChannel&q;:1,&q;offline&q;:null,&q;duration&q;:7362,&q;hasAudition&q;:false,&q;bizType&q;:0,&q;bizId&q;:&q;726825&q;,&q;supportReplay&q;:true,&q;extraInfo&q;:null,&q;liveConfig&q;:{&q;episodeId&q;:10787788,&q;supportMultiGroup&q;:false,&q;exerciseBizType&q;:0,&q;videoDisplayType&q;:0,&q;avForwardType&q;:0,&q;useIntelligentRoom&q;:false,&q;hasStrokeKeynote&q;:true,&q;verticalModeType&q;:0,&q;originEpisodeId&q;:0,&q;supportRtmp&q;:false,&q;supportPk&q;:true,&q;supportLuckyBag&q;:true,&q;supportUserNoteStroke&q;:false,&q;communicateType&q;:0,&q;one2One&q;:false,&q;fakeLive&q;:false},&q;validStatus&q;:1,&q;supportLive&q;:true,&q;supportAiCatalog&q;:false,&q;hasIntelligentPen&q;:false,&q;useLocalRecording&q;:false,&q;useIntelligentRoom&q;:false,&q;hasSalePosition&q;:false,&q;hasEpisodeCards&q;:true,&q;lockedForShouna&q;:false,&q;needSignIn&q;:false,&q;needTeacherSignIn&q;:false,&q;enablePadPencil&q;:true,&q;displayExercise&q;:false,&q;supportLuckyBag&q;:true,&q;supportLivePk&q;:true},{&q;id&q;:10831578,&q;kePrefix&q;:&q;sydw&q;,&q;courseId&q;:6,&q;status&q;:3,&q;playStatus&q;:3,&q;type&q;:33,&q;recordingType&q;:0,&q;mediaType&q;:0,&q;title&q;:&q;【言语】精选好题 沉浸刷题&q;,&q;innerTitle&q;:&q;&q;,&q;startTime&q;:1749715200000,&q;endTime&q;:1749722400000,&q;teacher&q;:{&q;id&q;:16735,&q;userId&q;:46275516,&q;name&q;:&q;郭孟楠&q;,&q;brief&q;:&q;粉笔优质讲师&q;,&q;desc&q;:&q;粉笔优质讲师\n5年一线教学经验，对言语理解与表达的命题趋势和解题技巧有着精准的把握。在教学过程中，注重培养学生的语言敏感度和逻辑思维能力，通过系统的知识讲解和大量的真题演练，帮助学生快速掌握解题技巧，提高答题速度和准确率。注重启发式教学，能够及时发现并解决学生在学习过程中遇到的问题，适合各个阶段的学习并深受学员喜爱。&q;,&q;avatar&q;:&q;1746be4c31acce6.jpg&q;,&q;upperBodyPhoto&q;:null,&q;displayCoursePrefix&q;:&q;sydw&q;,&q;teacherStat&q;:{&q;teacherId&q;:16735,&q;episodeCount&q;:386,&q;scoreCount&q;:5679,&q;avgScore&q;:9.730938545518592,&q;fiveGradeAvgScore&q;:4.87,&q;updateTime&q;:1773371290044},&q;auditionEpisode&q;:{&q;episodeTitle&q;:&q;个人展示课&q;,&q;episodeVideoUrl&q;:&q;https://vod.fbstatic.cn/22e9ceb2vodbj1251001446/cf4aa7181397757903434929665/eDPwMVOaVQcA.mp4?t=f2a4b300&a;us=4070880000&a;sign=32ab41a3d56b67eb4d07d67b2bdb9cc6&q;},&q;memberOfCPC&q;:false,&q;tags&q;:null},&q;teachChannel&q;:1,&q;offline&q;:null,&q;duration&q;:6121,&q;hasAudition&q;:false,&q;bizType&q;:0,&q;bizId&q;:&q;726825&q;,&q;supportReplay&q;:true,&q;extraInfo&q;:null,&q;liveConfig&q;:{&q;episodeId&q;:10831578,&q;supportMultiGroup&q;:false,&q;exerciseBizType&q;:0,&q;videoDisplayType&q;:0,&q;avForwardType&q;:0,&q;useIntelligentRoom&q;:false,&q;hasStrokeKeynote&q;:true,&q;verticalModeType&q;:0,&q;originEpisodeId&q;:0,&q;supportRtmp&q;:false,&q;supportPk&q;:true,&q;supportLuckyBag&q;:true,&q;supportUserNoteStroke&q;:false,&q;communicateType&q;:0,&q;one2One&q;:false,&q;fakeLive&q;:false},&q;validStatus&q;:1,&q;supportLive&q;:true,&q;supportAiCatalog&q;:false,&q;hasIntelligentPen&q;:false,&q;useLocalRecording&q;:false,&q;useIntelligentRoom&q;:false,&q;hasSalePosition&q;:false,&q;hasEpisodeCards&q;:true,&q;lockedForShouna&q;:false,&q;needSignIn&q;:false,&q;needTeacherSignIn&q;:false,&q;enablePadPencil&q;:true,&q;displayExercise&q;:false,&q;supportLuckyBag&q;:true,&q;supportLivePk&q;:true},{&q;id&q;:10789946,&q;kePrefix&q;:&q;sydw&q;,&q;courseId&q;:6,&q;status&q;:3,&q;playStatus&q;:3,&q;type&q;:33,&q;recordingType&q;:0,&q;mediaType&q;:0,&q;title&q;:&q;【判断】精选好题 沉浸刷题&q;,&q;innerTitle&q;:&q;&q;,&q;startTime&q;:1749780000000,&q;endTime&q;:1749787200000,&q;teacher&q;:{&q;id&q;:25998,&q;userId&q;:74893882,&q;name&q;:&q;卜晓&q;,&q;brief&q;:&q;粉笔优质讲师&q;,&q;desc&q;:&q;粉笔优质教师\n6年一线教学授课经验，具有判断科目丰富的实践经验及系统扎实的专业理论知识。多次参加粉笔授课研讨会议，全面把握公考笔试命题趋势及最新考情，积累丰富的笔试知识。\n授课风格形象生动、条理清晰，让学生在轻松的学习氛围中，用更简单的方法，找到更快捷的解题之道，深受广大学员的认可和好评；在学员中具有非常好的口碑，是值得信赖的好导师。&q;,&q;avatar&q;:&q;1983b0eb4544784.jpg&q;,&q;upperBodyPhoto&q;:null,&q;displayCoursePrefix&q;:&q;sydw&q;,&q;teacherStat&q;:{&q;teacherId&q;:25998,&q;episodeCount&q;:241,&q;scoreCount&q;:956,&q;avgScore&q;:9.822175732217573,&q;fiveGradeAvgScore&q;:4.91,&q;updateTime&q;:1772456165442},&q;auditionEpisode&q;:{&q;episodeTitle&q;:&q;个人展示课&q;,&q;episodeVideoUrl&q;:&q;https://vod.fbstatic.cn/22e9ceb2vodbj1251001446/66f828ce1397757903436832264/gWy20rAOGRMA.mp4?t=f2a4b300&a;us=4070880000&a;sign=80068e51d1010737ea53aef5d97ef1a4&q;},&q;memberOfCPC&q;:false,&q;tags&q;:null},&q;teachChannel&q;:1,&q;offline&q;:null,&q;duration&q;:7479,&q;hasAudition&q;:false,&q;bizType&q;:0,&q;bizId&q;:&q;726825&q;,&q;supportReplay&q;:true,&q;extraInfo&q;:null,&q;liveConfig&q;:{&q;episodeId&q;:10789946,&q;supportMultiGroup&q;:false,&q;exerciseBizType&q;:0,&q;videoDisplayType&q;:0,&q;avForwardType&q;:0,&q;useIntelligentRoom&q;:false,&q;hasStrokeKeynote&q;:true,&q;verticalModeType&q;:0,&q;originEpisodeId&q;:0,&q;supportRtmp&q;:false,&q;supportPk&q;:true,&q;supportLuckyBag&q;:true,&q;supportUserNoteStroke&q;:false,&q;communicateType&q;:0,&q;one2One&q;:false,&q;fakeLive&q;:false},&q;validStatus&q;:1,&q;supportLive&q;:true,&q;supportAiCatalog&q;:false,&q;hasIntelligentPen&q;:false,&q;useLocalRecording&q;:false,&q;useIntelligentRoom&q;:false,&q;hasSalePosition&q;:false,&q;hasEpisodeCards&q;:true,&q;lockedForShouna&q;:false,&q;needSignIn&q;:false,&q;needTeacherSignIn&q;:false,&q;enablePadPencil&q;:true,&q;displayExercise&q;:false,&q;supportLuckyBag&q;:true,&q;supportLivePk&q;:true},{&q;id&q;:10789949,&q;kePrefix&q;:&q;sydw&q;,&q;courseId&q;:6,&q;status&q;:3,&q;playStatus&q;:3,&q;type&q;:33,&q;recordingType&q;:0,&q;mediaType&q;:0,&q;title&q;:&q;【综应】精选好题 沉浸刷题&q;,&q;innerTitle&q;:&q;&q;,&q;startTime&q;:1749787200000,&q;endTime&q;:1749794400000,&q;teacher&q;:{&q;id&q;:35912,&q;userId&q;:84301173,&q;name&q;:&q;黄迟驰&q;,&q;brief&q;:&q;粉笔优质讲师&q;,&q;desc&q;:&q;粉笔优质讲师\n投身教育事业5年，拥有扎实一线教学经验。承接过各省份笔试系统班，刷题冲刺营，冲刺营，刷题营等班型，服务过近千名学员。参与题库解析课录制，综应一对一课程，综应刷题课。深耕事业单位考试，全面了解事业单位综合应用能力科目考试的命题规律及答题技巧。针对学生困惑研究教学策略，深入研讨最新考情。注重自我提升，每年度多次参加培训学习和综应科目教研，并取得优异成绩。积极分享经验心得，助力粉笔理论研发持续升级，积累丰富笔试理论知识。注重理论与实践相结合，让学生在轻松的学习氛围中，用更简单的方法，找到更快捷的解题之道，深受学员的认可和好评。&q;,&q;avatar&q;:&q;193af66b81fc0b1.jpg&q;,&q;upperBodyPhoto&q;:null,&q;displayCoursePrefix&q;:&q;sydw&q;,&q;teacherStat&q;:{&q;teacherId&q;:35912,&q;episodeCount&q;:195,&q;scoreCount&q;:305,&q;avgScore&q;:9.947540983606558,&q;fiveGradeAvgScore&q;:4.97,&q;updateTime&q;:1773557231120},&q;auditionEpisode&q;:{&q;episodeTitle&q;:&q;个人展示课&q;,&q;episodeVideoUrl&q;:&q;https://vod.fbstatic.cn/22e9ceb2vodbj1251001446/ba2b7e275145403709538047971/m0NVEgAoIxsA.mp4?t=f2a4b300&a;us=4070880000&a;sign=90823bb2aa3547011e7a0d5700585e7c&q;},&q;memberOfCPC&q;:false,&q;tags&q;:null},&q;teachChannel&q;:1,&q;offline&q;:null,&q;duration&q;:7473,&q;hasAudition&q;:false,&q;bizType&q;:0,&q;bizId&q;:&q;726825&q;,&q;supportReplay&q;:true,&q;extraInfo&q;:null,&q;liveConfig&q;:{&q;episodeId&q;:10789949,&q;supportMultiGroup&q;:false,&q;exerciseBizType&q;:0,&q;videoDisplayType&q;:0,&q;avForwardType&q;:0,&q;useIntelligentRoom&q;:false,&q;hasStrokeKeynote&q;:true,&q;verticalModeType&q;:0,&q;originEpisodeId&q;:0,&q;supportRtmp&q;:false,&q;supportPk&q;:true,&q;supportLuckyBag&q;:true,&q;supportUserNoteStroke&q;:false,&q;communicateType&q;:0,&q;one2One&q;:false,&q;fakeLive&q;:false},&q;validStatus&q;:1,&q;supportLive&q;:true,&q;supportAiCatalog&q;:false,&q;hasIntelligentPen&q;:false,&q;useLocalRecording&q;:false,&q;useIntelligentRoom&q;:false,&q;hasSalePosition&q;:false,&q;hasEpisodeCards&q;:true,&q;lockedForShouna&q;:false,&q;needSignIn&q;:false,&q;needTeacherSignIn&q;:false,&q;enablePadPencil&q;:true,&q;displayExercise&q;:false,&q;supportLuckyBag&q;:true,&q;supportLivePk&q;:true},{&q;id&q;:10789954,&q;kePrefix&q;:&q;sydw&q;,&q;courseId&q;:6,&q;status&q;:3,&q;playStatus&q;:3,&q;type&q;:33,&q;recordingType&q;:0,&q;mediaType&q;:0,&q;title&q;:&q;【公基非法】精选好题 沉浸刷题&q;,&q;innerTitle&q;:&q;&q;,&q;startTime&q;:1749794400000,&q;endTime&q;:1749801600000,&q;teacher&q;:{&q;id&q;:17050,&q;userId&q;:69384227,&q;name&q;:&q;刘枭&q;,&q;brief&q;:&q;粉笔优质讲师&q;,&q;desc&q;:&q;粉笔优质讲师。\n硕士毕业，从事线上常识公基科目教研授课长达6年，拥有非常丰富扎实的一线授课经验，承担多种产品类型的授课工作。\n教学上，具有常识公基非法科目丰富的实践经验及扎实的专业知识，对常识公基非法考情有着深入的研究，长期承担非法板块小模考授课，曾多次参与命制笔试真题教研和解析撰写工作，致力于研究事业单位的命题规律及答题技巧。\n授课深入浅出，举一反三，善于引导和启发学生；讲课逻辑性强条分缕析，善长归纳方法技巧；从学员角度出发解决问题，长期累计评分达4.9。细致耐心，寓教于乐，善于营造轻松愉悦的课堂氛围，深受学生喜爱。&q;,&q;avatar&q;:&q;17470a2ced5ee4c.jpg&q;,&q;upperBodyPhoto&q;:null,&q;displayCoursePrefix&q;:&q;sydw&q;,&q;teacherStat&q;:{&q;teacherId&q;:17050,&q;episodeCount&q;:730,&q;scoreCount&q;:2726,&q;avgScore&q;:9.798972853998558,&q;fiveGradeAvgScore&q;:4.9,&q;updateTime&q;:1773476302738},&q;auditionEpisode&q;:{&q;episodeTitle&q;:&q;个人展示课&q;,&q;episodeVideoUrl&q;:&q;https://vod.fbstatic.cn/22e9ceb2vodbj1251001446/9ae2fc415145403708185095920/NpmeJff4ztMA.mp4?t=f2a4b300&a;us=4070880000&a;sign=de1c4dfab32e0a94c2ae19673faed255&q;},&q;memberOfCPC&q;:false,&q;tags&q;:null},&q;teachChannel&q;:1,&q;offline&q;:null,&q;duration&q;:7933,&q;hasAudition&q;:false,&q;bizType&q;:0,&q;bizId&q;:&q;726825&q;,&q;supportReplay&q;:true,&q;extraInfo&q;:null,&q;liveConfig&q;:{&q;episodeId&q;:10789954,&q;supportMultiGroup&q;:false,&q;exerciseBizType&q;:0,&q;videoDisplayType&q;:0,&q;avForwardType&q;:0,&q;useIntelligentRoom&q;:false,&q;hasStrokeKeynote&q;:true,&q;verticalModeType&q;:0,&q;originEpisodeId&q;:0,&q;supportRtmp&q;:false,&q;supportPk&q;:true,&q;supportLuckyBag&q;:true,&q;supportUserNoteStroke&q;:false,&q;communicateType&q;:0,&q;one2One&q;:false,&q;fakeLive&q;:false},&q;validStatus&q;:1,&q;supportLive&q;:true,&q;supportAiCatalog&q;:false,&q;hasIntelligentPen&q;:false,&q;useLocalRecording&q;:false,&q;useIntelligentRoom&q;:false,&q;hasSalePosition&q;:false,&q;hasEpisodeCards&q;:true,&q;lockedForShouna&q;:false,&q;needSignIn&q;:false,&q;needTeacherSignIn&q;:false,&q;enablePadPencil&q;:true,&q;displayExercise&q;:false,&q;supportLuckyBag&q;:true,&q;supportLivePk&q;:true},{&q;id&q;:10789987,&q;kePrefix&q;:&q;sydw&q;,&q;courseId&q;:6,&q;status&q;:3,&q;playStatus&q;:3,&q;type&q;:33,&q;recordingType&q;:0,&q;mediaType&q;:0,&q;title&q;:&q;【数资】精选好题 沉浸刷题&q;,&q;innerTitle&q;:&q;&q;,&q;startTime&q;:1749801600000,&q;endTime&q;:1749808800000,&q;teacher&q;:{&q;id&q;:16722,&q;userId&q;:52232168,&q;name&q;:&q;王轶琢&q;,&q;brief&q;:&q;粉笔优质讲师&q;,&q;desc&q;:&q;粉笔优质讲师\n6年一线教学授课经验；具有数资科目丰富的实践经验及系统扎实的专业理论知识；多次参加粉笔教研活动，分享授课经验心得，助力粉笔理论研发升级；\n累计授课超过2000小时，累计评分达4.9分；授课与实战经验丰富，熟悉考场答题思维及应变技巧。\n老师授课风格：风趣幽默，灵活引导学员自主思考，激发学员学习热情和自主意识；授课逻辑性强，注重理论与实践相结合，深受学员的喜爱。&q;,&q;avatar&q;:&q;1983bddcd777cc6.jpg&q;,&q;upperBodyPhoto&q;:null,&q;displayCoursePrefix&q;:&q;sydw&q;,&q;teacherStat&q;:{&q;teacherId&q;:16722,&q;episodeCount&q;:870,&q;scoreCount&q;:2527,&q;avgScore&q;:9.784724970320534,&q;fiveGradeAvgScore&q;:4.89,&q;updateTime&q;:1773198754974},&q;auditionEpisode&q;:{&q;episodeTitle&q;:&q;个人展示课&q;,&q;episodeVideoUrl&q;:&q;https://vod.fbstatic.cn/22e9ceb2vodbj1251001446/9ebc23c15145403707375528343/mutMbTelffgA.mp4?t=f2a4b300&a;us=4070880000&a;sign=fa18dfaff16469d1f41c7e7cebb5b1a6&q;},&q;memberOfCPC&q;:false,&q;tags&q;:null},&q;teachChannel&q;:1,&q;offline&q;:null,&q;duration&q;:7180,&q;hasAudition&q;:false,&q;bizType&q;:0,&q;bizId&q;:&q;726825&q;,&q;supportReplay&q;:true,&q;extraInfo&q;:null,&q;liveConfig&q;:{&q;episodeId&q;:10789987,&q;supportMultiGroup&q;:false,&q;exerciseBizType&q;:0,&q;videoDisplayType&q;:0,&q;avForwardType&q;:0,&q;useIntelligentRoom&q;:false,&q;hasStrokeKeynote&q;:true,&q;verticalModeType&q;:0,&q;originEpisodeId&q;:0,&q;supportRtmp&q;:false,&q;supportPk&q;:true,&q;supportLuckyBag&q;:true,&q;supportUserNoteStroke&q;:false,&q;communicateType&q;:0,&q;one2One&q;:false,&q;fakeLive&q;:false},&q;validStatus&q;:1,&q;supportLive&q;:true,&q;supportAiCatalog&q;:false,&q;hasIntelligentPen&q;:false,&q;useLocalRecording&q;:false,&q;useIntelligentRoom&q;:false,&q;hasSalePosition&q;:false,&q;hasEpisodeCards&q;:true,&q;lockedForShouna&q;:false,&q;needSignIn&q;:false,&q;needTeacherSignIn&q;:false,&q;enablePadPencil&q;:true,&q;displayExercise&q;:false,&q;supportLuckyBag&q;:true,&q;supportLivePk&q;:true},{&q;id&q;:10790098,&q;kePrefix&q;:&q;sydw&q;,&q;courseId&q;:6,&q;status&q;:3,&q;playStatus&q;:3,&q;type&q;:33,&q;recordingType&q;:0,&q;mediaType&q;:0,&q;title&q;:&q;【公基非法】精选好题 沉浸刷题&q;,&q;innerTitle&q;:&q;&q;,&q;startTime&q;:1749873600000,&q;endTime&q;:1749880800000,&q;teacher&q;:{&q;id&q;:52897,&q;userId&q;:88925186,&q;name&q;:&q;魏涅与&q;,&q;brief&q;:&q;粉笔优质讲师&q;,&q;desc&q;:&q;粉笔优质讲师\n211高校毕业，6年一线教学经验，累计授课时长3000+。\n具有常识公基及判断科目丰富的实践经验及系统扎实的专业理论知识：\n多次参与粉笔授课研讨会议，精准捕捉考试命题的最新趋势；\n多次参加粉笔教学教研活动，分享授课心得，推动教学质量不断攀升。\n授课评分保持在4.9以上，累计超过500条学员好评。拥有“条理清晰、风趣幽默”的授课风格，擅长将复杂的知识点简单化，让学生在轻松愉悦的学习氛围中，快速掌握解题秘诀，深受广大学员的喜爱与信赖。&q;,&q;avatar&q;:&q;1984fd2774f3568.jpg&q;,&q;upperBodyPhoto&q;:null,&q;displayCoursePrefix&q;:&q;sydw&q;,&q;teacherStat&q;:{&q;teacherId&q;:52897,&q;episodeCount&q;:653,&q;scoreCount&q;:1711,&q;avgScore&q;:9.880771478667448,&q;fiveGradeAvgScore&q;:4.94,&q;updateTime&q;:1773204298276},&q;auditionEpisode&q;:{&q;episodeTitle&q;:&q;个人展示课&q;,&q;episodeVideoUrl&q;:&q;https://vod.fbstatic.cn/22e9ceb2vodbj1251001446/c19bce885145403709545114799/2m4bcwkBNWEA.mp4?t=f2a4b300&a;us=4070880000&a;sign=8287b189dcab7ca6525e7380fb25d677&q;},&q;memberOfCPC&q;:false,&q;tags&q;:null},&q;teachChannel&q;:1,&q;offline&q;:null,&q;duration&q;:7229,&q;hasAudition&q;:false,&q;bizType&q;:0,&q;bizId&q;:&q;726825&q;,&q;supportReplay&q;:true,&q;extraInfo&q;:null,&q;liveConfig&q;:{&q;episodeId&q;:10790098,&q;supportMultiGroup&q;:false,&q;exerciseBizType&q;:0,&q;videoDisplayType&q;:0,&q;avForwardType&q;:0,&q;useIntelligentRoom&q;:false,&q;hasStrokeKeynote&q;:true,&q;verticalModeType&q;:0,&q;originEpisodeId&q;:0,&q;supportRtmp&q;:false,&q;supportPk&q;:false,&q;supportLuckyBag&q;:true,&q;supportUserNoteStroke&q;:false,&q;communicateType&q;:0,&q;one2One&q;:false,&q;fakeLive&q;:false},&q;validStatus&q;:1,&q;supportLive&q;:true,&q;supportAiCatalog&q;:false,&q;hasIntelligentPen&q;:false,&q;useLocalRecording&q;:false,&q;useIntelligentRoom&q;:false,&q;hasSalePosition&q;:false,&q;hasEpisodeCards&q;:true,&q;lockedForShouna&q;:false,&q;needSignIn&q;:false,&q;needTeacherSignIn&q;:false,&q;enablePadPencil&q;:true,&q;displayExercise&q;:false,&q;supportLuckyBag&q;:true,&q;supportLivePk&q;:false},{&q;id&q;:10790012,&q;kePrefix&q;:&q;sydw&q;,&q;courseId&q;:6,&q;status&q;:3,&q;playStatus&q;:3,&q;type&q;:33,&q;recordingType&q;:0,&q;mediaType&q;:0,&q;title&q;:&q;【公基非法】精选好题 沉浸刷题&q;,&q;innerTitle&q;:&q;&q;,&q;startTime&q;:1749888000000,&q;endTime&q;:1749895200000,&q;teacher&q;:{&q;id&q;:13526,&q;userId&q;:48601508,&q;name&q;:&q;冯春雨&q;,&q;brief&q;:&q;粉笔优质讲师&q;,&q;desc&q;:&q;粉笔常识公基优质教师\n     六年一线教学授课经验，具有丰富的实践经验及系统扎实的专业理论知识，态度严谨，知识储备深厚，授课思路清晰，风格风趣幽默，善于抓住学员学习薄弱点，因材施教，易于激发学员学习热情，深受广大学员的认可和好评。&q;,&q;avatar&q;:&q;1983b565ff03e7b.jpg&q;,&q;upperBodyPhoto&q;:null,&q;displayCoursePrefix&q;:&q;sydw&q;,&q;teacherStat&q;:{&q;teacherId&q;:13526,&q;episodeCount&q;:661,&q;scoreCount&q;:5775,&q;avgScore&q;:9.77593073593074,&q;fiveGradeAvgScore&q;:4.89,&q;updateTime&q;:1773240032843},&q;auditionEpisode&q;:{&q;episodeTitle&q;:&q;个人展示课&q;,&q;episodeVideoUrl&q;:&q;https://vod.fbstatic.cn/22e9ceb2vodbj1251001446/5ba385475145403708398283831/7GT7IAU0lBMA.mp4?t=f2a4b300&a;us=4070880000&a;sign=b9f34bbf2057adc9158f0bcdd0d61937&q;},&q;memberOfCPC&q;:false,&q;tags&q;:null},&q;teachChannel&q;:1,&q;offline&q;:null,&q;duration&q;:7116,&q;hasAudition&q;:false,&q;bizType&q;:0,&q;bizId&q;:&q;726825&q;,&q;supportReplay&q;:true,&q;extraInfo&q;:null,&q;liveConfig&q;:{&q;episodeId&q;:10790012,&q;supportMultiGroup&q;:false,&q;exerciseBizType&q;:0,&q;videoDisplayType&q;:0,&q;avForwardType&q;:0,&q;useIntelligentRoom&q;:false,&q;hasStrokeKeynote&q;:true,&q;verticalModeType&q;:0,&q;originEpisodeId&q;:0,&q;supportRtmp&q;:false,&q;supportPk&q;:true,&q;supportLuckyBag&q;:true,&q;supportUserNoteStroke&q;:false,&q;communicateType&q;:0,&q;one2One&q;:false,&q;fakeLive&q;:false},&q;validStatus&q;:1,&q;supportLive&q;:true,&q;supportAiCatalog&q;:false,&q;hasIntelligentPen&q;:false,&q;useLocalRecording&q;:false,&q;useIntelligentRoom&q;:false,&q;hasSalePosition&q;:false,&q;hasEpisodeCards&q;:true,&q;lockedForShouna&q;:false,&q;needSignIn&q;:false,&q;needTeacherSignIn&q;:false,&q;enablePadPencil&q;:true,&q;displayExercise&q;:false,&q;supportLuckyBag&q;:true,&q;supportLivePk&q;:true},{&q;id&q;:10790013,&q;kePrefix&q;:&q;sydw&q;,&q;courseId&q;:6,&q;status&q;:3,&q;playStatus&q;:3,&q;type&q;:33,&q;recordingType&q;:0,&q;mediaType&q;:0,&q;title&q;:&q;【言语】精选好题 沉浸刷题&q;,&q;innerTitle&q;:&q;&q;,&q;startTime&q;:1749952800000,&q;endTime&q;:1749960000000,&q;teacher&q;:{&q;id&q;:52293,&q;userId&q;:80180258,&q;name&q;:&q;张沫沫&q;,&q;brief&q;:&q;粉笔优质讲师&q;,&q;desc&q;:&q;粉笔优质讲师\n6年一线教学，深耕事业单位考试，总授课时长2000+h。\n承担过线上和线下的笔试精品班、刷题班、冲刺班等多种班型。线上公开课引人入胜，平均单次上课人数1000+。\n多次参与模拟题教研与命制、事业单位真题教研与解析，凭借敏锐的洞察力，精准把握考点的变化与走向，为学员备考指引清晰方向。\n高效技巧：总结出一套独特的解题技巧体系，帮助学员在有限时间内快速准确解题。\n因材施教：深知每个学员的基础、学习能力和风格各异，善于将枯燥的知识转化为生动有趣的案例。秉持因材施教的原则，为学员量身定制学习方案。\n凭借其深厚的专业知识、丰富的教学经验和认真负责的教学态度，赢得了学员们的一致赞誉和高度认可。学员们纷纷表示，老师的课程生动有趣、实用性强，不仅帮助他们掌握了知识和技巧，更在备考过程中给予了精神支持和鼓励。所带学员在事业单位笔试中成绩斐然，众多学员在考试中取得优异成绩，成功进入面试环节。&q;,&q;avatar&q;:&q;17ef63de64cbb55.jpg&q;,&q;upperBodyPhoto&q;:null,&q;displayCoursePrefix&q;:&q;sydw&q;,&q;teacherStat&q;:{&q;teacherId&q;:52293,&q;episodeCount&q;:543,&q;scoreCount&q;:2574,&q;avgScore&q;:9.802641802641809,&q;fiveGradeAvgScore&q;:4.9,&q;updateTime&q;:1773281606121},&q;auditionEpisode&q;:{&q;episodeTitle&q;:&q;个人展示课&q;,&q;episodeVideoUrl&q;:&q;https://nodestatic.fbstatic.cn/video_qhd/1714474876942.mp4&q;},&q;memberOfCPC&q;:false,&q;tags&q;:null},&q;teachChannel&q;:1,&q;offline&q;:null,&q;duration&q;:7470,&q;hasAudition&q;:false,&q;bizType&q;:0,&q;bizId&q;:&q;726825&q;,&q;supportReplay&q;:true,&q;extraInfo&q;:null,&q;liveConfig&q;:{&q;episodeId&q;:10790013,&q;supportMultiGroup&q;:false,&q;exerciseBizType&q;:0,&q;videoDisplayType&q;:0,&q;avForwardType&q;:0,&q;useIntelligentRoom&q;:false,&q;hasStrokeKeynote&q;:true,&q;verticalModeType&q;:0,&q;originEpisodeId&q;:0,&q;supportRtmp&q;:false,&q;supportPk&q;:true,&q;supportLuckyBag&q;:true,&q;supportUserNoteStroke&q;:false,&q;communicateType&q;:0,&q;one2One&q;:false,&q;fakeLive&q;:false},&q;validStatus&q;:1,&q;supportLive&q;:true,&q;supportAiCatalog&q;:false,&q;hasIntelligentPen&q;:false,&q;useLocalRecording&q;:false,&q;useIntelligentRoom&q;:false,&q;hasSalePosition&q;:false,&q;hasEpisodeCards&q;:true,&q;lockedForShouna&q;:false,&q;needSignIn&q;:false,&q;needTeacherSignIn&q;:false,&q;enablePadPencil&q;:true,&q;displayExercise&q;:false,&q;supportLuckyBag&q;:true,&q;supportLivePk&q;:true},{&q;id&q;:10789990,&q;kePrefix&q;:&q;sydw&q;,&q;courseId&q;:6,&q;status&q;:3,&q;playStatus&q;:3,&q;type&q;:33,&q;recordingType&q;:0,&q;mediaType&q;:0,&q;title&q;:&q;【综应】精选好题 沉浸刷题&q;,&q;innerTitle&q;:&q;&q;,&q;startTime&q;:1749967200000,&q;endTime&q;:1749974400000,&q;teacher&q;:{&q;id&q;:33464,&q;userId&q;:79618484,&q;name&q;:&q;钟页心&q;,&q;brief&q;:&q;粉笔优质讲师&q;,&q;desc&q;:&q;粉笔优质教师\n多次参加粉笔教研会议，全面把握各地区最新考情，积累丰富知识。\n五年一线教学经验，承担线上和线下精品班、系统班多种班型授课。课堂互动性佳，授课内容深入浅出，引导性强，激发学员学习热情，通过大量真实案例和实战演练让学生在练习中掌握答题技巧，灵活应对各类题目。\n累计线上授课超900小时，积累评分4.9分以上。针对性指导，发掘个人优势，帮助学员树立信心，答出自己真实的思考，突破自我，提高答题逻辑性和准确性，深受学生信赖。&q;,&q;avatar&q;:&q;17880f97c0ca868.jpg&q;,&q;upperBodyPhoto&q;:null,&q;displayCoursePrefix&q;:&q;sydw&q;,&q;teacherStat&q;:{&q;teacherId&q;:33464,&q;episodeCount&q;:462,&q;scoreCount&q;:280,&q;avgScore&q;:9.757142857142858,&q;fiveGradeAvgScore&q;:4.88,&q;updateTime&q;:1773388977630},&q;auditionEpisode&q;:{&q;episodeTitle&q;:&q;个人展示课&q;,&q;episodeVideoUrl&q;:&q;https://vod.fbstatic.cn/22e9ceb2vodbj1251001446/b4d00d621253642695657120814/yj7Ea7PjTXcA.mp4?t=f2a4b300&a;us=4070880000&a;sign=385e5bb2e5dde920bf1d27a23669c23f&q;},&q;memberOfCPC&q;:false,&q;tags&q;:null},&q;teachChannel&q;:1,&q;offline&q;:null,&q;duration&q;:6720,&q;hasAudition&q;:false,&q;bizType&q;:0,&q;bizId&q;:&q;726825&q;,&q;supportReplay&q;:true,&q;extraInfo&q;:null,&q;liveConfig&q;:{&q;episodeId&q;:10789990,&q;supportMultiGroup&q;:false,&q;exerciseBizType&q;:0,&q;videoDisplayType&q;:0,&q;avForwardType&q;:0,&q;useIntelligentRoom&q;:false,&q;hasStrokeKeynote&q;:true,&q;verticalModeType&q;:0,&q;originEpisodeId&q;:0,&q;supportRtmp&q;:false,&q;supportPk&q;:true,&q;supportLuckyBag&q;:true,&q;supportUserNoteStroke&q;:false,&q;communicateType&q;:0,&q;one2One&q;:false,&q;fakeLive&q;:false},&q;validStatus&q;:1,&q;supportLive&q;:true,&q;supportAiCatalog&q;:false,&q;hasIntelligentPen&q;:false,&q;useLocalRecording&q;:false,&q;useIntelligentRoom&q;:false,&q;hasSalePosition&q;:false,&q;hasEpisodeCards&q;:true,&q;lockedForShouna&q;:false,&q;needSignIn&q;:false,&q;needTeacherSignIn&q;:false,&q;enablePadPencil&q;:true,&q;displayExercise&q;:false,&q;supportLuckyBag&q;:true,&q;supportLivePk&q;:true},{&q;id&q;:10790016,&q;kePrefix&q;:&q;sydw&q;,&q;courseId&q;:6,&q;status&q;:3,&q;playStatus&q;:3,&q;type&q;:33,&q;recordingType&q;:0,&q;mediaType&q;:0,&q;title&q;:&q;【言语】精选好题 沉浸刷题&q;,&q;innerTitle&q;:&q;&q;,&q;startTime&q;:1750039200000,&q;endTime&q;:1750046400000,&q;teacher&q;:{&q;id&q;:32923,&q;userId&q;:83087094,&q;name&q;:&q;杨优秀&q;,&q;brief&q;:&q;粉笔优质讲师&q;,&q;desc&q;:&q;粉笔优质教师\n8年一线教学授课经验，线上累计授课超1000小时，授课人数10000+，线下曾担任联考言语主讲老师，具有言语理解与表达科目丰富的实践经验及系统扎实的专业理论知识。线下与线上授课经验丰富，善于讲解联考、江苏、浙江、广东各省言语课程，对于言语题型有独到的见解，能够多方面把握学员需求，精准定位学员薄弱点。多次参加粉笔教研活动，参与笔试真题解析与精品班精品挑战选题，助力粉笔理论研发升级。积极参与各项比赛，曾获粉笔风采大赛“最具风格奖”，娓娓道来的授课风格，让学生在轻松的学习氛围中，用更简单的方法，找到更快捷的解题之道，深受广大学员的认可和好评。&q;,&q;avatar&q;:&q;1785e21dcfe8463.jpg&q;,&q;upperBodyPhoto&q;:null,&q;displayCoursePrefix&q;:&q;sydw&q;,&q;teacherStat&q;:{&q;teacherId&q;:32923,&q;episodeCount&q;:374,&q;scoreCount&q;:1626,&q;avgScore&q;:9.857318573185726,&q;fiveGradeAvgScore&q;:4.93,&q;updateTime&q;:1772881550179},&q;auditionEpisode&q;:null,&q;memberOfCPC&q;:false,&q;tags&q;:null},&q;teachChannel&q;:1,&q;offline&q;:null,&q;duration&q;:8232,&q;hasAudition&q;:false,&q;bizType&q;:0,&q;bizId&q;:&q;726825&q;,&q;supportReplay&q;:true,&q;extraInfo&q;:null,&q;liveConfig&q;:{&q;episodeId&q;:10790016,&q;supportMultiGroup&q;:false,&q;exerciseBizType&q;:0,&q;videoDisplayType&q;:0,&q;avForwardType&q;:0,&q;useIntelligentRoom&q;:false,&q;hasStrokeKeynote&q;:true,&q;verticalModeType&q;:0,&q;originEpisodeId&q;:0,&q;supportRtmp&q;:false,&q;supportPk&q;:true,&q;supportLuckyBag&q;:true,&q;supportUserNoteStroke&q;:false,&q;communicateType&q;:0,&q;one2One&q;:false,&q;fakeLive&q;:false},&q;validStatus&q;:1,&q;supportLive&q;:true,&q;supportAiCatalog&q;:false,&q;hasIntelligentPen&q;:false,&q;useLocalRecording&q;:false,&q;useIntelligentRoom&q;:false,&q;hasSalePosition&q;:false,&q;hasEpisodeCards&q;:true,&q;lockedForShouna&q;:false,&q;needSignIn&q;:false,&q;needTeacherSignIn&q;:false,&q;enablePadPencil&q;:true,&q;displayExercise&q;:false,&q;supportLuckyBag&q;:true,&q;supportLivePk&q;:true},{&q;id&q;:10790017,&q;kePrefix&q;:&q;sydw&q;,&q;courseId&q;:6,&q;status&q;:3,&q;playStatus&q;:3,&q;type&q;:33,&q;recordingType&q;:0,&q;mediaType&q;:0,&q;title&q;:&q;【判断】精选好题 沉浸刷题&q;,&q;innerTitle&q;:&q;&q;,&q;startTime&q;:1750046400000,&q;endTime&q;:1750053600000,&q;teacher&q;:{&q;id&q;:16684,&q;userId&q;:59358516,&q;name&q;:&q;周晶辉&q;,&q;brief&q;:&q;粉笔优质讲师&q;,&q;desc&q;:&q;粉笔优质教师\n六年一线教学授课经验，累计授课时长1000+小时，综合授课评分4.9+，实战经验丰富，授课逻辑清晰，多次参与科目教研工作、授课研讨会议，参与事业单位真题单题录制、模拟题撰写等，熟练掌握判断科目考情及命题趋势，擅长各省联考、江苏、浙江、广东等多地区考点，擅于从学员角度思考，帮助学员理清解题思路，掌握科目常规考点，突破科目重难考点，具有幽默诙谐、形象生动、条理清晰的授课风格，让学生在轻松的学习氛围中，用更简单的方法，找到更快捷的解题之道，深受广大学员的认可和好评。&q;,&q;avatar&q;:&q;198caf9ea93f698.jpg&q;,&q;upperBodyPhoto&q;:null,&q;displayCoursePrefix&q;:&q;sydw&q;,&q;teacherStat&q;:{&q;teacherId&q;:16684,&q;episodeCount&q;:449,&q;scoreCount&q;:1699,&q;avgScore&q;:9.85638610947615,&q;fiveGradeAvgScore&q;:4.93,&q;updateTime&q;:1773578657175},&q;auditionEpisode&q;:{&q;episodeTitle&q;:&q;个人展示课&q;,&q;episodeVideoUrl&q;:&q;https://vod.fbstatic.cn/22e9ceb2vodbj1251001446/85b397c93560136620837741859/inWAKAms518A.mp4?t=f2a4b300&a;us=4070880000&a;sign=8ae71ff49f003e5c8d83058d09cdc3db&q;},&q;memberOfCPC&q;:false,&q;tags&q;:null},&q;teachChannel&q;:1,&q;offline&q;:null,&q;duration&q;:6976,&q;hasAudition&q;:false,&q;bizType&q;:0,&q;bizId&q;:&q;726825&q;,&q;supportReplay&q;:true,&q;extraInfo&q;:null,&q;liveConfig&q;:{&q;episodeId&q;:10790017,&q;supportMultiGroup&q;:false,&q;exerciseBizType&q;:0,&q;videoDisplayType&q;:0,&q;a