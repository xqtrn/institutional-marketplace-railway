;:4.94,&q;updateTime&q;:1773594524697},&q;auditionEpisode&q;:{&q;episodeTitle&q;:&q;个人展示课&q;,&q;episodeVideoUrl&q;:&q;https://vod.fbstatic.cn/22e9ceb2vodbj1251001446/9cc6e9f83560136621447402832/oxLbyW9tbc4A.mp4?t=f2a4b300&a;us=4070880000&a;sign=742574c1fe64d1e966a0d28dfe74cc08&q;},&q;memberOfCPC&q;:false,&q;tags&q;:null},&q;teachChannel&q;:1,&q;offline&q;:null,&q;duration&q;:2700,&q;hasAudition&q;:false,&q;bizType&q;:0,&q;bizId&q;:&q;773251&q;,&q;supportReplay&q;:true,&q;extraInfo&q;:null,&q;liveConfig&q;:{&q;episodeId&q;:11706791,&q;supportMultiGroup&q;:false,&q;exerciseBizType&q;:0,&q;videoDisplayType&q;:0,&q;avForwardType&q;:0,&q;useIntelligentRoom&q;:false,&q;hasStrokeKeynote&q;:false,&q;verticalModeType&q;:0,&q;originEpisodeId&q;:0,&q;supportRtmp&q;:false,&q;supportPk&q;:false,&q;supportLuckyBag&q;:false,&q;supportUserNoteStroke&q;:false,&q;communicateType&q;:0,&q;fakeLive&q;:false,&q;one2One&q;:false},&q;validStatus&q;:1,&q;supportLive&q;:true,&q;supportAiCatalog&q;:false,&q;hasIntelligentPen&q;:false,&q;useLocalRecording&q;:false,&q;useIntelligentRoom&q;:false,&q;hasSalePosition&q;:false,&q;hasEpisodeCards&q;:false,&q;lockedForShouna&q;:false,&q;needSignIn&q;:false,&q;needTeacherSignIn&q;:false,&q;enablePadPencil&q;:false,&q;displayExercise&q;:false,&q;supportLuckyBag&q;:false,&q;supportLivePk&q;:false},{&q;id&q;:11706792,&q;kePrefix&q;:&q;gwy&q;,&q;courseId&q;:1,&q;status&q;:0,&q;playStatus&q;:0,&q;type&q;:1,&q;recordingType&q;:0,&q;mediaType&q;:0,&q;title&q;:&q;晚课-热点夜话33&q;,&q;innerTitle&q;:&q;&q;,&q;startTime&q;:1776261600000,&q;endTime&q;:1776264300000,&q;teacher&q;:{&q;id&q;:4883,&q;userId&q;:43833662,&q;name&q;:&q;马梦伟&q;,&q;brief&q;:&q;粉笔公考面试优质讲师&q;,&q;desc&q;:&q;8年授课经验，培训部老师，主要负责公司内部师资面试培训、强化、授课后督课工作，面试基础夯实、应用灵活。曾多次参加省考面试并取得优异成绩，熟悉考官喜好、考试变化，授课中既注重基础也关注反模板反套路，帮助同学掌握考官思维。性格细心有耐心，认真负责，内部培训课程评分4.9+，培训师资千人，带班成果突出，多次实现班级高通过率。&q;,&q;avatar&q;:&q;1963c6cd559a7e9.jpg&q;,&q;upperBodyPhoto&q;:null,&q;displayCoursePrefix&q;:&q;gwy&q;,&q;teacherStat&q;:{&q;teacherId&q;:4883,&q;episodeCount&q;:973,&q;scoreCount&q;:5069,&q;avgScore&q;:9.92779640954824,&q;fiveGradeAvgScore&q;:4.96,&q;updateTime&q;:1773482740331},&q;auditionEpisode&q;:{&q;episodeTitle&q;:&q;个人展示课&q;,&q;episodeVideoUrl&q;:&q;https://vod.fbstatic.cn/22e9ceb2vodbj1251001446/9a640fe01397757910062623106/8mo7xp5sYGAA.mp4?t=f2a4b300&a;us=4070880000&a;sign=741fa06bad1b4157c3a9877ec38bc83d&q;},&q;memberOfCPC&q;:false,&q;tags&q;:null},&q;teachChannel&q;:1,&q;offline&q;:null,&q;duration&q;:2700,&q;hasAudition&q;:false,&q;bizType&q;:0,&q;bizId&q;:&q;773251&q;,&q;supportReplay&q;:true,&q;extraInfo&q;:null,&q;liveConfig&q;:{&q;episodeId&q;:11706792,&q;supportMultiGroup&q;:false,&q;exerciseBizType&q;:0,&q;videoDisplayType&q;:0,&q;avForwardType&q;:0,&q;useIntelligentRoom&q;:false,&q;hasStrokeKeynote&q;:false,&q;verticalModeType&q;:0,&q;originEpisodeId&q;:0,&q;supportRtmp&q;:false,&q;supportPk&q;:false,&q;supportLuckyBag&q;:false,&q;supportUserNoteStroke&q;:false,&q;communicateType&q;:0,&q;fakeLive&q;:false,&q;one2One&q;:false},&q;validStatus&q;:1,&q;supportLive&q;:true,&q;supportAiCatalog&q;:false,&q;hasIntelligentPen&q;:false,&q;useLocalRecording&q;:false,&q;useIntelligentRoom&q;:false,&q;hasSalePosition&q;:false,&q;hasEpisodeCards&q;:false,&q;lockedForShouna&q;:false,&q;needSignIn&q;:false,&q;needTeacherSignIn&q;:false,&q;enablePadPencil&q;:false,&q;displayExercise&q;:false,&q;supportLuckyBag&q;:false,&q;supportLivePk&q;:false},{&q;id&q;:11706793,&q;kePrefix&q;:&q;gwy&q;,&q;courseId&q;:1,&q;status&q;:0,&q;playStatus&q;:0,&q;type&q;:1,&q;recordingType&q;:0,&q;mediaType&q;:0,&q;title&q;:&q;早课-计算能力速成（三）&q;,&q;innerTitle&q;:&q;&q;,&q;startTime&q;:1776294000000,&q;endTime&q;:1776296700000,&q;teacher&q;:{&q;id&q;:1191,&q;userId&q;:42494582,&q;name&q;:&q;唐宋&q;,&q;brief&q;:&q;粉笔数资优质教师&q;,&q;desc&q;:&q;粉笔数资优质教师，985高校毕业。 \n15年公考授课经验，打分人次超70万，学员评分高达4.9分。 \n对数量关系与资料分析有深刻的认识和见解，在授课中注重思维引导，善于剖析学员的解题误区，针对性解决问题，解题方法多样，可操作性强。 \n参与主持各类授课研讨会议和教研活动，负责审阅《行测的思维》等多套图书。&q;,&q;avatar&q;:&q;18d405f7e4b8986.jpg&q;,&q;upperBodyPhoto&q;:null,&q;displayCoursePrefix&q;:&q;gwy&q;,&q;teacherStat&q;:{&q;teacherId&q;:1191,&q;episodeCount&q;:1320,&q;scoreCount&q;:782369,&q;avgScore&q;:9.868775475510896,&q;fiveGradeAvgScore&q;:4.93,&q;updateTime&q;:1773622758821},&q;auditionEpisode&q;:{&q;episodeTitle&q;:&q;个人展示课&q;,&q;episodeVideoUrl&q;:&q;https://vod.fbstatic.cn/22e9ceb2vodbj1251001446/9d2164e03560136621447452862/SBy9zjJj7ScA.mp4?t=f2a4b300&a;us=4070880000&a;sign=0cd0cf017d8689074ec85b58c31ca5af&q;},&q;memberOfCPC&q;:false,&q;tags&q;:null},&q;teachChannel&q;:1,&q;offline&q;:null,&q;duration&q;:2700,&q;hasAudition&q;:false,&q;bizType&q;:0,&q;bizId&q;:&q;773251&q;,&q;supportReplay&q;:true,&q;extraInfo&q;:null,&q;liveConfig&q;:{&q;episodeId&q;:11706793,&q;supportMultiGroup&q;:false,&q;exerciseBizType&q;:0,&q;videoDisplayType&q;:0,&q;avForwardType&q;:0,&q;useIntelligentRoom&q;:false,&q;hasStrokeKeynote&q;:false,&q;verticalModeType&q;:0,&q;originEpisodeId&q;:0,&q;supportRtmp&q;:false,&q;supportPk&q;:false,&q;supportLuckyBag&q;:false,&q;supportUserNoteStroke&q;:false,&q;communicateType&q;:0,&q;fakeLive&q;:false,&q;one2One&q;:false},&q;validStatus&q;:1,&q;supportLive&q;:true,&q;supportAiCatalog&q;:false,&q;hasIntelligentPen&q;:false,&q;useLocalRecording&q;:false,&q;useIntelligentRoom&q;:false,&q;hasSalePosition&q;:false,&q;hasEpisodeCards&q;:false,&q;lockedForShouna&q;:false,&q;needSignIn&q;:false,&q;needTeacherSignIn&q;:false,&q;enablePadPencil&q;:false,&q;displayExercise&q;:false,&q;supportLuckyBag&q;:false,&q;supportLivePk&q;:false},{&q;id&q;:11706794,&q;kePrefix&q;:&q;gwy&q;,&q;courseId&q;:1,&q;status&q;:0,&q;playStatus&q;:0,&q;type&q;:1,&q;recordingType&q;:0,&q;mediaType&q;:0,&q;title&q;:&q;晚课-热点夜话34&q;,&q;innerTitle&q;:&q;&q;,&q;startTime&q;:1776348000000,&q;endTime&q;:1776350700000,&q;teacher&q;:{&q;id&q;:6696,&q;userId&q;:42331308,&q;name&q;:&q;安岚&q;,&q;brief&q;:&q;粉笔面试研究院成员、高级面试讲师&q;,&q;desc&q;:&q;粉笔面试优质教师，粉笔面试研究院成员、大区面试教学教研负责人\n5年公考面试授课经验，累计授课时长超过10000小时，线下面试授课遍及全国，熟悉各地面试考情，多班级通过率超过90%，学员高分突破95。粉笔面试大课、直播工作带头人，主要承担国省考面试理论大课、线上公开课、线上直播等工作，注重对各类热点的深挖与教研，致力于帮助学生提升答题思维的深度和广度。具备社会学等相关专业背景，有过多次面试实战高分经历，善于在技巧总结和经验分享中帮助考生挖掘自身潜力、遇见更好的自己！\n参与组织各类授课研讨会议和教研活动，负责面试教研、题本研发和师资培训等工作，包括粉笔面试理论研发、晚课资料及反模板教学配套资料撰写、粉笔面试图书撰写等。&q;,&q;avatar&q;:&q;186c5ba0fd07efb.jpg&q;,&q;upperBodyPhoto&q;:null,&q;displayCoursePrefix&q;:&q;gwy&q;,&q;teacherStat&q;:{&q;teacherId&q;:6696,&q;episodeCount&q;:982,&q;scoreCount&q;:19865,&q;avgScore&q;:9.87253964258746,&q;fiveGradeAvgScore&q;:4.94,&q;updateTime&q;:1773582951352},&q;auditionEpisode&q;:{&q;episodeTitle&q;:&q;个人展示课&q;,&q;episodeVideoUrl&q;:&q;https://vod.fbstatic.cn/22e9ceb2vodbj1251001446/2bad8d4a243791580022478007/f0.mp4?t=f2a4b300&a;us=4070880000&a;sign=9ac26cbb569268517bd25a6572b63d7a&q;},&q;memberOfCPC&q;:false,&q;tags&q;:null},&q;teachChannel&q;:1,&q;offline&q;:null,&q;duration&q;:2700,&q;hasAudition&q;:false,&q;bizType&q;:0,&q;bizId&q;:&q;773251&q;,&q;supportReplay&q;:true,&q;extraInfo&q;:null,&q;liveConfig&q;:{&q;episodeId&q;:11706794,&q;supportMultiGroup&q;:false,&q;exerciseBizType&q;:0,&q;videoDisplayType&q;:0,&q;avForwardType&q;:0,&q;useIntelligentRoom&q;:false,&q;hasStrokeKeynote&q;:false,&q;verticalModeType&q;:0,&q;originEpisodeId&q;:0,&q;supportRtmp&q;:false,&q;supportPk&q;:false,&q;supportLuckyBag&q;:false,&q;supportUserNoteStroke&q;:false,&q;communicateType&q;:0,&q;fakeLive&q;:false,&q;one2One&q;:false},&q;validStatus&q;:1,&q;supportLive&q;:true,&q;supportAiCatalog&q;:false,&q;hasIntelligentPen&q;:false,&q;useLocalRecording&q;:false,&q;useIntelligentRoom&q;:false,&q;hasSalePosition&q;:false,&q;hasEpisodeCards&q;:false,&q;lockedForShouna&q;:false,&q;needSignIn&q;:false,&q;needTeacherSignIn&q;:false,&q;enablePadPencil&q;:false,&q;displayExercise&q;:false,&q;supportLuckyBag&q;:false,&q;supportLivePk&q;:false},{&q;id&q;:11706795,&q;kePrefix&q;:&q;gwy&q;,&q;courseId&q;:1,&q;status&q;:0,&q;playStatus&q;:0,&q;type&q;:1,&q;recordingType&q;:0,&q;mediaType&q;:0,&q;title&q;:&q;早课-申论提分必学好文（六）&q;,&q;innerTitle