acherId&q;:16585,&q;episodeCount&q;:552,&q;scoreCount&q;:1401,&q;avgScore&q;:9.822983583154892,&q;fiveGradeAvgScore&q;:4.91,&q;updateTime&q;:1773561621338},&q;auditionEpisode&q;:{&q;episodeTitle&q;:&q;个人展示课&q;,&q;episodeVideoUrl&q;:&q;https://vod.fbstatic.cn/22e9ceb2vodbj1251001446/8083c2095145403709544648249/NKx7gKaPMmIA.mp4?t=f2a4b300&a;us=4070880000&a;sign=b125bc598cde7445acb1a34c322b7d05&q;},&q;memberOfCPC&q;:false,&q;tags&q;:null},&q;teachChannel&q;:1,&q;offline&q;:null,&q;duration&q;:8950,&q;hasAudition&q;:false,&q;bizType&q;:0,&q;bizId&q;:&q;726825&q;,&q;supportReplay&q;:true,&q;extraInfo&q;:null,&q;liveConfig&q;:{&q;episodeId&q;:10603604,&q;supportMultiGroup&q;:false,&q;exerciseBizType&q;:0,&q;videoDisplayType&q;:0,&q;avForwardType&q;:0,&q;useIntelligentRoom&q;:false,&q;hasStrokeKeynote&q;:true,&q;verticalModeType&q;:0,&q;originEpisodeId&q;:0,&q;supportRtmp&q;:false,&q;supportPk&q;:true,&q;supportLuckyBag&q;:true,&q;supportUserNoteStroke&q;:false,&q;communicateType&q;:0,&q;one2One&q;:false,&q;fakeLive&q;:false},&q;validStatus&q;:1,&q;supportLive&q;:true,&q;supportAiCatalog&q;:false,&q;hasIntelligentPen&q;:false,&q;useLocalRecording&q;:false,&q;useIntelligentRoom&q;:false,&q;hasSalePosition&q;:false,&q;hasEpisodeCards&q;:true,&q;lockedForShouna&q;:false,&q;needSignIn&q;:false,&q;needTeacherSignIn&q;:false,&q;enablePadPencil&q;:true,&q;displayExercise&q;:false,&q;supportLuckyBag&q;:true,&q;supportLivePk&q;:true},{&q;id&q;:10603609,&q;kePrefix&q;:&q;sydw&q;,&q;courseId&q;:6,&q;status&q;:3,&q;playStatus&q;:3,&q;type&q;:33,&q;recordingType&q;:0,&q;mediaType&q;:0,&q;title&q;:&q;【判断】精选好题 沉浸刷题&q;,&q;innerTitle&q;:&q;&q;,&q;startTime&q;:1747382400000,&q;endTime&q;:1747389600000,&q;teacher&q;:{&q;id&q;:16837,&q;userId&q;:74162051,&q;name&q;:&q;杨晓晓&q;,&q;brief&q;:&q;粉笔优质讲师&q;,&q;desc&q;:&q;粉笔优质教师\n六年一线教学授课经验，具有判断科目丰富的实践经验及系统扎实的专业理论知识，参与判断科目讲义、模拟卷研发。始终以生动有趣、激发学生思维为教学宗旨，课堂氛围轻松融洽，广受学员好评。授课重点突出，能够及时总结拓展，讲解语言通俗易懂。擅长引导学生自主思考，善于根据学生的不同情况和需求,制定合适的教学计划，进行个性化指导，助力学员上岸。&q;,&q;ava