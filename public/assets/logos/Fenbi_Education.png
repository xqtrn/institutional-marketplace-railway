icalModeType&q;:0,&q;originEpisodeId&q;:0,&q;supportRtmp&q;:false,&q;supportPk&q;:false,&q;supportLuckyBag&q;:false,&q;supportUserNoteStroke&q;:false,&q;communicateType&q;:0,&q;fakeLive&q;:false,&q;one2One&q;:false},&q;validStatus&q;:1,&q;supportLive&q;:true,&q;supportAiCatalog&q;:false,&q;hasIntelligentPen&q;:false,&q;useLocalRecording&q;:false,&q;useIntelligentRoom&q;:false,&q;hasSalePosition&q;:false,&q;hasEpisodeCards&q;:false,&q;lockedForShouna&q;:false,&q;needSignIn&q;:false,&q;needTeacherSignIn&q;:false,&q;enablePadPencil&q;:false,&q;displayExercise&q;:false,&q;supportLuckyBag&q;:false,&q;supportLivePk&q;:false},{&q;id&q;:11705783,&q;kePrefix&q;:&q;gwy&q;,&q;courseId&q;:1,&q;status&q;:0,&q;playStatus&q;:0,&q;type&q;:1,&q;recordingType&q;:0,&q;mediaType&q;:0,&q;title&q;:&q;早课-政治理论常见词汇（四）&q;,&q;innerTitle&q;:&q;&q;,&q;startTime&q;:1774220400000,&q;endTime&q;:1774222200000,&q;teacher&q;:{&q;id&q;:4372,&q;userId&q;:45812058,&q;name&q;:&q;夏方军&q;,&q;brief&q;:&q;粉笔公基优质教师&q;,&q;desc&q;:&q;粉笔公基优质教师，岗位第一考入食药系统，一年编制工作经历，八年公考事业编授课经历。对政治理论、时政常识、面试有深入研究，擅长从热点、考情维度进行预判。授课细致耐心、思维发散清晰，学生的“小姨夫”。&q;,&q;avatar&q;:&q;19407933436c6d4.jpg&q;,&q;upperBodyPhoto&q;:null,&q;displayCoursePrefix&q;:&q;gwy&q;,&q;teacherStat&q;:{&q;teacherId&q;:4372,&q;episodeCount&q;:1059,&q;scoreCount&q;:209965,&q;avgScore&q;:9.894925344700331,&q;fiveGradeAvgScore&q;:4.95,&q;updateTime&q;:1773623280251},&q;auditionEpisode&q;:{&q;episodeTitle&q;:&q;个人展示课&q;,&q;episodeVideoUrl&q;:&q;https://vod.fbstatic.cn/22e9ceb2vodbj1251001446/65771a37243791580257902972/f0.mp4?t=f2a4b300&a;us=4070880000&a;sign=fe62d49b4742040836cd99e0a96d0768&q;},&q;memberOfCPC&q;:false,&q;tags&q;:null},&q;teachChannel&q;:1,&q;offline&q;:null,&q;duration&q;:1800,&q;hasAudition&q;:false,&q;bizType&q;:0,&q;bizId&q;:&q;773251&q;,&q;supportReplay&q;:true,&q;extraInfo&q;:null,&q;liveConfig&q;:{&q;episodeId&q;:11705783,&q;supportMultiGroup&q;:false,&q;exerciseBizType&q;:0,&q;videoDisplayType&q;:0,&q;avForwardType&q;:0,&q;useIntelligentRoom&q;:false,&q;hasStrokeKeynote&q;:false,&q;verticalModeType&q;:0,&q;originEpisodeId&q;:0,&q;supportRtmp&q;:false,&q;supportPk&q;:false,&q;supportLuckyBag&q;:false,&q;supportUserNoteStroke&q;:false,&q;communicateType&q;:0,&q;fakeLive&q;:false,&q;one2One&q;:false},&q;validStatus&q;:1,&q;supportLive&q;:true,&q;supportAiCatalog&q;:false,&q;hasIntelligentPen&q;:false,&q;useLocalRecording&q;:false,&q;useIntelligentRoom&q;:false,&q;hasSalePosition&q;:false,&q;hasEpisodeCards&q;:false,&q;lockedForShouna&q;:false,&q;needSignIn&q;:false,&q;needTeacherSignIn&q;:false,&q;enablePadPencil&q;:false,&q;displayExercise&q;:false,&q;supportLuckyBag&q;:false,&q;supportLivePk&q;:false},{&q;id&q;:11705784,&q;kePrefix&q;:&q;gwy&q;,&q;courseId&q;:1,&q;status&q;:0,&q;playStatus&q;:0,&q;type&q;:1,&q;recordingType&q;:0,&q;mediaType&q;:0,&q;title&q;:&q;晚课-热点夜话16&q;,&q;innerTitle&q;:&q;&q;,&q;startTime&q;:1774274400000,&q;endTime&q;:1774277100000,&q;teacher&q;:{&q;id&q;:6696,&q;userId&q;:42331308,&q;name&q;:&q;安岚&q;,&q;brief&q;:&q;粉笔面试研究院成员、高级面试讲师&q;,&q;desc&q;:&q;粉笔面试优质教师，粉笔面试研究院成员、大区面试教学教研负责人\n5年公考面试授课经验，累计授课时长超过10000小时，线下面试授课遍及全国，熟悉各地面试考情，多班级通过率超过90%，学员高分突破95。粉笔面试大课、直播工作带头人，主要承担国省考面试理论大课、线上公开课、线上直播等工作，注重对各类热点的深挖与教研，致力于帮助学生提升答题思维的深度和广度。具备社会学等相关专业背景，有过多次面试实战高分经历，善于在技巧总结和经验分享中帮助考生挖掘自身潜力、遇见更好的自己！\n参与组织各类授课研讨会议和教研活动，负责面试教研、题本研发和师资培训等工作，包括粉笔面试理论研发、晚课资料及反模板教学配套资料撰写、粉笔面试图书撰写等。&q;,&q;avatar&q;:&q;186c5ba0fd07efb.jpg&q;,&q;upperBodyPhoto&q;:null,&q;displayCoursePrefix&q;:&q;gwy&q;,&q;teacherStat&q;:{&q;teacherId&q;:6696,&q;episodeCount&q;:982,&q;scoreCount&q;:19865,&q;avgScore&q;:9.87253964258746,&q;fiveGradeAvgScore&q;:4.94,&q;updateTime&q;:1773582951352},&q;auditionEpisode&q;:{&q;episodeTitle&q;:&q;个人展示课&q;,&q;episodeVideoUrl&q;:&q;https://vod.fbstatic.cn/22e9ceb2vodbj1251001446/2bad8d4a243791580022478007/f0.mp4?t=f2a4b300&a;us=4070880000&a;sign=9ac26cbb569268517bd25a6572b63d7a&q;},&q;memberOfCPC&q;:false,&q;tags&q;:null},&q;teachChannel&q;:1,&q;offline&q;:null,&q;duration&q;:2700,&q;hasAudition&q;:false,&q;bizType&q;:0,&q;bizId&q;:&q;773251&q;,&q;supportReplay&q;:true,&q;extraInfo&q;:null,&q;liveConfig&q;:{&q;episodeId&q;:11705784,&q;supportMultiGroup&q;:false,&q;exerciseBizType&q;:0,&q;videoDisplayType&q;:0,&q;avForwardType&q;:0,&q;useIntelligentRoom&q;:false,&q;hasStrokeKeynote&q;:false,&q;verticalModeType&q;:0,&q;originEpisodeId&q;:0,&q;supportRtmp&q;:false,&q;supportPk&q;:false,&q;supportLuckyBag&q;:false,&q;supportUserNoteStroke&q;:false,&q;communicateType&q;:0,&q;fakeLive&q;:false,&q;one2One&q;:false},&q;validStatus&q;:1,&q;supportLive&q;:true,&q;supportAiCatalog&q;:false,&q;hasIntelligentPen&q;:false,&q;useLocalRecording&q;:false,&q;useIntelligentRoom&q;:false,&q;hasSalePosition&q;:false,&q;hasEpisodeCards&q;:false,&q;lockedForShouna&q;:false,&q;needSignIn&q;:false,&q;needTeacherSignIn&q;:false,&q;enablePadPencil&q;:false,&q;displayExercise&q;:false,&q;supportLuckyBag&q;:false,&q;supportLivePk&q;:false},{&q;id&q;:11705785,&q;kePrefix&q;:&q;gwy&q;,&q;courseId&q;:1,&q;status&q;:0,&q;playStatus&q;:0,&q;type&q;:1,&q;recordingType&q;:0,&q;mediaType&q;:0,&q;title&q;:&q;早课-政府职能与行政监督：公务员应知的行政管理知识&q;,&q;innerTitle&q;:&q;&q;,&q;startTime&q;:1774306800000,&q;endTime&q;:1774308600000,&q;teacher&q;:{&q;id&q;:32254,&q;userId&q;:74446336,&q;name&q;:&q;张月亮&q;,&q;brief&q;:&q;粉笔公考常识优质讲师&q;,&q;desc&q;:&q;       粉笔常识优质老师。\n       性格耐心细致，善于把握学员个性化特点，因材施教，认真负责，对待课程一丝不苟。讲课生动形象，机智诙谐，听课体验好，学员可以在轻松愉快的氛围中学习，跟着老师节奏主动思考。老师同时注重“反模板”教学，助力学员走出答题模板与误区。&q;,&q;avatar&q;:&q;1783f5430429930.jpg&q;,&q;upperBodyPhoto&q;:null,&q;displayCoursePrefix&q;:&q;gwy&q;,&q;teacherStat&q;:{&q;teacherId&q;:32254,&q;episodeCount&q;:133,&q;scoreCount&q;:20388,&q;avgScore&q;:9.69501667647632,&q;fiveGradeAvgScore&q;:4.85,&q;updateTime&q;:1773491006064},&q;auditionEpisode&q;:null,&q;memberOfCPC&q;:false,&q;tags&q;:null},&q;teachChannel&q;:1,&q;offline&q;:null,&q;duration&q;:1800,&q;hasAudition&q;:false,&q;bizType&q;:0,&q;bizId&q;:&q;773251&q;,&q;supportReplay&q;:true,&q;extraInfo&q;:null,&q;liveConfig&q;:{&q;episodeId&q;:11705785,&q;supportMultiGroup&q;:false,&q;exerciseBizType&q;:0,&q;videoDisplayType&q;:0,&q;avForwardType&q;:0,&q;useIntelligentRoom&q;:false,&q;hasStrokeKeynote&q;:false,&q;verticalModeType&q;:0,&q;originEpisodeId&q;:0,&q;supportRtmp&q;:false,&q;supportPk&q;:false,&q;supportLuckyBag&q;:false,&q;supportUserNoteStroke&q;:false,&q;communicateType&q;:0,&q;fakeLive&q;:false,&q;one2One&q;:false},&q;validStatus&q;:1,&q;supportLive&q;:true,&q;supportAiCatalog&q;:false,&q;hasIntelligentPen&q;:false,&q;useLocalRecording&q;:false,&q;useIntelligentRoom&q;:false,&q;hasSalePosition&q;:false,&q;hasEpisodeCards&q;:false,&q;lockedForShouna&q;:false,&q;needSignIn&q;:false,&q;needTeacherSignIn&q;:false,&q;enablePadPencil&q;:false,&q;displayExercise&q;:false,&q;supportLuckyBag&q;:false,&q;supportLivePk&q;:false},{&q;id&q;:11705786,&q;kePrefix&q;:&q;gwy&q;,&q;courseId&q;:1,&q;status&q;:0,&q;playStatus&q;:0,&q;type&q;:1,&q;recordingType&q;:0,&q;mediaType&q;:0,&q;title&q;:&q;晚课-热点夜话17&q;,&q;innerTitle&q;:&q;&q;,&q;startTime&q;:1774360800000,&q;endTime&q;:1774363500000,&q;teacher&q;:{&q;id&q;:14952,&q;userId&q;:48263990,&q;name&q;:&q;赵博&q;,&q;brief&q;:&q;粉笔面试研究院成员、高级面试讲师&q;,&q;desc&q;:&q;8年公考面试授课经验，粉笔大区面试教学教研负责人，面试直播工作负责人，粉笔面试教材主编，主要承担粉笔国省考理论大课及各类线上公开课与直播工作，参与过多省市、多部门面试教材的教研与题本的研发设计工作。曾任高校讲师，并受邀担任华语网辩联赛评委。 \n赵博老师多年深耕于教学一线，具备出众的表达能力与严谨的逻辑思维，深谙面试作答之道，对内容思考以及语言表达都有着非常独到的见解。授课风格严谨却不失幽默，善于通过启发式教学，激发学员自主思考的能力。不仅能帮助学员迅速掌握应试技巧，更能在授课中传递正确的三观与为人处世的态度。&q;,&q;avatar&q;:&q;19b4f428479021e.jpg&q;,&q;upperBodyPhoto&q;:null,&q;displayCoursePrefix&q;:&q;gwy&q;,&q;teacherStat&q;:{&q;teacherId&q;:14952,&q;episodeCount&q;:1056,&q;scoreCount&q;:31594,&q;avgScore&q;:9.872444134962334,&q;fiveGradeAvgScore&q;:4.94,&q;updateTime&q;:1773622989376},&q;auditionEpisode&q;:{&q;episodeTitle&q;:&q;个人展示课&q;,&q;episodeVideoUrl&q;:&q;https://vod.fbstatic.cn/22e9ceb2vodbj1251001446/3d4dee423270835013757846611/qL4f3aEL8qMA.mp4?t=f2a4b300&a;us=4070880000&a;sign=5b7cf4d0d4b9823356332971b3f930b7&q;},&q;memberOfCPC&q;:false,&q;tags&q;:null},&q;teachChannel&q;:1,&q;offline&q;:null,&q;duration&q;:2700,&q;hasAudition&q;:false,&q;bizType&q;:0,&q;bizId&q;:&q;773251&q;,&q;supportReplay&q;:true,&q;extraInfo&q;:null,&q;liveConfig&q;:{&q;episodeId&q;:11705786,&q;supportMultiGroup&q;:false,&q;exerciseBizType&q;:0,&q;videoDisplayType&q;:0,&q;avForwardType&q;:0,&q;useIntelligentRoom&q;:false,&q;hasStrokeKeynote&q;:false,&q;verticalModeType&q;:0,&q;originEpisodeId&q;:0,&q;supportRtmp&q;:false,&q;supportPk&q;:false,&q;supportLuckyBag&q;:false,&q;supportUserNoteStroke&q;:false,&q;communicateType&q;:0,&q;fakeLive&q;:false,&q;one2One&q;:false},&q;validStatus&q;:1,&q;supportLive&q;:true,&q;supportAiCatalog&q;:false,&q;hasIntelligentPen&q;:false,&q;useLocalRecording&q;:false,&q;useIntelligentRoom&q;:false,&q;hasSalePosition&q;:false,&q;hasEpisodeCards&q;:false,&q;lockedForShouna&q;:false,&q;needSignIn&q;:false,&q;needTeacherSignIn&q;:false,&q;enablePadPencil&q;:false,&q;displayExercise&q;:false,&q;supportLuckyBag&q;:false,&q;supportLivePk&q;:false},{&q;id&q;:11705787,&q;kePrefix&q;:&q;gwy&q;,&q;courseId&q;:1,&q;status&q;:0,&q;playStatus&q;:0,&q;type&q;:1,&q;recordingType&q;:0,&q;mediaType&q;:0,&q;title&q;:&q;早课-成语登科计划（四）&q;,&q;innerTitle&q;:&q;&q;,&q;startTime&q;:1774393200000,&q;endTime&q;:1774395900000,&q;teacher&q;:{&q;id&q;:5418,&q;userId&q;:57004843,&q;name&q;:&q;王得权&q;,&q;brief&q;:&q;粉笔言语优质教师&q;,&q;desc&q;:&q;粉笔言语优质教师，9年授课经验，累计授课学员超10万人。课程讲解深入浅出，易于理解。方法和技巧并重，能够让学员学会举一反三，提高备考效率。善于归纳总结，能及时帮助学员梳理知识点和易错点，让大家在备考过程中少走许多弯路。 \n参与组织各类教研工作，曾参与《行测的思维》《笔试系统讲义》《行测5000题》等多个套图书的编写工作，同时参与了多套模拟题的命制和审核工作。&q;,&q;avatar&q;:&q;171ee8c61a66542.jpg&q;,&q;upperBodyPhoto&q;:null,&q;displayCoursePrefix&q;:&q;gwy&q;,&q;teacherStat&q;:{&q;teacherId&q;:5418,&q;episodeCount&q;:1247,&q;scoreCount&q;:277060,&q;avgScore&q;:9.835154840106865,&q;fiveGradeAvgScore&q;:4.92,&q;updateTime&q;:1773586366127},&q;auditionEpisode&q;:{&q;episodeTitle&q;:&q;个人展示课&q;,&q;episodeVideoUrl&q;:&q;https://vod.fbstatic.cn/22e9ceb2vodbj1251001446/0f225a083560136621445998641/a18MDSiKuD8A.mp4?t=f2a4b300&a;us=4070880000&a;sign=37d51c78dbb190aa30426da491044bdf&q;},&q;memberOfCPC&q;:false,&q;tags&q;:null},&q;teachChannel&q;:1,&q;offline&q;:null,&q;duration&q;:2700,&q;hasAudition&q;:false,&q;bizType&q;:0,&q;bizId&q;:&q;773251&q;,&q;supportReplay&q;:true,&q;extraInfo&q;:null,&q;liveConfig&q;:{&q;episodeId&q;:11705787,&q;supportMultiGroup&q;:false,&q;exerciseBizType&q;:0,&q;videoDisplayType&q;:0,&q;avForwardType&q;:0,&q;useIntelligentRoom&q;:false,&q;hasStrokeKeynote&q;:false,&q;verticalModeType&q;:0,&q;originEpisodeId&q;:0,&q;supportRtmp&q;:false,&q;supportPk&q;:false,&q;supportLuckyBag&q;:false,&q;supportUserNoteStroke&q;:false,&q;communicateType&q;:0,&q;fakeLive&q;:false,&q;one2One&q;:false},&q;validStatus&q;:1,&q;supportLive&q;:true,&q;supportAiCatalog&q;:false,&q;hasIntelligentPen&q;:false,&q;useLocalRecording&q;:false,&q;useIntelligentRoom&q;:false,&q;hasSalePosition&q;:false,&q;hasEpisodeCards&q;:false,&q;lockedForShouna&q;:false,&q;needSignIn&q;:false,&q;needTeacherSignIn&q;:false,&q;enablePadPencil&q;:false,&q;displayExercise&q;:false,&q;supportLuckyBag&q;:false,&q;supportLivePk&q;:false},{&q;id&q;:11705788,&q;kePrefix&q;:&q;gwy&q;,&q;courseId&q;:1,&q;status&q;:0,&q;playStatus&q;:0,&q;type&q;:1,&q;recordingType&q;:0,&q;mediaType&q;:0,&q;title&q;:&q;晚课-热点夜话18&q;,&q;innerTitle&q;:&q;&q;,&q;startTime&q;:1774447200000,&q;endTime&q;:1774449900000,&q;teacher&q;:{&q;id&q;:13635,&q;userId&q;:66803519,&q;name&q;:&q;张易也&q;,&q;brief&q;:&q;粉笔判断、综应优质教师&q;,&q;desc&q;:&q;粉笔判断、综应优质教师，985高校毕业，6年公考培训经验，授课经验丰富，服务学员众多。粉笔系统评分4.9分，对于判断学科有着精准细致的把握，授课风格严肃而不失活泼，对学生高标准严要求，对课堂有着精准的安排和把握，善于用简单直白的话语解释复杂艰深的逻辑关系。&q;,&q;avatar&q;:&q;1928a7c056a5334.jpg&q;,&q;upperBodyPhoto&q;:null,&q;displayCoursePrefix&q;:&q;gwy&q;,&q;teacherStat&q;:{&q;teacherId&q;:13635,&q;episodeCount&q;:1088,&q;scoreCount&q;:3676,&q;avgScore&q;:9.914581066376458,&q;fiveGradeAvgScore&q;:4.96,&q;updateTime&q;:1773621696609},&q;auditionEpisode&q;:{&q;episodeTitle&q;:&q;个人展示课&q;,&q;episodeVideoUrl&q;:&q;https://vod.fbstatic.cn/22e9ceb2vodbj1251001446/8481f4d63560136621457221164/fxynwMS1SSwA.mp4?t=f2a4b300&a;us=4070880000&a;sign=f90639d1c7a1c1d931bf99c7977de236&q;},&q;memberOfCPC&q;:false,&q;tags&q;:null},&q;teachChannel&q;:1,&q;offline&q;:null,&q;duration&q;:2700,&q;hasAudition&q;:false,&q;bizType&q;:0,&q;bizId&q;:&q;773251&q;,&q;supportReplay&q;:true,&q;extraInfo&q;:null,&q;liveConfig&q;:{&q;episodeId&q;:11705788,&q;supportMultiGroup&q;:false,&q;exerciseBizType&q;:0,&q;videoDisplayType&q;:0,&q;avForwardType&q;:0,&q;useIntelligentRoom&q;:false,&q;hasStrokeKeynote&q;:false,&q;verticalModeType&q;:0,&q;originEpisodeId&q;:0,&q;supportRtmp&q;:false,&q;supportPk&q;:false,&q;supportLuckyBag&q;:false,&q;supportUserNoteStroke&q;:false,&q;communicateType&q;:0,&q;fakeLive&q;:false,&q;one2One&q;:false},&q;validStatus&q;:1,&q;supportLive&q;:true,&q;supportAiCatalog&q;:false,&q;hasIntelligentPen&q;:false,&q;useLocalRecording&q;:false,&q;useIntelligentRoom&q;:false,&q;hasSalePosition&q;:false,&q;hasEpisodeCards&q;:false,&q;lockedForShouna&q;:false,&q;needSignIn&q;:false,&q;needTeacherSignIn&q;:false,&q;enablePadPencil&q;:false,&q;displayExercise&q;:false,&q;supportLuckyBag&q;:false,&q;supportLivePk&q;:false},{&q;id&q;:11705789,&q;kePrefix&q;:&q;gwy&q;,&q;courseId&q;:1,&q;status&q;:0,&q;playStatus&q;:0,&q;type&q;:1,&q;recordingType&q;:0,&q;mediaType&q;:0,&q;title&q;:&q;早课-计算能力速成（二）&q;,&q;innerTitle&q;:&q;&q;,&q;startTime&q;:1774479600000,&q;endTime&q;:1774482300000,&q;teacher&q;:{&q;id&q;:241,&q;userId&q;:53092312,&q;name&q;:&q;刘凯&q;,&q;brief&q;:&q;粉笔数资优质教师&q;,&q;desc&q;:&q;粉笔数资优质教师，13年公考事考授课经验，同时培训师资数百名，长期致力于公考事考研究。专业功底扎实，因材施教，授课深入浅出，注重学员思路的引导，让学员在理解的基础上更好的学习数资知识，方法实用性强，深受学员好评。&q;,&q;avatar&q;:&q;17203354d2273fc.jpg&q;,&q;upperBodyPhoto&q;:null,&q;displayCoursePrefix&q;:&q;gwy&q;,&q;teacherStat&q;:{&q;teacherId&q;:241,&q;episodeCount&q;:1290,&q;scoreCount&q;:304514,&q;avgScore&q;:9.840066466566421,&q;fiveGradeAvgScore&q;:4.92,&q;updateTime&q;:1773619643676},&q;auditionEpisode&q;:{&q;episodeTitle&q;:&q;个人展示课&q;,&q;episodeVideoUrl&q;:&q;https://vod.fbstatic.cn/22e9ceb2vodbj1251001446/9d496bc13560136621447479800/VJWLl8XByEAA.mp4?t=f2a4b300&a;us=4070880000&a;sign=8cde3ed0892f39d2c645169b86462c16&q;},&q;memberOfCPC&q;:false,&q;tags&q;:null},&q;teachChannel&q;:1,&q;offline&q;:null,&q;duration&q;:2700,&q;hasAudition&q;:false,&q;bizType&q;:0,&q;bizId&q;:&q;773251&q;,&q;supportReplay&q;:true,&q;extraInfo&q;:null,&q;liveConfig&q;:{&q;episodeId&q;:11705789,&q;supportMultiGroup&q;:false,&q;exerciseBizType&q;:0,&q;videoDisplayType&q;:0,&q;avForwardType&q;:0,&q;useIntelligentRoom&q;:false,&q;hasStrokeKeynote&q;:false,&q;verticalModeType&q;:0,&q;originEpisodeId&q;:0,&q;supportRtmp&q;:false,&q;supportPk&q;:false,&q;supportLuckyBag&q;:false,&q;supportUserNoteStroke&q;:false,&q;communicateType&q;:0,&q;fakeLive&q;:false,&q;one2One&q;:false},&q;validStatus&q;:1,&q;supportLive&q;:true,&q;supportAiCatalog&q;:false,&q;hasIntelligentPen&q;:false,&q;useLocalRecording&q;:false,&q;useIntelligentRoom&q;:false,&q;hasSalePosition&q;:false,&q;hasEpisodeCards&q;:false,&q;lockedForShouna&q;:false,&q;needSignIn&q;:false,&q;needTeacherSignIn&q;:false,&q;enablePadPencil&q;:false,&q;displayExercise&q;:false,&q;supportLuckyBag&q;:false,&q;supportLivePk&q;:false},{&q;id&q;:11705790,&q;kePrefix&q;:&q;gwy&q;,&q;courseId&q;:1,&q;status&q;:0,&q;playStatus&q;:0,&q;type&q;:1,&q;recordingType&q;:0,&q;mediaType&q;:0,&q;title&q;:&q;晚课-热点夜话19&q;,&q;innerTitle&q;:&q;&q;,&q;startTime&q;:1774533600000,&q;endTime&q;:1774536300000,&q;teacher&q;:{&q;id&q;:2567,&q;userId&q;:43307158,&q;name&q;:&q;艾小丁&q;,&q;brief&q;:&q;粉笔面试研究院成员、高级面试讲师&q;,&q;desc&q;:&q;8年公考面试授课经验，粉笔大区面试教学教研负责人，主要承担国省考理论大课及各类线上公开课。有过多次面试高分实战经历。曾设计并主持多次粉笔面试老师培训会议，培训面试师资数千人。 \n艾小丁老师有多年一线授课经历与面试教研经验，灵活风趣，课堂氛围轻松。始终秉持“千人千面”的教学理念，善于引导学员理解面试的底层逻辑，发掘自身特点，从自己擅长的角度实现高效提升，成果显著。&q;,&q;avatar&q;:&q;19b0cf4f21e691e.jpg&q;,&q;upperBodyPhoto&q;:null,&q;displayCoursePrefix&q;:&q;gwy&q;,&q;teacherStat&q;:{&q;teacherId&q;:2567,&q;episodeCount&q;:1140,&q;scoreCount&q;:39146,&q;avgScore&q;:9.869054309508025,&q;fiveGradeAvgScore&q;:4.93,&q;updateTime&q;:1773589055187},&q;auditionEpisode&q;:{&q;episodeTitle&q;:&q;个人展示课&q;,&q;episodeVideoUrl&q;:&q;https://vod.fbstatic.cn/22e9ceb2vodbj1251001446/365026ea3270835013757549961/7azwde9iqIAA.mp4?t=f2a4b300&a;us=4070880000&a;sign=7ae333696ea68a3be68e8952550ff6ef&q;},&q;memberOfCPC&q;:false,&q;tags&q;:null},&q;teachChannel&q;:1,&q;offline&q;:null,&q;duration&q;:2700,&q;hasAudition&q;:false,&q;bizType&q;:0,&q;bizId&q;:&q;773251&q;,&q;supportReplay&q;:true,&q;extraInfo&q;:null,&q;liveConfig&q;:{&q;episodeId&q;:11705790,&q;supportMultiGroup&q;:false,&q;exerciseBizType&q;:0,&q;videoDisplayType&q;:0,&q;avForwardType&q;:0,&q;useIntelligentRoom&q;:false,&q;hasStrokeKeynote&q;:false,&q;verticalModeType&q;:0,&q;originEpisodeId&q;:0,&q;supportRtmp&q;:false,&q;supportPk&q;:false,&q;supportLuckyBag&q;:false,&q;supportUserNoteStroke&q;:false,&q;communicateType&q;:0,&q;fakeLive&q;:false,&q;one2One&q;:false},&q;validStatus&q;:1,&q;supportLive&q;:true,&q;supportAiCatalog&q;:false,&q;hasIntelligentPen&q;:false,&q;useLocalRecording&q;:false,&q;useIntelligentRoom&q;:false,&q;hasSalePosition&q;:false,&q;hasEpisodeCards&q;:false,&q;lockedForShouna&q;:false,&q;needSignIn&q;:false,&q;needTeacherSignIn&q;:false,&q;enablePadPencil&q;:false,&q;displayExercise&q;:false,&q;supportLuckyBag&q;:false,&q;supportLivePk&q;:false},{&q;id&q;:11705791,&q;kePrefix&q;:&q;gwy&q;,&q;courseId&q;:1,&q;status&q;:0,&q;playStatus&q;:0,&q;type&q;:1,&q;recordingType&q;:0,&q;mediaType&q;:0,&q;title&q;:&q;早课-申论提分必学好文（四）&q;,&q;innerTitle&q;:&q;&q;,&q;startTime&q;:1774566000000,&q;endTime&q;:1774568700000,&q;teacher&q;:{&q;id&q;:1491,&q;userId&q;:40445632,&q;name&q;:&q;李纳&q;,&q;brief&q;:&q;粉笔申论优质教师&q;,&q;desc&q;:&q;粉笔申论优质老师，\n9年公考授课经验，打分人次超20万，学员评分高达4.9分。\n长期致力于公考研究，对试题有深刻的把握和独到的见解。注重因材施教，授课深入浅出、通俗易懂。富有激情又不失幽默，课堂氛围活跃。&q;,&q;avatar&q;:&q;17587d0e130748e.jpg&q;,&q;upperBodyPhoto&q;:null,&q;displayCoursePrefix&q;:&q;gwy&q;,&q;teacherStat&q;:{&q;teacherId&q;:1491,&q;episodeCount&q;:1101,&q;scoreCount&q;:402422,&q;avgScore&q;:9.854351899250036,&q;fiveGradeAvgScore&q;:4.93,&q;updateTime&q;:1773585181685},&q;auditionEpisode&q;:{&q;episodeTitle&q;:&q;个人展示课&q;,&q;episodeVideoUrl&q;:&q;https://vod.fbstatic.cn/22e9ceb2vodbj1251001446/a3c805883560136621447705797/W2Ucye2AjXgA.mp4?t=f2a4b300&a;us=4070880000&a;sign=a628916274f31ee68e9e0419239f215e&q;},&q;memberOfCPC&q;:false,&q;tags&q;:null},&q;teachChannel&q;:1,&q;offline&q;:null,&q;duration&q;:2700,&q;hasAudition&q;:false,&q;bizType&q;:0,&q;bizId&q;:&q;773251&q;,&q;supportReplay&q;:true,&q;extraInfo&q;:null,&q;liveConfig&q;:{&q;episodeId&q;:11705791,&q;supportMultiGroup&q;:false,&q;exerciseBizType&q;:0,&q;videoDisplayType&q;:0,&q;avForwardType&q;:0,&q;useIntelligentRoom&q;:false,&q;hasStrokeKeynote&q;:false,&q;verticalModeType&q;:0,&q;originEpisodeId&q;:0,&q;supportRtmp&q;:false,&q;supportPk&q;:false,&q;supportLuckyBag&q;:false,&q;supportUserNoteStroke&q;:false,&q;communicateType&q;:0,&q;fakeLive&q;:false,&q;one2One&q;:false},&q;validStatus&q;:1,&q;supportLive&q;:true,&q;supportAiCatalog&q;:false,&q;hasIntelligentPen&q;:false,&q;useLocalRecording&q;:false,&q;useIntelligentRoom&q;:false,&q;hasSalePosition&q;:false,&q;hasEpisodeCards&q;:false,&q;lockedForShouna&q;:false,&q;needSignIn&q;:false,&q;needTeacherSignIn&q;:false,&q;enablePadPencil&q;:false,&q;displayExercise&q;:false,&q;supportLuckyBag&q;:false,&q;supportLivePk&q;:false},{&q;id&q;:11705792,&q;kePrefix&q;:&q;gwy&q;,&q;courseId&q;:1,&q;status&q;:0,&q;playStatus&q;:0,&q;type&q;:1,&q;recordingType&q;:0,&q;mediaType&q;:0,&q;title&q;:&q;晚课-热点夜话20&q;,&q;innerTitle&q;:&q;&q;,&q;startTime&q;:1774620000000,&q;endTime&q;:1774622700000,&q;teacher&q;:{&q;id&q;:12252,&q;userId&q;:60895825,&q;name&q;:&q;朱严&q;,&q;brief&q;:&q;粉笔面试研究院成员、高级面试讲师&q;,&q;desc&q;:&q;7年公考面试授课经验，粉笔培训部项目负责人之一，大区面试教学教研负责人。累计授课时长超过2000小时，负责培训师资2000+，粉笔客户端评分4.9分（满分5分）。主要负责师资面试能力提升的培训工作和一线教学教研工作，善于把自己在一线教学的感悟和实情融入日常师资的培训中，做到融会贯通。有过面试实战高分经历，曾在国考税务考试中从笔试压线进面，逆袭至总分第2名（岗位招3人）。 \n朱严老师教学培训严谨，能够聚焦不同地区的特色，准确把握面试学习的发力方向，授课力求精准化。授课耐心细致，注重因材施教，能够充分发挥学员的创造性。点评指导一针见血，帮助学员明确改进方向，让学员在面试学习中有更多的收获感，助力学员上岸。&q;,&q;avatar&q;:&q;1730e510528a227.jpg&q;,&q;upperBodyPhoto&q;:null,&q;displayCoursePrefix&q;:&q;gwy&q;,&q;teacherStat&q;:{&q;teacherId&q;:12252,&q;episodeCount&q;:492,&q;scoreCount&q;:7803,&q;avgScore&q;:9.870306292451621,&q;fiveGradeAvgScore&q;:4.94,&q;updateTime&q;:1773580246258},&q;auditionEpisode&q;:{&q;episodeTitle&q;:&q;个人展示课&q;,&q;episodeVideoUrl&q;:&q;https://vod.fbstatic.cn/22e9ceb2vodbj1251001446/623149aa1253642695625689240/CLuJL0kCqgQA.mp4?t=f2a4b300&a;us=4070880000&a;sign=39a2dbd4e450b7e9dc3d314f8957a992&q;},&q;memberOfCPC&q;:false,&q;tags&q;:null},&q;teachChannel&q;:1,&q;offline&q;:null,&q;duration&q;:2700,&q;hasAudition&q;:false,&q;bizType&q;:0,&q;bizId&q;:&q;773251&q;,&q;supportReplay&q;:true,&q;extraInfo&q;:null,&q;liveConfig&q;:{&q;episodeId&q;:11705792,&q;supportMultiGroup&q;:false,&q;exerciseBizType&q;:0,&q;videoDisplayType&q;:0,&q;avForwardType&q;:0,&q;useIntelligentRoom&q;:false,&q;hasStrokeKeynote&q;:false,&q;verticalModeType&q;:0,&q;originEpisodeId&q;:0,&q;supportRtmp&q;:false,&q;supportPk&q;:false,&q;supportLuckyBag&q;:false,&q;supportUserNoteStroke&q;:false,&q;communicateType&q;:0,&q;fakeLive&q;:false,&q;one2One&q;:false},&q;validStatus&q;:1,&q;supportLive&q;:true,&q;supportAiCatalog&q;:false,&q;hasIntelligentPen&q;:false,&q;useLocalRecording&q;:false,&q;useIntelligentRoom&q;:false,&q;hasSalePosition&q;:false,&q;hasEpisodeCards&q;:false,&q;lockedForShouna&q;:false,&q;needSignIn&q;:false,&q;needTeacherSignIn&q;:false,&q;enablePadPencil&q;:false,&q;displayExercise&q;:false,&q;supportLuckyBag&q;:false,&q;supportLivePk&q;:false},{&q;id&q;:11705793,&q;kePrefix&q;:&q;gwy&q;,&q;courseId&q;:1,&q;status&q;:0,&q;playStatus&q;:0,&q;type&q;:1,&q;recordingType&q;:0,&q;mediaType&q;:0,&q;title&q;:&q;早课-每月时政1&q;,&q;innerTitle&q;:&q;&q;,&q;startTime&q;:1774825200000,&q;endTime&q;:1774827000000,&q;teacher&q;:{&q;id&q;:11676,&q;userId&q;:44787868,&q;name&q;:&q;刘鸿&q;,&q;brief&q;:&q;粉笔公基优质讲师&q;,&q;desc&q;:&q;粉笔公考常识、公共基础知识优质讲师，累计授课1W+。9年公考培训经验，常年从事一线授课工作。对马克思主义哲学、中共党史、中国特色社会主义理论体系、大政方针时事政治等政治理论有系统研究。授课脉络清晰重点突出，课堂风格激情幽默，擅长学员备考规划指导及技巧点拨。&q;,&q;avatar&q;:&q;192d26d60f9ea18.jpg&q;,&q;upperBodyPhoto&q;:null,&q;displayCoursePrefix&q;:&q;gwy&q;,&q;teacherStat&q;:{&q;teacherId&q;:11676,&q;episodeCount&q;:764,&q;scoreCount&q;:235431,&q;avgScore&q;:9.907361392509907,&q;fiveGradeAvgScore&q;:4.95,&q;updateTime&q;:1773623300330},&q;auditionEpisode&q;:null,&q;memberOfCPC&q;:false,&q;tags&q;:null},&q;teachChannel&q;:1,&q;offline&q;:null,&q;duration&q;:1800,&q;hasAudition&q;:false,&q;bizType&q;:0,&q;bizId&q;:&q;773251&q;,&q;supportReplay&q;:true,&q;extraInfo&q;:null,&q;liveConfig&q;:{&q;episodeId&q;:11705793,&q;supportMultiGroup&q;:false,&q;exerciseBizType&q;:0,&q;videoDisplayType&q;:0,&q;avForwardType&q;:0,&q;useIntelligentRoom&q;:false,&q;hasStrokeKeynote&q;:false,&q;verticalModeType&q;:0,&q;originEpisodeId&q;:0,&q;supportRtmp&q;:false,&q;supportPk&q;:false,&q;supportLuckyBag&q;:false,&q;supportUserNoteStroke&q;:false,&q;communicateType&q;:0,&q;fakeLive&q;:false,&q;one2One&q;:false},&q;validStatus&q;:1,&q;supportLive&q;:true,&q;supportAiCatalog&q;:false,&q;hasIntelligentPen&q;:false,&q;useLocalRecording&q;:false,&q;useIntelligentRoom&q;:false,&q;hasSalePosition&q;:false,&q;hasEpisodeCards&q;:false,&q;lockedForShouna&q;:false,&q;needSignIn&q;:false,&q;needTeacherSignIn&q;:false,&q;enablePadPencil&q;:false,&q;displayExercise&q;:false,&q;supportLuckyBag&q;:false,&q;supportLivePk&q;:false},{&q;id&q;:11705794,&q;kePrefix&q;:&q;gwy&q;,&q;courseId&q;:1,&q;status&q;:0,&q;playStatus&q;:0,&q;type&q;:1,&q;recordingType&q;:0,&q;mediaType&q;:0,&q;title&q;:&q;晚课-热点夜话21&q;,&q;innerTitle&q;:&q;&q;,&q;startTime&q;:1774879200000,&q;endTime&q;:1774881900000,&q;teacher&q;:{&q;id&q;:4791,&q;userId&q;:51346254,&q;name&q;:&q;林秋莹&q;,&q;brief&q;:&q;粉笔面试研究院成员、高级面试讲师&q;,&q;desc&q;:&q;8年公考面试授课经验，粉笔大区面试教学教研负责人，主要承担面试各类培训的策划组织、授课培训工作，同时承担国省考各类线上公开课，粉笔培训部项目负责人，获得粉笔”卓越教师”称号。 \n林秋莹老师凭借多年一线授课、培训、研发工作经验，掌握大量的面试方法技巧、干货知识素材与政府思维逻辑，深谙面试作答之道，能够把海量备考内容转化成精简的技巧内容。深入浅出，举一反三答出反套路有深度的内容，让学生高效备考，少走弯路。同时深度结合每位学生的特点，打造个性化，让学员在课堂中展现自我风采，轻松掌握面试。&q;,&q;avatar&q;:&q;1720cd00cce8f13.jpg&q;,&q;upperBodyPhoto&q;:null,&q;displayCoursePrefix&q;:&q;gwy&q;,&q;teacherStat&q;:{&q;teacherId&q;:4791,&q;episodeCount&q;:826,&q;scoreCount&q;:11458,&q;avgScore&q;:9.864025135276655,&q;fiveGradeAvgScore&q;:4.93,&q;updateTime&q;:1773623280272},&q;auditionEpisode&q;:{&q;episodeTitle&q;:&q;个人展示课&q;,&q;episodeVideoUrl&q;:&q;https://vod.fbstatic.cn/22e9ceb2vodbj1251001446/f6a7f0f73270835013753033481/r57CET8eRCMA.mp4?t=f2a4b300&a;us=4070880000&a;sign=ba11551c01f5b7967383de833b064957&q;},&q;memberOfCPC&q;:false,&q;tags&q;:null},&q;teachChannel&q;:1,&q;offline&q;:null,&q;duration&q;:2700,&q;hasAudition&q;:false,&q;bizType&q;:0,&q;bizId&q;:&q;773251&q;,&q;supportReplay&q;:true,&q;extraInfo&q;:null,&q;liveConfig&q;:{&q;episodeId&q;:11705794,&q;supportMultiGroup&q;:false,&q;exerciseBizType&q;:0,&q;videoDisplayType&q;:0,&q;avForwardType&q;:0,&q;useIntelligentRoom&q;:false,&q;hasStrokeKeynote&q;:false,&q;verticalModeType&q;:0,&q;originEpisodeId&q;:0,&q;supportRtmp&q;:false,&q;supportPk&q;:false,&q;supportLuckyBag&q;:false,&q;supportUserNoteStroke&q;:false,&q;communicateType&q;:0,&q;fakeLive&q;:false,&q;one2One&q;:false},&q;validStatus&q;:1,&q;supportLive&q;:true,&q;supportAiCatalog&q;:false,&q;hasIntelligentPen&q;:false,&q;useLocalRecording&q;:false,&q;useIntelligentRoom&q;:false,&q;hasSalePosition&q;:false,&q;hasEpisodeCards&q;:false,&q;lockedForShouna&q;:false,&q;needSignIn&q;:false,&q;needTeacherSignIn&q;:false,&q;enablePadPencil&q;:false,&q;displayExercise&q;:false,&q;supportLuckyBag&q;:false,&q;supportLivePk&q;:false},{&q;id&q;:11705795,&q;kePrefix&q;:&q;gwy&q;,&q;courseId&q;:1,&q;status&q;:0,&q;playStatus&q;:0,&q;type&q;:1,&q;recordingType&q;:0,&q;mediaType&q;:0,&q;title&q;:&q;早课-每月时政2&q;,&q;innerTitle&q;:&q;&q;,&q;startTime&q;:1774911600000,&q;endTime&q;:1774913400000,&q;teacher&q;:{&q;id&q;:4372,&q;userId&q;:45812058,&q;name&q;:&q;夏方军&q;,&q;brief&q;:&q;粉笔公基优质教师&q;,&q;desc&q;:&q;粉笔公基优质教师，岗位第一考入食药系统，一年编制工作经历，八年公考事业编授课经历。对政治理论、时政常识、面试有深入研究，擅长从热点、考情维度进行预判。授课细致耐心、思维发散清晰，学生的“小姨夫”。&q;,&q;avatar&q;:&q;19407933436c6d4.jpg&q;,&q;upperBodyPhoto&q;:null,&q;displayCoursePrefix&q;:&q;gwy&q;,&q;teacherStat&q;:{&q;teacherId&q;:4372,&q;episodeCount&q;:1059,&q;scoreCount&q;:209965,&q;avgScore&q;:9.894925344700331,&q;fiveGradeAvgScore&q;:4.95,&q;updateTime&q;:1773623280251},&q;auditionEpisode&q;:{&q;episodeTitle&q;:&q;个人展示课&q;,&q;episodeVideoUrl&q;:&q;https://vod.fbstatic.cn/22e9ceb2vodbj1251001446/65771a37243791580257902972/f0.mp4?t=f2a4b300&a;us=4070880000&a;sign=fe62d49b4742040836cd99e0a96d0768&q;},&q;memberOfCPC&q;:false,&q;tags&q;:null},&q;teachChannel&q;:1,&q;offline&q;:null,&q;duration&q;:1800,&q;hasAudition&q;:false,&q;bizType&q;:0,&q;bizId&q;:&q;773251&q;,&q;supportReplay&q;:true,&q;extraInfo&q;:null,&q;liveConfig&q;:{&q;episodeId&q;:11705795,&q;supportMultiGroup&q;:false,&q;exerciseBizType&q;:0,&q;videoDisplayType&q;:0,&q;avForwardType&q;:0,&q;useIntelligentRoom&q;:false,&q;hasStrokeKeynote&q;:false,&q;verticalModeType&q;:0,&q;originEpisodeId&q;:0,&q;supportRtmp&q;:false,&q;supportPk&q;:false,&q;supportLuckyBag&q;:false,&q;supportUserNoteStroke&q;:false,&q;communicateType&q;:0,&q;fakeLive&q;:false,&q;one2One&q;:false},&q;validStatus&q;:1,&q;supportLive&q;:true,&q;supportAiCatalog&q;:false,&q;hasIntelligentPen&q;:false,&q;useLocalRecording&q;:false,&q;useIntelligentRoom&q;:false,&q;hasSalePosition&q;:false,&q;hasEpisodeCards&q;:false,&q;lockedForShouna&q;:false,&q;needSignIn&q;:false,&q;needTeacherSignIn&q;:false,&q;enablePadPencil&q;:false,&q;displayExercise&q;:false,&q;supportLuckyBag&q;:false,&q;supportLivePk&q;:false},{&q;id&q;:11705796,&q;kePrefix&q;:&q;gwy&q;,&q;courseId&q;:1,&q;status&q;:0,&q;playStatus&q;:0,&q;type&q;:1,&q;recordingType&q;:0,&q;mediaType&q;:0,&q;title&q;:&q;晚课-热点夜话22&q;,&q;innerTitle&q;:&q;&q;,&q;startTime&q;:1774965600000,&q;endTime&q;:1774968300000,&q;teacher&q;:{&q;id&q;:4432,&q;userId&q;:15393595,&q;name&q;:&q;唐圣楠&q;,&q;brief&q;:&q;粉笔面试研究院成员、高级面试讲师&q;,&q;desc&q;:&q;2年公务员工作经验，7年公考面试授课经验，粉笔卓越教师。\n唐圣楠老师有面试高分实战经历，熟悉政府各项工作。7年来深耕于面试教学一线，线下精品小班和线上千人大课兼顾，从业7年间累计授课人次超过 5000 人，授课时长超过 4000 小时，善于挖掘考生个人优势，突破面试瓶颈。同时是粉笔培训项目负责人，粉笔教学教研团队成员。每年受邀撰写省考面试高频考点和真题解析，主导撰写《真题精练50题》等图书，深度组织参与结构化和结构化小组面试理论的研发升级。&q;,&q;avatar&q;:&q;172984dddabdf3e.jpg&q;,&q;upperBodyPhoto&q;:null,&q;displayCoursePrefix&q;:&q;gwy&q;,&q;teacherStat&q;:{&q;teacherId&q;:4432,&q;episodeCount&q;:1180,&q;scoreCount&q;:9935,&q;avgScore&q;:9.871565173628591,&q;fiveGradeAvgScore&q;:4.94,&q;updateTime&q;:1773615380133},&q;auditionEpisode&q;:{&q;episodeTitle&q;:&q;个人展示课&q;,&q;episodeVideoUrl&q;:&q;https://vod.fbstatic.cn/22e9ceb2vodbj1251001446/e79772521397757910063658844/07JN4CCRa7UA.mp4?t=f2a4b300&a;us=4070880000&a;sign=aadad9d80d32fd5bc0a9f57128cdc699&q;},&q;memberOfCPC&q;:false,&q;tags&q;:null},&q;teachChannel&q;:1,&q;offline&q;:null,&q;duration&q;:2700,&q;hasAudition&q;:false,&q;bizType&q;:0,&q;bizId&q;:&q;773251&q;,&q;supportReplay&q;:true,&q;extraInfo&q;:null,&q;liveConfig&q;:{&q;episodeId&q;:11705796,&q;supportMultiGroup&q;:false,&q;exerciseBizType&q;:0,&q;videoDisplayType&q;:0,&q;avForwardType&q;:0,&q;useIntelligentRoom&q;:false,&q;hasStrokeKeynote&q;:false,&q;verticalModeType&q;:0,&q;originEpisodeId&q;:0,&q;supportRtmp&q;:false,&q;supportPk&q;:false,&q;supportLuckyBag&q;:false,&q;supportUserNoteStroke&q;:false,&q;communicateType&q;:0,&q;fakeLive&q;:false,&q;one2One&q;:false},&q;validStatus&q;:1,&q;supportLive&q;:true,&q;supportAiCatalog&q;:false,&q;hasIntelligentPen&q;:false,&q;useLocalRecording&q;:false,&q;useIntelligentRoom&q;:false,&q;hasSalePosition&q;:false,&q;hasEpisodeCards&q;:false,&q;lockedForShouna&q;:false,&q;needSignIn&q;:false,&q;needTeacherSignIn&q;:false,&q;enablePadPencil&q;:false,&q;displayExercise&q;:false,&q;supportLuckyBag&q;:false,&q;supportLivePk&q;:false},{&q;id&q;:11705797,&q;kePrefix&q;:&q;gwy&q;,&q;courseId&q;:1,&q;status&q;:0,&q;playStatus&q;:0,&q;type&q;:1,&q;recordingType&q;:0,&q;mediaType&q;:0,&q;title&q;:&q;早课-每月时政3&q;,&q;innerTitle&q;:&q;&q;,&q;startTime&q;:1774998000000,&q;endTime&q;:1774999800000,&q;teacher&q;:{&q;id&q;:4372,&q;userId&q;:45812058,&q;name&q;:&q;夏方军&q;,&q;brief&q;:&q;粉笔公基优质教师&q;,&q;desc&q;:&q;粉笔公基优质教师，岗位第一考入食药系统，一年编制工作经历，八年公考事业编授课经历。对政治理论、时政常识、面试有深入研究，擅长从热点、考情维度进行预判。授课细致耐心、思维发散清晰，学生的“小姨夫”。&q;,&q;avatar&q;:&q;19407933436c6d4.jpg&q;,&q;upperBodyPhoto&q;:null,&q;displayCoursePrefix&q;:&q;gwy&q;,&q;teacherStat&q;:{&q;teacherId&q;:4372,&q;episodeCount&q;:1059,&q;scoreCount&q;:209965,&q;avgScore&q;:9.894925344700331,&q;fiveGradeAvgScore&q;:4.95,&q;updateTime&q;:1773623280251},&q;auditionEpisode&q;:{&q;episodeTitle&q;:&q;个人展示课&q;,&q;episodeVideoUrl&q;:&q;https://vod.fbstatic.cn/22e9ceb2vodbj1251001446/65771a37243791580257902972/f0.mp4?t=f2a4b300&a;us=4070880000&a;sign=fe62d49b4742040836cd99e0a96d0768&q;},&q;memberOfCPC&q;:false,&q;tags&q;:null},&q;teachChannel&q;:1,&q;offline&q;:null,&q;duration&q;:1800,&q;hasAudition&q;:false,&q;bizType&q;:0,&q;bizId&q;:&q;773251&q;,&q;supportReplay&q;:true,&q;extraInfo&q;:null,&q;liveConfig&q;:{&q;episodeId&q;:11705797,&q;supportMultiGroup&q;:false,&q;exerciseBizType&q;:0,&q;videoDisplayType&q;:0,&q;avForwardType&q;:0,&q;useIntelligentRoom&q;:false,&q;hasStrokeKeynote&q;:false,&q;verticalModeType&q;:0,&q;originEpisodeId&q;:0,&q;supportRtmp&q;:false,&q;supportPk&q;:false,&q;supportLuckyBag&q;:false,&q;supportUserNoteStroke&q;:false,&q;communicateType&q;:0,&q;fakeLive&q;:false,&q;one2One&q;:false},&q;validStatus&q;:1,&q;supportLive&q;:true,&q;supportAiCatalog&q;:false,&q;hasIntelligentPen&q;:false,&q;useLocalRecording&q;:false,&q;useIntelligentRoom&q;:false,&q;hasSalePosition&q;:false,&q;hasEpisodeCards&q;:false,&q;lockedForShouna&q;:false,&q;needSignIn&q;:false,&q;needTeacherSignIn&q;:false,&q;enablePadPencil&q;:false,&q;displayExercise&q;:false,&q;supportLuckyBag&q;:false,&q;supportLivePk&q;:false},{&q;id&q;:11705798,&q;kePrefix&q;:&q;gwy&q;,&q;courseId&q;:1,&q;status&q;:0,&q;playStatus&q;:0,&q;type&q;:1,&q;recordingType&q;:0,&q;mediaType&q;:0,&q;title&q;:&q;晚课-热点夜话23&q;,&q;innerTitle&q;:&q;&q;,&q;startTime&q;:1775052000000,&q;endTime&q;:1775054700000,&q;teacher&q;:{&q;id&q;:13823,&q;userId&q;:58626581,&q;name&q;:&q;王微&q;,&q;brief&q;:&q;粉笔面试优质教师&q;,&q;desc&q;:&q;       粉笔面试优质教师\n       大区面试教学教研负责人，粉笔面试大课骨干教师，人气面试讲师，高级培训师，直播工作核心教师，曾任某线上公益就业平台主持人。\n8年公考面试授课经验，累计授课时长15000h+，授课学员100000+，累计培训师资5000+；主要承担国省考理论大课、各类线上公开课及平台直播等授课任务，并参与组织多次授课研讨、图书撰写、解析编撰等工作。 授课亲切自然，富有激情，逻辑清晰，讲授内容通俗易懂接地气，深度高度两相宜。深谙面试学习重点难点，善于抓取学员问题并逐个击破，引导学员回归面试本质，让思维不断发散，用真情打动考官！       \n       粉笔教研教学团队成员，参与粉笔多省的教学研发工作，受邀出镜录制面试真题示范答题 22 道，并在粉笔题库进行展示。参加 22 次粉笔面试授课研讨会议，全面把握公考面试命题趋势及最新考情，积累丰富面试知识。参加 48 次粉笔面试教研活动，分享授课经验心得，助力粉笔面试理论研发升级。​&q;,&q;avatar&q;:&q;173998e78802a13.jpg&q;,&q;upperBodyPhoto&q;:null,&q;displayCoursePrefix&q;:&q;gwy&q;,&q;teacherStat&q;:{&q;teacherId&q;:13823,&q;episodeCount&q;:642,&q;scoreCount&q;:30161,&q;avgScore&q;:9.86107887669507,&q;fiveGradeAvgScore&q;:4.93,&q;updateTime&q;:1773574398582},&q;auditionEpisode&q;:{&q;episodeTitle&q;:&q;个人展示课&q;,&q;episodeVideoUrl&q;:&q;https://vod.fbstatic.cn/22e9ceb2vodbj1251001446/ad4d45cf243791580414529514/f0.mp4?t=f2a4b300&a;us=4070880000&a;sign=b8b6ba805911da7e41d00c7ce19dfacd&q;},&q;memberOfCPC&q;:false,&q;tags&q;:null},&q;teachChannel&q;:1,&q;offline&q;:null,&q;duration&q;:2700,&q;hasAudition&q;:false,&q;bizType&q;:0,&q;bizId&q;:&q;773251&q;,&q;supportReplay&q;:true,&q;extraInfo&q;:null,&q;liveConfig&q;:{&q;episodeId&q;:11705798,&q;supportMultiGroup&q;:false,&q;exerciseBizType&q;:0,&q;videoDisplayType&q;:0,&q;avForwardType&q;:0,&q;useIntelligentRoom&q;:false,&q;hasStrokeKeynote&q;:false,&q;verticalModeType&q;:0,&q;originEpisodeId&q;:0,&q;supportRtmp&q;:false,&q;supportPk&q;:false,&q;supportLuckyBag&q;:false,&q;supportUserNoteStroke&q;:false,&q;communicateType&q;:0,&q;fakeLive&q;:false,&q;one2One&q;:false},&q;validStatus&q;:1,&q;supportLive&q;:true,&q;supportAiCatalog&q;:false,&q;hasIntelligentPen&q;:false,&q;useLocalRecording&q;:false,&q;useIntelligentRoom&q;:false,&q;hasSalePosition&q;:false,&q;hasEpisodeCards&q;:false,&q;lockedForShouna&q;:false,&q;needSignIn&q;:false,&q;needTeacherSignIn&q;:false,&q;enablePadPencil&q;:false,&q;displayExercise&q;:false,&q;supportLuckyBag&q;:false,&q;supportLivePk&q;:false},{&q;id&q;:11705799,&q;kePrefix&q;:&q;gwy&q;,&q;courseId&q;:1,&q;status&q;:0,&q;playStatus&q;:0,&q;type&q;:1,&q;recordingType&q;:0,&q;mediaType&q;:0,&q;title&q;:&q;早课-每月时政4&q;,&q;innerTitle&q;:&q;&q;,&q;startTime&q;:1775084400000,&q;endTime&q;:1775086200000,&q;teacher&q;:{&q;id&q;:11249,&q;userId&q;:64782764,&q;name&q;:&q;刘烨&q;,&q;brief&q;:&q;粉笔公基、常识优质教师&q;,&q;desc&q;:&q;粉笔公基、常识优质教师。\n9年一线授课教研经验，累计授课时长超1w小时，学员评分高达4.9分。老师始终以生动有趣、激发学生思维为教学宗旨，善于将课堂内容化繁为简、化难为易，将晦涩知识通过日常生活的案例呈现，使学员在较短时间内能够更清晰地掌握所学知识。&q;,&q;avatar&q;:&q;192d26d6a1107c0.jpg&q;,&q;upperBodyPhoto&q;:null,&q;displayCoursePrefix&q;:&q;gwy&q;,&q;teacherStat&q;:{&q;teacherId&q;:11249,&q;episodeCount&q;:861,&q;scoreCount&q;:51878,&q;avgScore&q;:9.866263155865685,&q;fiveGradeAvgScore&q;:4.93,&q;updateTime&q;:1773622237480},&q;auditionEpisode&q;:null,&q;memberOfCPC&q;:false,&q;tags&q;:null},&q;teachChannel&q;:1,&q;offline&q;:null,&q;duration&q;:1800,&q;hasAudition&q;:false,&q;bizType&q;:0,&q;bizId&q;:&q;773251&q;,&q;supportReplay&q;:true,&q;extraInfo&q;:null,&q;liveConfig&q;:{&q;episodeId&q;:11705799,&q;supportMultiGroup&q;:false,&q;exerciseBizType&q;:0,&q;videoDisplayType&q;:0,&q;avForwardType&q;:0,&q;useIntelligentRoom&q;:false,&q;hasStrokeKeynote&q;:false,&q;verticalModeType&q;:0,&q;originEpisodeId&q;:0,&q;supportRtmp&q;:false,&q;supportPk&q;:false,&q;supportLuckyBag&q;:false,&q;supportUserNoteStroke&q;:false,&q;communicateType&q;:0,&q;fakeLive&q;:false,&q;one2One&q;:false},&q;validStatus&q;:1,&q;supportLive&q;:true,&q;supportAiCatalog&q;:false,&q;hasIntelligentPen&q;:false,&q;useLocalRecording&q;:false,&q;useIntelligentRoom&q;:false,&q;hasSalePosition&q;:false,&q;hasEpisodeCards&q;:false,&q;lockedForShouna&q;:false,&q;needSignIn&q;:false,&q;needTeacherSignIn&q;:false,&q;enablePadPencil&q;:false,&q;displayExercise&q;:false,&q;supportLuckyBag&q;:false,&q;supportLivePk&q;:false},{&q;id&q;:11705800,&q;kePrefix&q;:&q;gwy&q;,&q;courseId&q;:1,&q;status&q;:0,&q;playStatus&q;:0,&q;type&q;:1,&q;recordingType&q;:0,&q;mediaType&q;:0,&q;title&q;:&q;晚课-热点夜话24&q;,&q;innerTitle&q;:&q;&q;,&q;startTime&q;:1775138400000,&q;endTime&q;:1775141100000,&q;teacher&q;:{&q;id&q;:4345,&q;userId&q;:49646700,&q;name&q;:&q;马影&q;,&q;brief&q;:&q;粉笔面试研究院成员、高级面试讲师&q;,&q;desc&q;:&q;       7 年公考面试授课经验，粉笔华南大区面试教学教研负责人，主要承担国省考理论大课及各类线上公开课。曾任粉笔面试培训负责人，作为主培训师培训面试师资数千人。 \n       马影老师多年深耕授课一线，面试教学教研经验丰富，授课逻辑清晰，讲解言简意赅，始终相信“复杂的不是问题，而是看问题的眼睛，好老师应该把复杂的知识简单化，而不是把简单的知识复杂化。”&q;,&q;avatar&q;:&q;171831fc08abd68.png&q;,&q;upperBodyPhoto&q;:null,&q;displayCoursePrefix&q;:&q;gwy&q;,&q;teacherStat&q;:{&q;teacherId&q;:4345,&q;episodeCount&q;:772,&q;scoreCount&q;:27886,&q;avgScore&q;:9.866456286308543,&q;fiveGradeAvgScore&q;:4.93,&q;updateTime&q;:1773621596496},&q;auditionEpisode&q;:{&q;episodeTitle&q;:&q;个人展示课&q;,&q;episodeVideoUrl&q;:&q;https://vod.fbstatic.cn/22e9ceb2vodbj1251001446/2d1f97403270835013757169233/fVNXhL9Rzi8A.mp4?t=f2a4b300&a;us=4070880000&a;sign=c498a50a2a0932f505e4290200e585b7&q;},&q;memberOfCPC&q;:false,&q;tags&q;:null},&q;teachChannel&q;:1,&q;offline&q;:null,&q;duration&q;:2700,&q;hasAudition&q;:false,&q;bizType&q;:0,&q;bizId&q;:&q;773251&q;,&q;supportReplay&q;:true,&q;extraInfo&q;:null,&q;liveConfig&q;:{&q;episodeId&q;:11705800,&q;supportMultiGroup&q;:false,&q;exerciseBizType&q;:0,&q;videoDisplayType&q;:0,&q;avForwardType&q;:0,&q;useIntelligentRoom&q;:false,&q;hasStrokeKeynote&q;:false,&q;verticalModeType&q;:0,&q;originEpisodeId&q;:0,&q;supportRtmp&q;:false,&q;supportPk&q;:false,&q;supportLuckyBag&q;:false,&q;supportUserNoteStroke&q;:false,&q;communicateType&q;:0,&q;fakeLive&q;:false,&q;one2One&q;:false},&q;validStatus&q;:1,&q;supportLive&q;:true,&q;supportAiCatalog&q;:false,&q;hasIntelligentPen&q;:false,&q;useLocalRecording&q;:false,&q;useIntelligentRoom&q;:false,&q;hasSalePosition&q;:false,&q;hasEpisodeCards&q;:false,&q;lockedForShouna&q;:false,&q;needSignIn&q;:false,&q;needTeacherSignIn&q;:false,&q;enablePadPencil&q;:false,&q;displayExercise&q;:false,&q;supportLuckyBag&q;:false,&q;supportLivePk&q;:false},{&q;id&q;:11705801,&q;kePrefix&q;:&q;gwy&q;,&q;courseId&q;:1,&q;status&q;:0,&q;playStatus&q;:0,&q;type&q;:1,&q;recordingType&q;:0,&q;mediaType&q;:0,&q;title&q;:&q;早课-每月时政5&q;,&q;innerTitle&q;:&q;&q;,&q;startTime&q;:1775170800000,&q;endTime&q;:1775172600000,&q;teacher&q;:{&q;id&q;:11249,&q;userId&q;:64782764,&q;name&q;:&q;刘烨&q;,&q;brief&q;:&q;粉笔公基、常识优质教师&q;,&q;desc&q;:&q;粉笔公基、常识优质教师。\n9年一线授课教研经验，累计授课时长超1w小时，学员评分高达4.9分。老师始终以生动有趣、激发学生思维为教学宗旨，善于将课堂内容化繁为简、化难为易，将晦涩知识通过日常生活的案例呈现，使学员在较短时间内能够更清晰地掌握所学知识。&q;,&q;avatar&q;:&q;192d26d6a1107c0.jpg&q;,&q;upperBodyPhoto&q;:null,&q;displayCoursePrefix&q;:&q;gwy&q;,&q;teacherStat&q;:{&q;teacherId&q;:11249,&q;episodeCount&q;:861,&q;scoreCount&q;:51878,&q;avgScore&q;:9.866263155865685,&q;fiveGradeAvgScore&q;:4.93,&q;updateTime&q;:1773622237480},&q;auditionEpisode&q;:null,&q;memberOfCPC&q;:false,&q;tags&q;:null},&q;teachChannel&q;:1,&q;offline&q;:null,&q;duration&q;:1800,&q;hasAudition&q;:false,&q;bizType&q;:0,&q;bizId&q;:&q;773251&q;,&q;supportReplay&q;:true,&q;extraInfo&q;:null,&q;liveConfig&q;:{&q;episodeId&q;:11705801,&q;supportMultiGroup&q;:false,&q;exerciseBizType&q;:0,&q;videoDisplayType&q;:0,&q;avForwardType&q;:0,&q;useIntelligentRoom&q;:false,&q;hasStrokeKeynote&q;:false,&q;verticalModeType&q;:0,&q;originEpisodeId&q;:0,&q;supportRtmp&q;:false,&q;supportPk&q;:false,&q;supportLuckyBag&q;:false,&q;supportUserNoteStroke&q;:false,&q;communicateType&q;:0,&q;fakeLive&q;:false,&q;one2One&q;:false},&q;validStatus&q;:1,&q;supportLive&q;:true,&q;supportAiCatalog&q;:false,&q;hasIntelligentPen&q;:false,&q;useLocalRecording&q;:false,&q;useIntelligentRoom&q;:false,&q;hasSalePosition&q;:false,&q;hasEpisodeCards&q;:false,&q;lockedForShouna&q;:false,&q;needSignIn&q;:false,&q;needTeacherSignIn&q;:false,&q;enablePadPencil&q;:false,&q;displayExercise&q;:false,&q;supportLuckyBag&q;:false,&q;supportLivePk&q;:false},{&q;id&q;:11705802,&q;kePrefix&q;:&q;gwy&q;,&q;courseId&q;:1,&q;status&q;:0,&q;playStatus&q;:0,&q;type&q;:1,&q;recordingType&q;:0,&q;mediaType&q;:0,&q;title&q;:&q;晚课-热点夜话25&q;,&q;innerTitle&q;:&q;&q;,&q;startTime&q;:1775224800000,&q;endTime&q;:1775227500000,&q;teacher&q;:{&q;id&q;:5201,&q;userId&q;:41358262,&q;name&q;:&q;刘秋实&q;,&q;brief&q;:&q;粉笔面试研究院成员、高级面试讲师&q;,&q;desc&q;:&q;8年公考面试授课经验，粉笔大区面试教学教研负责人，主要担任粉笔面试师资的培训师，参与组织各类授课研讨会议和培训工作，培训师资千余人，承担国省考理论大课及各类线上公开课，参与负责面试教研、题本研发等工作，曾获得粉笔“卓越教师”称号，高分实战经验丰富。\n刘秋实老师秉承着“我的梦想就是帮学生实现梦想”的教学目标，和“虚心涵泳、居敬持志”的教育理念，深谙面试答题逻辑，善于寻找命题的趋势和规律，发掘学生自身优势，授课风格轻松幽默、温柔细致、逻辑缜密、严谨专业，致力于去模板化答题和“自信、自主、自然”的精彩表达，帮助学生在面试学习中遇到不一样的自己。&q;,&q;avatar&q;:&q;1720cd2d2210cf1.jpg&q;,&q;upperBodyPhoto&q;:null,&q;displayCoursePrefix&q;:&q;gwy&q;,&q;teacherStat&q;:{&q;teacherId&q;:5201,&q;episodeCount&q;:1163,&q;scoreCount&q;:11921,&q;avgScore&q;:9.812431842966207,&q;fiveGradeAvgScore&q;:4.91,&q;updateTime&q;:1773605088494},&q;auditionEpisode&q;:{&q;episodeTitle&q;:&q;个人展示课&q;,&q;episodeVideoUrl&q;:&q;https://vod.fbstatic.cn/22e9ceb2vodbj1251001446/d434698e243791580126493171/f0.mp4?t=f2a4b300&a;us=4070880000&a;sign=91827eb53851e204f0052b8f6d5ec28d&q;},&q;memberOfCPC&q;:false,&q;tags&q;:null},&q;teachChannel&q;:1,&q;offline&q;:null,&q;duration&q;:2700,&q;hasAudition&q;:false,&q;bizType&q;:0,&q;bizId&q;:&q;773251&q;,&q;supportReplay&q;:true,&q;extraInfo&q;:null,&q;liveConfig&q;:{&q;episodeId&q;:11705802,&q;supportMultiGroup&q;:false,&q;exerciseBizType&q;:0,&q;videoDisplayType&q;:0,&q;avForwardType&q;:0,&q;useIntelligentRoom&q;:false,&q;hasStrokeKeynote&q;:false,&q;verticalModeType&q;:0,&q;originEpisodeId&q;:0,&q;supportRtmp&q;:false,&q;supportPk&q;:false,&q;supportLuckyBag&q;:false,&q;supportUserNoteStroke&q;:false,&q;communicateType&q;:0,&q;fakeLive&q;:false,&q;one2One&q;:false},&q;validStatus&q;:1,&q;supportLive&q;:true,&q;supportAiCatalog&q;:false,&q;hasIntelligentPen&q;:false,&q;useLocalRecording&q;:false,&q;useIntelligentRoom&q;:false,&q;hasSalePosition&q;:false,&q;hasEpisodeCards&q;:false,&q;lockedForShouna&q;:false,&q;needSignIn&q;:false,&q;needTeacherSignIn&q;:false,&q;enablePadPencil&q;:false,&q;displayExercise&q;:false,&q;supportLuckyBag&q;:false,&q;supportLivePk&q;:false},{&q;id&q;:11706777,&q;kePrefix&q;:&q;gwy&q;,&q;courseId&q;:1,&q;status&q;:0,&q;playStatus&q;:0,&q;type&q;:1,&q;recordingType&q;:0,&q;mediaType&q;:0,&q;title&q;:&q;早课-政治理论常见词汇（五）&q;,&q;innerTitle&q;:&q;&q;,&q;startTime&q;:1775430000000,&q;endTime&q;:1775431800000,&q;teacher&q;:{&q;id&q;:83780,&q;userId&q;:161829498,&q;name&q;:&q;姜倩倩&q;,&q;brief&q;:&q;粉笔公基优质教师&q;,&q;desc&q;:&q;       粉笔公基优质教师。\n      8年公考授课经验，985高校毕业。从业以来授课人数超5000人，授课时长超1w小时。\n是课堂的“双面手”：一面是严谨的“知识匠人”，用逻辑的刻刀雕琢思维；一面是温暖的“心灵画师”，用共情的色彩疏解学生的情绪。长期深耕在教学、教研一线，有扎实的理论功底，有成熟的实践经验。深入研究国省考、事业单位、三支一扶等各类笔试考情及命题特色，有对针对性的讲解知识点。授课思路清晰，讲解细致全面。课堂上认真负责，内容深入浅出。深受学员的好评。&q;,&q;avatar&q;:&q;19b25114d11aa4b.jpg&q;,&q;upperBodyPhoto&q;:null,&q;displayCoursePrefix&q;:&q;gwy&q;,&q;teacherStat&q;:{&q;teacherId&q;:83780,&q;episodeCount&q;:93,&q;scoreCount&q;:205,&q;avgScore&q;:9.902439024390244,&q;fiveGradeAvgScore&q;:4.95,&q;updateTime&q;:1773582800581},&q;auditionEpisode&q;:null,&q;memberOfCPC&q;:false,&q;tags&q;:null},&q;teachChannel&q;:1,&q;offline&q;:null,&q;duration&q;:1800,&q;hasAudition&q;:false,&q;bizType&q;:0,&q;bizId&q;:&q;773251&q;,&q;supportReplay&q;:true,&q;extraInfo&q;:null,&q;liveConfig&q;:{&q;episodeId&q;:11706777,&q;supportMultiGroup&q;:false,&q;exerciseBizType&q;:0,&q;videoDisplayType&q;:0,&q;avForwardType&q;:0,&q;useIntelligentRoom&q;:false,&q;hasStrokeKeynote&q;:false,&q;verticalModeType&q;:0,&q;originEpisodeId&q;:0,&q;supportRtmp&q;:false,&q;supportPk&q;:false,&q;supportLuckyBag&q;:false,&q;supportUserNoteStroke&q;:false,&q;communicateType&q;:0,&q;fakeLive&q;:false,&q;one2One&q;:false},&q;validStatus&q;:1,&q;supportLive&q;:true,&q;supportAiCatalog&q;:false,&q;hasIntelligentPen&q;:false,&q;useLocalRecording&q;:false,&q;useIntelligentRoom&q;:false,&q;hasSalePosition&q;:false,&q;hasEpisodeCards&q;:false,&q;lockedForShouna&q;:false,&q;needSignIn&q;:false,&q;needTeacherSignIn&q;:false,&q;enablePadPencil&q;:false,&q;displayExercise&q;:false,&q;supportLuckyBag&q;:false,&q;supportLivePk&q;:false},{&q;id&q;:11706778,&q;kePrefix&q;:&q;gwy&q;,&q;courseId&q;:1,&q;status&q;:0,&q;playStatus&q;:0,&q;type&q;:1,&q;recordingType&q;:0,&q;mediaType&q;:0,&q;title&q;:&q;晚课-热点夜话26&q;,&q;innerTitle&q;:&q;&q;,&q;startTime&q;:1775484000000,&q;endTime&q;:1775486700000,&q;teacher&q;:{&q;id&q;:3184,&q;userId&q;:16570049,&q;name&q;:&q;赵公梓&q;,&q;brief&q;:&q;粉笔面试优质教师&q;,&q;desc&q;:&q;       粉笔面试优质教师。\n       2017年从事公考教学工作，授课耐心细致、严谨认真，在给予指导的同时，帮助学生调整心态积极备考。教学注重系统思维，带领学生以清晰的逻辑思路直面问题；授课内容丰富，为学生提供海量答题内容参考；倡导个性化教学，帮助学生短期内形成特色答题风格。\n       粉笔面试教研教学团队成员。受邀参与命制面试模拟预测题目，国省考面试真题解析撰写，并收录至粉笔面试题库；受邀录制面试真题示范答题，并在粉笔题库进行展示；受邀参与《粉笔晨读》等图书编辑撰写工作；多次参与粉笔组织的各类授课研讨会议和面试教研活动，共同助力粉笔面试理论的研发与升级。&q;,&q;avatar&q;:&q;171861d7c8d1831.jpg&q;,&q;upperBodyPhoto&q;:null,&q;displayCoursePrefix&q;:&q;gwy&q;,&q;teacherStat&q;:{&q;teacherId&q;:3184,&q;episodeCount&q;:1543,&q;scoreCount&q;:10976,&q;avgScore&q;:9.847485422740515,&q;fiveGradeAvgScore&q;:4.92,&q;updateTime&q;:1773622909183},&q;auditionEpisode&q;:{&q;episodeTitle&q;:&q;个人展示课&q;,&q;episodeVideoUrl&q;:&q;https://vod.fbstatic.cn/22e9ceb2vodbj1251001446/702e6d723270835014228008314/AU0Hkzm5lf8A.mp4?t=f2a4b300&a;us=4070880000&a;sign=2085272ea9e042a7ec8e7019cfef691e&q;},&q;memberOfCPC&q;:false,&q;tags&q;:null},&q;teachChannel&q;:1,&q;offline&q;:null,&q;duration&q;:2700,&q;hasAudition&q;:false,&q;bizType&q;:0,&q;bizId&q;:&q;773251&q;,&q;supportReplay&q;:true,&q;extraInfo&q;:null,&q;liveConfig&q;:{&q;episodeId&q;:11706778,&q;supportMultiGroup&q;:false,&q;exerciseBizType&q;:0,&q;videoDisplayType&q;:0,&q;avForwardType&q;:0,&q;useIntelligentRoom&q;:false,&q;hasStrokeKeynote&q;:false,&q;verticalModeType&q;:0,&q;originEpisodeId&q;:0,&q;supportRtmp&q;:false,&q;supportPk&q;:false,&q;supportLuckyBag&q;:false,&q;supportUserNoteStroke&q;:false,&q;communicateType&q;:0,&q;fakeLive&q;:false,&q;one2One&q;:false},&q;validStatus&q;:1,&q;supportLive&q;:true,&q;supportAiCatalog&q;:false,&q;hasIntelligentPen&q;:false,&q;useLocalRecording&q;:false,&q;useIntelligentRoom&q;:false,&q;hasSalePosition&q;:false,&q;hasEpisodeCards&q;:false,&q;lockedForShouna&q;:false,&q;needSignIn&q;:false,&q;needTeacherSignIn&q;:false,&q;enablePadPencil&q;:false,&q;displayExercise&q;:false,&q;supportLuckyBag&q;:false,&q;supportLivePk&q;:false},{&q;id&q;:11706779,&q;kePrefix&q;:&q;gwy&q;,&q;courseId&q;:1,&q;status&q;:0,&q;playStatus&q;:0,&q;type&q;:1,&q;recordingType&q;:0,&q;mediaType&q;:0,&q;title&q;:&q;早课-物权“爱恨情仇”：易混淆概念辨析&q;,&q;innerTitle&q;:&q;&q;,&q;startTime&q;:1775516400000,&q;endTime&q;:1775518200000,&q;teacher&q;:{&q;id&q;:29329,&q;userId&q;:59984840,&q;name&q;:&q;婉君&q;,&q;brief&q;:&q;粉笔公考常识、公安优质讲师&q;,&q;desc&q;:&q;       粉笔常识、公安优质老师。\n       性格耐心细致，善于把握学员个性化特点，因材施教，认真负责，对待课程一丝不苟。讲课生动形象，机智诙谐，听课体验好，学员可以在轻松愉快的氛围中学习，跟着老师节奏主动思考。老师同时注重“反模板”教学，助力学员走出答题模板与误区。&q;,&q;avatar&q;:&q;17cfe442bf3a975.jpg&q;,&q;upperBodyPhoto&q;:null,&q;displayCoursePrefix&q;:&q;gwy&q;,&q;teacherStat&q;:{&q;teacherId&q;:29329,&q;episodeCount&q;:300,&q;scoreCount&q;:21185,&q;avgScore&q;:9.837715364644751,&q;fiveGradeAvgScore&q;:4.92,&q;updateTime&q;:1773579682515},&q;auditionEpisode&q;:null,&q;memberOfCPC&q;:false,&q;tags&q;:null},&q;teachChannel&q;:1,&q;offline&q;:null,&q;duration&q;:1800,&q;hasAudition&q;:false,&q;bizType&q;:0,&q;bizId&q;:&q;773251&q;,&q;supportReplay&q;:true,&q;extraInfo&q;:null,&q;liveConfig&q;:{&q;episodeId&q;:11706779,&q;supportMultiGroup&q;:false,&q;exerciseBizType&q;:0,&q;videoDisplayType&q;:0,&q;avForwardType&q;:0,&q;useIntelligentRoom&q;:false,&q;hasStrokeKeynote&q;:false,&q;verticalModeType&q;:0,&q;originEpisodeId&q;:0,&q;supportRtmp&q;:false,&q;supportPk&q;:false,&q;supportLuckyBag&q;:false,&q;supportUserNoteStroke&q;:false,&q;communicateType&q;:0,&q;fakeLive&q;:false,&q;one2One&q;:false},&q;validStatus&q;:1,&q;supportLive&q;:true,&q;supportAiCatalog&q;:false,&q;hasIntelligentPen&q;:false,&q;useLocalRecording&q;:false,&q;useIntelligentRoom&q;:false,&q;hasSalePosition&q;:false,&q;hasEpisodeCards&q;:false,&q;lockedForShouna&q;:false,&q;needSignIn&q;:false,&q;needTeacherSignIn&q;:false,&q;enablePadPencil&q;:false,&q;displayExercise&q;:false,&q;supportLuckyBag&q;:false,&q;supportLivePk&q;:false},{&q;id&q;:11706780,&q;kePrefix&q;:&q;gwy&q;,&q;courseId&q;:1,&q;status&q;:0,&q;playStatus&q;:0,&q;type&q;:1,&q;recordingType&q;:0,&q;mediaType&q;:0,&q;title&q;:&q;晚课-热点夜话27&q;,&q;innerTitle&q;:&q;&q;,&q;startTime&q;:1775570400000,&q;endTime&q;:1775573100000,&q;teacher&q;:{&q;id&q;:865,&q;userId&q;:37392799,&q;name&q;:&q;程菲&q;,&q;brief&q;:&q;粉笔公考面试优质讲师&q;,&q;desc&q;:&q;       粉笔面试优质老师。\n       始终以生动有趣、激发学生思维为教学宗旨，课堂氛围轻松融洽，广受学员好评。授课重点突出，能够及时总结拓展，讲解语言通俗易懂。擅长引导学生自主思考，善于根据学生的不同情况和需求，制定合适的教学计划，进行个性化指导，助力学员上岸。&q;,&q;avatar&q;:&q;1717beafeb6ab50.jpg&q;,&q;upperBodyPhoto&q;:null,&q;displayCoursePrefix&q;:&q;gwy&q;,&q;teacherStat&q;:{&q;teacherId&q;:865,&q;episodeCount&q;:815,&q;scoreCount&q;:49181,&q;avgScore&q;:9.831072975336003,&q;fiveGradeAvgScore&q;:4.92,&q;updateTime&q;:1773620424465},&q;auditionEpisode&q;:{&q;episodeTitle&q;:&q;个人展示课&q;,&q;episodeVideoUrl&q;:&q;https://vod.fbstatic.cn/22e9ceb2vodbj1251001446/3dc414923270835014652217041/ZWqirDjpBC8A.mp4?t=f2a4b300&a;us=4070880000&a;sign=514bdd00f5985bafec1a8312d5705e84&q;},&q;memberOfCPC&q;:false,&q;tags&q;:null},&q;teachChannel&q;:1,&q;offline&q;:null,&q;duration&q;:2700,&q;hasAudition&q;:false,&q;bizType&q;:0,&q;bizId&q;:&q;773251&q;,&q;supportReplay&q;:true,&q;extraInfo&q;:null,&q;liveConfig&q;:{&q;episodeId&q;:11706780,&q;supportMultiGroup&q;:false,&q;exerciseBizType&q;:0,&q;videoDisplayType&q;:0,&q;avForwardType&q;:0,&q;useIntelligentRoom&q;:false,&q;hasStrokeKeynote&q;:false,&q;verticalModeType&q;:0,&q;originEpisodeId&q;:0,&q;supportRtmp&q;:false,&q;supportPk&q;:false,&q;supportLuckyBag&q;:false,&q;supportUserNoteStroke&q;:false,&q;communicateType&q;:0,&q;fakeLive&q;:false,&q;one2One&q;:false},&q;validStatus&q;:1,&q;supportLive&q;:true,&q;supportAiCatalog&q;:false,&q;hasIntelligentPen&q;:false,&q;useLocalRecording&q;:false,&q;useIntelligentRoom&q;:false,&q;hasSalePosition&q;:false,&q;hasEpisodeCards&q;:false,&q;lockedForShouna&q;:false,&q;needSignIn&q;:false,&q;needTeacherSignIn&q;:false,&q;enablePadPencil&q;:false,&q;displayExercise&q;:false,&q;supportLuckyBag&q;:false,&q;supportLivePk&q;:false},{&q;id&q;:11706781,&q;kePrefix&q;:&q;gwy&q;,&q;courseId&q;:1,&q;status&q;:0,&q;playStatus&q;:0,&q;type&q;:1,&q;recordingType&q;:0,&q;mediaType&q;:0,&q;title&q;:&q;早课-成语登科计划（五）&q;,&q;innerTitle&q;:&q;&q;,&q;startTime&q;:1775602800000,&q;endTime&q;:1775605500000,&q;teacher&q;:{&q;id&q;:1779,&q;userId&q;:44420612,&q;name&q;:&q;明蕾&q;,&q;brief&q;:&q;粉笔言语优质教师&q;,&q;desc&q;:&q;粉笔言语优质教师，文科类硕士\n11年公考授课经验，打分人次超60万，学员评分高达4.9分。\n言语理论基本功扎实，教学经验丰富，授课思路清晰、重点突出，善于引导和总结，注重培养学员举一反三的能力，深受学员好评。&q;,&q;avatar&q;:&q;1718adf9442d3aa.jpg&q;,&q;upperBodyPhoto&q;:null,&q;displayCoursePrefix&q;:&q;gwy&q;,&q;teacherStat&q;:{&q;teacherId&q;:1779,&q;episodeCount&q;:1221,&q;scoreCount&q;:711933,&q;avgScore&q;:9.856694379948717,&q;fiveGradeAvgScore&q;:4.93,&q;updateTime&q;:1773617671467},&q;auditionEpisode&q;:{&q;episodeTitle&q;:&q;个人展示课&q;,&q;episodeVideoUrl&q;:&q;https://vod.fbstatic.cn/22e9ceb2vodbj1251001446/9cec1afc3560136621447424292/iEATIpvLLIQA.mp4?t=f2a4b300&a;us=4070880000&a;sign=63c6130e26890e04c6b2856e24c1f1da&q;},&q;memberOfCPC&q;:false,&q;tags&q;:null},&q;teachChannel&q;:1,&q;offline&q;:null,&q;duration&q;:2700,&q;hasAudition&q;:false,&q;bizType&q;:0,&q;bizId&q;:&q;773251&q;,&q;supportReplay&q;:true,&q;extraInfo&q;:null,&q;liveConfig&q;:{&q;episodeId&q;:11706781,&q;supportMultiGroup&q;:false,&q;exerciseBizType&q;:0,&q;videoDisplayType&q;:0,&q;avForwardType&q;:0,&q;useIntelligentRoom&q;:false,&q;hasStrokeKeynote&q;:false,&q;verticalModeType&q;:0,&q;originEpisodeId&q;:0,&q;supportRtmp&q;:false,&q;supportPk&q;:false,&q;supportLuckyBag&q;:false,&q;supportUserNoteStroke&q;:false,&q;communicateType&q;:0,&q;fakeLive&q;:false,&q;one2One&q;:false},&q;validStatus&q;:1,&q;supportLive&q;:true,&q;supportAiCatalog&q;:false,&q;hasIntelligentPen&q;:false,&q;useLocalRecording&q;:false,&q;useIntelligentRoom&q;:false,&q;hasSalePosition&q;:false,&q;hasEpisodeCards&q;:false,&q;lockedForShouna&q;:false,&q;needSignIn&q;:false,&q;needTeacherSignIn&q;:false,&q;enablePadPencil&q;:false,&q;displayExercise&q;:false,&q;supportLuckyBag&q;:false,&q;supportLivePk&q;:false},{&q;id&q;:11706782,&q;kePrefix&q;:&q;gwy&q;,&q;courseId&q;:1,&q;status&q;:0,&q;playStatus&q;:0,&q;type&q;:1,&q;recordingType&q;:0,&q;mediaType&q;:0,&q;title&q;:&q;晚课-热点夜话28&q;,&q;innerTitle&q;:&q;&q;,&q;startTime&q;:1775656800000,&q;endTime&q;:1775659500000,&q;teacher&q;:{&q;id&q;:6391,&q;userId&q;:62196424,&q;name&q;:&q;王诗佳&q;,&q;brief&q;:&q;粉笔面试研究院成员、高级面试讲师&q;,&q;desc&q;:&q;       8年公考面试授课经验，粉笔吉林面试教学教研负责人，主要承担国省考理论大课及各类线上公开课。参与过多省市、多部门面试教材的教研与题本研发设计工作。多次参与粉笔面试师资的培训、考核工作。 \n       王诗佳老师拥有多年一线授课与面试教研经验，授课细致、严谨，注重因材施教，善于通过细致地点评和清晰地讲解帮助学生找到个性化问题，实现突破性提升。注重个人提升，始终秉承“终身学习”的理念，对面试教学有独到见解。&q;,&q;avatar&q;:&q;171537158838eb0.png&q;,&q;upperBodyPhoto&q;:null,&q;displayCoursePrefix&q;:&q;gwy&q;,&q;teacherStat&q;:{&q;teacherId&q;:6391,&q;episodeCount&q;:917,&q;scoreCount&q;:26262,&q;avgScore&q;:9.847536364328683,&q;fiveGradeAvgScore&q;:4.92,&q;updateTime&q;:1773622969306},&q;auditionEpisode&q;:{&q;episodeTitle&q;:&q;个人展示课&q;,&q;episodeVideoUrl&q;:&q;https://vod.fbstatic.cn/22e9ceb2vodbj1251001446/dcf7d575243791580578434460/f0.mp4?t=f2a4b300&a;us=4070880000&a;sign=5d3639621b61af1c1b43508312c707e7&q;},&q;memberOfCPC&q;:false,&q;tags&q;:null},&q;teachChannel&q;:1,&q;offline&q;:null,&q;duration&q;:2700,&q;hasAudition&q;:false,&q;bizType&q;:0,&q;bizId&q;:&q;773251&q;,&q;supportReplay&q;:true,&q;extraInfo&q;:null,&q;liveConfig&q;:{&q;episodeId&q;:11706782,&q;supportMultiGroup&q;:false,&q;exerciseBizType&q;:0,&q;videoDisplayType&q;:0,&q;avForwardType&q;:0,&q;useIntelligentRoom&q;:false,&q;hasStrokeKeynote&q;:false,&q;verticalModeType&q;:0,&q;originEpisodeId&q;:0,&q;supportRtmp&q;:false,&q;supportPk&q;:false,&q;supportLuckyBag&q;:false,&q;supportUserNoteStroke&q;:false,&q;communicateType&q;:0,&q;fakeLive&q;:false,&q;one2One&q;:false},&q;validStatus&q;:1,&q;supportLive&q;:true,&q;supportAiCatalog&q;:false,&q;hasIntelligentPen&q;:false,&q;useLocalRecording&q;:false,&q;useIntelligentRoom&q;:false,&q;hasSalePosition&q;:false,&q;hasEpisodeCards&q;:false,&q;lockedForShouna&q;:false,&q;needSignIn&q;:false,&q;needTeacherSignIn&q;:false,&q;enablePadPencil&q;:false,&q;displayExercise&q;:false,&q;supportLuckyBag&q;:false,&q;supportLivePk&q;:false},{&q;id&q;:11706783,&q;kePrefix&q;:&q;gwy&q;,&q;courseId&q;:1,&q;status&q;:0,&q;playStatus&q;:0,&q;type&q;:1,&q;recordingType&q;:0,&q;mediaType&q;:0,&q;title&q;:&q;早课-速记特征图之“对称图”&q;,&q;innerTitle&q;:&q;&q;,&q;startTime&q;:1775689200000,&q;endTime&q;:1775691900000,&q;teacher&q;:{&q;id&q;:21356,&q;userId&q;:74166806,&q;name&q;:&q;李陈&q;,&q;brief&q;:&q;粉笔判断优质教师&q;,&q;desc&q;:&q;粉笔判断优质教师，纽约大学理学硕士。 \n国考部委高分考生，5年公考授课经验，累积授课时长超2000小时。 \n作为判断教研组成员，每年参与系统班、精品班课程设计，图书更新，AI测试等工作，理论功底扎实，授课逻辑清晰，善于归纳总结，深受学生喜爱。&q;,&q;avatar&q;:&q;179f4e980a2a9c2.jpg&q;,&q;upperBodyPhoto&q;:null,&q;displayCoursePrefix&q;:&q;gwy&q;,&q;teacherStat&q;:{&q;teacherId&q;:21356,&q;episodeCount&q;:630,&q;scoreCount&q;:58216,&q;avgScore&q;:9.906589253813385,&q;fiveGradeAvgScore&q;:4.95,&q;updateTime&q;:1773591681002},&q;auditionEpisode&q;:{&q;episodeTitle&q;:&q;个人展示课&q;,&q;episodeVideoUrl&q;:&q;https://vod.fbstatic.cn/22e9ceb2vodbj1251001446/93a914d83560136621447033634/KARgUYgs6AEA.mp4?t=f2a4b300&a;us=4070880000&a;sign=0b98f8bdbbcb817fcb78cbd713914cc1&q;},&q;memberOfCPC&q;:false,&q;tags&q;:null},&q;teachChannel&q;:1,&q;offline&q;:null,&q;duration&q;:2700,&q;hasAudition&q;:false,&q;bizType&q;:0,&q;bizId&q;:&q;773251&q;,&q;supportReplay&q;:true,&q;extraInfo&q;:null,&q;liveConfig&q;:{&q;episodeId&q;:11706783,&q;supportMultiGroup&q;:false,&q;exerciseBizType&q;:0,&q;videoDisplayType&q;:0,&q;avForwardType&q;:0,&q;useIntelligentRoom&q;:false,&q;hasStrokeKeynote&q;:false,&q;verticalModeType&q;:0,&q;originEpisodeId&q;:0,&q;supportRtmp&q;:false,&q;supportPk&q;:false,&q;supportLuckyBag&q;:false,&q;supportUserNoteStroke&q;:false,&q;communicateType&q;:0,&q;fakeLive&q;:false,&q;one2One&q;:false},&q;validStatus&q;:1,&q;supportLive&q;:true,&q;supportAiCatalog&q;:false,&q;hasIntelligentPen&q;:false,&q;useLocalRecording&q;:false,&q;useIntelligentRoom&q;:false,&q;hasSalePosition&q;:false,&q;hasEpisodeCards&q;:false,&q;lockedForShouna&q;:false,&q;needSignIn&q;:false,&q;needTeacherSignIn&q;:false,&q;enablePadPencil&q;:false,&q;displayExercise&q;:false,&q;supportLuckyBag&q;:false,&q;supportLivePk&q;:false},{&q;id&q;:11706784,&q;kePrefix&q;:&q;gwy&q;,&q;courseId&q;:1,&q;status&q;:0,&q;playStatus&q;:0,&q;type&q;:1,&q;recordingType&q;:0,&q;mediaType&q;:0,&q;title&q;:&q;晚课-热点夜话29&q;,&q;innerTitle&q;:&q;&q;,&q;startTime&q;:1775743200000,&q;endTime&q;:1775745900000,&q;teacher&q;:{&q;id&q;:1182,&q;userId&q;:29881941,&q;name&q;:&q;于林&q;,&q;brief&q;:&q;粉笔面试研究院成员、高级面试讲师&q;,&q;desc&q;:&q;粉笔公考面试优质讲师\n7年公考面试授课经验，粉笔大区面试教学教研负责人，主要承担国省考线上理论和各类型公开课授课，参与过多省市、多部门面试教材的教研、题本研发、课程设计和面试师资培训工作，曾于体制内任职，工作经验丰富，可给予学员更多的工作实务教学内容。\n于林老师拥有多年一线授课经历与面试教研经验，始终以“师者，传道授业解惑也”为人生信条，通过传道，向学生们传授道理，使学生正直阳光，积极向上;通过授业，耐心细致地为学员讲授面试的内容，由表及里、深入浅出;通过解惑，一针见血找到学生问题，并指明解决问题的方法，使学员\n茅塞顿开，深受学员喜欢。&q;,&q;avatar&q;:&q;171ee6f96c2ae72.jpg&q;,&q;upperBodyPhoto&q;:null,&q;displayCoursePrefix&q;:&q;gwy&q;,&q;teacherStat&q;:{&q;teacherId&q;:1182,&q;episodeCount&q;:1214,&q;scoreCount&q;:28583,&q;avgScore&q;:9.872161774481334,&q;fiveGradeAvgScore&q;:4.94,&q;updateTime&q;:1773595085305},&q;auditionEpisode&q;:{&q;episodeTitle&q;:&q;个人展示课&q;,&q;episodeVideoUrl&q;:&q;https://vod.fbstatic.cn/22e9ceb2vodbj1251001446/9b6cc38f243791580417850235/f0.mp4?t=f2a4b300&a;us=4070880000&a;sign=5d693678e28fe7d30da2599c79d22785&q;},&q;memberOfCPC&q;:false,&q;tags&q;:null},&q;teachChannel&q;:1,&q;offline&q;:null,&q;duration&q;:2700,&q;hasAudition&q;:false,&q;bizType&q;:0,&q;bizId&q;:&q;773251&q;,&q;supportReplay&q;:true,&q;extraInfo&q;:null,&q;liveConfig&q;:{&q;episodeId&q;:11706784,&q;supportMultiGroup&q;:false,&q;exerciseBizType&q;:0,&q;videoDisplayType&q;:0,&q;avForwardType&q;:0,&q;useIntelligentRoom&q;:false,&q;hasStrokeKeynote&q;:false,&q;verticalModeType&q;:0,&q;originEpisodeId&q;:0,&q;supportRtmp&q;:false,&q;supportPk&q;:false,&q;supportLuckyBag&q;:false,&q;supportUserNoteStroke&q;:false,&q;communicateType&q;:0,&q;fakeLive&q;:false,&q;one2One&q;:false},&q;validStatus&q;:1,&q;supportLive&q;:true,&q;supportAiCatalog&q;:false,&q;hasIntelligentPen&q;:false,&q;useLocalRecording&q;:false,&q;useIntelligentRoom&q;:false,&q;hasSalePosition&q;:false,&q;hasEpisodeCards&q;:false,&q;lockedForShouna&q;:false,&q;needSignIn&q;:false,&q;needTeacherSignIn&q;:false,&q;enablePadPencil&q;:false,&q;displayExercise&q;:false,&q;supportLuckyBag&q;:false,&q;supportLivePk&q;:false},{&q;id&q;:11706785,&q;kePrefix&q;:&q;gwy&q;,&q;courseId&q;:1,&q;status&q;:0,&q;playStatus&q;:0,&q;type&q;:1,&q;recordingType&q;:0,&q;mediaType&q;:0,&q;title&q;:&q;早课-申论提分必学好文（五）&q;,&q;innerTitle&q;:&q;&q;,&q;startTime&q;:1775775600000,&q;endTime&q;:1775778300000,&q;teacher&q;:{&q;id&q;:3824,&q;userId&q;:40174320,&q;name&q;:&q;江澄&q;,&q;brief&q;:&q;粉笔申论优质教师&q;,&q;desc&q;:&q;粉笔申论优质教师，曾受邀担任政府机关公文写作培训主讲。8年公考授课经验，打分人次超16万，学员评分高达4.9分。 \n考点把握精准，授课重点突出，善于总结拓展，教学实用性强，能够及时发现学员的个性化问题，因材施教。&q;,&q;avatar&q;:&q;1954bf50a3a4e0a.jpg&q;,&q;upperBodyPhoto&q;:null,&q;displayCoursePrefix&q;:&q;gwy&q;,&q;teacherStat&q;:{&q;teacherId&q;:3824,&q;episodeCount&q;:1475,&q;scoreCount&q;:235460,&q;avgScore&q;:9.865624734562134,&q;fiveGradeAvgScore&q;:4.93,&q;updateTime&q;:1773620554674},&q;auditionEpisode&q;:{&q;episodeTitle&q;:&q;个人展示课&q;,&q;episodeVideoUrl&q;:&q;https://vod.fbstatic.cn/22e9ceb2vodbj1251001446/98ad3b5b3560136621447282082/3LnOnFkB4YoA.mp4?t=f2a4b300&a;us=4070880000&a;sign=5fa092dd930dd9ec24f161c367231eed&q;},&q;memberOfCPC&q;:false,&q;tags&q;:null},&q;teachChannel&q;:1,&q;offline&q;:null,&q;duration&q;:2700,&q;hasAudition&q;:false,&q;bizType&q;:0,&q;bizId&q;:&q;773251&q;,&q;supportReplay&q;:true,&q;extraInfo&q;:null,&q;liveConfig&q;:{&q;episodeId&q;:11706785,&q;supportMultiGroup&q;:false,&q;exerciseBizType&q;:0,&q;videoDisplayType&q;:0,&q;avForwardType&q;:0,&q;useIntelligentRoom&q;:false,&q;hasStrokeKeynote&q;:false,&q;verticalModeType&q;:0,&q;originEpisodeId&q;:0,&q;supportRtmp&q;:false,&q;supportPk&q;:false,&q;supportLuckyBag&q;:false,&q;supportUserNoteStroke&q;:false,&q;communicateType&q;:0,&q;fakeLive&q;:false,&q;one2One&q;:false},&q;validStatus&q;:1,&q;supportLive&q;:true,&q;supportAiCatalog&q;:false,&q;hasIntelligentPen&q;:false,&q;useLocalRecording&q;:false,&q;useIntelligentRoom&q;:false,&q;hasSalePosition&q;:false,&q;hasEpisodeCards&q;:false,&q;lockedForShouna&q;:false,&q;needSignIn&q;:false,&q;needTeacherSignIn&q;:false,&q;enablePadPencil&q;:false,&q;displayExercise&q;:false,&q;supportLuckyBag&q;:false,&q;supportLivePk&q;:false},{&q;id&q;:11706786,&q;kePrefix&q;:&q;gwy&q;,&q;courseId&q;:1,&q;status&q;:0,&q;playStatus&q;:0,&q;type&q;:1,&q;recordingType&q;:0,&q;mediaType&q;:0,&q;title&q;:&q;晚课-热点夜话30&q;,&q;innerTitle&q;:&q;&q;,&q;startTime&q;:1775829600000,&q;endTime&q;:1775832300000,&q;teacher&q;:{&q;id&q;:1875,&q;userId&q;:41410898,&q;name&q;:&q;马婉卿&q;,&q;brief&q;:&q;粉笔面试研究院成员、高级面试讲师&q;,&q;desc&q;:&q;       9年授课经验，累计授课时长超过10000小时，培训师资千余人。长期致力于公务员考试研究，曾有基层的工作经验，对试题有深刻的把握和独到的见解。授课风趣幽默，注重因材施教，打造个性化答题亮点，相信最好的相遇是能成就彼此的人生。 \n       参与组织各类授课研讨会议，教研讨论和题本研发等活动，曾获粉笔“卓越教师”称号，著有《素材集萃30例》等图书。&q;,&q;avatar&q;:&q;17d466e42ad2b67.jpg&q;,&q;upperBodyPhoto&q;:null,&q;displayCoursePrefix&q;:&q;gwy&q;,&q;teacherStat&q;:{&q;teacherId&q;:1875,&q;episodeCount&q;:1464,&q;scoreCount&q;:27739,&q;avgScore&q;:9.859980532823823,&q;fiveGradeAvgScore&q;:4.93,&q;updateTime&q;:1773585462832},&q;auditionEpisode&q;:{&q;episodeTitle&q;:&q;个人展示课&q;,&q;episodeVideoUrl&q;:&q;https://vod.fbstatic.cn/22e9ceb2vodbj1251001446/d5f9fc9b243791580578137376/f0.mp4?t=f2a4b300&a;us=4070880000&a;sign=2948f145c310a3e6cfb2e4c2252e43ee&q;},&q;memberOfCPC&q;:false,&q;tags&q;:null},&q;teachChannel&q;:1,&q;offline&q;:null,&q;duration&q;:2700,&q;hasAudition&q;:false,&q;bizType&q;:0,&q;bizId&q;:&q;773251&q;,&q;supportReplay&q;:true,&q;extraInfo&q;:null,&q;liveConfig&q;:{&q;episodeId&q;:11706786,&q;supportMultiGroup&q;:false,&q;exerciseBizType&q;:0,&q;videoDisplayType&q;:0,&q;avForwardType&q;:0,&q;useIntelligentRoom&q;:false,&q;hasStrokeKeynote&q;:false,&q;verticalModeType&q;:0,&q;originEpisodeId&q;:0,&q;supportRtmp&q;:false,&q;supportPk&q;:false,&q;supportLuckyBag&q;:false,&q;supportUserNoteStroke&q;:false,&q;communicateType&q;:0,&q;fakeLive&q;:false,&q;one2One&q;:false},&q;validStatus&q;:1,&q;supportLive&q;:true,&q;supportAiCatalog&q;:false,&q;hasIntelligentPen&q;:false,&q;useLocalRecording&q;:false,&q;useIntelligentRoom&q;:false,&q;hasSalePosition&q;:false,&q;hasEpisodeCards&q;:false,&q;lockedForShouna&q;:false,&q;needSignIn&q;:false,&q;needTeacherSignIn&q;:false,&q;enablePadPencil&q;:false,&q;displayExercise&q;:false,&q;supportLuckyBag&q;:false,&q;supportLivePk&q;:false},{&q;id&q;:11706787,&q;kePrefix&q;:&q;gwy&q;,&q;courseId&q;:1,&q;status&q;:0,&q;playStatus&q;:0,&q;type&q;:1,&q;recordingType&q;:0,&q;mediaType&q;:0,&q;title&q;:&q;早课-政治理论常见词汇（六）&q;,&q;innerTitle&q;:&q;&q;,&q;startTime&q;:1776034800000,&q;endTime&q;:1776036600000,&q;teacher&q;:{&q;id&q;:11249,&q;userId&q;:64782764,&q;name&q;:&q;刘烨&q;,&q;brief&q;:&q;粉笔公基、常识优质教师&q;,&q;desc&q;:&q;粉笔公基、常识优质教师。\n9年一线授课教研经验，累计授课时长超1w小时，学员评分高达4.9分。老师始终以生动有趣、激发学生思维为教学宗旨，善于将课堂内容化繁为简、化难为易，将晦涩知识通过日常生活的案例呈现，使学员在较短时间内能够更清晰地掌握所学知识。&q;,&q;avatar&q;:&q;192d26d6a1107c0.jpg&q;,&q;upperBodyPhoto&q;:null,&q;displayCoursePrefix&q;:&q;gwy&q;,&q;teacherStat&q;:{&q;teacherId&q;:11249,&q;episodeCount&q;:861,&q;scoreCount&q;:51878,&q;avgScore&q;:9.866263155865685,&q;fiveGradeAvgScore&q;:4.93,&q;updateTime&q;:1773622237480},&q;auditionEpisode&q;:null,&q;memberOfCPC&q;:false,&q;tags&q;:null},&q;teachChannel&q;:1,&q;offline&q;:null,&q;duration&q;:1800,&q;hasAudition&q;:false,&q;bizType&q;:0,&q;bizId&q;:&q;773251&q;,&q;supportReplay&q;:true,&q;extraInfo&q;:null,&q;liveConfig&q;:{&q;episodeId&q;:11706787,&q;supportMultiGroup&q;:false,&q;exerciseBizType&q;:0,&q;videoDisplayType&q;:0,&q;avForwardType&q;:0,&q;useIntelligentRoom&q;:false,&q;hasStrokeKeynote&q;:false,&q;verticalModeType&q;:0,&q;originEpisodeId&q;:0,&q;supportRtmp&q;:false,&q;supportPk&q;:false,&q;supportLuckyBag&q;:false,&q;supportUserNoteStroke&q;:false,&q;communicateType&q;:0,&q;fakeLive&q;:false,&q;one2One&q;:false},&q;validStatus&q;:1,&q;supportLive&q;:true,&q;supportAiCatalog&q;:false,&q;hasIntelligentPen&q;:false,&q;useLocalRecording&q;:false,&q;useIntelligentRoom&q;:false,&q;hasSalePosition&q;:false,&q;hasEpisodeCards&q;:false,&q;lockedForShouna&q;:false,&q;needSignIn&q;:false,&q;needTeacherSignIn&q;:false,&q;enablePadPencil&q;:false,&q;displayExercise&q;:false,&q;supportLuckyBag&q;:false,&q;supportLivePk&q;:false},{&q;id&q;:11706788,&q;kePrefix&q;:&q;gwy&q;,&q;courseId&q;:1,&q;status&q;:0,&q;playStatus&q;:0,&q;type&q;:1,&q;recordingType&q;:0,&q;mediaType&q;:0,&q;title&q;:&q;晚课-热点夜话31&q;,&q;innerTitle&q;:&q;&q;,&q;startTime&q;:1776088800000,&q;endTime&q;:1776091500000,&q;teacher&q;:{&q;id&q;:3095,&q;userId&q;:48741920,&q;name&q;:&q;姚柯&q;,&q;brief&q;:&q;公考面试、言语理解与表达主讲&q;,&q;desc&q;:&q;粉笔公考面试、言语理解与表达优质讲师。多年机关工作经验、军队服役经历、面试状元、硕士学历。授课逻辑严谨且却又不失轻松幽默。擅长结合每位同学不同的情况，从应试角度帮助学员掌握解题方法和答题技巧，个性化的设定学习内容，帮助学员打造最适合自身的答题思路。用最短的时间，让你遇见不一样的自己。&q;,&q;avatar&q;:&q;1715cd40ca069a3.png&q;,&q;upperBodyPhoto&q;:null,&q;displayCoursePrefix&q;:&q;gwy&q;,&q;teacherStat&q;:{&q;teacherId&q;:3095,&q;episodeCount&q;:178,&q;scoreCount&q;:4505,&q;avgScore&q;:9.878357380688126,&q;fiveGradeAvgScore&q;:4.94,&q;updateTime&q;:1773458339540},&q;auditionEpisode&q;:null,&q;memberOfCPC&q;:false,&q;tags&q;:null},&q;teachChannel&q;:1,&q;offline&q;:null,&q;duration&q;:2700,&q;hasAudition&q;:false,&q;bizType&q;:0,&q;bizId&q;:&q;773251&q;,&q;supportReplay&q;:true,&q;extraInfo&q;:null,&q;liveConfig&q;:{&q;episodeId&q;:11706788,&q;supportMultiGroup&q;:false,&q;exerciseBizType&q;:0,&q;videoDisplayType&q;:0,&q;avForwardType&q;:0,&q;useIntelligentRoom&q;:false,&q;hasStrokeKeynote&q;:false,&q;verticalModeType&q;:0,&q;originEpisodeId&q;:0,&q;supportRtmp&q;:false,&q;supportPk&q;:false,&q;supportLuckyBag&q;:false,&q;supportUserNoteStroke&q;:false,&q;communicateType&q;:0,&q;fakeLive&q;:false,&q;one2One&q;:false},&q;validStatus&q;:1,&q;supportLive&q;:true,&q;supportAiCatalog&q;:false,&q;hasIntelligentPen&q;:false,&q;useLocalRecording&q;:false,&q;useIntelligentRoom&q;:false,&q;hasSalePosition&q;:false,&q;hasEpisodeCards&q;:false,&q;lockedForShouna&q;:false,&q;needSignIn&q;:false,&q;needTeacherSignIn&q;:false,&q;enablePadPencil&q;:false,&q;displayExercise&q;:false,&q;supportLuckyBag&q;:false,&q;supportLivePk&q;:false},{&q;id&q;:11706789,&q;kePrefix&q;:&q;gwy&q;,&q;courseId&q;:1,&q;status&q;:0,&q;playStatus&q;:0,&q;type&q;:1,&q;recordingType&q;:0,&q;mediaType&q;:0,&q;title&q;:&q;早课-民事行为“校准仪”：如何衡量民事约定的有效边界&q;,&q;innerTitle&q;:&q;&q;,&q;startTime&q;:1776121200000,&q;endTime&q;:1776123000000,&q;teacher&q;:{&q;id&q;:29329,&q;userId&q;:59984840,&q;name&q;:&q;婉君&q;,&q;brief&q;:&q;粉笔公考常识、公安优质讲师&q;,&q;desc&q;:&q;       粉笔常识、公安优质老师。\n       性格耐心细致，善于把握学员个性化特点，因材施教，认真负责，对待课程一丝不苟。讲课生动形象，机智诙谐，听课体验好，学员可以在轻松愉快的氛围中学习，跟着老师节奏主动思考。老师同时注重“反模板”教学，助力学员走出答题模板与误区。&q;,&q;avatar&q;:&q;17cfe442bf3a975.jpg&q;,&q;upperBodyPhoto&q;:null,&q;displayCoursePrefix&q;:&q;gwy&q;,&q;teacherStat&q;:{&q;teacherId&q;:29329,&q;episodeCount&q;:300,&q;scoreCount&q;:21185,&q;avgScore&q;:9.837715364644751,&q;fiveGradeAvgScore&q;:4.92,&q;updateTime&q;:1773579682515}