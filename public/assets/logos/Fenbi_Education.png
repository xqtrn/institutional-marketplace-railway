00000,&q;endTime&q;:1743048000000,&q;teacher&q;:{&q;id&q;:64161,&q;userId&q;:107611277,&q;name&q;:&q;彭珏&q;,&q;brief&q;:&q;粉笔优质讲师&q;,&q;desc&q;:&q;粉笔优质讲师\n多年一线教学经验，深耕事业单位考试，承担过线下笔试精品班、刷题班、冲刺班等多种班型，授课经验丰富。\n多次参与粉笔数资科目教研，熟悉命题特点及做题技巧。累计授课超3000小时，累计评分达4.9分。\n善于对于不同类型的题目进行归类与总结，并从中找出共同点。授课形式生动形象，对学生亲和有礼，能够有针对性的引导学生进行主动思考，课堂氛围轻松无压力。&q;,&q;avatar&q;:&q;19405df58deb903.jpg&q;,&q;upperBodyPhoto&q;:null,&q;displayCoursePrefix&q;:&q;sydw&q;,&q;teacherStat&q;:{&q;teacherId&q;:64161,&q;episodeCount&q;:575,&q;scoreCount&q;:853,&q;avgScore&q;:9.61547479484174,&q;fiveGradeAvgScore&q;:4.81,&q;updateTime&q;:1772813556150},&q;auditionEpisode&q;:{&q;episodeTitle&q;:&q;个人展示课&q;,&q;episodeVideoUrl&q;:&q;https://vod.fbstatic.cn/22e9ceb2vodbj1251001446/cd7329fa1397757890484177284/6aPPHzaMBg8A.mp4?t=f2a4b300&a;us=4070880000&a;sign=11ee5ab2f8f129a9f10f76ab8f103533&q;},&q;memberOfCPC&q;:false,&q;tags&q;:null},&q;teachChannel&q;:1,&q;offline&q;:null,&q;duration&q;:11956,&q;hasAudition&q;:false,&q;bizType&q;:0,&q;bizId&q;:&q;726825&q;,&q;supportReplay&q;:true,&q;extraInfo&q;:null,&q;liveConfig&q;:{&q;episodeId&q;:10139742,&q;supportMultiGroup&q;:false,&q;exerciseBizType&q;:0,&q;videoDisplayType&q;:0,&q;avForwardType&q;:0,&q;useIntelligentRoom&q;:false,&q;hasStrokeKeynote&q;:true,&q;verticalModeType&q;:0,&q;originEpisodeId&q;:0,&q;supportRtmp&q;:false,&q;supportPk&q;:true,&q;supportLuckyBag&q;:true,&q;supportUserNoteStroke&q;:false,&q;communicateType&q;:0,&q;one2One&q;:false,&q;fakeLive&q;:false},&q;validStatus&q;:1,&q;supportLive&q;:true,&q;supportAiCatalog&q;:false,&q;hasIntelligentPen&q;:false,&q;useLocalRecording&q;:false,&q;useIntelligentRoom&q;:false,&q;hasSalePosition&q;:false,&q;hasEpisodeCards&q;:true,&q;lockedForShouna&q;:false,&q;needSignIn&q;:false,&q;needTeacherSignIn&q;:false,&q;enablePadPencil&q;:true,&q;displayExercise&q;:false,&q;supportLuckyBag&q;:true,&q;supportLivePk&q;:true},{&q;id&q;:10139836,&q;kePrefix&q;:&q;sydw&q;,&q;courseId&q;:6,&q;status&q;:3,&q;playStatus&q;:3,&q;type&q;:33,&q;recordingType&q;:0,&q;mediaType&q;:0,&q;title&q;:&q;【综应】精选好题 沉浸刷题&q;,&q;innerTitle&q;:&q;&q;,&q;startTime&q;:1743127200000,&q;endTime&q;:1743134400000,&q;teacher&q;:{&q;id&q;:16833,&q;userId&q;:57723890,&q;name&q;:&q;李珍芳&q;,&q;brief&q;:&q;粉笔优质讲师&q;,&q;desc&q;:&q;粉笔优质教师\n7年以上公考教学经验，授课经验丰富，线上累计授课时长1000+，授课人次3000+，授课累计评分4.9。多次参与全国事业单位综应考情以及热点梳理，熟悉事业单位联考综应ABC考情、命题特点和答题技巧。擅长联考、山东、江苏、浙江等地事业单位以及三支一扶的综应课程，并参与综应各大题型人工批改服务上千份，了解学员作答综应的难点、痛点，能精准定位学员薄弱点，对综应有独到的见解。授课思路清晰，逻辑严谨，操作性强，擅长因材施教，在学员中具有非常好的口碑，是值得信赖的好老师。&q;,&q;avatar&q;:&q;19841215f64df6f.jpg&q;,&q;upperBodyPhoto&q;:null,&q;displayCoursePrefix&q;:&q;sydw&q;,&q;teacherStat&q;:{&q;teacherId&q;:16833,&q;episodeCount&q;:409,&q;scoreCount&q;:405,&q;avgScore&q;:9.841975308641969,&q;fiveGradeAvgScore&q;:4.92,&q;updateTime&q;:1773052091382},&q;auditionEpisode&q;:{&q;episodeTitle&q;:&q;个人展示课&q;,&q;episodeVideoUrl&q;:&q;https://vod.fbstatic.cn/22e9ceb2vodbj1251001446/7a0a71cb5145403709466476960/iuy2CLkvs8gA.mp4?t=f2a4b300&a;us=4070880000&a;sign=9b6fa00b91c85f610da0b5f435be8997&q;},&q;memberOfCPC&q;:false,&q;tags&q;:null},&q;teachChannel&q;:1,&q;offline&q;:null,&q;duration&q;:7155,&q;hasAudition&q;:false,&q;bizType&q;:0,&q;bizId&q;:&q;726825&q;,&q;supportReplay&q;:true,&q;extraInfo&q;:null,&q;liveConfig&q;:{&q;episodeId&q;:10139836,&q;supportMultiGroup&q;:false,&q;exerciseBizType&q;:0,&q;videoDisplayType&q;:0,&q;avForwardType&q;:0,&q;useIntelligentRoom&q;:false,&q;hasStrokeKeynote&q;:true,&q;verticalModeType&q;:0,&q;originEpisodeId&q;:0,&q;supportRtmp&q;:false,&q;supportPk&q;:true,&q;supportLuckyBag&q;:true,&q;supportUserNoteStroke&q;:false,&q;communicateType&q;:0,&q;one2One&q;:false,&q;fakeLive&q;:false},&q;validStatus&q;:1,&q;supportLive&q;:true,&q;supportAiCatalog&q;:false,&q;hasIntelligentPen&q;:false,&q;useLocalRecording&q;:false,&q;useIntelligentRoom&q;:false,&q;hasSalePosition&q;:false,&q;hasEpisodeCards&q;:true,&q;lockedForShouna&q;:false,&q;needSignIn&q;:false,&q;needTeacherSignIn&q;:false,&q;enablePadPencil&q;:true,&q;displayExercise&q;:false,&q;supportLuckyBag&q;:true,&q;supportLivePk&q;:true},{&q;id&q;:10139839,&q;kePrefix&q;:&q;sydw&q;,&q;courseId&q;:6,&q;status&q;:3,&q;playStatus&q;:3,&q;type&q;:33,&q;recordingType&q;:0,&q;mediaType&q;:0,&q;title&q;:&q;【公基非法】精选好题 沉浸刷题&q;,&q;innerTitle&q;:&q;&q;,&q;startTime&q;:1743213600000,&q;endTime&q;:1743220800000,&q;teacher&q;:{&q;id&q;:34141,&q;userId&q;:67002168,&q;name&q;:&q;温东升&q;,&q;brief&q;:&q;粉笔优质讲师&q;,&q;desc&q;:&q;粉笔优质教师\n6年以上一线授课经验。带班学生10000+；熟悉国考、省考、事业单位考情，参与四川、山东、甘肃等省考情分析；长期扎根于公考、省考、事业单位教学教研工作，参与粉笔题库真题、模拟题解析编撰工作，时政文件解析工作，参与全国常识公基非法密卷课件及教案制作，农业农村书籍编撰工作。长期担任常识公基、判断课程主讲。课堂氛围轻松幽默，寓教于乐，能够结合当下时政，灵活运用到实际讲解之中，逻辑思维性强，善于沟通，能够迅速帮助考生进行全方位提升。&q;,&q;avatar&q;:&q;19841271adb989c.jpg&q;,&q;upperBodyPhoto&q;:null,&q;displayCoursePrefix&q;:&q;sydw&q;,&q;teacherStat&q;:{&q;teacherId&q;:34141,&q;episodeCount&q;:708,&q;scoreCount&q;:1467,&q;avgScore&q;:9.745057941376977,&q;fiveGradeAvgScore&q;:4.87,&q;updateTime&q;:1773480813169},&q;auditionEpisode&q;:{&q;episodeTitle&q;:&q;个人展示课&q;,&q;episodeVideoUrl&q;:&q;https://vod.fbstatic.cn/22e9ceb2vodbj1251001446/7b5794655145403710132043113/2OaZlykd0yAA.mp4?t=f2a4b300&a;us=4070880000&a;sign=63dc74bcedbc74171e790ef405ff495e&q;},&q;memberOfCPC&q;:false,&q;tags&q;:null},&q;teachChannel&q;:1,&q;offline&q;:null,&q;duration&q;:7585,&q;hasAudition&q;:false,&q;bizType&q;:0,&q;bizId&q;:&q;726825&q;,&q;supportReplay&q;:true,&q;extraInfo&q;:null,&q;liveConfig&q;:{&q;episodeId&q;:10139839,&q;supportMultiGroup&q;:false,&q;exerciseBizType&q;:0,&q;videoDisplayType&q;:0,&q;avForwardType&q;:0,&q;useIntelligentRoom&q;:false,&q;hasStrokeKeynote&q;:true,&q;verticalModeType&q;:0,&q;originEpisodeId&q;:0,&q;supportRtmp&q;:false,&q;supportPk&q;:true,&q;supportLuckyBag&q;:true,&q;supportUserNoteStroke&q;:false,&q;communicateType&q;:0,&q;one2One&q;:false,&q;fakeLive&q;:false},&q;validStatus&q;:1,&q;supportLive&q;:true,&q;supportAiCatalog&q;:false,&q;hasIntelligentPen&q;:false,&q;useLocalRecording&q;:false,&q;useIntelligentR