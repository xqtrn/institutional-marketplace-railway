d&q;:0,&q;supportRtmp&q;:false,&q;supportPk&q;:false,&q;supportLuckyBag&q;:false,&q;supportUserNoteStroke&q;:false,&q;communicateType&q;:0,&q;one2One&q;:false,&q;fakeLive&q;:false},&q;validStatus&q;:1,&q;supportLive&q;:true,&q;supportAiCatalog&q;:true,&q;hasIntelligentPen&q;:false,&q;useLocalRecording&q;:false,&q;useIntelligentRoom&q;:false,&q;hasSalePosition&q;:false,&q;hasEpisodeCards&q;:false,&q;lockedForShouna&q;:false,&q;needSignIn&q;:false,&q;needTeacherSignIn&q;:false,&q;enablePadPencil&q;:true,&q;displayExercise&q;:false,&q;supportLuckyBag&q;:false,&q;supportLivePk&q;:false},{&q;id&q;:10839854,&q;kePrefix&q;:&q;gwy&q;,&q;courseId&q;:1,&q;status&q;:3,&q;playStatus&q;:3,&q;type&q;:1,&q;recordingType&q;:0,&q;mediaType&q;:0,&q;title&q;:&q;判断-【2026国考第27季&a;2025下半年省考第19季】行测模考大赛&q;,&q;innerTitle&q;:&q;&q;,&q;startTime&q;:1753614000000,&q;endTime&q;:1753624800000,&q;teacher&q;:{&q;id&q;:2774,&q;userId&q;:28109961,&q;name&q;:&q;魏倩&q;,&q;brief&q;:&q;粉笔判断优质教师&q;,&q;desc&q;:&q;粉笔判断优质教师， 9年授课经验，长期致力于公务员考试研究，具有扎实的专业理论知识，严谨的授课思维，善于引导学员思路，总结做题方法，认真负责，细致耐心，帮助学员触类旁通，让学员在轻松愉快的氛围中掌握解题技巧。 \n参与各类授课研讨会议和教研活动，参与编写《行测的思维》《专项题集》等多套图书。 &q;,&q;avatar&q;:&q;171a64f9a5acea6.jpg&q;,&q;upperBodyPhoto&q;:null,&q;displayCoursePrefix&q;:&q;gwy&q;,&q;teacherStat&q;:{&q;teacherId&q;:2774,&q;episodeCount&q;:1189,&q;scoreCount&q;:343403,&q;avgScore&q;:9.776233754510049,&q;fiveGradeAvgScore&q;:4.89,&q;updateTime&q;:1773587098907},&q;auditionEpisode&q;:{&q;episodeTitle&q;:&q;个人展示课&q;,&q;episodeVideoUrl&q;:&q;https://vod.fbstatic.cn/22e9ceb2vodbj1251001446/9cc905d93560136621447406307/DEgSjqlUU9IA.mp4?t=f2a4b300&a;us=4070880000&a;sign=64520ebea0bb372ee32fddb86886973a&q;},&q;memberOfCPC&q;:false,&q;tags&q;:null},&q;teachChannel&q;:1,&q;offline&q;:null,&q;duration&q;:12301,&q;hasAudition&q;:false,&q;bizType&q;:0,&q;bizId&q;:&q;710082&q;,&q;supportReplay&q;:true,&q;extraInfo&q;:null,&q;liveConfig&q;:{&q;episodeId&q;:10839854,&q;supportMultiGroup&q;:false,&q;exerciseBizType&q;:0,&q;videoDisplayType&q;:0,&q;avForwardType&q;:0,&q;useIntelligentRoom&q;:false,&q;hasStrokeKeynote&q;:true,&q;verticalModeType&q;:0,&q;originEpisodeId&q;:0,&q;supportRtmp&q;:false,&q;supportPk&q;:false,&q;supportLuckyBag&q;:false,&q;supportUserNoteStroke&q;:false,&q;communicateType&q;:0,&q;one2One&q;:false,&q;fakeLive&q;:false},&q;validStatus&q;:1,&q;supportLive&q;:true,&q;supportAiCatalog&q;:true,&q;hasIntelligentPen&q;:false,&q;useLocalRecording&q;:false,&q;useIntelligentRoom&q;:false,&q;hasSalePosition&q;:false,&q;hasEpisodeCards&q;:false,&q;lockedForShouna&q;:false,&q;needSignIn&q;:false,&q;needTeacherSignIn&q;:false,&q;enablePadPencil&q;:true,&q;displayExercise&q;:false,&q;supportLuckyBag&q;:false,&q;supportLivePk&q;:false},{&q;id&q;:10839855,&q;kePrefix&q;:&q;gwy&q;,&q;courseId&q;:1,&q;status&q;:3,&q;playStatus&q;:3,&q;type&q;:1,&q;recordingType&q;:0,&q;mediaType&q;:0,&q;title&q;:&q;数资-【2026国考第27季&a;2025下半年省考第19季】行测模考大赛&q;,&q;innerTitle&q;:&q;&q;,&q;startTime&q;:1753614000000,&q;endTime&q;:1753624800000,&q;teacher&q;:{&q;id&q;:71950,&q;userId&q;:41185252,&q;name&q;:&q;左宏帅&q;,&q;brief&q;:&q;粉笔数资优质教师&q;,&q;desc&q;:&q;粉笔数资优质教师，浙江大学数学系硕士毕业。\n15年授课经验，累计授课时长超过20000小时，培训师资千余人，培训学员300余万人次，上岸学员数以万计。\n坚持一线教学，不断钻研创新，独创行业资料分析题型教学法，深刻了解学员的痛点难点，授课深入浅出，通俗易懂，因材施教，深受学员好评。\n参与组织各类授课研讨会议和教研活动，著有《行测新时代(数量关系)》《行测新时代(资料分析)》、《公务员考试5100题》等多套图书。&q;,&q;avatar&q;:&q;194401c9dbc8d94.jpg&q;,&q;upperBodyPhoto&q;:null,&q;displayCoursePrefix&q;:&q;gwy&q;,&q;teacherStat&q;:{&q;teacherId&q;:71950,&q;episodeCount&q;:306,&q;scoreCount&q;:106865,&q;avgScore&q;:9.8630795863941,&q;fiveGradeAvgScore&q;:4.93,&q;updateTime&q;:1773623430603},&q;auditionEpisode&q;:{&q;episodeTitle&q;:&q;个人展示课&q;,&q;episodeVideoUrl&q;:&q;https://vod.fbstatic.cn/22e9ceb2vodbj1251001446/ef0d2a603560136621448690407/eJ7KKJmF5b8A.mp4?t=f2a4b300&a;us=4070880000&a;sign=c3fa61877607e1167f9a85a9b29ea6aa&q;},&q;memberOfCPC&q;:false,&q;tags&q;:null},&q;teachChannel&q;:1,&q;offline&q;:null,&q;duration&q;:10373,&q;hasAudition&q;:false,&q;bizType&q;:0,&q;bizId