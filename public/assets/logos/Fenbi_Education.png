:&q;粉笔言语优质教师，硕士学历。 \n15年授课经验，累计授课时长超过20000小时，培训学员300余万人次。对言语理解与表达模块有深入研究，深入了解言语理解与表达模块各种题型的考情，根据各题型特点讲解解题方法，讲课态度认真，细致入微，课堂气氛活跃，深受好评。 \n参与组织各类授课研讨会议和教研活动。&q;,&q;avatar&q;:&q;171abe13498b613.jpg&q;,&q;upperBodyPhoto&q;:null,&q;displayCoursePrefix&q;:&q;gwy&q;,&q;teacherStat&q;:{&q;teacherId&q;:152,&q;episodeCount&q;:1129,&q;scoreCount&q;:163191,&q;avgScore&q;:9.714236691974454,&q;fiveGradeAvgScore&q;:4.86,&q;updateTime&q;:1773559752362},&q;auditionEpisode&q;:{&q;episodeTitle&q;:&q;个人展示课&q;,&q;episodeVideoUrl&q;:&q;https://vod.fbstatic.cn/22e9ceb2vodbj1251001446/52c403db3560136621446591026/FXdla8iGgaoA.mp4?t=f2a4b300&a;us=4070880000&a;sign=61bd19a9db40c5fa6fb8e7cbbb0f861b&q;},&q;memberOfCPC&q;:false,&q;tags&q;:null},&q;teachChannel&q;:1,&q;offline&q;:null,&q;duration&q;:11844,&q;hasAudition&q;:false,&q;bizType&q;:0,&q;bizId&q;:&q;710082&q;,&q;supportReplay&q;:true,&q;extraInfo&q;:null,&q;liveConfig&q;:{&q;episodeId&q;:10516272,&q;supportMultiGroup&q;:false,&q;exerciseBizType&q;:0,&q;videoDisplayType&q;:0,&q;avForwardType&q;:0,&q;useIntelligentRoom&q;:false,&q;hasStrokeKeynote&q;:true,&q;verticalModeType&q;:0,&q;originEpisodeId&q;:0,&q;supportRtmp&q;:false,&q;supportPk&q;:false,&q;supportLuckyBag&q;:false,&q;supportUserNoteStroke&q;:false,&q;communicateType&q;:0,&q;one2One&q;:false,&q;fakeLive&q;:false},&q;validStatus&q;:1,&q;supportLive&q;:true,&q;supportAiCatalog&q;:true,&q;hasIntelligentPen&q;:false,&q;useLocalRecording&q;:false,&q;useIntelligentRoom&q;:false,&q;hasSalePosition&q;:false,&q;hasEpisodeCards&q;:false,&q;lockedForShouna&q;:false,&q;needSignIn&q;:false,&q;needTeacherSignIn&q;:false,&q;enablePadPencil&q;:false,&q;displayExercise&q;:false,&q;supportLuckyBag&q;:false,&q;supportLivePk&q;:false},{&q;id&q;:10516273,&q;kePrefix&q;:&q;gwy&q;,&q;courseId&q;:1,&q;status&q;:3,&q;playStatus&q;:3,&q;type&q;:1,&q;recordingType&q;:0,&q;mediaType&q;:0,&q;title&q;:&q;判断-【2026国考第18季&a;2025下半年省考第10季】行测模考大赛&q;,&q;innerTitle&q;:&q;&q;,&q;startTime&q;:1748170800000,&q;endTime&