Status&q;:3,&q;type&q;:33,&q;recordingType&q;:0,&q;mediaType&q;:0,&q;title&q;:&q;【言语】精选好题 沉浸刷题&q;,&q;innerTitle&q;:&q;&q;,&q;startTime&q;:1749441600000,&q;endTime&q;:1749448800000,&q;teacher&q;:{&q;id&q;:16530,&q;userId&q;:73216758,&q;name&q;:&q;刘开慧&q;,&q;brief&q;:&q;粉笔优质讲师&q;,&q;desc&q;:&q;粉笔优质讲师\n四年公考教学经验，全面了解事业单位言语科目近年来命题规律、重难点及不同类型题目答题技巧，授课条理清晰，语言通俗易懂，风格幽默风趣，实战经验丰富，且擅长深入浅出，激发学员学习热情，深受学员喜爱。&q;,&q;avatar&q;:&q;198551347778a1e.jpg&q;,&q;upperBodyPhoto&q;:null,&q;displayCoursePrefix&q;:&q;sydw&q;,&q;teacherStat&q;:{&q;teacherId&q;:16530,&q;episodeCount&q;:350,&q;scoreCount&q;:1605,&q;avgScore&q;:9.879127725856709,&q;fiveGradeAvgScore&q;:4.94,&q;updateTime&q;:1773566095917},&q;auditionEpisode&q;:{&q;episodeTitle&q;:&q;个人展示课&q;,&q;episodeVideoUrl&q;:&q;https://vod.fbstatic.cn/22e9ceb2vodbj1251001446/b7e4edc21253642695664039132/hf14S37Vsx0A.mp4?t=f2a4b300&a;us=4070880000&a;sign=7574a5c01ba998ba731acf886001efb3&q;},&q;memberOfCPC&q;:false,&q;tags&q;:null},&q;teachChannel&q;:1,&q;offline&q;:null,&q;duration&q;:8178,&q;hasAudition&q;:false,&q;bizType&q;:0,&q;bizId&q;:&q;726825&q;,&q;supportReplay&q;:true,&q;extraInfo&q;:null,&q;liveConfig&q;:{&q;episodeId&q;:10775242,&q;supportMultiGroup&q;:false,&q;exerciseBizType&q;:0,&q;videoDisplayType&q;:0,&q;avForwardType&q;:0,&q;useIntelligentRoom&q;:false,&q;hasStrokeKeynote&q;:true,&q;verticalModeType&q;:0,&q;originEpisodeId&q;:0,&q;supportRtmp&q;:false,&q;supportPk&q;:true,&q;supportLuckyBag&q;:true,&q;supportUserNoteStroke&q;:false,&q;communicateType&q;:0,&q;one2One&q;:false,&q;fakeLive&q;:false},&q;validStatus&q;:1,&q;supportLive&q;:true,&q;supportAiCatalog&q;:false,&q;hasIntelligentPen&q;:false,&q;useLocalRecording&q;:false,&q;useIntelligentRoom&q;:false,&q;hasSalePosition&q;:false,&q;hasEpisodeCards&q;:true,&q;lockedForShouna&q;:false,&q;needSignIn&q;:false,&q;needTeacherSignIn&q;:false,&q;enablePadPencil&q;:true,&q;displayExercise&q;:false,&q;supportLuckyBag&q;:true,&q;supportLivePk&q;:true},{&q;id&q;:10775276,&q;kePrefix&q;:&q;sydw&q;,&q;courseId&q;:6,&q;status&q;:3,&q;playStatus&q;:3,&q;type&q;:33,&q;recordingType&q;:0,&q;mediaType&q;:0,&q;title&q;:&q;【判断】精选好题 沉浸刷题&q;,&q;innerTitle&q;:&q;&q;,&q;startTime&q;:1749456000000,&q;endTime&q;:1749463200000,&q;teacher&q;:{&q;id&q;:16991,&q;userId&q;:46502384,&q;name&q;:&q;岑红&q;,&q;brief&q;:&q;粉笔优质讲师&q;,&q;desc&q;:&q;粉笔优质教师\n       6年教学授课经验，具有判断科目丰富的实践经验及系统扎实的专业理论知识，参与笔试判断科目模拟题命制和解析审核且多次参加粉笔授课研讨会议，全面了解事业单位判断类题型的命题规律及答题技巧。善于将知识点简单化、条理化和趣味化以激发学生的学习热情，同时授课逻辑性强，思维严谨，能够意识到学生在知识点上的问题并给予相应的指导，深受广大学员的认可和好评。&q;,&q;avatar&q;:&q;19854eea5710183.jpg&q;,&q;upperBodyPhoto&q;:null,&q;displayCoursePrefix&q;:&q;sydw&q;,&q;teacherStat&q;:{&q;teacherId&q;:16991,&q;episodeCount&q;:496,&q;scoreCount&q;:2569,&q;avgScore&q;:9.792915531335142,&q;fiveGradeAvgScore&q;:4.9,&q;updateTime&q;:1773604268370},&q;auditionEpisode&q;:{&q;episodeTitle&q;:&q;个人展示课&q;,&q;episodeVideoUrl&q;:&q;https://vod.fbstatic.cn/22e9ceb2vodbj1251001446/10d5dbb55145403709539499496/emXm1Ym9kfIA.mp4?t=f2a4b300&a;us=4070880000&a;sign=fc844b010265e86e6742934e4dffdd3c&q;},&q;memberOfCPC&q;:false,&q;tags&q;:null},&q;teachChannel&q;:1,&q;offline&q;:null,&q;duration&q;:7761,&q;hasAudition&q;:false,&q;bizType&q;:0,&q;bizId&q;:&q;726825&q;,&q;supportReplay&q;:true,&q;extraInfo&q;:null,&q;liveConfig&q;:{&q;episodeId&q;:10775276,&q;supportMultiGroup&q;:false,&q;exerciseBizType&q;:0,&q;videoDisplayType&q;:0,&q;avForwardType&q;:0,&q;useIntelligentRoom&q;:false,&q;hasStrokeKeynote&q;:true,&q;verticalModeType&q;:0,&q;originEpisodeId&q;:0,&q;supportRtmp&q;:false,&q;supportPk&q;:true,&q;supportLuckyBag&q;:true,&q;supportUserNoteStroke&q;:false,&q;communicateType&q;:0,&q;one2One&q;:false,&q;fakeLive&q;:false},&q;validStatus&q;:1,&q;supportLive&q;:true,&q;supportAiCatalog&q;:false,&q;hasIntelligentPen&q;:false,&q;useLocalRecording&q;:false,&q;useIntelligentRoom&q;:false,&q;hasSalePosition&q;:false,&q;hasEpisodeCards&q;:true,&q;lockedForShouna&q;:false,&q;needSignIn&q;:false,&q;needTeacherSignIn&q;:false,&q;enablePadPencil&q;:true,&q;displayExercise&q;:false,&q;supportLuckyBag&q;:true,&q;supportLivePk&q;:true},{&q;id&q;:10786683,&q;kePrefix&q;:&q;sydw&q;,&q;courseId&q;:6,&q;status&q;:3,&q;playStatus&q;:3,&q;type&q;:33,&q;recordingType&q;:0,&q;mediaType&q;:0,&q;title&q;:&q;【综应】精选好题 沉浸刷题&q;,&q;innerTitle&q;:&q;&q;,&q;startTime&q;:1749520800000,&q;endTime&q;:1749528000000,&q;teacher&q;:{&q;id&q;:35003,&q;userId&q;:83142599,&q;name&q;:&q;史芯蕊&q;,&q;brief&q;:&q;粉笔优质讲师&q;,&q;desc&q;:&q;粉笔优质讲师\n6年一线教学经验，承担过线上线下多种课程，包含安徽、武汉地区联考A，联考C，以及江苏等线下课程。线上部分以精品系统班，刷题班，线下考前冲刺班为主，授课经验丰富，深受学员喜爱，服务学员上千人，累计授课时长超千小时，授课评分4.9分。\n授课思路清晰，逻辑较强，善于从学员的角度切入，用更轻松的方式灵活运用答题技巧，同时给出学员针对性又个性化的指导方案。\n定期参加粉笔教研，多次参与真题解析以及真题解析视频录制，对理论体系有深入的研究，了解最新命题趋势方向。&q;,&q;avatar&q;:&q;18f656de50744c0.jpg&q;,&q;upperBodyPhoto&q;:null,&q;displayCoursePrefix&q;:&q;sydw&q;,&q;teacherStat&q;:{&q;teacherId&q;:35003,&q;episodeCount&q;:281,&q;scoreCount&q;:638,&q;avgScore&q;:9.877742946708466,&q;fiveGradeAvgScore&q;:4.94,&q;updateTime&q;:1773590037796},&q;auditionEpisode&q;:{&q;episodeTitle&q;:&q;个人展示课&q;,&q;episodeVideoUrl&q;:&q;https://vod.fbstatic.cn/22e9ceb2vodbj1251001446/fb1642195145403708057024670/r8VrOUODYOYA.mp4?t=f2a4b300&a;us=4070880000&a;sign=66f06661bf427c9cc98ffaf63d1aef4e&q;},&q;memberOfCPC&q;:false,&q;tags&q;:null},&q;teachChannel&q;:1,&q;offline&q;:null,&q;duration&q;:8682,&q;hasAudition&q;:false,&q;bizType&q;:0,&q;bizId&q;:&q;726825&q;,&q;supportReplay&q;:true,&q;extraInfo&q;:null,&q;liveConfig&q;:{&q;episodeId&q;:10786683,&q;supportMultiGroup&q;:false,&q;exerciseBizType&q;:0,&q;videoDisplayType&q;:0,&q;avForwardType&q;:0,&q;useIntelligentRoom&q;:false,&q;hasStrokeKeynote&q;:true,&q;verticalModeType&q;:0,&q;originEpisodeId&q;:0,&q;supportRtmp&q;:false,&q;supportPk&q;:true,&q;supportLuckyBag&q;:true,&q;supportUserNoteStroke&q;:false,&q;communicateType&q;:0,&q;one2One&q;:false,&q;fakeLive&q;:false},&q;validStatus&q;:1,&q;supportLive&q;:true,&q;supportAiCatalog&q;:false,&q;hasIntelligentPen&q;:false,&q;useLocalRecording&q;:false,&q;useIntelligentRoom&q;:false,&q;hasSalePosition&q;:false,&q;hasEpisodeCards&q;:true,&q;lockedForShouna&q;:false,&q;needSignIn&q;:false,&q;needTeacherSignIn&q;:false,&q;enablePadPencil&q;:true,&q;displayExercise&q;:false,&q;supportLuckyBag&q;:true,&q;supportLivePk&q;:true},{&q;id&q;:10786684,&q;kePrefix&q;:&q;sydw&q;,&q;courseId&q;:6,&q;status&q;:3,&q;playStatus&q;:3,&q;type&q;:33,&q;recordingType&q;:0,&q;mediaType&q;:0,&q;title&q;:&q;【言语】精选好题 沉浸刷题&q;,&q;innerTitle&q;:&q;&q;,&q;startTime&q;:1749528000000,&q;endTime&q;:1749535200000,&q;teacher&q;:{&q;id&q;:16891,&q;userId&q;:68668145,&q;name&q;:&q;闫思辰&q;,&q;brief&q;:&q;粉笔优质讲师&q;,&q;desc&q;:&q;粉笔优质讲师\n6年线上线下授课经验，理论功底扎实——深度参与粉笔教研、内部培训，常分享授课心得；对考情、出题规律、命题套路有精准把控；\n授课风格逻辑清晰、严谨又亲和：既能营造轻松课堂氛围，让学员“听得进、愿意听”；更擅长化繁为简，结合学员特点因材施教，高效提升备考效率与成绩。\n累计授课评分4.9分，是学员公认的“提分好帮手”。&q;,&q;avatar&q;:&q;1983ba13ad3d06d.jpg&q;,&q;upperBodyPhoto&q;:null,&q;displayCoursePrefix&q;:&q;sydw&q;,&q;teacherStat&q;:{&q;teacherId&q;:16891,&q;episodeCount&q;:461,&q;scoreCount&q;:1771,&q;avgScore&q;:9.731225296442677,&q;fiveGradeAvgScore&q;:4.87,&q;updateTime&q;:1773582810652},&q;auditionEpisode&q;:null,&q;memberOfCPC&q;:false,&q;tags&q;:null},&q;teachChannel&q;:1,&q;offline&q;:null,&q;duration&q;:7551,&q;hasAudition&q;:false,&q;bizType&q;:0,&q;bizId&q;:&q;726825&q;,&q;supportReplay&q;:true,&q;extraInfo&q;:null,&q;liveConfig&q;:{&q;episodeId&q;:10786684,&q;supportMultiGroup&q;:false,&q;exerciseBizType&q;:0,&q;videoDisplayType&q;:0,&q;avForwardType&q;:0,&q;useIntelligentRoom&q;:false,&q;hasStrokeKeynote&q;:true,&q;verticalModeType&q;:0,&q;originEpisodeId&q;:0,&q;supportRtmp&q;:false,&q;supportPk&q;:true,&q;supportLuckyBag&q;:true,&q;supportUserNoteStroke&q;:false,&q;communicateType&q;:0,&q;one2One&q;:false,&q;fakeLive&q;:false},&q;validStatus&q;:1,&q;supportLive&q;:true,&q;supportAiCatalog&q;:false,&q;hasIntelligentPen&q;:false,&q;useLocalRecording&q;:false,&q;useIntelligentRoom&q;:false,&q;hasSalePosition&q;:false,&q;hasEpisodeCards&q;:true,&q;lockedForShouna&q;:false,&q;needSignIn&q;:false,&q;needTeacherSignIn&q;:false,&q;enablePadPencil&q;:true,&q;displayExercise&q;:false,&q;supportLuckyBag&q;:true,&q;supportLivePk&q;:true},{&q;id&q;:10786685,&q;kePrefix&q;:&q;sydw&q;,&q;courseId&q;:6,&q;status&q;:3,&q;playStatus&q;:3,&q;type&q;:33,&q;recordingType&q;:0,&q;mediaType&q;:0,&q;title&q;:&q;【公基非法】精选好题 沉浸刷题&q;,&q;innerTitle&q;:&q;&q;,&q;startTime&q;:1749535200000,&q;endTime&q;:1749542400000,&q;teacher&q;:{&q;id&q;:34196,&q;userId&q;:83885051,&q;name&q;:&q;马莹萍&q;,&q;brief&q;:&q;粉笔优质讲师&q;,&q;desc&q;:&q;粉笔常识公基优质教师\n6年授课经验，授课实战经验丰富。累计授课时长900+，授课人次2500+，授课评分4.9分，深受学员喜爱。长期扎根于常识公基非法及判断教学教研工作，曾撰写教研文章十余篇，撰写多地政府工作报告解读文件，参与全国常识公基非法密卷课件及讲义制作。授课班级中，公基成绩均有明显提升，历年考试中，均有多名学员取得80+的好成绩。授课风格幽默风趣，贴近实际，能够通过学员特点进行个性化指导，帮助学员突破瓶颈，一举成“公”。&q;,&q;avatar&q;:&q;198412a1819fc20.jpg&q;,&q;upperBodyPhoto&q;:null,&q;displayCoursePrefix&q;:&q;sydw&q;,&q;teacherStat&q;:{&q;teacherId&q;:34196,&q;episodeCount&q;:833,&q;scoreCount&q;:1519,&q;avgScore&q;:9.81566820276498,&q;fiveGradeAvgScore&q;:4.91,&q;updateTime&q;:1773561169054},&q;auditionEpisode&q;:{&q;episodeTitle&q;:&q;个人展示课&q;,&q;episodeVideoUrl&q;:&q;https://vod.fbstatic.cn/22e9ceb2vodbj1251001446/72db76805145403709544091356/dk0lqGQPopcA.mp4?t=f2a4b300&a;us=4070880000&a;sign=c98ccaef848337ae40404519654c80f6&q;},&q;memberOfCPC&q;:false,&q;tags&q;:null},&q;teachChannel&q;:1,&q;offline&q;:null,&q;duration&q;:7630,&q;hasAudition&q;:false,&q;bizType&q;:0,&q;bizId&q;:&q;726825&q;,&q;supportReplay&q;:true,&q;extraInfo&q;:null,&q;liveConfig&q;:{&q;episodeId&q;:10786685,&q;supportMultiGroup&q;:false,&q;exerciseBizType&q;:0,&q;videoDisplayType&q;:0,&q;avForwardType&q;:0,&q;useIntelligentRoom&q;:false,&q;hasStrokeKeynote&q;:true,&q;verticalModeType&q;:0,&q;originEpisodeId&q;:0,&q;supportRtmp&q;:false,&q;supportPk&q;:true,&q;supportLuckyBag&q;:true,&q;supportUserNoteStroke&q;:false,&q;communicateType&q;:0,&q;one2One&q;:false,&q;fakeLive&q;:false},&q;validStatus&q;:1,&q;supportLive&q;:true,&q;supportAiCatalog&q;:false,&q;hasIntelligentPen&q;:false,&q;useLocalRecording&q;:false,&q;useIntelligentRoom&q;:false,&q;hasSalePosition&q;:false,&q;hasEpisodeCards&q;:true,&q;lockedForShouna&q;:false,&q;needSignIn&q;:false,&q;needTeacherSignIn&q;:false,&q;enablePadPencil&q;:true,&q;displayExercise&q;:false,&q;supportLuckyBag&q;:true,&q;supportLivePk&q;:true},{&q;id&q;:10786686,&q;kePrefix&q;:&q;sydw&q;,&q;courseId&q;:6,&q;status&q;:3,&q;playStatus&q;:3,&q;type&q;:33,&q;recordingType&q;:0,&q;mediaType&q;:0,&q;title&q;:&q;【数资】精选好题 沉浸刷题&q;,&q;innerTitle&q;:&q;&q;,&q;startTime&q;:1749542400000,&q;endTime&q;:1749549600000,&q;teacher&q;:{&q;id&q;:56432,&q;userId&q;:96015899,&q;name&q;:&q;李秋霖&q;,&q;brief&q;:&q;粉笔优质讲师&q;,&q;desc&q;:&q;粉笔优质教师\n4年一线教学授课经验，具有数资科目丰富的实践经验及系统扎实的专业理论知识。参与命制笔试教研，对资料分析方向有深入研究，并撰写多篇事业单位笔试教研材料，在粉笔笔试教师内部进行共享。多次参加粉笔教研活动，分享授课经验心得，助力粉笔理论研发升级。获得学员的多次好评，具有热情洋溢的授课风格，让学生在轻松的学习氛围中，用更简单的方法，找到更快捷的解题之道，深受广大学员的认可和好评。&q;,&q;avatar&q;:&q;18488bc569ccb4d.jpg&q;,&q;upperBodyPhoto&q;:null,&q;displayCoursePrefix&q;:&q;sydw&q;,&q;teacherStat&q;:{&q;teacherId&q;:56432,&q;episodeCount&q;:274,&q;scoreCount&q;:785,&q;avgScore&q;:9.76305732484077,&q;fiveGradeAvgScore&q;:4.88,&q;updateTime&q;:1773590328512},&q;auditionEpisode&q;:{&q;episodeTitle&q;:&q;个人展示课&q;,&q;episodeVideoUrl&q;:&q;https://vod.fbstatic.cn/22e9ceb2vodbj1251001446/160ff7b15145403709427487787/AMGHBIZnUaYA.mp4?t=f2a4b300&a;us=4070880000&a;sign=5bd04e214d72bef5a7d368b737db12f4&q;},&q;memberOfCPC&q;:false,&q;tags&q;:null},&q;teachChannel&q;:1,&q;offline&q;:null,&q;duration&q;:7245,&q;hasAudition&q;:false,&q;bizType&q;:0,&q;bizId&q;:&q;726825&q;,&q;supportReplay&q;:true,&q;extraInfo&q;:null,&q;liveConfig&q;:{&q;episodeId&q;:10786686,&q;supportMultiGroup&q;:false,&q;exerciseBizType&q;:0,&q;videoDisplayType&q;:0,&q;avForwardType&q;:0,&q;useIntelligentRoom&q;:false,&q;hasStrokeKeynote&q;:true,&q;verticalModeType&q;:0,&q;originEpisodeId&q;:0,&q;supportRtmp&q;:false,&q;supportPk&q;:true,&q;supportLuckyBag&q;:true,&q;supportUserNoteS