;:&q;sydw&q;,&q;courseId&q;:6,&q;status&q;:3,&q;playStatus&q;:3,&q;type&q;:33,&q;recordingType&q;:0,&q;mediaType&q;:0,&q;title&q;:&q;【判断】精选好题 沉浸刷题&q;,&q;innerTitle&q;:&q;&q;,&q;startTime&q;:1741399200000,&q;endTime&q;:1741406400000,&q;teacher&q;:{&q;id&q;:16782,&q;userId&q;:62414994,&q;name&q;:&q;李宁宁&q;,&q;brief&q;:&q;粉笔优质讲师&q;,&q;desc&q;:&q;粉笔优质讲师\n6年一线教学授课经验，对于判断科目有丰富的实践经验及系统扎实的专业理论知识，多次参加粉笔授课研讨会议，撰写事业单位笔试教研材料，分享授课经验心得，全面掌握事业单位考试题型及最新考情。授课风格形象生动、条理清晰，受到同学们的一致好评。&q;,&q;avatar&q;:&q;198552a8eb7a710.jpg&q;,&q;upperBodyPhoto&q;:null,&q;displayCoursePrefix&q;:&q;sydw&q;,&q;teacherStat&q;:{&q;teacherId&q;:16782,&q;episodeCount&q;:461,&q;scoreCount&q;:1852,&q;avgScore&q;:9.804535637149028,&q;fiveGradeAvgScore&q;:4.9,&q;updateTime&q;:1773582720099},&q;auditionEpisode&q;:{&q;episodeTitle&q;:&q;个人展示课&q;,&q;episodeVideoUrl&q;:&q;https://vod.fbstatic.cn/22e9ceb2vodbj1251001446/0c9d81075145403709546068429/szLjSYA13EAA.mp4?t=f2a4b300&a;us=4070880000&a;sign=1a1288969d3bff4d5f5deefe5adbc17b&q;},&q;memberOfCPC&q;:false,&q;tags&q;:null},&q;teachChannel&q;:1,&q;offline&q;:null,&q;duration&q;:8276,&q;hasAudition&q;:false,&q;bizType&q;:0,&q;bizId&q;:&q;726825&q;,&q;supportReplay&q;:true,&q;extraInfo&q;:null,&q;liveConfig&q;:{&q;episodeId&q;:10136985,&q;supportMultiGroup&q;:false,&q;exerciseBizType&q;:0,&q;videoDisplayType&q;:0,&q;avForwardType&q;:0,&q;useIntelligentRoom&q;:false,&q;hasStrokeKeynote&q;:true,&q;verticalModeType&q;:0,&q;originEpisodeId&q;:0,&q;supportRtmp&q;:false,&q;supportPk&q;:true,&q;supportLuckyBag&q;:true,&q;supportUserNoteStroke&q;:false,&q;communicateType&q;:0,&q;one2One&q;:false,&q;fakeLive&q;:false},&q;validStatus&q;:1,&q;supportLive&q;:true,&q;supportAiCatalog&q;:false,&q;hasIntelligentPen&q;:false,&q;useLocalRecording&q;:false,&q;useIntelligentRoom&q;:false,&q;hasSalePosition&q;:false,&q;hasEpisodeCards&q;:true,&q;lockedForShouna&q;:false,&q;needSignIn&q;:false,&q;needTeacherSignIn&q;:false,&q;enablePadPencil&q;:true,&q;displayExercise&q;:false,&q;supportLuckyBag&q;:true,&q;supportLivePk&q;:true},{&q;id&q;:10139442,&q;kePrefix&q;:&q;sydw&q;,&q;courseId&q;:6,&q;status&q;:3,&q;playStatus&q;:3,&q;type&q;:33,&q;recordingType&q;:0,&q;mediaType&q;:0,&q;title&q;:&q;【数资】精选好题 沉浸刷题&q;,&q;innerTitle&q;:&q;&q;,&q;startTime&q;:1741485600000,&q;endTime&q;:1741492800000,&q;teacher&q;:{&q;id&q;:18293,&q;userId&q;:67808406,&q;name&q;:&q;任忠生&q;,&q;brief&q;:&q;粉笔优质讲师&q;,&q;desc&q;:&q;粉笔优质讲师\n6年一线教学经验，承担过线上线下多种课程，授课经验丰富，深受学员喜爱，累计授课评分4.9分。\n授课思路清晰，风趣幽默，妙语连珠，课堂中知识与段子齐飞，答题声与欢笑声连成一片，课堂氛围极佳。\n定期参加粉笔笔试教研，多次参与真题解析以及真题解析视频录制，对笔试理论体系有深入的研究，了解最新命题趋势方向。&q;,&q;avatar&q;:&q;193b4b22415b966.jpg&q;,&q;upperBodyPhoto&q;:null,&q;displayCoursePrefix&q;:&q;sydw&q;,&q;teacherStat&q;:{&q;teacherId&q;:18293,&q;episodeCount&q;:418,&q;scoreCount&q;:1609,&q;avgScore&q;:9.794903666873825,&q;fiveGradeAvgScore&q;:4.9,&q;updateTime&q;:1773490915782},&q;auditionEpisode&q;:{&q;episodeTitle&q;:&q;个人展示课&q;,&q;episodeVideoUrl&q;:&q;https://vod.fbstatic.cn/22e9ceb2vodbj1251001446/bfb29f3c5145403709545073450/6OUlHaE0u2UA.mp4?t=f2a4b300&a;us=4070880000&a;sign=4672d88aaa0f986bf84441ae77d619a3&q;},&q;memberOfCPC&q;:false,&q;tags&q;:null},&q;teachChannel&q;:1,&q;offline&q;:null,&q;duration&q;:8833,&q;hasAudition&q;:false,&q;bizType&q;:0,&q;bizId&q;:&q;726825&q;,&q;supportReplay&q;:true,&q;extraInfo&q;:null,&q;liveConfig&q;:{&q;episodeId&q;:10139442,&q;supportMultiGroup&q;:false,&q;exerciseBizType&q;:0,&q;videoDisplayType&q;:0,&q;avForwardType&q;:0,&q;useIntelligentRoom&q;:false,&q;hasStrokeKeynote&q;:true,&q;verticalModeType&q;:0,&q;originEpisodeId&q;:0,&q;supportRtmp&q;:false,&q;supportPk&q;:true,&q;supportLuckyBag&q;:true,&q;supportUserNoteStroke&q;:false,&q;communicateType&q;:0,&q;one2One&q;:false,&q;fakeLive&q;:false},&q;validStatus&q;:1,&q;supportLive&q;:true,&q;supportAiCatalog&q;:false,&q;hasIntelligentPen&q;:false,&q;useLocalRecording&q;:false,&q;useIntelligentRoom&q;:false,&q;hasSalePosition&q;:false,&q;hasEpisodeCards&q;:true,&q;lockedForShouna&q;:false,&q;needSignIn&q;:false,&q;needTeacherSignIn&q;:false,&q;enablePadPencil&q;:true,&q;displayExercise&q;:false,&q;supportLuckyBag&q;:true,&q;supportLivePk&q;:true},{&q;id&q;:10139506,&q;kePrefix&q;:&q;sydw&q;,&q;courseId&q;:6,&q;status&q;:3,&q;playStatus&q;:3,&q;type&q;:33,&q;recordingType&q;:0,&q;mediaType&q;:0,&q;title&q;:&q;【公基非法】精选好题 沉浸刷题&q;,&q;innerTitle&q;:&q;&q;,&q;startTime&q;:1741658400000,&q;endTime&q;:1741665600000,&q;teacher&q;:{&q;id&q;:52906,&q;userId&q;:88669957,&q;name&q;:&q;陶静&q;,&q;brief&q;:&q;粉笔优质讲师&q;,&q;desc&q;:&q;粉笔优质讲师\n6年一线教学，深耕线上线下授课，累计覆盖全国超万名学员，授课时长已突破2500小时，教学经验扎实且全面。\n深耕常识与公共基础知识、判断科目领域，兼具扎实的专业理论功底与丰富实践经验。对全国多地考试考情、真题规律及命题趋势有着深刻洞察，授课理念独到新颖，始终秉持理论与实践相结合的教学原则，致力于帮助学员系统掌握解题技巧，让大家在轻松高效的学习氛围中稳步提升。\n授课风格独树一帜，条理清晰，又风趣幽默，把复杂课程内容拆解得层次分明、脉络清晰，让学员轻松跟上学习节奏，再搭配专业完善的教学体系，学习效率直接拉满。&q;,&q;avatar&q;:&q;1984fe9e02e27a3.jpg&q;,&q;upperBodyPhoto&q;:null,&q;displayCoursePrefix&q;:&q;sydw&q;,&q;teacherStat&q;:{&q;teacherId&q;:52906,&q;episodeCount&q;:640,&q;scoreCount&q;:952,&q;avgScore&q;:9.83823529411764,&q;fiveGradeAvgScore&q;:4.92,&q;updateTime&q;:1773495035648},&q;auditionEpisode&q;:{&q;episodeTitle&q;:&q;个人展示课&q;,&q;episodeVideoUrl&q;:&q;https://vod.fbstatic.cn/22e9ceb2vodbj1251001446/d568fd2c1397757888047530032/UZNkfXcuVicA.mp4?t=f2a4b300&a;us=4070880000&a;sign=a17687f4fba4def68220de9a1cbf4eef&q;},&q;memberOfCPC&q;:false,&q;tags&q;:null},&q;teachChannel&q;:1,&q;offline&q;:null,&q;duration&q;:7629,&q;hasAudition&q;:false,&q;bizType&q;:0,&q;bizId&q;:&q;726825&q;,&q;supportReplay&q;:true,&q;extraInfo&q;:null,&q;liveConfig&q;:{&q;episodeId&q;:10139506,&q;supportMultiGroup&q;:false,&q;exerciseBizType&q;:0,&q;videoDisplayType&q;:0,&q;avForwardType&q;:0,&q;useIntelligentRoom&q;:false,&q;hasStrokeKeynote&q;:true,&q;verticalModeType&q;:0,&q;originEpisodeId&q;:0,&q;supportRtmp&q;:false,&q;supportPk&q;:true,&q;supportLuckyBag&q;:true,&q;supportUserNoteStroke&q;:false,&q;communicateType&q;:0,&q;one2One&q;:false,&q;fakeLive&q;:false},&q;validStatus&q;:1,&q;supportLive&q;:true,&q;supportAiCatalog&q;:false,&q;hasIntelligentPen&q;:false,&q;useLocalRecording&q;:false,&q;useIntelligentRoom&q;:false,&q;hasSalePosition&q;:false,&q;hasEpisodeCards&q;:true,&q;lockedForShouna&q;:false,&q;needSignIn&q;:false,&q;needTeacherSignIn&q;:false,&q;enablePadPencil&q;:true,&q;displayExercise&q;:false,&q;supportLuckyBag&q;:true,&q;supportLivePk&q;:true},{&q;id&q;:10443690,&q;kePrefix&q;:&q;sydw&q;,&q;courseId&q;:6,&q;status&q;:3,&q;playStatus&q;:3,&q;type&q;:33,&q;recordingType&q;:0,&q;mediaType&q;:0,&q;title&q;:&q;【言语】精选好题 沉浸刷题&q;,&q;innerTitle&q;:&q;&q;,&q;startTime&q;:1741759200000,&q;endTime&q;:1741766400000,&q;teacher&q;:{&q;id&q;:35776,&q;userId&q;:83534698,&q;name&q;:&q;魏兰婷&q;,&q;brief&q;:&q;粉笔优质讲师&q;,&q;desc&q;:&q;粉笔优质讲师\n拥有7年一线教学授课经验，毕业于双一流院校。深耕言语理解与表达科目，对国考及各省考情有精准把握。具有言语科目丰富的实践经验及系统扎实的专业理论知识。\n①多次参与粉笔授课研讨与教研活动，持续更新教学理论与方法；\n②承担线上公开课及线上直播课等工作，累计全国授课超万人次，学员评分长期稳定在4.9分以上；\n③曾2次在粉笔“师资风采大赛”中入围并获奖，教学能力获得内部认可。\n授课风格耐心细致，善于将复杂的知识点转化为通俗易懂的讲解，营造轻松积极的学习氛围。其高效的解题方法与亲切的指导深受学员好评，是学员信赖的良师。&q;,&q;avatar&q;:&q;1984fca9fbd6325.jpg&q;,&q;upperBodyPhoto&q;:null,&q;displayCoursePrefix&q;:&q;sydw&q;,&q;teacherStat&q;:{&q;teacherId&q;:35776,&q;episodeCount&q;:610,&q;scoreCount&q;:4222,&q;avgScore&q;:9.801989578398866,&q;fiveGradeAvgScore&q;:4.9,&q;updateTime&q;:1773576447340},&q;auditionEpisode&q;:{&q;episodeTitle&q;:&q;个人展示课&q;,&q;episodeVideoUrl&q;:&q;https://vod.fbstatic.cn/22e9ceb2vodbj1251001446/bcb7f84d5145403709538179593/LKKkDheS6YsA.mp4?t=f2a4b300&a;us=4070880000&a;sign=ade5c614ffe4fa0bcf0395aa689081c8&q;},&q;memberOfCPC&q;:false,&q;tags&q;:null},&q;teachChannel&q;:1,&q;offline&q;:null,&q;duration&q;:8110,&q;hasAudition&q;:false,&q;bizType&q;:0,&q;bizId&q;:&q;726825&q;,&q;supportReplay&q;:true,&q;extraInfo&q;:null,&q;liveConfig&q;:{&q;episodeId&q;:10443690,&q;supportMultiGroup&q;:false,&q;exerciseBizType&q;:0,&q;videoDisplayType&q;:0,&q;avForwardType&q;:0,&q;useIntelligentRoom&q;:false,&q;hasStrokeKeynote&q;:true,&q;verticalModeType&q;:0,&q;originEpisodeId&q;:0,&q;supportRtmp&q;:false,&q;supportPk&q;:true,&q;supportLuckyBag&q;:true,&q;supportUserNoteStroke&q;:false,&q;communicateType&q;:0,&q;one2One&q;:false,&q;fakeLive&q;:false},&q;validStatus&q;:1,&q;supportLive&q;:true,&q;supportAiCatalog&q;:false,&q;hasIntelligentPen&q;:false,&q;useLocalRecording&q;:false,&q;useIntelligentRoom&q;:false,&q;hasSalePosition&q;:false,&q;hasEpisodeCards&q;:true,&q;lockedForShouna&q;:false,&q;needSignIn&q;:false,&q;needTeacherSignIn&q;:false,&q;enablePadPencil&q;:false,&q;displayExercise&q;:false,&q;supportLuckyBag&q;:true,&q;supportLivePk&q;:true},{&q;id&q;:10139515,&q;kePrefix&q;:&q;sydw&q;,&q;courseId&q;:6,&q;status&q;:3,&q;playStatus&q;:3,&q;type&q;:33,&q;recordingType&q;:0,&q;mediaType&q;:0,&q;title&q;:&q;【公基法律】精选好题 沉浸刷题 &q;,&q;innerTitle&q;:&q;&q;,&q;startTime&q;:1741831200000,&q;endTime&q;:1741838400000,&q;teacher&q;:{&q;id&q;:31967,&q;userId&q;:67126019,&q;name&q;:&q;郭一桐&q;,&q;brief&q;:&q;粉笔优质讲师&q;,&q;desc&q;:&q;粉笔优质教师\n投身教育事业四年，拥有扎实一线教学经验，在事业单位公共基础知识科目的教学中，积累大量实用经验，专业理论知识扎实。对各省市考情深入钻研，精准把握各地考试要点与命题方向。多次参加粉笔真题教研与模拟题教研，全面把握事考命题趋势和最新考情。授课风格独具魅力，善于营造轻松愉悦的学习氛围，让学生对知识点茅塞顿开，并灵活运用，深受学员认可。&q;,&q;avatar&q;:&q;1789129960c875a.jpg&q;,&q;upperBodyPhoto&q;:null,&q;displayCoursePrefix&q;:&q;sydw&q;,&q;teacherStat&q;:{&q;teacherId&q;:31967,&q;episodeCount&q;:543,&q;scoreCount&q;:808,&q;avgScore&q;:9.811881188118809,&q;fiveGradeAvgScore&q;:4.91,&q;updateTime&q;:1773133486342},&q;auditionEpisode&q;:{&q;episodeTitle&q;:&q;个人展示课&q;,&q;episodeVideoUrl&q;:&q;https://vod.fbstatic.cn/22e9ceb2vodbj1251001446/e44064b11397757888020613737/LkKFrBQcBMAA.mp4?t=f2a4b300&a;us=4070880000&a;sign=9c612c0ca75f3a068042327bb6f1e7c6&q;},&q;memberOfCPC&q;:false,&q;tags&q;:null},&q;teachChannel&q;:1,&q;offline&q;:null,&q;duration&q;:9598,&q;hasAudition&q;:false,&q;bizType&q;:0,&q;bizId&q;:&q;726825&q;,&q;supportReplay&q;:true,&q;extraInfo&q;:null,&q;liveConfig&q;:{&q;episodeId&q;:10139515,&q;supportMultiGroup&q;:false,&q;exerciseBizType&q;:0,&q;videoDisplayType&q;:0,&q;avForwardType&q;:0,&q;useIntelligentRoom&q;:false,&q;hasStrokeKeynote&q;:true,&q;verticalModeType&q;:0,&q;originEpisodeId&q;:0,&q;supportRtmp&q;:false,&q;supportPk&q;:true,&q;supportLuckyBag&q;:true,&q;supportUserNoteStroke&q;:false,&q;communicateType&q;:0,&q;one2One&q;:false,&q;fakeLive&q;:false},&q;validStatus&q;:1,&q;supportLive&q;:true,&q;supportAiCatalog&q;:false,&q;hasIntelligentPen&q;:false,&q;useLocalRecording&q;:false,&q;useIntelligentRoom&q;:false,&q;hasSalePosition&q;:false,&q;hasEpisodeCards&q;:true,&q;lockedForShouna&q;:false,&q;needSignIn&q;:false,&q;needTeacherSignIn&q;:false,&q;enablePadPencil&q;:true,&q;displayExercise&q;:false,&q;supportLuckyBag&q;:true,&q;supportLivePk&q;:true},{&q;id&q;:10139518,&q;kePrefix&q;:&q;sydw&q;,&q;courseId&q;:6,&q;status&q;:3,&q;playStatus&q;:3,&q;type&q;:33,&q;recordingType&q;:0,&q;mediaType&q;:0,&q;title&q;:&q;【判断】精选好题 沉浸刷题&q;,&q;innerTitle&q;:&q;&q;,&q;startTime&q;:1741917600000,&q;endTime&q;:1741924800000,&q;teacher&q;:{&q;id&q;:24162,&q;userId&q;:59957211,&q;name&q;:&q;金思彤&q;,&q;brief&q;:&q;粉笔优质讲师&q;,&q;desc&q;:&q;粉笔优质讲师\n7年一线教学经验，211大学双一流学科硕士毕业，教学态度认真负责，具有判断科目丰富的实践经验及系统扎实的专业理论知识和对事业单位判断推理考情的深入研究；曾参与命制笔试真题教研和解析撰写工作，对判断推理最新命题趋势方向有深入研究。&q;,&q;avatar&q;:&q;19bbc34197eebfe.jpg&q;,&q;upperBodyPhoto&q;:null,&q;displayCoursePrefix&q;:&q;sydw&q;,&q;teacherStat&q;:{&q;teacherId&q;:24162,&q;episodeCount&q;:506,&q;scoreCount&q;:2157,&q;avgScore&q;:9.907278627723691,&q;fiveGradeAvgScore&q;:4.95,&q;updateTime&q;:1772558154031},&q;auditionEpisode&q;:{&q;episodeTitle&q;:&q;个人展示课&q;,&q;episodeVideoUrl&q;:&q;https://vod.fbstatic.cn/22e9ceb2vodbj1251001446/769646875145403709537454592/AvgGIhEZbfEA.mp4?t=f2a4b300&a;us=4070880000&a;sign=b403d56f99dc2f52a13f62fafb197865&q;},&q;memberOfCPC&q;:false,&q;tags&q;:null},&q;teachChannel&q;:1,&q;offline&q;:null,&q;duration&q;:8049,&q;hasAudition&q;:false,&q;bizType&q;:0,&q;bizId&q;:&q;726825&q;,&q;supportReplay&q;:true,&q;extraInfo&q;:null,&q;liveConfig&q;:{&q;episodeId&q;:10139518,&q;supportMultiGroup&q;:false,&q;exerciseBizType&q;:0,&q;videoDisplayType&q;:0,&q;avForwardType&q;:0,&q;useIntelligentRoom&q;:false,&q;hasStrokeKeynote&q;:true,&q;verticalModeType&q;:0,&q;originEpisodeId&q;:0,&q;supportRtmp&q;:false,&q;supportPk&q;:true,&q;supportLuckyBag&q;:true,&q;supportUserNoteStroke&q;:false,&q;communicateType&q;:0,&q;one2One&q;:false,&q;fakeLive&q;:false},&q;validStatus&q;:1,&q;supportLive&q;:true,&q;supportAiCatalog&q;:false,&q;hasIntelligentPen&q;:false,&q;useLocalRecording&q;:false,&q;useIntelligentRoom&q;:false,&q;hasSalePosition&q;:false,&q;hasEpisodeCards&q;:true,&q;lockedForShouna&q;:false,&q;needSignIn&q;:false,&q;needTeacherSignIn&q;:false,&q;enablePadPencil&q;:true,&q;displayExercise&q;:false,&q;supportLuckyBag&q;:true,&q;supportLivePk&q;:true},{&q;id&q;:10139521,&q;kePrefix&q;:&q;sydw&q;,&q;courseId&q;:6,&q;status&q;:3,&q;playStatus&q;:3,&q;type&q;:33,&q;recordingType&q;:0,&q;mediaType&q;:0,&q;title&q;:&q;【数资】精选好题 沉浸刷题 &q;,&q;innerTitle&q;:&q;&q;,&q;startTime&q;:1742004000000,&q;endTime&q;:1742011200000,&q;teacher&q;:{&q;id&q;:16588,&q;userId&q;:73651929,&q;name&q;:&q;王雅平&q;,&q;brief&q;:&q;粉笔优质讲师&q;,&q;desc&q;:&q;粉笔优质讲师\n6年一线教学经验，授课时长3000+小时，所带学员综合通过率达68%，具有数资科目丰富的实践经验及系统扎实的专业理论知识，对考情深入研究，授课经验丰富：①撰写多篇教研材料，在粉笔教师内部进行共享；②多次参加粉笔授课研讨会议，全面把握数资命题趋势及最新考情，积累丰富知识；③多次参加粉笔教研活动，分享授课经验心得。&q;,&q;avatar&q;:&q;17467ff056cb0e3.jpg&q;,&q;upperBodyPhoto&q;:null,&q;displayCoursePrefix&q;:&q;sydw&q;,&q;teacherStat&q;:{&q;teacherId&q;:16588,&q;episodeCount&q;:645,&q;scoreCount&q;:1598,&q;avgScore&q;:9.801001251564475,&q;fiveGradeAvgScore&q;:4.9,&q;updateTime&q;:1773543164175},&q;auditionEpisode&q;:{&q;episodeTitle&q;:&q;个人展示课&q;,&q;episodeVideoUrl&q;:&q;https://vod.fbstatic.cn/22e9ceb2vodbj1251001446/3d7922af5145403708051711222/4CdLbW9JRzEA.mp4?t=f2a4b300&a;us=4070880000&a;sign=db9e82e392a8449558ccd8e4eedf3845&q;},&q;memberOfCPC&q;:false,&q;tags&q;:null},&q;teachChannel&q;:1,&q;offline&q;:null,&q;duration&q;:7814,&q;hasAudition&q;:false,&q;bizType&q;:0,&q;bizId&q;:&q;726825&q;,