tatus&q;:3,&q;type&q;:33,&q;recordingType&q;:0,&q;mediaType&q;:0,&q;title&q;:&q;【公基非法】精选好题 沉浸刷题&q;,&q;innerTitle&q;:&q;&q;,&q;startTime&q;:1751954400000,&q;endTime&q;:1751961600000,&q;teacher&q;:{&q;id&q;:16538,&q;userId&q;:72683674,&q;name&q;:&q;章亦轩&q;,&q;brief&q;:&q;粉笔优质讲师&q;,&q;desc&q;:&q;粉笔常识公基优质教师\n四年一线教学授课经验，深耕一线课程，承担过线上笔试精品班、刷题班等多种班型。\n具有常识公基科目丰富的实践经验及系统扎实的专业理论知识和对常识公基考情的深入研究，曾参与笔试教研和解析撰写工作；注重考场思维，针对学生困惑研究教学策略；深入研讨常识公基命题趋势及最新考情，注重自我提升，积累丰富笔试理论知识。\n累计授课超1000小时，注重启发式引导，让学生在轻松的学习氛围中，用更简单的方法，找到更快捷的解题之道，深受广大学员的认可和好评。&q;,&q;avatar&q;:&q;17467b2f8a0fb3b.jpg&q;,&q;upperBodyPhoto&q;:null,&q;displayCoursePrefix&q;:&q;sydw&q;,&q;teacherStat&q;:{&q;teacherId&q;:16538,&q;episodeCount&q;:914,&q;scoreCount&q;:1035,&q;avgScore&q;:9.62898550724638,&q;fiveGradeAvgScore&q;:4.81,&q;updateTime&q;:1773475961041},&q;auditionEpisode&q;:{&q;episodeTitle&q;:&q;个人展示课&q;,&q;episodeVideoUrl&q;:&q;https://vod.fbstatic.cn/22e9ceb2vodbj1251001446/6ef433b51397757888365410347/0qvJbp7EGrgA.mp4?t=f2a4b300&a;us=4070880000&a;sign=5675190d3b2d1da9f9d0e15ba0571903&q;},&q;memberOfCPC&q;:false,&q;tags&q;:null},&q;teachChannel&q;:1,&q;offline&q;:null,&q;duration&q;:7470,&q;hasAudition&q;:false,&q;bizType&q;:0,&q;bizId&q;:&q;726825&q;,&q;supportReplay&q;:true,&q;extraInfo&q;:null,&q;liveConfig&q;:{&q;episodeId&q;:10844625,&q;supportMultiGroup&q;:false,&q;exerciseBizType&q;:0,&q;videoDisplayType&q;:0,&q;avForwardType&q;:0,&q;useIntelligentRoom&q;:false,&q;hasStrokeKeynote&q;:true,&q;verticalModeType&q;:0,&q;originEpisodeId&q;:0,&q;supportRtmp&q;:false,&q;supportPk&q;:true,&q;supportLuckyBag&q;:true,&q;supportUserNoteStroke&q;:false,&q;communicateType&q;:0,&q;one2One&q;:false,&q;fakeLive&q;:false},&q;validStatus&q;:1,&q;supportLive&q;:true,&q;supportAiCatalog&q;:false,&q;hasIntelligentPen&q;:false,&q;useLocalRecording&q;:false,&q;useIntelligentRoom&q;:false,&q;hasSalePosition&q;:false,&q;hasEpisodeCards&q;:true,&q;lockedForShouna&q;:false,&q;needSignIn&q;:false,&q;needTeacherSignIn&q;:false,&q;enablePadPencil&q;:true,&q;displayExercise&q;:false,&q;supportLuckyBag&q;:true,&q;supportLivePk&q;:true},{&q;id&q;:10844630,&q;kePrefix&q;:&q;sydw&q;,&q;courseId&q;:6,&q;status&q;:3,&q;playStatus&q;:3,&q;type&q;:33,&q;recordingType&q;:0,&q;mediaType&q;:0,&q;title&q;:&q;【数资】精选好题 沉浸刷题&q;,&q;innerTitle&q;:&q;&q;,&q;startTime&q;:1751961600000,&q;endTime&q;:1751968800000,&q;teacher&q;:{&q;id&q;:23908,&q;userId&q;:78283874,&q;name&q;:&q;许苗苗&q;,&q;brief&q;:&q;粉笔优质讲师&q;,&q;desc&q;:&q;粉笔优质讲师\n六年一线教学授课经验，承担过线上、线下笔试精品班多种班型课程，授课经验丰富，擅于总结知识点。\n有扎实的理论知识基础和丰富的实战经验，全面把握各个地区的考试情况和命题趋势，可以更好辨析不同知识点的区别关键点，解决学员的疑惑点；目前授课评分达4.9分，善于归纳和总结数资的学习方法，授课思维逻辑严谨清晰，通俗易懂，能帮助学员提供多种解题思路，更好地理解掌握数资内容，提高答题的正确率和速度，深受学员好评。&q;,&q;avatar&q;:&q;1945f3cf66cbd8c.jpg&q;,&q;upperBodyPhoto&q;:null,&q;displayCoursePrefix&q;:&q;sydw&q;,&q;teacherStat&q;:{&q;teacherId&q;:23908,&q;episodeCount&q;:430,&q;scoreCount&q;:1123,&q;avgScore&q;:9.861086375779168,&q;fiveGradeAvgScore&q;:4.93,&q;updateTime&q;:1766110373004},&q;auditionEpisode&q;:{&q;episodeTitle&q;:&q;个人展示课&q;,&q;episodeVideoUrl&q;:&q;https://vod.fbstatic.cn/22e9ceb2vodbj1251001446/8b9d686f1253642696527671297/OhQurD2xhWsA.mp4?t=f2a4b300&a;us=4070880000&a;sign=41febbbae155f49bcac8f627babcda5f&q;},&q;memberOfCPC&q;:false,&q;tags&q;:null},&q;teachChannel&q;:1,&q;offline&q;:null,&q;duration&q;:8121,&q;hasAudition&q;:false,&q;bizType&q;:0,&q;bizId&q;:&q;726825&q;,&q;supportReplay&q;:true,&q;extraInfo&q;:null,&q;liveConfig&q;:{&q;episodeId&q;:10844630,&q;supportMultiGroup&q;:false,&q;exerciseBizType&q;:0,&q;videoDisplayType&q;:0,&q;avForwardType&q;:0,&q;useIntelligentRoom&q;:false,&q;hasStrokeKeynote&q;:true,&q;verticalModeType&q;:0,&q;originEpisodeId&q;:0,&q;supportRtmp&q;:false,&q;supportPk&q;:true,&q;supportLuckyBag&q;:true,&q;supportUserNoteStroke&q;:false,&q;communicateType&q;:0,&q;one2One&q;:false,&q;fakeLive&q;:false},&q;validStatus&q;:1,&q;supportLive&q;:true,&q;supportAiCatalog&q;:false,&q;hasIntelligentPen&q;:false,&q;useLocalRecording&q;:false,&q;useIntelligentRoom&q;:false,&q;hasSalePosition&q;:false,&q;hasEpisodeCards&q;:true,&q;lockedForShouna&q;:false,&q;needSignIn&q;:false,&q;needTeacherSignIn&q;:false,&q;enablePadPencil&q;:true,&q;displayExercise&q;:false,&q;supportLuckyBag&q;:true,&q;supportLivePk&q;:true},{&q;id&q;:10844632,&q;kePrefix&q;:&q;sydw&q;,&q;courseId&q;:6,&q;status&q;:3,&q;playStatus&q;:3,&q;type&q;:33,&q;recordingType&q;:0,&q;mediaType&q;:0,&q;title&q;:&q;【综应】精选好题 沉浸刷题&q;,&q;innerTitle&q;:&q;&q;,&q;startTime&q;:1752026400000,&q;endTime&q;:1752033600000,&q;teacher&q;:{&q;id&q;:34155,&q;userId&q;:71560696,&q;name&q;:&q;巩梦&q;,&q;brief&q;:&q;粉笔优质讲师&q;,&q;desc&q;:&q;粉笔优质教师\n5年一线教学授课经验，具有综应科目丰富的实践经验及系统扎实的专业理论知识。\n多次参加粉笔教研活动，分享授课经验心得，助力粉笔理论研发升级。\n具有耐心细致的授课风格，让学生在轻松的学习氛围中，用更简单的方法，找到更快捷的解题之道，深受广大学员的认可和好评，在学员中具有非常好的口碑，是值得信赖的好导师。&q;,&q;avatar&q;:&q;178a5fe93da6095.jpg&q;,&q;upperBodyPhoto&q;:null,&q;displayCoursePrefix&q;:&q;sydw&q;,&q;teacherStat&q;:{&q;teacherId&q;:34155,&q;episodeCount&q;:400,&q;scoreCount&q;:523,&q;avgScore&q;:9.789674952198864,&q;fiveGradeAvgScore&q;:4.89,&q;updateTime&q;:1773022083070},&q;auditionEpisode&q;:{&q;episodeTitle&q;:&q;个人展示课&q;,&q;episodeVideoUrl&q;:&q;https://vod.fbstatic.cn/22e9ceb2vodbj1251001446/a24a99a55145403709334290849/y0iTp4HJ8GkA.mp4?t=f2a4b300&a;us=4070880000&a;sign=aa5d046c3225db7891d3c4c81f7b7542&q;},&q;memberOfCPC&q;:false,&q;tags&q;:null},&q;teachChannel&q;:1,&q;offline&q;:null,&q;duration&q;:7923,&q;hasAudition&q;:false,&q;bizType&q;:0,&q;bizId&q;:&q;726825&q;,&q;supportReplay&q;:true,&q;extraInfo&q;:null,&q;liveConfig&q;:{&q;episodeId&q;:10844632,&q;supportMultiGroup&q;:false,&q;exerciseBizType&q;:0,&q;videoDisplayType&q;:0,&q;avForwardType&q;:0,&q;useIntelligentRoom&q;:false,&q;hasStrokeKeynote&q;:true,&q;verticalModeType&q;:0,&q;originEpisodeId&q;:0,&q;supportRtmp&q;:false,&q;supportPk&q;:true,&q;supportLuckyBag&q;:true,&q;supportUserNoteStroke&q;:false,&q;communicateType&q;:0,&q;one2One&q;:false,&q;fakeLive&q;:false},&q;validStatus&q;:1,&q;supportLive&q;:true,&q;supportAiCatalog&q;:false,&q;hasIntelligentPen&q;:false,&q;useLocalRecording&q;:false,&q;useIntelligentRoom&q;:false,&q;hasSalePosition&q;:false,&q;hasEpisodeCards&q;:true,&q;lockedForShouna&q;:false,&q;needSignIn&q;:false,&q;needTeacherSignIn&q;:false,&q;enablePadPencil&q;:true,&q;displayExercise&q;:false,&q;supportLuckyBag&q;:true,&q;supportLivePk&q;:true},{&q;id&q;:10844650,&q;kePrefix&q;:&q;sydw&q;,&q;courseId&q;:6,&q;status&q;:3,&q;playStatus&q;:3,&q;type&q;:33,&q;recordingType&q;:0,&q;mediaType&q;:0,&q;title&q;:&q;【公基非法】精选好题 沉浸刷题&q;,&q;innerTitle&q;:&q;&q;,&q;startTime&q;:1752040800000,&q;endTime&q;:1752048000000,&q;teacher&q;:{&q;id&q;:34196,&q;userId&q;:83885051,&q;name&q;:&q;马莹萍&q;,&q;brief&q;:&q;粉笔优质讲师&q;,&q;desc&q;:&q;粉笔常识公基优质教师\n6年授课经验，授课实战经验丰富。累计授课时长900+，授课人次2500+，授课评分4.9分，深受学员喜爱。长期扎根于常识公基非法及判断教学教研工作，曾撰写教研文章十余篇，撰写多地政府工作报告解读文件，参与全国常识公基非法密卷课件及讲义制作。授课班级中，公基成绩均有明显提升，历年考试中，均有多名学员取得80+的好成绩。授课风格幽默风趣，贴近实际，能够通过学员特点进行个性化指导，帮助学员突破瓶颈，一举成“公”。&q;,&q;avatar&q;:&q;198412a1819fc20.jpg&q;,&q;upperBodyPhoto&q;:null,&q;displayCoursePrefix&q;:&q;sydw&q;,&q;teacherStat&q;:{&q;teacherId&q;:34196,&q;episodeCount&q;:833,&q;scoreCount&q;:1519,&q;avgScore&q;:9.81566820276498,&q;fiveGradeAvgScore&q;:4.91,&q;updateTime&q;:1773561169054},&q;auditionEpisode&q;:{&q;episodeTitle&q;:&q;个人展示课&q;,&q;episodeVideoUrl&q;:&q;https://vod.fbstatic.cn/22e9ceb2vodbj1251001446/72db76805145403709544091356/dk0lqGQPopcA.mp4?t=f2a4b300&a;us=4070880000&a;sign=c98ccaef848337ae40404519654c80f6&q;},&q;memberOfCPC&q;:false,&q;tags&q;:null},&q;teachChannel&q;:1,&q;offline&q;:null,&q;duration&q;:6876,&q;hasAudition&q;:false,&q;bizType&q;:0,&q;bizId&q;:&q;726825&q;,&q;supportReplay&q;:true,&q;extraInfo&q;:null,&q;liveConfig&q;:{&q;episodeId&q;:10844650,&q;supportMultiGroup&q;:false,&q;exerciseBizType&q;:0,&q;videoDisplayType&q;:0,&q;avForwardType&q;:0,&q;useIntelligentRoom&q;:false,&q;hasStrokeKeynote&q;:true,&q;verticalModeType&q;:0,&q;originEpisodeId&q;:0,&q;supportRtmp&q;:false,&q;supportPk&q;:true,&q;support