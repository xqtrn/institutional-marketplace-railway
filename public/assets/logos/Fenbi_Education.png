keKeynote&q;:true,&q;verticalModeType&q;:0,&q;originEpisodeId&q;:0,&q;supportRtmp&q;:false,&q;supportPk&q;:false,&q;supportLuckyBag&q;:false,&q;supportUserNoteStroke&q;:false,&q;communicateType&q;:0,&q;one2One&q;:false,&q;fakeLive&q;:false},&q;validStatus&q;:1,&q;supportLive&q;:true,&q;supportAiCatalog&q;:true,&q;hasIntelligentPen&q;:false,&q;useLocalRecording&q;:false,&q;useIntelligentRoom&q;:false,&q;hasSalePosition&q;:false,&q;hasEpisodeCards&q;:false,&q;lockedForShouna&q;:false,&q;needSignIn&q;:false,&q;needTeacherSignIn&q;:false,&q;enablePadPencil&q;:true,&q;displayExercise&q;:false,&q;supportLuckyBag&q;:false,&q;supportLivePk&q;:false},{&q;id&q;:11397983,&q;kePrefix&q;:&q;gwy&q;,&q;courseId&q;:1,&q;status&q;:3,&q;playStatus&q;:3,&q;type&q;:1,&q;recordingType&q;:0,&q;mediaType&q;:0,&q;title&q;:&q;言语赛后复盘-26上半年省考第3季通用卷&q;,&q;innerTitle&q;:&q;&q;,&q;startTime&q;:1766288400000,&q;endTime&q;:1766292000000,&q;teacher&q;:{&q;id&q;:4996,&q;userId&q;:51581932,&q;name&q;:&q;司琦&q;,&q;brief&q;:&q;粉笔言语优质教师&q;,&q;desc&q;:&q;粉笔言语优质教师，8年授课经验，长期深耕公务员行测言语模块，精准把握命题趋势，对各类题型有着独到的见解，曾负责师资培训、模拟题撰写和教材编写等工作。教学中，注重因材施教，助力学员夯实基础、提升能力。授课风格幽默且严谨，讲解深入浅出，让复杂的知识变得通俗易懂，深受学员好评。&q;,&q;avatar&q;:&q;19270dc6dfb73cb.jpg&q;,&q;upperBodyPhoto&q;:null,&q;displayCoursePrefix&q;:&q;gwy&q;,&q;teacherStat&q;:{&q;teacherId&q;:4996,&q;episodeCount&q;:1396,&q;scoreCount&q;:216731,&q;avgScore&q;:9.871767306015292,&q;fiveGradeAvgScore&q;:4.94,&q;updateTime&q;:1773594524697},&q;auditionEpisode&q;:{&q;episodeTitle&q;:&q;个人展示课&q;,&q;episodeVideoUrl&q;:&q;https://vod.fbstatic.cn/22e9ceb2vodbj1251001446/9cc6e9f83560136621447402832/oxLbyW9tbc4A.mp4?t=f2a4b300&a;us=4070880000&a;sign=742574c1fe64d1e966a0d28dfe74cc08&q;},&q;memberOfCPC&q;:false,&q;tags&q;:null},&q;teachChannel&q;:1,&q;offline&q;:null,&q;duration&q;:5376,&q;hasAudition&q;:false,&q;bizType&q;:0,&q;bizId&q;:&q;710082&q;,&q;supportReplay&q;:true,&q;extraInfo&q;:null,&q;liveConfig&q;:{&q;episodeId&q;:11397983,&q;supportMultiGroup&q;:false,&q;exerciseBizType&q;:0,&q;videoDisplayType&q;:0,&q;avForwardType&q;:0,&q;useIntelligentRoom&q;:false,&q;hasStrokeKeynote&q;:true,&q;verticalModeType&q;:0,&q;originEpisodeId&q;:0,&q;supportRtmp&q;:false,&q;supportPk&q;:false,&q;supportLuckyBag&q;:false,&q;supportUserNoteStroke&q;:false,&q;communicateType&q;:0,&q;one2One&q;:false,&q;fakeLive&q;:false},&q;validStatus&q;:1,&q;supportLive&q;:true,&q;supportAiCatalog&q;:true,&q;hasIntelligentPen&q;:false,&q;useLocalRecording&q;:false,&q;useIntelligentRoom&q;:false,&q;hasSalePosition&q;:false,&q;hasEpisodeCards&q;:false,&q;lockedForShouna&q;:false,&q;needSignIn&q;:false,&q;needTeacherSignIn&q;:false,&q;enablePadPencil&q;:true,&q;displayExercise&q;:false,&q;supportLuckyBag&q;:false,&q;supportLivePk&q;:false},{&q;id&q;:11397984,&q;kePrefix&q;:&q;gwy&q;,&q;courseId&q;:1,&q;status&q;:3,&q;playStatus&q;:3,&q;type&q;:1,&q;recordingType&q;:0,&q;mediaType&q;:0,&q;title&q;:&q;数资赛后复盘-26上半年省考第3季通用卷&q;,&q;innerTitle&q;:&q;&q;,&q;startTime&q;:1766288400000,&q;endTime&q;:1766292000000,&q;teacher&q;:{&q;id&q;:13294,&q;userId&q;:40308934,&q;name&q;:&q;陶昶安&q;,&q;brief&q;:&q;粉笔数资优质教师&q;,&q;desc&q;:&q;粉笔数资优质教师，数量经济学研究生毕业。 \n17年公考从业经验，长期钻研公考数量资料模块的命题规律，独立研发并推广多个解题技巧，广受业内好评。 \n授课逻辑清晰、内容全面、认真负责，风格严谨又不失幽默，善于从学员角度出发，帮助学员更好地提升，被学员亲切地称为“考场安老师”。累计授课时长超过20000小时，学员评分达4.9分。 \n从业期间，累计培训师资千余名、编写图书十余部。&q;,&q;avatar&q;:&q;196ec5345e4963e.jpg&q;,&q;upperBodyPhoto&q;:null,&q;displayCoursePrefix&q;:&q;gwy&q;,&q;teacherStat&q;:{&q;teacherId&q;:13294,&q;episodeCount&q;:1047,&q;scoreCount&q;:330982,&q;avgScore&q;:9.880688375803002,&q;fiveGradeAvgScore&q;:4.94,&q;updateTime&q;:1773611809271},&q;auditionEpisode&q;:{&q;episodeTitle&q;:&q;个人展示课&q;,&q;episodeVideoUrl&q;:&q;https://vod.fbstatic.cn/22e9ceb2vodbj1251001446/a870b9223560136621447902918/Pv3XToPc45IA.mp4?t=f2a4b300&a;us=4070880000&a;sign=019c0f384ba6716d5ce30a3dec8fe39d&q;},&q;memberOfCPC&q;:false,&q;tags&q;:null},&q;teachChannel&q;:1,&q;offline&q;:null,&q;duration&q;:6160,&q;hasAudition&q;:false,&q;bizType&q;:0,&q;bizId&q;:&q;710082&q;,&q;supportReplay&q;:true,&q;extraInfo&q;:null,&q;liveConfig&q;:{&q;episodeId&q;:11397984,&q;supportMultiGroup&q;:false,&q;exerciseBizType&q;:0,&q;videoDisplayType&q;:0,&q;avForwardType&q;:0,&q;useIntelligentRoom&q;:false,&q;hasStrokeKeynote&q;:true,&q;verticalModeType&q;:0,&q;originEpisodeId&q;:0,&q;supportRtmp&q;:false,&q;supportPk&q;:false,&q;supportLuckyBag&q;:false,&q;supportUserNoteStroke&q;:false,&q;communicateType&q;:0,&q;one2One&q;:false,&q;fakeLive&q;:false},&q;validStatus&q;:1,&q;supportLive&q;:true,&q;supportAiCatalog&q;:true,&q;hasIntelligentPen&q;:false,&q;useLocalRecording&q;:false,&q;useIntelligentRoom&q;:false,&q;hasSalePosition&q;:false,&q;hasEpisodeCards&q;:false,&q;lockedForShouna&q;:false,&q;needSignIn&q;:false,&q;needTeacherSignIn&q;:false,&q;enablePadPencil&q;:true,&q;displayExercise&q;:false,&q;supportLuckyBag&q;:false,&q;supportLivePk&q;:false},{&q;id&q;:11397985,&q;kePrefix&q;:&q;gwy&q;,&q;courseId&q;:1,&q;status&q;:3,&q;playStatus&q;:3,&q;type&q;:1,&q;recordingType&q;:0,&q;mediaType&q;:0,&q;title&q;:&q;判断赛后复盘-26上半年省考第3季通用卷&q;,&q;innerTitle&q;:&q;&q;,&q;startTime&q;:1766288400000,&q;endTime&q;:1766292000000,&q;teacher&q;:{&q;id&q;:21356,&q;userId&q;:74166806,&q;name&q;:&q;李陈&q;,&q;brief&q;:&q;粉笔判断优质教师&q;,&q;desc&q;:&q;粉笔判断优质教师，纽约大学理学硕士。 \n国考部委高分考生，5年公考授课经验，累积授课时长超2000小时。 \n作为判断教研组成员，每年参与系统班、精品班课程设计，图书更新，AI测试等工作，理论功底扎实，授课逻辑清晰，善于归纳总结，深受学生喜爱。&q;,&q;avatar&q;:&q;179f4e980a2a9c2.jpg&q;,&q;upperBodyPhoto&q;:null,&q;displayCoursePrefix&q;:&q;gwy&q;,&q;teacherStat&q;:{&q;teacherId&q;:21356,&q;episodeCount&q;:630,&q;scoreCount&q;:58216,&q;avgScore&q;:9.906589253813385,&q;fiveGradeAvgScore&q;:4.95,&q;updateTime&q;:1773591681002},&q;auditionEpisode&q;:{&q;episodeTitle&q;:&q;个人展示课&q;,&q;episodeVideoUrl&q;:&q;https://vod.fbstatic.cn/22e9ceb2vodbj1251001446/93a914d83560136621447033634/KARgUYgs6AEA.mp4?t=f2a4b300&a;us=4070880000&a;sign=0b98f8bdbbcb817fcb78cbd713914cc1&q;},&q;memberOfCPC&q;:false,&q;tags&q;:null},&q;teachChannel&q;:1,&q;offline&q;:null,&q;duration&q;:7202,&q;hasAudition&q;:false,&q;bizType&q;:0,&q;bizId&q;:&q;710082&q;,&q;supportReplay&q;:true,&q;extraInfo&q;:null,&q;liveConfig&q;:{&q;episodeId&q;:11397985,&q;supportMultiGroup&q;:false,&q;exerciseBizType&q;:0,&q;videoDisplayType&q;:0,&q;avForwardType&q;:0,&q;useIntelligentRoom&q;:false,&q;hasStrokeKeynote&q;:true,&q;verticalModeType&q;:0,&q;originEpisodeId&q;:0,&q;supportRtmp&q;:false,&q;supportPk&q;:false,&q;supportLuckyBag&q;:false,&q;supportUserNoteStroke&q;:false,&q;communicateType&q;:0,&q;one2One&q;:false,&q;fakeLive&q;:false},&q;validStatus&q;:1,&q;supportLive&q;:true,&q;supportAiCatalog&q;:true,&q;hasIntelligentPen&q;:false,&q;useLocalRecording&q;:false,&q;useIntelligentRoom&q;:false,&q;hasSalePosition&q;:false,&q;hasEpisodeCards&q;:false,&q;lockedForShouna&q;:false,&q;needSignIn&q;:false,&q;needTeacherSignIn&q;:false,&q;enablePadPencil&q;:true,&q;displayExercise&q;:false,&q;supportLuckyBag&q;:false,&q;supportLivePk&q;:false},{&q;id&q;:11427654,&q;kePrefix&q;:&q;gwy&q;,&q;courseId&q;:1,&q;status&q;:3,&q;playStatus&q;:3,&q;type&q;:1,&q;recordingType&q;:0,&q;mediaType&q;:0,&q;title&q;:&q;言语赛后复盘-26上半年省考第4季通用卷&q;,&q;innerTitle&q;:&q;&q;,&q;startTime&q;:1766893200000,&q;endTime&q;:1766896800000,&q;teacher&q;:{&q;id&q;:115,&q;userId&q;:2865735,&q;name&q;:&q;赵晓曦&q;,&q;brief&q;:&q;粉笔言语优质教师&q;,&q;desc&q;:&q;粉笔言语优质教师，211大学文科类博士 \n15年公考授课经验，打分人次超25万，学员评分高达4.9分。 \n长期从事言语理解与表达的授课和教研工作，功底扎实，耐心负责。对于言语题目、教学思路、授课模式有非常深入的研究和理解，并在教学实践中充分贯彻和体现。授课思路清晰严谨，讲解细致入微，条理清楚，是“极高明而道中庸”的典范。 \n粉笔公考笔试教研教学总负责人，组织各类授课研讨会议和教研活动，带领教研师资团队制作《行测5000题》《申论100题》《极致模考卷》《模考80分》等优质图书，深受学员认可。&q;,&q;avatar&q;:&q;18bd5fee4a345fe.jpg&q;,&q;upperBodyPhoto&q;:null,&q;displayCoursePrefix&q;:&q;gwy&q;,&q;teacherStat&q;:{&q;teacherId&q;:115,&q;episodeCount&q;:751,&q;scoreCount&q;:322342,&q;avgScore&q;:9.824323234328757,&q;fiveGradeAvgScore&q;:4.91,&q;updateTime&q;:1773622147298},&q;auditionEpisode&q;:null,&q;memberOfCPC&q;:false,&q;tags&q;:null},&q;teachChannel&q;:1,&q;offline&q;:null,