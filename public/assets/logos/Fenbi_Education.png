://vod.fbstatic.cn/22e9ceb2vodbj1251001446/255ce6741397757892492058531/DM2ZCzPVvG0A.mp4?t=f2a4b300&a;us=4070880000&a;sign=92bc17de4aaa1524e2e3d34ea7439d42&q;},&q;memberOfCPC&q;:false,&q;tags&q;:null},&q;teachChannel&q;:1,&q;offline&q;:null,&q;duration&q;:9344,&q;hasAudition&q;:false,&q;bizType&q;:0,&q;bizId&q;:&q;710082&q;,&q;supportReplay&q;:true,&q;extraInfo&q;:null,&q;liveConfig&q;:{&q;episodeId&q;:11458457,&q;supportMultiGroup&q;:false,&q;exerciseBizType&q;:0,&q;videoDisplayType&q;:0,&q;avForwardType&q;:0,&q;useIntelligentRoom&q;:false,&q;hasStrokeKeynote&q;:true,&q;verticalModeType&q;:0,&q;originEpisodeId&q;:0,&q;supportRtmp&q;:false,&q;supportPk&q;:false,&q;supportLuckyBag&q;:false,&q;supportUserNoteStroke&q;:false,&q;communicateType&q;:0,&q;one2One&q;:false,&q;fakeLive&q;:false},&q;validStatus&q;:1,&q;supportLive&q;:true,&q;supportAiCatalog&q;:true,&q;hasIntelligentPen&q;:false,&q;useLocalRecording&q;:false,&q;useIntelligentRoom&q;:false,&q;hasSalePosition&q;:false,&q;hasEpisodeCards&q;:false,&q;lockedForShouna&q;:false,&q;needSignIn&q;:false,&q;needTeacherSignIn&q;:false,&q;enablePadPencil&q;:true,&q;displayExercise&q;:false,&q;supportLuckyBag&q;:false,&q;supportLivePk&q;:false},{&q;id&q;:11360216,&q;kePrefix&q;:&q;gwy&q;,&q;courseId&q;:1,&q;status&q;:3,&q;playStatus&q;:3,&q;type&q;:1,&q;recordingType&q;:0,&q;mediaType&q;:0,&q;title&q;:&q;言语-【2026上半年省考第4季】行测模考大赛&q;,&q;innerTitle&q;:&q;&q;,&q;startTime&q;:1766919600000,&q;endTime&q;:1766930400000,&q;teacher&q;:{&q;id&q;:4999,&q;userId&q;:42647440,&q;name&q;:&q;高昕&q;,&q;brief&q;:&q;粉笔言语优质教师&q;,&q;desc&q;:&q;粉笔言语优质教师\n8年+公考授课经验，累计授课时长超10000小时，学员总评分高达4.9分。长期致力于言语科目的一线教学工作，熟悉各类公职考试（包括国考、各省省考、事业单位、军队文职等）的言语考情、考点及命题特色，授课涵盖线上线下全阶段班型，包括基础精讲、强化刷题、冲刺点睛等。曾负责并长期参与言语真题解析、模拟题命制、师资培训等教研工作。授课风格亲切自然，讲解深入浅出，课堂气氛活跃，既能帮助学员构建完整知识体系，又能精准传授实用解题技巧，教学耐心细致、认真负责，深受广大学员的信赖与好评。&q;,&q;avatar&q;:&q;1927b035d94fb81.jpg&q;,&q;upperBodyPhoto&q;:null,&q;displayCoursePrefix&q;:&q;gwy&q;,&q;teacherStat&q;:{&q;teacherId&q;:4999,&q;episodeCount&q;