:&q;粉笔判断优质教师。\n7年授课经验，累计授课时长6000+，授课评分4.9+，培训学员100余万人次。有着多年丰富的国考及省考授课经验，逻辑框架清晰。授课风格深入浅出，结构严谨又不乏幽默；授课内容直指考试核心。教学方式多样，因材施教，掌握学生心理，深受学员欢迎。\n参与制作国省考授课讲义、《行测的思维》、《决战行测5000题》等多套图书。&q;,&q;avatar&q;:&q;1928e11bb6d26f0.jpg&q;,&q;upperBodyPhoto&q;:null,&q;displayCoursePrefix&q;:&q;gwy&q;,&q;teacherStat&q;:{&q;teacherId&q;:7754,&q;episodeCount&q;:1301,&q;scoreCount&q;:243516,&q;avgScore&q;:9.87308431478835,&q;fiveGradeAvgScore&q;:4.94,&q;updateTime&q;:1773620855135},&q;auditionEpisode&q;:{&q;episodeTitle&q;:&q;个人展示课&q;,&q;episodeVideoUrl&q;:&q;https://vod.fbstatic.cn/22e9ceb2vodbj1251001446/4bb38a333560136621446283020/WcYGrU72AukA.mp4?t=f2a4b300&a;us=4070880000&a;sign=0634969fb328a1e47afdf3e0332c5544&q;},&q;memberOfCPC&q;:false,&q;tags&q;:null},&q;teachChannel&q;:1,&q;offline&q;:null,&q;duration&q;:11232,&q;hasAudition&q;:false,&q;bizType&q;:0,&q;bizId&q;:&q;710082&q;,&q;supportReplay&q;:true,&q;extraInfo&q;:null,&q;liveConfig&q;:{&q;episodeId&q;:11023966,&q;supportMultiGroup&q;:false,&q;exerciseBizType&q;:0,&q;videoDisplayType&q;:0,&q;avForwardType&q;:0,&q;useIntelligentRoom&q;:false,&q;hasStrokeKeynote&q;:true,&q;verticalModeType&q;:0,&q;originEpisodeId&q;:0,&q;supportRtmp&q;:false,&q;supportPk&q;:false,&q;supportLuckyBag&q;:false,&q;supportUserNoteStroke&q;:false,&q;communicateType&q;:0,&q;one2One&q;:false,&q;fakeLive&q;:false},&q;validStatus&q;:1,&q;supportLive&q;:true,&q;supportAiCatalog&q;:true,&q;hasIntelligentPen&q;:false,&q;useLocalRecording&q;:false,&q;useIntelligentRoom&q;:false,&q;hasSalePosition&q;:false,&q;hasEpisodeCards&q;:false,&q;lockedForShouna&q;:false,&q;needSignIn&q;:false,&q;needTeacherSignIn&q;:false,&q;enablePadPencil&q;:true,&q;displayExercise&q;:false,&q;supportLuckyBag&q;:false,&q;supportLivePk&q;:false},{&q;id&q;:11023967,&q;kePrefix&q;:&q;gwy&q;,&q;courseId&q;:1,&q;status&q;:3,&q;playStatus&q;:3,&q;type&q;:1,&q;recordingType&q;:0,&q;mediaType&q;:0,&q;title&q;:&q;数资-【2026国考第36季&a;2025下半年省考第28季】行测模考大赛&q;,&q;innerTitle&q;:&q;&q;,&q;startTime&q;:17589