false,&q;supportPk&q;:true,&q;supportLuckyBag&q;:true,&q;supportUserNoteStroke&q;:false,&q;communicateType&q;:0,&q;one2One&q;:false,&q;fakeLive&q;:false},&q;validStatus&q;:1,&q;supportLive&q;:true,&q;supportAiCatalog&q;:false,&q;hasIntelligentPen&q;:false,&q;useLocalRecording&q;:false,&q;useIntelligentRoom&q;:false,&q;hasSalePosition&q;:false,&q;hasEpisodeCards&q;:true,&q;lockedForShouna&q;:false,&q;needSignIn&q;:false,&q;needTeacherSignIn&q;:false,&q;enablePadPencil&q;:true,&q;displayExercise&q;:false,&q;supportLuckyBag&q;:true,&q;supportLivePk&q;:true},{&q;id&q;:10771540,&q;kePrefix&q;:&q;sydw&q;,&q;courseId&q;:6,&q;status&q;:3,&q;playStatus&q;:3,&q;type&q;:33,&q;recordingType&q;:0,&q;mediaType&q;:0,&q;title&q;:&q;【公基非法】精选好题 沉浸刷题&q;,&q;innerTitle&q;:&q;&q;,&q;startTime&q;:1749110400000,&q;endTime&q;:1749117600000,&q;teacher&q;:{&q;id&q;:34151,&q;userId&q;:83887928,&q;name&q;:&q;颜瑞&q;,&q;brief&q;:&q;粉笔优质讲师&q;,&q;desc&q;:&q;粉笔优质讲师\n5年一线教学经验，教学教研经验丰富。授课思路开阔，善于举一反三，引导和启发学生；课堂互动性强，善于从学员角度出发解决问题；授课风格循循善诱，细致耐心，寓教于乐给予个性化帮助，授课产品类型丰富，评分高达4.9，深受学生喜爱。\n教研上，常识公基科目实践经验及专业理论知识扎实丰富，对常识公基非法考情把握恰当，并负责多科目单题录制工作，并且多次参与命制笔试真题教研、解析以及教研文章撰写工作，致力于深入探究常识公基的命题规律及拿分技巧。&q;,&q;avatar&q;:&q;193af63981634c3.jpg&q;,&q;upperBodyPhoto&q;:null,&q;displayCoursePrefix&q;:&q;sydw&q;,&q;teacherStat&q;:{&q;teacherId&q;:34151,&q;episodeCount&q;:764,&q;scoreCount&q;:928,&q;avgScore&q;:9.73275862068965,&q;fiveGradeAvgScore&q;:4.87,&q;updateTime&q;:1773579803077},&q;auditionEpisode&q;:{&q;episodeTitle&q;:&q;个人展示课&q;,&q;episodeVideoUrl&q;:&q;https://vod.fbstatic.cn/22e9ceb2vodbj1251001446/852adeed5145403709544842797/4NI3eZVTCIgA.mp4?t=f2a4b300&a;us=4070880000&a;sign=8b0451bae7287a818ba1ca53e0d1a8cd&q;},&q;memberOfCPC&q;:false,&q;tags&q;:null},&q;teachChannel&q;:1,&q;offline&q;:null,&q;duration&q;:6759,&q;hasAudition&q;:false,&q;bizType&q;:0,&q;bizId&q;:&q;726825&q;,&q;supportReplay&q;:true,&q;extraInfo&q;:null,&q;liveConfig&q;:{&q;episodeId&q;:10771540,&q;supportMultiGroup&q;:false,&q;exerciseBizType&q;:0,&q;videoDisplayType&q;:0,&q;avForwardType&q;:0,&q;useIntelligentRoom&q;:false,&q;hasStrokeKeynote&q;:true,&q;verticalModeType&q;:0,&q;originEpisodeId&q;:0,&q;supportRtmp&q;:false,&q;supportPk&q;:true,&q;supportLuckyBag&q;:true,&q;supportUserNoteStroke&q;:false,&q;communicateType&q;:0,&q;one2One&q;:false,&q;fakeLive&q;:false},&q;validStatus&q;:1,&q;supportLive&q;:true,&q;supportAiCatalog&q;:false,&q;hasIntelligentPen&q;:false,&q;useLocalRecording&q;:false,&q;useIntelligentRoom&q;:false,&q;hasSalePosition&q;:false,&q;hasEpisodeCards&q;:true,&q;lockedForShouna&q;:false,&q;needSignIn&q;:false,&q;needTeacherSignIn&q;:false,&q;enablePadPencil&q;:true,&q;displayExercise&q;:false,&q;supportLuckyBag&q;:true,&q;supportLivePk&q;:true},{&q;id&q;:10774762,&q;kePrefix&q;:&q;sydw&q;,&q;courseId&q;:6,&q;status&q;:3,&q;playStatus&q;:3,&q;type&q;:33,&q;recordingType&q;:0,&q;mediaType&q;:0,&q;title&q;:&q;【数资】精选好题 沉浸刷题&q;,&q;innerTitle&q;:&q;&q;,&q;startTime&q;:1749175200000,&q;endTime&q;:1749182400000,&q;teacher&q;:{&q;id&q;:61431,&q;userId&q;:97072356,&q;name&q;:&q;陈伶&q;,&q;brief&q;:&q;粉笔优质讲师&q;,&q;desc&q;:&q;粉笔优质教师\n长期从事公考一线教学，具有数资科目丰富的实践经验及系统扎实的专业理论知识，参与笔试教研，对数资方向有深入研究；撰写多篇事业单位笔试教研材料，多次参加粉笔教研活动，分享授课经验心得，助力粉笔理论研发升级，累计获得事业编、军队文职学员好评，具有深入浅出的授课风格，让学生在轻松的学习氛围中，用更简单的方法，找到更快捷的解题之道，是值得信赖的好导师。&q;,&q;avatar&q;:&q;193b462a6079080.jpg&q;,&q;upperBodyPhoto&q;:null,&q;displayCoursePrefix&q;:&q;sydw&q;,&q;teacherStat&q;:{&q;teacherId&q;:61431,&q;episodeCount&q;:256,&q;scoreCount&q;:763,&q;avgScore&q;:9.753604193971162,&q;fiveGradeAvgScore&q;:4.88,&q;updateTime&q;:1773491076279},&q;auditionEpisode&q;:{&q;episodeTitle&q;:&q;个人展示课&q;,&q;episodeVideoUrl&q;:&q;https://vod.fbstatic.cn/22e9ceb2vodbj1251001446/92ef045f5145403709541396620/ShNRjQwtmN8A.mp4?t=f2a4b300&a;us=4070880000&a;sign=994c2b763453aa36eee2dbbf67be1373&q;},&q;memberOfCPC&q;:false,&q;tags&q;:null},&q;teachChannel&q;:1,&q;offline&q;:null,&q;duration&q;:7238,&q;hasAudition&q;:false,&q;bizType&q;:0,&q;bizId&q;:&q;726825&q;,&q;supportReplay&q;:true,&q;extraInfo&q;:null,&q;liveConfig&q;:{&q;episodeId&q;:10774762,&q;supportMultiGroup&q;:false,&q;exerciseBizType&q;:0,&q;videoDisplayType&q;:0,&q;avForwardType&q;:0,&q;useIntelligentRoom&q;:false,&q;hasStrokeKeynote&q;:true,&q;verticalModeType&q;:0,&q;originEpisodeId&q;:0,&q;supportRtmp&q;:false,&q;supportPk&q;:true,&q;supportLuckyBag&q;:true,&q;supportUserNoteStroke&q;:false,&q;communicateType&q;:0,&q;one2One&q;:false,&q;fakeLive&q;:false},&q;validStatus&q;:1,&q;supportLive&q;:true,&q;supportAiCatalog&q;:false,&q;hasIntelligentPen&q;:false,&q;useLocalRecording&q;:false,&q;useIntelligentRoom&q;:false,&q;hasSalePosition&q;:false,&q;hasEpisodeCards&q;:true,&q;lockedForShouna&q;:false,&q;needSignIn&q;:false,&q;needTeacherSignIn&q;:false,&q;enablePadPencil&q;:true,&q;displayExercise&q;:false,&q;supportLuckyBag&q;:true,&q;supportLivePk&q;:true},{&q;id&q;:10774763,&q;kePrefix&q;:&q;sydw&q;,&q;courseId&q;:6,&q;status&q;:3,&q;playStatus&q;:3,&q;type&q;:33,&q;recordingType&q;:0,&q;mediaType&q;:0,&q;title&q;:&q;【判断】精选好题 沉浸刷题&q;,&q;innerTitle&q;:&q;&q;,&q;startTime&q;:1749182400000,&q;endTime&q;:1749189600000,&q;teacher&q;:{&q;id&q;:16920,&q;userId&q;:60928347,&q;name&q;:&q;刘巍&q;,&q;brief&q;:&q;粉笔优质讲师&q;,&q;desc&q;:&q;粉笔优质讲师\n6年一线教学经验，授课与实战经验丰富； \n在判断科目教学中，参与过多次判断真题教研、多次参与模拟题撰写及审核工作，积累大量使用经验，专业理论知识扎实，对事业单位考试考情、真题等理解深刻\n累计授课1000+小时，授课累计评分4.9分，深受学员的喜爱与认可。\n授课逻辑清晰，讲解细致，通俗易懂，因材施教，为学员提供个性化帮助。讲课细致耐心，课堂氛围轻松活跃,能够帮助学员将所学理论更好应用在实际做题中。&q;,&q;avatar&q;:&q;1746cde0ef0f624.jpg&q;,&q;upperBodyPhoto&q;:null,&q;displayCoursePrefix&q;:&q;sydw&q;,&q;teacherStat&q;:{&q;teacherId&q;:16920,&q;episodeCount&q;:662,&q;scoreCount&q;:2601,&q;avgScore&q;:9.796232218377565,&q;fiveGradeAvgScore&q;:4.9,&q;updateTime&q;:1773622939246},&q;auditionEpisode&q;:{&q;episodeTitle&q;:&q;个人展示课&q;,&q;episodeVideoUrl&q;:&q;https://vod.fbstatic.cn/22e9ceb2vodbj1251001446/607279c25145403713946934153/vsAmh2ZkdSwA.mp4?t=f2a4b300&a;us=4070880000&a;sign=eb2972679a3f405d7a8df877bf6117ea&q;},&q;memberOfCPC&q;:false,&q;tags&q;:null},&q;teachChannel&q;:1,&q;offline&q;:null,&q;duration&q;:7117,&q;hasAudition&q;:false,&q;bizType&q;:0,&q;bizId&q;:&q;726825&q;,&q;supportReplay&q;:true,&q;extraInfo&q;:null,&q;liveConfig&q;:{&q;episodeId&q;:10774763,&q;supportMultiGroup&q;:false,&q;exerciseBizType&q;:0,&q;videoDisplayType&q;:0,&q;avForwardType&q;:0,&q;useIntelligentRoom&q;:false,&q;hasStrokeKeynote&q;:true,&q;verticalModeType&q;:0,&q;originEpisodeId&q;:0,&q;supportRtmp&q;:false,&q;supportPk&q;:true,&q;supportLuckyBag&q;:true,&q;supportUserNoteStroke&q;:false,&q;communicateType&q;:0,&q;one2One&q;:false,&q;fakeLive&q;:false},&q;validStatus&q;:1,&q;supportLive&q;:true,&q;supportAiCatalog&q;:false,&q;hasIntelligentPen&q;:false,&q;useLocalRecording&q;:false,&q;useIntelligentRoom&q;:false,&q;hasSalePosition&q;:false,&q;hasEpisodeCards&q;:true,&q;lockedForShouna&q;:false,&q;needSignIn&q;:false,&q;needTeacherSignIn&q;:false,&q;enablePadPencil&q;:true,&q;displayExercise&q;:false,&q;supportLuckyBag&q;:true,&q;supportLivePk&q;:true},{&q;id&q;:10774767,&q;kePrefix&q;:&q;sydw&q;,&q;courseId&q;:6,&q;status&q;:3,&q;playStatus&q;:3,&q;type&q;:33,&q;recordingType&q;:0,&q;mediaType&q;:0,&q;title&q;:&q;【言语】精选好题 沉浸刷题&q;,&q;innerTitle&q;:&q;&q;,&q;startTime&q;:1749189600000,&q;endTime&q;:1749196800000,&q;teacher&q;:{&q;id&q;:16575,&q;userId&q;:58269049,&q;name&q;:&q;王秀敏&q;,&q;brief&q;:&q;粉笔优质讲师&q;,&q;desc&q;:&q;粉笔优质教师\n211高校毕业，五年一线教学授课经验，专注于事业单位笔试领域，主讲线上精品班、线下刷题特训营等多种班型，教学积淀深厚。\n在言语科目上拥有坚实而系统的理论功底，对事业单位考试中言语题目的命题规律有着透彻的分析，多次参与真题解析和模拟试题撰写工作；积极参与授课教学研讨会，不断探索高效教学策略，针对学员痛点定制个性化学习方案，同时注重个人教学技能的持续精进。\n累计授课时长超过2000小时，平均评分达4.9分；授课风格条理清晰，生动活泼，能够引导学生循序渐进地掌握知识要点，构建起牢固的知识框架。始终将助力学员成功上岸为己任，无论是备考策略的指导还是心理调适的建议，都力求做到无微不至，深受学员喜爱。&q;,&q;avatar&q;:&q;17467f0d079109a.jpg&q;,&q;upperBodyPhoto&q;:null,&q;displayCoursePrefix&q;:&q;sydw&q;,&q;teacherStat&q;:{&q;teacherId&q;:16575,&q;episodeCount&q;:413,&q;scoreCount&q;:1597,&q;avgScore&q;:9.864746399499051,&q;fiveGradeAvgScore&q;:4.93,&q;updateTime&q;:1773571217222},&q;auditionEpiso