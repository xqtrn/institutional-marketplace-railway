true,&q;extraInfo&q;:null,&q;liveConfig&q;:{&q;episodeId&q;:11000524,&q;supportMultiGroup&q;:false,&q;exerciseBizType&q;:0,&q;videoDisplayType&q;:0,&q;avForwardType&q;:0,&q;useIntelligentRoom&q;:false,&q;hasStrokeKeynote&q;:true,&q;verticalModeType&q;:0,&q;originEpisodeId&q;:0,&q;supportRtmp&q;:false,&q;supportPk&q;:true,&q;supportLuckyBag&q;:true,&q;supportUserNoteStroke&q;:false,&q;communicateType&q;:0,&q;one2One&q;:false,&q;fakeLive&q;:false},&q;validStatus&q;:1,&q;supportLive&q;:true,&q;supportAiCatalog&q;:false,&q;hasIntelligentPen&q;:false,&q;useLocalRecording&q;:false,&q;useIntelligentRoom&q;:false,&q;hasSalePosition&q;:false,&q;hasEpisodeCards&q;:true,&q;lockedForShouna&q;:false,&q;needSignIn&q;:false,&q;needTeacherSignIn&q;:false,&q;enablePadPencil&q;:true,&q;displayExercise&q;:false,&q;supportLuckyBag&q;:true,&q;supportLivePk&q;:true},{&q;id&q;:11000525,&q;kePrefix&q;:&q;sydw&q;,&q;courseId&q;:6,&q;status&q;:3,&q;playStatus&q;:3,&q;type&q;:33,&q;recordingType&q;:0,&q;mediaType&q;:0,&q;title&q;:&q;【公基非法】精选好题 沉浸刷题&q;,&q;innerTitle&q;:&q;&q;,&q;startTime&q;:1757390400000,&q;endTime&q;:1757397600000,&q;teacher&q;:{&q;id&q;:32970,&q;userId&q;:83438578,&q;name&q;:&q;朱湘依&q;,&q;brief&q;:&q;粉笔优质讲师&q;,&q;desc&q;:&q;粉笔优质讲师\n毕业于双一流院校，6年一线教学经验，承担线上、线下多种班型课程，授课经验丰富。\n承担常识公基非法律部分与数资科目授课、教研与培训工作。撰写多篇笔试教研材料。\n上课风格条理清晰，逻辑性强，擅长理论与实际相结合，授课有方法与技巧，积极引导并激发学员学习热情和自主意识，深受学员喜爱与好评。&q;,&q;avatar&q;:&q;1965c4972230508.jpg&q;,&q;upperBodyPhoto&q;:null,&q;displayCoursePrefix&q;:&q;sydw&q;,&q;teacherStat&q;:{&q;teacherId&q;:32970,&q;episodeCount&q;:707,&q;scoreCount&q;:1045,&q;avgScore&q;:9.666985645933023,&q;fiveGradeAvgScore&q;:4.83,&q;updateTime&q;:1773622939242},&q;auditionEpisode&q;:{&q;episodeTitle&q;:&q;个人展示课&q;,&q;episodeVideoUrl&q;:&q;https://vod.fbstatic.cn/22e9ceb2vodbj1251001446/499072d75145403715606210097/s5aPkRTv9zwA.mp4?t=f2a4b300&a;us=4070880000&a;sign=e5a5a9ce7c1f73488eb51fc79567a0aa&q;},&q;memberOfCPC&q;:false,&q;tags&q;:null},&q;teachChannel&q;:1,&q;offline&q;:null,&q;duration&q;:7337,&q;hasAudition&q;:false,&q;bizType&q;:0,&q;bizId&q;:&q;726825&q;,&q;supportReplay&q;:true,&q;extraInfo&q;:null,&q;liveConfig&q;:{&q;episodeId&q;:11000525,&q;supportMultiGroup&q;:false,&q;exerciseBizType&q;:0,&q;videoDisplayType&q;:0,&q;avForwardType&q;:0,&q;useIntelligentRoom&q;:false,&q;hasStrokeKeynote&q;:true,&q;verticalModeType&q;:0,&q;originEpisodeId&q;:0,&q;supportRtmp&q;:false,&q;supportPk&q;:true,&q;supportLuckyBag&q;:true,&q;supportUserNoteStroke&q;:false,&q;communicateType&q;:0,&q;one2One&q;:false,&q;fakeLive&q;:false},&q;validStatus&q;:1,&q;supportLive&q;:true,&q;supportAiCatalog&q;:false,&q;hasIntelligentPen&q;:false,&q;useLocalRecording&q;:false,&q;useIntelligentRoom&q;:false,&q;hasSalePosition&q;:false,&q;hasEpisodeCards&q;:true,&q;lockedForShouna&q;:false,&q;needSignIn&q;:false,&q;needTeacherSignIn&q;:false,&q;enablePadPencil&q;:true,&q;displayExercise&q;:false,&q;supportLuckyBag&q;:true,&q;supportLivePk&q;:true},{&q;id&q;:11000537,&q;kePrefix&q;:&q;sydw&q;,&q;courseId&q;:6,&q;status&q;:3,&q;playStatus&q;:3,&q;type&q;:33,&q;recordingType&q;:0,&q;mediaType&q;:0,&q;title&q;:&q;【综应】精选好题 沉浸刷题&q;,&q;innerTitle&q;:&q;&q;,&q;startTime&q;:1757397600000,&q;endTime&q;:1757404800000,&q;teacher&q;:{&q;id&q;:26278,&q;userId&q;:61736380,&q;name&q;:&q;江丽贤&q;,&q;brief&q;:&q;粉笔优质讲师&q;,&q;desc&q;:&q;粉笔优质教师\n5年一线教学经验，深耕事业单位笔试考试，承担线上精品班、系统班等多种班型，具有综应科目丰富的实践经验及系统扎实的专业理论知识。\n不断更新知识，注重笔试理论知识丰富，多次参与笔试真题教研，对联考ABC以及非联考地区如山东、江苏等地区的命题有深入研究，时刻把握最新考情动态。\n累计带班人数超过2200人，学员整体评分维持在4.9左右，累计授课超900小时，授课评分高达4.9，授课思路清晰，课堂互动性佳，授课内容深入浅出，善于引导学生自主思考，发现学生问题给出针对性建议。&q;,&q;avatar&q;:&q;1983b170cb4f625.jpg&q;,&q;upperBodyPhoto&q;:null,&q;displayCoursePrefix&q;:&q;sydw&q;,&q;teacherStat&q;:{&q;teacherId&q;:26278,&q;episodeCount&q;:288,&q;scoreCount&q;:356,&q;avgScore&q;:9.870786516853938,&q;fiveGradeAvgScore&q;:4.94,&q;updateTime&q;:1773475358078},&q;auditionEpisode&q;:{&q;episodeTitle&q;:&q;个人展示课&q;,&q;episodeVideoUrl&q;:&q;https://vod.fbstatic.cn/22e9ceb2vodbj1251001446/2e926e765