vodbj1251001446/571009c11397757903436191001/71GyWjiNw7MA.mp4?t=f2a4b300&a;us=4070880000&a;sign=b59a7b96a095f92f99b475fb3660977b&q;},&q;memberOfCPC&q;:false,&q;tags&q;:null},&q;teachChannel&q;:1,&q;offline&q;:null,&q;duration&q;:8861,&q;hasAudition&q;:false,&q;bizType&q;:0,&q;bizId&q;:&q;726825&q;,&q;supportReplay&q;:true,&q;extraInfo&q;:null,&q;liveConfig&q;:{&q;episodeId&q;:10921330,&q;supportMultiGroup&q;:false,&q;exerciseBizType&q;:0,&q;videoDisplayType&q;:0,&q;avForwardType&q;:0,&q;useIntelligentRoom&q;:false,&q;hasStrokeKeynote&q;:true,&q;verticalModeType&q;:0,&q;originEpisodeId&q;:0,&q;supportRtmp&q;:false,&q;supportPk&q;:true,&q;supportLuckyBag&q;:true,&q;supportUserNoteStroke&q;:false,&q;communicateType&q;:0,&q;one2One&q;:false,&q;fakeLive&q;:false},&q;validStatus&q;:1,&q;supportLive&q;:true,&q;supportAiCatalog&q;:false,&q;hasIntelligentPen&q;:false,&q;useLocalRecording&q;:false,&q;useIntelligentRoom&q;:false,&q;hasSalePosition&q;:false,&q;hasEpisodeCards&q;:true,&q;lockedForShouna&q;:false,&q;needSignIn&q;:false,&q;needTeacherSignIn&q;:false,&q;enablePadPencil&q;:true,&q;displayExercise&q;:false,&q;supportLuckyBag&q;:true,&q;supportLivePk&q;:true},{&q;id&q;:10921331,&q;kePrefix&q;:&q;sydw&q;,&q;courseId&q;:6,&q;status&q;:3,&q;playStatus&q;:3,&q;type&q;:33,&q;recordingType&q;:0,&q;mediaType&q;:0,&q;title&q;:&q;【言语】精选好题 沉浸刷题&q;,&q;innerTitle&q;:&q;&q;,&q;startTime&q;:1754100000000,&q;endTime&q;:1754107200000,&q;teacher&q;:{&q;id&q;:14565,&q;userId&q;:48370970,&q;name&q;:&q;王清悦&q;,&q;brief&q;:&q;粉笔优质讲师&q;,&q;desc&q;:&q;粉笔优质讲师\n8年一线教学经验，教学风格严谨而不失活泼，善于将复杂的知识点以生动有趣的方式呈现，让学生轻松掌握。对于考试考点有着敏锐的洞察力和精准的把握能力，帮助学生有效备考，事半功倍。我坚信，教育不仅仅是知识的传授，更是思维的启迪与人格的塑造，因此，始终致力于培养学生的独立思考能力与解决问题的能力，助力他们在人生的每一个阶段都能自信前行。&q;,&q;avatar&q;:&q;173d720cea24b6c.jpg&q;,&q;upperBodyPhoto&q;:null,&q;displayCoursePrefix&q;:&q;sydw&q;,&q;teacherStat&q;:{&q;teacherId&q;:14565,&q;episodeCount&q;:477,&q;scoreCount&q;:1439,&q;avgScore&q;:9.745656706045871,&q;fiveGradeAvgScore&q;:4.87,&q;updateTime&q;:1773559873082},&q;auditionEpisode&q;:{&q;episodeTitle&q;:&q;个人展示课&q;,&q;episodeVideoUrl&q;:&q;https://vod.fbstatic.cn/22e9ceb2vodbj1251001446/cbd1293d5145403707742801437/WSGdVtt1L3AA.mp4?t=f2a4b300&a;us=4070880000&a;sign=a446564dcadd70a9b99e6d27e1f0ecde&q;},&q;memberOfCPC&q;:false,&q;tags&q;:null},&q;teachChannel&q;:1,&q;offline&q;:null,&q;duration&q;:7629,&q;hasAudition&q;:false,&q;bizType&q;:0,&q;bizId&q;:&q;726825&q;,&q;supportReplay&q;:true,&q;extraInfo&q;:null,&q;liveConfig&q;:{&q;episodeId&q;:10921331,&q;supportMultiGroup&q;:false,&q;exerciseBizType&q;:0,&q;videoDisplayType&q;:0,&q;avForwardType&q;:0,&q;useIntelligentRoom&q;:false,&q;hasStrokeKeynote&q;:true,&q;verticalModeType&q;:0,&q;originEpisodeId&q;:0,&q;supportRtmp&q;:false,&q;supportPk&q;:true,&q;supportLuckyBag&q;:true,&q;supportUserNoteStroke&q;:false,&q;communicateType&q;:0,&q;one2One&q;:false,&q;fakeLive&q;:false},&q;validStatus&q;:1,&q;supportLive&q;:true,&q;supportAiCatalog&q;:false,&q;hasIntelligentPen&q;:false,&q;useLocalRecording&q;:false,&q;useIntelligentRoom&q;:false,&q;hasSalePosition&q;:false,&q;hasEpisodeCards&q;:true,&q;lockedForShouna&q;:false,&q;needSignIn&q;:false,&q;needTeacherSignIn&q;:false,&q;enablePadPencil&q;:true,&q;displayExercise&q;:false,&q;supportLuckyBag&q;:true,&q;supportLivePk&q;:true},{&q;id&q;:10921443,&q;kePrefix&q;:&q;sydw&q;,&q;courseId&q;:6,&q;status&q;:3,&q;playStatus&q;:3,&q;type&q;:33,&q;recordingType&q;:0,&q;mediaType&q;:0,&q;title&q;:&q;【数资】精选好题 沉浸刷题&q;,&q;innerTitle&q;:&q;&q;,&q;startTime&q;:1754114400000,&q;endTime&q;:1754121600000,&q;teacher&q;:{&q;id&q;:34188,&q;userId&q;:83856586,&q;name&q;:&q;李宗菊&q;,&q;brief&q;:&q;粉笔优质讲师&q;,&q;desc&q;:&q;粉笔优质教师\n6年公考教学经验和多年培训教育经验，授课思路清晰，课堂氛围轻松，重难点突出 擅长引导，激发学员学习热情，学员好评度高。&q;,&q;avatar&q;:&q;178a630cbca5182.jpg&q;,&q;upperBodyPhoto&q;:null,&q;displayCoursePrefix&q;:&q;sydw&q;,&q;teacherStat&q;:{&q;teacherId&q;:34188,&q;episodeCount&q;:596,&q;scoreCount&q;:812,&q;avgScore&q;:9.679802955665014,&q;fiveGradeAvgScore&q;:4.84,&q;updateTime&q;:1773475247640},&q;auditionEpisode&q;:{&q;episodeTitle&q;:&q;个人展示课&q;,&q;episodeVideoUrl&q;:&q;https://vod.fbstatic.cn/22e9ceb2vodbj1251001446/53f4fa301253642695778393524/uGA8MEZ6dXgA.mp4?t=f2a4b300&a;us=4070880000&a;sign=53f612c946fe50fbc2fe02f9de9341e1&q;},&q;memberOfCPC&q;:false,&q;tags&q;:null},&q;teachChannel&q;:1,&q;offline&q;:null,&q;duration&q;:8775,&q;hasAudition&q;:false,&q;bizType&q;:0,&q;bizId&q;:&q;726825&q;,&q;supportReplay&q;:true,&q;extraInfo&q;:null,&q;liveConfig&q;:{&q;episodeId&q;:10921443,&q;supportMultiGroup&q;:false,&q;exerciseBizType&q;:0,&q;videoDisplayType&q;:0,&q;avForwardType&q;:0,&q;useIntelligentRoom&q;:false,&q;hasStrokeKeynote&q;:true,&q;verticalModeType&q;:0,&q;originEpisodeId&q;:0,&q;supportRtmp&q;:false,&q;supportPk&q;:true,&q;supportLuckyBag&q;:true,&q;supportUserNoteStroke&q;:false,&q;communicateType&q;:0,&q;one2One&q;:false,&q;fakeLive&q;:false},&q;validStatus&q;:1,&q;supportLive&q;:true,&q;supportAiCatalog&q;:false,&q;hasIntelligentPen&q;:false,&q;useLocalRecording&q;:false,&q;useIntelligentRoom&q;:false,&q;hasSalePosition&q;:false,&q;hasEpisodeCards&q;:true,&q;lockedForShouna&q;:false,&q;needSignIn&q;:false,&q;needTeacherSignIn&q;:false,&q;enablePadPencil&q;:true,&q;displayExercise&q;:false,&q;supportLuckyBag&q;:true,&q;supportLivePk&q;:true},{&q;id&q;:10921449,&q;kePrefix&q;:&q;sydw&q;,&q;courseId&q;:6,&q;status&q;:3,&q;playStatus&q;:3,&q;type&q;:33,&q;recordingType&q;:0,&q;mediaType&q;:0,&q;title&q;:&q;【公基非法】精选好题 沉浸刷题&q;,&q;innerTitle&q;:&q;&q;,&q;startTime&q;:1754186400000,&q;endTime&q;:1754193600000,&q;teacher&q;:{&q;id&q;:15530,&q;userId&q;:71692629,&q;name&q;:&q;杨意雯&q;,&q;brief&q;:&q;粉笔优质讲师&q;,&q;desc&q;:&q;粉笔优质讲师\n丰富实战背景：\n拥有超过7年的实战教学经验，总授课时长突破2000小时，见证了无数学生的成长与蜕变。\n深厚专业底蕴与实战融合：\n在公基与言语领域，拥有深厚的学术功底与实战经验，能够深入浅出地剖析考点，直击要害。积极参与多次教研会，紧跟国家公务员及事业单位选拔的最新动态，确保教学内容的前沿性与针对性。\n优质教学风采与广泛认可：\n收获超过1000份来自全国各地学员的热烈好评，构建起坚实的口碑基础。\n以“逻辑严谨、寓教于乐”的独特教学风格著称，擅长运用生动实例与趣味互动，将抽象概念具象化，让学习之旅变得生动有趣，极大提升了学生的学习兴趣与效率。&q;,&q;avatar&q;:&q;1760362bb2f7c82.jpg&q;,&q;upperBodyPhoto&q;:null,&q;displayCoursePrefix&q;:&q;sydw&q;,&q;teacherStat&q;:{&q;teacherId&q;:15530,&q;episodeCount&q;:449,&q;scoreCount&q;:1212,&q;avgScore&q;:9.900990099009896,&q;fiveGradeAvgScore&q;:4.95,&q;updateTime&q;:1773411447504},&q;auditionEpisode&q;:null,&q;memberOfCPC&q;:false,&q;tags&q;:null},&q;teachChannel&q;:1,&q;offline&q;:null,&q;duration&q;:8219,&q;hasAudition&q;:false,&q;bizType&q;:0,&q;bizId&q;:&q;726825&q;,&q;supportReplay&q;:true,&q;extraInfo&q;:null,&q;liveConfig&q;:{&q;episodeId&q;:10921449,&q;supportMultiGroup&q;:false,&q;exerciseBizType&q;:0,&q;videoDisplayType&q;:0,&q;avForwardType&q;:0,&q;useIntelligentRoom&q;:false,&q;hasStrokeKeynote&q;:true,&q;verticalModeType&q;:0,&q;originEpisodeId&q;:0,&q;supportRtmp&q;:false,&q;supportPk&q;:true,&q;supportLuckyBag&q;:true,&q;supportUserNoteStroke&q;:false,&q;communicateType&q;:0,&q;one2One&q;:false,&q;fakeLive&q;:false},&q;validStatus&q;:1,&q;supportLive&q;:true,&q;supportAiCatalog&q;:false,&q;hasIntelligentPen&q;:false,&q;useLocalRecording&q;:false,&q;useIntelligentRoom&q;:false,&q;hasSalePosition&q;:false,&q;hasEpisodeCards&q;:true,&q;lockedForShouna&q;:false,&q;needSignIn&q;:false,&q;needTeacherSignIn&q;:false,&q;enablePadPencil&q;:true,&q;displayExercise&q;:false,&q;supportLuckyBag&q;:true,&q;supportLivePk&q;:true},{&q;id&q;:10921487,&q;kePrefix&q;:&q;sydw&q;,&q;courseId&q;:6,&q;status&q;:3,&q;playStatus&q;:3,&q;type&q;:33,&q;recordingType&q;:0,&q;mediaType&q;:0,&q;title&q;:&q;【综应】精选好题 沉浸刷题&q;,&q;innerTitle&q;:&q;&q;,&q;startTime&q;:1754193600000,&q;endTime&q;:1754200800000,&q;teacher&q;:{&q;id&q;:26288,&q;userId&q;:52871684,&q;name&q;:&q;刘开心&q;,&q;brief&q;:&q;粉笔优质讲师&q;,&q;desc&q;:&q;粉笔优质教师\n5年一线教学经验，具有系统的专业理论知识。在职期间除了完成授课，同时兼顾教学研讨，熟悉命题及各地区考情动态，能力扎实。\n累计带笔试班学员人数超2000人，学员整体评分维持在4.8分以上；累计授课超过1000小时，评分达4.9分以上。\n课堂氛围轻松融洽，授课重点突出，思路清晰，讲解耐心细致，语言通俗易懂，擅长引导学生自主思考，并根据学生的不同情况和需求进行个性化指导。&q;,&q;avatar&q;:&q;17692b3ab794012.jpg&q;,&q;upperBodyPhoto&q;:null,&q;displayCoursePrefix&q;:&q;sydw&q;,&q;teacherStat&q;:{&q;teacherId&q;:26288,&q;episodeCount&q;:281,&q;scoreCount&q;:253,&q;avgScore&q;:9.794466403162055,&q;fiveGradeAvgScore&q;:4.9,&q;updateTime&q;:1773542090440},&q;auditionEpisode&q;:null,&q;memberOfCPC&q;:false,&q;tags&q;:null},&q;teachChannel&q;:1,&q;offline&q;:null,&q;duration&q;:6937,&q;hasAudition&q;:false,&q;bizType&q;:0,&q;bizId&q;:&q;726825&q;,&q;supportReplay&q;:true,&q;extraInfo&q;:null,&q;liveConfig&q;:{&q;episodeId&q;:10921487,&q;supportMultiGroup&q;:false,&q;exerciseBizType&q;:0,&q;videoDisplayType&q;:0,&q;avForwardType&q;:0,&q;useIntelligentRoom&q;:false,&q;hasStrokeKeynote&q;:true,&q;verticalModeType&q;:0,&q;originEpisodeId&q;:0,&q;supportRtmp&q;:false,&q;supportPk&q;:true,&q;supportLuckyBag&q;:true,&q;supportUserNoteStroke&q;:false,&q;communicateType&q;:0,&q;one2One&q;:false,&q;fakeLive&q;:false},&q;validStatus&q;:1,&q;supportLive&q;:true,&q;supportAiCatalog&q;:false,&q;hasIntelligentPen&q;:false,&q;useLocalRecording&q;:false,&q;useIntelligentRoom&q;:false,&q;hasSalePosition&q;:false,&q;hasEpisodeCards&q;:true,&q;lockedForShouna&q;:false,&q;needSignIn&q;:false,&q;needTeacherSignIn&q;:false,&q;enablePadPencil&q;:true,&q;displayExercise&q;:false,&q;supportLuckyBag&q;:true,&q;supportLivePk&q;:true},{&q;id&q;:10921647,&q;kePrefix&q;:&q;sydw&q;,&q;courseId&q;:6,&q;status&q;:3,&q;playStatus&q;:3,&q;type&q;:33,&q;recordingType&q;:0,&q;mediaType&q;:0,&q;title&q;:&q;【数资】精选好题 沉浸刷题&q;,&q;innerTitle&q;:&q;&q;,&q;startTime&q;:1754272800000,&q;endTime&q;:1754280000000,&q;teacher&q;:{&q;id&q;:16722,&q;userId&q;:52232168,&q;name&q;:&q;王轶琢&q;,&q;brief&q;:&q;粉笔优质讲师&q;,&q;desc&q;:&q;粉笔优质讲师\n6年一线教学授课经验；具有数资科目丰富的实践经验及系统扎实的专业理论知识；多次参加粉笔教研活动，分享授课经验心得，助力粉笔理论研发升级；\n累计授课超过2000小时，累计评分达4.9分；授课与实战经验丰富，熟悉考场答题思维及应变技巧。\n老师授课风格：风趣幽默，灵活引导学员自主思考，激发学员学习热情和自主意识；授课逻辑性强，注重理论与实践相结合，深受学员的喜爱。&q;,&q;avatar&q;:&q;1983bddcd777cc6.jpg&q;,&q;upperBodyPhoto&q;:null,&q;displayCoursePrefix&q;:&q;sydw&q;,&q;teacherStat&q;:{&q;teacherId&q;:16722,&q;episodeCount&q;:870,&q;scoreCount&q;:2527,&q;avgScore&q;:9.784724970320534,&q;fiveGradeAvgScore&q;:4.89,&q;updateTime&q;:1773198754974},&q;auditionEpisode&q;:{&q;episodeTitle&q;:&q;个人展示课&q;,&q;episodeVideoUrl&q;:&q;https://vod.fbstatic.cn/22e9ceb2vodbj1251001446/9ebc23c15145403707375528343/mutMbTelffgA.mp4?t=f2a4b300&a;us=4070880000&a;sign=fa18dfaff16469d1f41c7e7cebb5b1a6&q;},&q;memberOfCPC&q;:false,&q;tags&q;:null},&q;teachChannel&q;:1,&q;offline&q;:null,&q;duration&q;:6927,&q;hasAudition&q;:false,&q;bizType&q;:0,&q;bizId&q;:&q;726825&q;,&q;supportReplay&q;:true,&q;extraInfo&q;:null,&q;liveConfig&q;:{&q;episodeId&q;:10921647,&q;supportMultiGroup&q;:false,&q;exerciseBizType&q;:0,&q;videoDisplayType&q;:0,&q;avForwardType&q;:0,&q;useIntelligentRoom&q;:false,&q;hasStrokeKeynote&q;:true,&q;verticalModeType&q;:0,&q;originEpisodeId&q;:0,&q;supportRtmp&q;:false,&q;supportPk&q;:true,&q;supportLuckyBag&q;:true,&q;supportUserNoteStroke&q;:false,&q;communicateType&q;:0,&q;one2One&q;:false,&q;fakeLive&q;:false},&q;validStatus&q;:1,&q;supportLive&q;:true,&q;supportAiCatalog&q;:false,&q;hasIntelligentPen&q;:false,&q;useLocalRecording&q;:false,&q;useIntelligentRoom&q;:false,&q;hasSalePosition&q;:false,&q;hasEpisodeCards&q;:true,&q;lockedForShouna&q;:false,&q;needSignIn&q;:false,&q;needTeacherSignIn&q;:false,&q;enablePadPencil&q;:true,&q;displayExercise&q;:false,&q;supportLuckyBag&q;:true,&q;supportLivePk&q;:true},{&q;id&q;:10921661,&q;kePrefix&q;:&q;sydw&q;,&q;courseId&q;:6,&q;status&q;:3,&q;playStatus&q;:3,&q;type&q;:33,&q;recordingType&q;:0,&q;mediaType&q;:0,&q;title&q;:&q;【言语】精选好题 沉浸刷题&q;,&q;innerTitle&q;:&q;&q;,&q;startTime&q;:1754280000000,&q;endTime&q;:1754287200000,&q;teacher&q;:{&q;id&q;:35776,&q;userId&q;:83534698,&q;name&q;:&q;魏兰婷&q;,&q;brief&q;:&q;粉笔优质讲师&q;,&q;desc&q;:&q;粉笔优质讲师\n拥有7年一线教学授课经验，毕业于双一流院校。深耕言语理解与表达科目，对国考及各省考情有精准把握。具有言语科目丰富的实践经验及系统扎实的专业理论知识。\n①多次参与粉笔授课研讨与教研活动，持续更新教学理论与方法；\n②承担线上公开课及线上直播课等工作，累计全国授课超万人次，学员评分长期稳定在4.9分以上；\n③曾2次在粉笔“师资风采大赛”中入围并获奖，教学能力获得内部认可。\n授课风格耐心细致，善于将复杂的知识点转化为通俗易懂的讲解，营造轻松积极的学习氛围。其高效的解题方法与亲切的指导深受学员好评，是学员信赖的良师。&q;,&q;avatar&q;:&q;1984fca9fbd6325.jpg&q;,&q;upperBodyPhoto&q;:null,&q;displayCoursePrefix&q;:&q;sydw&q;,&q;teacherStat&q;:{&q;teacherId&q;:35776,&q;episodeCount&q;:610,&q;scoreCount&q;:4222,&q;avgScore&q;:9.801989578398866,&q;fiveGradeAvgScore&q;:4.9,&q;updateTime&q;:1773576447340},&q;auditionEpisode&q;:{&q;episodeTitle&q;:&q;个人展示课&q;,&q;episodeVideoUrl&q;:&q;https://vod.fbstatic.cn/22e9ceb2vodbj1251001446/bcb7f84d5145403709538179593/LKKkDheS6YsA.mp4?t=f2a4b300&a;us=4070880000&a;sign=ade5c614ffe4fa0bcf0395aa689081c8&q;},&q;memberOfCPC&q;:false,&q;tags&q;:null},&q;teachChannel&q;:1,&q;offline&q;:null,&q;duration&q;:7335,&q;hasAudition&q;:false,&q;bizType&q;:0,&q;bizId&q;:&q;726825&q;,&q;supportReplay&q;:true,&q;extraInfo&q;:null,&q;liveConfig&q;:{&q;episodeId&q;:10921661,&q;supportMultiGroup&q;:false,&q;exerciseBizType&q;:0,&q;videoDisplayType&q;:0,&q;avForwardType&q;:0,&q;useIntelligentRoom&q;:false,&q;hasStrokeKeynote&q;:true,&q;verticalModeType&q;:0,&q;originEpisodeId&q;:0,&q;supportRtmp&q;:false,&q;supportPk&q;:true,&q;supportLuckyBag&q;:true,&q;supportUserNoteStroke&q;:false,&q;communicateType&q;:0,&q;one2One&q;:false,&q;fakeLive&q;:false},&q;validStatus&q;:1,&q;supportLive&q;:true,&q;supportAiCatalog&q;:false,&q;hasIntelligentPen&q;:false,&q;useLocalRecording&q;:false,&q;useIntelligentRoom&q;:false,&q;hasSalePosition&q;:false,&q;hasEpisodeCards&q;:true,&q;lockedForShouna&q;:false,&q;needSignIn&q;:false,&q;needTeacherSignIn&q;:false,&q;enablePadPencil&q;:true,&q;displayExercise&q;:false,&q;supportLuckyBag&q;:true,&q;supportLivePk&q;:true},{&q;id&q;:10921688,&q;kePrefix&q;:&q;sydw&q;,&q;courseId&q;:6,&q;status&q;:3,&q;playStatus&q;:3,&q;type&q;:33,&q;recordingType&q;:0,&q;mediaType&q;:0,&q;title&q;:&q;【公基法律】精选好题 沉浸刷题&q;,&q;innerTitle&q;:&q;&q;,&q;startTime&q;:1754287200000,&q;endTime&q;:1754294400000,&q;teacher&q;:{&q;id&q;:16813,&q;userId&q;:50366016,&q;name&q;:&q;张煦昕&q;,&q;brief&q;:&q;粉笔优质讲师&q;,&q;desc&q;:&q;粉笔优质教师。\n投身教育事业6年，拥有扎实一线教学经验，对于面试内容有自己独到的见解。\n擅长运用结构化面试、情景模拟等多种方法，全面、客观地评估考生的逻辑思维、问题解决、沟通协调及抗压能力。\n授课评分累计达4.9分，授课耐心细致、严谨，循循善诱，熟悉考场答题技巧，能帮助学员理清答题思路；讲解题目逻辑性强条分缕析，善于总结方法技巧；课堂互动性强，善于通过点评帮助学生找到问题，激发学员学习热情，受到学员欢迎。&q;,&q;avatar&q;:&q;176a72cb2c6d8c4.jpg&q;,&q;upperBodyPhoto&q;:null,&q;displayCoursePrefix&q;:&q;sydw&q;,&q;teacherStat&q;:{&q;teacherId&q;:16813,&q;episodeCount&q;:466,&q;scoreCount&q;:1061,&q;avgScore&q;:9.796418473138555,&q;fiveGradeAvgScore&q;:4.9,&q;updateTime&q;:1773396064102},&q;auditionEpisode&q;:{&q;episodeTitle&q;:&q;个人展示课&q;,&q;episodeVideoUrl&q;:&q;https://vod.fbstatic.cn/22e9ceb2vodbj1251001446/3350025c5145403709543612633/AuAZazr4H98A.mp4?t=f2a4b300&a;us=4070880000&a;sign=d862836cd36bd5e4b2977a502173f189&q;},&q;memberOfCPC&q;:false,&q;tags&q;:null},&q;teachChannel&q;:1,&q;offline&q;:null,&q;duration&q;:7430,&q;hasAudition&q;:false,&q;bizType&q;:0,&q;bizId&q;:&q;726825&q;,&q;supportReplay&q;:true,&q;extraInfo&q;:null,&q;liveConfig&q;:{&q;episodeId&q;:10921688,&q;supportMultiGroup&q;:false,&q;exerciseBizType&q;:0,&q;videoDisplayType&q;:0,&q;avForwardType&q;:0,&q;useIntelligentRoom&q;:false,&q;hasStrokeKeynote&q;:true,&q;verticalModeType&q;:0,&q;originEpisodeId&q;:0,&q;supportRtmp&q;:false,&q;supportPk&q;:true,&q;supportLuckyBag&q;:true,&q;supportUserNoteStroke&q;:false,&q;communicateType&q;:0,&q;one2One&q;:false,&q;fakeLive&q;:false},&q;validStatus&q;:1,&q;supportLive&q;:true,&q;supportAiCatalog&q;:false,&q;hasIntelligentPen&q;:false,&q;useLocalRecording&q;:false,&q;useIntelligentRoom&q;:false,&q;hasSalePosition&q;:false,&q;hasEpisodeCards&q;:true,&q;lockedForShouna&q;:false,&q;needSignIn&q;:false,&q;needTeacherSignIn&q;:false,&q;enablePadPencil&q;:true,&q;displayExercise&q;:false,&q;supportLuckyBag&q;:true,&q;supportLivePk&q;:true},{&q;id&q;:10921689,&q;kePrefix&q;:&q;sydw&q;,&q;courseId&q;:6,&q;status&q;:3,&q;playStatus&q;:3,&q;type&q;:33,&q;recordingType&q;:0,&q;mediaType&q;:0,&q;title&q;:&q;【数资】精选好题 沉浸刷题&q;,&q;innerTitle&q;:&q;&q;,&q;startTime&q;:1754294400000,&q;endTime&q;:1754301600000,&q;teacher&q;:{&q;id&q;:56432,&q;userId&q;:96015899,&q;name&q;:&q;李秋霖&q;,&q;brief&q;:&q;粉笔优质讲师&q;,&q;desc&q;:&q;粉笔优质教师\n4年一线教学授课经验，具有数资科目丰富的实践经验及系统扎实的专业理论知识。参与命制笔试教研，对资料分析方向有深入研究，并撰写多篇事业单位笔试教研材料，在粉笔笔试教师内部进行共享。多次参加粉笔教研活动，分享授课经验心得，助力粉笔理论研发升级。获得学员的多次好评，具有热情洋溢的授课风格，让学生在轻松的学习氛围中，用更简单的方法，找到更快捷的解题之道，深受广大学员的认可和好评。&q;,&q;avatar&q;:&q;18488bc569ccb4d.jpg&q;,&q;upperBodyPhoto&q;:null,&q;displayCoursePrefix&q;:&q;sydw&q;,&q;teacherStat&q;:{&q;teacherId&q;:56432,&q;episodeCount&q;:274,&q;scoreCount&q;:785,&q;avgScore&q;:9.76305732484077,&q;fiveGradeAvgScore&q;:4.88,&q;updateTime&q;:1773590328512},&q;auditionEpisode&q;:{&q;episodeTitle&q;:&q;个人展示课&q;,&q;episodeVideoUrl&q;:&q;https://vod.fbstatic.cn/22e9ceb2vodbj1251001446/160ff7b15145403709427487787/AMGHBIZnUaYA.mp4?t=f2a4b300&a;us=4070880000&a;sign=5bd04e214d72bef5a7d368b737db12f4&q;},&q;memberOfCPC&q;:false,&q;tags&q;:null},&q;teachChannel&q;:1,&q;offline&q;:null,&q;duration&q;:7839,&q;hasAudition&q;:false,&q;bizType&q;:0,&q;bizId&q;:&q;726825&q;,&q;supportReplay&q;:true,&q;extraInfo&q;:null,&q;liveConfig&q;:{&q;episodeId&q;:10921689,&q;supportMultiGroup&q;:false,&q;exerciseBizType&q;:0,&q;videoDisplayType&q;:0,&q;avForwardType&q;:0,&q;useIntelligentRoom&q;:false,&q;hasStrokeKeynote&q;:true,&q;verticalModeType&q;:0,&q;originEpisodeId&q;:0,&q;supportRtmp&q;:false,&q;supportPk&q;:true,&q;supportLuckyBag&q;:true,&q;supportUserNoteStroke&q;:false,&q;communicateType&q;:0,&q;one2One&q;:false,&q;fakeLive&q;:false},&q;validStatus&q;:1,&q;supportLive&q;:true,&q;supportAiCatalog&q;:false,&q;hasIntelligentPen&q;:false,&q;useLocalRecording&q;:false,&q;useIntelligentRoom&q;:false,&q;hasSalePosition&q;:false,&q;hasEpisodeCards&q;:true,&q;lockedForShouna&q;:false,&q;needSignIn&q;:false,&q;needTeacherSignIn&q;:false,&q;enablePadPencil&q;:true,&q;displayExercise&q;:false,&q;supportLuckyBag&q;:true,&q;supportLivePk&q;:true},{&q;id&q;:10921752,&q;kePrefix&q;:&q;sydw&q;,&q;courseId&q;:6,&q;status&q;:3,&q;playStatus&q;:3,&q;type&q;:33,&q;recordingType&q;:0,&q;mediaType&q;:0,&q;title&q;:&q;【判断】精选好题 沉浸刷题&q;,&q;innerTitle&q;:&q;&q;,&q;startTime&q;:1754359200000,&q;endTime&q;:1754366400000,&q;teacher&q;:{&q;id&q;:24162,&q;userId&q;:59957211,&q;name&q;:&q;金思彤&q;,&q;brief&q;:&q;粉笔优质讲师&q;,&q;desc&q;:&q;粉笔优质讲师\n7年一线教学经验，211大学双一流学科硕士毕业，教学态度认真负责，具有判断科目丰富的实践经验及系统扎实的专业理论知识和对事业单位判断推理考情的深入研究；曾参与命制笔试真题教研和解析撰写工作，对判断推理最新命题趋势方向有深入研究。&q;,&q;avatar&q;:&q;19bbc34197eebfe.jpg&q;,&q;upperBodyPhoto&q;:null,&q;displayCoursePrefix&q;:&q;sydw&q;,&q;teacherStat&q;:{&q;teacherId&q;:24162,&q;episodeCount&q;:506,&q;scoreCount&q;:2157,&q;avgScore&q;:9.907278627723691,&q;fiveGradeAvgScore&q;:4.95,&q;updateTime&q;:1772558154031},&q;auditionEpisode&q;:{&q;episodeTitle&q;:&q;个人展示课&q;,&q;episodeVideoUrl&q;:&q;https://vod.fbstatic.cn/22e9ceb2vodbj1251001446/769646875145403709537454592/AvgGIhEZbfEA.mp4?t=f2a4b300&a;us=4070880000&a;sign=b403d56f99dc2f52a13f62fafb197865&q;},&q;memberOfCPC&q;:false,&q;tags&q;:null},&q;teachChannel&q;:1,&q;offline&q;:null,&q;duration&q;:7258,&q;hasAudition&q;:false,&q;bizType&q;:0,&q;bizId&q;:&q;726825&q;,&q;supportReplay&q;:true,&q;extraInfo&q;:null,&q;liveConfig&q;:{&q;episodeId&q;:10921752,&q;supportMultiGroup&q;:false,&q;exerciseBizType&q;:0,&q;videoDisplayType&q;:0,&q;avForwardType&q;:0,&q;useIntelligentRoom&q;:false,&q;hasStrokeKeynote&q;:true,&q;verticalModeType&q;:0,&q;originEpisodeId&q;:0,&q;supportRtmp&q;:false,&q;supportPk&q;:true,&q;supportLuckyBag&q;:true,&q;supportUserNoteStroke&q;:false,&q;communicateType&q;:0,&q;one2One&q;:false,&q;fakeLive&q;:false},&q;validStatus&q;:1,&q;supportLive&q;:true,&q;supportAiCatalog&q;:false,&q;hasIntelligentPen&q;:false,&q;useLocalRecording&q;:false,&q;useIntelligentRoom&q;:false,&q;hasSalePosition&q;:false,&q;hasEpisodeCards&q;:true,&q;lockedForShouna&q;:false,&q;needSignIn&q;:false,&q;needTeacherSignIn&q;:false,&q;enablePadPencil&q;:true,&q;displayExercise&q;:false,&q;supportLuckyBag&q;:true,&q;supportLivePk&q;:true},{&q;id&q;:10921763,&q;kePrefix&q;:&q;sydw&q;,&q;courseId&q;:6,&q;status&q;:3,&q;playStatus&q;:3,&q;type&q;:33,&q;recordingType&q;:0,&q;mediaType&q;:0,&q;title&q;:&q;【公基非法】精选好题 沉浸刷题&q;,&q;innerTitle&q;:&q;&q;,&q;startTime&q;:1754373600000,&q;endTime&q;:1754380800000,&q;teacher&q;:{&q;id&q;:17050,&q;userId&q;:69384227,&q;name&q;:&q;刘枭&q;,&q;brief&q;:&q;粉笔优质讲师&q;,&q;desc&q;:&q;粉笔优质讲师。\n硕士毕业，从事线上常识公基科目教研授课长达6年，拥有非常丰富扎实的一线授课经验，承担多种产品类型的授课工作。\n教学上，具有常识公基非法科目丰富的实践经验及扎实的专业知识，对常识公基非法考情有着深入的研究，长期承担非法板块小模考授课，曾多次参与命制笔试真题教研和解析撰写工作，致力于研究事业单位的命题规律及答题技巧。\n授课深入浅出，举一反三，善于引导和启发学生；讲课逻辑性强条分缕析，善长归纳方法技巧；从学员角度出发解决问题，长期累计评分达4.9。细致耐心，寓教于乐，善于营造轻松愉悦的课堂氛围，深受学生喜爱。&q;,&q;avatar&q;:&q;17470a2ced5ee4c.jpg&q;,&q;upperBodyPhoto&q;:null,&q;displayCoursePrefix&q;:&q;sydw&q;,&q;teacherStat&q;:{&q;teacherId&q;:17050,&q;episodeCount&q;:730,&q;scoreCount&q;:2726,&q;avgScore&q;:9.798972853998558,&q;fiveGradeAvgScore&q;:4.9,&q;updateTime&q;:1773476302738},&q;auditionEpisode&q;:{&q;episodeTitle&q;:&q;个人展示课&q;,&q;episodeVideoUrl&q;:&q;https://vod.fbstatic.cn/22e9ceb2vodbj1251001446/9ae2fc415145403708185095920/NpmeJff4ztMA.mp4?t=f2a4b300&a;us=4070880000&a;sign=de1c4dfab32e0a94c2ae19673faed255&q;},&q;memberOfCPC&q;:false,&q;tags&q;:null},&q;teachChannel&q;:1,&q;offline&q;:null,&q;duration&q;:8183,&q;hasAudition&q;:false,&q;bizType&q;:0,&q;bizId&q;:&q;726825&q;,&q;supportReplay&q;:true,&q;extraInfo&q;:null,&q;liveConfig&q;:{&q;episodeId&q;:10921763,&q;supportMultiGroup&q;:false,&q;exerciseBizType&q;:0,&q;videoDisplayType&q;:0,&q;avForwardType&q;:0,&q;useIntelligentRoom&q;:false,&q;hasStrokeKeynote&q;:true,&q;verticalModeType&q;:0,&q;originEpisodeId&q;:0,&q;supportRtmp&q;:false,&q;supportPk&q;:true,&q;supportLuckyBag&q;:true,&q;supportUserNoteStroke&q;:false,&q;communicateType&q;:0,&q;one2One&q;:false,&q;fakeLive&q;:false},&q;validStatus&q;:1,&q;supportLive&q;:true,&q;supportAiCatalog&q;:false,&q;hasIntelligentPen&q;:false,&q;useLocalRecording&q;:false,&q;useIntelligentRoom&q;:false,&q;hasSalePosition&q;:false,&q;hasEpisodeCards&q;:true,&q;lockedForShouna&q;:false,&q;needSignIn&q;:false,&q;needTeacherSignIn&q;:false,&q;enablePadPencil&q;:true,&q;displayExercise&q;:false,&q;supportLuckyBag&q;:true,&q;supportLivePk&q;:true},{&q;id&q;:10921764,&q;kePrefix&q;:&q;sydw&q;,&q;courseId&q;:6,&q;status&q;:3,&q;playStatus&q;:3,&q;type&q;:33,&q;recordingType&q;:0,&q;mediaType&q;:0,&q;title&q;:&q;【言语】精选好题 沉浸刷题&q;,&q;innerTitle&q;:&q;&q;,&q;startTime&q;:1754380800000,&q;endTime&q;:1754388000000,&q;teacher&q;:{&q;id&q;:35776,&q;userId&q;:83534698,&q;name&q;:&q;魏兰婷&q;,&q;brief&q;:&q;粉笔优质讲师&q;,&q;desc&q;:&q;粉笔优质讲师\n拥有7年一线教学授课经验，毕业于双一流院校。深耕言语理解与表达科目，对国考及各省考情有精准把握。具有言语科目丰富的实践经验及系统扎实的专业理论知识。\n①多次参与粉笔授课研讨与教研活动，持续更新教学理论与方法；\n②承担线上公开课及线上直播课等工作，累计全国授课超万人次，学员评分长期稳定在4.9分以上；\n③曾2次在粉笔“师资风采大赛”中入围并获奖，教学能力获得内部认可。\n授课风格耐心细致，善于将复杂的知识点转化为通俗易懂的讲解，营造轻松积极的学习氛围。其高效的解题方法与亲切的指导深受学员好评，是学员信赖的良师。&q;,&q;avatar&q;:&q;1984fca9fbd6325.jpg&q;,&q;upperBodyPhoto&q;:null,&q;displayCoursePrefix&q;:&q;sydw&q;,&q;teacherStat&q;:{&q;teacherId&q;:35776,&q;episodeCount&q;:610,&q;scoreCount&q;:4222,&q;avgScore&q;:9.801989578398866,&q;fiveGradeAvgScore&q;:4.9,&q;updateTime&q;:1773576447340},&q;auditionEpisode&q;:{&q;episodeTitle&q;:&q;个人展示课&q;,&q;episodeVideoUrl&q;:&q;https://vod.fbstatic.cn/22e9ceb2vodbj1251001446/bcb7f84d5145403709538179593/LKKkDheS6YsA.mp4?t=f2a4b300&a;us=4070880000&a;sign=ade5c614ffe4fa0bcf0395aa689081c8&q;},&q;memberOfCPC&q;:false,&q;tags&q;:null},&q;teachChannel&q;:1,&q;offline&q;:null,&q;duration&q;:7908,&q;hasAudition&q;:false,&q;bizType&q;:0,&q;bizId&q;:&q;726825&q;,&q;supportReplay&q;:true,&q;extraInfo&q;:null,&q;liveConfig&q;:{&q;episodeId&q;:10921764,&q;supportMultiGroup&q;:false,&q;exerciseBizType&q;:0,&q;videoDisplayType&q;:0,&q;avForwardType&q;:0,&q;useIntelligentRoom&q;:false,&q;hasStrokeKeynote&q;:true,&q;verticalModeType&q;:0,&q;originEpisodeId&q;:0,&q;supportRtmp&q;:false,&q;supportPk&q;:true,&q;supportLuckyBag&q;:true,&q;supportUserNoteStroke&q;:false,&q;communicateType&q;:0,&q;one2One&q;:false,&q;fakeLive&q;:false},&q;validStatus&q;:1,&q;supportLive&q;:true,&q;supportAiCatalog&q;:false,&q;hasIntelligentPen&q;:false,&q;useLocalRecording&q;:false,&q;useIntelligentRoom&q;:false,&q;hasSalePosition&q;:false,&q;hasEpisodeCards&q;:true,&q;lockedForShouna&q;:false,&q;needSignIn&q;:false,&q;needTeacherSignIn&q;:false,&q;enablePadPencil&q;:true,&q;displayExercise&q;:false,&q;supportLuckyBag&q;:true,&q;supportLivePk&q;:true},{&q;id&q;:10921786,&q;kePrefix&q;:&q;sydw&q;,&q;courseId&q;:6,&q;status&q;:3,&q;playStatus&q;:3,&q;type&q;:33,&q;recordingType&q;:0,&q;mediaType&q;:0,&q;title&q;:&q;【综应】精选好题 沉浸刷题&q;,&q;innerTitle&q;:&q;&q;,&q;startTime&q;:1754445600000,&q;endTime&q;:1754452800000,&q;teacher&q;:{&q;id&q;:36424,&q;userId&q;:68075961,&q;name&q;:&q;周凡&q;,&q;brief&q;:&q;粉笔优质讲师&q;,&q;desc&q;:&q;粉笔优质讲师\n五年一线教学授课经验，具有申论、综应科目丰富的实践经验及系统扎实的专业理论知识，承担过笔试精品班、刷题班、冲刺营等多种班型，熟悉各地方事业单位综合应用科目的真题特色和答题技巧。多次参加粉笔教研活动，注重自我提升，积极丰富更新理论知识。\n擅长启发式教学，将理论与实际结合引导学员形成逻辑思维，抓住学员痛点，针对性解决；授课风格生动亲和，互动性强，激发学员自主思考，深受学员喜爱。&q;,&q;avatar&q;:&q;193af6a0ddc74ed.jpg&q;,&q;upperBodyPhoto&q;:null,&q;displayCoursePrefix&q;:&q;sydw&q;,&q;teacherStat&q;:{&q;teacherId&q;:36424,&q;episodeCount&q;:186,&q;scoreCount&q;:310,&q;avgScore&q;:9.832258064516125,&q;fiveGradeAvgScore&q;:4.92,&q;updateTime&q;:1773451850353},&q;auditionEpisode&q;:{&q;episodeTitle&q;:&q;个人展示课&q;,&q;episodeVideoUrl&q;:&q;https://vod.fbstatic.cn/22e9ceb2vodbj1251001446/8069d87c1253642696337003353/yZcT8GBR7s0A.mp4?t=f2a4b300&a;us=4070880000&a;sign=d6adc5739df5884a68595e7bb9a0a63f&q;},&q;memberOfCPC&q;:false,&q;tags&q;:null},&q;teachChannel&q;:1,&q;offline&q;:null,&q;duration&q;:6148,&q;hasAudition&q;:false,&q;bizType&q;:0,&q;bizId&q;:&q;726825&q;,&q;supportReplay&q;:true,&q;extraInfo&q;:null,&q;liveConfig&q;:{&q;episodeId&q;:10921786,&q;supportMultiGroup&q;:false,&q;exerciseBizType&q;:0,&q;videoDisplayType&q;:0,&q;avForwardType&q;:0,&q;useIntelligentRoom&q;:false,&q;hasStrokeKeynote&q;:true,&q;verticalModeType&q;:0,&q;originEpisodeId&q;:0,&q;supportRtmp&q;:false,&q;supportPk&q;:true,&q;supportLuckyBag&q;:true,&q;supportUserNoteStroke&q;:false,&q;communicateType&q;:0,&q;one2One&q;:false,&q;fakeLive&q;:false},&q;validStatus&q;:1,&q;supportLive&q;:true,&q;supportAiCatalog&q;:false,&q;hasIntelligentPen&q;:false,&q;useLocalRecording&q;:false,&q;useIntelligentRoom&q;:false,&q;hasSalePosition&q;:false,&q;hasEpisodeCards&q;:true,&q;lockedForShouna&q;:false,&q;needSignIn&q;:false,&q;needTeacherSignIn&q;:false,&q;enablePadPencil&q;:true,&q;displayExercise&q;:false,&q;supportLuckyBag&q;:true,&q;supportLivePk&q;:true},{&q;id&q;:10921796,&q;kePrefix&q;:&q;sydw&q;,&q;courseId&q;:6,&q;status&q;:3,&q;playStatus&q;:3,&q;type&q;:33,&q;recordingType&q;:0,&q;mediaType&q;:0,&q;title&q;:&q;【综应】精选好题 沉浸刷题&q;,&q;innerTitle&q;:&q;&q;,&q;startTime&q;:1754460000000,&q;endTime&q;:1754467200000,&q;teacher&q;:{&q;id&q;:16970,&q;userId&q;:66988478,&q;name&q;:&q;彭雨青&q;,&q;brief&q;:&q;粉笔优质讲师&q;,&q;desc&q;:&q;粉笔优质讲师。六年一线教学经验，多次事业单位考试实战经历，综应成绩突出，全面了解事业单位综合应用能力考情及答题技巧; 多次参与粉笔线上线下教研活动，理论基础扎实，注重考场思维；授课经验丰富，参与多班型授课，课堂氛围轻松；授课风格成熟，讲解耐心细致，条理清晰，受到学员广泛好评。&q;,&q;avatar&q;:&q;198551f5f2aeddc.jpg&q;,&q;upperBodyPhoto&q;:null,&q;displayCoursePrefix&q;:&q;sydw&q;,&q;teacherStat&q;:{&q;teacherId&q;:16970,&q;episodeCount&q;:426,&q;scoreCount&q;:550,&q;avgScore&q;:9.959999999999994,&q;fiveGradeAvgScore&q;:4.98,&q;updateTime&q;:1773206256359},&q;auditionEpisode&q;:{&q;episodeTitle&q;:&q;个人展示课&q;,&q;episodeVideoUrl&q;:&q;https://vod.fbstatic.cn/22e9ceb2vodbj1251001446/8207a7095145403709537920947/TaUQYutM1mAA.mp4?t=f2a4b300&a;us=4070880000&a;sign=03a53cae536bade8d5d8aa41a688ac08&q;},&q;memberOfCPC&q;:false,&q;tags&q;:null},&q;teachChannel&q;:1,&q;offline&q;:null,&q;duration&q;:7397,&q;hasAudition&q;:false,&q;bizType&q;:0,&q;bizId&q;:&q;726825&q;,&q;supportReplay&q;:true,&q;extraInfo&q;:null,&q;liveConfig&q;:{&q;episodeId&q;:10921796,&q;supportMultiGroup&q;:false,&q;exerciseBizType&q;:0,&q;videoDisplayType&q;:0,&q;avForwardType&q;:0,&q;useIntelligentRoom&q;:false,&q;hasStrokeKeynote&q;:true,&q;verticalModeType&q;:0,&q;originEpisodeId&q;:0,&q;supportRtmp&q;:false,&q;supportPk&q;:true,&q;supportLuckyBag&q;:true,&q;supportUserNoteStroke&q;:false,&q;communicateType&q;:0,&q;one2One&q;:false,&q;fakeLive&q;:false},&q;validStatus&q;:1,&q;supportLive&q;:true,&q;supportAiCatalog&q;:false,&q;hasIntelligentPen&q;:false,&q;useLocalRecording&q;:false,&q;useIntelligentRoom&q;:false,&q;hasSalePosition&q;:false,&q;hasEpisodeCards&q;:true,&q;lockedForShouna&q;:false,&q;needSignIn&q;:false,&q;needTeacherSignIn&q;:false,&q;enablePadPencil&q;:true,&q;displayExercise&q;:false,&q;supportLuckyBag&q;:true,&q;supportLivePk&q;:true},{&q;id&q;:10921839,&q;kePrefix&q;:&q;sydw&q;,&q;courseId&q;:6,&q;status&q;:3,&q;playStatus&q;:3,&q;type&q;:33,&q;recordingType&q;:0,&q;mediaType&q;:0,&q;title&q;:&q;【判断】精选好题 沉浸刷题&q;,&q;innerTitle&q;:&q;&q;,&q;startTime&q;:1754532000000,&q;endTime&q;:1754539200000,&q;teacher&q;:{&q;id&q;:16684,&q;userId&q;:59358516,&q;name&q;:&q;周晶辉&q;,&q;brief&q;:&q;粉笔优质讲师&q;,&q;desc&q;:&q;粉笔优质教师\n六年一线教学授课经验，累计授课时长1000+小时，综合授课评分4.9+，实战经验丰富，授课逻辑清晰，多次参与科目教研工作、授课研讨会议，参与事业单位真题单题录制、模拟题撰写等，熟练掌握判断科目考情及命题趋势，擅长各省联考、江苏、浙江、广东等多地区考点，擅于从学员角度思考，帮助学员理清解题思路，掌握科目常规考点，突破科目重难考点，具有幽默诙谐、形象生动、条理清晰的授课风格，让学生在轻松的学习氛围中，用更简单的方法，找到更快捷的解题之道，深受广大学员的认可和好评。&q;,&q;avatar&q;:&q;198caf9ea93f698.jpg&q;,&q;upperBodyPhoto&q;:null,&q;displayCoursePrefix&q;:&q;sydw&q;,&q;teacherStat&q;:{&q;teacherId&q;:16684,&q;episodeCount&q;:449,&q;scoreCount&q;:1699,&q;avgScore&q;:9.85638610947615,&q;fiveGradeAvgScore&q;:4.93,&q;updateTime&q;:1773578657175},&q;auditionEpisode&q;:{&q;episodeTitle&q;:&q;个人展示课&q;,&q;episodeVideoUrl&q;:&q;https://vod.fbstatic.cn/22e9ceb2vodbj1251001446/85b397c93560136620837741859/inWAKAms518A.mp4?t=f2a4b300&a;us=4070880000&a;sign=8ae71ff49f003e5c8d83058d09cdc3db&q;},&q;memberOfCPC&q;:false,&q;tags&q;:null},&q;teachChannel&q;:1,&q;offline&q;:null,&q;duration&q;:7568,&q;hasAudition&q;:false,&q;bizType&q;:0,&q;bizId&q;:&q;726825&q;,&q;supportReplay&q;:true,&q;extraInfo&q;:null,&q;liveConfig&q;:{&q;episodeId&q;:10921839,&q;supportMultiGroup&q;:false,&q;exerciseBizType&q;:0,&q;videoDisplayType&q;:0,&q;avForwardType&q;:0,&q;useIntelligentRoom&q;:false,&q;hasStrokeKeynote&q;:true,&q;verticalModeType&q;:0,&q;originEpisodeId&q;:0,&q;supportRtmp&q;:false,&q;supportPk&q;:true,&q;supportLuckyBag&q;:true,&q;supportUserNoteStroke&q;:false,&q;communicateType&q;:0,&q;one2One&q;:false,&q;fakeLive&q;:false},&q;validStatus&q;:1,&q;supportLive&q;:true,&q;supportAiCatalog&q;:false,&q;hasIntelligentPen&q;:false,&q;useLocalRecording&q;:false,&q;useIntelligentRoom&q;:false,&q;hasSalePosition&q;:false,&q;hasEpisodeCards&q;:true,&q;lockedForShouna&q;:false,&q;needSignIn&q;:false,&q;needTeacherSignIn&q;:false,&q;enablePadPencil&q;:true,&q;displayExercise&q;:false,&q;supportLuckyBag&q;:true,&q;supportLivePk&q;:true},{&q;id&q;:10921904,&q;kePrefix&q;:&q;sydw&q;,&q;courseId&q;:6,&q;status&q;:3,&q;playStatus&q;:3,&q;type&q;:33,&q;recordingType&q;:0,&q;mediaType&q;:0,&q;title&q;:&q;【综应】精选好题 沉浸刷题&q;,&q;innerTitle&q;:&q;&q;,&q;startTime&q;:1754539200000,&q;endTime&q;:1754546400000,&q;teacher&q;:{&q;id&q;:15514,&q;userId&q;:63317913,&q;name&q;:&q;唐邦杰&q;,&q;brief&q;:&q;粉笔优质讲师&q;,&q;desc&q;:&q;粉笔优质教师\n6年一线教学授课经验，线上累计授课超1000+小时，授课人数2500+，始终教研结合，紧跟命题走向，强调知识更新。善于讲解联考A、江苏、浙江、山东、广东各省综应课程，对于综应解题技巧有独到的见解，并参与综应各大题型人工批改服务上千份，能够多方面把握学员需求，精准定位学员薄弱点。全面了解事业单位综合应用能力考试的命题规律及答题技巧，授课经验丰富，逻辑清晰，思维严谨，擅长总结，深受广大学员的认可和好评，在学员中具有非常好的口碑，是值得信赖的好导师。&q;,&q;avatar&q;:&q;198411427ad51c5.jpg&q;,&q;upperBodyPhoto&q;:null,&q;displayCoursePrefix&q;:&q;sydw&q;,&q;teacherStat&q;:{&q;teacherId&q;:15514,&q;episodeCount&q;:512,&q;scoreCount&q;:787,&q;avgScore&q;:9.9135959339263,&q;fiveGradeAvgScore&q;:4.96,&q;updateTime&q;:1772548329533},&q;auditionEpisode&q;:{&q;episodeTitle&q;:&q;个人展示课&q;,&q;episodeVideoUrl&q;:&q;https://vod.fbstatic.cn/22e9ceb2vodbj1251001446/5402b0855145403709207407994/antnJrlNvLMA.mp4?t=f2a4b300&a;us=4070880000&a;sign=cd84b92e364976b35f69adb6cf6cd1b7&q;},&q;memberOfCPC&q;:false,&q;tags&q;:null},&q;teachC