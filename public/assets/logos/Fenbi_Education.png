;:&q;&q;}],&q;guidanceArticles&q;:[{&q;title&q;:&q;&q;,&q;jumpLink&q;:&q;&q;}],&q;mainImages&q;:[{&q;title&q;:&q;&q;,&q;jumpLink&q;:&q;&q;,&q;imgUrl&q;:&q;&q;,&q;weight&q;:0}],&q;table&q;:{&q;title&q;:&q;&q;,&q;row&q;:0,&q;column&q;:0,&q;contents&q;:[]}},&q;homepageExams&q;:[{&q;title&q;:&q;&q;,&q;jumpLink&q;:&q;&q;}],&q;publisher&q;:&q;&q;,&q;contentType&q;:0,&q;courseId&q;:710082,&q;saleStatus&q;:0,&q;salesStatus&q;:0,&q;shortName&q;:&q;&q;,&q;explanation&q;:&q;&q;,&q;price&q;:0,&q;priceDisplayType&q;:0,&q;floorPrice&q;:0,&q;topPrice&q;:0,&q;promotionPrice&q;:0,&q;promotionDesc&q;:&q;&q;,&q;studentLimit&q;:0,&q;studentCount&q;:88729,&q;salesText&q;:&q;88729人购买&q;,&q;hasAddress&q;:false,&q;classHours&q;:700,&q;startSaleTime&q;:1741489200000,&q;stopSaleTime&q;:1806451200000,&q;classStartTime&q;:1742727600000,&q;classEndTime&q;:1773064800000,&q;hasExercise&q;:false,&q;hasQQGroup&q;:false,&q;hasImGroup&q;:false,&q;hasClassPeriod&q;:false,&q;hasPosition&q;:false,&q;hasUserContentInfo&q;:false,&q;hasUserExamInfo&q;:false,&q;hasUserFormBeforeOrder&q;:false,&q;hasUserFormAfterOrder&q;:false,&q;hasCustomerService&q;:false,&q;hasRedirectInstructor&q;:false,&q;hasLiveEpisodes&q;:false,&q;hasAudition&q;:false,&q;teachers&q;:[{&q;id&q;:4196,&q;userId&q;:42452354,&q;name&q;:&q;夏雨&q;,&q;brief&q;:&q;粉笔言语优质教师&q;,&q;desc&q;:&q;粉笔言语优质教师，211文科类硕士，13年公考培训经验，长期从事一线教研、教学和培训工作。授课思路清晰严谨，擅于将复杂问题简单化，抽象问题具体化，授课风格平易近人，娓娓道来，循循善诱，深受学生喜爱。&q;,&q;avatar&q;:&q;17150273f201b5b.jpg&q;,&q;upperBodyPhoto&q;:null,&q;displayCoursePrefix&q;:&q;gwy&q;,&q;teacherStat&q;:{&q;teacherId&q;:4196,&q;episodeCount&q;:1208,&q;scoreCount&q;:183138,&q;avgScore&q;:9.77488014502722,&q;fiveGradeAvgScore&q;:4.89,&q;updateTime&q;:1773590769396},&q;auditionEpisode&q;:{&q;episodeTitle&q;:&q;个人展示课&q;,&q;episodeVideoUrl&q;:&q;https://vod.fbstatic.cn/22e9ceb2vodbj1251001446/e2faa75b3560136621448137523/XpsJJWG3kGMA.mp4?t=f2a4b300&a;us=4070880000&a;sign=272350a83a3c4e93359ab1dbab490e24&q;},&q;memberOfCPC&q;:false,&q;tags&q;:null},{&q;id&q;:6668,&q;userId&q;:59143597,&q;name&q;:&q;辛思露&q;,&q;brief&q;:&q;粉笔判断优质教师&q;,&q;desc&q;:&q;粉笔判断优质教师，9年公考授课经验，善于总结试题，对题目有着深刻的思考和把握。授课风格幽默，善于引导，条理清晰，内容讲解深入浅出，课堂氛围轻松，能够让同学们在轻松的氛围中将知识点和题目理解掌握，形成完善的思维体系。是陪同学们在公考旅途上顺利追梦的伙伴。&q;,&q;avatar&q;:&q;171ee85ca6ee3f9.jpg&q;,&q;upperBodyPhoto&q;:null,&q;displayCoursePrefix&q;:&q;gwy&q;,&q;teacherStat&q;:{&q;teacherId&q;:6668,&q;episodeCount&q;:785,&q;scoreCount&q;:147165,&q;avgScore&q;:9.847762715319542,&q;fiveGradeAvgScore&q;:4.92,&q;updateTime&q;:1773589305896},&q;auditionEpisode&q;:{&q;episodeTitle&q;:&q;个人展示课&q;,&q;episodeVideoUrl&q;:&q;https://vod.fbstatic.cn/22e9ceb2vodbj1251001446/a6af7daa3560136621447888184/vzmxZEt9yhwA.mp4?t=f2a4b300&a;us=4070880000&a;sign=57fa891e533285edfa93c3beb306b154&q;},&q;memberOfCPC&q;:false,&q;tags&q;:null},{&q;id&q;:3240,&q;userId&q;:46456478,&q;name&q;:&q;张磊&q;,&q;brief&q;:&q;粉笔数资优质教师&q;,&q;desc&q;:&q;粉笔数资优质教师，8年公考培训经验，参与培训大量师资，定期参加各类教研，编写更新各类数资科目相关图书。理论基础扎实，针对不同程度的学员因材施教，课堂氛围活跃，讲解通俗易懂，授课思路清晰，善于从学员角度思考问题，方法实用性强，是学员上岸路上的良师益友。&q;,&q;avatar&q;:&q;174d423553b3bc3.jpg&q;,&q;upperBodyPhoto&q;:null,&q;displayCoursePrefix&q;:&q;gwy&q;,&q;teacherStat&q;:{&q;teacherId&q;:3240,&q;episodeCount&q;:1100,&q;scoreCount&q;:180144,&q;avgScore&q;:9.815802913224934,&q;fiveGradeAvgScore&q;:4.91,&q;updateTime&q;:1773620795012},&q;auditionEpisode&q;:{&q;episodeTitle&q;:&q;个人展示课&q;,&q;episodeVideoUrl&q;:&q;https://vod.fbstatic.cn/22e9ceb2vodbj1251001446/570526aa3560136621446737687/8nWNryUXslkA.mp4?t=f2a4b300&a;us=4070880000&a;sign=8ec14a3abc870f41bfb320a2daa0a203&q;},&q;memberOfCPC&q;:false,&q;tags&q;:null},{&q;id&q;:1505,&q;userId&q;:39828288,&q;name&q;:&q;邓健&q;,&q;brief&q;:&q;粉笔数资优质教师&q;,&q;desc&q;:&q;粉笔数资优质教师。10年公考授课经验，培训人次超过100万，打分人次超50万；学员评分4.9分，授课逻辑清晰，风格幽默，善于调动学员思考，能将复杂枯燥的内容让学员轻松掌握。&q;,&q;avatar&q;:&q;1714f9f7954c22d.jpg&q;,&q;upperBodyPhoto&q;:null,&q;displayCoursePrefix&q;:&q;gwy&q;,&q;teacherStat&q;:{&q;teacherId&q;:1505,&q;episodeCount&q;:1363,&q;scoreCount&q;:655149,&q;avgScore&q;:9.901591851624621,&q;fiveGradeAvgScore&q;:4.95,&q;updateTime&q;:1773622899126},&q;auditionEpisode&q;:{&q;episodeTitle&q;:&q;个人展示课&q;,&q;episodeVideoUrl&q;:&q;https://vod.fbstatic.cn/22e9ceb2vodbj1251001446/e9d45bdd3560136621448414905/E53pg8IsBaUA.mp4?t=f2a4b300&a;us=4070880000&a;sign=226c5778b0843a5f03efb71521b68243&q;},&q;memberOfCPC&q;:false,&q;tags&q;:null},{&q;id&q;:5234,&q;userId&q;:56626272,&q;name&q;:&q;林凡&q;,&q;brief&q;:&q;粉笔数资优质教师&q;,&q;desc&q;:&q;粉笔数资优质教师，9年公考授课经验，累计授课人次达十万以上，授课评分平均分5.0。曾担任数资科目培训负责人，培训师资数百名。对公考数学有深入理解，授课风格幽默风趣，课堂氛围轻松愉悦。擅长调动学员的数学思维，启发思考，深受学员好评。&q;,&q;avatar&q;:&q;1926fe4e99f0f5b.jpg&q;,&q;upperBodyPhoto&q;:null,&q;displayCoursePrefix&q;:&q;gwy&q;,&q;teacherStat&q;:{&q;teacherId&q;:5234,&q;episodeCount&q;:952,&q;scoreCount&q;:191566,&q;avgScore&q;:9.916436110792063,&q;fiveGradeAvgScore&q;:4.96,&q;updateTime&q;:1773623310342},&q;auditionEpisode&q;:{&q;episodeTitle&q;:&q;个人展示课&q;,&q;episodeVideoUrl&q;:&q;https://vod.fbstatic.cn/22e9ceb2vodbj1251001446/494f935d3560136621446179026/Rebj3P8AYRgA.mp4?t=f2a4b300&a;us=4070880000&a;sign=db0880414e78d1570e2fbd8c3e5016f0&q;},&q;memberOfCPC&q;:false,&q;tags&q;:null},{&q;id&q;:1958,&q;userId&q;:16094527,&q;name&q;:&q;程永乐&q;,&q;brief&q;:&q;粉笔判断优质教师&q;,&q;desc&q;:&q;粉笔判断优质教师，985高校工科硕士。\n10年公考授课经验，打分人次超60万，学员评分高达4.9分，学员口中的“永乐大帝”。\n深谙判断推理出题特点，理论功底扎实，授课思路清晰，耐心细致，风趣幽默。善于从出题思路入手快速破题，深入浅出，注重归纳总结，举一反三。&q;,&q;avatar&q;:&q;196ec50ad55a6e0.jpg&q;,&q;upperBodyPhoto&q;:null,&q;displayCoursePrefix&q;:&q;gwy&q;,&q;teacherStat&q;:{&q;teacherId&q;:1958,&q;episodeCount&q;:1573,&q;scoreCount&q;:820068,&q;avgScore&q;:9.86799387367887,&q;fiveGradeAvgScore&q;:4.93,&q;updateTime&q;:1773623069509},&q;auditionEpisode&q;:{&q;episodeTitle&q;:&q;个人展示课&q;,&q;episodeVideoUrl&q;:&q;https://vod.fbstatic.cn/22e9ceb2vodbj1251001446/ea647b293560136621448493397/AgNBj9JryZ0A.mp4?t=f2a4b300&a;us=4070880000&a;sign=f2afee40504dffe0d47170f69b331867&q;},&q;memberOfCPC&q;:false,&q;tags&q;:null},{&q;id&q;:1191,&q;userId&q;:42494582,&q;name&q;:&q;唐宋&q;,&q;brief&q;:&q;粉笔数资优质教师&q;,&q;desc&q;:&q;粉笔数资优质教师，985高校毕业。 \n15年公考授课经验，打分人次超70万，学员评分高达4.9分。 \n对数量关系与资料分析有深刻的认识和见解，在授课中注重思维引导，善于剖析学员的解题误区，针对性解决问题，解题方法多样，可操作性强。 \n参与主持各类授课研讨会议和教研活动，负责审阅《行测的思维》等多套图书。&q;,&q;avatar&q;:&q;18d405f7e4b8986.jpg&q;,&q;upperBodyPhoto&q;:null,&q;displayCoursePrefix&q;:&q;gwy&q;,&q;teacherStat&q;:{&q;teacherId&q;:1191,&q;episodeCount&q;:1320,&q;scoreCount&q;:782369,&q;avgScore&q;:9.868775475510896,&q;fiveGradeAvgScore&q;:4.93,&q;updateTime&q;:1773622758821},&q;auditionEpisode&q;:{&q;episodeTitle&q;:&q;个人展示课&q;,&q;episodeVideoUrl&q;:&q;https://vod.fbstatic.cn/22e9ceb2vodbj1251001446/9d2164e03560136621447452862/SBy9zjJj7ScA.mp4?t=f2a4b300&a;us=4070880000&a;sign=0cd0cf017d8689074ec85b58c31ca5af&q;},&q;memberOfCPC&q;:false,&q;tags&q;:null},{&q;id&q;:4372,&q;userId&q;:45812058,&q;name&q;:&q;夏方军&q;,&q;brief&q;:&q;粉笔公基优质教师&q;,&q;desc&q;:&q;粉笔公基优质教师，岗位第一考入食药系统，一年编制工作经历，八年公考事业编授课经历。对政治理论、时政常识、面试有深入研究，擅长从热点、考情维度进行预判。授课细致耐心、思维发散清晰，学生的“小姨夫”。&q;,&q;avatar&q;:&q;19407933436c6d4.jpg&q;,&q;upperBodyPhoto&q;:null,&q;displayCoursePrefix&q;:&q;gwy&q;,&q;teacherStat&q;:{&q;teacherId&q;:4372,&q;episodeCount&q;:1059,&q;scoreCount&q;:209965,&q;avgScore&q;:9.894925344700331,&q;fiveGradeAvgScore&q;:4.95,&q;updateTime&q;:1773623280251},&q;auditionEpisode&q;:{&q;episodeTitle&q;:&q;个人展示课&q;,&q;episodeVideoUrl&q;:&q;https://vod.fbstatic.cn/22e9ceb2vodbj1251001446/65771a37243791580257902972/f0.mp4?t=f2a4b300&a;us=4070880000&a;sign=fe62d49b4742040836cd99e0a96d0768&q;},&q;memberOfCPC&q;:false,&q;tags&q;:null},{&q;id&q;:2013,&q;userId&q;:28029131,&q;name&q;:&q;徐来&q;,&q;brief&q;:&q;粉笔判断优质教师&q;,&q;desc&q;:&q;粉笔判断优质教师，应用心理学硕士。13年授课经验，打分人次超50万。讲究题目与技巧的结合，通过对于不同题型特征的总结，帮助考生更快速地找到解题突破口。授课风趣幽默，让学生在轻松的学习氛围中，用更简单、有效的方法，找到更快捷的解题之道。&q;,&q;avatar&q;:&q;1927ad708499b8c.jpg&q;,&q;upperBodyPhoto&q;:null,&q;displayCoursePrefix&q;:&q;gwy&q;,&q;teacherStat&q;:{&q;teacherId&q;:2013,&q;episodeCount&q;:817,&q;scoreCount&q;:635664,&q;avgScore&q;:9.864758740466648,&q;fiveGradeAvgScore&q;:4.93,&q;updateTime&q;:1773619192762},&q;auditionEpisode&q;:{&q;episodeTitle&q;:&q;个人展示课&q;,&q;episodeVideoUrl&q;:&q;https://vod.fbstatic.cn/22e9ceb2vodbj1251001446/9d57b2233560136621447482925/jTwhTLmhwDAA.mp4?t=f2a4b300&a;us=4070880000&a;sign=b7ce314890cc88f571ead60edc9fa8d3&q;},&q;memberOfCPC&q;:false,&q;tags&q;:null},{&q;id&q;:6832,&q;userId&q;:64139692,&q;name&q;:&q;王韵博&q;,&q;brief&q;:&q;粉笔申论面试优质教师&q;,&q;desc&q;:&q;粉笔申论面试优质教师。\n10年公考培训经验，累计一线授课超20000小时，学员评分5.0。对学生的问题都能有针对性的解决办法。授课严谨，见解独到，多方面了解命题规律。风趣幽默，逻辑清晰，营造沉浸式学习氛围，在轻松的环境下，收获更多知识，让学员有所得，有所悟。&q;,&q;avatar&q;:&q;1927ac795361d54.jpg&q;,&q;upperBodyPhoto&q;:null,&q;displayCoursePrefix&q;:&q;gwy&q;,&q;teacherStat&q;:{&q;teacherId&q;:6832,&q;episodeCount&q;:966,&q;scoreCount&q;:170662,&q;avgScore&q;:9.900458215654355,&q;fiveGradeAvgScore&q;:4.95,&q;updateTime&q;:1773621896940},&q;auditionEpisode&q;:{&q;episodeTitle&q;:&q;个人展示课&q;,&q;episodeVideoUrl&q;:&q;https://vod.fbstatic.cn/22e9ceb2vodbj1251001446/5f1e50dc1397757891876772063/MWKFa6GN1IMA.mp4?t=f2a4b300&a;us=4070880000&a;sign=14db4fb731e022ba961306cafa5b6855&q;},&q;memberOfCPC&q;:false,&q;tags&q;:null},{&q;id&q;:13294,&q;userId&q;:40308934,&q;name&q;:&q;陶昶安&q;,&q;brief&q;:&q;粉笔数资优质教师&q;,&q;desc&q;:&q;粉笔数资优质教师，数量经济学研究生毕业。 \n17年公考从业经验，长期钻研公考数量资料模块的命题规律，独立研发并推广多个解题技巧，广受业内好评。 \n授课逻辑清晰、内容全面、认真负责，风格严谨又不失幽默，善于从学员角度出发，帮助学员更好地提升，被学员亲切地称为“考场安老师”。累计授课时长超过20000小时，学员评分达4.9分。 \n从业期间，累计培训师资千余名、编写图书十余部。&q;,&q;avatar&q;:&q;196ec5345e4963e.jpg&q;,&q;upperBodyPhoto&q;:null,&q;displayCoursePrefix&q;:&q;gwy&q;,&q;teacherStat&q;:{&q;teacherId&q;:13294,&q;episodeCount&q;:1047,&q;scoreCount&q;:330982,&q;avgScore&q;:9.880688375803002,&q;fiveGradeAvgScore&q;:4.94,&q;updateTime&q;:1773611809271},&q;auditionEpisode&q;:{&q;episodeTitle&q;:&q;个人展示课&q;,&q;episodeVideoUrl&q;:&q;https://vod.fbstatic.cn/22e9ceb2vodbj1251001446/a870b9223560136621447902918/Pv3XToPc45IA.mp4?t=f2a4b300&a;us=4070880000&a;sign=019c0f384ba6716d5ce30a3dec8fe39d&q;},&q;memberOfCPC&q;:false,&q;tags&q;:null},{&q;id&q;:2322,&q;userId&q;:45183726,&q;name&q;:&q;田鹏&q;,&q;brief&q;:&q;粉笔数资优质教师&q;,&q;desc&q;:&q;粉笔数资优质教师，9年授课经验，长期致力于公务员考试研究，授课时长超过10000小时，培训师资百余人，培训学员超过100万人次。授课思路清晰，善于归纳总结，注重学员思维培养，始终以生动有趣、激发学生思维为教学宗旨，课堂氛围轻松融洽，广受学员好评。&q;,&q;avatar&q;:&q;17249adc5fbd669.jpg&q;,&q;upperBodyPhoto&q;:null,&q;displayCoursePrefix&q;:&q;gwy&q;,&q;teacherStat&q;:{&q;teacherId&q;:2322,&q;episodeCount&q;:1160,&q;scoreCount&q;:307258,&q;avgScore&q;:9.881383072206413,&q;fiveGradeAvgScore&q;:4.94,&q;updateTime&q;:1773623330388},&q;auditionEpisode&q;:{&q;episodeTitle&q;:&q;个人展示课&q;,&q;episodeVideoUrl&q;:&q;https://vod.fbstatic.cn/22e9ceb2vodbj1251001446/ef0e58643560136621448692904/pNA6qCqZjaAA.mp4?t=f2a4b300&a;us=4070880000&a;sign=e665247a9ae24238c3ebd117a1c0fcee&q;},&q;memberOfCPC&q;:false,&q;tags&q;:null},{&q;id&q;:4358,&q;userId&q;:47236786,&q;name&q;:&q;李天然&q;,&q;brief&q;:&q;粉笔公基优质教师&q;,&q;desc&q;:&q;粉笔公基优质教师，8年公考授课经验，累计授课时长超过10000小时，打分人次超25万。政治理论、常识教研带头人，经济学科“扛把子”，参与组织各类授课研讨会议和教研活动。授课富有亲和力，逻辑清晰，深刻了解学员的痛点难点，笔面双科均有丰富经验。&q;,&q;avatar&q;:&q;178babb9016a4de.jpg&q;,&q;upperBodyPhoto&q;:null,&q;displayCoursePrefix&q;:&q;gwy&q;,&q;teacherStat&q;:{&q;teacherId&q;:4358,&q;episodeCount&q;:808,&q;scoreCount&q;:149399,&q;avgScore&q;:9.902181406836727,&q;fiveGradeAvgScore&q;:4.95,&q;updateTime&q;:1773620134214},&q;auditionEpisode&q;:{&q;episodeTitle&q;:&q;个人展示课&q;,&q;episodeVideoUrl&q;:&q;https://vod.fbstatic.cn/22e9ceb2vodbj1251001446/32f13223243791580005151632/f0.mp4?t=f2a4b300&a;us=4070880000&a;sign=01471f2ae73fade13a6822de5cd010e1&q;},&q;memberOfCPC&q;:false,&q;tags&q;:null},{&q;id&q;:1779,&q;userId&q;:44420612,&q;name&q;:&q;明蕾&q;,&q;brief&q;:&q;粉笔言语优质教师&q;,&q;desc&q;:&q;粉笔言语优质教师，文科类硕士\n11年公考授课经验，打分人次超60万，学员评分高达4.9分。\n言语理论基本功扎实，教学经验丰富，授课思路清晰、重点突出，善于引导和总结，注重培养学员举一反三的能力，深受学员好评。&q;,&q;avatar&q;:&q;1718adf9442d3aa.jpg&q;,&q;upperBodyPhoto&q;:null,&q;displayCoursePrefix&q;:&q;gwy&q;,&q;teacherStat&q;:{&q;teacherId&q;:1779,&q;episodeCount&q;:1221,&q;scoreCount&q;:711933,&q;avgScore&q;:9.856694379948717,&q;fiveGradeAvgScore&q;:4.93,&q;updateTime&q;:1773617671467},&q;auditionEpisode&q;:{&q;episodeTitle&q;:&q;个人展示课&q;,&q;episodeVideoUrl&q;:&q;https://vod.fbstatic.cn/22e9ceb2vodbj1251001446/9cec1afc3560136621447424292/iEATIpvLLIQA.mp4?t=f2a4b300&a;us=4070880000&a;sign=63c6130e26890e04c6b2856e24c1f1da&q;},&q;memberOfCPC&q;:false,&q;tags&q;:null},{&q;id&q;:3198,&q;userId&q;:43782348,&q;name&q;:&q;安杰&q;,&q;brief&q;:&q;粉笔言语优质教师&q;,&q;desc&q;:&q;粉笔言语优质教师，硕士学历，10年公考授课经验，学员评分高达4.9分，被学员亲切称为“二舅”。授课端，善于把握考情趋势，将知识点融会贯通，迅速厘清重点难点。培训端，为行业培养上百名优秀教师。&q;,&q;avatar&q;:&q;171ee8a2fecad21.jpg&q;,&q;upperBodyPhoto&q;:null,&q;displayCoursePrefix&q;:&q;gwy&q;,&q;teacherStat&q;:{&q;teacherId&q;:3198,&q;episodeCount&q;:1375,&q;scoreCount&q;:532049,&q;avgScore&q;:9.863429872060653,&q;fiveGradeAvgScore&q;:4.93,&q;updateTime&q;:1773623129594},&q;auditionEpisode&q;:{&q;episodeTitle&q;:&q;个人展示课&q;,&q;episodeVideoUrl&q;:&q;https://vod.fbstatic.cn/22e9ceb2vodbj1251001446/9f9d6ba73560136621447577483/bsphLRtOyaAA.mp4?t=f2a4b300&a;us=4070880000&a;sign=615c6ec215235eec9be3da23e83f2652&q;},&q;memberOfCPC&q;:false,&q;tags&q;:null},{&q;id&q;:3227,&q;userId&q;:43496984,&q;name&q;:&q;杨亚辉&q;,&q;brief&q;:&q;粉笔数资优质教师&q;,&q;desc&q;:&q;粉笔数资优质教师。\n研究生学历，管理学硕士。9年公考授课经验，累计授课人次超百万，累计授课时长超过8000小时。理论功底扎实，态度严谨认真，亲切耐心细致，善于引导学生对解题方法进行思考和总结，被学生亲切的称为“叨叨羊”。&q;,&q;avatar&q;:&q;1928e488a32a13c.jpg&q;,&q;upperBodyPhoto&q;:null,&q;displayCoursePrefix&q;:&q;gwy&q;,&q;teacherStat&q;:{&q;teacherId&q;:3227,&q;episodeCount&q;:849,&q;scoreCount&q;:125321,&q;avgScore&q;:9.898069756864372,&q;fiveGradeAvgScore&q;:4.95,&q;updateTime&q;:1773621926967},&q;auditionEpisode&q;:{&q;episodeTitle&q;:&q;个人展示课&q;,&q;episodeVideoUrl&q;:&q;https://vod.fbstatic.cn/22e9ceb2vodbj1251001446/c8177c031397757891881665865/CAeSujbHBMwA.mp4?t=f2a4b300&a;us=4070880000&a;sign=013d5be831be3414393c2ade04a7788b&q;},&q;memberOfCPC&q;:false,&q;tags&q;:null},{&q;id&q;:7754,&q;userId&q;:61196798,&q;name&q;:&q;王东岳&q;,&q;brief&q;:&q;粉笔判断优质教师&q;,&q;desc&q;:&q;粉笔判断优质教师。\n7年授课经验，累计授课时长6000+，授课评分4.9+，培训学员100余万人次。有着多年丰富的国考及省考授课经验，逻辑框架清晰。授课风格深入浅出，结构严谨又不乏幽默；授课内容直指考试核心。教学方式多样，因材施教，掌握学生心理，深受学员欢迎。\n参与制作国省考授课讲义、《行测的思维》、《决战行测5000题》等多套图书。&q;,&q;avatar&q;:&q;1928e11bb6d26f0.jpg&q;,&q;upperBodyPhoto&q;:null,&q;displayCoursePrefix&q;:&q;gwy&q;,&q;teacherStat&q;:{&q;teacherId&q;:7754,&q;episodeCount&q;:1301,&q;scoreCount&q;:243516,&q;avgScore&q;:9.87308431478835,&q;fiveGradeAvgScore&q;:4.94,&q;updateTime&q;:1773620855135},&q;auditionEpisode&q;:{&q;episodeTitle&q;:&q;个人展示课&q;,&q;episodeVideoUrl&q;:&q;https://vod.fbstatic.cn/22e9ceb2vodbj1251001446/4bb38a333560136621446283020/WcYGrU72AukA.mp4?t=f2a4b300&a;us=4070880000&a;sign=0634969fb328a1e47afdf3e0332c5544&q;},&q;memberOfCPC&q;:false,&q;tags&q;:null},{&q;id&q;:4996,&q;userId&q;:51581932,&q;name&q;:&q;司琦&q;,&q;brief&q;:&q;粉笔言语优质教师&q;,&q;desc&q;:&q;粉笔言语优质教师，8年授课经验，长期深耕公务员行测言语模块，精准把握命题趋势，对各类题型有着独到的见解，曾负责师资培训、模拟题撰写和教材编写等工作。教学中，注重因材施教，助力学员夯实基础、提升能力。授课风格幽默且严谨，讲解深入浅出，让复杂的知识变得通俗易懂，深受学员好评。&q;,&q;avatar&q;:&q;19270dc6dfb73cb.jpg&q;,&q;upperBodyPhoto&q;:null,&q;displayCoursePrefix&q;:&q;gwy&q;,&q;teacherStat&q;:{&q;teacherId&q;:4996,&q;episodeCount&q;:1396,&q;scoreCount&q;:216731,&q;avgScore&q;:9.871767306015292,&q;fiveGradeAvgScore&q;:4.94,&q;updateTime&q;:1773594524697},&q;auditionEpisode&q;:{&q;episodeTitle&q;:&q;个人展示课&q;,&q;episodeVideoUrl&q;:&q;https://vod.fbstatic.cn/22e9ceb2vodbj1251001446/9cc6e9f83560136621447402832/oxLbyW9tbc4A.mp4?t=f2a4b300&a;us=4070880000&a;sign=742574c1fe64d1e966a0d28dfe74cc08&q;},&q;memberOfCPC&q;:false,&q;tags&q;:null},{&q;id&q;:1491,&q;userId&q;:40445632,&q;name&q;:&q;李纳&q;,&q;brief&q;:&q;粉笔申论优质教师&q;,&q;desc&q;:&q;粉笔申论优质老师，\n9年公考授课经验，打分人次超20万，学员评分高达4.9分。\n长期致力于公考研究，对试题有深刻的把握和独到的见解。注重因材施教，授课深入浅出、通俗易懂。富有激情又不失幽默，课堂氛围活跃。&q;,&q;avatar&q;:&q;17587d0e130748e.jpg&q;,&q;upperBodyPhoto&q;:null,&q;displayCoursePrefix&q;:&q;gwy&q;,&q;teacherStat&q;:{&q;teacherId&q;:1491,&q;episodeCount&q;:1101,&q;scoreCount&q;:402422,&q;avgScore&q;:9.854351899250036,&q;fiveGradeAvgScore&q;:4.93,&q;updateTime&q;:1773585181685},&q;auditionEpisode&q;:{&q;episodeTitle&q;:&q;个人展示课&q;,&q;episodeVideoUrl&q;:&q;https://vod.fbstatic.cn/22e9ceb2vodbj1251001446/a3c805883560136621447705797/W2Ucye2AjXgA.mp4?t=f2a4b300&a;us=4070880000&a;sign=a628916274f31ee68e9e0419239f215e&q;},&q;memberOfCPC&q;:false,&q;tags&q;:null},{&q;id&q;:3824,&q;userId&q;:40174320,&q;name&q;:&q;江澄&q;,&q;brief&q;:&q;粉笔申论优质教师&q;,&q;desc&q;:&q;粉笔申论优质教师，曾受邀担任政府机关公文写作培训主讲。8年公考授课经验，打分人次超16万，学员评分高达4.9分。 \n考点把握精准，授课重点突出，善于总结拓展，教学实用性强，能够及时发现学员的个性化问题，因材施教。&q;,&q;avatar&q;:&q;1954bf50a3a4e0a.jpg&q;,&q;upperBodyPhoto&q;:null,&q;displayCoursePrefix&q;:&q;gwy&q;,&q;teacherStat&q;:{&q;teacherId&q;:3824,&q;episodeCount&q;:1475,&q;scoreCount&q;:235460,&q;avgScore&q;:9.865624734562134,&q;fiveGradeAvgScore&q;:4.93,&q;updateTime&q;:1773620554674},&q;auditionEpisode&q;:{&q;episodeTitle&q;:&q;个人展示课&q;,&q;episodeVideoUrl&q;:&q;https://vod.fbstatic.cn/22e9ceb2vodbj1251001446/98ad3b5b3560136621447282082/3LnOnFkB4YoA.mp4?t=f2a4b300&a;us=4070880000&a;sign=5fa092dd930dd9ec24f161c367231eed&q;},&q;memberOfCPC&q;:false,&q;tags&q;:null},{&q;id&q;:5249,&q;userId&q;:50327108,&q;name&q;:&q;马清&q;,&q;brief&q;:&q;粉笔判断优质教师&q;,&q;desc&q;:&q;粉笔判断优质教师，七年公考授课经验。授课经验丰富，理论功底扎实。曾多次进面且省考笔面第一上岸。能够精准把握国省考考试中的重难点，逻辑清晰、思维严谨、表达准确。授课深入浅出，能够有实效性的帮助学生用简单方法快速解题。&q;,&q;avatar&q;:&q;16391969ce9d96d.jpg&q;,&q;upperBodyPhoto&q;:null,&q;displayCoursePrefix&q;:&q;gwy&q;,&q;teacherStat&q;:{&q;teacherId&q;:5249,&q;episodeCount&q;:1152,&q;scoreCount&q;:245375,&q;avgScore&q;:9.863824758023434,&q;fiveGradeAvgScore&q;:4.93,&q;updateTime&q;:1773597196517},&q;auditionEpisode&q;:{&q;episodeTitle&q;:&q;个人展示课&q;,&q;episodeVideoUrl&q;:&q;https://vod.fbstatic.cn/22e9ceb2vodbj1251001446/fa2346df3560136621445097075/tFApT6FadXkA.mp4?t=f2a4b300&a;us=4070880000&a;sign=f2dfec9da242cdd11abb83870c910840&q;},&q;memberOfCPC&q;:false,&q;tags&q;:null},{&q;id&q;:5442,&q;userId&q;:57074161,&q;name&q;:&q;徐夏&q;,&q;brief&q;:&q;粉笔判断优质教师&q;,&q;desc&q;:&q;粉笔判断优质教师，法学硕士，西北师资中心教研总监。13年公考授课经验，打分人次超30万，学员评分高达4.9，多次亲历公务员录用考试笔试、面试全过程，具有丰富的实战经验和教学经验。授课思路清晰，善于把难以理解的逻辑学知识与日常生活紧密联系，提升学员听课效率。重视学员参与性，幽默风趣，富有激情，在学员中具有非常好的口碑，是值得信赖的好导师。&q;,&q;avatar&q;:&q;196ec520eb2f0d2.jpg&q;,&q;upperBodyPhoto&q;:null,&q;displayCoursePrefix&q;:&q;gwy&q;,&q;teacherStat&q;:{&q;teacherId&q;:5442,&q;episodeCount&q;:1092,&q;scoreCount&q;:524991,&q;avgScore&q;:9.84035916806193,&q;fiveGradeAvgScore&q;:4.92,&q;updateTime&q;:1773623300311},&q;auditionEpisode&q;:{&q;episodeTitle&q;:&q;个人展示课&q;,&q;episodeVideoUrl&q;:&q;https://vod.fbstatic.cn/22e9ceb2vodbj1251001446/ec726f483560136621448555856/Z302a8en6KkA.mp4?t=f2a4b300&a;us=4070880000&a;sign=8d1c076835441a2123354067cd7bc36f&q;},&q;memberOfCPC&q;:false,&q;tags&q;:null},{&q;id&q;:21356,&q;userId&q;:74166806,&q;name&q;:&q;李陈&q;,&q;brief&q;:&q;粉笔判断优质教师&q;,&q;desc&q;:&q;粉笔判断优质教师，纽约大学理学硕士。 \n国考部委高分考生，5年公考授课经验，累积授课时长超2000小时。 \n作为判断教研组成员，每年参与系统班、精品班课程设计，图书更新，AI测试等工作，理论功底扎实，授课逻辑清晰，善于归纳总结，深受学生喜爱。&q;,&q;avatar&q;:&q;179f4e980a2a9c2.jpg&q;,&q;upperBodyPhoto&q;:null,&q;displayCoursePrefix&q;:&q;gwy&q;,&q;teacherStat&q;:{&q;teacherId&q;:21356,&q;episodeCount&q;:630,&q;scoreCount&q;:58216,&q;avgScore&q;:9.906589253813385,&q;fiveGradeAvgScore&q;:4.95,&q;updateTime&q;:1773591681002},&q;auditionEpisode&q;:{&q;episodeTitle&q;:&q;个人展示课&q;,&q;episodeVideoUrl&q;:&q;https://vod.fbstatic.cn/22e9ceb2vodbj1251001446/93a914d83560136621447033634/KARgUYgs6AEA.mp4?t=f2a4b300&a;us=4070880000&a;sign=0b98f8bdbbcb817fcb78cbd713914cc1&q;},&q;memberOfCPC&q;:false,&q;tags&q;:null},{&q;id&q;:4499,&q;userId&q;:40708126,&q;name&q;:&q;焦点&q;,&q;brief&q;:&q;粉笔数资优质教师&q;,&q;desc&q;:&q;粉笔数资优质教师，12年公考培训经验，3年选调生就职经历。考场经验丰富，授课思路清晰，讲解细致，善于引导学员获得公考数学思维，能精准判断学员的薄弱点，并帮助学员扬长补短，调整心态，在考场遇见更好的自己。&q;,&q;avatar&q;:&q;18bd5fc8090fc53.jpg&q;,&q;upperBodyPhoto&q;:null,&q;displayCoursePrefix&q;:&q;gwy&q;,&q;teacherStat&q;:{&q;teacherId&q;:4499,&q;episodeCount&q;:1259,&q;scoreCount&q;:206839,&q;avgScore&q;:9.859281856903227,&q;fiveGradeAvgScore&q;:4.93,&q;updateTime&q;:1773590939778},&q;auditionEpisode&q;:{&q;episodeTitle&q;:&q;个人展示课&q;,&q;episodeVideo