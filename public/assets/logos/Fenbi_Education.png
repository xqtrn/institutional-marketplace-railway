vePk&q;:true},{&q;id&q;:11093307,&q;kePrefix&q;:&q;sydw&q;,&q;courseId&q;:6,&q;status&q;:3,&q;playStatus&q;:3,&q;type&q;:33,&q;recordingType&q;:0,&q;mediaType&q;:0,&q;title&q;:&q;【公基非法】精选好题 沉浸刷题&q;,&q;innerTitle&q;:&q;&q;,&q;startTime&q;:1760407200000,&q;endTime&q;:1760414400000,&q;teacher&q;:{&q;id&q;:34151,&q;userId&q;:83887928,&q;name&q;:&q;颜瑞&q;,&q;brief&q;:&q;粉笔优质讲师&q;,&q;desc&q;:&q;粉笔优质讲师\n5年一线教学经验，教学教研经验丰富。授课思路开阔，善于举一反三，引导和启发学生；课堂互动性强，善于从学员角度出发解决问题；授课风格循循善诱，细致耐心，寓教于乐给予个性化帮助，授课产品类型丰富，评分高达4.9，深受学生喜爱。\n教研上，常识公基科目实践经验及专业理论知识扎实丰富，对常识公基非法考情把握恰当，并负责多科目单题录制工作，并且多次参与命制笔试真题教研、解析以及教研文章撰写工作，致力于深入探究常识公基的命题规律及拿分技巧。&q;,&q;avatar&q;:&q;193af63981634c3.jpg&q;,&q;upperBodyPhoto&q;:null,&q;displayCoursePrefix&q;:&q;sydw&q;,&q;teacherStat&q;:{&q;teacherId&q;:34151,&q;episodeCount&q;:764,&q;scoreCount&q;:928,&q;avgScore&q;:9.73275862068965,&q;fiveGradeAvgScore&q;:4.87,&q;updateTime&q;:1773579803077},&q;auditionEpisode&q;:{&q;episodeTitle&q;:&q;个人展示课&q;,&q;episodeVideoUrl&q;:&q;https://vod.fbstatic.cn/22e9ceb2vodbj1251001446/852adeed5145403709544842797/4NI3eZVTCIgA.mp4?t=f2a4b300&a;us=4070880000&a;sign=8b0451bae7287a818ba1ca53e0d1a8cd&q;},&q;memberOfCPC&q;:false,&q;tags&q;:null},&q;teachChannel&q;:1,&q;offline&q;:null,&q;duration&q;:7741,&q;hasAudition&q;:false,&q;bizType&q;:0,&q;bizId&q;:&q;726825&q;,&q;supportReplay&q;:true,&q;extraInfo&q;:null,&q;liveConfig&q;:{&q;episodeId&q;:11093307,&q;supportMultiGroup&q;:false,&q;exerciseBizType&q;:0,&q;videoDisplayType&q;:0,&q;avForwardType&q;:0,&q;useIntelligentRoom&q;:false,&q;hasStrokeKeynote&q;:true,&q;verticalModeType&q;:0,&q;originEpisodeId&q;:0,&q;supportRtmp&q;:false,&q;supportPk&q;:true,&q;supportLuckyBag&q;:true,&q;supportUserNoteStroke&q;:false,&q;communicateType&q;:0,&q;one2One&q;:false,&q;fakeLive&q;:false},&q;validStatus&q;:1,&q;supportLive&q;:true,&q;supportAiCatalog&q;:false,&q;hasIntelligentPen&q;:false,&q;useLocalRecording&q;:false,&q;useIntelligentRoom&q;:false,&q;hasSalePosition&q;:false,&q;hasEpisodeCards&q;:true,&q;lockedForShouna&q;:false,&q;needSignIn&q;:false,&q;needTeacherSignIn&q;:false,&q;enablePadPencil&q;:true,&q;displayExercise&q;:false,&q;supportLuckyBag&q;:true,&q;supportLivePk&q;:true},{&q;id&q;:11093329,&q;kePrefix&q;:&q;sydw&q;,&q;courseId&q;:6,&q;status&q;:3,&q;playStatus&q;:3,&q;type&q;:33,&q;recordingType&q;:0,&q;mediaType&q;:0,&q;title&q;:&q;【判断】精选好题 沉浸刷题&q;,&q;innerTitle&q;:&q;&q;,&q;startTime&q;:1760414400000,&q;endTime&q;:1760421600000,&q;teacher&q;:{&q;id&q;:56387,&q;userId&q;:95238878,&q;name&q;:&q;唐可乐&q;,&q;brief&q;:&q;粉笔优质讲师&q;,&q;desc&q;:&q;粉笔优质教师\n6年一线教学经验，具有判断科目丰富的实践经验以及系统扎实的专业理论知识，对事业单位的考情深入研究，多次参与粉笔组织的各类授课能研讨会议和面试教研活动，共同助力粉笔笔试理论的研发与升级，授课风格幽默风趣，耐心解答学生问题，让学生在轻松的学习氛围中，用更简单的方法，找到更快捷的解题之道，深受广大学员的认可和好评。&q;,&q;avatar&q;:&q;1841838ea98e147.jpg&q;,&q;upperBodyPhoto&q;:null,&q;displayCoursePrefix&q;:&q;sydw&q;,&q;teacherStat&q;:{&q;teacherId&q;:56387,&q;episodeCount&q;:244,&q;scoreCount&q;:751,&q;avgScore&q;:9.797603195739004,&q;fiveGradeAvgScore&q;:4.9,&q;updateTime&q;:1773581000733},&q;auditionEpisode&q;:{&q;episodeTitle&q;:&q;个人展示课&q;,&q;episodeVideoUrl&q;:&q;https://vod.fbstatic.cn/22e9ceb2vodbj1251001446/8342d7ee1397757912785015921/dmPKNp90hJgA.mp4?t=f2a4b300&a;us=4070880000&a;sign=c7fe6933f00b336b152ad7e6dc41eff8&q;},&q;memberOfCPC&q;:false,&q;tags&q;:null},&q;teachChannel&q;:1,&q;offline&q;:null,&q;duration&q;:7555,&q;hasAudition&q;:false,&q;bizType&q;:0,&q;bizId&q;:&q;726825&q;,&q;supportReplay&q;:true,&q;extraInfo&q;:null,&q;liveConfig&q;:{&q;episodeId&q;:11093329,&q;supportMultiGroup&q;:false,&q;exerciseBizType&q;:0,&q;videoDisplayType&q;:0,&q;avForwardType&q;:0,&q;useIntelligentRoom&q;:false,&q;hasStrokeKeynote&q;:true,&q;verticalModeType&q;:0,&q;originEpisodeId&q;:0,&q;supportRtmp&q;:false,&q;supportPk&q;:true,&q;supportLuckyBag&q;:true,&q;supportUserNoteStroke&q;:false,&q;communicateType&q;:0,&q;one2One&q;:false,&q;fakeLive&q;:false},&q;validStatus&q;:1,&q;supportLive&q;:true,&q;supportAiCatalog&q;:false,&q;hasIntelligentPen&q;:false,&q;useLocalRecording&q;:false,&q;useIntelligentRoom&q;:false,&q;hasSalePosition&q;:false,&q;hasEpisodeCards&q;:true,&q;lockedForShouna&q;:false,&q;needSignIn&q;:false,&q;needTeacherSignIn&q;:false,&q;enablePadPencil&q;:true,&q;displayExercise&q;:false,&q;supportLuckyBag&q;:true,&q;supportLivePk&q;:true},{&q;id&q;:11093359,&q;kePrefix&q;:&q;sydw&q;,&q;courseId&q;:6,&q;status&q;:3,&q;playStatus&q;:3,&q;type&q;:33,&q;recordingType&q;:0,&q;mediaType&q;:0,&q;title&q;:&q;【综应】精选好题 沉浸刷题&q;,&q;innerTitle&q;:&q;&q;,&q;startTime&q;:1760421600000,&q;endTime&q;:1760428800000,&q;teacher&q;:{&q;id&q;:26288,&q;userId&q;:52871684,&q;name&q;:&q;刘开心&q;,&q;brief&q;:&q;粉笔优质讲师&q;,&q;desc&q;:&q;粉笔优质教师\n5年一线教学经验，具有系统的专业理论知识。在职期间除了完成授课，同时兼顾教学研讨，熟悉命题及各地区考情动态，能力扎实。\n累计带笔试班学员人数超2000人，学员整体评分维持在4.8分以上；累计授课超过1000小时，评分达4.9分以上。\n课堂氛围轻松融洽，授课重点突出，思路清晰，讲解耐心细致，语言通俗易懂，擅长引导学生自主思考，并根据学生的不同情况和需求进行个性化指导。&q;,&q;avatar&q;:&q;17692b3ab794012.jpg&q;,&q;upperBodyPhoto&q;:null,&q;displayCoursePrefix&q;:&q;sydw&q;,&q;teacherStat&q;:{&q;teacherId&q;:26288,&q;episodeCount&q;:281,&q;scoreCount&q;:253,&q;avgScore&q;:9.794466403162055,&q;fiveGradeAvgScore&q;:4.9,&q;updateTime&q;:1773542090440},&q;auditionEpisode&q;:null,&q;memberOfCPC&q;:false,&q;tags&q;:null},&q;teachChannel&q;:1,&q;offline&q;:null,&q;duration&q;:7240,&q;hasAudition&q;:false,&q;bizType&q;:0,&q;bizId&q;:&q;726825&q;,&q;supportReplay&q;:true,&q;extraInfo&q;:null,&q;liveConfig&q;:{&q;episodeId&q;:11093359,&q;supportMultiGroup&q;:false,&q;exerciseBizType&q;:0,&q;videoDisplayType&q;:0,&q;avForwardType&q;:0,&q;useIntelligentRoom&q;:false,&q;hasStrokeKeynote&q;:true,&q;verticalModeType&q;:0,&q;originEpisodeId&q;:0,&q;supportRtmp&q;:false,&q;supportPk&q;:true,&q;supportLuckyBag&q;:true,&q;supportUserNoteStroke&q;:false,&q;communicateType&q;:0,&q;one2One&q;:false,&q;fakeLive&q;:false},&q;validStatus&q;:1,&q;supportLive&q;:true,&q;supportAiCatalog&q;:false,&q;hasIntelligentPen&q;:false,&q;useLocalRecording&q;:false,&q;useIntelligentRoom&q;:false,&q;hasSalePosition&q;:false,&q;hasEpisodeCards&q;:true,&q;lockedForShouna&q;:false,&q;needSignIn&q;:false,&q;needTeacherSignIn&q;:false,&q;enablePadPencil&q;:true,&q;displayExercise&q;:false,&q;supportLuckyBag&q;:true,&q;supportLivePk&q;:true},{&q;id&q;:11093361,&q;kePrefix&q;:&q;sydw&q;,&q;courseId&q;:6,&q;status&q;:3,&q;playStatus&q;:3,&q;type&q;:33,&q;recordingType&q;:0,&q;mediaType&q;:0,&q;title&q;:&q;【言语】精选好题 沉浸刷题&q;,&q;innerTitle&q;:&q;&q;,&q;startTime&q;:1760428800000,&q;endTime&q;:1760436000000,&q;teacher&q;:{&q;id&q;:14565,&q;userId&q;:48370970,&q;name&q;:&q;王清悦&q;,&q;brief&q;:&q;粉笔优质讲师&q;,&q;desc&q;:&q;粉笔优质讲师\n8年一线教学经验，教学风格严谨而不失活泼，善于将复杂的知识点以生动有趣的方式呈现，让学生轻松掌握。对于考试考点有着敏锐的洞察力和精准的把握能力，帮助学生有效备考，事半功倍。我坚信，教育不仅仅是知识的传授，更是思维的启迪与人格的塑造，因此，始终致力于培养学生的独立思考能力与解决问题的能力，助力他们在人生的每一个阶段都能自信前行。&q;,&q;avatar&q;:&q;173d720cea24b6c.jpg&q;,&q;upperBodyPhoto&q;:null,&q;displayCoursePrefix&q;:&q;sydw&q;,&q;teacherStat&q;:{&q;teacherId&q;:14565,&q;episodeCount&q;:477,&q;scoreCount&q;:1439,&q;avgScore&q;:9.745656706045871,&q;fiveGradeAvgScore&q;:4.87,&q;updateTime&q;:1773559873082},&q;auditionEpisode&q;:{&q;episodeTitle&q;:&q;个人展示课&q;,&q;episodeVideoUrl&q;:&q;https://vod.fbstatic.cn/22e9ceb2vodbj1251001446/cbd1293d5145403707742801437/WSGdVtt1L3AA.mp4?t=f2a4b300&a;us=4070880000&a;sign=a446564dcadd70a9b99e6d27e1f0ecde&q;},&q;memberOfCPC&q;:false,&q;tags&q;:null},&q;teachChannel&q;:1,&q;offline&q;:null,&q;duration&q;:8173,&q;hasAudition&q;:false,&q;bizType&q;:0,&q;bizId&q;:&q;726825&q;,&q;supportReplay&q;:true,&q;extraInfo&q;:null,&q;liveConfig&q;:{&q;episodeId&q;:11093361,&q;supportMultiGroup&q;:false,&q;exerciseBizType&q;:0,&q;videoDisplayType&q;:0,&q;avForwardType&q;:0,&q;useIntelligentRoom&q;:false,&q;hasStrokeKeynote&q;:true,&q;verticalModeType&q;:0,&q;originEpisodeId&q;:0,&q;supportRtmp&q;:false,&q;supportPk&q;:true,&q;supportLuckyBag&q;:true,&q;supportUserNoteStroke&q;:false,&q;communicateType&q;:0,&q;one2One&q;:false,&q;fakeLive&q;:false},&q;validStatus&q;:1,&q;supportLive&q;:true,&q;supportAiCatalog&q;:false,&q;hasIntelligentPen&q;:false,&q;useLocalRecording&q;:false,&q;useIntelligentRoom&q;:false,&q;hasSalePosition&q;:false,&q;hasEpisodeCards&q;:true,&q;lockedForShouna&q;:false,&q;needSignIn&q;:false,&q;needTeacherSignIn&q;:false,&q;enablePadPencil&q;:true,&q;displayExercise&q;:false,&q;supportLuckyBag&q;:true,&q;supportLivePk&q;:true},{&q;id&q;:11093363,&q;kePrefix&q;:&q;sydw&q;,&q;courseId&q;:6,&q;status&q;:3,&q;playStatus&q;:3,&q;type&q;:33,&q;recordingType&q;:0,&q;mediaType&q;:0,&q;title&q;:&q;【公基法律】精选好题 沉浸刷题&q;,&q;innerTitle&q;:&q;&q;,&q;startTime&q;:1760500800000,&q;endTime&q;:1760508000000,&q;teacher&q;:{&q;id&q;:32808,&q;userId&q;:83059591,&q;name&q;:&q;杨恬&q;,&q;brief&q;:&q;粉笔优质讲师&q;,&q;desc&q;:&q;粉笔优质讲师。\n五年一线教学授课经验，深耕一线考试，承担过多种班型授课，经验丰富。\n多次参与笔试真题教研和解析撰写、模拟题撰写等工作，具有常识公基法律科目丰富的实践经验及系统扎实的专业理论知识，对常识公基法律考情有深入研究。\n累计带班学员超2000人，累计授课评分达4.9分，善于将知识以通俗易懂的方式进行讲解，课堂氛围轻松融洽。授课重点突出，能够及时总结拓展，广受学员好评。&q;,&q;avatar&q;:&q;193af6183f51cdd.jpg&q;,&q;upperBodyPhoto&q;:null,&q;displayCoursePrefix&q;:&q;sydw&q;,&q;teacherStat&q;:{&q;teacherId&q;:32808,&q;episodeCount&q;:454,&q;scoreCount&q;:842,&q;avgScore&q;:9.821852731591449,&q;fiveGradeAvgScore&q;:4.91,&q;updateTime&q;:1773115152848},&q;auditionEpisode&q;:{&q;episodeTitle&q;:&q;个人展示课&q;,&q;episodeVideoUrl&q;:&q;https://vod.fbstatic.cn/22e9ceb2vodbj1251001446/c5ad3d005145403709538520842/7oXi70wDlacA.mp4?t=f2a4b300&a;us=4070880000&a;sign=fb07f07d913a537688e0a54d439803e7&q;},&q;memberOfCPC&q;:false,&q;tags&q;:null},&q;teachChannel&q;:1,&q;offline&q;:null,&q;duration&q;:8217,&q;hasAudition&q;:false,&q;bizType&q;:0,&q;bizId&q;:&q;726825&q;,&q;supportReplay&q;:true,&q;extraInfo&q;:null,&q;liveConfig&q;:{&q;episodeId&q;:11093363,&q;supportMultiGroup&q;:false,&q;exerciseBizType&q;:0,&q;videoDisplayType&q;:0,&q;avForwardType&q;:0,&q;useIntelligentRoom&q;:false,&q;hasStrokeKeynote&q;:true,&q;verticalModeType&q;:0,&q;originEpisodeId&q;:0,&q;supportRtmp&q;:false,&q;supportPk&q;:true,&q;supportLuckyBag&q;:true,&q;supportUserNoteStroke&q;:false,&q;communicateType&q;:0,&q;one2One&q;:false,&q;fakeLive&q;:false},&q;validStatus&q;:1,&q;supportLive&q;:true,&q;supportAiCatalog&q;:false,&q;hasIntelligentPen&q;:false,&q;useLocalRecording&q;:false,&q;useIntelligentRoom&q;:false,&q;hasSalePosition&q;:false,&q;hasEpisodeCards&q;:true,&q;lockedForShouna&q;:false,&q;needSignIn&q;:false,&q;needTeacherSignIn&q;:false,&q;enablePadPencil&q;:true,&q;displayExercise&q;:false,&q;supportLuckyBag&q;:true,&q;supportLivePk&q;:true},{&q;id&q;:11093364,&q;kePrefix&q;:&q;sydw&q;,&q;courseId&q;:6,&q;status&q;:3,&q;playStatus&q;:3,&q;type&q;:33,&q;recordingType&q;:0,&q;mediaType&q;:0,&q;title&q;:&q;【公基非法】精选好题 沉浸刷题&q;,&q;innerTitle&q;:&q;&q;,&q;startTime&q;:1760508000000,&q;endTime&q;:1760515200000,&q;teacher&q;:{&q;id&q;:18668,&q;userId&q;:69522017,&q;name&q;:&q;王杉&q;,&q;brief&q;:&q;粉笔优质讲师&q;,&q;desc&q;:&q;粉笔优质讲师。拥有六年一线授课经验，参与多种课程类型的教学，积累了丰富的授课经验。在常识公共基础知识和言语科目教学中，结合山东、福建、四川、江苏等地的地方考情，深入理解真题命题方向。授课风格幽默活泼，善于将时事热点与理论知识结合，帮助学生更好地理解和记忆。&q;,&q;avatar&q;:&q;193af589c3b05e6.jpg&q;,&q;upperBodyPhoto&q;:null,&q;displayCoursePrefix&q;:&q;sydw&q;,&q;teacherStat&q;:{&q;teacherId&q;:18668,&q;episodeCount&q;:613,&q;scoreCount&q;:1605,&q;avgScore&q;:9.823052959501561,&q;fiveGradeAvgScore&q;:4.91,&q;updateTime&q;:1773481515764},&q;auditionEpisode&q;:null,&q;memberOfCPC&q;:false,&q;tags&q;:null},&q;teachChannel&q;:1,&q;offline&q;:null,&q;duration&q;:8387,&q;hasAudition&q;:false,&q;bizType&q;:0,&q;bizId&q;:&q;726825&q;,&q;supportReplay&q;:true,&q;extraInfo&q;:null,&q;liveConfig&q;:{&q;episodeId&q;:11093364,&q;supportMultiGroup&q;:false,&q;exerciseBizType&q;:0,&q;videoDisplayType&q;:0,&q;avForwardType&q;:0,&q;useIntelligentRoom&q;:false,&q;hasStrokeKeynote&q;:true,&q;verticalModeType&q;:0,&q;originEpisodeId&q;:0,&q;supportRtmp&q;:false,&q;supportPk&q;:true,&q;supportLuckyBag&q;:true,&q;supportUserNoteStroke&q;:false,&q;communicateType&q;:0,&q;one2One&q;:false,&q;fakeLive&q;:false},&q;validStatus&q;:1,&q;supportLive&q;:true,&q;supportAiCatalog&q;:false,&q;hasIntelligentPen&q;:false,&q;useLocalRecording&q;:false,&q;useIntelligentRoom&q;:false,&q;hasSalePosition&q;:false,&q;hasEpisodeCards&q;:true,&q;lockedForShouna&q;:false,&q;needSignIn&q;:false,&q;needTeacherSignIn&q;:false,&q;enablePadPencil&q;:true,&q;displayExercise&q;:false,&q;supportLuckyBag&q;:true,&q;supportLivePk&q;:true},{&q;id&q;:11093380,&q;kePrefix&q;:&q;sydw&q;,&q;courseId&q;:6,&q;status&q;:3,&q;playStatus&q;:3,&q;type&q;:33,&q;recordingType&q;:0,&q;mediaType&q;:0,&q;title&q;:&q;【判断】精选好题 沉浸刷题&q;,&q;innerTitle&q;:&q;&q;,&q;startTime&q;:1760515200000,&q;endTime&q;:1760522400000,&q;teacher&q;:{&q;id&q;:16630,&q;userId&q;:63555782,&q;name&q;:&q;陈贺&q;,&q;brief&q;:&q;粉笔优质讲师&q;,&q;desc&q;:&q;粉笔优质教师\n6年一线教学授课经验，线上累计授课超800+小时，带班学生8000+；具有判断推理科目丰富的实践经验和系统扎实的专业理论，对山东、陕西、甘肃等各省判断推理科目的考情深入研究，全面了解命题规律及答题技巧，长期参与线上系统班和精品班的教研工作，撰写教研文章10余篇，出过近200道优质模拟题；具有幽默诙谐、形象生动、条理清晰的授课风格，让学生在轻松的学习氛围中，用更简单的方法，找到更快捷的解题之道，深受广大学员的认可和好评。&q;,&q;avatar&q;:&q;175d8f143291ec7.jpg&q;,&q;upperBodyPhoto&q;:null,&q;displayCoursePrefix&q;:&q;sydw&q;,&q;teacherStat&q;:{&q;teacherId&q;:16630,&q;episodeCount&q;:508,&q;scoreCount&q;:1860,&q;avgScore&q;:9.8516129032258,&q;fiveGradeAvgScore&q;:4.93,&q;updateTime&q;:1773584418412},&q;auditionEpisode&q;:{&q;episodeTitle&q;:&q;个人展示课&q;,&q;episodeVideoUrl&q;:&q;https://vod.fbstatic.cn/22e9ceb2vodbj1251001446/be9c21bc5145403709538211346/S3YE0Y3AIBoA.mp4?t=f2a4b300&a;us=4070880000&a;sign=aa0da2116ec32854b9c50d64d3429cec&q;},&q;memberOfCPC&q;:false,&q;tags&q;:null},&q;teachChannel&q;:1,&q;offline&q;:null,&q;duration&q;:8081,&q;hasAudition&q;:false,&q;bizType&q;:0,&q;bizId&q;:&q;726825&q;,&q;supportReplay&q;:true,&q;extraInfo&q;:null,&q;liveConfig&q;:{&q;episodeId&q;:11093380,&q;supportMultiGroup&q;:false,&q;exerciseBizType&q;:0,&q;videoDisplayType&q;:0,&q;avForwardType&q;:0,&q;useIntelligentRoom&q;:false,&q;hasStrokeKeynote&q;:true,&q;verticalModeType&q;:0,&q;originEpisodeId&q;:0,&q;supportRtmp&q;:false,&q;supportPk&q;:true,&q;supportLuckyBag&q;:true,&q;supportUserNoteStroke&q;:false,&q;communicateType&q;:0,&q;one2One&q;:false,&q;fakeLive&q;:false},&q;validStatus&q;:1,&q;supportLive&q;:true,&q;supportAiCatalog&q;:false,&q;hasIntelligentPen&q;:false,&q;useLocalRecording&q;:false,&q;useIntelligentRoom&q;:false,&q;hasSalePosition&q;:false,&q;hasEpisodeCards&q;:true,&q;lockedForShouna&q;:false,&q;needSignIn&q;:false,&q;needTeacherSignIn&q;:false,&q;enablePadPencil&q;:true,&q;displayExercise&q;:false,&q;supportLuckyBag&q;:true,&q;supportLivePk&q;:true},{&q;id&q;:11093384,&q;kePrefix&q;:&q;sydw&q;,&q;courseId&q;:6,&q;status&q;:3,&q;playStatus&q;:3,&q;type&q;:33,&q;recordingType&q;:0,&q;mediaType&q;:0,&q;title&q;:&q;【综应】精选好题 沉浸刷题&q;,&q;innerTitle&q;:&q;&q;,&q;startTime&q;:1760580000000,&q;endTime&q;:1760587200000,&q;teacher&q;:{&q;id&q;:34144,&q;userId&q;:83886683,&q;name&q;:&q;成远&q;,&q;brief&q;:&q;粉笔优质讲师&q;,&q;desc&q;:&q;粉笔优质教师\n五年一线教学授课经验 具有综应科目丰富的实践经验及系统扎实的专业理论知识，对综应考情深入研究 教学经验：多次积极参加综应科目的教研培训，对各省份综应考情进行深入研究，积累丰富的综应知识 学生口碑：授课风格细腻认真，根据学员的学习风格，灵活调整教学策略，使每位学员都能跟上课堂进度。课堂氛围轻松，能够让学员们积极参与讨论，互相分享自己的见解。与学员之间的互动频繁，学员提出的问题能够及时耐心解答。&q;,&q;avatar&q;:&q;178a5ed9b29baae.jpg&q;,&q;upperBodyPhoto&q;:null,&q;displayCoursePrefix&q;:&q;sydw&q;,&q;teacherStat&q;:{&q;teacherId&q;:34144,&q;episodeCount&q;:379,&q;scoreCount&q;:278,&q;avgScore&q;:9.812949640287767,&q;fiveGradeAvgScore&q;:4.91,&q;updateTime&q;:1773283970717},&q;auditionEpisode&q;:{&q;episodeTitle&q;:&q;个人展示课&q;,&q;episodeVideoUrl&q;:&q;https://vod.fbstatic.cn/22e9ceb2vodbj1251001446/dded7c315145403709430054231/MetXyTQDR9MA.mp4?t=f2a4b300&a;us=4070880000&a;sign=5cfd13ce7c9af3e4a44ad6a7c92fffaa&q;},&q;memberOfCPC&q;:false,&q;tags&q;:null},&q;teachChannel&q;:1,&q;offline&q;:null,&q;duration&q;:8141,&q;hasAudition&q;:false,&q;bizType&q;:0,&q;bizId&q;:&q;726825&q;,&q;supportReplay&q;:true,&q;extraInfo&q;:null,&q;liveConfig&q;:{&q;episodeId&q;:11093384,&q;supportMultiGroup&q;:false,&q;exerciseBizType&q;:0,&q;videoDisplayType&q;:0,&q;avForwardType&q;:0,&q;useIntelligentRoom&q;:false,&q;