0,&q;avForwardType&q;:0,&q;useIntelligentRoom&q;:false,&q;hasStrokeKeynote&q;:true,&q;verticalModeType&q;:0,&q;originEpisodeId&q;:0,&q;supportRtmp&q;:false,&q;supportPk&q;:true,&q;supportLuckyBag&q;:true,&q;supportUserNoteStroke&q;:false,&q;communicateType&q;:0,&q;one2One&q;:false,&q;fakeLive&q;:false},&q;validStatus&q;:1,&q;supportLive&q;:true,&q;supportAiCatalog&q;:false,&q;hasIntelligentPen&q;:false,&q;useLocalRecording&q;:false,&q;useIntelligentRoom&q;:false,&q;hasSalePosition&q;:false,&q;hasEpisodeCards&q;:true,&q;lockedForShouna&q;:false,&q;needSignIn&q;:false,&q;needTeacherSignIn&q;:false,&q;enablePadPencil&q;:true,&q;displayExercise&q;:false,&q;supportLuckyBag&q;:true,&q;supportLivePk&q;:true},{&q;id&q;:9919040,&q;kePrefix&q;:&q;sydw&q;,&q;courseId&q;:6,&q;status&q;:3,&q;playStatus&q;:3,&q;type&q;:33,&q;recordingType&q;:0,&q;mediaType&q;:0,&q;title&q;:&q;【综应】精选好题 沉浸刷题&q;,&q;innerTitle&q;:&q;&q;,&q;startTime&q;:1736064000000,&q;endTime&q;:1736071200000,&q;teacher&q;:{&q;id&q;:16967,&q;userId&q;:73695412,&q;name&q;:&q;周雯&q;,&q;brief&q;:&q;粉笔优质讲师&q;,&q;desc&q;:&q;粉笔优质教师\n六年事考、公考教学经验，累计授课时长1000+，授课经验丰富，教研教学扎实，全面了解事业单位综合应用能力考试的命题规律及答题技巧，授课重点突出，能及时总结拓展，讲解语言通俗易懂。课堂氛围轻松活跃，擅长引导学生自主思考，能够在课堂互动中发现学员的问题并给出针对性的解决措施，对待学生认真负责、有耐心，深受学生喜爱。&q;,&q;avatar&q;:&q;17549fe18ee3d2f.jpg&q;,&q;upperBodyPhoto&q;:null,&q;displayCoursePrefix&q;:&q;sydw&q;,&q;teacherStat&q;:{&q;teacherId&q;:16967,&q;episodeCount&q;:453,&q;scoreCount&q;:481,&q;avgScore&q;:9.817047817047817,&q;fiveGradeAvgScore&q;:4.91,&q;updateTime&q;:1773103543649},&q;auditionEpisode&q;:null,&q;memberOfCPC&q;:false,&q;tags&q;:null},&q;teachChannel&q;:1,&q;offline&q;:null,&q;duration&q;:6984,&q;hasAudition&q;:false,&q;bizType&q;:0,&q;bizId&q;:&q;726825&q;,&q;supportReplay&q;:true,&q;extraInfo&q;:null,&q;liveConfig&q;:{&q;episodeId&q;:9919040,&q;supportMultiGroup&q;:false,&q;exerciseBizType&q;:0,&q;videoDisplayType&q;:0,&q;avForwardType&q;:0,&q;useIntelligentRoom&q;:false,&q;hasStrokeKeynote&q;:true,&q;verticalModeType&q;:0,&q;originEpisodeId&q;:0,&q;supportRtmp&q;:false,&q;supportPk&q;:true,&q;supportLuckyBag&q;:true,&q;supportUserNoteStroke&q;:false,&q;communicateType&q;:0,&q;one2One&q;:false,&q;fakeLive&q;:false},&q;validStatus&q;:1,&q;supportLive&q;:true,&q;supportAiCatalog&q;:false,&q;hasIntelligentPen&q;:false,&q;useLocalRecording&q;:false,&q;useIntelligentRoom&q;:false,&q;hasSalePosition&q;:false,&q;hasEpisodeCards&q;:true,&q;lockedForShouna&q;:false,&q;needSignIn&q;:false,&q;needTeacherSignIn&q;:false,&q;enablePadPencil&q;:true,&q;displayExercise&q;:false,&q;supportLuckyBag&q;:true,&q;supportLivePk&q;:true},{&q;id&q;:9969511,&q;kePrefix&q;:&q;sydw&q;,&q;courseId&q;:6,&q;status&q;:3,&q;playStatus&q;:3,&q;type&q;:33,&q;recordingType&q;:0,&q;mediaType&q;:0,&q;title&q;:&q;【综应】精选好题 沉浸刷题&q;,&q;innerTitle&q;:&q;&q;,&q;startTime&q;:1736128800000,&q;endTime&q;:1736136000000,&q;teacher&q;:{&q;id&q;:64309,&q;userId&q;:105157457,&q;name&q;:&q;彭行锋&q;,&q;brief&q;:&q;粉笔优质讲师&q;,&q;desc&q;:&q;粉笔优质教师\n长期从事一线公考教学工作，熟悉体制内实际工作，累计授课5年余，每年授课时长超1000小时。理论功底深厚，具有申论、综应科目丰富的实践经验及系统扎实的专业理论知识，对国考、各地方省考和事业单位考试考情、真题和命题方向理解深刻。授课时讲解细致、逻辑清晰、重点突出，能从题型特点和材料逻辑出发，引导学生思考，并善于总结梳理解题方法，让学员能从一道题学会一类题，用更简单的方法，找到更快捷的解题之道，不断提高综应分数，带领多名学生高分上岸，广受学员好评。&q;,&q;avatar&q;:&q;19462c5b766fea8.jpg&q;,&q;upperBodyPhoto&q;:null,&q;displayCoursePrefix&q;:&q;sydw&q;,&q;teacherStat&q;:{&q;teacherId&q;:64309,&q;episodeCount&q;:770,&q;scoreCount&q;:788,&q;avgScore&q;:9.845177664974608,&q;fiveGradeAvgScore&q;:4.92,&q;updateTime&q;:1773391273278},&q;auditionEpisode&q;:{&q;episodeTitle&q;:&q;个人展示课&q;,&q;episodeVideoUrl&q;:&q;https://vod.fbstatic.cn/22e9ceb2vodbj1251001446/b448932f5145403708976968107/Wojnx2AoI0gA.mp4?t=f2a4b300&a;us=4070880000&a;sign=87716c59c7264a28aa85682a04ffbaa8&q;},&q;memberOfCPC&q;:false,&q;tags&q;:null},&q;teachChannel&q;:1,&q;offline&q;:null,&q;duration&q;:7934,&q;hasAudition&q;:false,&q;bizType&q;:0,&q;bizId&q;:&q;726825&q;,&q;supportReplay&q;:true,&q;extraInfo&q;:null,&q;liveConfig&q;:{&q;episodeId&q;:9969511,&q;supportMultiGroup&q;:false,&q;exerciseBizType&q;:0,&q;videoDisplayType&q;:0,&q;avForwardType&q;:0,&q;useIntelligentRoom&q;:false,&q;hasStrokeKeynote&q;:true,&q;verticalModeType&q;:0,&q;originEpisodeId&q;:0,&q;supportRtmp&q;:false,&q;supportPk&q;:true,&q;supportLuckyBag&q;:true,&q;supportUserNoteStroke&q;:false,&q;communicateType&q;:0,&q;one2One&q;:false,&q;fakeLive&q;:false},&q;validStatus&q;:1,&q;supportLive&q;:true,&q;supportAiCatalog&q;:false,&q;hasIntelligentPen&q;:false,&q;useLocalRecording&q;:false,&q;useIntelligentRoom&q;:false,&q;hasSalePosition&q;:false,&q;hasEpisodeCards&q;:true,&q;lockedForShouna&q;:false,&q;needSignIn&q;:false,&q;needTeacherSignIn&q;:false,&q;enablePadPencil&q;:true,&q;displayExercise&q;:false,&q;supportLuckyBag&q;:true,&q;supportLivePk&q;:true},{&q;id&q;:9969521,&q;kePrefix&q;:&q;sydw&q;,&q;courseId&q;:6,&q;status&q;:3,&q;playStatus&q;:3,&q;type&q;:33,&q;recordingType&q;:0,&q;mediaType&q;:0,&q;title&q;:&q;【数资】精选好题 沉浸刷题&q;,&q;innerTitle&q;:&q;&q;,&q;startTime&q;:1736136000000,&q;endTime&q;:1736143200000,&q;teacher&q;:{&q;id&q;:64420,&q;userId&q;:118340918,&q;name&q;:&q;徐化雨&q;,&q;brief&q;:&q;粉笔优质讲师&q;,&q;desc&q;:&q;粉笔优质讲师\n6年一线线上线下数资授课及教研工作，承担过线下笔试精品班、刷题班、冲刺班等多种班型，具有丰富的实战经验；\n了解数量关系与资料分析的命题规律及答题技巧，多次参与命制笔试真题教研和解析撰写工作；\n授课逻辑性强，操作性强，知识点详细，重难点突出，了解学生解题过程中容易出错的点，帮助学生解决学习过程中遇到的难题，注重不同教学方法和技巧的拓展，开拓学生的思维，深受学生喜爱，广受好评。&q;,&q;avatar&q;:&q;193af7d4cbf360d.jpg&q;,&q;upperBodyPhoto&q;:null,&q;displayCoursePrefix&q;:&q;sydw&q;,&q;teacherStat&q;:{&q;teacherId&q;:64420,&q;episodeCount&q;:639,&q;scoreCount&q;:1186,&q;avgScore&q;:9.465430016863413,&q;fiveGradeAvgScore&q;:4.73,&q;updateTime&q;:1773574509026},&q;auditionEpisode&q;:{&q;episodeTitle&q;:&q;个人展示课&q;,&q;episodeVideoUrl&q;:&q;https://vod.fbstatic.cn/22e9ceb2vodbj1251001446/c1bf7a9e5145403709545133914/m6dJlzi9NsEA.mp4?t=f2a4b300&a;us=4070880000&a;sign=205797ab3c5e47054fafe87d2b29f65d&q;},&q;memberOfCPC&q;:false,&q;tags&q;:null},&q;teachChannel&q;:1,&q;offline&q;:null,&q;duration&q;:6971,&q;hasAudition&q;:false,&q;bizType&q;:0,&q;bizId&q;:&q;726825&q;,&q;supportReplay&q;:true,&q;extraInfo&q;:null,&q;liveConfig&q;:{&q;episodeId&q;:9969521,&q;supportMultiGroup&q;:false,&q;exerciseBizType&q;:0,&q;videoDisplayType&q;:0,&q;avForwardType&q;:0,&q;useIntelligentRoom&q;:false,&q;hasStrokeKeynote&q;:true,&q;verticalModeType&q;:0,&q;originEpisodeId&q;:0,&q;supportRtmp&q;:false,&q;supportPk&q;:true,&q;supportLuckyBag&q;:true,&q;supportUserNoteStroke&q;:false,&q;communicateType&q;:0,&q;one2One&q;:false,&q;fakeLive&q;:false},&q;validStatus&q;:1,&q;supportLive&q;:true,&q;supportAiCatalog&q;:false,&q;hasIntelligentPen&q;:false,&q;useLocalRecording&q;:false,&q;useIntelligentRoom&q;:false,&q;hasSalePosition&q;:false,&q;hasEpisodeCards&q;:true,&q;lockedForShouna&q;:false,&q;needSignIn&q;:false,&q;needTeacherSignIn&q;:false,&q;enablePadPencil&q;:true,&q;displayExercise&q;:false,&q;supportLuckyBag&q;:true,&q;supportLivePk&q;:true},{&q;id&q;:9969524,&q;kePrefix&q;:&q;sydw&q;,&q;courseId&q;:6,&q;status&q;:3,&q;playStatus&q;:3,&q;type&q;:33,&q;recordingType&q;:0,&q;mediaType&q;:0,&q;title&q;:&q;【言语】精选好题 沉浸刷题&q;,&q;innerTitle&q;:&q;&q;,&q;startTime&q;:1736150400000,&q;endTime&q;:1736157600000,&q;teacher&q;:{&q;id&q;:17075,&q;userId&q;:44061788,&q;name&q;:&q;余寅波&q;,&q;brief&q;:&q;粉笔优质讲师&q;,&q;desc&q;:&q;粉笔优质教师\n拥有长达六年的一线教学授课经验，专注深耕于事业单位考试领域。曾承担过笔试精品班、刷题班等多种班型的教学任务。\n在言语科目方面，理论功底极为扎实，对各类言语考点均进行了细致入微的研究与梳理。授课过程中，逻辑清晰明了，态度耐心负责，课堂上十分注重将知识点与真题紧密结合，助力学员迅速掌握做题技巧。\n参与笔试教研以及解析撰写工作，对最新命题趋势有着精准把握，还多次踊跃参加授课研讨会议，秉持注重考场思维的理念，针对学生在学习过程中产生的困惑深入研究教学策略。\n累计授课时长超过 2000 小时，累计评分高达 4.9 分。教学中注重采用启发式引导方式，致力于让学生在轻松愉悦的学习氛围中，探寻到更为快捷的解题之道，深受广大学员的认可与好评。坚信 “没有比人更高的山”，始终愿助力每一位学员翻越自身面临的那座高山。&q;,&q;avatar&q;:&q;17470c205d4814c.jpg&q;,&q;upperBodyPhoto&q;:null,&q;displayCoursePrefix&q;:&q;sydw&q;,&q;teacherStat&q;:{&q;teacherId&q;:17075,&q;episodeCount&q;:379,&q;scoreCount&q;:1504,&q;avgScore&q;:9.699468085106375,&q;fiveGradeAvgScore&q;:4.85,&q;updateTime&q;:1773571929826},&q;auditionEpisode&q;:null,&q;memberOfCPC&q;:false,&q;tags&q;:null},&q;teachChannel&q;:1,&q;offline&q;:null,&q;duration&q;:6922,&q;hasAudition&q;:false,&q;bizType&q;:0,&q;bizId&q;:&q;726825&q;,&q;supportReplay&q;:true,&q;extraInfo&q;:null,&q;liveConfig&q;:{&q;episodeId&q;:9969524,&q;supportMultiGroup&q;:false,&q;exerciseBizType&q;:0,&q;videoDisplayType&q;:0,&q;avForwardType&q;:0,&q;useIntelligentRoom&q;:false,&q;hasStrokeKeynote&q;:true,&q;verticalModeType&q;:0,&q;originEpisodeId&q;:0,&q;supportRtmp&q;:false,&q;supportPk&q;:true,&q;supportLuckyBag&q;:true,&q;supportUserNoteStroke&q;:false,&q;communicateType&q;:0,&q;one2One&q;:false,&q;fakeLive&q;:false},&q;validStatus&q;:1,&q;supportLive&q;:true,&q;supportAiCatalog&q;:false,&q;hasIntelligentPen&q;:false,&q;useLocalRecording&q;:false,&q;useIntelligentRoom&q;:false,&q;hasSalePosition&q;:false,&q;hasEpisodeCards&q;:true,&q;lockedForShouna&q;:false,&q;needSignIn&q;:false,&q;needTeacherSignIn&q;:false,&q;enablePadPencil&q;:true,&q;displayExercise&q;:false,&q;supportLuckyBag&q;:true,&q;supportLivePk&q;:true},{&q;id&q;:9969525,&q;kePrefix&q;:&q;sydw&q;,&q;courseId&q;:6,&q;status&q;:3,&q;playStatus&q;:3,&q;type&q;:33,&q;recordingType&q;:0,&q;mediaType&q;:0,&q;title&q;:&q;【综应】精选好题 沉浸刷题&q;,&q;innerTitle&q;:&q;&q;,&q;startTime&q;:1736215200000,&q;endTime&q;:1736222400000,&q;teacher&q;:{&q;id&q;:6520,&q;userId&q;:62532323,&q;name&q;:&q;刘紫阳&q;,&q;brief&q;:&q;粉笔优质讲师&q;,&q;desc&q;:&q;粉笔优质讲师\n9年一线教学授课经验，总授课时长 15000+，，累计评分4.9。\n具有申论、综应科目丰富的实践经验及系统扎实的专业理论知识，对国考、各地方省考和事业单位考试考情、真题和命题方向理解深刻；曾担任安徽申论教研负责人，参与不同阶段授课讲义制作，参与25年国考复读班、综应C讲义制作；19年在安徽粉笔被评为“年度优秀师资”。\n授课讲解细致，逻辑清晰，重点突出，逻辑与要点结合，课堂轻松活泼，让学生用更简单的方法，找到更快捷的解题之道，快速帮助学生提高，深受学员喜爱。&q;,&q;avatar&q;:&q;1942616de4f802f.jpg&q;,&q;upperBodyPhoto&q;:null,&q;displayCoursePrefix&q;:&q;sydw&q;,&q;teacherStat&q;:{&q;teacherId&q;:6520,&q;episodeCount&q;:1160,&q;scoreCount&q;:2251,&q;avgScore&q;:9.768991559306974,&q;fiveGradeAvgScore&q;:4.88,&q;updateTime&q;:1773583986493},&q;auditionEpisode&q;:{&q;episodeTitle&q;:&q;个人展示课&q;,&q;episodeVideoUrl&q;:&q;https://vod.fbstatic.cn/22e9ceb2vodbj1251001446/1987b2725145403709539809876/indGlBLeP1MA.mp4?t=f2a4b300&a;us=4070880000&a;sign=bf2d115e59de47301f001abb86eb6566&q;},&q;memberOfCPC&q;:false,&q;tags&q;:null},&q;teachChannel&q;:1,&q;offline&q;:null,&q;duration&q;:6572,&q;hasAudition&q;:false,&q;bizType&q;:0,&q;bizId&q;:&q;726825&q;,&q;supportReplay&q;:true,&q;extraInfo&q;:null,&q;liveConfig&q;:{&q;episodeId&q;:9969525,&q;supportMultiGroup&q;:false,&q;exerciseBizType&q;:0,&q;videoDisplayType&q;:0,&q;avForwardType&q;:0,&q;useIntelligentRoom&q;:false,&q;hasStrokeKeynote&q;:true,&q;verticalModeType&q;:0,&q;originEpisodeId&q;:0,&q;supportRtmp&q;:false,&q;supportPk&q;:true,&q;supportLuckyBag&q;:true,&q;supportUserNoteStroke&q;:false,&q;communicateType&q;:0,&q;one2One&q;:false,&q;fakeLive&q;:false},&q;validStatus&q;:1,&q;supportLive&q;:true,&q;supportAiCatalog&q;:false,&q;hasIntelligentPen&q;:false,&q;useLocalRecording&q;:false,&q;useIntelligentRoom&q;:false,&q;hasSalePosition&q;:false,&q;hasEpisodeCards&q;:true,&q;lockedForShouna&q;:false,&q;needSignIn&q;:false,&q;needTeacherSignIn&q;:false,&q;enablePadPencil&q;:true,&q;displayExercise&q;:false,&q;supportLuckyBag&q;:true,&q;supportLivePk&q;:true},{&q;id&q;:9969527,&q;kePrefix&q;:&q;sydw&q;,&q;courseId&q;:6,&q;status&q;:3,&q;playStatus&q;:3,&q;type&q;:33,&q;recordingType&q;:0,&q;mediaType&q;:0,&q;title&q;:&q;【公基非法】精选好题 沉浸刷题&q;,&q;innerTitle&q;:&q;&q;,&q;startTime&q;:1736222400000,&q;endTime&q;:1736229600000,&q;teacher&q;:{&q;id&q;:16538,&q;userId&q;:72683674,&q;name&q;:&q;章亦轩&q;,&q;brief&q;:&q;粉笔优质讲师&q;,&q;desc&q;:&q;粉笔常识公基优质教师\n四年一线教学授课经验，深耕一线课程，承担过线上笔试精品班、刷题班等多种班型。\n具有常识公基科目丰富的实践经验及系统扎实的专业理论知识和对常识公基考情的深入研究，曾参与笔试教研和解析撰写工作；注重考场思维，针对学生困惑研究教学策略；深入研讨常识公基命题趋势及最新考情，注重自我提升，积累丰富笔试理论知识。\n累计授课超1000小时，注重启发式引导，让学生在轻松的学习氛围中，用更简单的方法，找到更快捷的解题之道，深受广大学员的认可和好评。&q;,&q;avatar&q;:&q;17467b2f8a0fb3b.jpg&q;,&q;upperBodyPhoto&q;:null,&q;displayCoursePrefix&q;:&q;sydw&q;,&q;teacherStat&q;:{&q;teacherId&q;:16538,&q;episodeCount&q;:914,&q;scoreCount&q;:1035,&q;avgScore&q;:9.62898550724638,&q;fiveGradeAvgScore&q;:4.81,&q;updateTime&q;:1773475961041},&q;auditionEpisode&q;:{&q;episodeTitle&q;:&q;个人展示课&q;,&q;episodeVideoUrl&q;:&q;https://vod.fbstatic.cn/22e9ceb2vodbj1251001446/6ef433b51397757888365410347/0qvJbp7EGrgA.mp4?t=f2a4b300&a;us=4070880000&a;sign=5675190d3b2d1da9f9d0e15ba0571903&q;},&q;memberOfCPC&q;:false,&q;tags&q;:null},&q;teachChannel&q;:1,&q;offline&q;:null,&q;duration&q;:6672,&q;hasAudition&q;:false,&q;bizType&q;:0,&q;bizId&q;:&q;726825&q;,&q;supportReplay&q;:true,&q;extraInfo&q;:null,&q;liveConfig&q;:{&q;episodeId&q;:9969527,&q;supportMultiGroup&q;:false,&q;exerciseBizType&q;:0,&q;videoDisplayType&q;:0,&q;avForwardType&q;:0,&q;useIntelligentRoom&q;:false,&q;hasStrokeKeynote&q;:true,&q;verticalModeType&q;:0,&q;originEpisodeId&q;:0,&q;supportRtmp&q;:false,&q;supportPk&q;:true,&q;supportLuckyBag&q;:true,&q;supportUserNoteStroke&q;:false,&q;communicateType&q;:0,&q;one2One&q;:false,&q;fakeLive&q;:false},&q;validStatus&q;:1,&q;supportLive&q;:true,&q;supportAiCatalog&q;:false,&q;hasIntelligentPen&q;:false,&q;useLocalRecording&q;:false,&q;useIntelligentRoom&q;:false,&q;hasSalePosition&q;:false,&q;hasEpisodeCards&q;:true,&q;lockedForShouna&q;:false,&q;needSignIn&q;:false,&q;needTeacherSignIn&q;:false,&q;enablePadPencil&q;:true,&q;displayExercise&q;:false,&q;supportLuckyBag&q;:true,&q;supportLivePk&q;:true},{&q;id&q;:9969530,&q;kePrefix&q;:&q;sydw&q;,&q;courseId&q;:6,&q;status&q;:3,&q;playStatus&q;:3,&q;type&q;:33,&q;recordingType&q;:0,&q;mediaType&q;:0,&q;title&q;:&q;【言语】精选好题 沉浸刷题&q;,&q;innerTitle&q;:&q;&q;,&q;startTime&q;:1736229600000,&q;endTime&q;:1736236800000,&q;teacher&q;:{&q;id&q;:56429,&q;userId&q;:74160353,&q;name&q;:&q;邱宜静&q;,&q;brief&q;:&q;粉笔优质讲师&q;,&q;desc&q;:&q;粉笔优质教师\n五年一线教学授课经验，长期致力于事业单位考试研究与教学，对事业单位招聘考试体系有着深入的理解和扎实的教学经验。\n具有言语科目丰富的实践经验及系统扎实的专业理论知识和对事业单位言语考情的深入研究:\n多次参与笔试真题教研和解析撰写工作，对言语命题趋势方向有着深入的研究;\n多次参加粉笔授课研讨会议，深入研讨事考言语命题趋势及最新考情;\n授课特点:擅长将复杂的知识点转化为易于理解的教学内容，通过循序渐进的教学方式，引导学生逐步掌握所需的知识点，帮助学员快速掌握言语科目的核心要点，提升解题能力和应试技巧，成功帮助数百名考生顺利通过事业单位招聘考试。&q;,&q;avatar&q;:&q;18408e0ee9a5e5d.jpg&q;,&q;upperBodyPhoto&q;:null,&q;displayCoursePrefix&q;:&q;sydw&q;,&q;teacherStat&q;:{&q;teacherId&q;:56429,&q;episodeCount&q;:185,&q;scoreCount&q;:627,&q;avgScore&q;:9.763955342902712,&q;fiveGradeAvgScore&q;:4.88,&q;updateTime&q;:1773327807084},&q;auditionEpisode&q;:{&q;episodeTitle&q;:&q;个人展示课&q;,&q;episodeVideoUrl&q;:&q;https://vod.fbstatic.cn/22e9ceb2vodbj1251001446/cfc0c3501253642695688501785/bsDyySXGJLgA.mp4?t=f2a4b300&a;us=4070880000&a;sign=41a1d807640af0e9a33d92a3917850c4&q;},&q;memberOfCPC&q;:false,&q;tags&q;:null},&q;teachChannel&q;:1,&q;offline&q;:null,&q;duration&q;:7448,&q;hasAudition&q;:false,&q;bizType&q;:0,&q;bizId&q;:&q;726825&q;,&q;supportReplay&q;:true,&q;extraInfo&q;:null,&q;liveConfig&q;:{&q;episodeId&q;:9969530,&q;supportMultiGroup&q;:false,&q;exerciseBizType&q;:0,&q;videoDisplayType&q;:0,&q;avForwardType&q;:0,&q;useIntelligentRoom&q;:false,&q;hasStrokeKeynote&q;:true,&q;verticalModeType&q;:0,&q;originEpisodeId&q;:0,&q;supportRtmp&q;:false,&q;supportPk&q;:true,&q;supportLuckyBag&q;:true,&q;supportUserNoteStroke&q;:false,&q;communicateType&q;:0,&q;one2One&q;:false,&q;fakeLive&q;:false},&q;validStatus&q;:1,&q;supportLive&q;:true,&q;supportAiCatalog&q;:false,&q;hasIntelligentPen&q;:false,&q;useLocalRecording&q;:false,&q;useIntelligentRoom&q;:false,&q;hasSalePosition&q;:false,&q;hasEpisodeCards&q;:true,&q;lockedForShouna&q;:false,&q;needSignIn&q;:false,&q;needTeacherSignIn&q;:false,&q;enablePadPencil&q;:true,&q;displayExercise&q;:false,&q;supportLuckyBag&q;:true,&q;supportLivePk&q;:true},{&q;id&q;:9969536,&q;kePrefix&q;:&q;sydw&q;,&q;courseId&q;:6,&q;status&q;:3,&q;playStatus&q;:3,&q;type&q;:33,&q;recordingType&q;:0,&q;mediaType&q;:0,&q;title&q;:&q;【判断】精选好题 沉浸刷题&q;,&q;innerTitle&q;:&q;&q;,&q;startTime&q;:1736236800000,&q;endTime&q;:1736244000000,&q;teacher&q;:{&q;id&q;:25998,&q;userId&q;:74893882,&q;name&q;:&q;卜晓&q;,&q;brief&q;:&q;粉笔优质讲师&q;,&q;desc&q;:&q;粉笔优质教师\n6年一线教学授课经验，具有判断科目丰富的实践经验及系统扎实的专业理论知识。多次参加粉笔授课研讨会议，全面把握公考笔试命题趋势及最新考情，积累丰富的笔试知识。\n授课风格形象生动、条理清晰，让学生在轻松的学习氛围中，用更简单的方法，找到更快捷的解题之道，深受广大学员的认可和好评；在学员中具有非常好的口碑，是值得信赖的好导师。&q;,&q;avatar&q;:&q;1983b0eb4544784.jpg&q;,&q;upperBodyPhoto&q;:null,&q;displayCoursePrefix&q;:&q;sydw&q;,&q;teacherStat&q;:{&q;teacherId&q;:25998,&q;episodeCount&q;:241,&q;scoreCount&q;:956,&q;avgScore&q;:9.822175732217573,&q;fiveGradeAvgScore&q;:4.91,&q;updateTime&q;:1772456165442},&q;auditionEpisode&q;:{&q;episodeTitle&q;:&q;个人展示课&q;,&q;episodeVideoUrl&q;:&q;https://vod.fbstatic.cn/22e9ceb2vodbj1251001446/66f828ce1397757903436832264/gWy20rAOGRMA.mp4?t=f2a4b300&a;us=4070880000&a;sign=80068e51d1010737ea53aef5d97ef1a4&q;},&q;memberOfCPC&q;:false,&q;tags&q;:null},&q;teachChannel&q;:1,&q;offline&q;:null,&q;duration&q;:7163,&q;hasAudition&q;:false,&q;bizType&q;:0,&q;bizId&q;:&q;726825&q;,&q;supportReplay&q;:true,&q;extraInfo&q;:null,&q;liveConfig&q;:{&q;episodeId&q;:9969536,&q;supportMultiGroup&q;:false,&q;exerciseBizType&q;:0,&q;videoDisplayType&q;:0,&q;avForwardType&q;:0,&q;useIntelligentRoom&q;:false,&q;hasStrokeKeynote&q;:true,&q;verticalModeType&q;:0,&q;originEpisodeId&q;:0,&q;supportRtmp&q;:false,&q;supportPk&q;:true,&q;supportLuckyBag&q;:true,&q;supportUserNoteStroke&q;:false,&q;communicateType&q;:0,&q;one2One&q;:false,&q;fakeLive&q;:false},&q;validStatus&q;:1,&q;supportLive&q;:true,&q;supportAiCatalog&q;:false,&q;hasIntelligentPen&q;:false,&q;useLocalRecording&q;:false,&q;useIntelligentRoom&q;:false,&q;hasSalePosition&q;:false,&q;hasEpisodeCards&q;:true,&q;lockedForShouna&q;:false,&q;needSignIn&q;:false,&q;needTeacherSignIn&q;:false,&q;enablePadPencil&q;:true,&q;displayExercise&q;:false,&q;supportLuckyBag&q;:true,&q;supportLivePk&q;:true},{&q;id&q;:9969538,&q;kePrefix&q;:&q;sydw&q;,&q;courseId&q;:6,&q;status&q;:3,&q;playStatus&q;:3,&q;type&q;:33,&q;recordingType&q;:0,&q;mediaType&q;:0,&q;title&q;:&q;【综应】精选好题 沉浸刷题&q;,&q;innerTitle&q;:&q;&q;,&q;startTime&q;:1736301600000,&q;endTime&q;:1736308800000,&q;teacher&q;:{&q;id&q;:13527,&q;userId&q;:72790831,&q;name&q;:&q;安爱霞&q;,&q;brief&q;:&q;粉笔优质讲师&q;,&q;desc&q;:&q;粉笔综应优质讲师。\n5年多一线综应教学和带班经验，累计授课时长1200+，带班人次2000+，所带班级进面率高，学员整体评分5.0。\n多次参加粉笔综应科目教研，熟悉各类事业单位综应科目命题规律，重难点及不同题型的答题思路和方法，对联考、山东、江苏、浙江等省份事业单位的考情和备考策略了然于胸，专业知识扎实，带班经验丰富。\n清新温和，擅长总结做题规律和答题技巧，能够举一反三，帮助同学通过一道题掌握一类题的解题思路，谙熟学生各个阶段的备考心理，善于思维点拨和个性化辅导，实践性强，深受学员喜爱。&q;,&q;avatar&q;:&q;1737ee8a423e625.jpg&q;,&q;upperBodyPhoto&q;:null,&q;displayCoursePrefix&q;:&q;sydw&q;,&q;teacherStat&q;:{&q;teacherId&q;:13527,&q;episodeCount&q;:432,&q;scoreCount&q;:650,&q;avgScore&q;:9.95076923076923,&q;fiveGradeAvgScore&q;:4.98,&q;updateTime&q;:1773460026169},&q;auditionEpisode&q;:{&q;episodeTitle&q;:&q;个人展示课&q;,&q;episodeVideoUrl&q;:&q;https://vod.fbstatic.cn/22e9ceb2vodbj1251001446/c89b3a775145403709545414401/EobO1hNUCfwA.mp4?t=f2a4b300&a;us=4070880000&a;sign=235394db2773c64ad274454799390cd9&q;},&q;memberOfCPC&q;:false,&q;tags&q;:null},&q;teachChannel&q;:1,&q;offline&q;:null,&q;duration&q;:6647,&q;hasAudition&q;:false,&q;bizType&q;:0,&q;bizId&q;:&q;726825&q;,&q;supportReplay&q;:true,&q;extraInfo&q;:null,&q;liveConfig&q;:{&q;episodeId&q;:9969538,&q;supportMultiGroup&q;:false,&q;exerciseBizType&q;:0,&q;videoDisplayType&q;:0,&q;avForwardType&q;:0,&q;useIntelligentRoom&q;:false,&q;hasStrokeKeynote&q;:true,&q;verticalModeType&q;:0,&q;originEpisodeId&q;:0,&q;supportRtmp&q;:false,&q;supportPk&q;:true,&q;supportLuckyBag&q;:true,&q;supportUserNoteStroke&q;:false,&q;communicateType&q;:0,&q;one2One&q;:false,&q;fakeLive&q;:false},&q;validStatus&q;:1,&q;supportLive&q;:true,&q;supportAiCatalog&q;:false,&q;hasIntelligentPen&q;:false,&q;useLocalRecording&q;:false,&q;useIntelligentRoom&q;:false,&q;hasSalePosition&q;:false,&q;hasEpisodeCards&q;:true,&q;lockedForShouna&q;:false,&q;needSignIn&q;:false,&q;needTeacherSignIn&q;:false,&q;enablePadPencil&q;:true,&q;displayExercise&q;:false,&q;supportLuckyBag&q;:true,&q;supportLivePk&q;:true},{&q;id&q;:9969540,&q;kePrefix&q;:&q;sydw&q;,&q;courseId&q;:6,&q;status&q;:3,&q;playStatus&q;:3,&q;type&q;:33,&q;recordingType&q;:0,&q;mediaType&q;:0,&q;title&q;:&q;【公基非法】精选好题 沉浸刷题&q;,&q;innerTitle&q;:&q;&q;,&q;startTime&q;:1736308800000,&q;endTime&q;:1736316000000,&q;teacher&q;:{&q;id&q;:16651,&q;userId&q;:43424856,&q;name&q;:&q;杜姿乐&q;,&q;brief&q;:&q;粉笔优质讲师&q;,&q;desc&q;:&q;粉笔常识公基优质讲师。5年教学经验，全面了解考试重难点及不同类型题目答题技巧，授课思路清晰，能帮助学员高效备考。授课思路清晰，考点突出，知识点讲解细致，善诱循循，因材施教，深受学生喜爱。&q;,&q;avatar&q;:&q;19840fb4e37e187.jpg&q;,&q;upperBodyPhoto&q;:null,&q;displayCoursePrefix&q;:&q;sydw&q;,&q;teacherStat&q;:{&q;teacherId&q;:16651,&q;episodeCount&q;:751,&q;scoreCount&q;:6001,&q;avgScore&q;:9.749708381936355,&q;fiveGradeAvgScore&q;:4.87,&q;updateTime&q;:1773580276381},&q;auditionEpisode&q;:{&q;episodeTitle&q;:&q;个人展示课&q;,&q;episodeVideoUrl&q;:&q;https://vod.fbstatic.cn/22e9ceb2vodbj1251001446/3eb3377d5145403710131746857/zh5vva2I9DEA.mp4?t=f2a4b300&a;us=4070880000&a;sign=ba612bd296cc820cb8b2a3a70e21fc52&q;},&q;memberOfCPC&q;:false,&q;tags&q;:null},&q;teachChannel&q;:1,&q;offline&q;:null,&q;duration&q;:7853,&q;hasAudition&q;:false,&q;bizType&q;:0,&q;bizId&q;:&q;726825&q;,&q;supportReplay&q;:true,&q;extraInfo&q;:null,&q;liveConfig&q;:{&q;episodeId&q;:9969540,&q;supportMultiGroup&q;:false,&q;exerciseBizType&q;:0,&q;videoDisplayType&q;:0,&q;avForwardType&q;:0,&q;useIntelligentRoom&q;:false,&q;hasStrokeKeynote&q;:true,&q;verticalModeType&q;:0,&q;originEpisodeId&q;:0,&q;supportRtmp&q;:false,&q;supportPk&q;:true,&q;supportLuckyBag&q;:true,&q;supportUserNoteStroke&q;:false,&q;communicateType&q;:0,&q;one2One&q;:false,&q;fakeLive&q;:false},&q;validStatus&q;:1,&q;supportLive&q;:true,&q;supportAiCatalog&q;:false,&q;hasIntelligentPen&q;:false,&q;useLocalRecording&q;:false,&q;useIntelligentRoom&q;:false,&q;hasSalePosition&q;:false,&q;hasEpisodeCards&q;:true,&q;lockedForShouna&q;:false,&q;needSignIn&q;:false,&q;needTeacherSignIn&q;:false,&q;enablePadPencil&q;:true,&q;displayExercise&q;:false,&q;supportLuckyBag&q;:true,&q;supportLivePk&q;:true},{&q;id&q;:9969544,&q;kePrefix&q;:&q;sydw&q;,&q;courseId&q;:6,&q;status&q;:3,&q;playStatus&q;:3,&q;type&q;:33,&q;recordingType&q;:0,&q;mediaType&q;:0,&q;title&q;:&q;【判断】精选好题 沉浸刷题&q;,&q;innerTitle&q;:&q;&q;,&q;startTime&q;:1736316000000,&q;endTime&q;:1736323200000,&q;teacher&q;:{&q;id&q;:16920,&q;userId&q;:60928347,&q;name&q;:&q;刘巍&q;,&q;brief&q;:&q;粉笔优质讲师&q;,&q;desc&q;:&q;粉笔优质讲师\n6年一线教学经验，授课与实战经验丰富； \n在判断科目教学中，参与过多次判断真题教研、多次参与模拟题撰写及审核工作，积累大量使用经验，专业理论知识扎实，对事业单位考试考情、真题等理解深刻\n累计授课1000+小时，授课累计评分4.9分，深受学员的喜爱与认可。\n授课逻辑清晰，讲解细致，通俗易懂，因材施教，为学员提供个性化帮助。讲课细致耐心，课堂氛围轻松活跃,能够帮助学员将所学理论更好应用在实际做题中。&q;,&q;avatar&q;:&q;1746cde0ef0f624.jpg&q;,&q;upperBodyPhoto&q;:null,&q;displayCoursePrefix&q;:&q;sydw&q;,&q;teacherStat&q;:{&q;teacherId&q;:16920,&q;episodeCount&q;:662,&q;scoreCount&q;:2601,&q;avgScore&q;:9.796232218377565,&q;fiveGradeAvgScore&q;:4.9,&q;updateTime&q;:1773622939246},&q;auditionEpisode&q;:{&q;episodeTitle&q;:&q;个人展示课&q;,&q;episodeVideoUrl&q;:&q;https://vod.fbstatic.cn/22e9ceb2vodbj1251001446/607279c25145403713946934153/vsAmh2ZkdSwA.mp4?t=f2a4b300&a;us=4070880000&a;sign=eb2972679a3f405d7a8df877bf6117ea&q;},&q;memberOfCPC&q;:false,&q;tags&q;:null},&q;teachChannel&q;:1,&q;offline&q;:null,&q;duration&q;:7888,&q;hasAudition&q;:false,&q;bizType&q;:0,&q;bizId&q;:&q;726825&q;,&q;supportReplay&q;:true,&q;extraInfo&q;:null,&q;liveConfig&q;:{&q;episodeId&q;:9969544,&q;supportMultiGroup&q;:false,&q;exerciseBizType&q;:0,&q;videoDisplayType&q;:0,&q;avForwardType&q;:0,&q;useIntelligentRoom&q;:false,&q;hasStrokeKeynote&q;:true,&q;verticalModeType&q;:0,&q;originEpisodeId&q;:0,&q;supportRtmp&q;:false,&q;supportPk&q;:true,&q;supportLuckyBag&q;:true,&q;supportUserNoteStroke&q;:false,&q;communicateType&q;:0,&q;one2One&q;:false,&q;fakeLive&q;:false},&q;validStatus&q;:1,&q;supportLive&q;:true,&q;supportAiCatalog&q;:false,&q;hasIntelligentPen&q;:false,&q;useLocalRecording&q;:false,&q;useIntelligentRoom&q;:false,&q;hasSalePosition&q;:false,&q;hasEpisodeCards&q;:true,&q;lockedForShouna&q;:false,&q;needSignIn&q;:false,&q;needTeacherSignIn&q;:false,&q;enablePadPencil&q;:true,&q;displayExercise&q;:false,&q;supportLuckyBag&q;:true,&q;supportLivePk&q;:true},{&q;id&q;:9969628,&q;kePrefix&q;:&q;sydw&q;,&q;courseId&q;:6,&q;status&q;:3,&q;playStatus&q;:3,&q;type&q;:33,&q;recordingType&q;:0,&q;mediaType&q;:0,&q;title&q;:&q;【综应】精选好题 沉浸刷题&q;,&q;innerTitle&q;:&q;&q;,&q;startTime&q;:1736388000000,&q;endTime&q;:1736395200000,&q;teacher&q;:{&q;id&q;:35912,&q;userId&q;:84301173,&q;name&q;:&q;黄迟驰&q;,&q;brief&q;:&q;粉笔优质讲师&q;,&q;desc&q;:&q;粉笔优质讲师\n投身教育事业5年，拥有扎实一线教学经验。承接过各省份笔试系统班，刷题冲刺营，冲刺营，刷题营等班型，服务过近千名学员。参与题库解析课录制，综应一对一课程，综应刷题课。深耕事业单位考试，全面了解事业单位综合应用能力科目考试的命题规律及答题技巧。针对学生困惑研究教学策略，深入研讨最新考情。注重自我提升，每年度多次参加培训学习和综应科目教研，并取得优异成绩。积极分享经验心得，助力粉笔理论研发持续升级，积累丰富笔试理论知识。注重理论与实践相结合，让学生在轻松的学习氛围中，用更简单的方法，找到更快捷的解题之道，深受学员的认可和好评。&q;,&q;avatar&q;:&q;193af66b81fc0b1.jpg&q;,&q;upperBodyPhoto&q;:null,&q;displayCoursePrefix&q;:&q;sydw&q;,&q;teacherStat&q;:{&q;teacherId&q;:35912,&q;episodeCount&q;:195,&q;scoreCount&q;:305,&q;avgScore&q;:9.947540983606558,&q;fiveGradeAvgScore&q;:4.97,&q;updateTime&q;:1773557231120},&q;auditionEpisode&q;:{&q;episodeTitle&q;:&q;个人展示课&q;,&q;episodeVideoUrl&q;:&q;https://vod.fbstatic.cn/22e9ceb2vodbj1251001446/ba2b7e275145403709538047971/m0NVEgAoIxsA.mp4?t=f2a4b300&a;us=4070880000&a;sign=90823bb2aa3547011e7a0d5700585e7c&q;},&q;memberOfCPC&q;:false,&q;tags&q;:null},&q;teachChannel&q;:1,&q;offline&q;:null,&q;duration&q;:7977,&q;hasAudition&q;:false,&q;bizType&q;:0,&q;bizId&q;:&q;726825&q;,&q;supportReplay&q;:true,&q;extraInfo&q;:null,&q;liveConfig&q;:{&q;episodeId&q;:9969628,&q;supportMultiGroup&q;:false,&q;exerciseBizType&q;:0,&q;videoDisplayType&q;:0,&q;avForwardType&q;:0,&q;useIntelligentRoom&q;:false,&q;hasStrokeKeynote&q;:true,&q;verticalModeType&q;:0,&q;originEpisodeId&q;:0,&q;supportRtmp&q;:false,&q;supportPk&q;:true,&q;supportLuckyBag&q;:true,&q;supportUserNoteStroke&q;:false,&q;communicateType&q;:0,&q;one2One&q;:false,&q;fakeLive&q;:false},&q;validStatus&q;:1,&q;supportLive&q;:true,&q;supportAiCatalog&q;:false,&q;hasIntelligentPen&q;:false,&q;useLocalRecording&q;:false,&q;useIntelligentRoom&q;:false,&q;hasSalePosition&q;:false,&q;hasEpisodeCards&q;:true,&q;lockedForShouna&q;:false,&q;needSignIn&q;:false,&q;needTeacherSignIn&q;:false,&q;enablePadPencil&q;:true,&q;displayExercise&q;:false,&q;supportLuckyBag&q;:true,&q;supportLivePk&q;:true},{&q;id&q;:9969632,&q;kePrefix&q;:&q;sydw&q;,&q;courseId&q;:6,&q;status&q;:3,&q;playStatus&q;:3,&q;type&q;:33,&q;recordingType&q;:0,&q;mediaType&q;:0,&q;title&q;:&q;【判断】精选好题 沉浸刷题&q;,&q;innerTitle&q;:&q;&q;,&q;startTime&q;:1736395200000,&q;endTime&q;:1736402400000,&q;teacher&q;:{&q;id&q;:16630,&q;userId&q;:63555782,&q;name&q;:&q;陈贺&q;,&q;brief&q;:&q;粉笔优质讲师&q;,&q;desc&q;:&q;粉笔优质教师\n6年一线教学授课经验，线上累计授课超800+小时，带班学生8000+；具有判断推理科目丰富的实践经验和系统扎实的专业理论，对山东、陕西、甘肃等各省判断推理科目的考情深入研究，全面了解命题规律及答题技巧，长期参与线上系统班和精品班的教研工作，撰写教研文章10余篇，出过近200道优质模拟题；具有幽默诙谐、形象生动、条理清晰的授课风格，让学生在轻松的学习氛围中，用更简单的方法，找到更快捷的解题之道，深受广大学员的认可和好评。&q;,&q;avatar&q;:&q;175d8f143291ec7.jpg&q;,&q;upperBodyPhoto&q;:null,&q;displayCoursePrefix&q;:&q;sydw&q;,&q;teacherStat&q;:{&q;teacherId&q;:16630,&q;episodeCount&q;:508,&q;scoreCount&q;:1860,&q;avgScore&q;:9.8516129032258,&q;fiveGradeAvgScore&q;:4.93,&q;updateTime&q;:1773584418412},&q;auditionEpisode&q;:{&q;episodeTitle&q;:&q;个人展示课&q;,&q;episodeVideoUrl&q;:&q;https://vod.fbstatic.cn/22e9ceb2vodbj1251001446/be9c21bc5145403709538211346/S3YE0Y3AIBoA.mp4?t=f2a4b300&a;us=4070880000&a;sign=aa0da2116ec32854b9c50d64d3429cec&q;},&q;memberOfCPC&q;:false,&q;tags&q;:null},&q;teachChannel&q;:1,&q;offline&q;:null,&q;duration&q;:7993,&q;hasAudition&q;:false,&q;bizType&q;:0,&q;bizId&q;:&q;726825&q;,&q;supportReplay&q;:true,&q;extraInfo&q;:null,&q;liveConfig&q;:{&q;episodeId&q;:9969632,&q;supportMultiGroup&q;:false,&q;exerciseBizType&q;:0,&q;videoDisplayType&q;:0,&q;avForwardType&q;:0,&q;useIntelligentRoom&q;:false,&q;hasStrokeKeynote&q;:true,&q;verticalModeType&q;:0,&q;originEpisodeId&q;:0,&q;supportRtmp&q;:false,&q;supportPk&q;:true,&q;supportLuckyBag&q;:true,&q;supportUserNoteStroke&q;:false,&q;communicateType&q;:0,&q;one2One&q;:false,&q;fakeLive&q;:false},&q;validStatus&q;:1,&q;supportLive&q;:true,&q;supportAiCatalog&q;:false,&q;hasIntelligentPen&q;:false,&q;useLocalRecording&q;:false,&q;useIntelligentRoom&q;:false,&q;hasSalePosition&q;:false,&q;hasEpisodeCards&q;:true,&q;lockedForShouna&q;:false,&q;needSignIn&q;:false,&q;needTeacherSignIn&q;:false,&q;enablePadPencil&q;:true,&q;displayExercise&q;:false,&q;supportLuckyBag&q;:true,&q;supportLivePk&q;:true},{&q;id&q;:9969666,&q;kePrefix&q;:&q;sydw&q;,&q;courseId&q;:6,&q;status&q;:3,&q;playStatus&q;:3,&q;type&q;:33,&q;recordingType&q;:0,&q;mediaType&q;:0,&q;title&q;:&q;【公基非法】精选好题 沉浸刷题&q;,&q;innerTitle&q;:&q;&q;,&q;startTime&q;:1736402400000,&q;endTime&q;:1736409600000,&q;teacher&q;:{&q;id&q;:32718,&q;userId&q;:80360201,&q;name&q;:&q;张宝丁&q;,&q;brief&q;:&q;粉笔优质讲师&q;,&q;desc&q;:&q;粉笔优质教师\n多年一线教学授课经验，具有公基科目丰富的实践经验及系统扎实的专业理论知识，对考情深入研究，多次参加粉笔授课研讨会议，全面把握公考笔试命题趋势及最新考情，积累丰富知识，累计授课时长2000+，让学生在轻松的学习氛围中，用更简单的方法，找到更快捷的解题之道，深受广大学员的认可和好评；在学员中具有非常好的口碑，是值得信赖的好导师。&q;,&q;avatar&q;:&q;1794afa1686d904.jpg&q;,&q;upperBodyPhoto&q;:null,&q;displayCoursePrefix&q;:&q;sydw&q;,&q;teacherStat&q;:{&q;teacherId&q;:32718,&q;episodeCount&q;:665,&q;scoreCount&q;:1043,&q;avgScore&q;:9.681687440076702,&q;fiveGradeAvgScore&q;:4.84,&q;updateTime&q;:1773616820914},&q;auditionEpisode&q;:{&q;episodeTitle&q;:&q;个人展示课&q;,&q;episodeVideoUrl&q;:&q;https://vod.fbstatic.cn/22e9ceb2vodbj1251001446/72b1f9f11397757888022138571/Q1bBr4nSV70A.mp4?t=f2a4b300&a;us=4070880000&a;sign=2f95ac8a59f6994b28f11d556e31ce67&q;},&q;memberOfCPC&q;:false,&q;tags&q;:null},&q;teachChannel&q;:1,&q;offline&q;:null,&q;duration&q;:7904,&q;hasAudition&q;:false,&q;bizType&q;:0,&q;bizId&q;:&q;726825&q;,&q;supportReplay&q;:true,&q;extraInfo&q;:null,&q;liveConfig&q;:{&q;episodeId&q;:9969666,&q;supportMultiGroup&q;:false,&q;exerciseBizType&q;:0,&q;videoDisplayType&q;:0,&q;avForwardType&q;:0,&q;useIntelligentRoom&q;:false,&q;hasStrokeKeynote&q;:true,&q;verticalModeType