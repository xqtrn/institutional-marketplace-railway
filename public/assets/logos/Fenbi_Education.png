过程中少走许多弯路。 \n参与组织各类教研工作，曾参与《行测的思维》《笔试系统讲义》《行测5000题》等多个套图书的编写工作，同时参与了多套模拟题的命制和审核工作。&q;,&q;avatar&q;:&q;171ee8c61a66542.jpg&q;,&q;upperBodyPhoto&q;:null,&q;displayCoursePrefix&q;:&q;gwy&q;,&q;teacherStat&q;:{&q;teacherId&q;:5418,&q;episodeCount&q;:1247,&q;scoreCount&q;:277061,&q;avgScore&q;:9.83515543508472,&q;fiveGradeAvgScore&q;:4.92,&q;updateTime&q;:1773623450694},&q;auditionEpisode&q;:{&q;episodeTitle&q;:&q;个人展示课&q;,&q;episodeVideoUrl&q;:&q;https://vod.fbstatic.cn/22e9ceb2vodbj1251001446/0f225a083560136621445998641/a18MDSiKuD8A.mp4?t=f2a4b300&a;us=4070880000&a;sign=37d51c78dbb190aa30426da491044bdf&q;},&q;memberOfCPC&q;:false,&q;tags&q;:null},&q;teachChannel&q;:1,&q;offline&q;:null,&q;duration&q;:11582,&q;hasAudition&q;:false,&q;bizType&q;:0,&q;bizId&q;:&q;710082&q;,&q;supportReplay&q;:true,&q;extraInfo&q;:null,&q;liveConfig&q;:{&q;episodeId&q;:11502032,&q;supportMultiGroup&q;:false,&q;exerciseBizType&q;:0,&q;videoDisplayType&q;:0,&q;avForwardType&q;:0,&q;useIntelligentRoom&q;:false,&q;hasStrokeKeynote&q;:true,&q;verticalModeType&q;:0,&q;originEpisodeId&q;:0,&q;supportRtmp&q;:false,&q;supportPk&q;:false,&q;supportLuckyBag&q;:false,&q;supportUserNoteStroke&q;:false,&q;communicateType&q;:0,&q;one2One&q;:false,&q;fakeLive&q;:false},&q;validStatus&q;:1,&q;supportLive&q;:true,&q;supportAiCatalog&q;:true,&q;hasIntelligentPen&q;:false,&q;useLocalRecording&q;:false,&q;useIntelligentRoom&q;:false,&q;hasSalePosition&q;:false,&q;hasEpisodeCards&q;:false,&q;lockedForShouna&q;:false,&q;needSignIn&q;:false,&q;needTeacherSignIn&q;:false,&q;enablePadPencil&q;:true,&q;displayExercise&q;:false,&q;supportLuckyBag&q;:false,&q;supportLivePk&q;:false},{&q;id&q;:11502036,&q;kePrefix&q;:&q;gwy&q;,&q;courseId&q;:1,&q;status&q;:3,&q;playStatus&q;:3,&q;type&q;:1,&q;recordingType&q;:0,&q;mediaType&q;:0,&q;title&q;:&q;判断-【2026上半年省考第12季&a;2027国考第7季】行测模考大赛&q;,&q;innerTitle&q;:&q;&q;,&q;startTime&q;:1772362800000,&q;endTime&q;:1772373600000,&q;teacher&q;:{&q;id&q;:1958,&q;userId&q;:16094527,&q;na