&q;avForwardType&q;:0,&q;useIntelligentRoom&q;:false,&q;hasStrokeKeynote&q;:true,&q;verticalModeType&q;:0,&q;originEpisodeId&q;:0,&q;supportRtmp&q;:false,&q;supportPk&q;:true,&q;supportLuckyBag&q;:true,&q;supportUserNoteStroke&q;:false,&q;communicateType&q;:0,&q;one2One&q;:false,&q;fakeLive&q;:false},&q;validStatus&q;:1,&q;supportLive&q;:true,&q;supportAiCatalog&q;:false,&q;hasIntelligentPen&q;:false,&q;useLocalRecording&q;:false,&q;useIntelligentRoom&q;:false,&q;hasSalePosition&q;:false,&q;hasEpisodeCards&q;:true,&q;lockedForShouna&q;:false,&q;needSignIn&q;:false,&q;needTeacherSignIn&q;:false,&q;enablePadPencil&q;:true,&q;displayExercise&q;:false,&q;supportLuckyBag&q;:true,&q;supportLivePk&q;:true},{&q;id&q;:9969968,&q;kePrefix&q;:&q;sydw&q;,&q;courseId&q;:6,&q;status&q;:3,&q;playStatus&q;:3,&q;type&q;:33,&q;recordingType&q;:0,&q;mediaType&q;:0,&q;title&q;:&q;【公基非法】精选好题 沉浸刷题&q;,&q;innerTitle&q;:&q;&q;,&q;startTime&q;:1737093600000,&q;endTime&q;:1737100800000,&q;teacher&q;:{&q;id&q;:34141,&q;userId&q;:67002168,&q;name&q;:&q;温东升&q;,&q;brief&q;:&q;粉笔优质讲师&q;,&q;desc&q;:&q;粉笔优质教师\n6年以上一线授课经验。带班学生10000+；熟悉国考、省考、事业单位考情，参与四川、山东、甘肃等省考情分析；长期扎根于公考、省考、事业单位教学教研工作，参与粉笔题库真题、模拟题解析编撰工作，时政文件解析工作，参与全国常识公基非法密卷课件及教案制作，农业农村书籍编撰工作。长期担任常识公基、判断课程主讲。课堂氛围轻松幽默，寓教于乐，能够结合当下时政，灵活运用到实际讲解之中，逻辑思维性强，善于沟通，能够迅速帮助考生进行全方位提升。&q;,&q;avatar&q;:&q;19841271adb989c.jpg&q;,&q;upperBodyPhoto&q;:null,&q;displayCoursePrefix&q;:&q;sydw&q;,&q;teacherStat&q;:{&q;teacherId&q;:34141,&q;episodeCount&q;:708,&q;scoreCount&q;:1467,&q;avgScore&q;:9.745057941376977,&q;fiveGradeAvgScore&q;:4.87,&q;updateTime&q;:1773480813169},&q;auditionEpisode&q;:{&q;episodeTitle&q;:&q;个人展示课&q;,&q;episodeVideoUrl&q;:&q;https://vod.fbstatic.cn/22e9ceb2vodbj1251001446/7b5794655145403710132043113/2OaZlykd0yAA.mp4?t=f2a4b300&a;us=4070880000&a;sign=63dc74bcedbc74171e790ef405ff495e&q;},&q;memberOfCPC&q;:false,&q;tags&q;:null},&q;teachChannel&q;:1,&q;offline&q;:null,&q;duration&q;:8002,&q;hasAudition&q;:false,&q;bizType&q;:0,&q;bizId&q;:&q;726825&