Id&q;:11001180,&q;supportMultiGroup&q;:false,&q;exerciseBizType&q;:0,&q;videoDisplayType&q;:0,&q;avForwardType&q;:0,&q;useIntelligentRoom&q;:false,&q;hasStrokeKeynote&q;:true,&q;verticalModeType&q;:0,&q;originEpisodeId&q;:0,&q;supportRtmp&q;:false,&q;supportPk&q;:true,&q;supportLuckyBag&q;:true,&q;supportUserNoteStroke&q;:false,&q;communicateType&q;:0,&q;one2One&q;:false,&q;fakeLive&q;:false},&q;validStatus&q;:1,&q;supportLive&q;:true,&q;supportAiCatalog&q;:false,&q;hasIntelligentPen&q;:false,&q;useLocalRecording&q;:false,&q;useIntelligentRoom&q;:false,&q;hasSalePosition&q;:false,&q;hasEpisodeCards&q;:true,&q;lockedForShouna&q;:false,&q;needSignIn&q;:false,&q;needTeacherSignIn&q;:false,&q;enablePadPencil&q;:true,&q;displayExercise&q;:false,&q;supportLuckyBag&q;:true,&q;supportLivePk&q;:true},{&q;id&q;:11001183,&q;kePrefix&q;:&q;sydw&q;,&q;courseId&q;:6,&q;status&q;:3,&q;playStatus&q;:3,&q;type&q;:33,&q;recordingType&q;:0,&q;mediaType&q;:0,&q;title&q;:&q;【公基法律】精选好题 沉浸刷题&q;,&q;innerTitle&q;:&q;&q;,&q;startTime&q;:1758254400000,&q;endTime&q;:1758261600000,&q;teacher&q;:{&q;id&q;:34129,&q;userId&q;:83514929,&q;name&q;:&q;刘思秀&q;,&q;brief&q;:&q;粉笔优质讲师&q;,&q;desc&q;:&q;粉笔优质教师\n六年一线教学经验，总授课时长累计超2500小时。多年深耕事业单位考试领域，教学经验丰富，紧跟考情时新热点，对考情、真题、命题方向理解深刻。粉笔事业单位笔试教研材料撰写人之一，四年模考命题经验，多次参加粉笔教研活动，分享授课经验心得，助力粉笔理论研发升级。多年小班带队老师，学员累计评分4.9，结班上岸率 72%，名下多位学员岗位第一入面。授课条理清晰，讲解风趣幽默，擅长化难为简，总结做题规律，将复杂的笔试知识点进行系统梳理，帮助学员把握知识点底层逻辑，减轻学员记忆负担，快速掌握笔试答题技巧。&q;,&q;avatar&q;:&q;1983b891b2af100.jpg&q;,&q;upperBodyPhoto&q;:null,&q;displayCoursePrefix&q;:&q;sydw&q;,&q;teacherStat&q;:{&q;teacherId&q;:34129,&q;episodeCount&q;:613,&q;scoreCount&q;:970,&q;avgScore&q;:9.721649484536082,&q;fiveGradeAvgScore&q;:4.86,&q;updateTime&q;:1773558647472},&q;auditionEpisode&q;:null,&q;memberOfCPC&q;:false,&q;tags&q;:null},&q;teachChannel&q;:1,&q;offline&q;:null,&q;duration&q;:8455,&q;hasAudition&q;:false,&q;bizType&q;:0,&q;bizId&q;:&q;726825&q;,&q;supportReplay&q;:true,&q;extraInfo&q;:null,&q;liveConfig&q;:{&q;episodeId&q;:11001183,&q;supportMultiGroup&q;:false,&q;exerciseBizType&q;:0,&q;videoDisplayType&q;:0,&q;avForwardType&q;:0,&q;useIntelligentRoom&q;:false,&q;hasStrokeKeynote&q;:true,&q;verticalModeType&q;:0,&q;originEpisodeId&q;:0,&q;supportRtmp&q;:false,&q;supportPk&q;:true,&q;supportLuckyBag&q;:true,&q;supportUserNoteStroke&q;:false,&q;communicateType&q;:0,&q;one2One&q;:false,&q;fakeLive&q;:false},&q;validStatus&q;:1,&q;supportLive&q;:true,&q;supportAiCatalog&q;:false,&q;hasIntelligentPen&q;:false,&q;useLocalRecording&q;:false,&q;useIntelligentRoom&q;:false,&q;hasSalePosition&q;:false,&q;hasEpisodeCards&q;:true,&q;lockedForShouna&q;:false,&q;needSignIn&q;:false,&q;needTeacherSignIn&q;:false,&q;enablePadPencil&q;:true,&q;displayExercise&q;:false,&q;supportLuckyBag&q;:true,&q;supportLivePk&q;:true},{&q;id&q;:11001185,&q;kePrefix&q;:&q;sydw&q;,&q;courseId&q;:6,&q;status&q;:3,&q;playStatus&q;:3,&q;type&q;:33,&q;recordingType&q;:0,&q;mediaType&q;:0,&q;title&q;:&q;【言语】精选好题 沉浸刷题&q;,&q;innerTitle&q;:&q;&q;,&q;startTime&q;:1758261600000,&q;endTime&q;:1758268800000,&q;teacher&q;:{&q;id&q;:16530,&q;userId&q;:73216758,&q;name&q;:&q;刘开慧&q;,&q;brief&q;:&q;粉笔优质讲师&q;,&q;desc&q;:&q;粉笔优质讲师\n四年公考教学经验，全面了解事业单位言语科目近年来命题规律、重难点及不同类型题目答题技巧，授课条理清晰，语言通俗易懂，风格幽默风趣，实战经验丰富，且擅长深入浅出，激发学员学习热情，深受学员喜爱。&q;,&q;avatar&q;:&q;198551347778a1e.jpg&q;,&q;upperBodyPhoto&q;:null,&q;displayCoursePrefix&q;:&q;sydw&q;,&q;teacherStat&q;:{&q;teacherId&q;:16530,&q;episodeCount&q;:350,&q;scoreCount&q;:1605,&q;avgScore&q;:9.879127725856709,&q;fiveGradeAvgScore&q;:4.94,&q;updateTime&q;:1773566095917},&q;auditionEpisode&q;:{&q;episodeTitle&q;:&q;个人展示课&q;,&q;episodeVideoUrl&q;:&q;https://vod.fbstatic.cn/22e9ceb2vodbj1251001446/b7e4edc21253642695664039132/hf14S37Vsx0A.mp4?t=f2a4b300&a;us=4070880000&a;sign=7574a5c01ba998ba731acf886001efb3&q;},&q;memberOfCPC&q;:false,&q;tags&q;:null},&q;teachChannel&q;:1,&q;offline&q;:null,&q;duration&q;:7747,&q;hasAudition&q;:false,&q;bizType&q;:0,&q;bizId&q;:&q;726825&q;,&q;supportReplay&q;:true,&q;extraInfo&q;:null,&q;liveConfig&q;:{&q;episodeId&q;:11001185,&q;supportMultiGroup&q;:false,&q;exerciseBizType&q;:0,&q;videoDisplayType&q;:0,&q;avForwardType&q;:0,&q;useIntelligentRoom&q;:false,&q;hasStrokeKeynote&q;:true,&q;verticalModeType&q;:0,&q;originEpisodeId&q;:0,&q;supportRtmp&q;:false,&q;supportPk&q;:true,&q;supportLuckyBag&q;:true,&q;supportUserNoteStroke&q;:false,&q;communicateType&q;:0,&q;one2One&q;:false,&q;fakeLive&q;:false},&q;validStatus&q;:1,&q;supportLive&q;:true,&q;supportAiCatalog&q;:false,&q;hasIntelligentPen&q;:false,&q;useLocalRecording&q;:false,&q;useIntelligentRoom&q;:false,&q;hasSalePosition&q;:false,&q;hasEpisodeCards&q;:true,&q;lockedForShouna&q;:false,&q;needSignIn&q;:false,&q;needTeacherSignIn&q;:false,&q;enablePadPencil&q;:true,&q;displayExercise&q;:false,&q;supportLuckyBag&q;:true,&q;supportLivePk&q;:true},{&q;id&q;:11001189,&q;kePrefix&q;:&q;sydw&q;,&q;courseId&q;:6,&q;status&q;:3,&q;playStatus&q;:3,&q;type&q;:33,&q;recordingType&q;:0,&q;mediaType&q;:0,&q;title&q;:&q;【综应】精选好题 沉浸刷题&q;,&q;innerTitle&q;:&q;&q;,&q;startTime&q;:1758268800000,&q;endTime&q;:1758276000000,&q;teacher&q;:{&q;id&q;:13993,&q;userId&q;:69689351,&q;name&q;:&q;王一如&q;,&q;brief&q;:&q;粉笔优质讲师&q;,&q;desc&q;:&q;粉笔优质讲师\n法学硕士，具有7年一线授课经验，累计授课超千余小时。\n具有申论、综应科目丰富的实践经验，专业理论知识扎实。能够全面了解考试重难点及不同类型题目答题技巧，精准把握各地考试要点与命题方向。\n学员口碑：累计评分达4.9分。授课思维灵活，教学态度认真负责，富有感染力和亲和力，善于将实战与技巧相结合，让学员用简洁高效的方法找到解题捷径，能够帮助学员做到学以致用，深受学员高度认可。&q;,&q;avatar&q;:&q;1769373e273385e.jpg&q;,&q;upperBodyPhoto&q;:null,&q;displayCoursePrefix&q;:&q;sydw&q;,&q;teacherStat&q;:{&q;teacherId&q;:13993,&q;episodeCount&q;:501,&q;scoreCount&q;:776,&q;avgScore&q;:9.829896907216488,&q;fiveGradeAvgScore&q;:4.91,&q;updateTime&q;:1773403079901},&q;auditionEpisode&q;:{&q;episodeTitle&q;:&q;个人展示课&q;,&q;episodeVideoUrl&q;:&q;https://vod.fbstatic.cn/22e9ceb2vodbj1251001446/48e924035145403708540695624/ZUytViIKFgMA.mp4?t=f2a4b300&a;us=4070880000&a;sign=c6898af63e68d18207f2687b1d8c65ef&q;},&q;memberOfCPC&q;:false,&q;tags&q;:null},&q;teachChannel&