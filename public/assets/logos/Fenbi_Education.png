ayExercise&q;:false,&q;supportLuckyBag&q;:false,&q;supportLivePk&q;:false},{&q;id&q;:11705773,&q;kePrefix&q;:&q;gwy&q;,&q;courseId&q;:1,&q;status&q;:3,&q;playStatus&q;:3,&q;type&q;:1,&q;recordingType&q;:0,&q;mediaType&q;:0,&q;title&q;:&q;早课-政治理论常见词汇（三）&q;,&q;innerTitle&q;:&q;&q;,&q;startTime&q;:1773615600000,&q;endTime&q;:1773617400000,&q;teacher&q;:{&q;id&q;:11676,&q;userId&q;:44787868,&q;name&q;:&q;刘鸿&q;,&q;brief&q;:&q;粉笔公基优质讲师&q;,&q;desc&q;:&q;粉笔公考常识、公共基础知识优质讲师，累计授课1W+。9年公考培训经验，常年从事一线授课工作。对马克思主义哲学、中共党史、中国特色社会主义理论体系、大政方针时事政治等政治理论有系统研究。授课脉络清晰重点突出，课堂风格激情幽默，擅长学员备考规划指导及技巧点拨。&q;,&q;avatar&q;:&q;192d26d60f9ea18.jpg&q;,&q;upperBodyPhoto&q;:null,&q;displayCoursePrefix&q;:&q;gwy&q;,&q;teacherStat&q;:{&q;teacherId&q;:11676,&q;episodeCount&q;:764,&q;scoreCount&q;:235431,&q;avgScore&q;:9.907361392509907,&q;fiveGradeAvgScore&q;:4.95,&q;updateTime&q;:1773623300330},&q;auditionEpisode&q;:null,&q;memberOfCPC&q;:false,&q;tags&q;:null},&q;teachChannel&q;:1,&q;offline&q;:null,&q;duration&q;:3580,&q;hasAudition&q;:false,&q;bizType&q;:0,&q;bizId&q;:&q;773251&q;,&q;supportReplay&q;:true,&q;extraInfo&q;:null,&q;liveConfig&q;:{&q;episodeId&q;:11705773,&q;supportMultiGroup&q;:false,&q;exerciseBizType&q;:0,&q;videoDisplayType&q;:0,&q;avForwardType&q;:0,&q;useIntelligentRoom&q;:false,&q;hasStrokeKeynote&q;:true,&q;verticalModeType&q;:0,&q;originEpisodeId&q;:0,&q;supportRtmp&q;:false,&q;supportPk&q;:false,&q;supportLuckyBag&q;:false,&q;supportUserNoteStroke&q;:false,&q;communicateType&q;:0,&q;fakeLive&q;:false,&q;one2One&q;:false},&q;validStatus&q;:1,&q;supportLive&q;:true,&q;supportAiCatalog&q;:false,&q;hasIntelligentPen&q;:false,&q;useLocalRecording&q;:false,&q;useIntelligentRoom&q;:false,&q;hasSalePosition&q;:false,&q;hasEpisodeCards&q;:false,&q;lockedForShouna&q;:false,&q;needSignIn&q;:false,&q;needTeacherSignIn&q;:false,&q;enablePadPencil&q;:false,&q;displayExercise&q;:false,&q;supportLuckyBag&q;:false,&q;supportLivePk&q;:false},{&q;id&q;:11705774,&q;kePrefix&q;:&q;gwy&q;,&q;courseId&q;:1,&q;status&q;:0,&q;playStatus&q;:0,&q;type&q;:1,&q;recordingType&q;:0,&q;mediaType&q;:0,&q;title&q;:&q;晚课-热点夜话11&q;,&q;innerTitle&q;:&q;&q;,&q;startTime&q;:1773669600000,&q;endTime&q;:1773672300000,&q;teacher&q;:{&q;id&q;:1182,&q;userId&q;:29881941,&q;name&q;:&q;于林&q;,&q;brief&q;:&q;粉笔面试研究院成员、高级面试讲师&q;,&q;desc&q;:&q;粉笔公考面试优质讲师\n7年公考面试授课经验，粉笔大区面试教学教研负责人，主要承担国省考线上理论和各类型公开课授课，参与过多省市、多部门面试教材的教研、题本研发、课程设计和面试师资培训工作，曾于体制内任职，工作经验丰富，可给予学员更多的工作实务教学内容。\n于林老师拥有多年一线授课经历与面试教研经验，始终以“师者，传道授业解惑也”为人生信条，通过传道，向学生们传授道理，使学生正直阳光，积极向上;通过授业，耐心细致地为学员讲授面试的内容，由表及里、深入浅出;通过解惑，一针见血找到学生问题，并指明解决问题的方法，使学员\n茅塞顿开，深受学员喜欢。&q;,&q;avatar&q;:&q;171ee6f96c2ae72.jpg&q;,&q;upperBodyPhoto&q;:null,&q;displayCoursePrefix&q;:&q;gwy&q;,&q;teacherStat&q;:{&q;teacherId&q;:1182,&q;episodeCount&q;:1214,&q;scoreCount&q;:28583,&q;avgScore&q;:9.872161774481334,&q;fiveGradeAvgScore&q;:4.94,&q;updateTime&q;:1773595085305},&q;auditionEpisode&q;:{&q;episodeTitle&q;:&q;个人展示课&q;,&q;episodeVideoUrl&q;:&q;https://vod.fbstatic.cn/22e9ceb2vodbj1251001446/9b6cc38f243791580417850235/f0.mp4?t=f2a4b300&a;us=4070880000&a;sign=5d693678e28fe7d30da2599c79d22785&q;},&q;memberOfCPC&q;:false,&q;tags&q;:null},&q;teachChannel&q;:1,&q;offline&q;:null,&q;duration&q;:2700,&q;hasAudition&q;:false,&q;bizType&q;:0,&q;bizId&q;:&q;773251&q;,&q;supportReplay&q;:true,&q;extraInfo&q;:null,&q;liveConfig&q;:{&q;episodeId&q;:11705774,&q;supportMultiGroup&q;:false,&q;exerciseBizType&q;:0,&q;videoDisplayType&q;:0,&q;avForwardType&q;:0,&q;useIntelligentRoom&q;:false,&q;hasStrokeKeynote&q;:false,&q;verticalModeType&q;:0,&q;originEpisodeId&q;:0,&q;supportRtmp&q;:false,&q;supportPk&q;:false,&q;supportLuckyBag&q;:false,&q;supportUserNoteStroke&q;:false,&q;communicateType&q;:0,&q;fakeLive&q;:false,&q;one2One&q;:false},&q;validStatus&q;:1,&q;supportLive&q;:true,&q;supportAiCatalog&q;:false,&q;hasIntelligentPen&q;:false,&q;useLocalRecording&q;:false,&q;useIntelligentRoom&q;:false,&q;hasSalePosition&q;:false,&q;hasEpisodeCards&q;:false,&q;lockedForShouna&q;:false,&q;needSignIn&q;:false,&q;needTeacherSignIn&q;:false,&q;enablePadPencil&q;:false,&q;displayExercise&q;:false,&q;supportLuckyBag&q;:false,&q;supportLivePk&q;:false},{&q;id&q;:11705775,&q;kePrefix&q;:&q;gwy&q;,&q;courseId&q;:1,&q;status&q;:0,&q;playStatus&q;:0,&q;type&q;:1,&q;recordingType&q;:0,&q;mediaType&q;:0,&q;title&q;:&q;早课-机关公文解码：公务员必须会的常用文种&q;,&q;innerTitle&q;:&q;&q;,&q;startTime&q;:1773702000000,&q;endTime&q;:1773703800000,&q;teacher&q;:{&q;id&q;:32254,&q;userId&q;:74446336,&q;name&q;:&q;张月亮&q;,&q;brief&q;:&q;粉笔公考常识优质讲师&q;,&q;desc&q;:&q;       粉笔常识优质老师。\n       性格耐心细致，善于把握学员个性化特点，因材施教，认真负责，对待课程一丝不苟。讲课生动形象，机智诙谐，听课体验好，学员可以在轻松愉快的氛围中学习，跟着老师节奏主动思考。老师同时注重“反模板”教学，助力学员走出答题模板与误区。&q;,&q;avatar&q;:&q;1783f5430429930.jpg&q;,&q;upperBodyPhoto&q;:null,&q;displayCoursePrefix&q;:&q;gwy&q;,&q;teacherStat&q;:{&q;teacherId&q;:32254,&q;episodeCount&q;:133,&q;scoreCount&q;:20388,&q;avgScore&q;:9.69501667647632,&q;fiveGradeAvgScore&q;:4.85,&q;updateTime&q;:1773491006064},&q;auditionEpisode&q;:null,&q;memberOfCPC&q;:false,&q;tags&q;:null},&q;teachChannel&q;:1,&q;offline&q;:null,&q;duration&q;:1800,&q;hasAudition&q;:false,&q;bizType&q;:0,&q;bizId&q;:&q;773251&q;,&q;supportReplay&q;:true,&q;extraInfo&q;:null,&q;liveConfig&q;:{&q;episodeId&q;:11705775,&q;supportMultiGroup&q;:false,&q;exerciseBizType&q;:0,&q;videoDisplayType&q;:0,&q;avForwardType&q;:0,&q;useIntelligentRoom&q;:false,&q;hasStrokeKeynote&q;:false,&q;verticalModeType&q;:0,&q;originEpisodeId&q;:0,&q;supportRtmp&q;:false,&q;supportPk&q;:false,&q;supportLuckyBag&q;:false,&q;supportUserNoteStroke&q;:false,&q;communicateType&q;:0,&q;fakeLive&q;:false,&q;one2One&q;:false},&q;validStatus&q;:1,&q;supportLive&q;:true,&q;supportAiCatalog&q;:false,&q;hasIntelligentPen&q;:false,&q;useLocalRecording&q;:false,&q;useIntelligentRoom&q;:false,&q;hasSalePosition&q;:false,&q;hasEpisodeCards&q;:false,&q;lockedForShouna&q;:false,&q;needSignIn&q;:false,&q;needTeacherSignIn&q;:false,&q;enablePadPencil&q;:false,&q;displayExercise&q;:false,&q;supportLuckyBag&q;:false,&q;supportLivePk&q;:false},{&q;id&q;:11705776,&q;kePrefix&q;:&q;gwy&q;,&q;courseId&q;:1,&q;status&q;:0,&q;playStatus&q;:0,&q;type&q;:1,&q;recordingType&q;:0,&q;mediaType&q;:0,&q;title&q;:&q;晚课-热点夜话12&q;,&q;innerTitle&q;:&q;&q;,&q;startTime&q;:1773756000000,&q;endTime&q;:1773758700000,&q;teacher&q;:{&q;id&q;:1875,&q;userId&q;:41410898,&q;name&q;:&q;马婉卿&q;,&q;brief&q;:&q;粉笔面试研究院成员、高级面试讲师&q;,&q;desc&q;:&q;       9年授课经验，累计授课时长超过10000小时，培训师资千余人。长期致力于公务员考试研究，曾有基层的工作经验，对试题有深刻的把握和独到的见解。授课风趣幽默，注重因材施教，打造个性化答题亮点，相信最好的相遇是能成就彼此的人生。 \n       参与组织各类授课研讨会议，教研讨论和题本研发等活动，曾获粉笔“卓越教师”称号，著有《素材集萃30例》等图书。&q;,&q;avatar&q;:&q;17d466e42ad2b67.jpg&q;,&q;upperBodyPhoto&q;:null,&q;displayCoursePrefix&q;:&q;gwy&q;,&q;teacherStat&q;:{&q;teacherId&q;:1875,&q;episodeCount&q;:1464,&q;scoreCount&q;:27739,&q;avgScore&q;:9.859980532823823,&q;fiveGradeAvgScore&q;:4.93,&q;updateTime&q;:1773585462832},&q;auditionEpisode&q;:{&q;episodeTitle&q;:&q;个人展示课&q;,&q;episodeVideoUrl&q;:&q;https://vod.fbstatic.cn/22e9ceb2vodbj1251001446/d5f9fc9b243791580578137376/f0.mp4?t=f2a4b300&a;us=4070880000&a;sign=2948f145c310a3e6cfb2e4c2252e43ee&q;},&q;memberOfCPC&q;:false,&q;tags&q;:null},&q;teachChannel&q;:1,&q;offline&q;:null,&q;duration&q;:2700,&q;hasAudition&q;:false,&q;bizType&q;:0,&q;bizId&q;:&q;773251&q;,&q;supportReplay&q;:true,&q;extraInfo&q;:null,&q;liveConfig&q;:{&q;episodeId&q;:11705776,&q;supportMultiGroup&q;:false,&q;exerciseBizType&q;:0,&q;videoDisplayType&q;:0,&q;avForwardType&q;:0,&q;useIntelligentRoom&q;:false,&q;hasStrokeKeynote&q;:false,&q;verticalModeType&q;:0,&q;originEpisodeId&q;:0,&q;supportRtmp&q;:false,&q;supportPk&q;:false,&q;supportLuckyBag&q;:false,&q;supportUserNoteStroke&q;:false,&q;communicateType&q;:0,&q;fakeLive&q;:false,&q;one2One&q;:false},&q;validStatus&q;:1,&q;supportLive&q;:true,&q;supportAiCatalog&q;:false,&q;hasIntelligentPen&q;:false,&q;useLocalRecording&q;:false,&q;useIntelligentRoom&q;:false,&q;hasSalePosition&q;:false,&q;hasEpisodeCards&q;:false,&q;lockedForShouna&q;:false,&q;needSignIn&q;:false,&q;needTeacherSignIn&q;:false,&q;enablePadPencil&q;:false,&q;displayExercise&q;:false,&q;supportLuckyBag&q;:false,&q;supportLivePk&q;:false},{&q;id&q;:11705777,&q;kePrefix&q;:&q;gwy&q;,&q;courseId&q;:1,&q;status&q;:0,&q;playStatus&q;:0,&q;type&q;:1,&q;recordingType&q;:0,&q;mediaType&q;:0,&q;title&q;:&q;早课-成语登科计划（三）&q;,&q;innerTitle&q;:&q;&q;,&q;startTime&q;:1773788400000,&q;endTime&q;:1773791100000,&q;teacher&q;:{&q;id&q;:4996,&q;userId&q;:51581932,&q;name&q;:&q;司琦&q;,&q;brief&q;:&q;粉笔言语优质教师&q;,&q;desc&q;:&q;粉笔言语优质教师，8年授课经验，长期深耕公务员行测言语模块，精准把握命题趋势，对各类题型有着独到的见解，曾负责师资培训、模拟题撰写和教材编写等工作。教学中，注重因材施教，助力学员夯实基础、提升能力。授课风格幽默且严谨，讲解深入浅出，让复杂的知识变得通俗易懂，深受学员好评。&q;,&q;avatar&q;:&q;19270dc6dfb73cb.jpg&q;,&q;upperBodyPhoto&q;:null,&q;displayCoursePrefix&q;:&q;gwy&q;,&q;teacherStat&q;:{&q;teacherId&q;:4996,&q;episodeCount&q;:1396,&q;scoreCount&q;:216731,&q;avgScore&q;:9.871767306015292,&q;fiveGradeAvgScore&q;:4.94,&q;updateTime&q;:1773594524697},&q;auditionEpisode&q;:{&q;episodeTitle&q;:&q;个人展示课&q;,&q;episodeVideoUrl&q;:&q;https://vod.fbstatic.cn/22e9ceb2vodbj1251001446/9cc6e9f83560136621447402832/oxLbyW9tbc4A.mp4?t=f2a4b300&a;us=4070880000&a;sign=742574c1fe64d1e966a0d28dfe74cc08&q;},&q;memberOfCPC&q;:false,&q;tags&q;:null},&q;teachChannel&q;:1,&q;offline&q;:null,&q;duration&q;:2700,&q;hasAudition&q;:false,&q;bizType&q;:0,&q;bizId&q;:&q;773251&q;,&q;supportReplay&q;:true,&q;extraInfo&q;:null,&q;liveConfig&q;:{&q;episodeId&q;:11705777,&q;supportMultiGroup&q;:false,&q;exerciseBizType&q;:0,&q;videoDisplayType&q;:0,&q;avForwardType&q;:0,&q;useIntelligentRoom&q;:false,&q;hasStrokeKeynote&q;:false,&q;verticalModeType&q;:0,&q;originEpisodeId&q;:0,&q;supportRtmp&q;:false,&q;supportPk&q;:false,&q;supportLuckyBag&q;:false,&q;supportUserNoteStroke&q;:false,&q;communicateType&q;:0,&q;fakeLive&q;:false,&q;one2One&q;:false},&q;validStatus&q;:1,&q;supportLive&q;:true,&q;supportAiCatalog&q;:false,&q;hasIntelligentPen&q;:false,&q;useLocalRecording&q;:false,&q;useIntelligentRoom&q;:false,&q;hasSalePosition&q;:false,&q;hasEpisodeCards&q;:false,&q;lockedForShouna&q;:false,&q;needSignIn&q;:false,&q;needTeacherSignIn&q;:false,&q;enablePadPencil&q;:false,&q;displayExercise&q;:false,&q;supportLuckyBag&q;:false,&q;supportLivePk&q;:false},{&q;id&q;:11705778,&q;kePrefix&q;:&q;gwy&q;,&q;courseId&q;:1,&q;status&q;:0,&q;playStatus&q;:0,&q;type&q;:1,&q;recordingType&q;:0,&q;mediaType&q;:0,&q;title&q;:&q;晚课-热点夜话13&q;,&q;innerTitle&q;:&q;&q;,&q;startTime&q;:1773842400000,&q;endTime&q;:1773845100000,&q;teacher&q;:{&q;id&q;:3095,&q;userId&q;:48741920,&q;name&q;:&q;姚柯&q;,&q;brief&q;:&q;公考面试、言语理解与表达主讲&q;,&q;desc&q;:&q;粉笔公考面试、言语理解与表达优质讲师。多年机关工作经验、军队服役经历、面试状元、硕士学历。授课逻辑严谨且却又不失轻松幽默。擅长结合每位同学不同的情况，从应试角度帮助学员掌握解题方法和答题技巧，个性化的设定学习内容，帮助学员打造最适合自身的答题思路。用最短的时间，让你遇见不一样的自己。&q;,&q;avatar&q;:&q;1715cd40ca069a3.png&q;,&q;upperBodyPhoto&q;:null,&q;displayCoursePrefix&q;:&q;gwy&q;,&q;teacherStat&q;:{&q;teacherId&q;:3095,&q;episodeCount&q;:178,&q;scoreCount&q;:4505,&q;avgScore&q;:9.878357380688126,&q;fiveGradeAvgScore&q;:4.94,&q;updateTime&q;:1773458339540},&q;auditionEpisode&q;:null,&q;memberOfCPC&q;:false,&q;tags&q;:null},&q;teachChannel&q;:1,&q;offline&q;:null,&q;duration&q;:2700,&q;hasAudition&q;:false,&q;bizType&q;:0,&q;bizId&q;:&q;773251&q;,&q;supportReplay&q;:true,&q;extraInfo&q;:null,&q;liveConfig&q;:{&q;episodeId&q;:11705778,&q;supportMultiGroup&q;:false,&q;exerciseBizType&q;:0,&q;videoDisplayType&q;:0,&q;avForwardType&q;:0,&q;useIntelligentRoom&q;:false,&q;hasStrokeKeynote&q;:false,&q;verticalModeType&q;:0,&q;originEpisodeId&q;:0,&q;supportRtmp&q;:false,&q;supportPk&q;:false,&q;supportLuckyBag&q;:false,&q;supportUserNoteStroke&q;:false,&q;communicateType&q;:0,&q;fakeLive&q;:false,&q;one2One&q;:false},&q;validStatus&q;:1,&q;supportLive&q;:true,&q;supportAiCatalog&q;:false,&q;hasIntelligentPen&q;:false,&q;useLocalRecording&q;:false,&q;useIntelligentRoom&q;:false,&q;hasSalePosition&q;:false,&q;hasEpisodeCards&q;:false,&q;lockedForShouna&q;:false,&q;needSignIn&q;:false,&q;needTeacherSignIn&q;:false,&q;enablePadPencil&q;:false,&q;displayExercise&q;:false,&q;supportLuckyBag&q;:false,&q;supportLivePk&q;:false},{&q;id&q;:11705779,&q;kePrefix&q;:&q;gwy&q;,&q;courseId&q;:1,&q;status&q;:0,&q;playStatus&q;:0,&q;type&q;:1,&q;recordingType&q;:0,&q;mediaType&q;:0,&q;title&q;:&q;早课-类比常识速记（二）&q;,&q;innerTitle&q;:&q;&q;,&q;startTime&q;:1773874800000,&q;endTime&q;:1773877500000,&q;teacher&q;:{&q;id&q;:7754,&q;userId&q;:61196798,&q;name&q;:&q;王东岳&q;,&q;brief&q;:&q;粉笔判断优质教师&q;,&q;desc&q;:&q;粉笔判断优质教师。\n7年授课经验，累计授课时长6000+，授课评分4.9+，培训学员100余万人次。有着多年丰富的国考及省考授课经验，逻辑框架清晰。授课风格深入浅出，结构严谨又不乏幽默；授课内容直指考试核心。教学方式多样，因材施教，掌握学生心理，深受学员欢迎。\n参与制作国省考授课讲义、《行测的思维》、《决战行测5000题》等多套图书。&q;,&q;avatar&q;:&q;1928e11bb6d26f0.jpg&q;,&q;upperBodyPhoto&q;:null,&q;displayCoursePrefix&q;:&q;gwy&q;,&q;teacherStat&q;:{&q;teacherId&q;:7754,&q;episodeCount&q;:1301,&q;scoreCount&q;:243516,&q;avgScore&q;:9.87308431478835,&q;fiveGradeAvgScore&q;:4.94,&q;updateTime&q;:1773620855135},&q;auditionEpisode&q;:{&q;episodeTitle&q;:&q;个人展示课&q;,&q;episodeVideoUrl&q;:&q;https://vod.fbstatic.cn/22e9ceb2vodbj1251001446/4bb38a333560136621446283020/WcYGrU72AukA.mp4?t=f2a4b300&a;us=4070880000&a;sign=0634969fb328a1e47afdf3e0332c5544&q;},&q;memberOfCPC&q;:false,&q;tags&q;:null},&q;teachChannel&q;:1,&q;offline&q;:null,&q;duration&q;:2700,&q;hasAudition&q;:false,&q;bizType&q;:0,&q;bizId&q;:&q;773251&q;,&q;supportReplay&q;:true,&q;extraInfo&q;:null,&q;liveConfig&q;:{&q;episodeId&q;:11705779,&q;supportMultiGroup&q;:false,&q;exerciseBizType&q;:0,&q;videoDisplayType&q;:0,&q;avForwardType&q;:0,&q;useIntelligentRoom&q;:false,&q;hasStrokeKeynote&q;:false,&q;verticalModeType&q;:0,&q;originEpisodeId&q;:0,&q;supportRtmp&q;:false,&q;supportPk&q;:false,&q;supportLuckyBag&q;:false,&q;supportUserNoteStroke&q;:false,&q;communicateType&q;:0,&q;fakeLive&q;:false,&q;one2One&q;:false},&q;validStatus&q;:1,&q;supportLive&q;:true,&q;supportAiCatalog&q;:false,&q;hasIntelligentPen&q;:false,&q;useLocalRecording&q;:false,&q;useIntelligentRoom&q;:false,&q;hasSalePosition&q;:false,&q;hasEpisodeCards&q;:false,&q;lockedForShouna&q;:false,&q;needSignIn&q;:false,&q;needTeacherSignIn&q;:false,&q;enablePadPencil&q;:false,&q;displayExercise&q;:false,&q;supportLuckyBag&q;:false,&q;supportLivePk&q;:false},{&q;id&q;:11705780,&q;kePrefix&q;:&q;gwy&q;,&q;courseId&q;:1,&q;status&q;:0,&q;playStatus&q;:0,&q;type&q;:1,&q;recordingType&q;:0,&q;mediaType&q;:0,&q;title&q;:&q;晚课-热点夜话14&q;,&q;innerTitle&q;:&q;&q;,&q;startTime&q;:1773928800000,&q;endTime&q;:1773931500000,&q;teacher&q;:{&q;id&q;:1869,&q;userId&q;:44618334,&q;name&q;:&q;张婼予&q;,&q;brief&q;:&q;粉笔面试研究院成员、高级面试讲师&q;,&q;desc&q;:&q;       8年以上公考面试授课经验，曾任粉笔培训学院常务副院长职务，负责粉笔面试师资的整体培训工作。现任粉笔东北大区面试教学教研负责人，主要承担国省考面试理论大课、线上公开课及线上直播工作。\n       张婼予老师具备深厚的知识储备，对面试理论见解独到，能够通过清晰明确的步骤帮助学员理清答题技巧，掌握答题思路。更善于为学员进行干货补充，拔高答题站位，亮化答题内容。实现面试答题思路从无到有，从有到优的提升。&q;,&q;avatar&q;:&q;181d83e3f68ac60.jpg&q;,&q;upperBodyPhoto&q;:null,&q;displayCoursePrefix&q;:&q;gwy&q;,&q;teacherStat&q;:{&q;teacherId&q;:1869,&q;episodeCount&q;:634,&q;scoreCount&q;:68333,&q;avgScore&q;:9.875784759925676,&q;fiveGradeAvgScore&q;:4.94,&q;updateTime&q;:1773587670624},&q;auditionEpisode&q;:{&q;episodeTitle&q;:&q;个人展示课&q;,&q;episodeVideoUrl&q;:&q;https://vod.fbstatic.cn/22e9ceb2vodbj1251001446/f25d26233270835013756900478/CiXxK0TXdqAA.mp4?t=f2a4b300&a;us=4070880000&a;sign=ed3ab10128415000df2e782dac744c0a&q;},&q;memberOfCPC&q;:false,&q;tags&q;:null},&q;teachChannel&q;:1,&q;offline&q;:null,&q;duration&q;:2700,&q;hasAudition&q;:false,&q;bizType&q;:0,&q;bizId&q;:&q;773251&q;,&q;supportReplay&q;:true,&q;extraInfo&q;:null,&q;liveConfig&q;:{&q;episodeId&q;:11705780,&q;supportMultiGroup&q;:false,&q;exerciseBizType&q;:0,&q;videoDisplayType&q;:0,&q;avForwardType&q;:0,&q;useIntelligentRoom&q;:false,&q;hasStrokeKeynote&q;:false,&q;verticalModeType&q;:0,&q;originEpisodeId&q;:0,&q;supportRtmp&q;:false,&q;supportPk&q;:false,&q;supportLuckyBag&q;:false,&q;supportUserNoteStroke&q;:false,&q;communicateType&q;:0,&q;fakeLive&q;:false,&