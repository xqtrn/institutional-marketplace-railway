ynote&q;:true,&q;verticalModeType&q;:0,&q;originEpisodeId&q;:0,&q;supportRtmp&q;:false,&q;supportPk&q;:true,&q;supportLuckyBag&q;:true,&q;supportUserNoteStroke&q;:false,&q;communicateType&q;:0,&q;one2One&q;:false,&q;fakeLive&q;:false},&q;validStatus&q;:1,&q;supportLive&q;:true,&q;supportAiCatalog&q;:false,&q;hasIntelligentPen&q;:false,&q;useLocalRecording&q;:false,&q;useIntelligentRoom&q;:false,&q;hasSalePosition&q;:false,&q;hasEpisodeCards&q;:true,&q;lockedForShouna&q;:false,&q;needSignIn&q;:false,&q;needTeacherSignIn&q;:false,&q;enablePadPencil&q;:true,&q;displayExercise&q;:false,&q;supportLuckyBag&q;:true,&q;supportLivePk&q;:true},{&q;id&q;:10136579,&q;kePrefix&q;:&q;sydw&q;,&q;courseId&q;:6,&q;status&q;:3,&q;playStatus&q;:3,&q;type&q;:33,&q;recordingType&q;:0,&q;mediaType&q;:0,&q;title&q;:&q;【综应】精选好题 沉浸刷题&q;,&q;innerTitle&q;:&q;&q;,&q;startTime&q;:1739412000000,&q;endTime&q;:1739419200000,&q;teacher&q;:{&q;id&q;:64119,&q;userId&q;:90008449,&q;name&q;:&q;黄于晨&q;,&q;brief&q;:&q;粉笔优质讲师&q;,&q;desc&q;:&q;粉笔综应科目优质讲师\n多年一线教学经验，承担过线下笔试精品班，刷题班等多种班型，多次参加粉笔授课研讨会议，全面把握事考笔试命题趋势及最新考情，长期从事相关科目的教研工作，授课经验丰富，思路清晰，能够调动学员积极性。授课重点突出，能够及时总结拓展，针对性的解决学生的问题，制定合适的教学计划，进行个性化指导，助力学员上岸。&q;,&q;avatar&q;:&q;1945f2bc8a79ca7.jpg&q;,&q;upperBodyPhoto&q;:null,&q;displayCoursePrefix&q;:&q;sydw&q;,&q;teacherStat&q;:{&q;teacherId&q;:64119,&q;episodeCount&q;:501,&q;scoreCount&q;:524,&q;avgScore&q;:9.977099236641225,&q;fiveGradeAvgScore&q;:4.99,&q;updateTime&q;:1773581373076},&q;auditionEpisode&q;:{&q;episodeTitle&q;:&q;个人展示课&q;,&q;episodeVideoUrl&q;:&q;https://vod.fbstatic.cn/22e9ceb2vodbj1251001446/87956e2f5145403709544958863/UMDoH2GAdAIA.mp4?t=f2a4b300&a;us=4070880000&a;sign=5277a4d363f925d16bd6c83ac5410861&q;},&q;memberOfCPC&q;:false,&q;tags&q;:null},&q;teachChannel&q;:1,&q;offline&q;:null,&q;duration&q;:7567,&q;hasAudition&q;:false,&q;bizType&q;:0,&q;bizId&q;:&q;726825&q;,&q;supportReplay&q;:true,&q;extraInfo&q;:null,&q;liveConfig&q;:{&q;episodeId&q;:10136579,&q;supportMultiGroup&q;:false,&q;exerc