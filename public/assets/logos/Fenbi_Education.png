rsePrefix&q;:&q;gwy&q;,&q;teacherStat&q;:{&q;teacherId&q;:2181,&q;episodeCount&q;:1501,&q;scoreCount&q;:251706,&q;avgScore&q;:9.833671028898795,&q;fiveGradeAvgScore&q;:4.92,&q;updateTime&q;:1773618351956},&q;auditionEpisode&q;:{&q;episodeTitle&q;:&q;个人展示课&q;,&q;episodeVideoUrl&q;:&q;https://vod.fbstatic.cn/22e9ceb2vodbj1251001446/e9d22a973560136621448410921/CZZ5brVISBMA.mp4?t=f2a4b300&a;us=4070880000&a;sign=b6438e8f57289ac4aaede8f8cfbc28b0&q;},&q;memberOfCPC&q;:false,&q;tags&q;:null},&q;teachChannel&q;:1,&q;offline&q;:null,&q;duration&q;:12385,&q;hasAudition&q;:false,&q;bizType&q;:0,&q;bizId&q;:&q;710082&q;,&q;supportReplay&q;:true,&q;extraInfo&q;:null,&q;liveConfig&q;:{&q;episodeId&q;:11360217,&q;supportMultiGroup&q;:false,&q;exerciseBizType&q;:0,&q;videoDisplayType&q;:0,&q;avForwardType&q;:0,&q;useIntelligentRoom&q;:false,&q;hasStrokeKeynote&q;:true,&q;verticalModeType&q;:0,&q;originEpisodeId&q;:0,&q;supportRtmp&q;:false,&q;supportPk&q;:false,&q;supportLuckyBag&q;:false,&q;supportUserNoteStroke&q;:false,&q;communicateType&q;:0,&q;one2One&q;:false,&q;fakeLive&q;:false},&q;validStatus&q;:1,&q;supportLive&q;:true,&q;supportAiCatalog&q;:true,&q;hasIntelligentPen&q;:false,&q;useLocalRecording&q;:false,&q;useIntelligentRoom&q;:false,&q;hasSalePosition&q;:false,&q;hasEpisodeCards&q;:false,&q;lockedForShouna&q;:false,&q;needSignIn&q;:false,&q;needTeacherSignIn&q;:false,&q;enablePadPencil&q;:true,&q;displayExercise&q;:false,&q;supportLuckyBag&q;:false,&q;supportLivePk&q;:false},{&q;id&q;:11360225,&q;kePrefix&q;:&q;gwy&q;,&q;courseId&q;:1,&q;status&q;:3,&q;playStatus&q;:3,&q;type&q;:1,&q;recordingType&q;:0,&q;mediaType&q;:0,&q;title&q;:&q;判断-【2026上半年省考第4季】行测模考大赛&q;,&q;innerTitle&q;:&q;&q;,&q;startTime&q;:1766919600000,&q;endTime&q;:1766930400000,&q;teacher&q;:{&q;id&q;:7754,&q;userId&q;:61196798,&q;name&q;:&q;王东岳&q;,&q;brief&q;:&q;粉笔判断优质教师&q;,&q;desc&q;:&q;粉笔判断优质教师。\n7年授课经验，累计授课时长6000+，授课评分4.9+，培训学员100余万人次。有着多年丰富的国考及省考授课经验，逻辑框架清晰。授课风格深入浅出，结构严谨又不乏幽默；授课内容直指考试核心。教学方式多样，因材施教，掌握学生心理，深受学员欢迎。\n参与制作国省考授课讲义、《行测的思维》、《决战行测5000题》等多套图书。&q;,&q;avatar&q;:&q;1928e11bb6d26f0.jpg&q;,&q;upperBodyPhoto&q;:null,&q;displayCoursePrefix&q;:&q;gwy&q;,&q;teacherStat&q;:{&q;teacherId&q;:7754,&q;episodeCount&q;:1301,&q;scoreCount&q;:243516,&q;avgScore&q;:9.87308431478835,&q;fiveGradeAvgScore&q;:4.94,&q;updateTime&q;:1773620855135},&q;auditionEpisode&q;:{&q;episodeTitle&q;:&q;个人展示课&q;,&q;episodeVideoUrl&q;:&q;https://vod.fbstatic.cn/22e9ceb2vodbj1251001446/4bb38a333560136621446283020/WcYGrU72AukA.mp4?t=f2a4b300&a;us=4070880000&a;sign=0634969fb328a1e47afdf3e0332c5544&q;},&q;memberOfCPC&q;:false,&q;tags&q;:null},&q;teachChannel&q;:1,&q;offline&q;:null,&q;duration&q;:11264,&q;hasAudition&q;:false,&q;bizType&q;:0,&q;bizId&q;:&q;710082&q;,&q;supportReplay&q;:true,&q;extraInfo&q;:null,&q;liveConfig&q;:{&q;episodeId&q;:11360225,&q;supportMultiGroup&q;:false,&q;exerciseBizType&q;:0,&q;videoDisplayType&q;:0,&q;avForwardType&q;:0,&q;useIntelligentRoom&q;:false,&q;hasStrokeKeynote&q;:true,&q;verticalModeType&q;:0,&q;originEpisodeId&q;:0,&q;supportRtmp&q;:false,&q;supportPk&q;:false,&q;supportLuckyBag&q;:false,&q;supportUserNoteStroke&q;:false,&q;communicateType&q;:0,&q;one2One&q;:false,&q;fakeLive&q;:false},&q;validStatus&q;:1,&q;supportLive&q;:true,&q;supportAiCatalog&q;:false,&q;hasIntelligentPen&q;:false,&q;useLocalRecording&q;:false,&q;useIntelligentRoom&q;:false,&q;hasSalePosition&q;:false,&q;hasEpisodeCards&q;:false,&q;lockedForShouna&q;:false,&q;needSignIn&q;:false,&q;needTeacherSignIn&q;:false,&q;enablePadPencil&q;:true,&q;displayExercise&q;:false,&q;supportLuckyBag&q;:false,&q;supportLivePk&q;:false},{&q;id&q;:11386099,&q;kePrefix&q;:&q;gwy&q;,&q;courseId&q;:1,&q;status&q;:3,&q;playStatus&q;:3,&q;type&q;:1,&q;recordingType&q;:0,&q;mediaType&q;:0,&q;title&q;:&q;2026省考行测申论联合模考大赛（第4季）《申论》（通用卷）&q;,&q;innerTitle&q;:&q;&q;,&q;startTime&q;:1767006000000,&q;endTime&q;:1767016800000,&q;teacher&q;:{&q;id&q;:73982,&q;userId&q;:69156915,&q;name&q;:&q;李彬青&q;,&q;brief&q;:&q;粉笔申论优质教师&q;,&q;desc&q;:&q;粉笔申论优质教师，中国人民大学国际关系学院硕士毕业。11年授课经验，毕业后即投身于申论的研究和教学，培训申论老师千余人。长期致力于公务员笔试申论研究，申论授课方法实操性强，注重输出干货；擅长文章写作和教学，注重因材施教；授课重点突出，能够及时总结拓展。深受学员好评。 \n参与组织各类授课研讨会议和教研活动，著有《申论新时代》，参与编辑《公务员考试5100题》等图书。&q;,&q;avatar&q;:&q;19482559245a88c.jpg&q;,&q;upperBodyPhoto&q;:null,&q;displayCoursePrefix&q;:&q;gwy&q;,&q;teacherStat&q;:{&q;teacherId&q;:73982,&q;episodeCount&q;:304,&q;scoreCount&q;:4476,&q;avgScore&q;:9.873100983020556,&q;fiveGradeAvgScore&q;:4.94,&q;updateTime&q;:1773574579658},&q;auditionEpisode&q;:{&q;episodeTitle&q;:&q;个人展示课&q;,&q;episodeVideoUrl&q;:&q;https://vod.fbstatic.cn/22e9ceb2vodbj1251001446/b48a2e453560136621451159967/0lZLLuAXUY4A.mp4?t=f2a4b300&a;us=4070880000&a;sign=fe0f50824a047ae068f32dfd9ff663ef&q;},&q;memberOfCPC&q;:false,&q;tags&q;:null},&q;teachChannel&q;:1,&q;offline&q;:null,&q;duration&q;:11794,&q;hasAudition&q;:false,&q;bizType&q;:0,&q;bizId&q;:&q;710082&q;,&q;supportReplay&q;:true,&q;extraInfo&q;:null,&q;liveConfig&q;:{&q;episodeId&q;:11386099,&q;supportMultiGroup&q;:false,&q;exerciseBizType&q;:0,&q;videoDisplayType&q;:0,&q;avForwardType&q;:0,&q;useIntelligentRoom&q;:false,&q;hasStrokeKeynote&q;:true,&q;verticalModeType&q;:0,&q;originEpisodeId&q;:0,&q;supportRtmp&q;:false,&q;supportPk&q;:false,&q;supportLuckyBag&q;:false,&q;supportUserNoteStroke&q;:false,&q;communicateType&q;:0,&q;one2One&q;:false,&q;fakeLive&q;:false},&q;validStatus&q;:1,&q;supportLive&q;:true,&q;supportAiCatalog&q;:true,&q;hasIntelligentPen&q;:false,&q;useLocalRecording&q;:false,&q;useIntelligentRoom&q;:false,&q;hasSalePosition&q;:false,&q;hasEpisodeCards&q;:false,&q;lockedForShouna&q;:false,&q;needSignIn&q;:false,&q;needTeacherSignIn&q;:false,&q;enablePadPencil&q;:true,&q;displayExercise&q;:false,&q;supportLuckyBag&q;:false,&q;supportLivePk&q;:false},{&q;id&q;:11357954,&q;kePrefix&q;:&q;gwy&q;,&q;courseId&q;:1,&q;status&q;:3,&q;playStatus&q;:3,&q;type&q;:1,&q;recordingType&q;:0,&q;mediaType&q;:0,&q;title&q;:&q;言语赛后复盘-25下半年省考第37季通用卷&q;,&q;innerTitle&q;:&q;&q;,&q;sta