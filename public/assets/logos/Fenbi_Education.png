,&q;fiveGradeAvgScore&q;:4.94,&q;updateTime&q;:1773590739341},&q;auditionEpisode&q;:{&q;episodeTitle&q;:&q;个人展示课&q;,&q;episodeVideoUrl&q;:&q;https://vod.fbstatic.cn/22e9ceb2vodbj1251001446/a8ca0f033560136621447950682/yWKCuv9WQ1UA.mp4?t=f2a4b300&a;us=4070880000&a;sign=09777a4e0db401155a2b3523a73425a5&q;},&q;memberOfCPC&q;:false,&q;tags&q;:null},&q;teachChannel&q;:1,&q;offline&q;:null,&q;duration&q;:14135,&q;hasAudition&q;:false,&q;bizType&q;:0,&q;bizId&q;:&q;710082&q;,&q;supportReplay&q;:true,&q;extraInfo&q;:null,&q;liveConfig&q;:{&q;episodeId&q;:11386102,&q;supportMultiGroup&q;:false,&q;exerciseBizType&q;:0,&q;videoDisplayType&q;:0,&q;avForwardType&q;:0,&q;useIntelligentRoom&q;:false,&q;hasStrokeKeynote&q;:true,&q;verticalModeType&q;:0,&q;originEpisodeId&q;:0,&q;supportRtmp&q;:false,&q;supportPk&q;:false,&q;supportLuckyBag&q;:false,&q;supportUserNoteStroke&q;:false,&q;communicateType&q;:0,&q;one2One&q;:false,&q;fakeLive&q;:false},&q;validStatus&q;:1,&q;supportLive&q;:true,&q;supportAiCatalog&q;:true,&q;hasIntelligentPen&q;:false,&q;useLocalRecording&q;:false,&q;useIntelligentRoom&q;:false,&q;hasSalePosition&q;:false,&q;hasEpisodeCards&q;:false,&q;lockedForShouna&q;:false,&q;needSignIn&q;:false,&q;needTeacherSignIn&q;:false,&q;enablePadPencil&q;:true,&q;displayExercise&q;:false,&q;supportLuckyBag&q;:false,&q;supportLivePk&q;:false},{&q;id&q;:11450476,&q;kePrefix&q;:&q;gwy&q;,&q;courseId&q;:1,&q;status&q;:3,&q;playStatus&q;:3,&q;type&q;:1,&q;recordingType&q;:0,&q;mediaType&q;:0,&q;title&q;:&q;言语-【2026上半年省考第6季&a;2027国考第1季】行测模考大赛&q;,&q;innerTitle&q;:&q;&q;,&q;startTime&q;:1768129200000,&q;endTime&q;:1768140000000,&q;teacher&q;:{&q;id&q;:4996,&q;userId&q;:51581932,&q;name&q;:&q;司琦&q;,&q;brief&q;:&q;粉笔言语优质教师&q;,&q;desc&q;:&q;粉笔言语优质教师，8年授课经验，长期深耕公务员行测言语模块，精准把握命题趋势，对各类题型有着独到的见解，曾负责师资培训、模拟题撰写和教材编写等工作。教学中，注重因材施教，助力学员夯实基础、提升能力。授课风格幽默且严谨，讲解深入浅出，让复杂的知识变得通俗易懂，深受学员好评。&q;,&q;avatar&q;:&q;19270dc6dfb73cb.jpg&q;,&q;upperBodyPhoto&q;:null,&q;displayCoursePrefix&q;:&q;gwy&q;,&q;teacherStat&q;:{&q;teacherId&q;:4996,&q;episodeCount&q;:1396,&q;scoreCount&q;:216731,&q;avgScore&q;:9.871767306015292,&q;fiveGradeAvgScore&q;:4.94,&q;updateTime&q;:1773594524697},&q;auditionEpisode&q;:{&q;episodeTitle&q;:&q;个人展示课&q;,&q;episodeVideoUrl&q;:&q;https://vod.fbstatic.cn/22e9ceb2vodbj1251001446/9cc6e9f83560136621447402832/oxLbyW9tbc4A.mp4?t=f2a4b300&a;us=4070880000&a;sign=742574c1fe64d1e966a0d28dfe74cc08&q;},&q;memberOfCPC&q;:false,&q;tags&q;:null},&q;teachChannel&q;:1,&q;offline&q;:null,&q;duration&q;:11588,&q;hasAudition&q;:false,&q;bizType&q;:0,&q;bizId&q;:&q;710082&q;,&q;supportReplay&q;:true,&q;extraInfo&q;:null,&q;liveConfig&q;:{&q;episodeId&q;:11450476,&q;supportMultiGroup&q;:false,&q;exerciseBizType&q;:0,&q;videoDisplayType&q;:0,&q;avForwardType&q;:0,&q;useIntelligentRoom&q;:false,&q;hasStrokeKeynote&q;:true,&q;verticalModeType&q;:0,&q;originEpisodeId&q;:0,&q;supportRtmp&q;:false,&q;supportPk&q;:false,&q;supportLuckyBag&q;:false,&q;supportUserNoteStroke&q;:false,&q;communicateType&q;:0,&q;one2One&q;:false,&q;fakeLive&q;:false},&q;validStatus&q;:1,&q;supportLive&q;:true,&q;supportAiCatalog&q;:true,&q;hasIntelligentPen&q;:false,&q;useLocalRecording&q;:false,&q;useIntelligentRoom&q;:false,&q;hasSalePosition&q;:false,&q;hasEpisodeCards&q;:false,&q;lockedForShouna&q;:false,&q;needSignIn&q;:false,&q;needTeacherSignIn&q;:false,&q;enablePadPencil&q;:true,&q;displayExercise&q;:false,&q;supportLuckyBag&q;:false,&q;supportLivePk&q;:false},{&q;id&q;:11450477,&q;kePrefix&q;:&q;gwy&q;,&q;courseId&q;:1,&q;status&q;:3,&q;playStatus&q;:3,&q;type&q;:1,&q;recordingType&q;:0,&q;mediaType&q;:0,&q;title&q;:&q;判断-【2026上半年省考第6季&a;2027国考第1季】行测模考大赛&q;,&q;innerTitle&q;:&q;&q;,&q;startTime&q;:1768129200000,&q;endTime&q;:1768140000000,&q;teacher&q;:{&q;id&q;:7989,&q;userId&q;:57539965,&q;name&q;:&q;沙峰&q;,&q;brief&q;:&q;粉笔判断优质教师&q;,&q;desc&q;:&q;粉笔判断优质教师。\n8年公考授课经验，从业以来授课人次超5000人，授课时长超10000小时，学员评分高达4.9分。常年从事一线授课工作，担任国省考大班主讲。授课风格轻松诙谐，灵活多变，擅长将复杂的逻辑推理知识转化为生动有趣的案例，让学员在轻松愉快的氛围中掌握解题技巧。注重每位学员的差异化需求，凭借丰富的教学经验精准定位学员薄弱点，提供个性化提升方案。深刻理解公考备考学员的心里压力，不仅是深谙考试精髓的教师。更是众多考生公考路上的引路人和知心朋友。&q;,&q;avatar&q;:&q;1927025ae90d1b5.jpg&q;,&q;upperBodyPhoto&q;:null,&q;displayCoursePrefix&q;:&q;gwy&q;,&q;teacherStat&q;:{&q;teacherId&q;:7989,&q;episodeCount&q;:1076,&q;scoreCount&q;:34899,&q;avgScore&q;:9.867331442161671,&q;fiveGradeAvgScore&q;:4.93,&q;updateTime&q;:1773560596201},&q;auditionEpisode&q;:{&q;episodeTitle&q;:&q;个人展示课&q;,&q;episodeVideoUrl&q;:&q;https://vod.fbstatic.cn/22e9ceb2vodbj1251001446/0e476ab71397757891882393710/NbDGL7AAu7IA.mp4?t=f2a4b300&a;us=4070880000&a;sign=e57f2703f6bdfa0f5140fb31ceaa36e0&q;},&q;memberOfCPC&q;:false,&q;tags&q;:null},&q;teachChannel&q;:1,&q;offline&q;:null,&q;duration&q;:10606,&q;hasAudition&q;:false,&q;bizType&q;:0,&q;bizId&q;:&q;710082&q;,&q;supportReplay&q;:true,&q;extraInfo&q;:null,&q;liveConfig&q;:{&q;episodeId&q;:11450477,&q;supportMultiGroup&q;:false,&q;exerciseBizType&q;:0,&q;videoDisplayType&q;:0,&q;avForwardType&q;:0,&q;useIntelligentRoom&q;:false,&q;hasStrokeKeynote&q;:true,&q;verticalModeType&q;:0,&q;originEpisodeId&q;:0,&q;supportRtmp&q;:false,&q;supportPk&q;:false,&q;supportLuckyBag&q;:false,&q;supportUserNoteStroke&q;:false,&q;communicateType&q;:0,&q;one2One&q;:false,&q;fakeLive&q;:false},&q;validStatus&q;:1,&q;supportLive&q;:true,&q;supportAiCatalog&q;:true,&q;hasIntelligentPen&q;:false,&q;useLocalRecording&q;:false,&q;useIntelligentRoom&q;:false,&q;hasSalePosition&q;:false,&q;hasEpisodeCards&q;:false,&q;lockedForShouna&q;:false,&q;needSignIn&q;:false,&q;needTeacherSignIn&q;:false,&q;enablePadPencil&q;:true,&q;displayExercise&q;:false,&q;supportLuckyBag&q;:false,&q;supportLivePk&q;:false},{&q;id&q;:11450478,&q;kePrefix&q;:&q;gwy&q;,&q;courseId&q;:1,&q;status&q;:3,&q;playStatus&q;:3,&q;type&q;:1,&q;recordingType&q;:0,&q;mediaType&q;:0,&q;title&q;:&q;数资-【2026上半年省考第6季&a;2027国考第1季】行测模考大赛&q;,&q;innerTitle&q;:&q;&q;,&q;startTime&q;:1768129200000,&q;endTime&q;:1768140000000,&q;teacher&q;:{&q;id&q;:3240,&q;userId&q;:46456478,&q;name&q;:&q;张磊&q;,&q;brief&q;:&q;粉笔数资优质教师&q;,&q;desc&q;:&q;粉笔数资优质教师，8年公考培训经验，参与培训大量师资，定期参加各类教研，编写更新各类数资科目相关图书。理论基础扎实，针对不同程度的学员因材施教，课堂氛围活跃，讲解通俗易懂，授课思路清晰，善于从学员角度思考问题，方法实用性强，是学员上岸路上的良师益友。&q;,&q;avatar&q;:&q;174d423553b3bc3.jpg&q;,&q;upperBodyPhoto&q;:null,&q;displayCoursePrefix&q;:&q;gwy&q;,&q;teacherStat&q;:{&q;teacherId&q;:3240,&q;episodeCount&q;:1100,&q;scoreCount&q;:180144,&q;avgScore&q;:9.815802913224934,&q;fiveGradeAvgScore&q;:4.91,&q;updateTime&q;:1773620795012},&q;auditionEpisode&q;:{&q;episodeTitle&q;:&q;个人展示课&q;,&q;episodeVideoUrl&q;:&q;https://vod.fbstatic.cn/22e9ceb2vodbj1251001446/570526aa3560136621446737687/8nWNryUXslkA.mp4?t=f2a4b300&a;us=4070880000&a;sign=8ec14a3abc870f41bfb320a2daa0a203&q;},&q;memberOfCPC&q;:false,&q;tags&q;:null},&q;teachChannel&q;:1,&q;offline&q;:null,&q;duration&q;:12992,&q;hasAudition&q;:false,&q;bizType&q;:0,&q;bizId&q;:&q;710082&q;,&q;supportReplay&q;:true,&q;extraInfo&q;:null,&q;liveConfig&q;:{&q;episodeId&q;:11450478,&q;supportMultiGroup&q;:false,&q;exerciseBizType&q;:0,&q;videoDisplayType&q;:0,&q;avForwardType&q;:0,&q;useIntelligentRoom&q;:false,&q;hasStrokeKeynote&q;:true,&q;verticalModeType&q;:0,&q;originEpisodeId&q;:0,&q;supportRtmp&q;:false,&q;supportPk&q;:false,&q;supportLuckyBag&q;:false,&q;supportUserNoteStroke&q;:false,&q;communicateType&q;:0,&q;one2One&q;:false,&q;fakeLive&q;:false},&q;validStatus&q;:1,&q;supportLive&q;:true,&q;supportAiCatalog&q;:true,&q;hasIntelligentPen&q;:false,&q;useLocalRecording&q;:false,&q;useIntelligentRoom&q;:false,&q;hasSalePosition&q;:false,&q;hasEpisodeCards&q;:false,&q;lockedForShouna&q;:false,&q;needSignIn&q;:false,&q;needTeacherSignIn&q;:false,&q;enablePadPencil&q;:true,&q;displayExercise&q;:false,&q;supportLuckyBag&q;:false,&q;supportLivePk&q;:false},{&q;id&q;:11450479,&q;kePrefix&q;:&q;gwy&q;,&q;courseId&q;:1,&q;status&q;:3,&q;playStatus&q;:3,&q;type&q;:1,&q;recordingType&q;:0,&q;mediaType&q;:0,&q;title&q;:&q;言语-【2026上半年省考第7季&a;2027国考第2季】行测模考大赛&q;,&q;innerTitle&q;:&q;&q;,&q;startTime