合山东、福建、四川、江苏等地的地方考情，深入理解真题命题方向。授课风格幽默活泼，善于将时事热点与理论知识结合，帮助学生更好地理解和记忆。&q;,&q;avatar&q;:&q;193af589c3b05e6.jpg&q;,&q;upperBodyPhoto&q;:null,&q;displayCoursePrefix&q;:&q;sydw&q;,&q;teacherStat&q;:{&q;teacherId&q;:18668,&q;episodeCount&q;:613,&q;scoreCount&q;:1605,&q;avgScore&q;:9.823052959501561,&q;fiveGradeAvgScore&q;:4.91,&q;updateTime&q;:1773481515764},&q;auditionEpisode&q;:null,&q;memberOfCPC&q;:false,&q;tags&q;:null},&q;teachChannel&q;:1,&q;offline&q;:null,&q;duration&q;:6525,&q;hasAudition&q;:false,&q;bizType&q;:0,&q;bizId&q;:&q;726825&q;,&q;supportReplay&q;:true,&q;extraInfo&q;:null,&q;liveConfig&q;:{&q;episodeId&q;:10475184,&q;supportMultiGroup&q;:false,&q;exerciseBizType&q;:0,&q;videoDisplayType&q;:0,&q;avForwardType&q;:0,&q;useIntelligentRoom&q;:false,&q;hasStrokeKeynote&q;:true,&q;verticalModeType&q;:0,&q;originEpisodeId&q;:0,&q;supportRtmp&q;:false,&q;supportPk&q;:true,&q;supportLuckyBag&q;:true,&q;supportUserNoteStroke&q;:false,&q;communicateType&q;:0,&q;one2One&q;:false,&q;fakeLive&q;:false},&q;validStatus&q;:1,&q;supportLive&q;:true,&q;supportAiCatalog&q;:false,&q;hasIntelligentPen&q;:false,&q;useLocalRecording&q;:false,&q;useIntelligentRoom&q;:false,&q;hasSalePosition&q;:false,&q;hasEpisodeCards&q;:true,&q;lockedForShouna&q;:false,&q;needSignIn&q;:false,&q;needTeacherSignIn&q;:false,&q;enablePadPencil&q;:true,&q;displayExercise&q;:false,&q;supportLuckyBag&q;:true,&q;supportLivePk&q;:true},{&q;id&q;:10475576,&q;kePrefix&q;:&q;sydw&q;,&q;courseId&q;:6,&q;status&q;:3,&q;playStatus&q;:3,&q;type&q;:33,&q;recordingType&q;:0,&q;mediaType&q;:0,&q;title&q;:&q;【言语】精选好题 沉浸刷题&q;,&q;innerTitle&q;:&q;&q;,&q;startTime&q;:1744768800000,&q;endTime&q;:1744776000000,&q;teacher&q;:{&q;id&q;:16606,&q;userId&q;:72504959,&q;name&q;:&q;田文慧&q;,&q;brief&q;:&q;粉笔优质讲师&q;,&q;desc&q;:&q;粉笔优质教师\n五年一线教学授课经验，对事业单位言语考情深入研究，取得考情分析以及真题解析教研成果，线上班级学员进面率在粉笔受到过教学表彰。具有耐心细致，条理清晰的授课风格，让学生在轻松的学习氛围中，用更简单的方法，找到更快捷的解题之道，深受广大学员的认可和好评。&q;,&q;avatar&q;:&q;174683219f2607b.jpg&q;,&q;upperBodyPhoto&q;:null