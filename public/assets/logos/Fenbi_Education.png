;:23826,&q;score&q;:448027614006272,&q;imgURLs&q;:[&q;https://hera.fbstatic.cn/448027578929152.jpg&q;],&q;highlights&q;:[],&q;video&q;:null,&q;audio&q;:null,&q;extendInfo&q;:{&q;from&q;:2,&q;reqId&q;:-1},&q;commentNum&q;:11,&q;likeNum&q;:0,&q;sourceInfo&q;:{&q;id&q;:176,&q;name&q;:&q;综应小讲堂&q;,&q;icon&q;:&q;https://hera.fbstatic.cn/429801645618176.png&q;,&q;interest&q;:false,&q;interestNum&q;:0,&q;score&q;:0,&q;articleNum&q;:0},&q;showType&q;:0,&q;isLike&q;:0,&q;isFavor&q;:0,&q;preface&q;:&q;导读文章写作是联考B类考试中的重点题型，而议论文的重要部分之一就是标题。标题是文章的文眼，好的标题能够吸引阅卷老师，能够起到画龙点睛的效果。一般而言，自拟标题时应该包含文章的主题词，然而很多同学往往不&q;,&q;digest&q;:&q;第五十八关：拟定标题&q;,&q;digestRowInfo&q;:[],&q;tagsList&q;:[],&q;category&q;:0,&q;memberArticle&q;:false,&q;vipLecture&q;:false,&q;announcementArticleInfoRet&q;:{&q;enrollStatus&q;:0,&q;enrollStartTime&q;:0,&q;enrollEndTime&q;:0,&q;recruitNum&q;:0,&q;recruitNumRet&q;:null,&q;positionNum&q;:0,&q;reason&q;:null,&q;matchPositionTag&q;:null,&q;remarkBanner&q;:null,&q;hasGlobalStatistic&q;:false,&q;authorized&q;:false,&q;timeStatus&q;:null,&q;timeStatusInfo&q;:null,&q;registerWebsiteInfo&q;:{&q;websitePurpose&q;:null,&q;websiteName&q;:&q;&q;,&q;url&q;:null},&q;affixInfos&q;:null,&q;selectedExam&q;:false,&q;inHotQuery&q;:false,&q;sourceInfo&q;:null,&q;contactInfos&q;:null,&q;digestRemark&q;:null,&q;collectionChildrenNum&q;:0,&q;collectionChildrenUpdateTime&q;:0,&q;companyId&q;:0},&q;enrollStatus&q;:0,&q;enrollStartTime&q;:0,&q;enrollEndTime&q;:0,&q;memberArticleInfoRet&q;:{&q;memberTypes&q;:null},&q;likedUsers&q;:null,&q;relatedObject&q;:null,&q;relatedAds&q;:[],&q;rollingBanners&q;:null,&q;articleTaskStatus&q;:-1,&q;floatBanner&q;:null,&q;experienceTagList&q;:[],&q;morningReadingSpeakerTimeAudio&q;:null,&q;adBanner&q;:null},{&q;id&q;:448030762619904,&q;title&q;:&q;双管齐下，攻克“寓言哲理型材料”难关&q;,&q;source&q;:&q;综应小讲堂&q;,&q;issueTime&q;:1723011295578,&q;updateTime&q;:1761006824214,&q;favoriteTime&q;:-1,&q;favoriteNum&q;:6,&q;contentType&q;:1,&q;businessType&q;:4,&q;contentURL&q;:&q;https://hera-webapp.fenbi.com/api/article/detail?id=448030762619904&q;,&q;cardType&q;:3,&q;visitors&q;:22777,&q;score&q;:448030762619904,&q;imgURLs&q;:[&q;https://hera.fbstatic.cn/448030762405888.jpg&q;],&q;highlights&q;:[],&q;video&q;:null,&q;audio&q;:null,&q;extendInfo&q;:{&q;from&q;:2,&q;reqId&q;:-1},&q;commentNum&q;:23,&q;likeNum&q;:1,&q;sourceInfo&q;:{&q;id&q;:176,&q;name&q;:&q;综应小讲堂&q;,&q;icon&q;:&q;https://hera.fbstatic.cn/429801645618176.png&q;,&q;interest&q;:false,&q;interestNum&q;:0,&q;score&q;:0,&q;articleNum&q;:0},&q;showType&q;:0,&q;isLike&q;:0,&q;isFavor&q;:0,&q;preface&q;:&q;知识梳理“寓言哲理型”的材料作文题是事业单位考试比较常见的命题方式。这种命题方式的题意有的浅显易懂，有的则比较隐晦曲折；有的像是谜语，题目是谜面，而内涵是谜底，审题则是求解。我们有可能在初读材料时如坠&q;,&q;digest&q;:&q;双管齐下，攻克“寓言哲理型材料”难关&q;,&q;digestRowInfo&q;:[],&q;tagsList&q;:[],&q;category&q;:0,&q;memberArticle&q;:false,&q;vipLecture&q;:false,&q;announcementArticleInfoRet&q;:{&q;enrollStatus&q;:0,&q;enrollStartTime&q;:0,&q;enrollEndTime&q;:0,&q;recruitNum&q;:0,&q;recruitNumRet&q;:null,&q;positionNum&q;:0,&q;reason&q;:null,&q;matchPositionTag&q;:null,&q;remarkBanner&q;:null,&q;hasGlobalStatistic&q;:false,&q;authorized&q;:false,&q;timeStatus&q;:null,&q;timeStatusInfo&q;:null,&q;registerWebsiteInfo&q;:{&q;websitePurpose&q;:null,&q;websiteName&q;:&q;&q;,&q;url&q;:null},&q;affixInfos&q;:null,&q;selectedExam&q;:false,&q;inHotQuery&q;:false,&q;sourceInfo&q;:null,&q;contactInfos&q;:null,&q;digestRemark&q;:null,&q;collectionChildrenNum&q;:0,&q;collectionChildrenUpdateTime&q;:0,&q;companyId&q;:0},&q;enrollStatus&q;:0,&q;enrollStartTime&q;:0,&q;enrollEndTime&q;:0,&q;memberArticleInfoRet&q;:{&q;memberTypes&q;:null},&q;likedUsers&q;:null,&q;relatedObject&q;:null,&q;relatedAds&q;:[],&q;rollingBanners&q;:null,&q;articleTaskStatus&q;:-1,&q;floatBanner&q;:null,&q;experienceTagList&q;:[],&q;morningReadingSpeakerTimeAudio&q;:null,&q;adBanner&q;:null}],&q;totalNum&q;:20},{&q;id&q;:184,&q;name&q;:&q;军文小讲堂&q;,&q;icon&q;:&q;https://hera.fbstatic.cn/website_icon/icon-备考-8-军文@2x.png&q;,&q;stickTopArticles&q;:[],&q;articles&q;:[{&q;id&q;:450681884657664,&q;title&q;:&q;词语理解题也有不同类型&q;,&q;source&q;:&q;军文小讲堂&q;,&q;issueTime&q;:1723011028518,&q;updateTime&q;:1765092097495,&q;favoriteTime&q;:-1,&q;favoriteNum&q;:29,&q;contentType&q;:1,&q;businessType&q;:4,&q;contentURL&q;:&q;https://hera-webapp.fenbi.com/api/article/detail?id=450681884657664&q;,&q;cardType&q;:3,&q;visitors&q;:20419,&q;score&q;:450681884657664,&q;imgURLs&q;:[&q;https://hera.fbstatic.cn/450681792957440.jpg&q;],&q;highlights&q;:[],&q;video&q;:null,&q;audio&q;:null,&q;extendInfo&q;:{&q;from&q;:2,&q;reqId&q;:-1},&q;commentNum&q;:61,&q;likeNum&q;:10,&q;sourceInfo&q;:{&q;id&q;:184,&q;name&q;:&q;军文小讲堂&q;,&q;icon&q;:&q;https://hera.fbstatic.cn/436594662507520.png&q;,&q;interest&q;:false,&q;interestNum&q;:0,&q;score&q;:0,&q;articleNum&q;:0},&q;showType&q;:0,&q;isLike&q;:0,&q;isFavor&q;:0,&q;preface&q;:&q;前言词语理解题又叫词句理解题，重点考查考生对于词句在特定语境中含义的理解，这种能力是领会上级精神、与他人沟通合作的重要基础。该题型一般会给出我们文段中的某个词语或小短句问“这段文字中‘某某’指的/含义&q;,&q;digest&q;:&q;词语理解题也有不同类型&q;,&q;digestRowInfo&q;:[],&q;tagsList&q;:[],&q;category&q;:0,&q;memberArticle&q;:false,&q;vipLecture&q;:false,&q;announcementArticleInfoRet&q;:{&q;enrollStatus&q;:0,&q;enrollStartTime&q;:0,&q;enrollEndTime&q;:0,&q;recruitNum&q;:0,&q;recruitNumRet&q;:null,&q;positionNum&q;:0,&q;reason&q;:null,&q;matchPositionTag&q;:null,&q;remarkBanner&q;:null,&q;hasGlobalStatistic&q;:false,&q;authorized&q;:false,&q;timeStatus&q;:null,&q;timeStatusInfo&q;:null,&q;registerWebsiteInfo&q;:{&q;websitePurpose&q;:null,&q;websiteName&q;:&q;&q;,&q;url&q;:null},&q;affixInfos&q;:null,&q;selectedExam&q;:false,&q;inHotQuery&q;:false,&q;sourceInfo&q;:null,&q;contactInfos&q;:null,&q;digestRemark&q;:null,&q;collectionChildrenNum&q;:0,&q;collectionChildrenUpdateTime&q;:0,&q;companyId&q;:0},&q;enrollStatus&q;:0,&q;enrollStartTime&q;:0,&q;enrollEndTime&q;:0,&q;memberArticleInfoRet&q;:{&q;memberTypes&q;:null},&q;likedUsers&q;:null,&q;relatedObject&q;:null,&q;relatedAds&q;:[],&q;rollingBanners&q;:null,&q;articleTaskStatus&q;:-1,&q;floatBanner&q;:null,&q;experienceTagList&q;:[],&q;morningReadingSpeakerTimeAudio&q;:null,&q;adBanner&q;:null},{&q;id&q;:450681982963712,&q;title&q;:&q;语句排序题突破口在哪里&q;,&q;source&q;:&q;军文小讲堂&q;,&q;issueTime&q;:1723011023824,&q;updateTime&q;:1764257429848,&q;favoriteTime&q;:-1,&q;favoriteNum&q;:40,&q;contentType&q;:1,&q;businessType&q;:4,&q;contentURL&q;:&q;https://hera-webapp.fenbi.com/api/article/detail?id=450681982963712&q;,&q;cardType&q;:3,&q;visitors&q;:18754,&q;score&q;:450681982963712,&q;imgURLs&q;:[&q;https://hera.fbstatic.cn/450681898864640.jpg&q;],&q;highlights&q;:[],&q;video&q;:null,&q;audio&q;:null,&q;extendInfo&q;:{&q;from&q;:2,&q;reqId&q;:-1},&q;commentNum&q;:69,&q;likeNum&q;:17,&q;sourceInfo&q;:{&q;id&q;:184,&q;name&q;:&q;军文小讲堂&q;,&q;icon&q;:&q;https://hera.fbstatic.cn/436594662507520.png&q;,&q;interest&q;:false,&q;interestNum&q;:0,&q;score&q;:0,&q;articleNum&q;:0},&q;showType&q;:0,&q;isLike&q;:0,&q;isFavor&q;:0,&q;preface&q;:&q;前言语句排序题，即按正确顺序重新排列题干给出的语句，重点考查对语句顺序以及内在逻辑的把握能力。语句排序题是语句表达中的重点题型，一般一套试卷中考查1～2道题。常见误区是不顾选项，直接按照从1～6的顺序&q;,&q;digest&q;:&q;语句排序题突破口在哪里&q;,&q;digestRowInfo&q;:[],&q;tagsList&q;:[],&q;category&q;:0,&q;memberArticle&q;:false,&q;vipLecture&q;:false,&q;announcementArticleInfoRet&q;:{&q;enrollStatus&q;:0,&q;enrollStartTime&q;:0,&q;enrollEndTime&q;:0,&q;recruitNum&q;:0,&q;recruitNumRet&q;:null,&q;positionNum&q;:0,&q;reason&q;:null,&q;matchPositionTag&q;:null,&q;remarkBanner&q;:null,&q;hasGlobalStatistic&q;:false,&q;authorized&q;:false,&q;timeStatus&q;:null,&q;timeStatusInfo&q;:null,&q;registerWebsiteInfo&q;:{&q;websitePurpose&q;:null,&q;websiteName&q;:&q;&q;,&q;url&q;:null},&q;affixInfos&q;:null,&q;selectedExam&q;:false,&q;inHotQuery&q;:false,&q;sourceInfo&q;:null,&q;contactInfos&q;:null,&q;digestRemark&q;:null,&q;collectionChildrenNum&q;:0,&q;collectionChildrenUpdateTime&q;:0,&q;companyId&q;:0},&q;enrollStatus&q;:0,&q;enrollStartTime&q;:0,&q;enrollEndTime&q;:0,&q;memberArticleInfoRet&q;:{&q;memberTypes&q;:null},&q;likedUsers&q;:null,&q;relatedObject&q;:null,&q;relatedAds&q;:[],&q;rollingBanners&q;:null,&q;articleTaskStatus&q;:-1,&q;floatBanner&q;:null,&q;experienceTagList&q;:[],&q;morningReadingSpeakerTimeAudio&q;:null,&q;adBanner&q;:null},{&q;id&q;:450683874593792,&q;title&q;:&q;方程法+数列问题&q;,&q;source&q;:&q;军文小讲堂&q;,&q;issueTime&q;:1723010996457,&q;updateTime&q;:1751208585715,&q;favoriteTime&q;:-1,&q;favoriteNum&q;:60,&q;contentType&q;:1,&q;businessType&q;:4,&q;contentURL&q;:&q;https://hera-webapp.fenbi.com/api/article/detail?id=450683874593792&q;,&q;cardType&q;:3,&q;visitors&q;:20979,&q;score&q;:450683874593792,&q;imgURLs&q;:[&q;https://hera.fbstatic.cn/450683646576640.jpg&q;],&q;highlights&q;:[],&q;video&q;:null,&q;audio&q;:null,&q;extendInfo&q;:{&q;from&q;:2,&q;reqId&q;:-1},&q;commentNum&q;:93,&q;likeNum&q;:31,&q;sourceInfo&q;:{&q;id&q;:184,&q;name&q;:&q;军文小讲堂&q;,&q;icon&q;:&q;https://hera.fbstatic.cn/436594662507520.png&q;,&q;interest&q;:false,&q;interestNum&q;:0,&q;score&q;:0,&q;articleNum&q;:0},&q;showType&q;:0,&q;isLike&q;:0,&q;isFavor&q;:0,&q;preface&q;:&q;前言（方程法）方程法是解决数学问题最常用的方法之一，在大部分考试中都有题目可以用到方程法。列方程时需注意两点：一是找到等量关系，二是尽量简化计算。方程法的题型有两类：普通方程和不定方程。一、普通方程题&q;,&q;digest&q;:&q;方程法+数列问题&q;,&q;digestRowInfo&q;:[],&q;tagsList&q;:[],&q;category&q;:0,&q;memberArticle&q;:false,&q;vipLecture&q;:false,&q;announcementArticleInfoRet&q;:{&q;enrollStatus&q;:0,&q;enrollStartTime&q;:0,&q;enrollEndTime&q;:0,&q;recruitNum&q;:0,&q;recruitNumRet&q;:null,&q;positionNum&q;:0,&q;reason&q;:null,&q;matchPositionTag&q;:null,&q;remarkBanner&q;:null,&q;hasGlobalStatistic&q;:false,&q;authorized&q;:false,&q;timeStatus&q;:null,&q;timeStatusInfo&q;:null,&q;registerWebsiteInfo&q;:{&q;websitePurpose&q;:null,&q;websiteName&q;:&q;&q;,&q;url&q;:null},&q;affixInfos&q;:null,&q;selectedExam&q;:false,&q;inHotQuery&q;:false,&q;sourceInfo&q;:null,&q;contactInfos&q;:null,&q;digestRemark&q;:null,&q;collectionChildrenNum&q;:0,&q;collectionChildrenUpdateTime&q;:0,&q;companyId&q;:0},&q;enrollStatus&q;:0,&q;enrollStartTime&q;:0,&q;enrollEndTime&q;:0,&q;memberArticleInfoRet&q;:{&q;memberTypes&q;:null},&q;likedUsers&q;:null,&q;relatedObject&q;:null,&q;relatedAds&q;:[],&q;rollingBanners&q;:null,&q;articleTaskStatus&q;:-1,&q;floatBanner&q;:null,&q;experienceTagList&q;:[],&q;morningReadingSpeakerTimeAudio&q;:null,&q;adBanner&q;:null},{&q;id&q;:450703467761664,&q;title&q;:&q;行程问题总是做不对，哪些考点适合基础练习？&q;,&q;source&q;:&q;军文小讲堂&q;,&q;issueTime&q;:1723010982936,&q;updateTime&q;:1746423778663,&q;favoriteTime&q;:-1,&q;favoriteNum&q;:24,&q;contentType&q;:1,&q;businessType&q;:4,&q;contentURL&q;:&q;https://hera-webapp.fenbi.com/api/article/detail?id=450703467761664&q;,&q;cardType&q;:3,&q;visitors&q;:17510,&q;score&q;:450703467761664,&q;imgURLs&q;:[&q;https://hera.fbstatic.cn/450703435567104.jpg&q;],&q;highlights&q;:[],&q;video&q;:null,&q;audio&q;:null,&q;extendInfo&q;:{&q;from&q;:2,&q;reqId&q;:-1},&q;commentNum&q;:41,&q;likeNum&q;:6,&q;sourceInfo&q;:{&q;id&q;:184,&q;name&q;:&q;军文小讲堂&q;,&q;icon&q;:&q;https://hera.fbstatic.cn/436594662507520.png&q;,&q;interest&q;:false,&q;interestNum&q;:0,&q;score&q;:0,&q;articleNum&q;:0},&q;showType&q;:0,&q;isLike&q;:0,&q;isFavor&q;:0,&q;preface&q;:&q;知识梳理对近几年真题分析归类后，行程问题的考查主要分以下几种：考查基本公式，相对行程，比例行程。其中基本公式类比较简单，在军队文职中考查最多，通过对知识点的学习和练习均能掌握，主要需要大家掌握核心公式&q;,&q;digest&q;:&q;行程问题总是做不对，哪些考点适合基础练习？&q;,&q;digestRowInfo&q;:[],&q;tagsList&q;:[],&q;category&q;:0,&q;memberArticle&q;:false,&q;vipLecture&q;:false,&q;announcementArticleInfoRet&q;:{&q;enrollStatus&q;:0,&q;enrollStartTime&q;:0,&q;enrollEndTime&q;:0,&q;recruitNum&q;:0,&q;recruitNumRet&q;:null,&q;positionNum&q;:0,&q;reason&q;:null,&q;matchPositionTag&q;:null,&q;remarkBanner&q;:null,&q;hasGlobalStatistic&q;:false,&q;authorized&q;:false,&q;timeStatus&q;:null,&q;timeStatusInfo&q;:null,&q;registerWebsiteInfo&q;:{&q;websitePurpose&q;:null,&q;websiteName&q;:&q;&q;,&q;url&q;:null},&q;affixInfos&q;:null,&q;selectedExam&q;:false,&q;inHotQuery&q;:false,&q;sourceInfo&q;:null,&q;contactInfos&q;:null,&q;digestRemark&q;:null,&q;collectionChildrenNum&q;:0,&q;collectionChildrenUpdateTime&q;:0,&q;companyId&q;:0},&q;enrollStatus&q;:0,&q;enrollStartTime&q;:0,&q;enrollEndTime&q;:0,&q;memberArticleInfoRet&q;:{&q;memberTypes&q;:null},&q;likedUsers&q;:null,&q;relatedObject&q;:null,&q;relatedAds&q;:[],&q;rollingBanners&q;:null,&q;articleTaskStatus&q;:-1,&q;floatBanner&q;:null,&q;experienceTagList&q;:[],&q;morningReadingSpeakerTimeAudio&q;:null,&q;adBanner&q;:null},{&q;id&q;:450704829859840,&q;title&q;:&q;标点使用题——标点符号的应用&q;,&q;source&q;:&q;军文小讲堂&q;,&q;issueTime&q;:1723010975914,&q;updateTime&q;:1765008491869,&q;favoriteTime&q;:-1,&q;favoriteNum&q;:39,&q;contentType&q;:1,&q;businessType&q;:4,&q;contentURL&q;:&q;https://hera-webapp.fenbi.com/api/article/detail?id=450704829859840&q;,&q;cardType&q;:3,&q;visitors&q;:20425,&q;score&q;:450704829859840,&q;imgURLs&q;:[&q;https://hera.fbstatic.cn/450704776957952.jpg&q;],&q;highlights&q;:[],&q;video&q;:null,&q;audio&q;:null,&q;extendInfo&q;:{&q;from&q;:2,&q;reqId&q;:-1},&q;commentNum&q;:39,&q;likeNum&q;:11,&q;sourceInfo&q;:{&q;id&q;:184,&q;name&q;:&q;军文小讲堂&q;,&q;icon&q;:&q;https://hera.fbstatic.cn/436594662507520.png&q;,&q;interest&q;:false,&q;interestNum&q;:0,&q;score&q;:0,&q;articleNum&q;:0},&q;showType&q;:0,&q;isLike&q;:0,&q;isFavor&q;:0,&q;preface&q;:&q;前言标点使用题属于典型的语文基础题型，主要考查考生正确使用中文标点符号的能力，属于军队文职的必考题型，一般考查1道题。今天我们一起来了解一下常考标点符号的正确使用方法。常考标点符号1.逗号（，）主要用&q;,&q;digest&q;:&q;标点使用题——标点符号的应用&q;,&q;digestRowInfo&q;:[],&q;tagsList&q;:[],&q;category&q;:0,&q;memberArticle&q;:false,&q;vipLecture&q;:false,&q;announcementArticleInfoRet&q;:{&q;enrollStatus&q;:0,&q;enrollStartTime&q;:0,&q;enrollEndTime&q;:0,&q;recruitNum&q;:0,&q;recruitNumRet&q;:null,&q;positionNum&q;:0,&q;reason&q;:null,&q;matchPositionTag&q;:null,&q;remarkBanner&q;:null,&q;hasGlobalStatistic&q;:false,&q;authorized&q;:false,&q;timeStatus&q;:null,&q;timeStatusInfo&q;:null,&q;registerWebsiteInfo&q;:{&q;websitePurpose&q;:null,&q;websiteName&q;:&q;&q;,&q;url&q;:null},&q;affixInfos&q;:null,&q;selectedExam&q;:false,&q;inHotQuery&q;:false,&q;sourceInfo&q;:null,&q;contactInfos&q;:null,&q;digestRemark&q;:null,&q;collectionChildrenNum&q;:0,&q;collectionChildrenUpdateTime&q;:0,&q;companyId&q;:0},&q;enrollStatus&q;:0,&q;enrollStartTime&q;:0,&q;enrollEndTime&q;:0,&q;memberArticleInfoRet&q;:{&q;memberTypes&q;:null},&q;likedUsers&q;:null,&q;relatedObject&q;:null,&q;relatedAds&q;:[],&q;rollingBanners&q;:null,&q;articleTaskStatus&q;:-1,&q;floatBanner&q;:null,&q;experienceTagList&q;:[],&q;morningReadingSpeakerTimeAudio&q;:null,&q;adBanner&q;:null},{&q;id&q;:450704940746752,&q;title&q;:&q;中心理解题 —— 转折关系、因果关系的应用&q;,&q;source&q;:&q;军文小讲堂&q;,&q;issueTime&q;:1723010971303,&q;updateTime&q;:1764431733904,&q;favoriteTime&q;:-1,&q;favoriteNum&q;:67,&q;contentType&q;:1,&q;businessType&q;:4,&q;contentURL&q;:&q;https://hera-webapp.fenbi.com/api/article/detail?id=450704940746752&q;,&q;cardType&q;:3,&q;visitors&q;:22184,&q;score&q;:450704940746752,&q;imgURLs&q;:[&q;https://hera.fbstatic.cn/450704900165632.jpg&q;],&q;highlights&q;:[],&q;video&q;:null,&q;audio&q;:null,&q;extendInfo&q;:{&q;from&q;:2,&q;reqId&q;:-1},&q;commentNum&q;:111,&q;likeNum&q;:35,&q;sourceInfo&q;:{&q;id&q;:184,&q;name&q;:&q;军文小讲堂&q;,&q;icon&q;:&q;https://hera.fbstatic.cn/436594662507520.png&q;,&q;interest&q;:false,&q;interestNum&q;:0,&q;score&q;:0,&q;articleNum&q;:0},&q;showType&q;:0,&q;isLike&q;:0,&q;isFavor&q;:0,&q;preface&q;:&q;前言我们在学习军队文职，言语理解与表达的过程中，关联词是不可忽略的一环，它们可以引导句子与句子之间的逻辑关系，通过关联词我们可以找到解题的突破口，是解题过程中可以依靠的“重要力量”。而在关联关系中，转&q;,&q;digest&q;:&q;中心理解题 —— 转折关系、因果关系的应用&q;,&q;digestRowInfo&q;:[],&q;tagsList&q;:[],&q;category&q;:0,&q;memberArticle&q;:false,&q;vipLecture&q;:false,&q;announcementArticleInfoRet&q;:{&q;enrollStatus&q;:0,&q;enrollStartTime&q;:0,&q;enrollEndTime&q;:0,&q;recruitNum&q;:0,&q;recruitNumRet&q;:null,&q;positionNum&q;:0,&q;reason&q;:null,&q;matchPositionTag&q;:null,&q;remarkBanner&q;:null,&q;hasGlobalStatistic&q;:false,&q;authorized&q;:false,&q;timeStatus&q;:null,&q;timeStatusInfo&q;:null,&q;registerWebsiteInfo&q;:{&q;websitePurpose&q;:null,&q;websiteName&q;:&q;&q;,&q;url&q;:null},&q;affixInfos&q;:null,&q;selectedExam&q;:false,&q;inHotQuery&q;:false,&q;sourceInfo&q;:null,&q;contactInfos&q;:null,&q;digestRemark&q;:null,&q;collectionChildrenNum&q;:0,&q;collectionChildrenUpdateTime&q;:0,&q;companyId&q;:0},&q;enrollStatus&q;:0,&q;enrollStartTime&q;:0,&q;enrollEndTime&q;:0,&q;memberArticleInfoRet&q;:{&q;memberTypes&q;:null},&q;likedUsers&q;:null,&q;relatedObject&q;:null,&q;relatedAds&q;:[],&q;rollingBanners&q;:null,&q;articleTaskStatus&q;:-1,&q;floatBanner&q;:null,&q;experienceTagList&q;:[],&q;morningReadingSpeakerTimeAudio&q;:null,&q;adBanner&q;:null},{&q;id&q;:450729292353536,&q;title&q;:&q;信息技术在现代战争中的应用&q;,&q;source&q;:&q;军文小讲堂&q;,&q;issueTime&q;:1723010956927,&q;updateTime&q;:1765155607949,&q;favoriteTime&q;:-1,&q;favoriteNum&q;:55,&q;contentType&q;:1,&q;businessType&q;:4,&q;contentURL&q;:&q;https://hera-webapp.fenbi.com/api/article/detail?id=450729292353536&q;,&q;cardType&q;:3,&q;visitors&q;:20035,&q;score&q;:450729292353536,&q;imgURLs&q;:[&q;https://hera.fbstatic.cn/450729276672000.jpg&q;],&q;highlights&q;:[],&q;video&q;:null,&q;audio&q;:null,&q;extendInfo&q;:{&q;from&q;:2,&q;reqId&q;:-1},&q;commentNum&q;:63,&q;likeNum&q;:18,&q;sourceInfo&q;:{&q;id&q;:184,&q;name&q;:&q;军文小讲堂&q;,&q;icon&q;:&q;https://hera.fbstatic.cn/436594662507520.png&q;,&q;interest&q;:false,&q;interestNum&q;:0,&q;score&q;:0,&q;articleNum&q;:0},&q;showType&q;:0,&q;isLike&q;:0,&q;isFavor&q;:0,&q;preface&q;:&q;知识讲解信息技术是主要用于管理和处理信息所采用的各种技术的总称。它主要是应用计算机科学和通信技术来设计、开发、安装和实施信息系统及应用软件，包括我们熟知的大数据、物联网、5G技术、人工智能等。1.大数&q;,&q;digest&q;:&q;信息技术在现代战争中的应用&q;,&q;digestRowInfo&q;:[],&q;tagsList&q;:[],&q;category&q;:0,&q;memberArticle&q;:false,&q;vipLecture&q;:false,&q;announcementArticleInfoRet&q;:{&q;enrollStatus&q;:0,&q;enrollStartTime&q;:0,&q;enrollEndTime&q;:0,&q;recruitNum&q;:0,&q;recruitNumRet&q;:null,&q;positionNum&q;:0,&q;reason&q;:null,&q;matchPositionTag&q;:null,&q;remarkBanner&q;:null,&q;hasGlobalStatistic&q;:false,&q;authorized&q;:false,&q;timeStatus&q;:null,&q;timeStatusInfo&q;:null,&q;registerWebsiteInfo&q;:{&q;websitePurpose&q;:null,&q;websiteName&q;:&q;&q;,&q;url&q;:null},&q;affixInfos&q;:null,&q;selectedExam&q;:false,&q;inHotQuery&q;:false,&q;sourceInfo&q;:null,&q;contactInfos&q;:null,&q;digestRemark&q;:null,&q;collectionChildrenNum&q;:0,&q;collectionChildrenUpdateTime&q;:0,&q;companyId&q;:0},&q;enrollStatus&q;:0,&q;enrollStartTime&q;:0,&q;enrollEndTime&q;:0,&q;memberArticleInfoRet&q;:{&q;memberTypes&q;:null},&q;likedUsers&q;:null,&q;relatedObject&q;:null,&q;relatedAds&q;:[],&q;rollingBanners&q;:null,&q;articleTaskStatus&q;:-1,&q;floatBanner&q;:null,&q;experienceTagList&q;:[],&q;morningReadingSpeakerTimeAudio&q;:null,&q;adBanner&q;:null},{&q;id&q;:450723588360192,&q;title&q;:&q;吃透特殊增长率&q;,&q;source&q;:&q;军文小讲堂&q;,&q;issueTime&q;:1723010951385,&q;updateTime&q;:1765126377385,&q;favoriteTime&q;:-1,&q;favoriteNum&q;:139,&q;contentType&q;:1,&q;businessType&q;:4,&q;contentURL&q;:&q;https://hera-webapp.fenbi.com/api/article/detail?id=450723588360192&q;,&q;cardType&q;:3,&q;visitors&q;:26290,&q;score&q;:450723588360192,&q;imgURLs&q;:[&q;https://hera.fbstatic.cn/450723400979456.jpg&q;],&q;highlights&q;:[],&q;video&q;:null,&q;audio&q;:null,&q;extendInfo&q;:{&q;from&q;:2,&q;reqId&q;:-1},&q;commentNum&q;:94,&q;likeNum&q;:31,&q;sourceInfo&q;:{&q;id&q;:184,&q;name&q;:&q;军文小讲堂&q;,&q;icon&q;:&q;https://hera.fbstatic.cn/436594662507520.png&q;,&q;interest&q;:false,&q;interestNum&q;:0,&q;score&q;:0,&q;articleNum&q;:0},&q;showType&q;:0,&q;isLike&q;:0,&q;isFavor&q;:0,&q;preface&q;:&q;前言特殊增长率包括间隔增长率、年均增长率、混合增长率类三种题型。间隔增长率题型识别:时间间隔一年，求增长率。例：求2018年相比2016年的增长率是多少。公式：r=r1+r2+r1×r2首先要我们明确&q;,&q;digest&q;:&q;吃透特殊增长率&q;,&q;digestRowInfo&q;:[],&q;tagsList&q;:[],&q;category&q;:0,&q;memberArticle&q;:false,&q;vipLecture&q;:false,&q;announcementArticleInfoRet&q;:{&q;enrollStatus&q;:0,&q;enrollStartTime&q;:0,&q;enrollEndTime&q;:0,&q;recruitNum&q;:0,&q;recruitNumRet&q;:null,&q;positionNum&q;:0,&q;reason&q;:null,&q;matchPositionTag&q;:null,&q;remarkBanner&q;:null,&q;hasGlobalStatistic&q;:false,&q;authorized&q;:false,&q;timeStatus&q;:null,&q;timeStatusInfo&q;:null,&q;registerWebsiteInfo&q;:{&q;websitePurpose&q;:null,&q;websiteName&q;:&q;&q;,&q;url&q;:null},&q;affixInfos&q;:null,&q;selectedExam&q;:false,&q;inHotQuery&q;:false,&q;sourceInfo&q;:null,&q;contactInfos&q;:null,&q;digestRemark&q;:null,&q;collectionChildrenNum&q;:0,&q;collectionChildrenUpdateTime&q;:0,&q;companyId&q;:0},&q;enrollStatus&q;:0,&q;enrollStartTime&q;:0,&q;enrollEndTime&q;:0,&q;memberArticleInfoRet&q;:{&q;memberTypes&q;:null},&q;likedUsers&q;:null,&q;relatedObject&q;:null,&q;relatedAds&q;:[],&q;rollingBanners&q;:null,&q;articleTaskStatus&q;:-1,&q;floatBanner&q;:null,&q;experienceTagList&q;:[],&q;morningReadingSpeakerTimeAudio&q;:null,&q;adBanner&q;:null},{&q;id&q;:450722885028864,&q;title&q;:&q;逻辑判断—真假推理&q;,&q;source&q;:&q;军文小讲堂&q;,&q;issueTime&q;:1723010947418,&q;updateTime&q;:1763718063470,&q;favoriteTime&q;:-1,&q;favoriteNum&q;:92,&q;contentType&q;:1,&q;businessType&q;:4,&q;contentURL&q;:&q;https://hera-webapp.fenbi.com/api/article/detail?id=450722885028864&q;,&q;cardType&q;:3,&q;visitors&q;:25682,&q;score&q;:450722885028864,&q;imgURLs&q;:[&q;https://hera.fbstatic.cn/450722837107712.jpg&q;],&q;highlights&q;:[],&q;video&q;:null,&q;audio&q;:null,&q;extendInfo&q;:{&q;from&q;:2,&q;reqId&q;:-1},&q;commentNum&q;:87,&q;likeNum&q;:51,&q;sourceInfo&q;:{&q;id&q;:184,&q;name&q;:&q;军文小讲堂&q;,&q;icon&q;:&q;https://hera.fbstatic.cn/436594662507520.png&q;,&q;interest&q;:false,&q;interestNum&q;:0,&q;score&q;:0,&q;articleNum&q;:0},&q;showType&q;:0,&q;isLike&q;:0,&q;isFavor&q;:0,&q;preface&q;:&q;前言真假推理属于考察频率比较高的题型，但是这种题型的难度并不高。所谓的真假推理题目就是指题干中给出几句陈述，且陈述中有真或有假，由此推出结论。本文主要介绍真假推理的解题思路，以及如何利用矛盾和反对关系&q;,&q;digest&q;:&q;逻辑判断—真假推理&q;,&q;digestRowInfo&q;:[],&q;tagsList&q;:[],&q;category&q;:0,&q;memberArticle&q;:false,&q;vipLecture&q;:false,&q;announcementArticleInfoRet&q;:{&q;enrollStatus&q;:0,&q;enrollStartTime&q;:0,&q;enrollEndTime&q;:0,&q;recruitNum&q;:0,&q;recruitNumRet&q;:null,&q;positionNum&q;:0,&q;reason&q;:null,&q;matchPositionTag&q;:null,&q;remarkBanner&q;:null,&q;hasGlobalStatistic&q;:false,&q;authorized&q;:false,&q;timeStatus&q;:null,&q;timeStatusInfo&q;:null,&q;registerWebsiteInfo&q;:{&q;websitePurpose&q;:null,&q;websiteName&q;:&q;&q;,&q;url&q;:null},&q;affixInfos&q;:null,&q;selectedExam&q;:false,&q;inHotQuery&q;:false,&q;sourceInfo&q;:null,&q;contactInfos&q;:null,&q;digestRemark&q;:null,&q;collectionChildrenNum&q;:0,&q;collectionChildrenUpdateTime&q;:0,&q;companyId&q;:0},&q;enrollStatus&q;:0,&q;enrollStartTime&q;:0,&q;enrollEndTime&q;:0,&q;memberArticleInfoRet&q;:{&q;memberTypes&q;:null},&q;likedUsers&q;:null,&q;relatedObject&q;:null,&q;relatedAds&q;:[],&q;rollingBanners&q;:null,&q;articleTaskStatus&q;:-1,&q;floatBanner&q;:null,&q;experienceTagList&q;:[],&q;morningReadingSpeakerTimeAudio&q;:null,&q;adBanner&q;:null},{&q;id&q;:450722805336064,&q;title&q;:&q;图形推理-三视图&q;,&q;source&q;:&q;军文小讲堂&q;,&q;issueTime&q;:1723010943312,&q;updateTime&q;:1764154043259,&q;favoriteTime&q;:-1,&q;favoriteNum&q;:18,&q;contentType&q;:1,&q;businessType&q;:4,&q;contentURL&q;:&q;https://hera-webapp.fenbi.com/api/article/detail?id=450722805336064&q;,&q;cardType&q;:3,&q;visitors&q;:26793,&q;score&q;:450722805336064,&q;imgURLs&q;:[&q;https://hera.fbstatic.cn/450722732772352.jpg&q;],&q;highlights&q;:[],&q;video&q;:null,&q;audio&q;:null,&q;extendInfo&q;:{&q;from&q;:2,&q;reqId&q;:-1},&q;commentNum&q;:60,&q;likeNum&q;:9,&q;sourceInfo&q;:{&q;id&q;:184,&q;name&q;:&q;军文小讲堂&q;,&q;icon&q;:&q;https://hera.fbstatic.cn/436594662507520.png&q;,&q;interest&q;:false,&q;interestNum&q;:0,&q;score&q;:0,&q;articleNum&q;:0},&q;showType&q;:0,&q;isLike&q;:0,&q;isFavor&q;:0,&q;preface&q;:&q;知识梳理三视图指的是立体图形的正视图、俯视图和左视图。正视图是指从物体的正面观察，物体的影像投影在背后的投影面上，这个投影影像称为正视图;俯视图是指由物体上方向下作正投影得到的视图，也叫顶视图;侧视图&q;,&q;digest&q;:&q;图形推理-三视图&q;,&q;digestRowInfo&q;:[],&q;tagsList&q;:[],&q;category&q;:0,&q;memberArticle&q;:false,&q;vipLecture&q;:false,&q;announcementArticleInfoRet&q;:{&q;enrollStatus&q;:0,&q;enrollStartTime&q;:0,&q;enrollEndTime&q;:0,&q;recruitNum&q;:0,&q;recruitNumRet&q;:null,&q;positionNum&q;:0,&q;reason&q;:null,&q;matchPositionTag&q;:null,&q;remarkBanner&q;:null,&q;hasGlobalStatistic&q;:false,&q;authorized&q;:false,&q;timeStatus&q;:null,&q;timeStatusInfo&q;:null,&q;registerWebsiteInfo&q;:{&q;websitePurpose&q;:null,&q;websiteName&q;:&q;&q;,&q;url&q;:null},&q;affixInfos&q;:null,&q;selectedExam&q;:false,&q;inHotQuery&q;:false,&q;sourceInfo&q;:null,&q;contactInfos&q;:null,&q;digestRemark&q;:null,&q;collectionChildrenNum&q;:0,&q;collectionChildrenUpdateTime&q;:0,&q;companyId&q;:0},&q;enrollStatus&q;:0,&q;enrollStartTime&q;:0,&q;enrollEndTime&q;:0,&q;memberArticleInfoRet&q;:{&q;memberTypes&q;:null},&q;likedUsers&q;:null,&q;relatedObject&q;:null,&q;relatedAds&q;:[],&q;rollingBanners&q;:null,&q;articleTaskStatus&q;:-1,&q;floatBanner&q;:null,&q;experienceTagList&q;:[],&q;morningReadingSpeakerTimeAudio&q;:null,&q;adBanner&q;:null}],&q;totalNum&q;:13},{&q;id&q;:164,&q;name&q;:&q;爱听干货&q;,&q;icon&q;:&q;https://hera.fbstatic.cn/website_icon/icon-备考-9-爱听@2x.png&q;,&q;stickTopArticles&q;:[],&q;articles&q;:[{&q;id&q;:448461400723456,&q;title&q;:&q;爱听干货·金句积累 |脱贫成果金句&q;,&q;source&q;:&q;爱听干货&q;,&q;issueTime&q;:1711836010136,&q;updateTime&q;:1772412940669,&q;favoriteTime&q;:-1,&q;favoriteNum&q;:501,&q;contentType&q;:4,&q;businessType&q;:4,&q;contentURL&q;:&q;https://hera-webapp.fenbi.com/api/article/detail?id=448461400723456&q;,&q;cardType&q;:8,&q;visitors&q;:54411,&q;score&q;:448461400723456,&q;imgURLs&q;:[],&q;highlights&q;:[],&q;video&q;:null,&q;audio&q;:{&q;duration&q;:149,&q;sourceURL&q;:&q;fenbi-audio&q;,&q;coverURL&q;:&q;https://vod.fbstatic.cn/22e9ceb2vodbj1251001446/ad0903d81397757887508271194/1397757887508277557.png?t=69b781ea&a;us=GIXtusOOau&a;sign=0603d94e0e73e2fd99c18df3b11a2e55&q;,&q;singer&q;:&q;爱听干货&q;,&q;name&q;:&q;金句积累：脱贫成果&q;,&q;unread&q;:true,&q;breakpoint&q;:0,&q;id&q;:448552397623296},&q;extendInfo