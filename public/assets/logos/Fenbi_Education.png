roke&q;:false,&q;communicateType&q;:0,&q;one2One&q;:false,&q;fakeLive&q;:false},&q;validStatus&q;:1,&q;supportLive&q;:true,&q;supportAiCatalog&q;:true,&q;hasIntelligentPen&q;:false,&q;useLocalRecording&q;:false,&q;useIntelligentRoom&q;:false,&q;hasSalePosition&q;:false,&q;hasEpisodeCards&q;:false,&q;lockedForShouna&q;:false,&q;needSignIn&q;:false,&q;needTeacherSignIn&q;:false,&q;enablePadPencil&q;:true,&q;displayExercise&q;:false,&q;supportLuckyBag&q;:false,&q;supportLivePk&q;:false},{&q;id&q;:11397979,&q;kePrefix&q;:&q;gwy&q;,&q;courseId&q;:1,&q;status&q;:3,&q;playStatus&q;:3,&q;type&q;:1,&q;recordingType&q;:0,&q;mediaType&q;:0,&q;title&q;:&q;数资赛后复盘-26上半年省考第2季通用卷&q;,&q;innerTitle&q;:&q;&q;,&q;startTime&q;:1765683600000,&q;endTime&q;:1765687200000,&q;teacher&q;:{&q;id&q;:5234,&q;userId&q;:56626272,&q;name&q;:&q;林凡&q;,&q;brief&q;:&q;粉笔数资优质教师&q;,&q;desc&q;:&q;粉笔数资优质教师，9年公考授课经验，累计授课人次达十万以上，授课评分平均分5.0。曾担任数资科目培训负责人，培训师资数百名。对公考数学有深入理解，授课风格幽默风趣，课堂氛围轻松愉悦。擅长调动学员的数学思维，启发思考，深受学员好评。&q;,&q;avatar&q;:&q;1926fe4e99f0f5b.jpg&q;,&q;upperBodyPhoto&q;:null,&q;displayCoursePrefix&q;:&q;gwy&q;,&q;teacherStat&q;:{&q;teacherId&q;:5234,&q;episodeCount&q;:952,&q;scoreCount&q;:191566,&q;avgScore&q;:9.916436110792063,&q;fiveGradeAvgScore&q;:4.96,&q;updateTime&q;:1773623310342},&q;auditionEpisode&q;:{&q;episodeTitle&q;:&q;个人展示课&q;,&q;episodeVideoUrl&q;:&q;https://vod.fbstatic.cn/22e9ceb2vodbj1251001446/494f935d3560136621446179026/Rebj3P8AYRgA.mp4?t=f2a4b300&a;us=4070880000&a;sign=db0880414e78d1570e2fbd8c3e5016f0&q;},&q;memberOfCPC&q;:false,&q;tags&q;:null},&q;teachChannel&q;:1,&q;offline&q;:null,&q;duration&q;:4875,&q;hasAudition&q;:false,&q;bizType&q;:0,&q;bizId&q;:&q;710082&q;,&q;supportReplay&q;:true,&q;extraInfo&q;:null,&q;liveConfig&q;:{&q;episodeId&q;:11397979,&q;supportMultiGroup&q;:false,&q;exerciseBizType&q;:0,&q;videoDisplayType&q;:0,&q;avForwardType&q;:0,&q;useIntelligentRoom&q;:false,&q;hasStrokeKeynote&q;:true,&q;verticalModeType&q;:0,&q;originEpisodeId&q;:0,&q;supportRtmp&q;:fals