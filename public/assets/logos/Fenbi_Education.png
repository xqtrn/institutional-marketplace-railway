ckyBag&q;:true,&q;supportLivePk&q;:true},{&q;id&q;:10475085,&q;kePrefix&q;:&q;sydw&q;,&q;courseId&q;:6,&q;status&q;:3,&q;playStatus&q;:3,&q;type&q;:33,&q;recordingType&q;:0,&q;mediaType&q;:0,&q;title&q;:&q;【公基法律】精选好题 沉浸刷题&q;,&q;innerTitle&q;:&q;&q;,&q;startTime&q;:1744423200000,&q;endTime&q;:1744430400000,&q;teacher&q;:{&q;id&q;:16637,&q;userId&q;:73362780,&q;name&q;:&q;施孙芳&q;,&q;brief&q;:&q;粉笔优质讲师&q;,&q;desc&q;:&q;粉笔常识公基优质讲师。\n6年一线教学授课经验。具有常识公基科目丰富的实践经验及系统扎实的专业理论知识。多次参加粉笔授课研讨会议，全面把握常识公基考试命题趋势及最新考情，积累丰富笔试知识。具有幽默的授课风格，让学生在轻松的学习氛围中，用更简单的方法，找到更快捷的解题之道，深受广大学员的认可和好评，是值得信赖的好导师。&q;,&q;avatar&q;:&q;1746b726467e4a2.jpg&q;,&q;upperBodyPhoto&q;:null,&q;displayCoursePrefix&q;:&q;sydw&q;,&q;teacherStat&q;:{&q;teacherId&q;:16637,&q;episodeCount&q;:893,&q;scoreCount&q;:3281,&q;avgScore&q;:9.663517220359648,&q;fiveGradeAvgScore&q;:4.83,&q;updateTime&q;:1773547028739},&q;auditionEpisode&q;:{&q;episodeTitle&q;:&q;个人展示课&q;,&q;episodeVideoUrl&q;:&q;https://vod.fbstatic.cn/22e9ceb2vodbj1251001446/5a62805a5145403714882122093/LsABTK490BoA.mp4?t=f2a4b300&a;us=4070880000&a;sign=d987186e83731399b0f26511ecf8d802&q;},&q;memberOfCPC&q;:false,&q;tags&q;:null},&q;teachChannel&q;:1,&q;offline&q;:null,&q;duration&q;:8898,&q;hasAudition&q;:false,&q;bizType&q;:0,&q;bizId&q;:&q;726825&q;,&q;supportReplay&q;:true,&q;extraInfo&q;:null,&q;liveConfig&q;:{&q;episodeId&q;:10475085,&q;supportMultiGroup&q;:false,&q;exerciseBizType&q;:0,&q;videoDisplayType&q;:0,&q;avForwardType&q;:0,&q;useIntelligentRoom&q;:false,&q;hasStrokeKeynote&q;:true,&q;verticalModeType&q;:0,&q;originEpisodeId&q;:0,&q;supportRtmp&q;:false,&q;supportPk&q;:true,&q;supportLuckyBag&q;:true,&q;supportUserNoteStroke&q;:false,&q;communicateType&q;:0,&q;one2One&q;:false,&q;fakeLive&q;:false},&q;validStatus&q;:1,&q;supportLive&q;:true,&q;supportAiCatalog&q;:false,&q;hasIntelligentPen&q;:false,&q;useLocalRecording&q;:false,&q;useIntelligentRoom&q;:false,&q;hasSalePosition&q;:false,&q;hasEpisodeCards&q;:true,&q;lockedForShouna&q;:false,&q;needSignIn&q;:false,&q;needTeacherSignIn&q;:false,&q;enablePadPencil&q;:true,&q;displayExercise&q;:false,&q;supportLuckyBag&q;:true,&q;supportLivePk&q;:true},{&q;id&q;:10475101,&q;kePrefix&q;:&q;sydw&q;,&q;courseId&q;:6,&q;status&q;:3,&q;playStatus&q;:3,&q;type&q;:33,&q;recordingType&q;:0,&q;mediaType&q;:0,&q;title&q;:&q;【言语】精选好题 沉浸刷题&q;,&q;innerTitle&q;:&q;&q;,&q;startTime&q;:1744437600000,&q;endTime&q;:1744444800000,&q;teacher&q;:{&q;id&q;:56428,&q;userId&q;:87702759,&q;name&q;:&q;徐雨婷&q;,&q;brief&q;:&q;粉笔优质讲师&q;,&q;desc&q;:&q;粉笔优质讲师\n拥有5年的考编辅导经验，深入研究各类考编考试，熟练掌握考点与解题技巧，能够精准把握考试动态；\n多年授课经验，深耕言语类教学，长期从事相关教研工作，熟知事业单位命题格式和答题技巧；\n累计授课辅导学员近15000人，综合评分达4.95分，注重启发式引导，授课思路清晰直接，讲解细致耐心，富有亲和力。&q;,&q;avatar&q;:&q;19bbc410c81476e.jpg&q;,&q;upperBodyPhoto&q;:null,&q;displayCoursePrefix&q;:&q;sydw&q;,&q;teacherStat&q;:{&q;teacherId&q;:56428,&q;episodeCount&q;:304,&q;scoreCount&q;:866,&q;avgScore&q;:9.736720554272521,&q;fiveGradeAvgScore&q;:4.87,&q;updateTime&q;:1770692599396},&q;auditionEpisode&q;:{&q;episodeTitle&q;:&q;个人展示课&q;,&q;episodeVideoUrl&q;:&q;https://vod.fbstatic.cn/22e9ceb2vodbj1251001446/829ecf005145403709544711366/wKTZNI4y06UA.mp4?t=f2a4b300&a;us=4070880000&a;sign=50d98f18eca2d6b1d5bb116b66e23690&q;},&q;memberOfCPC&q;:false,&q;tags&q;:null},&q;teachChannel&q;:1,&q;offline&q;:null,&q;duration&q;:6726,&q;hasAudition&q;:false,&q;bizType&q;:0,&q;bizId&q;:&q;726825&q;,&q;supportReplay&q;:true,&q;extraInfo&q;:null,&q;liveConfig&q;:{&q;episodeId&q;:10475101,&q;supportMultiGroup&q;:false,&q;exerciseBizType&q;:0,&q;videoDisplayType&q;:0,&q;avForwardType&q;:0,&q;useIntelligentRoom&q;:false,&q;hasStrokeKeynote&q;:true,&q;verticalModeType&q;:0,&q;originEpisodeId&q;:0,&q;supportRtmp&q;:false,&q;supportPk&q;:true,&q;supportLuckyBag&q;:true,&q;supportUserNoteStroke&q;:false,&q;communicateType&q;:0,&q;one2One&q;:false,&q;fakeLive&q;:false},&q;validStatus&q;:1,&q;supportLive&q;:true,&q;supportAiCatalog&q;:false,&q;hasIntelligentPen&q;:false,&q;useLocalRecording&q;:false,&q;useIntelligentRoom&q;:false,&q;hasSalePosition&q;:false,&q;hasEpisodeCards&q;:true,&q;lockedForShouna&q;:false,&q;needSignIn&q;:false,&q;needTeacherSignIn&q;:false,&q;enablePadPencil&q;:true,&q;displayExercise&q;:false,&q;supportLuckyBag&q;:true,&q;supportLivePk&q;:true},{&q;id&q;:10475091,&q;kePrefix&q;:&q;sydw&q;,&q;courseId&q;:6,&q;status&q;:3,&q;playStatus&q;:3,&q;type&q;:33,&q;recordingType&q;:0,&q;mediaType&q;:0,&q;title&q;:&q;【公基非法】精选好题 沉浸刷题&q;,&q;innerTitle&q;:&q;&q;,&q;startTime&q;:1744444800000,&q;endTime&q;:1744452000000,&q;teacher&q;:{&q;id&q;:35490,&q;userId&q;:68968810,&q;name&q;:&q;刘斐&q;,&q;brief&q;:&q;粉笔优质讲师&q;,&q;desc&q;:&q;粉笔优质讲师\n过往授课经验:6年一线教学授课经验，总授课时长 7000+h.\n教学经验: 具有常识公基、综应科目丰富的实践经验及系统扎实的专业理论知识，对各省市地方考试考情和命题方向有独到见解； 22 年在武汉粉笔被评为“学员进面率三等奖”。\n授课耐心细致精确高效。讲解知识能抓住重点，剖析难题深邃透彻。教学能力全面，既能精准狙击各类高频考点，帮助学生高效提分，又能深入剖析那些变态难题，拓展学生的思维边界。思维输出逻辑清晰，层次分明，条理井然，能让复杂知识变得简单易懂。&q;,&q;avatar&q;:&q;193b4cc400085a7.jpg&q;,&q;upperBodyPhoto&q;:null,&q;displayCoursePrefix&q;:&q;sydw&q;,&q;teacherStat&q;:{&q;teacherId&q;:35490,&q;episodeCount&q;:772,&q;scoreCount&q;:1768,&q;avgScore&q;:9.75113122171944,&q;fiveGradeAvgScore&q;:4.88,&q;updateTime&q;:1773473369986},&q;auditionEpisode&q;:{&q;episodeTitle&q;:&q;个人展示课&q;,&q;episodeVideoUrl&q;:&q;https://vod.fbstatic.cn/22e9ceb2vodbj1251001446/637a1c8d5145403708072789369/Q935cWiAVDUA.mp4?t=f2a4b300&a;us=4070880000&a;sign=b9e97b132323836b52734dae342e21af&q;},&q;memberOfCPC&q;:false,&q;tags&q;:null},&q;teachChannel&q;:1,&q;offline&q;:null,&q;duration&q;:7622,&q;hasAudition&q;:false,&q;bizType&q;:0,&q;bizId&q;:&q;726825&q;,&q;supportReplay&q;:true,&q;extraInfo&q;:null,&q;liveConfig&q;:{&q;episodeId&q;:10475091,&q;supportMultiGroup&q;:false,&q;exerciseBizType&q;:0,&q;videoDisplayType&q;:0,&q;avForwardType&q;:0,&q;useIntelligentRoom&q;:false,&q;hasStrokeKeynote&q;:true,&q;verticalModeType&q;:0,&q;originEpisodeId&q;:0,&q;supportRtmp&q;:false,&q;supportPk&q;:true,&q;supportLuckyBag&q;:true,&q;supportUserNoteStroke&q;:false,&q;communicateType&q;:0,&q;one2One&q;:false,&q;fakeLive&q;:false},&q;validStatus&q;:1,&q;supportLive&q;:true,&q;supportAiCatalog&q;:false,&q;hasIntelligentPen&q;:false,&q;useLocalRecording&q;:false,&q;useIntelligentRoom&q;:false,&q;hasSalePosition&q;:false,&q;hasEpisodeCards&q;:true,&q;lockedForShouna&q;:false,&q;needSignIn&q;:false,&q;needTeacherSignIn&q;:false,&q;enablePadPencil&q;:true,&q;displayExercise&q;:false,&q;supportLuckyBag&q;:true,&q;supportLivePk&q;:true},{&q;id&q;:10475810,&q;kePrefix&q;:&q;sydw&q;,&q;courseId&q;:6,&q;status&q;:3,&q;playStatus&q;:3,&q;type&q;:33,&q;recordingType&q;:0,&q;mediaType&q;:0,&q;title&q;:&q;【判断】精选好题 沉浸刷题&q;,&q;innerTitle&q;:&q;&q;,&q;startTime&q;:1744524000000,&q;endTime&q;:1744531200000,&q;teacher&q;:{&q;id&q;:64311,&q;userId&q;:87660655,&q;name&q;:&q;毛雨&q;,&q;brief&q;:&q;粉笔优质讲师&q;,&q;desc&q;:&q;粉笔优质教师\n多年一线教学授课经验，深耕事业单位考试，承担过线下笔试精品班、刷题班、冲刺班等多种班型，授课经验丰富。\n具有判断科目丰富的实践经验及系统扎实的专业理论知识和对事业单位判断推理考情的深入研究：\n曾参与命制笔试真题教研和解析撰写工作，对判断推理最新命题趋势方向有深入研究；\n多次参加粉笔授课研讨会议，注重考场思维，针对学生困惑研究教学策略，深入研讨事考判断命题趋势及最新考情，注重自我提升，积累丰富笔试理论知识；\n累计授课超1500小时，累计评分达4.9分，注重启发式引导，让学生在轻松的学习氛围中，用更简单的方法，找到更快捷的解题之道，深受广大学员的认可和好评；在学员中具有非常好的口碑，是值得信赖的好导师。&q;,&q;avatar&q;:&q;1945f3395b1b42e.jpg&q;,&q;upperBodyPhoto&q;:null,&q;displayCoursePrefix&q;:&q;sydw&q;,&q;teacherStat&q;:{&q;teacherId&q;:64311,&q;episodeCount&q;:607,&q;scoreCount&q;:1177,&q;avgScore&q;:9.83347493627868,&q;fiveGradeAvgScore&q;:4.92,&q;updateTime&q;:1773584237682},&q;auditionEpisode&q;:{&q;episodeTitle&q;:&q;个人展示课&q;,&q;episodeVideoUrl&q;:&q;https://vod.fbstatic.cn/22e9ceb2vodbj1251001446/075934a35145403709539072509/hFfKlbfvNUUA.mp4?t=f2a4b300&a;us=4070880000&a;sign=200c5599e3a9767162793d5e286a2d57&q;},&q;memberOfCPC&q;:false,&q;tags&q;:null},&q;teachChannel&q;:1,&q;offline&q;:null,&q;duration&q;:7489,&q;hasAudition&q;:false,&q;bizType&q;:0,&q;bizId&q;:&q;726825&q;,&q;supportReplay&q;:true,&q;extraInfo&q;:null,&q;liveConfig&q;:{&q;episodeId&q;:10475810,&q;supportMultiGroup&q;:false,&q;exerciseBizType&q;:0,&q;videoDisplayType&q;:0,&q;avFo