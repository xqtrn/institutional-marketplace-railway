q;validStatus&q;:1,&q;supportLive&q;:true,&q;supportAiCatalog&q;:false,&q;hasIntelligentPen&q;:false,&q;useLocalRecording&q;:false,&q;useIntelligentRoom&q;:false,&q;hasSalePosition&q;:false,&q;hasEpisodeCards&q;:true,&q;lockedForShouna&q;:false,&q;needSignIn&q;:false,&q;needTeacherSignIn&q;:false,&q;enablePadPencil&q;:true,&q;displayExercise&q;:false,&q;supportLuckyBag&q;:true,&q;supportLivePk&q;:true},{&q;id&q;:11094785,&q;kePrefix&q;:&q;sydw&q;,&q;courseId&q;:6,&q;status&q;:3,&q;playStatus&q;:3,&q;type&q;:33,&q;recordingType&q;:0,&q;mediaType&q;:0,&q;title&q;:&q;【数资】精选好题 沉浸刷题&q;,&q;innerTitle&q;:&q;&q;,&q;startTime&q;:1761184800000,&q;endTime&q;:1761192000000,&q;teacher&q;:{&q;id&q;:26292,&q;userId&q;:79327575,&q;name&q;:&q;郑美娟&q;,&q;brief&q;:&q;粉笔优质讲师&q;,&q;desc&q;:&q;粉笔数量关系与资料分析科目优质教师\n5年一线教学授课经验。\n具有数资科目丰富的实践经验及系统扎实的专业理论知识。多次参与粉笔数资授课研讨，教学教研能力扎实。承担过线下笔试精品班、刷题班、冲刺班等多种班型，授课经验丰富，思路清晰，讲解全面细致。\n授课形式生动形象，能够有针对性的引导学生进行主动思考，课堂氛围轻松无压力。擅长化繁为简，适合各个阶段的学生，深受广大学员好评。&q;,&q;avatar&q;:&q;1777f9e082273e5.jpg&q;,&q;upperBodyPhoto&q;:null,&q;displayCoursePrefix&q;:&q;sydw&q;,&q;teacherStat&q;:{&q;teacherId&q;:26292,&q;episodeCount&q;:567,&q;scoreCount&q;:1594,&q;avgScore&q;:9.803011292346305,&q;fiveGradeAvgScore&q;:4.9,&q;updateTime&q;:1773586366104},&q;auditionEpisode&q;:{&q;episodeTitle&q;:&q;个人展示课&q;,&q;episodeVideoUrl&q;:&q;https://vod.fbstatic.cn/22e9ceb2vodbj1251001446/9f3a48475145403713947309566/MDmpFEIP6G8A.mp4?t=f2a4b300&a;us=4070880000&a;sign=39fd01bda5913d3e938e577986d9db4b&q;},&q;memberOfCPC&q;:false,&q;tags&q;:null},&q;teachChannel&q;:1,&q;offline&q;:null,&q;duration&q;:9493,&q;hasAudition&q;:false,&q;bizType&q;:0,&q;bizId&q;:&q;726825&q;,&q;supportReplay&q;:true,&q;extraInfo&q;:null,&q;liveConfig&q;:{&q;episodeId&q;:11094785,&q;supportMultiGroup&q;:false,&q;exerciseBizType&q;:0,&q;videoDisplayType&q;:0,&q;avForwardType&q;:0,&q;useIntelligentRoom&q;:false,&q;hasStrokeKeynote&q;:true,&q;verticalModeType&q;:0,&q;originEpisodeId&q;:0,&q;supportRtmp&q;:false,&q;supportPk&q