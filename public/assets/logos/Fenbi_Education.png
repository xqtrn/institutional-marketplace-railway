ticalModeType&q;:0,&q;originEpisodeId&q;:0,&q;supportRtmp&q;:false,&q;supportPk&q;:true,&q;supportLuckyBag&q;:true,&q;supportUserNoteStroke&q;:false,&q;communicateType&q;:0,&q;one2One&q;:false,&q;fakeLive&q;:false},&q;validStatus&q;:1,&q;supportLive&q;:true,&q;supportAiCatalog&q;:false,&q;hasIntelligentPen&q;:false,&q;useLocalRecording&q;:false,&q;useIntelligentRoom&q;:false,&q;hasSalePosition&q;:false,&q;hasEpisodeCards&q;:true,&q;lockedForShouna&q;:false,&q;needSignIn&q;:false,&q;needTeacherSignIn&q;:false,&q;enablePadPencil&q;:true,&q;displayExercise&q;:false,&q;supportLuckyBag&q;:true,&q;supportLivePk&q;:true},{&q;id&q;:10844657,&q;kePrefix&q;:&q;sydw&q;,&q;courseId&q;:6,&q;status&q;:3,&q;playStatus&q;:3,&q;type&q;:33,&q;recordingType&q;:0,&q;mediaType&q;:0,&q;title&q;:&q;【综应】精选好题 沉浸刷题&q;,&q;innerTitle&q;:&q;&q;,&q;startTime&q;:1752112800000,&q;endTime&q;:1752120000000,&q;teacher&q;:{&q;id&q;:33934,&q;userId&q;:47842292,&q;name&q;:&q;王小雪&q;,&q;brief&q;:&q;粉笔优质讲师&q;,&q;desc&q;:&q;粉笔优质讲师\n6年一线教学经验，累计授课超过2500小时，累计评分达4.9分，深耕事业单位笔试考试，授课和实战经验丰富。\n在综应科目教学中，参与过多次综应真题教研，积累大量使用经验，专业理论知识扎实，对事业单位考试考情、真题等理解深刻。\n授课特色：授课风格多样化，风趣幽默，生动形象。授课内容上，知识点讲解细致，善于化繁为简，能够耐心引导，准确把握重点，深受学员喜爱。&q;,&q;avatar&q;:&q;17d222383a2be22.jpg&q;,&q;upperBodyPhoto&q;:null,&q;displayCoursePrefix&q;:&q;sydw&q;,&q;teacherStat&q;:{&q;teacherId&q;:33934,&q;episodeCount&q;:352,&q;scoreCount&q;:654,&q;avgScore&q;:9.917431192660548,&q;fiveGradeAvgScore&q;:4.96,&q;updateTime&q;:1773322484439},&q;auditionEpisode&q;:{&q;episodeTitle&q;:&q;个人展示课&q;,&q;episodeVideoUrl&q;:&q;https://vod.fbstatic.cn/22e9ceb2vodbj1251001446/cfa2d5445145403707474934084/ZImz8czb8RcA.mp4?t=f2a4b300&a;us=4070880000&a;sign=1521fbe9ea574acc07dbe931b344661e&q;},&q;memberOfCPC&q;:false,&q;tags&q;:null},&q;teachChannel&q;:1,&q;offline&q;:null,&q;duration&q;:7580,&q;hasAudition&q;:false,&q;bizType&q;:0,&q;bizId&q;:&q;726825&q;,&q;supportReplay&q;:true,&q;extraInfo&q;:null,&q;liveConfig&q;:{&q;episodeId&q;:10844657,&q;supportMultiGroup&q;:false,&q;exerciseBizType&q;:0,&q;videoDisplayType&q;:0,&q;avForwardType&q;:0,&q;useIntelligentRoom&q;:false,&q;hasStrokeKeynote&q;:true,&q;verticalModeType&q;:0,&q;originEpisodeId&q;:0,&q;supportRtmp&q;:false,&q;supportPk&q;:true,&q;supportLuckyBag&q;:true,&q;supportUserNoteStroke&q;:false,&q;communicateType&q;:0,&q;one2One&q;:false,&q;fakeLive&q;:false},&q;validStatus&q;:1,&q;supportLive&q;:true,&q;supportAiCatalog&q;:false,&q;hasIntelligentPen&q;:false,&q;useLocalRecording&q;:false,&q;useIntelligentRoom&q;:false,&q;hasSalePosition&q;:false,&q;hasEpisodeCards&q;:true,&q;lockedForShouna&q;:false,&q;needSignIn&q;:false,&q;needTeacherSignIn&q;:false,&q;enablePadPencil&q;:false,&q;displayExercise&q;:false,&q;supportLuckyBag&q;:true,&q;supportLivePk&q;:true},{&q;id&q;:10844658,&q;kePrefix&q;:&q;sydw&q;,&q;courseId&q;:6,&q;status&q;:3,&q;playStatus&q;:3,&q;type&q;:33,&q;recordingType&q;:0,&q;mediaType&q;:0,&q;title&q;:&q;【言语】精选好题 沉浸刷题&q;,&q;innerTitle&q;:&q;&q;,&q;startTime&q;:1752120000000,&q;endTime&q;:1752127200000,&q;teacher&q;:{&q;id&q;:32923,&q;userId&q;:83087094,&q;name&q;:&q;杨优秀&q;,&q;brief&q;:&q;粉笔优质讲师&q;,&q;desc&q;:&q;粉笔优质教师\n8年一线教学授课经验，线上累计授课超1000小时，授课人数10000+，线下曾担任联考言语主讲老师，具有言语理解与表达科目丰富的实践经验及系统扎实的专业理论知识。线下与线上授课经验丰富，善于讲解联考、江苏、浙江、广东各省言语课程，对于言语题型有独到的见解，能够多方面把握学员需求，精准定位学员薄弱点。多次参加粉笔教研活动，参与笔试真题解析与精品班精品挑战选题，助力粉笔理论研发升级。积极参与各项比赛，曾获粉笔风采大赛“最具风格奖”，娓娓道来的授课风格，让学生在轻松的学习氛围中，用更简单的方法，找到更快捷的解题之道，深受广大学员的认可和好评。&q;,&q;avatar&q;:&q;1785e21dcfe8463.jpg&q;,&q;upperBodyPhoto&q;:null,&q;displayCoursePrefix&q;:&q;sydw&q;,&q;teacherStat&q;:{&q;teacherId&q;:32923,&q;episodeCount&q;:374,&q;scoreCount&q;:1626,&q;avgScore&q;:9.857318573185726,&q;fiveGradeAvgScore&q;:4.93,&q;updateTime&q;:1772881550179},&q;auditionEpisode&q;:null,&q;memberOfCPC&q;:false,&q;tags&q;:null},&q;teachChannel&q;:1,&q;offline&q;:null,&q;duration&q;:7957,&q;hasAudition&q;:false,&q;bizType&q;:0,&q;bizId&q;:&q;726825&q;,&q;supportReplay&q;:true,&q;extraInfo&q;:null,&q;liveConfig&q;:{&q;episodeId&q;:10844658,&q;supportMultiGroup