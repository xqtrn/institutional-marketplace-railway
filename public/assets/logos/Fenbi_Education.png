://vod.fbstatic.cn/22e9ceb2vodbj1251001446/ea647b293560136621448493397/AgNBj9JryZ0A.mp4?t=f2a4b300&a;us=4070880000&a;sign=f2afee40504dffe0d47170f69b331867&q;},&q;memberOfCPC&q;:false,&q;tags&q;:null},&q;teachChannel&q;:1,&q;offline&q;:null,&q;duration&q;:7949,&q;hasAudition&q;:false,&q;bizType&q;:0,&q;bizId&q;:&q;710082&q;,&q;supportReplay&q;:true,&q;extraInfo&q;:null,&q;liveConfig&q;:{&q;episodeId&q;:11636300,&q;supportMultiGroup&q;:false,&q;exerciseBizType&q;:0,&q;videoDisplayType&q;:0,&q;avForwardType&q;:0,&q;useIntelligentRoom&q;:false,&q;hasStrokeKeynote&q;:true,&q;verticalModeType&q;:0,&q;originEpisodeId&q;:0,&q;supportRtmp&q;:false,&q;supportPk&q;:false,&q;supportLuckyBag&q;:false,&q;supportUserNoteStroke&q;:false,&q;communicateType&q;:0,&q;one2One&q;:false,&q;fakeLive&q;:false},&q;validStatus&q;:1,&q;supportLive&q;:true,&q;supportAiCatalog&q;:true,&q;hasIntelligentPen&q;:false,&q;useLocalRecording&q;:false,&q;useIntelligentRoom&q;:false,&q;hasSalePosition&q;:false,&q;hasEpisodeCards&q;:false,&q;lockedForShouna&q;:false,&q;needSignIn&q;:false,&q;needTeacherSignIn&q;:false,&q;enablePadPencil&q;:true,&q;displayExercise&q;:false,&q;supportLuckyBag&q;:false,&q;supportLivePk&q;:false}],&q;episodeCount&q;:229,&q;hasComments&q;:false,&q;individualInfo&q;:{&q;userGroupon&q;:null},&q;paid&q;:false,&q;fillExamInfo&q;:false,&q;payPrice&q;:0,&q;canBuy&q;:true},{&q;id&q;:223,&q;gid&q;:57,&q;umask&q;:6627,&q;name&q;:&q;&q;,&q;title&q;:&q;【早晚课】2026年粉笔晨晚伴学课（早7晚10   3月2日正式开课   全年合集仅需9元(会员免费)）&q;,&q;desc&q;:&q;&l;p&g;&l;img width=\&q;750px\&q; height=\&q;10407px\&q; src=\&q;https://ke.fbstatic.cn/api/images/19c309f1f4c96e1.jpg?width=1080\&q; /&g;&l;/p&g;&q;,&q;ubbText&q;:&q;&q;,&q;imgUrl&q;:&q;//nodestatic.fbstatic.cn/pan/downloads/c27881565b0aa4caa1470ea318595c44.png&q;,&q;linkUrl&q;:&q;https://www.fenbi.com/spa/pwa/lecture/gwy/773251/0&q;,&q;type&q;:0,&q;typeName&q;:&q;热门课程&q;,&q;weight&q;:80,&q;status&q;:1,&q;isPublished&q;:1,&q;course&q;:0,&q;courseType&q;:0,&q;position&q;:0,&q;source&q;:&q;&q;,&q;uploadTime&q;:&q;&q;,&q;updatedTime&q;:&q;2026-02-11T09:10:13.000Z&q;,&q;createdTime&q;:&q;2024-08-05T08:43:57.931Z&q;,&q;teacherId&q;:&q;0&q;,&q;teacherAvatar&q;:&q;&q;,&q;teacherProtrait&q;:&q;&q;,&q;brief&q;:&q;【早晚课】2026年粉笔晨晚伴学课&q;,&q;videoUrl&q;:&q;&q;,&q;coverUrl&q;:&q;&q;,&q;subjectInformation&q;:{&q;examInformation&q;:[],&q;historyExams&q;:[],&q;examPreparationMaterials&q;:[]},&q;homepageTopic&q;:{&q;examAnnouncements&q;:[{&q;title&q;:&q;&q;,&q;subtitle&q;:&q;&q;,&q;jumpLink&q;:&q;&q;}],&q;guidanceArticles&q;:[{&q;title&q;:&q;&q;,&q;jumpLink&q;:&q;&q;}],&q;mainImages&q;:[{&q;title&q;:&q;&q;,&q;jumpLink&q;:&q;&q;,&q;imgUrl&q;:&q;&q;,&q;weight&q;:0}],&q;table&q;:{&q;title&q;:&q;&q;,&q;row&q;:0,&q;column&q;:0,&q;contents&q;:[]}},&q;homepageExams&q;:[{&q;title&q;:&q;&q;,&q;jumpLink&q;:&q;&q;}],&q;publisher&q;:&q;&q;,&q;contentType&q;:0,&q;courseId&q;:773251,&q;saleStatus&q;:0,&q;salesStatus&q;:0,&q;shortName&q;:&q;&q;,&q;explanation&q;:&q;早7晚10   3月2日正式开课   全年合集仅需9元(会员免费)&q;,&q;price&q;:9,&q;priceDisplayType&q;:0,&q;floorPrice&q;:9,&q;topPrice&q;:9,&q;promotionPrice&q;:9,&q;promotionDesc&q;:&q;&q;,&q;studentLimit&q;:0,&q;studentCount&q;:5501,&q;salesText&q;:&q;5501人购买&q;,&q;hasAddress&q;:true,&q;classHours&q;:437,&q;startSaleTime&q;:1770775200000,&q;stopSaleTime&q;:1805076000000,&q;classStartTime&q;:1772406000811,&q;classEndTime&q;:1801233900811,&q;hasExercise&q;:false,&q;hasQQGroup&q;:false,&q;hasImGroup&q;:false,&q;hasClassPeriod&q;:true,&q;hasPosition&q;:false,&q;hasUserContentInfo&q;:false,&q;hasUserExamInfo&q;:false,&q;hasUserFormBeforeOrder&q;:false,&q;hasUserFormAfterOrder&q;:false,&q;hasCustomerService&q;:false,&q;hasRedirectInstructor&q;:false,&q;hasLiveEpisodes&q;:false,&q;hasAudition&q;:false,&q;teachers&q;:[{&q;id&q;:4372,&q;userId&q;:45812058,&q;name&q;:&q;夏方军&q;,&q;brief&q;:&q;粉笔公基优质教师&q;,&q;desc&q;:&q;粉笔公基优质教师，岗位第一考入食药系统，一年编制工作经历，八年公考事业编授课经历。对政治理论、时政常识、面试有深入研究，擅长从热点、考情维度进行预判。授课细致耐心、思维发散清晰，学生的“小姨夫”。&q;,&q;avatar&q;:&q;19407933436c6d4.jpg&q;,&q;upperBodyPhoto&q;:null,&q;displayCoursePrefix&q;:&q;gwy&q;,&q;teacherStat&q;:{&q;teacherId&q;:4372,&q;episodeCount&q;:1059,&q;scoreCount&q;:209965,&q;avgScore&q;:9.894925344700331,&q;fiveGradeAvgScore&q;:4.95,&q;updateTime&q;:1773623280251},&q;auditionEpisode&q;:{&q;episodeTitle&q;:&q;个人展示课&q;,&q;episodeVideoUrl&q;:&q;https://vod.fbstatic.cn/22e9ceb2vodbj1251001446/65771a37243791580257902972/f0.mp4?t=f2a4b300&a;us=4070880000&a;sign=fe62d49b4742040836cd99e0a96d0768&q;},&q;memberOfCPC&q;:false,&q;tags&q;:null},{&q;id&q;:1779,&q;userId&q;:44420612,&q;name&q;:&q;明蕾&q;,&q;brief&q;:&q;粉笔言语优质教师&q;,&q;desc&q;:&q;粉笔言语优质教师，文科类硕士\n11年公考授课经验，打分人次超60万，学员评分高达4.9分。\n言语理论基本功扎实，教学经验丰富，授课思路清晰、重点突出，善于引导和总结，注重培养学员举一反三的能力，深受学员好评。&q;,&q;avatar&q;:&q;1718adf9442d3aa.jpg&q;,&q;upperBodyPhoto&q;:null,&q;displayCoursePrefix&q;:&q;gwy&q;,&q;teacherStat&q;:{&q;teacherId&q;:1779,&q;episodeCount&q;:1221,&q;scoreCount&q;:711933,&q;avgScore&q;:9.856694379948717,&q;fiveGradeAvgScore&q;:4.93,&q;updateTime&q;:1773617671467},&q;auditionEpisode&q;:{&q;episodeTitle&q;:&q;个人展示课&q;,&q;episodeVideoUrl&q;:&q;https://vod.fbstatic.cn/22e9ceb2vodbj1251001446/9cec1afc3560136621447424292/iEATIpvLLIQA.mp4?t=f2a4b300&a;us=4070880000&a;sign=63c6130e26890e04c6b2856e24c1f1da&q;},&q;memberOfCPC&q;:false,&q;tags&q;:null},{&q;id&q;:71950,&q;userId&q;:41185252,&q;name&q;:&q;左宏帅&q;,&q;brief&q;:&q;粉笔数资优质教师&q;,&q;desc&q;:&q;粉笔数资优质教师，浙江大学数学系硕士毕业。\n15年授课经验，累计授课时长超过20000小时，培训师资千余人，培训学员300余万人次，上岸学员数以万计。\n坚持一线教学，不断钻研创新，独创行业资料分析题型教学法，深刻了解学员的痛点难点，授课深入浅出，通俗易懂，因材施教，深受学员好评。\n参与组织各类授课研讨会议和教研活动，著有《行测新时代(数量关系)》《行测新时代(资料分析)》、《公务员考试5100题》等多套图书。&q;,&q;avatar&q;:&q;194401c9dbc8d94.jpg&q;,&q;upperBodyPhoto&q;:null,&q;displayCoursePrefix&q;:&q;gwy&q;,&q;teacherStat&q;:{&q;teacherId&q;:71950,&q;episodeCount&q;:306,&q;scoreCount&q;:106865,&q;avgScore&q;:9.8630795863941,&q;fiveGradeAvgScore&q;:4.93,&q;updateTime&q;:1773623430603},&q;auditionEpisode&q;:{&q;episodeTitle&q;:&q;个人展示课&q;,&q;episodeVideoUrl&q;:&q;https://vod.fbstatic.cn/22e9ceb2vodbj1251001446/ef0d2a603560136621448690407/eJ7KKJmF5b8A.mp4?t=f2a4b300&a;us=4070880000&a;sign=c3fa61877607e1167f9a85a9b29ea6aa&q;},&q;memberOfCPC&q;:false,&q;tags&q;:null},{&q;id&q;:11676,&q;userId&q;:44787868,&q;name&q;:&q;刘鸿&q;,&q;brief&q;:&q;粉笔公基优质讲师&q;,&q;desc&q;:&q;粉笔公考常识、公共基础知识优质讲师，累计授课1W+。9年公考培训经验，常年从事一线授课工作。对马克思主义哲学、中共党史、中国特色社会主义理论体系、大政方针时事政治等政治理论有系统研究。授课脉络清晰重点突出，课堂风格激情幽默，擅长学员备考规划指导及技巧点拨。&q;,&q;avatar&q;:&q;192d26d60f9ea18.jpg&q;,&q;upperBodyPhoto&q;:null,&q;displayCoursePrefix&q;:&q;gwy&q;,&q;teacherStat&q;:{&q;teacherId&q;:11676,&q;episodeCount&q;:764,&q;scoreCount&q;:235431,&q;avgScore&q;:9.907361392509907,&q;fiveGradeAvgScore&q;:4.95,&q;updateTime&q;:1773623300330},&q;auditionEpisode&q;:null,&q;memberOfCPC&q;:false,&q;tags&q;:null},{&q;id&q;:1191,&q;userId&q;:42494582,&q;name&q;:&q;唐宋&q;,&q;brief&q;:&q;粉笔数资优质教师&q;,&q;desc&q;:&q;粉笔数资优质教师，985高校毕业。 \n15年公考授课经验，打分人次超70万，学员评分高达4.9分。 \n对数量关系与资料分析有深刻的认识和见解，在授课中注重思维引导，善于剖析学员的解题误区，针对性解决问题，解题方法多样，可操作性强。 \n参与主持各类授课研讨会议和教研活动，负责审阅《行测的思维》等多套图书。&q;,&q;avatar&q;:&q;18d405f7e4b8986.jpg&q;,&q;upperBodyPhoto&q;:null,&q;displayCoursePrefix&q;:&q;gwy&q;,&q;teacherStat&q;:{&q;teacherId&q;:1191,&q;episodeCount&q;:1320,&q;scoreCount&q;:782369,&q;avgScore&q;:9.868775475510896,&q;fiveGradeAvgScore&q;:4.93,&q;updateTime&q;:1773622758821},&q;auditionEpisode&q;:{&q;episodeTitle&q;:&q;个人展示课&q;,&q;episodeVideoUrl&q;:&q;https://vod.fbstatic.cn/22e9ceb2vodbj1251001446/9d2164e03560136621447452862/SBy9zjJj7ScA.mp4?t=f2a4b300&a;us=4070880000&a;sign=0cd0cf017d8689074ec85b58c31ca5af&q;},&q;memberOfCPC&q;:false,&q;tags&q;:null},{&q;id&q;:6832,&q;userId&q;:64139692,&q;name&q;:&q;王韵博&q;,&q;brief&q;:&q;粉笔申论面试优质教师&q;,&q;desc&q;:&q;粉笔申论面试优质教师。\n10年公考培训经验，累计一线授课超20000小时，学员评分5.0。对学生的问题都能有针对性的解决办法。授课严谨，见解独到，多方面了解命题规律。风趣幽默，逻辑清晰，营造沉浸式学习氛围，在轻松的环境下，收获更多知识，让学员有所得，有所悟。&q;,&q;avatar&q;:&q;1927ac795361d54.jpg&q;,&q;upperBodyPhoto&q;:null,&q;displayCoursePrefix&q;:&q;gwy&q;,&q;teacherStat&q;:{&q;teacherId&q;:6832,&q;episodeCount&q;:966,&q;scoreCount&q;:170662,&q;avgScore&q;:9.900458215654355,&q;fiveGradeAvgScore&q;:4.95,&q;updateTime&q;:1773621896940},&q;auditionEpisode&q;:{&q;episodeTitle&q;:&q;个人展示课&q;,&q;episodeVideoUrl&q;:&q;https://vod.fbstatic.cn/22e9ceb2vodbj1251001446/5f1e50dc1397757891876772063/MWKFa6GN1IMA.mp4?t=f2a4b300&a;us=4070880000&a;sign=14db4fb731e022ba961306cafa5b6855&q;},&q;memberOfCPC&q;:false,&q;tags&q;:null},{&q;id&q;:3198,&q;userId&q;:43782348,&q;name&q;:&q;安杰&q;,&q;brief&q;:&q;粉笔言语优质教师&q;,&q;desc&q;:&q;粉笔言语优质教师，硕士学历，10年公考授课经验，学员评分高达4.9分，被学员亲切称为“二舅”。授课端，善于把握考情趋势，将知识点融会贯通，迅速厘清重点难点。培训端，为行业培养上百名优秀教师。&q;,&q;avatar&q;:&q;171ee8a2fecad21.jpg&q;,&q;upperBodyPhoto&q;:null,&q;displayCoursePrefix&q;:&q;gwy&q;,&q;teacherStat&q;:{&q;teacherId&q;:3198,&q;episodeCount&q;:1375,&q;scoreCount&q;:532049,&q;avgScore&q;:9.863429872060653,&q;fiveGradeAvgScore&q;:4.93,&q;updateTime&q;:1773623129594},&q;auditionEpisode&q;:{&q;episodeTitle&q;:&q;个人展示课&q;,&q;episodeVideoUrl&q;:&q;https://vod.fbstatic.cn/22e9ceb2vodbj1251001446/9f9d6ba73560136621447577483/bsphLRtOyaAA.mp4?t=f2a4b300&a;us=4070880000&a;sign=615c6ec215235eec9be3da23e83f2652&q;},&q;memberOfCPC&q;:false,&q;tags&q;:null},{&q;id&q;:7754,&q;userId&q;:61196798,&q;name&q;:&q;王东岳&q;,&q;brief&q;:&q;粉笔判断优质教师&q;,&q;desc&q;:&q;粉笔判断优质教师。\n7年授课经验，累计授课时长6000+，授课评分4.9+，培训学员100余万人次。有着多年丰富的国考及省考授课经验，逻辑框架清晰。授课风格深入浅出，结构严谨又不乏幽默；授课内容直指考试核心。教学方式多样，因材施教，掌握学生心理，深受学员欢迎。\n参与制作国省考授课讲义、《行测的思维》、《决战行测5000题》等多套图书。&q;,&q;avatar&q;:&q;1928e11bb6d26f0.jpg&q;,&q;upperBodyPhoto&q;:null,&q;displayCoursePrefix&q;:&q;gwy&q;,&q;teacherStat&q;:{&q;teacherId&q;:7754,&q;episodeCount&q;:1301,&q;scoreCount&q;:243516,&q;avgScore&q;:9.87308431478835,&q;fiveGradeAvgScore&q;:4.94,&q;updateTime&q;:1773620855135},&q;auditionEpisode&q;:{&q;episodeTitle&q;:&q;个人展示课&q;,&q;episodeVideoUrl&q;:&q;https://vod.fbstatic.cn/22e9ceb2vodbj1251001446/4bb38a333560136621446283020/WcYGrU72AukA.mp4?t=f2a4b300&a;us=4070880000&a;sign=0634969fb328a1e47afdf3e0332c5544&q;},&q;memberOfCPC&q;:false,&q;tags&q;:null},{&q;id&q;:4996,&q;userId&q;:51581932,&q;name&q;:&q;司琦&q;,&q;brief&q;:&q;粉笔言语优质教师&q;,&q;desc&q;:&q;粉笔言语优质教师，8年授课经验，长期深耕公务员行测言语模块，精准把握命题趋势，对各类题型有着独到的见解，曾负责师资培训、模拟题撰写和教材编写等工作。教学中，注重因材施教，助力学员夯实基础、提升能力。授课风格幽默且严谨，讲解深入浅出，让复杂的知识变得通俗易懂，深受学员好评。&q;,&q;avatar&q;:&q;19270dc6dfb73cb.jpg&q;,&q;upperBodyPhoto&q;:null,&q;displayCoursePrefix&q;:&q;gwy&q;,&q;teacherStat&q;:{&q;teacherId&q;:4996,&q;episodeCount&q;:1396,&q;scoreCount&q;:216731,&q;avgScore&q;:9.871767306015292,&q;fiveGradeAvgScore&q;:4.94,&q;updateTime&q;:1773594524697},&q;auditionEpisode&q;:{&q;episodeTitle&q;:&q;个人展示课&q;,&q;episodeVideoUrl&q;:&q;https://vod.fbstatic.cn/22e9ceb2vodbj1251001446/9cc6e9f83560136621447402832/oxLbyW9tbc4A.mp4?t=f2a4b300&a;us=4070880000&a;sign=742574c1fe64d1e966a0d28dfe74cc08&q;},&q;memberOfCPC&q;:false,&q;tags&q;:null},{&q;id&q;:1491,&q;userId&q;:40445632,&q;name&q;:&q;李纳&q;,&q;brief&q;:&q;粉笔申论优质教师&q;,&q;desc&q;:&q;粉笔申论优质老师，\n9年公考授课经验，打分人次超20万，学员评分高达4.9分。\n长期致力于公考研究，对试题有深刻的把握和独到的见解。注重因材施教，授课深入浅出、通俗易懂。富有激情又不失幽默，课堂氛围活跃。&q;,&q;avatar&q;:&q;17587d0e130748e.jpg&q;,&q;upperBodyPhoto&q;:null,&q;displayCoursePrefix&q;:&q;gwy&q;,&q;teacherStat&q;:{&q;teacherId&q;:1491,&q;episodeCount&q;:1101,&q;scoreCount&q;:402422,&q;avgScore&q;:9.854351899250036,&q;fiveGradeAvgScore&q;:4.93,&q;updateTime&q;:1773585181685},&q;auditionEpisode&q;:{&q;episodeTitle&q;:&q;个人展示课&q;,&q;episodeVideoUrl&q;:&q;https://vod.fbstatic.cn/22e9ceb2vodbj1251001446/a3c805883560136621447705797/W2Ucye2AjXgA.mp4?t=f2a4b300&a;us=4070880000&a;sign=a628916274f31ee68e9e0419239f215e&q;},&q;memberOfCPC&q;:false,&q;tags&q;:null},{&q;id&q;:3824,&q;userId&q;:40174320,&q;name&q;:&q;江澄&q;,&q;brief&q;:&q;粉笔申论优质教师&q;,&q;desc&q;:&q;粉笔申论优质教师，曾受邀担任政府机关公文写作培训主讲。8年公考授课经验，打分人次超16万，学员评分高达4.9分。 \n考点把握精准，授课重点突出，善于总结拓展，教学实用性强，能够及时发现学员的个性化问题，因材施教。&q;,&q;avatar&q;:&q;1954bf50a3a4e0a.jpg&q;,&q;upperBodyPhoto&q;:null,&q;displayCoursePrefix&q;:&q;gwy&q;,&q;teacherStat&q;:{&q;teacherId&q;:3824,&q;episodeCount&q;:1475,&q;scoreCount&q;:235460,&q;avgScore&q;:9.865624734562134,&q;fiveGradeAvgScore&q;:4.93,&q;updateTime&q;:1773620554674},&q;auditionEpisode&q;:{&q;episodeTitle&q;:&q;个人展示课&q;,&q;episodeVideoUrl&q;:&q;https://vod.fbstatic.cn/22e9ceb2vodbj1251001446/98ad3b5b3560136621447282082/3LnOnFkB4YoA.mp4?t=f2a4b300&a;us=4070880000&a;sign=5fa092dd930dd9ec24f161c367231eed&q;},&q;memberOfCPC&q;:false,&q;tags&q;:null},{&q;id&q;:21356,&q;userId&q;:74166806,&q;name&q;:&q;李陈&q;,&q;brief&q;:&q;粉笔判断优质教师&q;,&q;desc&q;:&q;粉笔判断优质教师，纽约大学理学硕士。 \n国考部委高分考生，5年公考授课经验，累积授课时长超2000小时。 \n作为判断教研组成员，每年参与系统班、精品班课程设计，图书更新，AI测试等工作，理论功底扎实，授课逻辑清晰，善于归纳总结，深受学生喜爱。&q;,&q;avatar&q;:&q;179f4e980a2a9c2.jpg&q;,&q;upperBodyPhoto&q;:null,&q;displayCoursePrefix&q;:&q;gwy&q;,&q;teacherStat&q;:{&q;teacherId&q;:21356,&q;episodeCount&q;:630,&q;scoreCount&q;:58216,&q;avgScore&q;:9.906589253813385,&q;fiveGradeAvgScore&q;:4.95,&q;updateTime&q;:1773591681002},&q;auditionEpisode&q;:{&q;episodeTitle&q;:&q;个人展示课&q;,&q;episodeVideoUrl&q;:&q;https://vod.fbstatic.cn/22e9ceb2vodbj1251001446/93a914d83560136621447033634/KARgUYgs6AEA.mp4?t=f2a4b300&a;us=4070880000&a;sign=0b98f8bdbbcb817fcb78cbd713914cc1&q;},&q;memberOfCPC&q;:false,&q;tags&q;:null},{&q;id&q;:3607,&q;userId&q;:44494242,&q;name&q;:&q;刘婉霞&q;,&q;brief&q;:&q;粉笔申论优质教师&q;,&q;desc&q;:&q;粉笔申论优质教师。\n211院校硕士学历，10年公考授课经验，授课时长10000+小时，学员评分达4.9。授课逻辑缜密，以“将军思维”帮助学生理清材料宏观逻辑，站在考生角度梳理题目，突出考场实战技巧，善于思维启发和知识点迁移，化繁为简，深受学员好评。&q;,&q;avatar&q;:&q;192703a52d62eae.jpg&q;,&q;upperBodyPhoto&q;:null,&q;displayCoursePrefix&q;:&q;gwy&q;,&q;teacherStat&q;:{&q;teacherId&q;:3607,&q;episodeCount&q;:1211,&q;scoreCount&q;:114424,&q;avgScore&q;:9.87735090540446,&q;fiveGradeAvgScore&q;:4.94,&q;updateTime&q;:1773621947021},&q;auditionEpisode&q;:{&q;episodeTitle&q;:&q;个人展示课&q;,&q;episodeVideoUrl&q;:&q;https://vod.fbstatic.cn/22e9ceb2vodbj1251001446/963623c23560136621447166448/QamF5xR1EwEA.mp4?t=f2a4b300&a;us=4070880000&a;sign=0bad72e4fdf68573309d8c6c0180008b&q;},&q;memberOfCPC&q;:false,&q;tags&q;:null},{&q;id&q;:241,&q;userId&q;:53092312,&q;name&q;:&q;刘凯&q;,&q;brief&q;:&q;粉笔数资优质教师&q;,&q;desc&q;:&q;粉笔数资优质教师，13年公考事考授课经验，同时培训师资数百名，长期致力于公考事考研究。专业功底扎实，因材施教，授课深入浅出，注重学员思路的引导，让学员在理解的基础上更好的学习数资知识，方法实用性强，深受学员好评。&q;,&q;avatar&q;:&q;17203354d2273fc.jpg&q;,&q;upperBodyPhoto&q;:null,&q;displayCoursePrefix&q;:&q;gwy&q;,&q;teacherStat&q;:{&q;teacherId&q;:241,&q;episodeCount&q;:1290,&q;scoreCount&q;:304514,&q;avgScore&q;:9.840066466566421,&q;fiveGradeAvgScore&q;:4.92,&q;updateTime&q;:1773619643676},&q;auditionEpisode&q;:{&q;episodeTitle&q;:&q;个人展示课&q;,&q;episodeVideoUrl&q;:&q;https://vod.fbstatic.cn/22e9ceb2vodbj1251001446/9d496bc13560136621447479800/VJWLl8XByEAA.mp4?t=f2a4b300&a;us=4070880000&a;sign=8cde3ed0892f39d2c645169b86462c16&q;},&q;memberOfCPC&q;:false,&q;tags&q;:null},{&q;id&q;:5418,&q;userId&q;:57004843,&q;name&q;:&q;王得权&q;,&q;brief&q;:&q;粉笔言语优质教师&q;,&q;desc&q;:&q;粉笔言语优质教师，9年授课经验，累计授课学员超10万人。课程讲解深入浅出，易于理解。方法和技巧并重，能够让学员学会举一反三，提高备考效率。善于归纳总结，能及时帮助学员梳理知识点和易错点，让大家在备考过程中少走许多弯路。 \n参与组织各类教研工作，曾参与《行测的思维》《笔试系统讲义》《行测5000题》等多个套图书的编写工作，同时参与了多套模拟题的命制和审核工作。&q;,&q;avatar&q;:&q;171ee8c61a66542.jpg&q;,&q;upperBodyPhoto&q;:null,&q;displayCoursePrefix&q;:&q;gwy&q;,&q;teacherStat&q;:{&q;teacherId&q;:5418,&q;episodeCount&q;:1247,&q;scoreCount&q;:277060,&q;avgScore&q;:9.835154840106865,&q;fiveGradeAvgScore&q;:4.92,&q;updateTime&q;:1773586366127},&q;auditionEpisode&q;:{&q;episodeTitle&q;:&q;个人展示课&q;,&q;episodeVideoUrl&q;:&q;https://vod.fbstatic.cn/22e9ceb2vodbj1251001446/0f225a083560136621445998641/a18MDSiKuD8A.mp4?t=f2a4b300&a;us=4070880000&a;sign=37d51c78dbb190aa30426da491044bdf&q;},&q;memberOfCPC&q;:false,&q;tags&q;:null},{&q;id&q;:1869,&q;userId&q;:44618334,&q;name&q;:&q;张婼予&q;,&q;brief&q;:&q;粉笔面试研究院成员、高级面试讲师&q;,&q;desc&q;:&q;       8年以上公考面试授课经验，曾任粉笔培训学院常务副院长职务，负责粉笔面试师资的整体培训工作。现任粉笔东北大区面试教学教研负责人，主要承担国省考面试理论大课、线上公开课及线上直播工作。\n       张婼予老师具备深厚的知识储备，对面试理论见解独到，能够通过清晰明确的步骤帮助学员理清答题技巧，掌握答题思路。更善于为学员进行干货补充，拔高答题站位，亮化答题内容。实现面试答题思路从无到有，从有到优的提升。&q;,&q;avatar&q;:&q;181d83e3f68ac60.jpg&q;,&q;upperBodyPhoto&q;:null,&q;displayCoursePrefix&q;:&q;gwy&q;,&q;teacherStat&q;:{&q;teacherId&q;:1869,&q;episodeCount&q;:634,&q;scoreCount&q;:68333,&q;avgScore&q;:9.875784759925676,&q;fiveGradeAvgScore&q;:4.94,&q;updateTime&q;:1773587670624},&q;auditionEpisode&q;:{&q;episodeTitle&q;:&q;个人展示课&q;,&q;episodeVideoUrl&q;:&q;https://vod.fbstatic.cn/22e9ceb2vodbj1251001446/f25d26233270835013756900478/CiXxK0TXdqAA.mp4?t=f2a4b300&a;us=4070880000&a;sign=ed3ab10128415000df2e782dac744c0a&q;},&q;memberOfCPC&q;:false,&q;tags&q;:null},{&q;id&q;:11249,&q;userId&q;:64782764,&q;name&q;:&q;刘烨&q;,&q;brief&q;:&q;粉笔公基、常识优质教师&q;,&q;desc&q;:&q;粉笔公基、常识优质教师。\n9年一线授课教研经验，累计授课时长超1w小时，学员评分高达4.9分。老师始终以生动有趣、激发学生思维为教学宗旨，善于将课堂内容化繁为简、化难为易，将晦涩知识通过日常生活的案例呈现，使学员在较短时间内能够更清晰地掌握所学知识。&q;,&q;avatar&q;:&q;192d26d6a1107c0.jpg&q;,&q;upperBodyPhoto&q;:null,&q;displayCoursePrefix&q;:&q;gwy&q;,&q;teacherStat&q;:{&q;teacherId&q;:11249,&q;episodeCount&q;:861,&q;scoreCount&q;:51878,&q;avgScore&q;:9.866263155865685,&q;fiveGradeAvgScore&q;:4.93,&q;updateTime&q;:1773622237480},&q;auditionEpisode&q;:null,&q;memberOfCPC&q;:false,&q;tags&q;:null},{&q;id&q;:4985,&q;userId&q;:49038142,&q;name&q;:&q;王丹娅&q;,&q;brief&q;:&q;粉笔判断优质教师&q;,&q;desc&q;:&q;粉笔判断优质教师，7年公考授课经验，长期致力于判断推理科目的教学及教研工作，善于拓展迁移，注重总结实用答题技巧。授课严谨细致又不失幽默，注重与学生的互动，擅长解决学员个性化问题，让学员可以在轻松愉快的氛围中得到个性化提升。希望在公考的道路上可以助您一臂之力。&q;,&q;avatar&q;:&q;1926fe0983d8fe5.jpg&q;,&q;upperBodyPhoto&q;:null,&q;displayCoursePrefix&q;:&q;gwy&q;,&q;teacherStat&q;:{&q;teacherId&q;:4985,&q;episodeCount&q;:1047,&q;scoreCount&q;:168734,&q;avgScore&q;:9.822015717045764,&q;fiveGradeAvgScore&q;:4.91,&q;updateTime&q;:1773617111112},&q;auditionEpisode&q;:{&q;episodeTitle&q;:&q;个人展示课&q;,&q;episodeVideoUrl&q;:&q;https://vod.fbstatic.cn/22e9ceb2vodbj1251001446/4fcec99d3560136621446406348/s1YvcVvNImkA.mp4?t=f2a4b300&a;us=4070880000&a;sign=d2e4f33d8224f412afae2f9043b0e59e&q;},&q;memberOfCPC&q;:false,&q;tags&q;:null},{&q;id&q;:2751,&q;userId&q;:45636740,&q;name&q;:&q;赵雯雯&q;,&q;brief&q;:&q;粉笔判断优质教师&q;,&q;desc&q;:&q;粉笔判断优质教师，研究生学历。 \n7年公考授课经验，长期从事判断推理模块的教研和教学工作，培训学员100余万人次，累计评分30余万人次。教学经验丰富，教学思路严谨。知识积累丰富，注重干货分享，带领学员触类旁通，举一反三。性格耐心细致，善于启发学员思考，调动学员积极性。&q;,&q;avatar&q;:&q;172985384e2340f.jpg&q;,&q;upperBodyPhoto&q;:null,&q;displayCoursePrefix&q;:&q;gwy&q;,&q;teacherStat&q;:{&q;teacherId&q;:2751,&q;episodeCount&q;:1608,&q;scoreCount&q;:375104,&q;avgScore&q;:9.798434567479958,&q;fiveGradeAvgScore&q;:4.9,&q;updateTime&q;:1773622798908},&q;auditionEpisode&q;:{&q;episodeTitle&q;:&q;个人展示课&q;,&q;episodeVideoUrl&q;:&q;https://vod.fbstatic.cn/22e9ceb2vodbj1251001446/a8b876473560136621447941398/E0VnY2xwtX4A.mp4?t=f2a4b300&a;us=4070880000&a;sign=2e8dcbb103e86b718886d405098fcb4f&q;},&q;memberOfCPC&q;:false,&q;tags&q;:null},{&q;id&q;:2567,&q;userId&q;:43307158,&q;name&q;:&q;艾小丁&q;,&q;brief&q;:&q;粉笔面试研究院成员、高级面试讲师&q;,&q;desc&q;:&q;8年公考面试授课经验，粉笔大区面试教学教研负责人，主要承担国省考理论大课及各类线上公开课。有过多次面试高分实战经历。曾设计并主持多次粉笔面试老师培训会议，培训面试师资数千人。 \n艾小丁老师有多年一线授课经历与面试教研经验，灵活风趣，课堂氛围轻松。始终秉持“千人千面”的教学理念，善于引导学员理解面试的底层逻辑，发掘自身特点，从自己擅长的角度实现高效提升，成果显著。&q;,&q;avatar&q;:&q;19b0cf4f21e691e.jpg&q;,&q;upperBodyPhoto&q;:null,&q;displayCoursePrefix&q;:&q;gwy&q;,&q;teacherStat&q;:{&q;teacherId&q;:2567,&q;episodeCount&q;:1140,&q;scoreCount&q;:39146,&q;avgScore&q;:9.869054309508025,&q;fiveGradeAvgScore&q;:4.93,&q;updateTime&q;:1773589055187},&q;auditionEpisode&q;:{&q;episodeTitle&q;:&q;个人展示课&q;,&q;episodeVideoUrl&q;:&q;https://vod.fbstatic.cn/22e9ceb2vodbj1251001446/365026ea3270835013757549961/7azwde9iqIAA.mp4?t=f2a4b300&a;us=4070880000&a;sign=7ae333696ea68a3be68e8952550ff6ef&q;},&q;memberOfCPC&q;:false,&q;tags&q;:null},{&q;id&q;:14952,&q;userId&q;:48263990,&q;name&q;:&q;赵博&q;,&q;brief&q;:&q;粉笔面试研究院成员、高级面试讲师&q;,&q;desc&q;:&q;8年公考面试授课经验，粉笔大区面试教学教研负责人，面试直播工作负责人，粉笔面试教材主编，主要承担粉笔国省考理论大课及各类线上公开课与直播工作，参与过多省市、多部门面试教材的教研与题本的研发设计工作。曾任高校讲师，并受邀担任华语网辩联赛评委。 \n赵博老师多年深耕于教学一线，具备出众的表达能力与严谨的逻辑思维，深谙面试作答之道，对内容思考以及语言表达都有着非常独到的见解。授课风格严谨却不失幽默，善于通过启发式教学，激发学员自主思考的能力。不仅能帮助学员迅速掌握应试技巧，更能在授课中传递正确的三观与为人处世的态度。&q;,&q;avatar&q;:&q;19b4f428479021e.jpg&q;,&q;upperBodyPhoto&q;:null,&q;displayCoursePrefix&q;:&q;gwy&q;,&q;teacherStat&q;:{&q;teacherId&q;:14952,&q;episodeCount&q;:1056,&q;scoreCount&q;:31594,&q;avgScore&q;:9.872444134962334,&q;fiveGradeAvgScore&q;:4.94,&q;updateTime&q;:1773622989376},&q;auditionEpisode&q;:{&q;episodeTitle&q;:&q;个人展示课&q;,&q;episodeVideoUrl&q;:&q;https://vod.fbstatic.cn/22e9ceb2vodbj1251001446/3d4dee423270835013757846611/qL4f3aEL8qMA.mp4?t=f2a4b300&a;us=4070880000&a;sign=5b7cf4d0d4b9823356332971b3f930b7&q;},&q;memberOfCPC&q;:false,&q;tags&q;:null},{&q;id&q;:1182,&q;userId&q;:29881941,&q;name&q;:&q;于林&q;,&q;brief&q;:&q;粉笔面试研究院成员、高级面试讲师&q;,&q;desc&q;:&q;粉笔公考面试优质讲师\n7年公考面试授课经验，粉笔大区面试教学教研负责人，主要承担国省考线上理论和各类型公开课授课，参与过多省市、多部门面试教材的教研、题本研发、课程设计和面试师资培训工作，曾于体制内任职，工作经验丰富，可给予学员更多的工作实务教学内容。\n于林老师拥有多年一线授课经历与面试教研经验，始终以“师者，传道授业解惑也”为人生信条，通过传道，向学生们传授道理，使学生正直阳光，积极向上;通过授业，耐心细致地为学员讲授面试的内容，由表及里、深入浅出;通过解惑，一针见血找到学生问题，并指明解决问题的方法，使学员\n茅塞顿开，深受学员喜欢。&q;,&q;avatar&q;:&q;171ee6f96c2ae72.jpg&q;,&q;upperBodyPhoto&q;:null,&q;displayCoursePrefix&q;:&q;gwy&q;,&q;teacherStat&q;:{&q;teacherId&q;:1182,&q;episodeCount&q;:1214,&q;scoreCount&q;:28583,&q;avgScore&q;:9.872161774481334,&q;fiveGradeAvgScore&q;:4.94,&q;updateTime&q;:1773595085305},&q;auditionEpisode&q;:{&q;episodeTitle&q;:&q;个人展示课&q;,&q;episodeVideoUrl&q;:&q;https://vod.fbstatic.cn/22e9ceb2vodbj1251001446/9b6cc38f243791580417850235/f0.mp4?t=f2a4b300&a;us=4070880000&a;sign=5d693678e28fe7d30da2599c79d22785&q;},&q;memberOfCPC&q;:false,&q;tags&q;:null},{&q;id&q;:1495,&q;userId&q;:39321688,&q;name&q;:&q;安妮&q;,&q;brief&q;:&q;粉笔言语优质教师&q;,&q;desc&q;:&q;粉笔言语优质教师，8年公考授课经验，学员评分高达4.9分。具有扎实的专业理论功底，对言语理解与表达科目有深入研究，授课思路清晰，教学态度严谨，善于启发学员思考，注重实用性。&q;,&q;avatar&q;:&q;172024769c1cb78.jpg&q;,&q;upperBodyPhoto&q;:null,&q;displayCoursePrefix&q;:&q;gwy&q;,&q;teacherStat&q;:{&q;teacherId&q;:1495,&q;episodeCount&q;:1383,&q;scoreCount&q;:282534,&q;avgScore&q;:9.793115164900474,&q;fiveGradeAvgScore&q;:4.9,&q;updateTime&q;:1773622788894},&q;auditionEpisode&q;:{&q;episodeTitle&q;:&q;个人展示课&q;,&q;episodeVideoUrl&q;:&q;https://vod.fbstatic.cn/22e9ceb2vodbj1251001446/98ad3b1d3560136621447282066/PCbRTZsekmwA.mp4?t=f2a4b300&a;us=4070880000&a;sign=398797f694b71533e6aca966a07b51b0&q;},&q;memberOfCPC&q;:false,&q;tags&q;:null},{&q;id&q;:4345,&q;userId&q;:49646700,&q;name&q;:&q;马影&q;,&q;brief&q;:&q;粉笔面试研究院成员、高级面试讲师&q;,&q;desc&q;:&q;       7 年公考面试授课经验，粉笔华南大区面试教学教研负责人，主要承担国省考理论大课及各类线上公开课。曾任粉笔面试培训负责人，作为主培训师培训面试师资数千人。 \n       马影老师多年深耕授课一线，面试教学教研经验丰富，授课逻辑清晰，讲解言简意赅，始终相信“复杂的不是问题，而是看问题的眼睛，好老师应该把复杂的知识简单化，而不是把简单的知识复杂化。”&q;,&q;avatar&q;:&q;171831fc08abd68.png&q;,&q;upperBodyPhoto&q;:null,&q;displayCoursePrefix&q;:&q;gwy&q;,&q;teacherStat&q;:{&q;teacherId&q;:4345,&q;episodeCount&q;:772,&q;scoreCount&q;:27886,&q;avgScore&q;:9.866456286308543,&q;fiveGradeAvgScore&q;:4.93,&q;updateTime&q;:1773621596496},&q;auditionEpisode&q;:{&q;episodeTitle&q;:&q;个人展示课&q;,&q;episodeVideoUrl&q;:&q;https://vod.fbstatic.cn/22e9ceb2vodbj1251001446/2d1f97403270835013757169233/fVNXhL9Rzi8A.mp4?t=f2a4b300&a;us=4070880000&a;sign=c498a50a2a0932f505e4290200e585b7&q;},&q;memberOfCPC&q;:false,&q;tags&q;:null},{&q;id&q;:3256,&q;userId&q;:928041,&q;name&q;:&q;黎依依&q;,&q;brief&q;:&q;粉笔申论优质教师&q;,&q;desc&q;:&q;粉笔申论优质教师，985硕士，5年公职经历，8年公考一线授课经验。授课逻辑清晰，内容饱满丰富，对热点把控精准。长期致力于公务员考试研究，善于总结做题规律，将实战与技巧相结合，耐心细致，注重与学员互动。&q;,&q;avatar&q;:&q;172138a07d74984.jpg&q;,&q;upperBodyPhoto&q;:null,&q;displayCoursePrefix&q;:&q;gwy&q;,&q;teacherStat&q;:{&q;teacherId&q;:3256,&q;episodeCount&q;:1141,&q;scoreCount&q;:128096,&q;avgScore&q;:9.810079940044966,&q;fiveGradeAvgScore&q;:4.91,&q;updateTime&q;:1773582589511},&q;auditionEpisode&q;:{&q;episodeTitle&q;:&q;个人展示课&q;,&q;episodeVideoUrl&q;:&q;https://vod.fbstatic.cn/22e9ceb2vodbj1251001446/9cecb7de3560136621447425653/n1sw1bGYVKAA.mp4?t=f2a4b300&a;us=4070880000&a;sign=94e5690d0098af54811051956a5c5988&q;},&q;memberOfCPC&q;:false,&q;tags&q;:null},{&q;id&q;:13823,&q;userId&q;:58626581,&q;name&q;:&q;王微&q;,&q;brief&q;:&q;粉笔面试优质教师&q;,&q;desc&q;:&q;       粉笔面试优质教师\n       大区面试教学教研负责人，粉笔面试大课骨干教师，人气面试讲师，高级培训师，直播工作核心教师，曾任某线上公益就业平台主持人。\n8年公考面试授课经验，累计授课时长15000h+，授课学员100000+，累计培训师资5000+；主要承担国省考理论大课、各类线上公开课及平台直播等授课任务，并参与组织多次授课研讨、图书撰写、解析编撰等工作。 授课亲切自然，富有激情，逻辑清晰，讲授内容通俗易懂接地气，深度高度两相宜。深谙面试学习重点难点，善于抓取学员问题并逐个击破，引导学员回归面试本质，让思维不断发散，用真情打动考官！       \n       粉笔教研教学团队成员，参与粉笔多省的教学研发工作，受邀出镜录制面试真题示范答题 22 道，并在粉笔题库进行展示。参加 22 次粉笔面试授课研讨会议，全面把握公考面试命题趋势及最新考情，积累丰富面试知识。参加 48 次粉笔面试教研活动，分享授课经验心得，助力粉笔面试理论研发升级。​&q;,&q;avatar&q;:&q;173998e78802a13.jpg&q;,&q;upperBodyPhoto&q;:null,&q;displayCoursePrefix&q;:&q;gwy&q;,&q;teacherStat&q;:{&q;teacherId&q;:13823,&q;episodeCount&q;:642,&q;scoreCount&q;:30161,&q;avgScore&q;:9.86107887669507,&q;fiveGradeAvgScore&q;:4.93,&q;updateTime&q;:1773574398582},&q;auditionEpisode&q;:{&q;episodeTitle&q;:&q;个人展示课&q;,&q;episodeVideoUrl&q;:&q;https://vod.fbstatic.cn/22e9ceb2vodbj1251001446/ad4d45cf243791580414529514/f0.mp4?t=f2a4b300&a;us=4070880000&a;sign=b8b6ba805911da7e41d00c7ce19dfacd&q;},&q;memberOfCPC&q;:false,&q;tags&q;:null},{&q;id&q;:1875,&q;userId&q;:41410898,&q;name&q;:&q;马婉卿&q;,&q;brief&q;:&q;粉笔面试研究院成员、高级面试讲师&q;,&q;desc&q;:&q;       9年授课经验，累计授课时长超过10000小时，培训师资千余人。长期致力于公务员考试研究，曾有基层的工作经验，对试题有深刻的把握和独到的见解。授课风趣幽默，注重因材施教，打造个性化答题亮点，相信最好的相遇是能成就彼此的人生。 \n       参与组织各类授课研讨会议，教研讨论和题本研发等活动，曾获粉笔“卓越教师”称号，著有《素材集萃30例》等图书。&q;,&q;avatar&q;:&q;17d466e42ad2b67.jpg&q;,&q;upperBodyPhoto&q;:null,&q;displayCoursePrefix&q;:&q;gwy&q;,&q;teacherStat&q;:{&q;teacherId&q;:1875,&q;episodeCount&q;:1464,&q;scoreCount&q;:27739,&q;avgScore&q;:9.859980532823823,&q;fiveGradeAvgScore&q;:4.93,&q;updateTime&q;:1773585462832},&q;auditionEpisode&q;:{&q;episodeTitle&q;:&q;个人展示课&q;,&q;episodeVideoUrl&q;:&q;https://vod.fbstatic.cn/22e9ceb2vodbj1251001446/d5f9fc9b243791580578137376/f0.mp4?t=f2a4b300&a;us=4070880000&a;sign=2948f145c310a3e6cfb2e4c2252e43ee&q;},&q;memberOfCPC&q;:false,&q;tags&q;:null},{&q;id&q;:6696,&q;userId&q;:42331308,&q;name&q;:&q;安岚&q;,&q;brief&q;:&q;粉笔面试研究院成员、高级面试讲师&q;,&q;desc&q;:&q;粉笔面试优质教师，粉笔面试研究院成员、大区面试教学教研负责人\n5年公考面试授课经验，累计授课时长超过10000小时，线下面试授课遍及全国，熟悉各地面试考情，多班级通过率超过90%，学员高分突破95。粉笔面试大课、直播工作带头人，主要承担国省考面试理论大课、线上公开课、线上直播等工作，注重对各类热点的深挖与教研，致力于帮助学生提升答题思维的深度和广度。具备社会学等相关专业背景，有过多次面试实战高分经历，善于在技巧总结和经验分享中帮助考生挖掘自身潜力、遇见更好的自己！\n参与组织各类授课研讨会议和教研活动，负责面试教研、题本研发和师资培训等工作，包括粉笔面试理论研发、晚课资料及反模板教学配套资料撰写、粉笔面试图书撰写等。&q;,&q;avatar&q;:&q;186c5ba0fd07efb.jpg&q;,&q;upperBodyPhoto&q;:null,&q;displayCoursePrefix&q;:&q;gwy&q;,&q;teacherStat&q;:{&q;teacherId&q;:6696,&q;episodeCount&q;:982,&q;scoreCount&q;:19865,&q;avgScore&q;:9.87253964258746,&q;fiveGradeAvgScore&q;:4.94,&q;updateTime&q;:1773582951352},&q;auditionEpisode&q;:{&q;episodeTitle&q;:&q;个人展示课&q;,&q;episodeVideoUrl&q;:&q;https://vod.fbstatic.cn/22e9ceb2vodbj1251001446/2bad8d4a243791580022478007/f0.mp4?t=f2a4b300&a;us=4070880000&a;sign=9ac26cbb569268517bd25a6572b63d7a&q;},&q;memberOfCPC&q;:false,&q;tags&q;:null},{&q;id&q;:920,&q;userId&q;:39500774,&q;name&q;:&q;喻晓萌&q;,&q;brief&q;:&q;粉笔面试优质教师&q;,&q;desc&q;:&q;       粉笔面试优质教师。\n       研究生学历，2016年从事公考培训工作，耐心细致，把握学员个性化特点，对待课程一丝不苟，熟练掌握各种面试作答技巧，善于针对学员自身实际进行针对性讲解，帮助学生快速提高。\n       粉笔面试教研教学团队成员。受邀参与命制面试模拟预测题目，国省考面试真题解析撰写，并收录至粉笔面试题库；受邀录制面试真题示范答题，并在粉笔题库进行展示；受邀参与《粉笔晨读》等图书编辑撰写工作；多次参加粉笔面试授课研讨会议，全面把握公考面试命题趋势及最新考情，积累丰富面试知识。&q;,&q;avatar&q;:&q;17278f01044bc53.jpg&q;,&q;upperBodyPhoto&q;:null,&q;displayCoursePrefix&q;:&q;gwy&q;,&q;teacherStat&q;:{&q;teacherId&q;:920,&q;episodeCount&q;:845,&q;scoreCount&q;:48893,&q;avgScore&q;:9.834454829934716,&q;fiveGradeAvgScore&q;:4.92,&q;updateTime&q;:1773621746645},&q;auditionEpisode&q;:{&q;episodeTitle&q;:&q;个人展示课&q;,&q;episodeVideoUrl&q;:&q;https://vod.fbstatic.cn/22e9ceb2vodbj1251001446/2f7d0f623270835014227591684/vT2OcAKITnAA.mp4?t=f2a4b300&a;us=4070880000&a;sign=fe5de24272ef3e7c40d4dac1267fe226&q;},&q;memberOfCPC&q;:false,&q;tags&q;:null},{&q;id&q;:865,&q;userId&q;:37392799,&q;name&q;:&q;程菲&q;,&q;brief&q;:&q;粉笔公考面试优质讲师&q;,&q;desc&q;:&q;       粉笔面试优质老师。\n       始终以生动有趣、激发学生思维为教学宗旨，课堂氛围轻松融洽，广受学员好评。授课重点突出，能够及时总结拓展，讲解语言通俗易懂。擅长引导学生自主思考，善于根据学生的不同情况和需求，制定合适的教学计划，进行个性化指导，助力学员上岸。&q;,&q;avatar&q;:&q;1717beafeb6ab50.jpg&q;,&q;upperBodyPhoto&q;:null,&q;displayCoursePrefix&q;:&q;gwy&q;,&q;teacherStat&q;:{&q;teacherId&q;:865,&q;episodeCount&q;:815,&q;scoreCount&q;:49181,&q;avgScore&q;:9.831072975336003,&q;fiveGradeAvgScore&q;:4.92,&q;updateTime&q;:1773620424465},&q;auditionEpisode&q;:{&q;episodeTitle&q;:&q;个人展示课&q;,&q;episodeVideoUrl&q;:&q;https://vod.fbstatic.cn/22e9ceb2vodbj1251001446/3dc414923270835014652217041/ZWqirDjpBC8A.mp4?t=f2a4b300&a;us=4070880000&a;sign=514bdd00f5985bafec1a8312d5705e84&q;},&q;memberOfCPC&q;:false,&q;tags&q;:null},{&q;id&q;:4883,&q;userId&q;:43833662,&q;name&q;:&q;马梦伟&q;,&q;brief&q;:&q;粉笔公考面试优质讲师&q;,&q;desc&q;:&q;8年授课经验，培训部老师，主要负责公司内部师资面试培训、强化、授课后督课工作，面试基础夯实、应用灵活。曾多次参加省考面试并取得优异成绩，熟悉考官喜好、考试变化，授课中既注重基础也关注反模板反套路，帮助同学掌握考官思维。性格细心有耐心，认真负责，内部培训课程评分4.9+，培训师资千人，带班成果突出，多次实现班级高通过率。&q;,&q;avatar&q;:&q;1963c6cd559a7e9.jpg&q;,&q;upperBodyPhoto&q;:null,&q;displayCoursePrefix&q;:&q;gwy&q;,&q;teacherStat&q;:{&q;teacherId&q;:4883,&q;episodeCount&q;:973,&q;scoreCount&q;:5069,&q;avgScore&q;:9.92779640954824,&q;fiveGradeAvgScore&q;:4.96,&q;updateTime&q;:1773482740331},&q;auditionEpisode&q;:{&q;episodeTitle&q;:&q;个人展示课&q;,&q;episodeVideoUrl&q;:&q;https://vod.fbstatic.cn/22e9ceb2vodbj1251001446/9a640fe01397757910062623106/8mo7xp5sYGAA.mp4?t=f2a4b300&a;us=4070880000&a;sign=741fa06bad1b4157c3a9877ec38bc83d&q;},&q;memberOfCPC&q;:false,&q;tags&q;:null},{&q;id&q;:6391,&q;userId&q;:62196424,&q;name&q;:&q;王诗佳&q;,&q;brief&q;:&q;粉笔面试研究院成员、高级面试讲师&q;,&q;desc&q;:&q;       8年公考面试授课经验，粉笔吉林面试教学教研负责人，主要承担国省考理论大课及各类线上公开课。参与过多省市、多部门面试教材的教研与题本研发设计工作。多次参与粉笔面试师资的培训、考核工作。 \n       王诗佳老师拥有多年一线授课与面试教研经验，授课细致、严谨，注重因材施教，善于通过细致地点评和清晰地讲解帮助学生找到个性化问题，实现突破性提升。注重个人提升，始终秉承“终身学习”的理念，对面试教学有独到见解。&q;,&q;avatar&q;:&q;171537158838eb0.png&q;,&q;upperBodyPhoto&q;:null,&q;displayCoursePrefix&q;:&q;gwy&q;,&q;teacherStat&q;:{&q;teacherId&q;:6391,&q;episodeCount&q;:917,&q;scoreCount&q;:26262,&q;avgScore&q;:9.847536364328683,&q;fiveGradeAvgScore&q;:4.92,&q;updateTime&q;:1773622969306},&q;auditionEpisode&q;:{&q;episodeTitle&q;:&q;个人展示课&q;,&q;episodeVideoUrl&q;:&q;https://vod.fbstatic.cn/22e9ceb2vodbj1251001446/dcf7d575243791580578434460/f0.mp4?t=f2a4b300&a;us=4070880000&a;sign=5d3639621b61af1c1b43508312c707e7&q;},&q;memberOfCPC&q;:false,&q;tags&q;:null},{&q;id&q;:859,&q;userId&q;:29155757,&q;name&q;:&q;安悦心&q;,&q;brief&q;:&q;粉笔面试优质教师&q;,&q;desc&q;:&q;       粉笔面试优质教师。\n       多年公考一线授课经验，授课风格活泼，思路清晰，深入浅出，耐心细致，擅长总结面试中的各种方法技巧。注重结合时政热点进行教学，实现理论实践相结合，提倡个性化教学，致力于帮助学员扬长避短，一举夺魁。\n       粉笔面试教研教学团队成员。受邀多次参与命制面试模拟预测题目，解析国省考面试真题，并收录粉笔面试题库。受邀参与录制粉笔智慧教室面试真题示范答题，并在粉笔题库进行展示。受邀参与《粉笔晨读》等粉笔精品图书编辑撰写工作。多次参与粉笔组织的各类授课能提升会议和面试教研活动，共同助力粉笔面试理论的研发与升级。&q;,&q;avatar&q;:&q;1718b0b0488d2f6.jpg&q;,&q;upperBodyPhoto&q;:null,&q;displayCoursePrefix&q;:&q;gwy&q;,&q;teacherStat&q;:{&q;teacherId&q;:859,&q;episodeCount&q;:1040,&q;scoreCount&q;:19378,&q;avgScore&q;:9.852100319950452,&q;fiveGradeAvgScore&q;:4.93,&q;updateTime&q;:1773622357748},&q;auditionEpisode&q;:{&q;episodeTitle&q;:&q;个人展示课&q;,&q;episodeVideoUrl&q;:&q;https://vod.fbstatic.cn/22e9ceb2vodbj1251001446/db8342923270835014226291114/LCTAKY82AdkA.mp4?t=f2a4b300&a;us=4070880000&a;sign=feecc878df108d966c4ebc42645b751b&q;},&q;memberOfCPC&q;:false,&q;tags&q;:null},{&q;id&q;:4631,&q;userId&q;:53050352,&q;name&q;:&q;李玟冰&q;,&q;brief&q;:&q;粉笔言语优质教师&q;,&q;desc&q;:&q;粉笔言语优质教师，7年公考培训经验，坚信“因材施教、寓教于乐”的教学理念。言语专业功底扎实，授课逻辑清晰，善于引发学生思考，注重课程实用性，对题型有独特的理解，梳理出实用性的言语解题思路，擅长“深入浅出”的授课风格。&q;,&q;avatar&q;:&q;171a64837d3cc60.jpg&q;,&q;upperBodyPhoto&q;:null,&q;displayCoursePrefix&q;:&q;gwy&q;,&q;teacherStat&q;:{&q;teacherId&q;:4631,&q;episodeCount&q;:1337,&q;scoreCount&q;:188687,&q;avgScore&q;:9.761679394976884,&q;fiveGradeAvgScore&q;:4.88,&q;updateTime&q;:1773621606522},&q;auditionEpisode&q;:{&q;episodeTitle&q;:&q;个人展示课&q;,&q;episodeVideoUrl&q;:&q;https://vod.fbstatic.cn/22e9ceb2vodbj1251001446/e2d793203560136621448119609/9yfzlYT6RAgA.mp4?t=f2a4b300&a;us=4070880000&a;sign=9dde19cf86d5d7cc4cd79b97f111aab8&q;},&q;memberOfCPC&q;:false,&q;tags&q;:null},{&q;id&q;:29329,&q;userId&q;:59984840,&q;name&q;:&q;婉君&q;,&q;brief&q;:&q;粉笔公考常识、公安优质讲师&q;,&q;desc&q;:&q;       粉笔常识、公安优质老师。\n       性格耐心细致，善于把握学员个性化特点，因材施教，认真负责，对待课程一丝不苟。讲课生动形象，机智诙谐，听课体验好，学员可以在轻松愉快的氛围中学习，跟着老师节奏主动思考。老师同时注重“反模板”教学，助力学员走出答题模板与误区。&q;,&q;avatar&q;:&q;17cfe442bf3a975.jpg&q;,&q;upperBodyPhoto&q;:null,&q;displayCoursePrefix&q;:&q;gwy&q;,&q;teacherStat&q;:{&q;teacherId&q;:29329,&q;episodeCount&q;:300,&q;scoreCount&q;:21185,&q;avgScore&q;:9.837715364644751,&q;fiveGradeAvgScore&q;:4.92,&q;updateTime&q;:1773579682515},&q;auditionEpisode&q;:null,&q;memberOfCPC&q;:false,&q;tags&q;:null},{&q;id&q;:4432,&q;userId&q;:15393595,&q;name&q;:&q;唐圣楠&q;,&q;brief&q;:&q;粉笔面试研究院成员、高级面试讲师&q;,&q;desc&q;:&q;2年公务员工作经验，7年公考面试授课经验，粉笔卓越教师。\n唐圣楠老师有面试高分实战经历，熟悉政府各项工作。7年来深耕于面试教学一线，线下精品小班和线上千人大课兼顾，从业7年间累计授课人次超过 5000 人，授课时长超过 4000 小时，善于挖掘考生个人优势，突破面试瓶颈。同时是粉笔培训项目负责人，粉笔教学教研团队成员。每年受邀撰写省考面试高频考点和真题解析，主导撰写《真题精练50题》等图书，深度组织参与结构化和结构化小组面试理论的研发升级。&q;,&q;avatar&q;:&q;172984dddabdf3e.jpg&q;,&q;upperBodyPhoto&q;:null,&q;displayCoursePrefix&q;:&q;gwy&q;,&q;teacherStat&q;:{&q;teacherId&q;:4432,&q;episodeCount&q;:1180,&q;scoreCount&q;:9935,&q;avgScore&q;:9.871565173628591,&q;fiveGradeAvgScore&q;:4.94,&q;updateTime&q;:1773615380133},&q;auditionEpisode&q;:{&q;episodeTitle&q;:&q;个人展示课&q;,&q;episodeVideoUrl&q;:&q;https://vod.fbstatic.cn/22e9ceb2vodbj1251001446/e79772521397757910063658844/07JN4CCRa7UA.mp4?t=f2a4b300&a;us=4070880000&a;sign=aadad9d80d32fd5bc0a9f57128cdc699&q;},&q;memberOfCPC&q;:false,&q;tags&q;:null},{&q;id&q;:4791,&q;userId&q;:51346254,&q;name&q;:&q;林秋莹&q;,&q;brief&q;:&q;粉笔面试研究院成员、高级面试讲师&q;,&q;desc&q;:&q;8年公考面试授课经验，粉笔大区面试教学教研负责人，主要承担面试各类培训的策划组织、授课培训工作，同时承担国省考各类线上公开课，粉笔培训部项目负责人，获得粉笔”卓越教师”称号。 \n林秋莹老师凭借多年一线授课、培训、研发工作经验，掌握大量的面试方法技巧、干货知识素材与政府思维逻辑，深谙面试作答之道，能够把海量备考内容转化成精简的技巧内容。深入浅出，举一反三答出反套路有深度的内容，让学生高效备考，少走弯路。同时深度结合每位学生的特点，打造个性化，让学员在课堂中展现自我风采，轻松掌握面试。&q;,&q;avatar&q;:&q;1720cd00cce8f13.jpg&q;,&q;upperBodyPhoto&q;:null,&q;displayCoursePrefix&q;:&q;gwy&q;,&q;teacherStat&q;:{&q;teacherId&q;:4791,&q;episodeCount&q;:826,&q;scoreCount&q;:11458,&q;avgScore&q;:9.864025135276655,&q;fiveGradeAvgScore&q;:4.93,&q;updateTime&q;:1773623280272},&q;auditionEpisode&q;:{&q;episodeTitle&q;:&q;个人展示课&q;,&q;episodeVideoUrl&q;:&q;https://vod.fbstatic.cn/22e9ceb2vodbj1251001446/f6a7f0f73270835013753033481/r57CET8eRCMA.mp4?t=f2a4b300&a;us=4070880000&a;sign=ba11551c01f5b7967383de833b064957&q;},&q;memberOfCPC&q;:false,&q;tags&q;:null},{&q;id&q;:5813,&q;userId&q;:21512867,&q;name&q;:&q;郑小书&q;,&q;brief&q;:&q;粉笔面试优质教师&q;,&q;desc&q;:&q;       粉笔面试优质教师。\n       曾有过丰富公职机关经验，熟悉政府各项工作，对机关单位制度流程较为了解，可以有效帮助学员建立起政府思维。2018年从事公考面试培训工作以来，授课人数超过3000人，授课时长超过2000小时，带班成果突出，曾经创造过100%通过率带班成绩。授课风格亲切自然、娓娓道来，善于与学员在平等、协作、和谐的气氛下，进行双向交流，帮助学员吸收理解知识。\n       粉笔面试教研教学团队成员。多次受邀参与命制面试模拟预测题，并收录粉笔面试题库。参与撰写省情专项、部门专项、面试会员晨读等多项图书教研工作。多次承担基础理论课、热点30分、两会热点分享、刷题课等粉笔公开课授课。&q;,&q;avatar&q;:&q;1717d7c323da4f2.jpg&q;,&q;upperBodyPhoto&q;:null,&q;displayCoursePrefix&q;:&q;gwy&q;,&q;teacherStat&q;:{&q;teacherId&q;:5813,&q;episodeCount&q;:1123,&q;scoreCount&q;:12118,&q;avgScore&q;:9.860042911371524,&q;fiveGradeAvgScore&q;:4.93,&q;updateTime&q;:1773571899660},&q;auditionEpisode&q;:{&q;episodeTitle&q;:&q;个人展示课&q;,&q;episodeVideoUrl&q;:&q;https://vod.fbstatic.cn/22e9ceb2vodbj1251001446/e21863953270835014226535323/zAt6cpf9Fb8A.mp4?t=f2a4b300&a;us=4070880000&a;sign=cbeded212432a1f9637d757b926018ac&q;},&q;memberOfCPC&q;:false,&q;tags&q;:null},{&q;id&q;:6723,&q;userId&q;:61346379,&q;name&q;:&q;狄小汐&q;,&q;brief&q;:&q; 粉笔常识、公安优质讲师&q;,&q;desc&q;:&q;       粉笔常识、公安优质老师。\n       性格耐心细致，善于把握学员个性化特点，因材施教，认真负责，对待课程一丝不苟。讲课生动形象，机智诙谐，听课体验好，学员可以在轻松愉快的氛围中学习，跟着老师节奏主动思考。老师同时注重“反模板”教学，助力学员走出答题模板与误区。&q;,&q;avatar&q;:&q;17133d5e50beccd.jpg&q;,&q;upperBodyPhoto&q;:null,&q;displayCoursePrefix&q;:&q;gwy&q;,&q;teacherStat&q;:{&q;teacherId&q;:6723,&q;episodeCount&q;:991,&q;scoreCount&q;:58830,&q;avgScore&q;:9.792180860105388,&q;fiveGradeAvgScore&q;:4.9,&q;updateTime&q;:1773623380488},&q;auditionEpisode&q;:null,&q;memberOfCPC&q;:false,&q;tags&q;:null},{&q;id&q;:13635,&q;userId&q;:66803519,&q;name&q;:&q;张易也&q;,&q;brief&q;:&q;粉笔判断、综应优质教师&q;,&q;desc&q;:&q;粉笔判断、综应优质教师，985高校毕业，6年公考培训经验，授课经验丰富，服务学员众多。粉笔系统评分4.9分，对于判断学科有着精准细致的把握，授课风格严肃而不失活泼，对学生高标准严要求，对课堂有着精准的安排和把握，善于用简单直白的话语解释复杂艰深的逻辑关系。&q;,&q;avatar&q;:&q;1928a7c056a5334.jpg&q;,&q;upperBodyPhoto&q;:null,&q;displayCoursePrefix&q;:&q;gwy&q;,&q;teacherStat&q;:{&q;teacherId&q;:13635,&q;episodeCount&q;:1088,&q;scoreCount&q;:3676,&q;avgScore&q;:9.914581066376458,&q;fiveGradeAvgScore&q;:4.96,&q;updateTime&q;:1773621696609},&q;auditionEpisode&q;:{&q;episodeTitle&q;:&q;个人展示课&q;,&q;episodeVideoUrl&q;:&q;https://vod.fbstatic.cn/22e9ceb2vodbj1251001446/8481f4d63560136621457221164/fxynwMS1SSwA.mp4?t=f2a4b300&a;us=4070880000&a;sign=f90639d1c7a1c1d931bf99c7977de236&q;},&q;memberOfCPC&q;:false,&q;tags&q;:null},{&q;id&q;:12252,&q;userId&q;:60895825,&q;name&q;:&q;朱严&q;,&q;brief&q;:&q;粉笔面试研究院成员、高级面试讲师&q;,&q;desc&q;:&q;7年公考面试授课经验，粉笔培训部项目负责人之一，大区面试教学教研负责人。累计授课时长超过2000小时，负责培训师资2000+，粉笔客户端评分4.9分（满分5分）。主要负责师资面试能力提升的培训工作和一线教学教研工作，善于把自己在一线教学的感悟和实情融入日常师资的培训中，做到融会贯通。有过面试实战高分经历，曾在国考税务考试中从笔试压线进面，逆袭至总分第2名（岗位招3人）。 \n朱严老师教学培训严谨，能够聚焦不同地区的特色，准确把握面试学习的发力方向，授课力求精准化。授课耐心细致，注重因材施教，能够充分发挥学员的创造性。点评指导一针见血，帮助学员明确改进方向，让学员在面试学习中有更多的收获感，助力学员上岸。&q;,&q;avatar&q;:&q;1730e510528a227.jpg&q;,&q;upperBodyPhoto&q;:null,&q;displayCoursePrefix&q;:&q;gwy&q;,&q;teacherStat&q;:{&q;teacherId&q;:12252,&q;episodeCount&q;:492,&q;scoreCount&q;:7803,&q;avgScore&q;:9.870306292451621,&q;fiveGradeAvgScore&q;:4.94,&q;updateTime&q;:1773580246258},&q;auditionEpisode&q;:{&q;episodeTitle&q;:&q;个人展示课&q;,&q;episodeVideoUrl&q;:&q;https://vod.fbstatic.cn/22e9ceb2vodbj1251001446/623149aa1253642695625689240/CLuJL0kCqgQA.mp4?t=f2a4b300&a;us=4070880000&a;sign=39a2dbd4e450b7e9dc3d314f8957a992&q;},&q;memberOfCPC&q;:false,&q;tags&q;:null},{&q;id&q;:3184,&q;userId&q;:16570049,&q;name&q;:&q;赵公梓&q;,&q;brief&q;:&q;粉笔面试优质教师&q;,&q;desc&q;:&q;       粉笔面试优质教师。\n       2017年从事公考教学工作，授课耐心细致、严谨认真，在给予指导的同时，帮助学生调整心态积极备考。教学注重系统思维，带领学生以清晰的逻辑思路直面问题；授课内容丰富，为学生提供海量答题内容参考；倡导个性化教学，帮助学生短期内形成特色答题风格。\n       粉笔面试教研教学团队成员。受邀参与命制面试模拟预测题目，国省考面试真题解析撰写，并收录至粉笔面试题库；受邀录制面试真题示范答题，并在粉笔题库进行展示；受邀参与《粉笔晨读》等图书编辑撰写工作；多次参与粉笔组织的各类授课研讨会议和面试教研活动，共同助力粉笔面试理论的研发与升级。&q;,&q;avatar&q;:&q;171861d7c8d1831.jpg&q;,&q;upperBodyPhoto&q;:null,&q;displayCoursePrefix&q;:&q;gwy&q;,&q;teacherStat&q;:{&q;teacherId&q;:3184,&q;episodeCount&q;:1543,&q;scoreCount&q;:10976,&q;avgScore&q;:9.847485422740515,&q;fiveGradeAvgScore&q;:4.92,&q;updateTime&q;:1773622909183},&q;auditionEpisode&q;:{&q;episodeTitle&q;:&q;个人展示课&q;,&q;episodeVideoUrl&q;:&q;https://vod.fbstatic.cn/22e9ceb2vodbj1251001446/702e6d723270835014228008314/AU0Hkzm5lf8A.mp4?t=f2a4b300&a;us=4070880000&a;sign=2085272ea9e042a7ec8e7019cfef691e&q;},&q;memberOfCPC&q;:false,&q;tags&q;:null},{&q;id&q;:3095,&q;userId&q;:48741920,&q;name&q;:&q;姚柯&q;,&q;brief&q;:&q;公考面试、言语理解与表达主讲&q;,&q;desc&q;:&q;粉笔公考面试、言语理解与表达优质讲师。多年机关工作经验、军队服役经历、面试状元、硕士学历。授课逻辑严谨且却又不失轻松幽默。擅长结合每位同学不同的情况，从应试角度帮助学员掌握解题方法和答题技巧，个性化的设定学习内容，帮助学员打造最适合自身的答题思路。用最短的时间，让你遇见不一样的自己。&q;,&q;avatar&q;:&q;1715cd40ca069a3.png&q;,&q;upperBodyPhoto&q;:null,&q;displayCoursePrefix&q;:&q;gwy&q;,&q;teacherStat&q;:{&q;teacherId&q;:3095,&q;episodeCount&q;:178,&q;scoreCount&q;:4505,&q;avgScore&q;:9.878357380688126,&q;fiveGradeAvgScore&q;:4.94,&q;updateTime&q;:1773458339540},&q;auditionEpisode&q;:null,&q;memberOfCPC&q;:false,&q;tags&q;:null},{&q;id&q;:5201,&q;userId&q;:41358262,&q;name&q;:&q;刘秋实&q;,&q;brief&q;:&q;粉笔面试研究院成员、高级面试讲师&q;,&q;desc&q;:&q;8年公考面试授课经验，粉笔大区面试教学教研负责人，主要担任粉笔面试师资的培训师，参与组织各类授课研讨会议和培训工作，培训师资千余人，承担国省考理论大课及各类线上公开课，参与负责面试教研、题本研发等工作，曾获得粉笔“卓越教师”称号，高分实战经验丰富。\n刘秋实老师秉承着“我的梦想就是帮学生实现梦想”的教学目标，和“虚心涵泳、居敬持志”的教育理念，深谙面试答题逻辑，善于寻找命题的趋势和规律，发掘学生自身优势，授课风格轻松幽默、温柔细致、逻辑缜密、严谨专业，致力于去模板化答题和“自信、自主、自然”的精彩表达，帮助学生在面试学习中遇到不一样的自己。&q;,&q;avatar&q;:&q;1720cd2d2210cf1.jpg&q;,&q;upperBodyPhoto&q;:null,&q;displayCoursePrefix&q;:&q;gwy&q;,&q;teacherStat&q;:{&q;teacherId&q;:5201,&q;episodeCount&q;:1163,&q;scoreCount&q;:11921,&q;avgScore&q;:9.812431842966207,&q;fiveGradeAvgScore&q;:4.91,&q;updateTime&q;:1773605088494},&q;auditionEpisode&q;:{&q;episodeTitle&q;:&q;个人展示课&q;,&q;episodeVideoUrl&q;:&q;https://vod.fbstatic.cn/22e9ceb2vodbj1251001446/d434698e243791580126493171/f0.mp4?t=f2a4b300&a;us=4070880000&a;sign=91827eb53851e204f0052b8f6d5ec28d&q;},&q;memberOfCPC&q;:false,&q;tags&q;:null},{&q;id&q;:32254,&q;userId&q;:74446336,&q;name&q;:&q;张月亮&q;,&q;brief&q;:&q;粉笔公考常识优质讲师&q;,&q;desc&q;:&q;       粉笔常识优质老师。\n       性格耐心细致，善于把握学员个性化特点，因材施教，认真负责，对待课程一丝不苟。讲课生动形象，机智诙谐，听课体验好，学员可以在轻松愉快的氛围中学习，跟着老师节奏主动思考。老师同时注重“反模板”教学，助力学员走出答题模板与误区。&q;,&q;avatar&q;:&q;1783f5430429930.jpg&q;,&q;upperBodyPhoto&q;:null,&q;displayCoursePrefix&q;:&q;gwy&q;,&q;teacherStat&q;:{&q;teacherId&q;:32254,&q;episodeCount&q;:133,&q;scoreCount&q;:20388,&q;avgScore&q;:9.69501667647632,&q;fiveGradeAvgScore&q;:4.85,&q;updateTime&q;:1773491006064},&q;auditionEpisode&q;:null,&q;memberOfCPC&q;:false,&q;tags&q;:null},{&q;id&q;:8542,&q;userId&q;:54512012,&q;name&q;:&q;孙瑞芳&q;,&q;brief&q;:&q;粉笔申论优质教师&q;,&q;desc&q;:&q;粉笔申论优质教师。\n毕业于西北政法大学，长期从事公考培训行业。深谙各类公考信息，能够为学员提供个性化职业建议。授课思路严谨，授课方式严格；能够对学员因材施教，精细辅导，传授专业知识同时，能让学生学会调动自身的知识和想法，善于激发学生学习兴趣，引导学员思考，以专业和严管为学生上岸保驾护航。&q;,&q;avatar&q;:&q;19863fcf5ab9d87.jpg&q;,&q;upperBodyPhoto&q;:null,&q;displayCoursePrefix&q;:&q;gwy&q;,&q;teacherStat&q;:{&q;teacherId&q;:8542,&q;episodeCount&q;:1597,&q;scoreCount&q;:1592,&q;avgScore&q;:9.817839195979895,&q;fiveGradeAvgScore&q;:4.91,&q;updateTime&q;:1773622869035},&q;auditionEpisode&q;:{&q;episodeTitle&q;:&q;个人展示课&q;,&q;episodeVideoUrl&q;:&q;https://vod.fbstatic.cn/22e9ceb2vodbj1251001446/c74abe051397757909318601013/9Ohn1OS9r2gA.mp4?t=f2a4b300&a;us=4070880000&a;sign=592620687a5267acbcba2c61d6e3c31d&q;},&q;memberOfCPC&q;:false,&q;tags&q;:null},{&q;id&q;:83780,&q;userId&q;:161829498,&q;name&q;:&q;姜倩倩&q;,&q;brief&q;:&q;粉笔公基优质教师&q;,&q;desc&q;:&q;       粉笔公基优质教师。\n      8年公考授课经验，985高校毕业。从业以来授课人数超5000人，授课时长超1w小时。\n是课堂的“双面手”：一面是严谨的“知识匠人”，用逻辑的刻刀雕琢思维；一面是温暖的“心灵画师”，用共情的色彩疏解学生的情绪。长期深耕在教学、教研一线，有扎实的理论功底，有成熟的实践经验。深入研究国省考、事业单位、三支一扶等各类笔试考情及命题特色，有对针对性的讲解知识点。授课思路清晰，讲解细致全面。课堂上认真负责，内容深入浅出。深受学员的好评。&q;,&q;avatar&q;:&q;19b25114d11aa4b.jpg&q;,&q;upperBodyPhoto&q;:null,&q;displayCoursePrefix&q;:&q;gwy&q;,&q;teacherStat&q;:{&q;teacherId&q;:83780,&q;episodeCount&q;:93,&q;scoreCount&q;:205,&q;avgScore&q;:9.902439024390244,&q;fiveGradeAvgScore&q;:4.95,&q;updateTime&q;:1773582800581},&q;auditionEpisode&q;:null,&q;memberOfCPC&q;:false,&q;tags&q;:null}],&q;lectureStat&q;:{&q;lectureId&q;:773251,&q;playStatus&q;:1,&q;freeAddedStudentCount&q;:0,&q;classMinutes&q;:3690,&q;classStartTime&q;:1772406000811,&q;classStopTime&q;:1801233900811,&q;playProgress&q;:0.5,&q;updateTime&q;:1772591187795},&q;catIds&q;:[],&q;teachChannel&q;:1,&q;examType&q;:0,&q;typeFlags&q;:{&q;systemLecture&q;:false,&q;interviewLecture&q;:false,&q;writtenLecture&q;:false,&q;writtenSmallClassLecture&q;:false,&q;writtenOfflineLecture&q;:false,&q;smallClassLecture&q;:false},&q;examSeason&q;:null,&q;needAgreement&q;:false,&q;bestDiscount&q;:{&q;id&q;:10362,&q;title&q;:&q;粉笔晨晚伴学课&q;,&q;tag&q;:&q;行测/申论会员价&q;,&q;discountedPrice&q;:0,&q;type&q;:1,&q;showType&q;:1,&q;desc&q;:&q;会员特惠&q;,&q;userAvailable&q;:true,&q;saleSlogan&q;:&q;行测/申论会员价仅需&q;,&q;icon&q;:&q;&q;,&q;jumpPath&q;:&q;/xingce/member/center&q;,&q;jumpSlogan&q;:&q;了解会员&q;},&q;discounts&q;:[{&q;id&q;:10362,&q;title&q;:&q;粉笔晨晚伴学课&q;,&q;tag&q;:&q;行测/申论会员价&q;,&q;discountedPrice&q;:0,&q;type&q;:1,&q;showType&q;:1,&q;desc&q;:&q;会员特惠&q;,&q;userAvailable&q;:true,&q;saleSlogan&q;:&q;行测/申论会员价仅需&q;,&q;icon&q;:&q;&q;,&q;jumpPath&q;:&q;/xingce/member/center&q;,&q;jumpSlogan&q;:&q;了解会员&q;}],&q;buyLimit&q;:{&q;id&q;:331,&q;tag&q;:&q;无法购买&q;,&q;hint&q;:&q;27考季公考AI刷题班及以上班型学员免费赠送！&q;},&q;grouponRule&q;:null,&q;apeCourseId&q;:1,&q;tradeUnit&q;:0,&q;distributionId&q;:-1,&q;dealPlanId&q;:-1,&q;productType&q;:{&q;type&q;:5,&q;name&q;:&q;低价发货课&q;},&q;contentHighlights&q;:[{&q;highlight&q;:&q;周一至周五温馨陪伴&q;,&q;color&q;:1,&q;ordinal&q;:2},{&q;highlight&q;:&q;日积月累提升备考能力&q;,&q;color&q;:1,&q;ordinal&q;:1}],&q;specialIdentities&q;:[{&q;icon&q;:&q;https://ke.fbstatic.cn/api/images/19ad95ba8d1bd99.jpg&q;,&q;jumpPath&q;:&q;&q;,&q;type&q;:1}],&q;kePrefix&q;:&q;gwy&q;,&q;imageBrief&q;:null,&q;hasRedirectInstructorAfterPaid&q;:false,&q;commentTargetId&q;:0,&q;promotionMedias&q;:[],&q;keFuConfig&q;:{&q;hasOnlineChat&q;:true,&q;hasPhoneSupport&q;:false,&q;hasWechatInstructor&q;:false,&q;schoolKeFuConfig&q;:{&q;id&q;:0,&q;schoolId&q;:0,&q;courseId&q;:0,&q;wechatInstructorUrl&q;:&q;&q;,&q;messageEnable&q;:false,&q;udeskGroupId&q;:&q;&q;,&q;udeskPhone&q;:&q;&q;}},&q;episodes&q;:[{&q;id&q;:11705642,&q;kePrefix&q;:&q;gwy&q;,&q;courseId&q;:1,&q;status&q;:3,&q;playStatus&q;:3,&q;type&q;:1,&q;recordingType&q;:0,&q;mediaType&q;:0,&q;title&q;:&q;早课-政治理论常见词汇(一)&q;,&q;innerTitle&q;:&q;&q;,&q;startTime&q;:1772406000000,&q;endTime&q;:1772407800000,&q;teacher&q;:{&q;id&q;:4372,&q;userId&q;:45812058,&q;name&q;:&q;夏方军&q;,&q;brief&q;:&q;粉笔公基优质教师&q;,&q;desc&q;:&q;粉笔公基优质教师，岗位第一考入食药系统，一年编制工作经历，八年公考事业编授课经历。对政治理论、时政常识、面试有深入研究，擅长从热点、考情维度进行预判。授课细致耐心、思维发散清晰，学生的“小姨夫”。&q;,&q;avatar&q;:&q;19407933436c6d4.jpg&q;,&q;upperBodyPhoto&q;:null,&q;displayCoursePrefix&q;:&q;gwy&q;,&q;teacherStat&q;:{&q;teacherId&q;:4372,&q;episodeCount&q;:1059,&q;scoreCount&q;:209965,&q;avgScore&q;:9.894925344700331,&q;fiveGradeAvgScore&q;:4.95,&q;updateTime&q;:1773623280251},&q;auditionEpisode&q;:{&q;episodeTitle&q;:&q;个人展示课&q;,&q;episodeVideoUrl&q;:&q;https://vod.fbstatic.cn/22e9ceb2vodbj1251001446/65771a37243791580257902972/f0.mp4?t=f2a4b300&a;us=4070880000&a;sign=fe62d49b4742040836cd99e0a96d0768&q;},&q;memberOfCPC&q;:false,&q;tags&q;:null},&q;teachChannel&q;:1,&q;offline&q;:null,&q;duration&q;:2909,&q;hasAudition&q;:false,&q;bizType&q;:0,&q;bizId&q;:&q;773251&q;,&q;supportReplay&q;:true,&q;extraInfo&q;:null,&q;liveConfig&q;:{&q;episodeId&q;:11705642,&q;supportMultiGroup&q;:false,&q;exerciseBizType&q;:0,&q;videoDisplayType&q;:0,&q;avForwardType&q;:0,&q;useIntelligentRoom&q;:false,&q;hasStrokeKeynote&q;:true,&q;verticalModeType&q;:0,&q;originEpisodeId&q;:0,&q;supportRtmp&q;:false,&q;supportPk&q;:false,&q;supportLuckyBag&q;:false,&q;supportUserNoteStroke&q;:false,&q;communicateType&q;:0,&q;fakeLive&q;:false,&q;one2One&q;:false},&q;validStatus&q;:1,&q;supportLive&q;:true,&q;suppo