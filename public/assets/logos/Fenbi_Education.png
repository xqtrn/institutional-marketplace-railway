88,&q;name&q;:&q;邓健&q;,&q;brief&q;:&q;粉笔数资优质教师&q;,&q;desc&q;:&q;粉笔数资优质教师。10年公考授课经验，培训人次超过100万，打分人次超50万；学员评分4.9分，授课逻辑清晰，风格幽默，善于调动学员思考，能将复杂枯燥的内容让学员轻松掌握。&q;,&q;avatar&q;:&q;1714f9f7954c22d.jpg&q;,&q;upperBodyPhoto&q;:null,&q;displayCoursePrefix&q;:&q;gwy&q;,&q;teacherStat&q;:{&q;teacherId&q;:1505,&q;episodeCount&q;:1363,&q;scoreCount&q;:655149,&q;avgScore&q;:9.901591851624621,&q;fiveGradeAvgScore&q;:4.95,&q;updateTime&q;:1773622899126},&q;auditionEpisode&q;:{&q;episodeTitle&q;:&q;个人展示课&q;,&q;episodeVideoUrl&q;:&q;https://vod.fbstatic.cn/22e9ceb2vodbj1251001446/e9d45bdd3560136621448414905/E53pg8IsBaUA.mp4?t=f2a4b300&a;us=4070880000&a;sign=226c5778b0843a5f03efb71521b68243&q;},&q;memberOfCPC&q;:false,&q;tags&q;:null},&q;teachChannel&q;:1,&q;offline&q;:null,&q;duration&q;:10926,&q;hasAudition&q;:false,&q;bizType&q;:0,&q;bizId&q;:&q;710082&q;,&q;supportReplay&q;:true,&q;extraInfo&q;:null,&q;liveConfig&q;:{&q;episodeId&q;:11251838,&q;supportMultiGroup&q;:false,&q;exerciseBizType&q;:0,&q;videoDisplayType&q;:0,&q;avForwardType&q;:0,&q;useIntelligentRoom&q;:false,&q;hasStrokeKeynote&q;:true,&q;verticalModeType&q;:0,&q;originEpisodeId&q;:0,&q;supportRtmp&q;:false,&q;supportPk&q;:false,&q;supportLuckyBag&q;:false,&q;supportUserNoteStroke&q;:false,&q;communicateType&q;:0,&q;one2One&q;:false,&q;fakeLive&q;:false},&q;validStatus&q;:1,&q;supportLive&q;:true,&q;supportAiCatalog&q;:true,&q;hasIntelligentPen&q;:false,&q;useLocalRecording&q;:false,&q;useIntelligentRoom&q;:false,&q;hasSalePosition&q;:false,&q;hasEpisodeCards&q;:false,&q;lockedForShouna&q;:false,&q;needSignIn&q;:false,&q;needTeacherSignIn&q;:false,&q;enablePadPencil&q;:true,&q;displayExercise&q;:false,&q;supportLuckyBag&q;:false,&q;supportLivePk&q;:false},{&q;id&q;:11251842,&q;kePrefix&q;:&q;gwy&q;,&q;courseId&q;:1,&q;status&q;:3,&q;playStatus&q;:3,&q;type&q;:1,&q;recordingType&q;:0,&q;mediaType&q;:0,&q;title&q;:&q;言语-【2026国考第43季&a;2025下半年省考第35季】行测模考大赛&q;,&q;innerTitle&q;:&q;&q;,&q;startTime&q;:1763290800000,&q;endTime&q;:1763299800000,&q;teacher&q;:{&q;id&q;:1779,&q;userId&q;:44420612,&q;name&q;:&q;明蕾&q;,&q;brief&q;:&q;粉笔言语优质教师&q;,&q;desc&q;:&q;粉笔言语优质教师，文科类硕士\n11年公考授课经验，打分人次超60万，学员评分高达4.9分。\n言语理论基本功扎实，教学经验丰富，授课思路清晰、重点突出，善于引导和总结，注重培养学员举一反三的能力，深受学员好评。&q;,&q;avatar&q;:&q;1718adf9442d3aa.jpg&q;,&q;upperBodyPhoto&q;:null,&q;displayCoursePrefix&q;:&q;gwy&q;,&q;teacherStat&q;:{&q;teacherId&q;:1779,&q;episodeCount&q;:1221,&q;scoreCount&q;:711933,&q;avgScore&q;:9.856694379948717,&q;fiveGradeAvgScore&q;:4.93,&q;updateTime&q;:1773617671467},&q;auditionEpisode&q;:{&q;episodeTitle&q;:&q;个人展示课&q;,&q;episodeVideoUrl&q;:&q;https://vod.fbstatic.cn/22e9ceb2vodbj1251001446/9cec1afc3560136621447424292/iEATIpvLLIQA.mp4?t=f2a4b300&a;us=4070880000&a;sign=63c6130e26890e04c6b2856e24c1f1da&q;},&q;memberOfCPC&q;:false,&q;tags&q;:null},&q;teachChannel&q;:1,&q;offline&q;:null,&q;duration&q;:9323,&q;hasAudition&q;:false,&q;bizType&q;:0,&q;bizId&q;:&q;710082&q;,&q;supportReplay&q;:true,&q;extraInfo&q;:null,&q;liveConfig&q;:{&q;episodeId&q;:11251842,&q;supportMultiGroup&q;:false,&q;exerciseBizType&q;:0,&q;videoDisplayType&q;:0,&q;avForwardType&q;:0,&q;useIntelligentRoom&q;:false,&q;hasStrokeKeynote&q;:true,&q;verticalModeType&q;:0,&q;originEpisodeId&q;:0,&q;supportRtmp&q;:false,&q;supportPk&q;:false,&q;supportLuckyBag&q;:false,&q;supportUserNoteStroke&q;:false,&q;communicateType&q;:0,&q;one2One&q;:false,&q;fakeLive&q;:false},&q;validStatus&q;:1,&q;supportLive&q;:true,&q;supportAiCatalog&q;:true,&q;hasIntelligentPen&q;:false,&q;useLocalRecording&q;:false,&q;useIntelligentRoom&q;:false,&q;hasSalePosition&q;:false,&q;hasEpisodeCards&q;:false,&q;lockedForShouna&q;:false,&q;needSignIn&q;:false,&q;needTeacherSignIn&q;:false,&q;enablePadPencil&q;:true,&q;displayExercise&q;:false,&q;supportLuckyBag&q;:false,&q;supportLivePk&q;:false},{&q;id&q;:11251843,&q;kePrefix&q;:&q;gwy&q;,&q;courseId&q;:1,&q;status&q;:3,&q;playStatus&q;:3,&q;type&q;:1,&q;recordingType&q;:0,&q;mediaType&q;:0,&q;title&q;:&q;判断-【2026国考第43季&a;2025下半年省考第35季】行测模考大赛&q;,&q;innerTitle&q;:&q;&q;,&q;startTime&q;:1763290800000,&q;endTime&q;:1763301600000,&q;teacher&q;:{&q;id&q;:1480,&q;userId&q;:41305626,&q;name&q;:&q;韩菲&q;,&q;brief&q;:&q;粉笔判断优质教师&q;,&q;desc&q;:&q;粉笔判断优质教师，985高校哲学硕士 \n10年公考授课经验，打分人次超37万，学员评分高达4.9分，江湖人称“菲姐”。 \n具有丰富的实践经验及系统扎实的专业理论功底。考点把握精准，授课思维严谨，讲解思路清晰，耐心细致，有亲和力。注重因材施教，教学方法多样，能够为不同水平的学员答疑解惑。 \n参与组织各类授课研讨会议和教研活动，参与编写了《行测的思维》、《行测5000题》等广受学员欢迎的图书。担任培训师培训了大量新老教师，培训内容涵盖理论、强化、刷题、冲刺课程以及命制模拟题等。&q;,&q;avatar&q;:&q;19b4f2fa4ee8339.jpg&q;,&q;upperBodyPhoto&q;:null,&q;displayCoursePrefix&q;:&q;gwy&q;,&q;teacherStat&q;:{&q;teacherId&q;:1480,&q;episodeCount&q;:909,&q;scoreCount&q;:449958,&q;avgScore&q;:9.822641224292045,&q;fiveGradeAvgScore&q;:4.91,&q;updateTime&q;:1773622678628},&q;auditionEpisode&q;:{&q;episodeTitle&q;:&q;个人展示课&q;,&q;episodeVideoUrl&q;:&q;https://vod.fbstatic.cn/22e9ceb2vodbj1251001446/9cfebf793560136621447435260/6SgrFagNErMA.mp4?t=f2a4b300&a;us=4070880000&a;sign=a1687d66388d791e7efb1af19ba888a7&q;},&q;memberOfCPC&q;:false,&q;tags&q;:null},&q;teachChannel&q;:1,&q;offline&q;:null,&q;duration&q;:11881,&q;hasAudition&q;:false,&q;bizType&q;:0,&q;bizId&q;:&q;710082&q;,&q;supportReplay&q;:true,&q;extraInfo&q;:null,&q;liveConfig&q;:{&q;episodeId&q;:11251843,&q;supportMultiGroup&q;:false,&q;exerciseBizType&q;:0,&q;videoDisplayType&q;:0,&q;avForwardType&q;:0,&q;useIntelligentRoom&q;:false,&q;hasStrokeKeynote&q;:true,&q;verticalModeType&q;:0,&q;originEpisodeId&q;:0,&q;supportRtmp&q;:false,&q;supportPk&q;:false,&q;supportLuckyBag&q;:false,&q;supportUserNoteStroke&q;:false,&q;communicateType&q;:0,&q;one2One&q;:false,&q;fakeLive&q;:false},&q;validStatus&q;:1,&q;supportLive&q;:true,&q;supportAiCatalog&q;:true,&q;hasIntelligentPen&q;:false,&q;useLocalRecording&q;:false,&q;useIntelligentRoom&q;:false,&q;hasSalePosition&q;:false,&q;hasEpisodeCards&q;:false,&q;lockedForShouna&q;:false,&q;needSignIn&q;:false,&q;needTeacherSignIn&q;:false,&q;enablePadPencil&q;:true,&q;displayExercise&q;:false,&q;supportLuckyBag&q;:false,&q;supportLivePk&q;:false},{&q;id&q;:11251844,&q;kePrefix&q;:&q;gwy&q;,&q;courseId&q;:1,&q;status&q;:3,&q;playStatus&q;:3,&q;type&q;:1,&q;recordingType&q;:0,&q;mediaType&q;:0,&q;title&q;:&q;数资-【2026国考第43季&a;2025下半年省考第35季】行测模考大赛&q;,&q;innerTitle&q;:&q;&q;,&q;startTime&q;:1763290800000,&q;endTime&q;:1763301600000,&q;teacher&q;:{&q;id&q;:13294,&q;userId&q;:40308934,&q;name&q;:&q;陶昶安&q;,&q;brief&q;:&q;粉笔数资优质教师&q;,&q;desc&q;:&q;粉笔数资优质教师，数量经济学研究生毕业。 \n17年公考从业经验，长期钻研公考数量资料模块的命题规律，独立研发并推广多个解题技巧，广受业内好评。 \n授课逻辑清晰、内容全面、认真负责，风格严谨又不失幽默，善于从学员角度出发，帮助学员更好地提升，被学员亲切地称为“考场安老师”。累计授课时长超过20000小时，学员评分达4.9分。 \n从业期间，累计培训师资千余名、编写图书十余部。&q;,&q;avatar&q;:&q;196ec5345e4963e.jpg&q;,&q;upperBodyPhoto&q;:null,&q;displayCoursePrefix&q;:&q;gwy&q;,&q;teacherStat&q;:{&q;teacherId&q;:13294,&q;episodeCount&q;:1047,&q;scoreCount&q;:330982,&q;avgScore&q;:9.880688375803002,&q;fiveGradeAvgScore&q;:4.94,&q;updateTime&q;:1773611809271},&q;auditionEpisode&q;:{&q;episodeTitle&q;:&q;个人展示课&q;,&q;episodeVideoUrl&q;:&q;https://vod.fbstatic.cn/22e9ceb2vodbj1251001446/a870b9223560136621447902918/Pv3XToPc45IA.mp4?t=f2a4b300&a;us=4070880000&a;sign=019c0f384ba6716d5ce30a3dec8fe39d&q;},&q;memberOfCPC&q;:false,&q;tags&q;:null},&q;teachChannel&q;:1,&q;offline&q;:null,&q;duration&q;:10595,&q;hasAudition&q;:false,&q;bizType&q;:0,&q;bizId&q;:&q;710082&q;,&q;supportReplay&q;:true,&q;extraInfo&q;:null,&q;liveConfig&q;:{&q;episodeId&q;:11251844,&q;supportMultiGroup&q;:false,&q;exerciseBizType&q;:0,&q;videoDisplayType&q;:0,&q;avForwardType&q;:0,&q;useIntelligentRoom&q;:false,&q;hasStrokeKeynote&q;:true,&q;verticalModeType&q;:0,&q;originEpisodeId&q;:0,&q;supportRtmp&q;:false,&q;supportPk&q;:false,&q;supportLuckyBag&q;:false,&q;supportUserNoteStroke&q;:false,&q;communicateType&q;:0,&q;one2One&q;:false,&q;fakeLive&q;:false},&q;validStatus&q;:1,&q;supportLive&q;:true,&q;supportAiCatalog&q;:true,&q;hasIntelligentPen&q;:false,&q;useLocalRecording&q;:false,&q;useIntelligentRoom&q;:false,&q;hasSalePosition&q;:false,&q;hasEpisodeCards&q;:fa