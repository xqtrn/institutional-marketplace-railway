751,&q;scoreCount&q;:6001,&q;avgScore&q;:9.749708381936355,&q;fiveGradeAvgScore&q;:4.87,&q;updateTime&q;:1773580276381},&q;auditionEpisode&q;:{&q;episodeTitle&q;:&q;个人展示课&q;,&q;episodeVideoUrl&q;:&q;https://vod.fbstatic.cn/22e9ceb2vodbj1251001446/3eb3377d5145403710131746857/zh5vva2I9DEA.mp4?t=f2a4b300&a;us=4070880000&a;sign=ba612bd296cc820cb8b2a3a70e21fc52&q;},&q;memberOfCPC&q;:false,&q;tags&q;:null},&q;teachChannel&q;:1,&q;offline&q;:null,&q;duration&q;:8359,&q;hasAudition&q;:false,&q;bizType&q;:0,&q;bizId&q;:&q;726825&q;,&q;supportReplay&q;:true,&q;extraInfo&q;:null,&q;liveConfig&q;:{&q;episodeId&q;:10474560,&q;supportMultiGroup&q;:false,&q;exerciseBizType&q;:0,&q;videoDisplayType&q;:0,&q;avForwardType&q;:0,&q;useIntelligentRoom&q;:false,&q;hasStrokeKeynote&q;:true,&q;verticalModeType&q;:0,&q;originEpisodeId&q;:0,&q;supportRtmp&q;:false,&q;supportPk&q;:true,&q;supportLuckyBag&q;:true,&q;supportUserNoteStroke&q;:false,&q;communicateType&q;:0,&q;one2One&q;:false,&q;fakeLive&q;:false},&q;validStatus&q;:1,&q;supportLive&q;:true,&q;supportAiCatalog&q;:false,&q;hasIntelligentPen&q;:false,&q;useLocalRecording&q;:false,&q;useIntelligentRoom&q;:false,&q;hasSalePosition&q;:false,&q;hasEpisodeCards&q;:true,&q;lockedForShouna&q;:false,&q;needSignIn&q;:false,&q;needTeacherSignIn&q;:false,&q;enablePadPencil&q;:true,&q;displayExercise&q;:false,&q;supportLuckyBag&q;:true,&q;supportLivePk&q;:true},{&q;id&q;:10474566,&q;kePrefix&q;:&q;sydw&q;,&q;courseId&q;:6,&q;status&q;:3,&q;playStatus&q;:3,&q;type&q;:33,&q;recordingType&q;:0,&q;mediaType&q;:0,&q;title&q;:&q;【公基法律】精选好题 沉浸刷题&q;,&q;innerTitle&q;:&q;&q;,&q;startTime&q;:1744077600000,&q;endTime&q;:1744084800000,&q;teacher&q;:{&q;id&q;:34129,&q;userId&q;:83514929,&q;name&q;:&q;刘思秀&q;,&q;brief&q;:&q;粉笔优质讲师&q;,&q;desc&q;:&q;粉笔优质教师\n六年一线教学经验，总授课时长累计超2500小时。多年深耕事业单位考试领域，教学经验丰富，紧跟考情时新热点，对考情、真题、命题方向理解深刻。粉笔事业单位笔试教研材料撰写人之一，四年模考命题经验，多次参加粉笔教研活动，分享授课经验心得，助力粉笔理论研发升级。多年小班带队老师，学员累计评分4.9，结班上岸率 72%，名下多位学员岗位第一入面。授课条理清晰，讲解风趣幽默，擅长化难为简，总结做题规律，将复杂的笔试知识点进行系统梳理，帮助学员把握知识点底层逻辑，减轻学员记忆负担，快速掌握笔试答题技巧。&q;,&q;avatar&q;:&q;1983b891b2af100.jpg&q;,&q;upperBodyPhoto&q;:null,&q;displayCoursePrefix&q;:&q;sydw&q;,&q;teacherStat&q;:{&q;teacherId&q;:34129,&q;episodeCount&q;:613,&q;scoreCount&q;:970,&q;avgScore&q;:9.721649484536082,&q;fiveGradeAvgScore&q;:4.86,&q;updateTime&q;:1773558647472},&q;auditionEpisode&q;:null,&q;memberOfCPC&q;:false,&q;tags&q;:null},&q;teachChannel&q;:1,&q;offline&q;:null,&q;duration&q;:7289,&q;hasAudition&q;:false,&q;bizType&q;:0,&q;bizId&q;:&q;726825&q;,&q;supportReplay&q;:true,&q;extraInfo&q;:null,&q;liveConfig&q;:{&q;episodeId&q;:10474566,&q;supportMultiGroup&q;:false,&q;exerciseBizType&q;:0,&q;videoDisplayType&q;:0,&q;avForwardType&q;:0,&q;useIntelligentRoom&q;:false,&q;hasStrokeKeynote&q;:true,&q;verticalModeType&q;:0,&q;originEpisodeId&q;:0,&q;supportRtmp&q;:false,&q;supportPk&q;:true,&q;supportLuckyBag&q;:true,&q;supportUserNoteStroke&q;:false,&q;communicateType&q;:0,&q;one2One&q;:false,&q;fakeLive&q;:false},&q;validStatus&q;:1,&q;supportLive&q;:true,&q;supportAiCatalog&q;:false,&q;hasIntelligentPen&q;:false,&q;useLocalRecording&q;:false,&q;useIntelligentRoom&q;:false,&q;hasSalePosition&q;:false,&q;hasEpisodeCards&q;:true,&q;lockedForShouna&q;:false,&q;needSignIn&q;:false,&q;needTeacherSignIn&q;:false,&q;enablePadPencil&q;:true,&q;displayExercise&q;:false,&q;supportLuckyBag&q;:true,&q;supportLivePk&q;:true},{&q;id&q;:10474621,&q;kePrefix&q;:&q;sydw&q;,&q;courseId&q;:6,&q;status&q;:3,&q;playStatus&q;:3,&q;type&q;:33,&q;recordingType&q;:0,&q;mediaType&q;:0,&q;title&q;:&q;【言语】精选好题 沉浸刷题&q;,&q;innerTitle&q;:&q;&q;,&q;startTime&q;:1744084800000,&q;endTime&q;:1744092000000,&q;teacher&q;:{&q;id&q;:16571,&q;userId&q;:68761675,&q;name&q;:&q;严月&q;,&q;brief&q;:&q;粉笔优质讲师&q;,&q;desc&q;:&q;粉笔优质讲师\n六年一线教学授课经验，深入了解地区考情，理论知识扎实，授课与实战经验丰富，熟悉考场答题思维及应变技巧。多次参加粉笔教研活动，分享授课经验心得，助力粉笔理论研发升级。能够从学员角度出发，耐心细致，条理清晰，以帮助学员上岸为己任，深受学员喜爱。&q;,&q;avatar&q;:&q;1985521b0d3aabd.jpg&q;,&q;upperBodyPhoto&q;:null,&q;displayCoursePrefix&q;:&q;sydw&