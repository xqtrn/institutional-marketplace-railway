          <img alt="" src="imgs/search.png">
        </div>
        <input id="search-input" oninput='screchInputChange()' placeholder="Search us.tineco.com">
        </input>
        <div id="click-search-hide">
          <img alt="" src="imgs/hide.png">
        </div>
        <div class="fly-user-box" style="position: relative;">
          <div class="nav-icon nav-user" style="display:block;">
            <img alt="" src="imgs/user.png" alt="" id="userCenterHeadImg" data-button_name="User"
              ga4-event="ga4-top-function">
          </div>
          <div class="downBox" id='navDownBox-userCenter' style="width: 200px;top:70px;left:-60px;">
            <div class="box-item"><a href="/tineco-club/overview">Overview</a></div>
            <div class="box-item"><a href="javascript:;" id="userCenterLogOut">Log out</a></div>
          </div>
        </div>
        <script type="text/javascript">
          const access_token = localStorage.getItem('access_token')
          const defaultHeadUrl = "https://static-ussite.tineco.com/header.png_2f44ad45-7.png";
          let isLoginUserCenter = false;
          const baseURL = window.location.hostname.includes('-test')
            ? 'https://cloud-api-us-test.tineco.com'
            : 'https://us-ucenter.tineco.com';
            
          const clearTokens = () => {
            ['access_token', 'refresh_token', 'expires_time', 'refresh_time', 'code', 'token_type']
              .forEach(key => localStorage.removeItem(key));
            localStorage.removeItem('userInfo');
          };
          
          function getUserInfo () {
            $.ajax({
              headers: {
                "Authorization": "Bearer " + localStorage.getItem("access_token")
              },
              url: baseURL + "/user/v1.0/user/get-me",
              type: "get",
              dataType: "json",
              contentType: "application/json",
              success: function (res) {
                if (res.code == 200) {
                  let userInfo = res.data;
                  localStorage.setItem('userInfo', JSON.stringify(userInfo));
                  let avatar = userInfo.avatar || defaultHeadUrl
                  $("#userCenterHeadImg").attr("src", avatar);
                  isLoginUserCenter = true;
                } else {
                  $("#userCenterHeadImg").attr("src", "imgs/user.png");
                  clearTokens()
                }
              },

              error: function (res) {
                $("#userCenterHeadImg").attr("src", "imgs/user.png");
                clearTokens()
              }
            })
          }

          $(function () {
            if (access_token) {
              getUserInfo()
            }
            $(".fly-user-box").hover(
              function () {
                if (isLoginUserCenter) {
                  clearTimeout($(this).data('hoverTimer'));
                  $(this).data('hoverTimer', setTimeout(() => {
                    $('#navDownBox-userCenter').stop().fadeIn(200);
                  }, 150));
                }
              },
              function () {
                clearTimeout($(this).data('hoverTimer'));
                $(this).data('hoverTimer', setTimeout(() => {
                  $('#navDownBox-userCenter').stop().fadeOut(200);
                }, 300));
              }
            );
            $(".fly-user-box").click(function () {
              if (!isLoginUserCenter) {
                $("#userCenterHeadImg").attr("src", "imgs/user.png");
                clearTokens()
                window.location.href = '/login'
              }
            });
            // 下拉框本身悬停处理
            $('#navDownBox-userCenter').hover(
              function () {
                clearTimeout($('.fly-user-box').data('hoverTimer'));
              },
              function () {
                $(this).stop().fadeOut(200);
              }
            );
          });

          var layer = null;
          layui.use(['layer'], function () {
            layer = layui.layer;
            $("#userCenterLogOut").click(function () {
              layer.confirm('Do you want to logout？', {
                btn: ['Yes', 'No'],
                title: "Log Out"
              }, function (index, layero) {
                clearTokens()
                window.location.href = '/'
              }, function (index) {
                console.log(index);
              });
            })
          });

        </script>
        <div class="nav-icon nav-change" data-button_name="Area" ga4-event="ga4-top-function">
          <img alt="" src="imgs/web.png">
        </div>
