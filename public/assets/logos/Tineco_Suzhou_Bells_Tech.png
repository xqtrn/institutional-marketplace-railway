    <div class="box-item"><a href="support/" data-search_term="Support" ga4-event="ga4-search">Support</a></div>
    <div class="box-item"><a href="product/accessories/" data-search_term="Accessories" ga4-event="ga4-search">Accessories</a></div>
        </div>
