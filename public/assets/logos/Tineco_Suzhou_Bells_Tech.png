		<style>
			.live-room-banner-pc {
				padding-bottom: 60px;
			}

			.live-room-banner-pc a {
				text-decoration: none;
			}

			.live-room-banner-pc .live-room-container {
				text-decoration: none;
				display: block;
				width: 1280px;
				margin: 0 auto;
				position: relative;
				overflow: hidden;
				cursor: pointer;
			}

			@media (max-width: 1370px) {
				.live-room-banner-pc .live-room-container {
					width: 1080px !important;
				}

				.live-room-banner-pc .live-room-container .content {
					padding-top: 40px !important;
				}

				.live-room-banner-pc .live-room-container .content .title {
					font-size: 44px !important;
				}
			}

			.live-room-banner-pc .live-room-container:hover .banner-img {
				transform: scale(1.05);
			}

			.live-room-banner-pc .live-room-container .banner-img {
				width: 100%;
				display: block;
				transition: all ease-in-out 0.4s;
			}

			.live-room-banner-pc .live-room-container .content {
				position: absolute;
				width: 100%;
				height: 100%;
				top: 0;
				left: 0;
				z-index: 2;
				display: flex;
				flex-direction: column;
				align-items: center;
				padding-top: 62px;
			}

			.live-room-banner-pc .live-room-container .content .title {
				font-size: 52px;
				line-height: 54px;
				color: #fff;
			}

			.live-room-banner-pc .live-room-container .content .desc-text {
				font-size: 32px;
				line-height: 34px;
				color: #fff;
				margin-top: 108px;
			}

			.live-room-banner-pc .live-room-container .content .live-room-btn {
				text-decoration: none;
				display: block;
				width: 200px;
				height: 44px;
				border-radius: 22px;
				background-color: #fff;
				font-size: 26px;
				line-height: 44px;
				color: #f33bc9;
				text-align: center;
				font-weight: bold;
				margin-top: 30px;
			}
			.swiper-slide_container {
      position: relative;
      cursor: pointer;
    }

    .swiper-slide_container .swiper-slide_container_bg {
      width: 100%;
      height: auto;
    }

    .swiper-slide_container .swiper-slide_container_icon1 {
      position: absolute;
      width: 13%;
      height: auto;
      left: 4%;
      top: 10%;

    }

    .swiper-slide_container .swiper-slide_container_icon2 {
      position: absolute;
      width: 22%;
      height: auto;
      right: 2%;
      top: 8%;

    }
    
       .video-container {
    pointer-events: none;
    /* 确保元素正确分层 */
    position: relative;
    z-index: 1;
    width: 100%;
    height: 100%;
}

.video-container video {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
}
