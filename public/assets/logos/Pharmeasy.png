aridabad, & Ghaziabad, Chennai, Pune, Ahmedabad and Gandhinagar, Surat, Vadodara, Lucknow, Kolkata, Hyderabad, Bengaluru & Jaipur.","logo":"https://assets.pharmeasy.in/web-assets/dist/fca22bc9.png","sameAs":["https://www.instagram.com/pharmeasyapp/","https://www.facebook.com/pharmeasy/","https://www.youtube.com/channel/UCDats_DLX-bGZH3-KGu8JhA","https://twitter.com/pharmeasyapp/","https://www.instagram.com/pharmeasyapp/","https://www.linkedin.com/company/pharmeasy/"],"taxID":"27AAHCT1527F1ZG"},{"@type":"WebSite","@id":"https://pharmeasy.in/#Website","url":"https://pharmeasy.in/","potentialAction":{"@type":"SearchAction","target":"https://pharmeasy.in/search/all?name={search_term_string}","query-input":"required name=search_term_string"}}]}</script><meta charSet="utf-8"/><title>PharmEasy – Online Pharmacy &amp; Medical Store with Healthcare Services in India | 50 Lakhs+ Customers</title><meta name="viewport" content="width=device-width, initial-scale=1"/><link rel="preload" as="image" href="https://cdn01.pharmeasy.in/dam/banner/banner/d924dee4d67-PHY_Jan26.png"/><link rel="preload" as="image" href="https://assets.pharmeasy.in/web-assets/images/banner_repeatUser_docConsult_transformed.webp"/><meta name="next-head-count" content="5"/><noscript data-n-css=""></noscript><script defer="" nomodule="" src="https://assets.pharmeasy.in/apothecary/_next/static/chunks/polyfills-5cd94c89d3acac5f.js"></script><script src="https://assets.pharmeasy.in/apothecary/_next/static/chunks/webpack-b11be93470f03de0.js" defer=""></script><script src="https://assets.pharmeasy.in/apothecary/_next/static/chunks/framework-5b50100ad9ed3e99.js" defer=""></script><script src="https://assets.pharmeasy.in/apothecary/_next/static/chunks/main-f92a253baabed43f.js" defer=""></script><script src="https://assets.pharmeasy.in/apothecary/_next/static/chunks/pages/_app-d3ae18e6d9caddd5.js" defer=""></script><script src="https://assets.pharmeasy.in/apothecary/_next/static/chunks/863-b56ae9c74b334fce.js" defer=