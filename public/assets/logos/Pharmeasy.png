7,\"shop_by_category\":8,\"recommended_for_you\":9,\"new_launches\":10,\"trending_near_you\":11,\"lab_tests_by_concern\":12,\"loyalty_banner\":13,\"shop_by_concern\":14,\"diag_recommendation\":15,\"payment_offers\":16,\"immunity_boosters\":17,\"featured_brands\":18,\"pl_banners\":19,\"deals_of_the_day\":20,\"spotlight\":21,\"secondary_banner\":22,\"health_articles\":23,\"statistics\":24,\"testimonials\":25,\"app_banner\":26,\"static_seo\":27}"},"valueType":"STRING"},"loginCallout":{"defaultValue":{"value":"{\"defaultLogin\":{\"contextualText\":\"Sign up or Login\",\"contextualImage\":\"https://assets.pharmeasy.in/apothecary/images/defaultLogin2.webp\"},\"offersLogin\":{\"contextualText\":\"Sign up or Login to view offers just for you\",\"contextualImage\":\"https://assets.pharmeasy.in/apothecary/images/offersLogin.webp\"}}"},"description":"This Parameter will have array of JSON objects, that will have fields responsible for rendering Login/Signup text and images based on the context","valueType":"JSON"},"enablePincodeAutoSelect":{"defaultValue":{"value":"true"},"description":"This flag is to enable pincode auto select for `isSEM=true`","valueType":"BOOLEAN"},"enableServerCache":{"defaultValue":{"value":"false"},"valueType":"BOOLEAN"},"autoScrollConfig":{"defaultValue":{"value":"{\"enable\":true,\"timer\":3000}"},"valueType":"JSON"}},"headers":{"X-Default-City":1,"X-App-Version":"2.2","X-Phone-Platform":"mweb","X-Pincode":"400001","x-ua":"-","x-ff":"169.150.203.197, 54.182.182.175","user-agent":"Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/78.0.3904.108 Safari/537.36","X-Client-IP":"169.150.203.197, 54.182.182.175","X-Feature-Flags":"{\"isBestOfferEnabled\":true}"},"searchQuery":{},"statisticsData":[{"headText":"51 Million+","caption":"Registered users as of Aug 18, 2025","imgUrl":"https://assets.pharmeasy.in/apothecary/images/family.svg"},{"headText":"71 Million+","caption":"Orders on PharmEasy till date ","imgUrl":"https://assets.pharmeasy.in/apothecary/images/deliveryBoy.svg"},{"headText":"60000+","caption":"Unique items sold last 6 months","imgUrl":"https://assets.pharmeasy.in/apothecary/images/pincodeServed.svg"},{"headText":"19000+","caption":"Pin codes serviced last 3 months","imgUrl":"https://assets.pharmeasy.in/apothecary/images/locationMarker.svg"}],"testimonialsData":[{"id":1,"name":"Niti Rohan","city":"December 11, 2024","content":"I ordered my dad’s heart medication through the app late in the evening and to my surprise, it was delivered the next morning. The process was really smooth, and I even got a good discount. Making repeat orders is even more convenient."},{"id":2,"name":"Yogesh Shukla","city":"January 10, 2025","content":"I had mistakenly ordered the wrong strip of tablets and thought I’d have to go through a lot of hassle to return it, but the customer support made it super easy. They arranged a return pickup and my refund was processed in just 2 days."},{"id":3,"name":"Anuj Kumar","city":"March 12, 2025","content":"PharmEasy is the best application for ordering medicines and lab tests. I have been using it for the last 5 years. The customer support is also good."},{"id":4,"name":"Meha jain","city":"April 3, 2025","content":"Excellent app for medicines \u0026 body check ups. Best part is that the app gives you the option to select from a range of Generic medicines manufactured by reputed firms which helps save a lot of money apart from giving so many options to choose from! Loved it."}],"staticHeaderData":{"quickLinks":[{"name":"Categories","id":"SHOP_BY_CATEGORY"},{"name":"Recommendations","id":"RECOMMENDED_PRODUCTS"},{"name":"Shop by Concerns","id":"SHOP_BY_CONCERN"},{"name":"Deals of the Day","id":"DOTD"},{"name":"Featured Brands","id":"FEATURED_BRANDS"},{"name":"Lab Tests by Concern","id":"LAB_TESTS_BY_CONCERN"}]},"defaultOfferings":[{"title":"Medicine","id":"order_medicine","bc":"#FDF4F5","subtitle":"50","icon":"Star","image":"","link":"/online-medicine-orde